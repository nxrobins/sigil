module erc20_calls;

record Token { balances: BoundedMap_u256_u256_64 }

impl Token {
    pub fn new() -> Token {
        return Token { balances: BoundedMap_u256_u256_64::new() };
    }

    pub fn transfer(self: Token @Mut, __fe_sender: u256, to: u256, amount: u256) {
        let mut __fe_inl1_from: u256 = __fe_sender;
        let mut __fe_inl1_to: u256 = to;
        let mut __fe_inl1_amount: u256 = amount;
        self.balances.transfer(__fe_inl1_from, __fe_inl1_to, __fe_inl1_amount);
    }
}
