module bytes32_roles;

record RoleRegistry { DEFAULT_ADMIN_ROLE: u256, MINTER_ROLE: u256, roleMemberCount: BoundedMap_u256_u256_64, lastRole: u256 }

impl RoleRegistry {
    pub fn new() -> RoleRegistry {
        return RoleRegistry { DEFAULT_ADMIN_ROLE: 0x00, MINTER_ROLE: 0x9f2df0fed2c77648de5860a4cc508cd0818c85b8b8a1ab4ceeef8d981c8956a6, roleMemberCount: BoundedMap_u256_u256_64::new(), lastRole: 0 };
    }

    pub fn bump(self: RoleRegistry @Mut, role: u256) {
        self.roleMemberCount.insert(role, (self.roleMemberCount.get_or(role, 0) + 1));
        self.lastRole = role;
    }

    pub fn count(self: RoleRegistry, role: u256) -> u256 {
        return self.roleMemberCount.get_or(role, 0);
    }

    pub fn minterRole(self: RoleRegistry) -> u256 {
        return self.MINTER_ROLE;
    }
}
