module overload_by_arity;

record C { x: u256 }

impl C {
    pub fn new() -> C {
        return C { x: 0 };
    }

    pub fn __fe_ov1_bump(self: C, v: u256) -> u256 {
        return (v + 1);
    }

    pub fn __fe_ov2_bump(self: C @Mut, v: u256, w: u256) {
        let mut __fe_inl0_v: u256 = v;
        let mut __fe_inl1_v: u256 = w;
        self.x = ((__fe_inl0_v + 1) + (__fe_inl1_v + 1));
    }
}
