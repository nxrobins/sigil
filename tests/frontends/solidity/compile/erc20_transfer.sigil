module erc20_transfer;

record Token { balances: BoundedMap_u256_u256_64 }

impl Token {
    pub fn new() -> Token {
        return Token { balances: BoundedMap_u256_u256_64::new() };
    }

    pub fn balanceOf(self: Token, who: u256) -> u256 {
        return self.balances.get_or(who, 0);
    }

    pub fn transfer(self: Token @Mut, __fe_sender: u256, to: u256, amount: u256) {
        trap_if(!((self.balances.get_or(__fe_sender, 0) >= amount)));
        self.balances.transfer(__fe_sender, to, amount);
    }
}
