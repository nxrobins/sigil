module control_flow;
pub fn clamp(x: i64, lo: i64, hi: i64) -> i64 {
  let mut r = x;
  if (x < lo) {
    r = lo;
  } else {
    if (x > hi) {
      r = hi;
    } else {
    }
  }
  return r;
}
pub fn sum_to(n: i64) -> i64 {
  let mut s = 0;
  let mut i = 0;
  while (i < n) {
    s = (s + i);
    i = (i + 1);
  }
  return s;
}
