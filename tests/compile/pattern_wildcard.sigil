// Test: wildcard and literal patterns in match
module sigil;
cap type Fuel {}

fn classify(n: i64) -> i64 {
    match n {
        0 => { return 100; },
        1 => { return 200; },
        _ => { return 0; }
    }
}

entry actor Main {
    state { fuel: Fuel }

    on Start() -> i64 {
        let a = classify(0);
        let b = classify(1);
        let c = classify(99);
        return a + b + c;
    }
}
