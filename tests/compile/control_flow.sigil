module sigil;

fn check(x: i64) -> i64 {
    if x > 10 {
        return 1;
    } else {
        return 0;
    }
}

fn loop_sum(n: i64) -> i64 {
    let sum: i64 = 0;
    let i: i64 = 0;
    while i < n {
        let sum = sum + i;
        let i = i + 1;
    }
    return sum;
}

fn match_bool(flag: bool) -> i64 {
    match flag {
        true => { return 1; },
        false => { return 0; }
    }
}
