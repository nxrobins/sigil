// Test: match with guard clauses
module sigil;
cap type Fuel {}

fn sign(n: i64) -> i64 {
    match n {
        x if x > 0 => { return 1; },
        x if x < 0 => { return 0 - 1; },
        _ => { return 0; }
    }
}

entry actor Main {
    state { fuel: Fuel }

    on Start() -> i64 {
        let a = sign(42);
        let b = sign(0 - 10);
        let c = sign(0);
        return a + b + c;
    }
}
