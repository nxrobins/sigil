// expect-runtime: FuelExhausted
// Recursive function exhausts fuel — each call burns 1 fuel tick
module sigil;
cap type Fuel {}

fn deep(n: i64) -> i64 {
    if n < 1 {
        return 0;
    } else {
        return deep(n - 1);
    }
}

entry actor Main {
    state { fuel: Fuel }

    on Start() -> i64 {
        return deep(1000);
    }
}
