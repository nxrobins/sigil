// Attack: capability consumed inside a loop body — each iteration
// expect-error: O001
// attempts to move the same linear value, which is double-spend.
// Phase 1 note: the ownership verifier doesn't model back-edge reuse,
// so this passes compilation. The runtime host catches it: "actor does
// not own fuel capability" on the second iteration.
module sigil;
cap type Fuel {}

entry actor Main {
    state { fuel: Fuel }

    on Start() -> i64 {
        let arr = [1, 2, 3];
        for x in arr {
            let child = spawn::<Worker>(fuel); // MUTATION_SITE
        }
        return 1;
    }
}

actor Worker {
    init(fuel: Fuel) {}
    on Ping() -> i64 { return 0; }
}
