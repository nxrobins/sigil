// Attack: child actor crashes via OOB array access, supervisor restarts it.
// expect-error: T278
// The host engine must survive — the trap is absorbed by Restart supervision.
module sigil;
cap type Fuel {}

entry actor Main {
    state { fuel: Fuel }

    on Start() -> i64 {
        let child_fuel = fuel.split(50);
        let child = spawn::<Worker>(child_fuel, supervision: Restart(3));
        return 1;
    }
}

actor Worker {
    init(fuel: Fuel) {}

    on Crash() -> i64 {
        let arr = [1, 2, 3];
        let boom = arr[99]; // MUTATION_SITE
        return 0;
    }
}
