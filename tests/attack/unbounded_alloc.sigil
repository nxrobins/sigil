// Attack: infinite loop that should be caught by back-edge fuel.
// expect-runtime: FuelExhausted
module sigil;
cap type Fuel {}

fn spin(n: i64) -> i64 {
    let i: i64 = 0;
    while i < n {
        let i = i + 1;
    }
    return i;
}

entry actor Main {
    state { fuel: Fuel }

    on Start() -> i64 {
        return spin(10000);
    }
}
