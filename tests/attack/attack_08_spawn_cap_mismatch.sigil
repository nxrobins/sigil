// Attack: spawn an actor expecting Fuel but provide Token instead.
// expect-error: T095
// The type checker must reject the capability type mismatch.
module sigil;
cap type Fuel {}
cap type Token {}

entry actor Main {
    state { fuel: Fuel }

    on Start(token: Token) -> i64 {
        let child = spawn::<Worker>(token); // MUTATION_SITE
        return 1;
    }
}

actor Worker {
    init(fuel: Fuel) {}
    on Ping() -> i64 { return 0; }
}
