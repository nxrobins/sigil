// Typed arena `Arena<T>` — index-addressed storage for graph/tree nodes.
//
// The Tier-3 self-hosting primitive (docs/specs/parser-in-sigil.md §3): the
// SIGIL-written parser stores its AST as an `Arena<Node>`, with every child
// reference a `NodeId` — the i64 index `allocate` returned — instead of a
// pointer. Records are reference-semantic heap values, so an index-addressed
// arena is what makes a recursive tree expressible: nodes are allocated
// bottom-up and refer to earlier nodes by id (back-references only).
//
// A thin wrapper over `Vec<T>`: `allocate` appends and returns the element's
// index; `get` is the LEN-bounded read (traps on `id >= len`, so a forged or
// stale id can never reach uninitialized capacity — the same bound `Vec::get`
// enforces). Ids are dense, sequential from 0, and never reused; the arena
// only grows. Bulk free / region association are future work (the memory-model
// roadmap) — v1 is global-heap, exactly like `Vec`.
//
// `T` is fully generic (the record/methods never name it beyond the type
// parameter); like `Vec`, the element type comes from the binding's
// annotation: `let a: Arena<Node> = Arena::new();`.

module arena;

record Arena<T> { store: Vec<T> }

impl Arena<T> {
    // Empty arena; allocates nothing until the first `allocate`. An associated
    // function — call as `Arena::new()`.
    pub fn new() -> Arena<T> {
        return Arena { store: Vec::new() };
    }

    // Append `item` and return its id — the index every later reference uses.
    // Ids are dense and sequential: the n-th allocate returns n-1 (0-based).
    pub fn allocate(self: Arena<T> @Mut, item: T) -> i64 ! { Alloc } {
        let new_len: i64 = self.store.push(item);
        return new_len - 1;
    }

    // Read the element with id `id`. LEN-bounded through `Vec::get`: traps on
    // `id >= len()`, so only allocated elements are reachable.
    pub fn get(self: Arena<T> @ReadOnly, id: i64) -> T {
        return self.store.get(id);
    }

    // Overwrite an ALLOCATED element in place (LEN-bounded like `get` — traps
    // on `id >= len()`, so only live elements can be rewritten). The parser's
    // literal fold (`-5` → one folded node) PATCHES the literal it already
    // allocated rather than allocating a replacement and orphaning the
    // original (ET-P4: every allocated node stays reachable). Returns `id`.
    pub fn set(self: Arena<T> @Mut, id: i64, item: T) -> i64 {
        let echo: i64 = self.store.set(id, item);
        return id;
    }

    // The number of allocated elements (== the next id `allocate` will return).
    pub fn len(self: Arena<T> @ReadOnly) -> i64 {
        return self.store.len();
    }
}
