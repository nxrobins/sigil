        while i < self.count {
            let ki: str = self.keys[i];
            if ki.bytes_eq(key) {
                self.vals[i] = val;
                return true;
            } else {
            }
            i = i + 1;
        }
        if self.count == 64 {
            return false;
        } else {
        }
        self.keys[self.count] = key;
        self.vals[self.count] = val;
        self.count = self.count + 1;
        return true;
    }

    pub fn get(self: BoundedMap_str_i64_64, key: str) -> Option<i64> {
        let mut i: i64 = 0;
        while i < self.count {
            let ki: str = self.keys[i];
            if ki.bytes_eq(key) {
                return Some(self.vals[i]);
            } else {
            }
            i = i + 1;
        }
        return None;
    }

    pub fn get_or(self: BoundedMap_str_i64_64, key: str, default: i64) -> i64 {
        let mut i: i64 = 0;
        while i < self.count {
            let ki: str = self.keys[i];
            if ki.bytes_eq(key) {
                return self.vals[i];
            } else {
            }
            i = i + 1;
        }
        return default;
    }

    pub fn contains_key(self: BoundedMap_str_i64_64, key: str) -> bool {
        let mut i: i64 = 0;
        while i < self.count {
            let ki: str = self.keys[i];
            if ki.bytes_eq(key) {
                return true;
            } else {
            }
            i = i + 1;
        }
        return false;
    }
}
