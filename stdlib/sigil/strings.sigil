// stdlib::strings — the public BORROWING string-operations module.
//
// Every function here is a pure reader over the foundation intrinsics
// `byte_at` / `len` / `substr`: it returns a `str` view into existing
// bytes or a scalar (or a `Vec<str>` of views for `split_on`), and
// allocates NO new content bytes. Owned construction (concat / join /
// itoa) is a separate later epic ("PR S2") and deliberately lives
// elsewhere.
//
// These functions are the targets of the str-method dispatch: a method on
// a `str` receiver — `s.find(n)` / `s.contains(n)` / `s.starts_with(p)` /
// `s.ends_with(p)` / `s.split_on(d)` / `s.trim()` / `s.parse_i64()` /
// `s.bytes_eq(o)` — desugars to `str_<method>(self, args...)` with the
// receiver prepended.
// (`.split()` is reserved for capability splitting, hence `split_on`.)
// Transitive deps: `option` (`str_find`'s `Option<i64>`, `str_parse_i64`)
// and `vec` (`str_split_on`'s `Vec<str>`). `use sigil::strings;` +
// qualified `strings::str_*` calls also work.
//
// Loop discipline (CF-S2): every scan loop is driven by a single
// monotone index bounded by the source `len`, exiting via the SIGIL
// sentinel idiom (no `break` keyword) — termination is structural.

module strings;

/// Find the first occurrence of `needle` in `haystack`.
///
/// Returns `Some(p)` where `p` is the ABSOLUTE byte offset into
/// `haystack` of the match (CF-S3): `haystack.substr(p, p + needle.len())
/// == needle`. Returns `None` when `needle` does not occur. An empty
/// needle matches at position 0 (CF-S8); a needle longer than the
/// haystack never matches.
pub fn str_find(haystack: str, needle: str) -> Option<i64> {
    let h_len: i64 = haystack.len();
    let n_len: i64 = needle.len();
    if n_len == 0 {
        // CF-S8: the empty needle matches at the start of any string.
        return Some(0);
    } else {
    }
    if n_len > h_len {
        return None;
    } else {
    }
    // Valid start positions are [0, h_len - n_len] inclusive.
    let limit: i64 = h_len - n_len;
    let mut i: i64 = 0;
    while i <= limit {
        let mut j: i64 = 0;
        let mut matched: bool = true;
        while j < n_len {
            if haystack.byte_at(i + j) != needle.byte_at(j) {
                matched = false;
                // Sentinel exit: bump j past n_len (SIGIL has no `break`).
                j = n_len;
            } else {
                j = j + 1;
            }
        }
        if matched {
            // CF-S3: `i` is the offset in the ORIGINAL haystack, not a
            // suffix-relative position.
            return Some(i);
        } else {
        }
        i = i + 1;
    }
    return None;
}

/// True iff `needle` occurs anywhere in `haystack` (an empty needle is
/// vacuously contained). Defined in terms of `str_find` so the two can
/// never disagree.
pub fn str_contains(haystack: str, needle: str) -> bool {
    let pos: Option<i64> = str_find(haystack, needle);
    return pos.is_some();
}

/// True iff `haystack` begins with `prefix`. A prefix longer than the
/// haystack is never a prefix (short-circuits before the loop).
pub fn str_starts_with(haystack: str, prefix: str) -> bool {
    let h_len: i64 = haystack.len();
    let p_len: i64 = prefix.len();
    if p_len > h_len {
        return false;
    } else {
    }
    let mut i: i64 = 0;
    while i < p_len {
        if haystack.byte_at(i) != prefix.byte_at(i) {
            return false;
        } else {
        }
        i = i + 1;
    }
    return true;
}

/// Byte-wise equality: true iff `a` and `b` have the same length AND every byte
/// matches. This is the SAME predicate `==` now computes on `str`; `bytes_eq`
/// predates the operator's byte-compare lowering (the AG-S1-M deferral, since
/// retired) and stays the explicit spelling used throughout the self-hosted
/// compiler. It is `len == && starts_with`, so it short-circuits on a length
/// mismatch and otherwise byte-compares. The SIGIL lexer's keyword recognition
/// rests on this (a keyword is matched against an identifier-span VIEW).
pub fn str_bytes_eq(a: str, b: str) -> bool {
    if a.len() == b.len() {
        return str_starts_with(a, b);
    } else {
        return false;
    }
}

/// True iff `needle` is an element of `haystack` by CONTENT equality.
/// Phase-1 `.contains(x)` on an Array/Slice of `str` desugars to this (the
/// array receiver coerces to `&[str]`). Uses `str_bytes_eq` (length-equal +
/// byte compare) — NOT `str_contains`, which is SUBSTRING search, a different
/// predicate. The counter is `u32` to match the slice's `.len()` width.
pub fn __sigil_slice_str_contains(haystack: &[str], needle: str) -> bool {
    let n: u32 = haystack.len();
    let mut i: u32 = 0;
    while i < n {
        if str_bytes_eq(haystack[i], needle) {
            return true;
        } else {
        }
        i = i + 1;
    }
    return false;
}

/// True iff `haystack` ends with `suffix`. Compares the last
/// `suffix.len()` bytes; a suffix longer than the haystack is never a
/// suffix.
pub fn str_ends_with(haystack: str, suffix: str) -> bool {
    let h_len: i64 = haystack.len();
    let s_len: i64 = suffix.len();
    if s_len > h_len {
        return false;
    } else {
    }
    let offset: i64 = h_len - s_len;
    let mut i: i64 = 0;
    while i < s_len {
        if haystack.byte_at(offset + i) != suffix.byte_at(i) {
            return false;
        } else {
        }
        i = i + 1;
    }
    return true;
}

/// Split `s` on every (non-overlapping, left-to-right) occurrence of
/// `delim`, returning the segments as a `Vec<str>` of views. The result
/// has EXACTLY `occurrences(delim) + 1` segments (CF-S4): leading,
/// trailing, and consecutive delimiters all yield empty-string segments,
/// and the segments interleaved with `delim` reconstruct `s`. An empty
/// delimiter is NOT scanned — it returns `[s]` (the whole string, one
/// element) — so the scan can never stall (CF-S4 empty-delim guard).
pub fn str_split_on(s: str, delim: str) -> Vec<str> ! { Alloc } {
    let mut out: Vec<str> = Vec::new();
    let dlen: i64 = delim.len();
    if dlen == 0 {
        let n0: i64 = out.push(s);
        return out;
    } else {
    }
    let slen: i64 = s.len();
    let limit: i64 = slen - dlen;
    let mut seg_start: i64 = 0;
    let mut i: i64 = 0;
    while i <= limit {
        let mut j: i64 = 0;
        let mut matched: bool = true;
        while j < dlen {
            if s.byte_at(i + j) != delim.byte_at(j) {
                matched = false;
                j = dlen;
            } else {
                j = j + 1;
            }
        }
        if matched {
            let seg: str = s.substr(seg_start, i);
            let n1: i64 = out.push(seg);
            // Non-overlapping: skip past the whole delimiter.
            seg_start = i + dlen;
            i = i + dlen;
        } else {
            i = i + 1;
        }
    }
    // The trailing segment [seg_start, slen) is ALWAYS pushed, which is
    // what makes the count occurrences+1 (and keeps a trailing delimiter's
    // empty segment).
    let tail: str = s.substr(seg_start, slen);
    let n2: i64 = out.push(tail);
    return out;
}

/// True iff `b` is one of the six ASCII whitespace bytes
/// {0x09 TAB, 0x0A LF, 0x0B VT, 0x0C FF, 0x0D CR, 0x20 SPACE} (CF-S6).
/// SIGIL has no `||`, so this is a cascade of early returns; no other
/// byte (NBSP 0xA0 etc.) is whitespace.
fn str_is_ws(b: i64) -> bool {
    if b == 32 {
        return true;
    } else {
    }
    if b == 9 {
        return true;
    } else {
    }
    if b == 10 {
        return true;
    } else {
    }
    if b == 13 {
        return true;
    } else {
    }
    if b == 11 {
        return true;
    } else {
    }
    if b == 12 {
        return true;
    } else {
    }
    return false;
}

/// Return the sub-view of `s` with leading and trailing ASCII whitespace
/// (the six `str_is_ws` bytes, CF-S6) removed. An all-whitespace or empty
/// string trims to `""`. Zero-copy: the result views the same bytes.
pub fn str_trim(s: str) -> str {
    let n: i64 = s.len();
    // First non-whitespace index (stays `n` if the whole string is ws).
    let mut start: i64 = n;
    let mut i: i64 = 0;
    while i < n {
        if str_is_ws(s.byte_at(i)) {
            i = i + 1;
        } else {
            start = i;
            i = n;
        }
    }
    // Exclusive end = one past the last non-ws index, scanning back to start.
    let mut stop: i64 = start;
    let mut k: i64 = n;
    while k > start {
        let idx: i64 = k - 1;
        if str_is_ws(s.byte_at(idx)) {
            k = k - 1;
        } else {
            stop = idx + 1;
            k = start;
        }
    }
    return s.substr(start, stop);
}

/// True iff byte offset `i` is a valid UTF-8 codepoint boundary in `s`: `i` is
/// `0`, `len`, or the start of a codepoint (NOT a continuation byte
/// `0b10xxxxxx`); an out-of-range `i` (`< 0` or `> len`) is not a boundary. This
/// is the SAME predicate the `substr` boundary trap enforces — the RAIL to its
/// floor: `s.substr(a, b)` traps iff `!is_char_boundary(a) || !is_char_boundary(b)`.
/// Lets a tool check before slicing instead of finding out via the trap.
pub fn str_is_char_boundary(s: str, i: i64) -> bool {
    let n: i64 = s.len();
    if i < 0 {
        return false;
    } else {
    }
    if i > n {
        return false;
    } else {
    }
    if i == 0 {
        return true;
    } else {
    }
    if i == n {
        return true;
    } else {
    }
    let b: i64 = s.byte_at(i);
    return (b & 0xC0) != 0x80;
}

/// Parse `s` as a base-10 `i64`. STRICT whole-string (CF-S7): the entire
/// string must match `-?[0-9]+` (an optional single leading `-` then one
/// or more ASCII digits). Returns `None` on empty input, a lone sign, a
/// leading `+`, surrounding whitespace, or any non-digit byte. A value
/// outside the i64 range is UNSPECIFIED (AG-S8) — the accumulator wraps.
pub fn str_parse_i64(s: str) -> Option<i64> {
    let n: i64 = s.len();
    if n == 0 {
        return None;
    } else {
    }
    let mut i: i64 = 0;
    let mut neg: bool = false;
    if s.byte_at(0) == 45 {
        neg = true;
        i = 1;
    } else {
    }
    if i == n {
        // A lone "-" has no digits.
        return None;
    } else {
    }
    let mut acc: i64 = 0;
    let mut ok: bool = true;
    while i < n {
        let b: i64 = s.byte_at(i);
        if b < 48 {
            ok = false;
            i = n;
        } else {
            if b > 57 {
                ok = false;
                i = n;
            } else {
                acc = acc * 10 + (b - 48);
                i = i + 1;
            }
        }
    }
    if ok {
        if neg {
            return Some(0 - acc);
        } else {
            return Some(acc);
        }
    } else {
        return None;
    }
}

/// Parse an UNSIGNED 64-bit integer: the whole string must match `[0-9]+` (no
/// sign). Returns `None` on empty input, a leading sign, or any non-digit byte.
/// A value past u64::MAX is UNSPECIFIED (AG-S8) — the accumulator wraps.
pub fn str_parse_u64(s: str) -> Option<u64> {
    let n: i64 = s.len();
    if n == 0 {
        return None;
    } else {
    }
    let mut i: i64 = 0;
    let mut acc: u64 = 0;
    let ten: u64 = 10;
    let mut ok: bool = true;
    while i < n {
        let b: i64 = s.byte_at(i);
        if b < 48 {
            ok = false;
            i = n;
        } else {
            if b > 57 {
                ok = false;
                i = n;
            } else {
                let dv: i64 = b - 48;
                let d: u64 = dv.as_u64();
                acc = acc * ten + d;
                i = i + 1;
            }
        }
    }
    if ok {
        return Some(acc);
    } else {
        return None;
    }
}

/// Parse an UNSIGNED 32-bit integer. Reuses `str_parse_u64` then range-checks
/// `<= u32::MAX`, returning `None` on overflow. The result narrows via `.as_u32()`.
pub fn str_parse_u32(s: str) -> Option<u32> {
    let p: Option<u64> = str_parse_u64(s);
    // Extract into a plain (value, ok) pair via NON-returning match arms. A bare
    // `return None` inside a `match` arm infers None's type-arg from the SCRUTINEE
    // (Option<u64>) rather than the function return (Option<u32>) → a false T049;
    // returning only from the if-tail below dodges that (None infers from the ret).
    let mut v: u64 = 0;
    let mut ok: bool = false;
    match p {
        Some(x) => {
            v = x;
            ok = true;
        },
        None => {
            ok = false;
        },
    }
    if ok {
        let hi: u64 = 4294967295;
        if v > hi {
            return None;
        } else {
        }
        let r: u32 = v.as_u32();
        return Some(r);
    } else {
        return None;
    }
}

/// Parse a SIGNED 32-bit integer. Reuses `str_parse_i64` then range-checks the
/// i32 bounds `[-2147483648, 2147483647]`, returning `None` on overflow. The
/// result narrows via `.as_i32()`.
pub fn str_parse_i32(s: str) -> Option<i32> {
    let p: Option<i64> = str_parse_i64(s);
    // See str_parse_u32: extract via non-returning arms, return from the if-tail.
    let mut v: i64 = 0;
    let mut ok: bool = false;
    match p {
        Some(x) => {
            v = x;
            ok = true;
        },
        None => {
            ok = false;
        },
    }
    if ok {
        let lo: i64 = 0 - 2147483648;
        let hi: i64 = 2147483647;
        if v < lo {
            return None;
        } else {
        }
        if v > hi {
            return None;
        } else {
        }
        let r: i32 = v.as_i32();
        return Some(r);
    } else {
        return None;
    }
}

/// ASCII case-insensitive equality: true iff `a` and `b` are equal after folding
/// each `A`–`Z` byte to lowercase. Length-equal-first, then byte-compares the
/// folded bytes. ASCII-only (bytes >= 128 compare verbatim).
pub fn str_eq_ignore_case(a: str, b: str) -> bool {
    let an: i64 = a.len();
    let bn: i64 = b.len();
    if an != bn {
        return false;
    } else {
    }
    let mut i: i64 = 0;
    while i < an {
        let mut ca: i64 = a.byte_at(i);
        let mut cb: i64 = b.byte_at(i);
        if ca >= 65 {
            if ca <= 90 {
                ca = ca + 32;
            } else {
            }
        } else {
        }
        if cb >= 65 {
            if cb <= 90 {
                cb = cb + 32;
            } else {
            }
        } else {
        }
        if ca != cb {
            return false;
        } else {
        }
        i = i + 1;
    }
    return true;
}

/// Split `s` at the FIRST occurrence of `delim`, returning `Some((head, rest))`
/// — the borrowed substring before the delimiter and the borrowed substring
/// after it. Returns `None` if `delim` does not occur. (An empty `delim` matches
/// at position 0, yielding `("", s)`.)
pub fn str_split_first(s: str, delim: str) -> Option<(str, str)> {
    let pos: Option<i64> = str_find(s, delim);
    // See str_parse_u32: extract the position via non-returning arms, return from
    // the if-tail so the `return None` infers Option<(str, str)> from the ret type.
    let mut p: i64 = 0;
    let mut found: bool = false;
    match pos {
        Some(x) => {
            p = x;
            found = true;
        },
        None => {
            found = false;
        },
    }
    if found {
        let dlen: i64 = delim.len();
        let slen: i64 = s.len();
        let head: str = s.substr(0, p);
        let rest_start: i64 = p + dlen;
        let rest: str = s.substr(rest_start, slen);
        let pair: (str, str) = (head, rest);
        return Some(pair);
    } else {
        return None;
    }
}
