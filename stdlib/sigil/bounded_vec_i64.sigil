    pub fn take(self: BoundedVec_i64_64, n: i64) -> BoundedVec_i64_64 {
        let mut lim: i64 = n;
        if self.count < n {
            lim = self.count;
        } else {
        }
        let mut out: BoundedVec_i64_64 = BoundedVec_i64_64::new();
        let mut i: i64 = 0;
