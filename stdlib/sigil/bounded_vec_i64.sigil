// ── functional transforms (COMPLETENESS Phase 2) ─────────────────────────────
//
// i64-only, `@ReadOnly self` (the bare receiver = default-frozen — these never
// mutate self). `map`/`filter`/`filter_map`/`take` return a FRESH `BoundedVec_i64_N`
// built via `::new()` (a fresh backing — not a header copy, so the result aliases
// neither self nor any other source) + `push`; the seal guarantees `count <= N`, so
// pushing `<= count` elements NEVER trips the `data[N]` trap. ALL Alloc-FREE (the
// inner-ring thesis — `Vec`'s adapters need `cap Alloc`; these don't). Source reads
// are `self.data[i]` for `i < self.count` (always a live cell — no `unwrap_or` mask).
// The closure result is bound to a local before use (called exactly once per
// element). The closure signatures are `Fn(i64)->…`, so a non-i64 element is a
// type error, never a silent widen. `seed` (not the reserved `init`) names the fold
// accumulator. The transform bodies carry NO capacity literal — only the type name
// differs per size — so a size transposition is a compile error, not a silent trap.

impl BoundedVec_i64_8 {
    pub fn map(self: BoundedVec_i64_8, f: Fn(i64) -> i64) -> BoundedVec_i64_8 {
        let mut out: BoundedVec_i64_8 = BoundedVec_i64_8::new();
        let mut i: i64 = 0;
        while i < self.count {
            let e: i64 = self.data[i];
            let r: i64 = f(e);
            let _n: i64 = out.push(r);
            i = i + 1;
        }
        return out;
    }

    pub fn filter(self: BoundedVec_i64_8, pred: Fn(i64) -> bool) -> BoundedVec_i64_8 {
        let mut out: BoundedVec_i64_8 = BoundedVec_i64_8::new();
        let mut i: i64 = 0;
        while i < self.count {
            let e: i64 = self.data[i];
            if pred(e) {
                let _n: i64 = out.push(e);
            } else {
            }
            i = i + 1;
        }
        return out;
    }

    pub fn filter_map(self: BoundedVec_i64_8, f: Fn(i64) -> Option<i64>) -> BoundedVec_i64_8 {
        let mut out: BoundedVec_i64_8 = BoundedVec_i64_8::new();
        let mut i: i64 = 0;
        while i < self.count {
            let e: i64 = self.data[i];
            let o: Option<i64> = f(e);
            if o.is_some() {
                let v: i64 = o.unwrap_or(0);
                let _n: i64 = out.push(v);
            } else {
            }
            i = i + 1;
        }
        return out;
    }

    pub fn fold(self: BoundedVec_i64_8, seed: i64, g: Fn(i64, i64) -> i64) -> i64 {
        let mut acc: i64 = seed;
        let mut i: i64 = 0;
        while i < self.count {
            let e: i64 = self.data[i];
            acc = g(acc, e);
            i = i + 1;
        }
        return acc;
    }

    pub fn sum(self: BoundedVec_i64_8) -> i64 {
        let mut acc: i64 = 0;
        let mut i: i64 = 0;
        while i < self.count {
            acc = acc + self.data[i];
            i = i + 1;
        }
        return acc;
    }

    pub fn any(self: BoundedVec_i64_8, pred: Fn(i64) -> bool) -> bool {
        let mut i: i64 = 0;
        let mut found: bool = false;
        while i < self.count {
            let e: i64 = self.data[i];
            if pred(e) {
                found = true;
                i = self.count;
            } else {
                i = i + 1;
            }
        }
        return found;
    }

    pub fn all(self: BoundedVec_i64_8, pred: Fn(i64) -> bool) -> bool {
        let mut i: i64 = 0;
        let mut ok: bool = true;
        while i < self.count {
            let e: i64 = self.data[i];
            if pred(e) {
                i = i + 1;
            } else {
                ok = false;
                i = self.count;
            }
        }
        return ok;
    }

    pub fn find(self: BoundedVec_i64_8, pred: Fn(i64) -> bool) -> Option<i64> {
        let mut i: i64 = 0;
        let mut out: Option<i64> = None;
        while i < self.count {
            let e: i64 = self.data[i];
            if pred(e) {
                out = Some(e);
                i = self.count;
            } else {
                i = i + 1;
            }
        }
        return out;
    }

    // Logical take: the first `min(n, count)` elements (bound unchanged). `lim`
    // precomputed (no `&&`); `n <= 0` yields an empty result.
    pub fn take(self: BoundedVec_i64_8, n: i64) -> BoundedVec_i64_8 {
        let mut lim: i64 = n;
        if self.count < n {
            lim = self.count;
        } else {
        }
        let mut out: BoundedVec_i64_8 = BoundedVec_i64_8::new();
        let mut i: i64 = 0;
        while i < lim {
            let _n: i64 = out.push(self.data[i]);
            i = i + 1;
        }
        return out;
    }
}

