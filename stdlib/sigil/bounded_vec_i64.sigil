    pub fn zip(self: BoundedVec_i64_64, other: BoundedVec_i64_64) -> BoundedPairVec_i64_i64_64 {
        let mut lim: i64 = self.count;
        if other.count < lim {
            lim = other.count;
        } else {
        }
        let mut out: BoundedPairVec_i64_i64_64 = BoundedPairVec_i64_i64_64::new();
        let mut i: i64 = 0;
        while i < lim {
            let _p: i64 = out.push(self.data[i], other.data[i]);
            i = i + 1;
        }
        return out;
    }

    pub fn enumerate(self: BoundedVec_i64_64) -> BoundedPairVec_i64_i64_64 {
        let mut out: BoundedPairVec_i64_i64_64 = BoundedPairVec_i64_i64_64::new();
        let mut i: i64 = 0;
        while i < self.count {
            let _p: i64 = out.push(i, self.data[i]);
            i = i + 1;
        }
        return out;
    }
}

impl BoundedVec_i64_256 {
    pub fn zip(self: BoundedVec_i64_256, other: BoundedVec_i64_256) -> BoundedPairVec_i64_i64_256 {
        let mut lim: i64 = self.count;
        if other.count < lim {
            lim = other.count;
        } else {
        }
        let mut out: BoundedPairVec_i64_i64_256 = BoundedPairVec_i64_i64_256::new();
        let mut i: i64 = 0;
        while i < lim {
            let _p: i64 = out.push(self.data[i], other.data[i]);
            i = i + 1;
        }
        return out;
    }

    pub fn enumerate(self: BoundedVec_i64_256) -> BoundedPairVec_i64_i64_256 {
        let mut out: BoundedPairVec_i64_i64_256 = BoundedPairVec_i64_i64_256::new();
        let mut i: i64 = 0;
        while i < self.count {
            let _p: i64 = out.push(i, self.data[i]);
            i = i + 1;
        }
        return out;
    }
