// ── zip / enumerate → BoundedPairVec (COMPLETENESS Phase 2) ───────────────────
//
// `zip(other)` pairs the live elements of two SAME-size bounded vectors up to
// `min(self.count, other.count)`; `enumerate()` pairs each element with its i64
// index. Both return a fresh `BoundedPairVec_i64_i64_N` (the tuple-element family),
// built via its public `::new()` + `push` API (a cross-`bounded_*`-module record
// can be built ONLY through its sealed public API, never a literal — T258). Reads
// are `self.data[i]` / `other.data[i]` for `i < count` (a live cell). Alloc-free;
// the result aliases neither source. (Cross-size zip is OUT — AG-P2-3; the
// enumerate index is i64, not u32 — AG-P2-2.)

impl BoundedVec_i64_8 {
    pub fn zip(self: BoundedVec_i64_8, other: BoundedVec_i64_8) -> BoundedPairVec_i64_i64_8 {
        let mut lim: i64 = self.count;
        if other.count < lim {
            lim = other.count;
        } else {
        }
        let mut out: BoundedPairVec_i64_i64_8 = BoundedPairVec_i64_i64_8::new();
        let mut i: i64 = 0;
        while i < lim {
            let _p: i64 = out.push(self.data[i], other.data[i]);
            i = i + 1;
        }
        return out;
    }

    pub fn enumerate(self: BoundedVec_i64_8) -> BoundedPairVec_i64_i64_8 {
        let mut out: BoundedPairVec_i64_i64_8 = BoundedPairVec_i64_i64_8::new();
        let mut i: i64 = 0;
        while i < self.count {
            let _p: i64 = out.push(i, self.data[i]);
            i = i + 1;
        }
        return out;
    }
}

