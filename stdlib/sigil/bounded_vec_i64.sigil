// stdlib::bounded_vec_i64 — BOUNDED, stack-backed vectors of `i64` (COMPLETENESS
// Phase 2, the inner-ring thesis). Monomorphized fixed-N records — NOT parametric
// const generics (the LOCKED decision); the family ships as concrete sizes. This
// module carries the `i64` element type at three capacities: `_8`, `_64`, `_256`.
// Each is an independent record + impl (the accepted cost of monomorphized slots);
// they differ ONLY in the capacity `N` (the backing length, the `capacity()`
// constant, the `is_full` bound, and the out-of-range force-trap index `data[N]`).
//
// Why bounded collections need NO `cap Alloc`:
//   - Memory: the elements live in a FIXED `[i64; N]` array embedded in the record
//     header — a BOUNDED allocation the fuel system accounts for statically as
//     N*8 bytes, regardless of `count`. There is no `alloc()` call, so no `Alloc`
//     effect (contrast `vec.sigil`, whose `push` grows the heap and carries
//     `! { Alloc }`). The whole API below is `Alloc`-free.
//   - Overflow is a RUNTIME TRAP, not a refinement: the SIGIL refinement system is
//     construction-time and doesn't model mutation, so a full `push` is caught by
//     the backing array's own bounds check — `self.data[self.count]` at
//     `count == N` is `self.data[N]`, which trips the `idx >= N` array trap. A
//     write therefore NEVER escapes the N*8-byte backing.
//   - Integrity (the `count <= N` claim is trustworthy): these records are
//     construction-SEALED (T258) — buildable only inside this module (via `new()`),
//     never via a direct `BoundedVec_i64_8 { count: 99 }` literal in user code, so
//     the length invariant cannot be forged.
//
// `count` is the length and `N` the capacity — the field is `count` (not `len`)
// because `len`/`cap` would collide with the `len()`/`capacity()` method names
// (the `vec.sigil` precedent). The `new()` backing is written with the array-repeat
// literal `[0; N]` (the readable form for large N). Reference semantics like every
// SIGIL record: `data` is a `u32` pointer packed in the compact 12-byte header
// (`data_ptr @0`, `count: i64 @4`), so a by-value copy duplicates the header, not
// the array (the same model as `Vec`).

module bounded_vec_i64;

// ── capacity 8 ───────────────────────────────────────────────────────────────

record BoundedVec_i64_8 { data: [i64; 8], count: i64 }

impl BoundedVec_i64_8 {
    // Empty bounded vector — the ONLY public constructor (the record is sealed).
    // No `Alloc`: the `[i64; 8]` backing is a fixed, statically-fuelled region.
    pub fn new() -> BoundedVec_i64_8 {
        return BoundedVec_i64_8 { data: [0; 8], count: 0 };
    }

    pub fn len(self: BoundedVec_i64_8) -> i64 {
        return self.count;
    }

    pub fn capacity(self: BoundedVec_i64_8) -> i64 {
        return 8;
    }

    pub fn is_empty(self: BoundedVec_i64_8) -> bool {
        return self.count == 0;
    }

    pub fn is_full(self: BoundedVec_i64_8) -> bool {
        return self.count == 8;
    }

    // Append `val`, returning the new length. When full (`count == 8`) the store
    // target is `self.data[8]`, which trips the backing array's bounds trap — a
    // bounded resource can't overflow its fixed backing. Mutates the shared header
    // in place (`@Mut self`), like `Vec::push`.
    pub fn push(self: BoundedVec_i64_8 @Mut, val: i64) -> i64 {
        self.data[self.count] = val;
        self.count = self.count + 1;
        return self.count;
    }

    // Remove and return the last element, or `None` if empty.
    pub fn pop(self: BoundedVec_i64_8 @Mut) -> Option<i64> {
        if self.count == 0 {
            return None;
        } else {
        }
        self.count = self.count - 1;
        return Some(self.data[self.count]);
    }

    // Read element `i`, or `None` if out of range. LEN-bounded: cells in
    // `[count, 8)` (zero-initialized or popped-stale) are unreachable.
    pub fn get(self: BoundedVec_i64_8, i: i64) -> Option<i64> {
        if i < 0 {
            return None;
        } else {
        }
        if i >= self.count {
            return None;
        } else {
        }
        return Some(self.data[i]);
    }

    // Overwrite the live cell at `i` with `val`, returning `i`. LEN-bounded (the
    // write counterpart of `get`): only an index in `[0, count)` is writable. An
    // out-of-range `i` ABORTS via the explicit `trap()` primitive rather than
    // silently writing the `[count, 8)` capacity tail or dropping the write.
    pub fn set(self: BoundedVec_i64_8 @Mut, i: i64, val: i64) -> i64 {
        if i < 0 {
            trap();
        } else {
            if i >= self.count {
                trap();
            } else {
                self.data[i] = val;
            }
        }
        return i;
    }
}

