// SH-CAP self-hosted capability-obligation shadow; see
// docs/specs/self-hosting-completion-ladder.md. (This leading comment lets the differential's
// `\nmodule cap_check;\n` strip match,
// exactly like lexer.sigil/parser.sigil/typecheck.sigil — keeping all fns in `module tool;`.)
module cap_check;

// SH-CAP — self-hosted capability shadow (prefix cap_). Composed (module header stripped) into
// cap_workload_differential alongside lexer + parser + typecheck; reuses PNode + P_K_* (parser)
// and tc_seg_at, tc_cap_name_of_typenode, tc_fn_body, tc_build_caps/tc_build_recs, TcRec/TcCap
// (typecheck). Mirrors the Pure collector air_capability_v2::collector — one obligation per
// cap-typed arg at a Call sink and per cap-typed Return value: required_mask = full_mask(the arg's
// OWN cap type, CALLEE-BLIND); actual_mask = trace_static_authority (restrict NARROWS to the named
// authority's bit, split/draw/copy PRESERVE the src, params/mint/opaque terminate at full). CAP-2
// = the FULL workload `{kind} {cap} {required} {actual}`; Spawn/Serialize sinks are DEFERRED (their
// cap arg is not a bare-name path). Output is a `;`-joined stream in program (pre-order-DFS) order —
// the harness splits on `;`, NO dedup, NO sort (order is load-bearing, MI-2).

const CAP_BYTE_COMMA: i64 = 44;

// One decimal digit (0..9) as a string. Masks are small non-negative ints.
fn cap_digit(d: i64) -> str {
    if d == 0 {
        return "0";
    } else {
    }
    if d == 1 {
        return "1";
    } else {
    }
    if d == 2 {
        return "2";
    } else {
    }
    if d == 3 {
        return "3";
    } else {
    }
    if d == 4 {
        return "4";
    } else {
    }
    if d == 5 {
        return "5";
    } else {
    }
    if d == 6 {
        return "6";
    } else {
    }
    if d == 7 {
        return "7";
    } else {
    }
    if d == 8 {
        return "8";
    } else {
    }
    return "9";
}

// Non-negative i64 → decimal string (recursive: high digits then low). Masks are <= 2^32-1 but the
// corpus stays <= 15; recursion depth is bounded by the digit count.
fn cap_i64_str(n: i64) -> str ! { Alloc } {
    if n < 10 {
        return cap_digit(n);
    } else {
    }
    let hi: str = cap_i64_str(n / 10);
    let lodig: i64 = n - (n / 10) * 10;
    let lo: str = cap_digit(lodig);
    return hi.concat(lo);
}

// Bitwise AND of two non-negative masks, computed bit-by-bit (SIGIL has no bitwise `&` operator;
// the ring checker reads a single bit the same way). 32 bits covers any u32 mask; the corpus is
// <= 4 bits.
fn cap_and(a: i64, b: i64) -> i64 {
    let mut result: i64 = 0;
    let mut bitval: i64 = 1;
    let mut x: i64 = a;
    let mut y: i64 = b;
    let mut i: i64 = 0;
    while i < 32 {
        let abit: i64 = x - (x / 2) * 2;
        let bbit: i64 = y - (y / 2) * 2;
        if abit == 1 {
            if bbit == 1 {
                result = result + bitval;
            } else {
            }
        } else {
        }
        x = x / 2;
        y = y / 2;
        bitval = bitval * 2;
        i = i + 1;
    }
    return result;
}

// The 0-based index of `name` in a comma-joined list (`burn,query` → burn=0, query=1), or -1. Byte
// scan, no allocation.
fn cap_index_in_csv(csv: str, name: str) -> i64 {
    let len: i64 = csv.len();
    let mut idx: i64 = 0;
    let mut segstart: i64 = 0;
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    let mut scanning: bool = true;
    while scanning {
        if i >= len {
            let seg: str = csv.substr(segstart, len);
            if seg.bytes_eq(name) {
                found = idx;
            } else {
            }
            scanning = false;
        } else {
            let b: i64 = csv.byte_at(i);
            if b == CAP_BYTE_COMMA {
                let seg: str = csv.substr(segstart, i);
                if seg.bytes_eq(name) {
                    found = idx;
                    scanning = false;
                } else {
                    idx = idx + 1;
                    segstart = i + 1;
                    i = i + 1;
                }
            } else {
                i = i + 1;
            }
        }
    }
    return found;
}

// Authority count of a cap type's `auths` segment (comma-joined names, decl order). 0 when empty,
// else the comma count + 1.
fn cap_auth_count(auths: str) -> i64 {
    let len: i64 = auths.len();
    if len == 0 {
        return 0;
    } else {
    }
    let mut commas: i64 = 0;
    let mut i: i64 = 0;
    while i < len {
        let b: i64 = auths.byte_at(i);
        if b == CAP_BYTE_COMMA {
            commas = commas + 1;
        } else {
        }
        i = i + 1;
    }
    return commas + 1;
}

// full_mask for `count` authorities = (1<<count)-1, built by doubling.
fn cap_full_mask(count: i64) -> i64 {
    let mut mask: i64 = 0;
    let mut i: i64 = 0;
    while i < count {
        mask = mask * 2 + 1;
        i = i + 1;
    }
    return mask;
}

// Module ids under `root`: a P_K_PROGRAM wrapper's children, or the bare P_K_MODULE root.
fn cap_collect_modules(nodes: Arena<PNode>, kids: Vec<i64>, root: i64, out: Vec<i64> @Mut) -> i64 ! { Alloc } {
    let rn: PNode = nodes.get(root);
    if rn.kind == P_K_PROGRAM {
        let mut i: i64 = 0;
        while i < rn.child_count {
            let cid: i64 = kids.get(rn.child_start + i);
            let pushed: i64 = out.push(cid);
            i = i + 1;
        }
    } else {
        let pushed: i64 = out.push(root);
    }
    return 0;
}

// Build the authority table: parallel cap_names / cap_masks / cap_auths over every P_K_CAP_TYPE decl
// across all modules. A cap-type text is `name;auths;params`; name = seg 0, auths = seg 1 (the
// comma-joined authority names, decl order — carried for the restrict-bit lookup, CAP-2).
fn cap_build_table(nodes: Arena<PNode>, kids: Vec<i64>, mods: Vec<i64>, cap_names: Vec<str> @Mut, cap_masks: Vec<i64> @Mut, cap_auths: Vec<str> @Mut) -> i64 ! { Alloc } {
    let nm: i64 = mods.len();
    let mut mi: i64 = 0;
    while mi < nm {
        let mid: i64 = mods.get(mi);
        let mn: PNode = nodes.get(mid);
        let mut i: i64 = 0;
        while i < mn.child_count {
            let cid: i64 = kids.get(mn.child_start + i);
            let cn: PNode = nodes.get(cid);
            if cn.kind == P_K_CAP_TYPE {
                let cnm: str = tc_seg_at(cn.text, 0);
                let auths: str = tc_seg_at(cn.text, 1);
                let count: i64 = cap_auth_count(auths);
                let mask: i64 = cap_full_mask(count);
                let qn: i64 = cap_names.push(cnm);
                let qm: i64 = cap_masks.push(mask);
                let qa: i64 = cap_auths.push(auths);
            } else {
            }
            i = i + 1;
        }
        mi = mi + 1;
    }
    return 0;
}

// full_mask of a cap by name (linear scan); 0 if unknown (never emitted — MI-5).
fn cap_mask_of(cap_names: Vec<str>, cap_masks: Vec<i64>, name: str) -> i64 {
    let n: i64 = cap_names.len();
    let mut i: i64 = 0;
    let mut found: i64 = 0;
    let mut scanning: bool = true;
    while scanning {
        if i >= n {
            scanning = false;
        } else {
            let cand: str = cap_names.get(i);
            if cand.bytes_eq(name) {
                found = cap_masks.get(i);
                scanning = false;
            } else {
                i = i + 1;
            }
        }
    }
    return found;
}

// The single-bit mask (1<<index) of `auth` within `cap_type`'s authority list; 0 if unknown. This
// is the oracle's restriction_mask for CapRestrict.
fn cap_auth_bit(cap_names: Vec<str>, cap_auths: Vec<str>, cap_type: str, auth: str) -> i64 {
    let n: i64 = cap_names.len();
    let mut i: i64 = 0;
    let mut auths: str = "";
    let mut scanning: bool = true;
    while scanning {
        if i >= n {
            scanning = false;
        } else {
            let cand: str = cap_names.get(i);
            if cand.bytes_eq(cap_type) {
                auths = cap_auths.get(i);
                scanning = false;
            } else {
                i = i + 1;
            }
        }
    }
    let idx: i64 = cap_index_in_csv(auths, auth);
    if idx < 0 {
        return 0;
    } else {
    }
    let mut bit: i64 = 1;
    let mut k: i64 = 0;
    while k < idx {
        bit = bit * 2;
        k = k + 1;
    }
    return bit;
}

// The cap type a var is bound to, or "" (not a cap). Most-recent-FIRST scan so a later re-`let` of
// the same NAME (legal shadowing) wins for uses AFTER it — but since the walk appends bindings in
// order and emits sinks in order, a use before the shadowing let still sees the earlier binding.
fn cap_env_find(env_names: Vec<str>, env_caps: Vec<str>, name: str) -> str {
    let n: i64 = env_names.len();
    let mut i: i64 = n - 1;
    let mut found: str = "";
    let mut scanning: bool = true;
    while scanning {
        if i < 0 {
            scanning = false;
        } else {
            let cand: str = env_names.get(i);
            if cand.bytes_eq(name) {
                found = env_caps.get(i);
                scanning = false;
            } else {
                i = i - 1;
            }
        }
    }
    return found;
}

// The actual authority mask a var is bound to (parallel to cap_env_find). -1 if unbound (a
// non-cap path; never reached for an emitted sink).
fn cap_env_actual(env_names: Vec<str>, env_actual: Vec<i64>, name: str) -> i64 {
    let n: i64 = env_names.len();
    let mut i: i64 = n - 1;
    let mut found: i64 = 0 - 1;
    let mut scanning: bool = true;
    while scanning {
        if i < 0 {
            scanning = false;
        } else {
            let cand: str = env_names.get(i);
            if cand.bytes_eq(name) {
                found = env_actual.get(i);
                scanning = false;
            } else {
                i = i - 1;
            }
        }
    }
    return found;
}

// The cap type a `let` binds, or "" (not cap-typed). Annotated `let x: T = …` → the annotation's cap
// name. MI-3: un-annotated `let x = recv.restrict/split/draw(…)` → the receiver's cap type.
fn cap_let_type(nodes: Arena<PNode>, kids: Vec<i64>, letid: i64, rdefs: Vec<TcRec>, cdefs: Vec<TcCap>, env_names: Vec<str>, env_caps: Vec<str>) -> str ! { Alloc } {
    let ln: PNode = nodes.get(letid);
    if ln.child_count == 2 {
        let tid: i64 = kids.get(ln.child_start);
        let capn: str = tc_cap_name_of_typenode(nodes, tid, rdefs, cdefs);
        return capn;
    } else {
    }
    if ln.child_count == 1 {
        let rid: i64 = kids.get(ln.child_start);
        let rn: PNode = nodes.get(rid);
        let mut isop: bool = false;
        if rn.kind == P_K_CAP_RESTRICT {
            isop = true;
        } else {
        }
        if rn.kind == P_K_CAP_RESTRICT_DEADLINE {
            isop = true;
        } else {
        }
        if rn.kind == P_K_CAP_SPLIT {
            isop = true;
        } else {
        }
        if rn.kind == P_K_CAP_DRAW {
            isop = true;
        } else {
        }
        if isop {
            let recv: str = tc_seg_at(rn.text, 0);
            let capn: str = cap_env_find(env_names, env_caps, recv);
            return capn;
        } else {
        }
    } else {
    }
    return "";
}

// The actual authority mask the let's RHS produces, given the bound cap type. Mirrors
// trace_static_authority INCREMENTALLY (the receiver's actual is already traced in the env):
//   restrict(auth)      → receiver.actual & bit(auth)   [NARROW]
//   split/draw(recv)    → receiver.actual               [PRESERVE — follow src]
//   a bare-name copy    → src.actual                    [PRESERVE — Assign(Var)]
//   restrict_deadline / call-returned / mint / opaque → full_mask   [ORIGIN — the walk breaks]
fn cap_let_actual(nodes: Arena<PNode>, kids: Vec<i64>, letid: i64, cap_type: str, cap_names: Vec<str>, cap_masks: Vec<i64>, cap_auths: Vec<str>, env_names: Vec<str>, env_actual: Vec<i64>) -> i64 ! { Alloc } {
    let ln: PNode = nodes.get(letid);
    let mut rid: i64 = 0;
    if ln.child_count == 2 {
        rid = kids.get(ln.child_start + 1);
    } else {
        rid = kids.get(ln.child_start);
    }
    let rn: PNode = nodes.get(rid);
    if rn.kind == P_K_CAP_RESTRICT {
        let recv: str = tc_seg_at(rn.text, 0);
        let auth: str = tc_seg_at(rn.text, 1);
        let base: i64 = cap_env_actual(env_names, env_actual, recv);
        let bit: i64 = cap_auth_bit(cap_names, cap_auths, cap_type, auth);
        return cap_and(base, bit);
    } else {
    }
    if rn.kind == P_K_CAP_SPLIT {
        let recv: str = tc_seg_at(rn.text, 0);
        return cap_env_actual(env_names, env_actual, recv);
    } else {
    }
    if rn.kind == P_K_CAP_DRAW {
        let recv: str = tc_seg_at(rn.text, 0);
        return cap_env_actual(env_names, env_actual, recv);
    } else {
    }
    if rn.kind == P_K_PATH {
        return cap_env_actual(env_names, env_actual, rn.text);
    } else {
    }
    return cap_mask_of(cap_names, cap_masks, cap_type);
}

// Emit for one cap-typed sink arg `path`, when it is a cap in the env with non-zero authority
// (MI-5). mode 0 (WORKLOAD) → `{kind} {cap} {required} {actual};`; mode 1 (VERDICT) → `C003;` iff
// the obligation is VIOLATED (actual & required != required, the callee-blind bitwise rule —
// provably == the Z3 discharge on slot-free programs, the CAP-0 equivalence proof). Returns 0.
fn cap_emit_if_cap(mode: i64, kind: str, pathname: str, cap_names: Vec<str>, cap_masks: Vec<i64>, env_names: Vec<str>, env_caps: Vec<str>, env_actual: Vec<i64>, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let capn: str = cap_env_find(env_names, env_caps, pathname);
    if capn.len() > 0 {
        let mask: i64 = cap_mask_of(cap_names, cap_masks, capn);
        if mask > 0 {
            let actual: i64 = cap_env_actual(env_names, env_actual, pathname);
            if mode == 1 {
                let covered: i64 = cap_and(actual, mask);
                if covered == mask {
                } else {
                    let q: i64 = diags.push("C003;");
                }
            } else {
                let s1: str = kind.concat(" ");
                let s2: str = s1.concat(capn);
                let s3: str = s2.concat(" ");
                let ms: str = cap_i64_str(mask);
                let s4: str = s3.concat(ms);
                let s5: str = s4.concat(" ");
                let as1: str = cap_i64_str(actual);
                let s6: str = s5.concat(as1);
                let s7: str = s6.concat(";");
                let q: i64 = diags.push(s7);
            }
        } else {
        }
    } else {
    }
    return 0;
}

// The single body walk: threads the append-only (names, caps, actual) env, emits Call/Return
// obligations in pre-order-DFS = source order. A P_K_LET adds its cap binding AFTER its RHS is
// walked (nested sinks emit first; the binding's actual is traced from the receiver already in env).
fn cap_walk(mode: i64, nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, rdefs: Vec<TcRec>, cdefs: Vec<TcCap>, cap_names: Vec<str>, cap_masks: Vec<i64>, cap_auths: Vec<str>, env_names: Vec<str> @Mut, env_caps: Vec<str> @Mut, env_actual: Vec<i64> @Mut, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(nid);
    if n.kind == P_K_LET {
        let capn: str = cap_let_type(nodes, kids, nid, rdefs, cdefs, env_names, env_caps);
        let mut ci: i64 = 0;
        while ci < n.child_count {
            let cid: i64 = kids.get(n.child_start + ci);
            let r: i64 = cap_walk(mode, nodes, kids, cid, rdefs, cdefs, cap_names, cap_masks, cap_auths, env_names, env_caps, env_actual, diags);
            ci = ci + 1;
        }
        if capn.len() > 0 {
            let actual: i64 = cap_let_actual(nodes, kids, nid, capn, cap_names, cap_masks, cap_auths, env_names, env_actual);
            let qn: i64 = env_names.push(n.text);
            let qc: i64 = env_caps.push(capn);
            let qa: i64 = env_actual.push(actual);
        } else {
        }
        return 0;
    } else {
    }
    if n.kind == P_K_CALL {
        let mut ai: i64 = 0;
        while ai < n.child_count {
            let aid: i64 = kids.get(n.child_start + ai);
            let an: PNode = nodes.get(aid);
            if an.kind == P_K_PATH {
                let e: i64 = cap_emit_if_cap(mode, "Call", an.text, cap_names, cap_masks, env_names, env_caps, env_actual, diags);
            } else {
            }
            ai = ai + 1;
        }
        let mut ci: i64 = 0;
        while ci < n.child_count {
            let cid: i64 = kids.get(n.child_start + ci);
            let r: i64 = cap_walk(mode, nodes, kids, cid, rdefs, cdefs, cap_names, cap_masks, cap_auths, env_names, env_caps, env_actual, diags);
            ci = ci + 1;
        }
        return 0;
    } else {
    }
    if n.kind == P_K_RETURN {
        if n.child_count >= 1 {
            let vid: i64 = kids.get(n.child_start);
            let vn: PNode = nodes.get(vid);
            if vn.kind == P_K_PATH {
                let e: i64 = cap_emit_if_cap(mode, "Return", vn.text, cap_names, cap_masks, env_names, env_caps, env_actual, diags);
            } else {
            }
        } else {
        }
        let mut ci: i64 = 0;
        while ci < n.child_count {
            let cid: i64 = kids.get(n.child_start + ci);
            let r: i64 = cap_walk(mode, nodes, kids, cid, rdefs, cdefs, cap_names, cap_masks, cap_auths, env_names, env_caps, env_actual, diags);
            ci = ci + 1;
        }
        return 0;
    } else {
    }
    if n.kind == P_K_SPAWN {
        // spawn::<T>(arg…): children[0] = the actor TYPE, children[1..] = the spawn args (+ an
        // optional restart-expr). Each bare-name cap arg is a Spawn sink (the collector's caps +
        // fuel_cap). child[0] (a type node) and non-cap args never emit.
        let mut ai: i64 = 1;
        while ai < n.child_count {
            let aid: i64 = kids.get(n.child_start + ai);
            let an: PNode = nodes.get(aid);
            if an.kind == P_K_PATH {
                let e: i64 = cap_emit_if_cap(mode, "Spawn", an.text, cap_names, cap_masks, env_names, env_caps, env_actual, diags);
            } else {
            }
            ai = ai + 1;
        }
        let mut ci: i64 = 0;
        while ci < n.child_count {
            let cid: i64 = kids.get(n.child_start + ci);
            let r: i64 = cap_walk(mode, nodes, kids, cid, rdefs, cdefs, cap_names, cap_masks, cap_auths, env_names, env_caps, env_actual, diags);
            ci = ci + 1;
        }
        return 0;
    } else {
    }
    if n.kind == P_K_SEND {
        // recv.send(Msg(cap…)) / recv.ask(Msg(cap…)): the receiver rides `text`; the child is the
        // message ctor whose OWN args carry the serialized caps (a Serialize sink per cap). Do NOT
        // recurse — the message ctor parses as a P_K_CALL, so the default walk would emit a
        // spurious Call for the same cap.
        let mut mi: i64 = 0;
        while mi < n.child_count {
            let msgid: i64 = kids.get(n.child_start + mi);
            let msg: PNode = nodes.get(msgid);
            let mut pi: i64 = 0;
            while pi < msg.child_count {
                let pid: i64 = kids.get(msg.child_start + pi);
                let pn: PNode = nodes.get(pid);
                if pn.kind == P_K_PATH {
                    let e: i64 = cap_emit_if_cap(mode, "Serialize", pn.text, cap_names, cap_masks, env_names, env_caps, env_actual, diags);
                } else {
                }
                pi = pi + 1;
            }
            mi = mi + 1;
        }
        return 0;
    } else {
    }
    if n.kind == P_K_ASK {
        let mut mi: i64 = 0;
        while mi < n.child_count {
            let msgid: i64 = kids.get(n.child_start + mi);
            let msg: PNode = nodes.get(msgid);
            let mut pi: i64 = 0;
            while pi < msg.child_count {
                let pid: i64 = kids.get(msg.child_start + pi);
                let pn: PNode = nodes.get(pid);
                if pn.kind == P_K_PATH {
                    let e: i64 = cap_emit_if_cap(mode, "Serialize", pn.text, cap_names, cap_masks, env_names, env_caps, env_actual, diags);
                } else {
                }
                pi = pi + 1;
            }
            mi = mi + 1;
        }
        return 0;
    } else {
    }
    let mut ci: i64 = 0;
    while ci < n.child_count {
        let cid: i64 = kids.get(n.child_start + ci);
        let r: i64 = cap_walk(mode, nodes, kids, cid, rdefs, cdefs, cap_names, cap_masks, cap_auths, env_names, env_caps, env_actual, diags);
        ci = ci + 1;
    }
    return 0;
}

// True iff `fnid` (a P_K_FN) is generic (has a P_K_TYPE_PARAM child) — skipped.
fn cap_is_generic_fn(nodes: Arena<PNode>, kids: Vec<i64>, fnid: i64) -> bool {
    let fnn: PNode = nodes.get(fnid);
    let mut i: i64 = 0;
    let mut found: bool = false;
    let mut scanning: bool = true;
    while scanning {
        if i >= fnn.child_count {
            scanning = false;
        } else {
            let cid: i64 = kids.get(fnn.child_start + i);
            let cn: PNode = nodes.get(cid);
            if cn.kind == P_K_TYPE_PARAM {
                found = true;
                scanning = false;
            } else {
                i = i + 1;
            }
        }
    }
    return found;
}

// Check one fn/handler/init: seed the pre-env (actor state cap fields — empty for a module fn),
// then cap-typed params (actual = full_mask, a param shadows a same-named state field), then walk.
fn cap_check_fn(mode: i64, nodes: Arena<PNode>, kids: Vec<i64>, fnid: i64, rdefs: Vec<TcRec>, cdefs: Vec<TcCap>, cap_names: Vec<str>, cap_masks: Vec<i64>, cap_auths: Vec<str>, seed_names: Vec<str>, seed_caps: Vec<str>, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let mut env_names: Vec<str> = Vec::new();
    let mut env_caps: Vec<str> = Vec::new();
    let mut env_actual: Vec<i64> = Vec::new();
    let mut si: i64 = 0;
    while si < seed_names.len() {
        let sn: str = seed_names.get(si);
        let sc: str = seed_caps.get(si);
        let sfull: i64 = cap_mask_of(cap_names, cap_masks, sc);
        let sq1: i64 = env_names.push(sn);
        let sq2: i64 = env_caps.push(sc);
        let sq3: i64 = env_actual.push(sfull);
        si = si + 1;
    }
    let fnn: PNode = nodes.get(fnid);
    let mut i: i64 = 0;
    while i < fnn.child_count {
        let cid: i64 = kids.get(fnn.child_start + i);
        let cn: PNode = nodes.get(cid);
        if cn.kind == P_K_PARAM {
            if cn.child_count >= 1 {
                let tid: i64 = kids.get(cn.child_start);
                let capn: str = tc_cap_name_of_typenode(nodes, tid, rdefs, cdefs);
                if capn.len() > 0 {
                    let fullm: i64 = cap_mask_of(cap_names, cap_masks, capn);
                    let qn: i64 = env_names.push(cn.text);
                    let qc: i64 = env_caps.push(capn);
                    let qa: i64 = env_actual.push(fullm);
                } else {
                }
            } else {
            }
        } else {
        }
        i = i + 1;
    }
    let body: i64 = tc_fn_body(nodes, kids, fnid);
    if body >= 0 {
        let r: i64 = cap_walk(mode, nodes, kids, body, rdefs, cdefs, cap_names, cap_masks, cap_auths, env_names, env_caps, env_actual, diags);
    } else {
    }
    return 0;
}

// Walk an actor's ACTOR_INIT + HANDLER children as functions (the MI-4 census). The actor's state
// cap fields (P_K_FIELD children whose type is a cap) are collected first and pre-seeded into every
// handler/init env at FULL authority (a state cap is an authority origin, like a param).
fn cap_check_actor(mode: i64, nodes: Arena<PNode>, kids: Vec<i64>, actid: i64, rdefs: Vec<TcRec>, cdefs: Vec<TcCap>, cap_names: Vec<str>, cap_masks: Vec<i64>, cap_auths: Vec<str>, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let an: PNode = nodes.get(actid);
    let mut sfnames: Vec<str> = Vec::new();
    let mut sfcaps: Vec<str> = Vec::new();
    let mut fi: i64 = 0;
    while fi < an.child_count {
        let fcid: i64 = kids.get(an.child_start + fi);
        let fcn: PNode = nodes.get(fcid);
        if fcn.kind == P_K_FIELD {
            if fcn.child_count >= 1 {
                let ftid: i64 = kids.get(fcn.child_start);
                let fcap: str = tc_cap_name_of_typenode(nodes, ftid, rdefs, cdefs);
                if fcap.len() > 0 {
                    let sq1: i64 = sfnames.push(fcn.text);
                    let sq2: i64 = sfcaps.push(fcap);
                } else {
                }
            } else {
            }
        } else {
        }
        fi = fi + 1;
    }
    let mut i: i64 = 0;
    while i < an.child_count {
        let cid: i64 = kids.get(an.child_start + i);
        let cn: PNode = nodes.get(cid);
        if cn.kind == P_K_ACTOR_INIT {
            let r: i64 = cap_check_fn(mode, nodes, kids, cid, rdefs, cdefs, cap_names, cap_masks, cap_auths, sfnames, sfcaps, diags);
        } else {
            if cn.kind == P_K_HANDLER {
                let r: i64 = cap_check_fn(mode, nodes, kids, cid, rdefs, cdefs, cap_names, cap_masks, cap_auths, sfnames, sfcaps, diags);
            } else {
            }
        }
        i = i + 1;
    }
    return 0;
}

// Emit the `;`-joined stream for the parsed program: mode 0 = the obligation WORKLOAD
// (`{kind} {cap} {required} {actual};` per sink), mode 1 = the VERDICT (`C003;` per violated sink).
// The cap/record tables are built once across all modules; every module fn + actor handler/init is
// checked in program (pre-order-DFS) order.
fn cap_encode_mode(mode: i64, nodes: Arena<PNode>, kids: Vec<i64>, root: i64) -> str ! { Alloc } {
    let mut diags: Vec<str> = Vec::new();

    let mut mods: Vec<i64> = Vec::new();
    let cm: i64 = cap_collect_modules(nodes, kids, root, mods);
    let nmod: i64 = mods.len();

    let mut cap_names: Vec<str> = Vec::new();
    let mut cap_masks: Vec<i64> = Vec::new();
    let mut cap_auths: Vec<str> = Vec::new();
    let bm: i64 = cap_build_table(nodes, kids, mods, cap_names, cap_masks, cap_auths);

    let mut cdefs: Vec<TcCap> = Vec::new();
    let mut rdefs: Vec<TcRec> = Vec::new();
    let mut bi: i64 = 0;
    while bi < nmod {
        let mid: i64 = mods.get(bi);
        let bc: i64 = tc_build_caps(nodes, kids, mid, cdefs);
        let br: i64 = tc_build_recs(nodes, kids, mid, rdefs);
        bi = bi + 1;
    }

    let mut mi: i64 = 0;
    while mi < nmod {
        let mid: i64 = mods.get(mi);
        let mn: PNode = nodes.get(mid);
        let mut i: i64 = 0;
        while i < mn.child_count {
            let cid: i64 = kids.get(mn.child_start + i);
            let cn: PNode = nodes.get(cid);
            if cn.kind == P_K_FN {
                let gen: bool = cap_is_generic_fn(nodes, kids, cid);
                if gen {
                } else {
                    let empty_names: Vec<str> = Vec::new();
                    let empty_caps: Vec<str> = Vec::new();
                    let rf: i64 = cap_check_fn(mode, nodes, kids, cid, rdefs, cdefs, cap_names, cap_masks, cap_auths, empty_names, empty_caps, diags);
                }
            } else {
                if cn.kind == P_K_ACTOR {
                    let ra: i64 = cap_check_actor(mode, nodes, kids, cid, rdefs, cdefs, cap_names, cap_masks, cap_auths, diags);
                } else {
                }
            }
            i = i + 1;
        }
        mi = mi + 1;
    }

    let empty: str = "";
    let diagj: str = empty.join(diags);
    return diagj;
}

// The obligation WORKLOAD stream (`{kind} {cap} {required} {actual};` per sink) — CAP-1/2.
pub fn cap_encode(nodes: Arena<PNode>, kids: Vec<i64>, root: i64) -> str ! { Alloc } {
    return cap_encode_mode(0, nodes, kids, root);
}

// The VERDICT stream (`C003;` per violated obligation, program order) — CAP-3. The bitwise rule
// (actual & required != required) is provably == the Z3 discharge on slot-free programs (the CAP-0
// equivalence proof); C002/C004/C005 stay Z3-only (un-shadowable, the epic's honesty line).
pub fn cap_verdict_encode(nodes: Arena<PNode>, kids: Vec<i64>, root: i64) -> str ! { Alloc } {
    return cap_encode_mode(1, nodes, kids, root);
}
