// The SIGIL parser, in SIGIL — Stage 0 self-hosting, the second stage
// (docs/specs/parser-in-sigil.md). Consumes the SIGIL lexer's `Vec<Token>`
// (selfhost/lexer.sigil — the two files are inlined into one differential tool,
// so every top-level symbol here is `parser_`/`P_`/`PNode`-prefixed to stay
// disjoint from the lexer's namespace).
//
// PR-1 (the mechanics slice): a minimal recursive-descent parser proving the
// whole differential pipeline end-to-end — `module NAME;` + fn items
// (`pub? fn name() -> type { … }`) + `return expr;` statements + additive
// expressions (`+`/`-`, left-assoc) over int literals, identifiers, and
// parenthesized grouping (which, like the oracle, produces NO node). The
// broader grammar lands slice by slice (PR-2.x expressions, PR-3.x statements,
// PR-4.x items/types/patterns, PR-5.x the SIGIL exotica).
//
// The AST is a flat `Arena<PNode>`: children are NodeIds (the i64 `allocate`
// returned), stored contiguously in ONE shared child-id Vec and addressed by
// each node's `(child_start, child_count)` slice — unbounded arity, ET-P3.
// Nodes are allocated BOTTOM-UP (children first), so child ids are always
// back-references (ET-P4). Per-node fields:
//   kind   — the P_K_* tag (the harness contract, drift-locked by the host's
//            TOTAL kind_of maps, ET-P9);
//   start/end — the byte span, matching the oracle's span exactly;
//   value  — per-kind: the IntLit i64 / the operator's LEXER token tag
//            (T_PLUS=19, T_MINUS=20 — "reuse the lexer's value conventions")
//            / the text byte-length for name-bearing kinds / 0;
//   flags  — per-kind bitflags (K_FN bit0 = pub), the ET-P2 slot for
//            semantic markers that value can't carry;
//   text   — the name string for name-bearing kinds (module/fn/path/type
//            names, sliced from src — ASCII idents, so substr on token
//            boundaries is always char-boundary-safe); "" otherwise.
//
// ET-P5 (progress): every production consumes ≥1 token, EXCEPT at the Eof
// token, where `parser_bail` returns without advancing — and every loop's
// guard checks Eof first, so the parse always terminates and never reads past
// the token vector. ET-P8 (no-trap): malformed input yields P_K_ERR nodes,
// never a trap; real diagnostics (P-codes compared against the oracle's) land
// with the error corpus in a later slice.

module parser;

// ── node-kind tags (the harness contract) ────────────────────────────────────
const P_K_MODULE: i64 = 1;
const P_K_FN: i64 = 2;
const P_K_TYPE: i64 = 3;
const P_K_BLOCK: i64 = 4;
const P_K_RETURN: i64 = 10;
const P_K_LET: i64 = 11;
const P_K_LET_TUPLE: i64 = 12;
const P_K_ASSIGN: i64 = 13;
const P_K_EXPR_STMT: i64 = 14;
const P_K_IF: i64 = 15;
const P_K_WHILE: i64 = 16;
const P_K_FOR_IN: i64 = 17;
const P_K_BREAK: i64 = 18;
const P_K_CONTINUE: i64 = 19;
const P_K_MATCH: i64 = 20;
const P_K_MATCH_ARM: i64 = 21;
const P_K_PAT_LIT: i64 = 22;
const P_K_PAT_LIT_STR: i64 = 23;
const P_K_PAT_RANGE: i64 = 24;
const P_K_PAT_WILDCARD: i64 = 25;
const P_K_PAT_BINDING: i64 = 26;
const P_K_PAT_ENUM: i64 = 27;
const P_K_PAT_ARRAY: i64 = 28;
const P_K_BINARY: i64 = 30;
const P_K_LIT_INT: i64 = 31;
const P_K_PATH: i64 = 32;
const P_K_LIT_BOOL: i64 = 33;
const P_K_LIT_FLOAT: i64 = 34;
const P_K_LIT_STR: i64 = 35;
const P_K_BORROW: i64 = 36;
const P_K_CALL: i64 = 37;
const P_K_METHOD: i64 = 38;
const P_K_TRY: i64 = 39;
const P_K_INDEX: i64 = 40;
const P_K_SLICE: i64 = 41;
const P_K_RESULT_CTOR: i64 = 42;
const P_K_ARRAY: i64 = 43;
const P_K_TUPLE: i64 = 44;
const P_K_RECORD_CONSTRUCT: i64 = 45;
const P_K_TYPE_FN: i64 = 46;
const P_K_TYPE_ARRAY: i64 = 47;
const P_K_TYPE_TUPLE: i64 = 48;
const P_K_PARAM: i64 = 49;
const P_K_CLOSURE: i64 = 50;
const P_K_USE: i64 = 51;
const P_K_CONST: i64 = 52;
const P_K_RECORD_DEF: i64 = 53;
const P_K_FIELD: i64 = 54;
const P_K_TYPE_PARAM: i64 = 55;
const P_K_ENUM_DEF: i64 = 56;
const P_K_ENUM_VARIANT: i64 = 57;
const P_K_ENUM_FIELD: i64 = 58;
const P_K_IMPL: i64 = 59;
const P_K_TRAIT: i64 = 60;
const P_K_TRAIT_SIG: i64 = 61;
const P_K_EXTERN_FN: i64 = 62;
const P_K_EFFECT_DECL: i64 = 63;
const P_K_SEND: i64 = 64;
const P_K_ASK: i64 = 65;
const P_K_SPAWN: i64 = 66;
const P_K_CAP_RESTRICT: i64 = 67;
const P_K_CAP_RESTRICT_DEADLINE: i64 = 68;
const P_K_CAP_SPLIT: i64 = 69;
const P_K_CAP_DRAW: i64 = 70;
const P_K_GRANT: i64 = 71;
const P_K_HANDLE: i64 = 72;
const P_K_DECLASSIFY: i64 = 73;
const P_K_DECLASSIFY_CT: i64 = 74;
const P_K_REGION: i64 = 75;
const P_K_ACTOR: i64 = 76;
const P_K_ACTOR_INIT: i64 = 77;
const P_K_HANDLER: i64 = 78;
const P_K_CAP_TYPE: i64 = 79;
const P_K_REFINEMENT: i64 = 80;
// PR-E3: an f-string `f"…{e}…"` node. MUST match the harness `K_FSTRING`
// (parser_differential.rs). value + child_count = the part count (chunks + holes,
// strict alternation); children are, in order, a P_K_LIT_STR per literal chunk
// (its own span + decoded text, like a normal string literal) and the parsed
// expression per hole. Carries no name text (matches the oracle's `text: None`).
const P_K_FSTRING: i64 = 81;
// PR-E4: a `type Name = TypeExpr;` alias item. MUST match the harness `K_TYPE_ALIAS`.
// text = the alias name; value = name length; flags = pub bit; one child = the body
// type (the shared type grammar); span = (pub|type)..semi.
const P_K_TYPE_ALIAS: i64 = 82;
// P_K_PROGRAM (SH-PARSE-MM): the multi-module wrapper root. Children are P_K_MODULE
// nodes, emitted ONLY when a source has >1 `module` decl; a single-module source
// returns the bare P_K_MODULE root (byte-identical to before — ET-PMM-1). MUST match
// the harness `K_PROGRAM`.
const P_K_PROGRAM: i64 = 83;
// Capabilities-as-values (R1): a `mint <CapType> [(<deadline>,…)] for <target>`
// expression. MUST match the harness `K_MINT` (parser_differential.rs). text =
// the cap-type name; value = its byte-length; flags = the deadline-param count
// (0 = non-parametric); one child = the parsed `<target>` expression; span =
// `mint`..target.end. `mint` is a CONTEXTUAL keyword (a plain ident everywhere
// else), so the lexer needs no `mint` token.
const P_K_MINT: i64 = 84;
// Typestate (Epic 1, R3): a `[pub] state Name { S1, S2, … }` protocol decl.
// MUST match the harness `K_STATE_DEF`. text = `name;S1;S2;…` (protocol name +
// its closed marker set, joined `;`); value = its byte-length; flags = the pub
// bit; a leaf (markers ride text); span = (pub|state)..`}`. The state-kinded
// binder `<@S>` rides P_K_TYPE_PARAM with flags=1 (the R2 kind encoding).
const P_K_STATE_DEF: i64 = 85;
// Effect Handlers (EH0b): the clause form `handle <e> { Op(x) => .. }`. MUST
// match the harness `K_CLAUSE_HANDLE`. A LEAF spanning `handle`..`}` (the
// scrutinee + clause bodies are consumed but not emitted in this slice); no
// text. Disjoint from P_K_HANDLE (the bare row-widening form) — constraint
// C-PATHSEP.
const P_K_CLAUSE_HANDLE: i64 = 86;
// Effect Handlers (EH0b): `perform <Effect>.<op>(args)`. MUST match the harness
// `K_PERFORM`. A LEAF; text = `effect;op`, value = its byte-length; the args are
// consumed but not emitted in this slice. `perform` is a CONTEXTUAL keyword (a
// plain ident everywhere else), like `mint`.
const P_K_PERFORM: i64 = 87;
// RANGE-FOR (RF-M4): `for v in a..b { … }` — the exclusive i64 range loop
// (oracle parser.rs parse_for_in_statement, the DotDot branch). MUST match the
// harness `K_FOR_RANGE`. text = the loop var, POOLED (parser_kind_has_text
// includes 88, mirroring the harness `kind_has_text` and the oracle
// flatten_stmt's `text: Some(f.var)` — full text parity like P_K_FOR_IN; the
// stdlib bounded_map corpus exercises it); value = the var's byte-length;
// flags 0; children [start, end, body]; span = for..body.end. `..=` takes the
// generic parse-error path (the oracle rejects it P029 — no differential
// fixture may contain it).
const P_K_FOR_RANGE: i64 = 88;

// the oracle's tuple-arity cap (ast::MAX_TUPLE_ARITY).
const P_MAX_TUPLE_ARITY: i64 = 12;
// HKT (R4): the oracle's higher-kinded arity cap (ast::MAX_KIND_ARITY) — `* ->
// *` is arity 1, `* -> * -> *` is arity 2; arity 0 (a bare `*`) or > 2 is P027.
const P_MAX_KIND_ARITY: i64 = 2;
// a token no production accepts → an error node (kind only; P-codes are a
// later slice). Never emitted on oracle-clean input.
const P_K_ERR: i64 = 900;

// One AST node. `child_start`/`child_count` slice the shared child-id Vec.
record PNode {
    kind: i64,
    start: i64,
    end: i64,
    value: i64,
    flags: i64,
    child_start: i64,
    child_count: i64,
    text: str
}

// text-bearing kinds ship `text` through the encoder's pool (value = its
// byte-length): the name-bearing kinds, plus K_LIT_STR whose text is the
// DECODED string value (escapes applied — ET-3's byte-for-byte comparison;
// arbitrary bytes are safe because the pool is length-walked). The host's
// decoder mirrors this set exactly.
fn parser_kind_has_text(k: i64) -> bool {
    if k == P_K_MODULE {
        return true;
    } else {
    }
    if k == P_K_TYPE_FN {
        // fn-type latent effect row (";!;Eff1;Eff2", ";!" = explicit-empty,
        // "" = no row) — text-bearing since fn-type rows landed; value = len.
        return true;
    } else {
    }
    if k == P_K_TYPE_ALIAS {
        return true;
    } else {
    }
    if k == P_K_MINT {
        // the minted cap-type name (R1).
        return true;
    } else {
    }
    if k == P_K_PERFORM {
        // `effect;op` — the performed operation (EH0b).
        return true;
    } else {
    }
    if k == P_K_FOR_RANGE {
        // the loop var (RF-M4) — pooled like P_K_FOR_IN's.
        return true;
    } else {
    }
    if k == P_K_STATE_DEF {
        // `name;S1;S2;…` — protocol name + its closed marker set (R3).
        return true;
    } else {
    }
    if k == P_K_FN {
        return true;
    } else {
    }
    if k == P_K_TYPE {
        return true;
    } else {
    }
    if k == P_K_PATH {
        return true;
    } else {
    }
    if k == P_K_LIT_STR {
        return true;
    } else {
    }
    if k == P_K_CALL {
        return true;
    } else {
    }
    if k == P_K_METHOD {
        return true;
    } else {
    }
    if k == P_K_RECORD_CONSTRUCT {
        // `type;field1;field2;…` — the type name + every field name, joined
        // with `;` (idents are ASCII without `;`, so the joining is unambiguous).
        return true;
    } else {
    }
    if k == P_K_LET {
        return true;
    } else {
    }
    if k == P_K_LET_TUPLE {
        // the binding names joined with `;` (per-binding mut rides flags).
        return true;
    } else {
    }
    if k == P_K_FOR_IN {
        return true;
    } else {
    }
    if k == P_K_PAT_LIT_STR {
        return true;
    } else {
    }
    if k == P_K_PAT_BINDING {
        return true;
    } else {
    }
    if k == P_K_PAT_ENUM {
        // `type;variant;binding1;…` — the type name is EMPTY for a bare
        // variant (`Some(x)` → `;Some;x`), mirroring the oracle's inferred
        // type_name.
        return true;
    } else {
    }
    if k == P_K_PAT_ARRAY {
        // `;`-joined element words (a binding name, or `_` for a wildcard) then
        // the rest name iff named — empty for `[]` / `[..]` (flags disambiguate).
        return true;
    } else {
    }
    if k == P_K_PARAM {
        // the name, or `name;region` when an `@in r` annotation is present.
        return true;
    } else {
    }
    if k == P_K_USE {
        return true;
    } else {
    }
    if k == P_K_CONST {
        // `name;<literal>` — int rendered via itoa, bool as true/false, str
        // as the decoded bytes (the pool is length-walked, arbitrary bytes ok).
        return true;
    } else {
    }
    if k == P_K_RECORD_DEF {
        return true;
    } else {
    }
    if k == P_K_FIELD {
        return true;
    } else {
    }
    if k == P_K_TYPE_PARAM {
        // the name, or `name;bound1;bound2;…` with trait bounds.
        return true;
    } else {
    }
    if k == P_K_ENUM_DEF {
        return true;
    } else {
    }
    if k == P_K_ENUM_VARIANT {
        return true;
    } else {
    }
    if k == P_K_ENUM_FIELD {
        // the field name for the named form; EMPTY for positional fields.
        return true;
    } else {
    }
    if k == P_K_IMPL {
        // `trait;type` — the trait name is EMPTY for an inherent impl.
        return true;
    } else {
    }
    if k == P_K_TRAIT {
        return true;
    } else {
    }
    if k == P_K_TRAIT_SIG {
        return true;
    } else {
    }
    if k == P_K_EXTERN_FN {
        // `abi;name(;eff)*` — the effect names ride the text (the extern row
        // is a plain Vec, so no-row and `! {}` are both the empty suffix).
        return true;
    } else {
    }
    if k == P_K_EFFECT_DECL {
        return true;
    } else {
    }
    if k == P_K_SEND {
        return true;
    } else {
    }
    if k == P_K_ASK {
        return true;
    } else {
    }
    if k == P_K_CAP_RESTRICT {
        // `cap-path;restriction`.
        return true;
    } else {
    }
    if k == P_K_CAP_RESTRICT_DEADLINE {
        return true;
    } else {
    }
    if k == P_K_CAP_SPLIT {
        return true;
    } else {
    }
    if k == P_K_CAP_DRAW {
        return true;
    } else {
    }
    if k == P_K_HANDLE {
        // the handled effect names joined `;` (EMPTY for `handle { … }`).
        return true;
    } else {
    }
    if k == P_K_REGION {
        return true;
    } else {
    }
    if k == P_K_ACTOR {
        return true;
    } else {
    }
    if k == P_K_HANDLER {
        return true;
    } else {
    }
    if k == P_K_CAP_TYPE {
        // `name;auth,auth;param,param` — authorities and parameters as
        // comma-joined sublists in two `;`-separated slots.
        return true;
    } else {
    }
    if k == P_K_REFINEMENT {
        // the LHS field name, or `@` for a return-refinement.
        return true;
    } else {
    }
    return false;
}

// Copy a locally-collected child-id list into the shared kids Vec (one
// contiguous run — nested parses interleave their OWN appends, so children are
// collected locally first and committed at parent-allocation time). Returns
// the run's start index (the parent's `child_start`).
fn parser_kids_commit(kids: Vec<i64> @Mut, local: Vec<i64>) -> i64 ! { Alloc } {
    let cstart: i64 = kids.len();
    let n: i64 = local.len();
    let mut i: i64 = 0;
    while i < n {
        let id: i64 = local.get(i);
        let pushed: i64 = kids.push(id);
        i = i + 1;
    }
    return cstart;
}

// The uniform expect-failure path: an error node spanning the offending token.
// Advances past it UNLESS it is Eof (ET-P5: progress everywhere except the
// terminal state, whose non-advance every loop guard terminates on).
fn parser_bail(toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut) -> (i64, i64) ! { Alloc } {
    let t: Token = toks.get(pos);
    let e: i64 = nodes.allocate(PNode { kind: P_K_ERR, start: t.start, end: t.end, value: 0, flags: 0, child_start: 0, child_count: 0, text: "" });
    if t.kind == T_EOF {
        return (e, pos);
    } else {
    }
    return (e, pos + 1);
}

// ── expressions ──────────────────────────────────────────────────────────────
//
// The full 11-level precedence climb, mirroring the oracle's chain exactly:
//   expr = equality (== !=) → comparison (< <= > >=) → bitor (|) → bitand (&)
//        → shift (<< >>) → additive (+ -) → multiplicative (* / %)
//        → prefix (& &mut borrow, unary - fold/desugar, ! desugar) → primary.
// Every binary level is a left-assoc loop; the Binary node's value is the
// operator's LEXER token tag and its span is lhs.start..rhs.end. Prefix falls
// to postfix (`?` / index / slice), postfix to primary (literals, paths,
// calls, method calls, grouping).

// Allocate a Binary node over two parsed children (span = lhs.start..rhs.end).
fn parser_mk_binary(op: i64, lhs: i64, rhs: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> i64 ! { Alloc } {
    let ln: PNode = nodes.get(lhs);
    let rn: PNode = nodes.get(rhs);
    let mut local: Vec<i64> = Vec::new();
    let q1: i64 = local.push(lhs);
    let q2: i64 = local.push(rhs);
    let cstart: i64 = parser_kids_commit(kids, local);
    let bid: i64 = nodes.allocate(PNode { kind: P_K_BINARY, start: ln.start, end: rn.end, value: op, flags: 0, child_start: cstart, child_count: 2, text: "" });
    return bid;
}

// Parse a `(`-led argument list into `argl`. `pos` is AT the `(`. Returns
// `(end_byte, new_pos)` — `end_byte` is the closing `)`'s end, or -1 when the
// list never closes (the caller bails at `new_pos`). Mirrors the oracle's arg
// loop exactly: exprs separated by commas; a non-comma breaks to expect-`)`.
fn parser_args(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut, argl: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let mut p: i64 = pos + 1;
    let mut scanning: bool = true;
    while scanning {
        let t: Token = toks.get(p);
        if t.kind == T_RPAREN {
            scanning = false;
        } else {
            if t.kind == T_EOF {
                scanning = false;
            } else {
                let (aid, p2) = parser_expr(src, toks, p, nodes, kids);
                let q: i64 = argl.push(aid);
                p = p2;
                let tc: Token = toks.get(p);
                if tc.kind == T_COMMA {
                    p = p + 1;
                } else {
                    scanning = false;
                }
            }
        }
    }
    let tr: Token = toks.get(p);
    if tr.kind == T_RPAREN {
        return (tr.end, p + 1);
    } else {
    }
    return (0 - 1, p);
}

// primary := INT | BOOL | FLOAT | STR | path-led | '(' expr ')'   (grouping
// returns the INNER node — the oracle carries no paren node; tuple literals,
// array literals, record construction, and closures are later slices).
//
// path-led mirrors the oracle's parse_ident_led_expr + parse_path_from_first:
// dots and `::` both EXTEND the path's segments (the oracle builds NO
// FieldAccess at parse time — `a.b` is a 2-segment Path; resolution happens in
// type-check). Then `(` decides:
//   - single-segment `Ok`/`Err`  → ResultCtor (exactly one argument);
//   - multi-segment + `(`        → MethodCall: the LAST segment is the method
//     name; the receiver is a synthesized Path node over the leading segments
//     whose span is the FULL path span (incl. the method segment) — the
//     oracle's quirk, replicated exactly. (The actor/cap special names
//     send/ask/restrict/… are the PR-5 exotica slice.)
//   - otherwise + `(`            → Call: the callee path rides `text` (joined
//     with `::`); the arguments are the children.
//   - no `(`                     → a Path node (text = segments joined `::`).
// Turbofish `::<T>` and `.`-segments that aren't plain idents are later slices
// (the path scan stops; the stray token bails at the statement layer).
// PR-E3: parse an f-string from the lexer's token sequence — T_FSTR_BEGIN, then
// (ALWAYS, ET-E3 strict alternation) a T_FSTR_CHUNK literal run and, if a hole
// follows, T_FSTR_HOLE_START, the hole's expression tokens, T_FSTR_HOLE_END —
// closing T_FSTR_END. Builds a P_K_FSTRING node whose children are, in order, a
// P_K_LIT_STR per chunk (decoded text on `text`, exactly like a normal string
// literal) and the parsed hole expression per hole; value + child_count = the part
// count, span = FStrBegin.start .. FStrEnd.end. parser_expr hard-stops at the
// non-expression T_FSTR_HOLE_END (ET-E9); a malformed hole / missing terminator
// bails. Mirror of the Rust parse_fstring_expr.
fn parser_fstring(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let tb: Token = toks.get(pos);
    let fstart: i64 = tb.start;
    let mut p: i64 = pos + 1;
    let mut localc: Vec<i64> = Vec::new();
    let mut fend: i64 = tb.end;
    let mut scanning: i64 = 1;
    while scanning == 1 {
        let tc: Token = toks.get(p);
        if tc.kind == T_FSTR_CHUNK {
            let clen: i64 = tc.text.len();
            let cid: i64 = nodes.allocate(PNode { kind: P_K_LIT_STR, start: tc.start, end: tc.end, value: clen, flags: 0, child_start: 0, child_count: 0, text: tc.text });
            let pushc: i64 = localc.push(cid);
            p = p + 1;
        } else {
            if tc.kind == T_FSTR_HOLE_START {
                let (hid, hp) = parser_expr(src, toks, p + 1, nodes, kids);
                let pushh: i64 = localc.push(hid);
                let te: Token = toks.get(hp);
                if te.kind == T_FSTR_HOLE_END {
                    p = hp + 1;
                } else {
                    return parser_bail(toks, hp, nodes);
                }
            } else {
                if tc.kind == T_FSTR_END {
                    fend = tc.end;
                    p = p + 1;
                    scanning = 0;
                } else {
                    return parser_bail(toks, p, nodes);
                }
            }
        }
    }
    let partcount: i64 = localc.len();
    let cstart: i64 = parser_kids_commit(kids, localc);
    let idf: i64 = nodes.allocate(PNode { kind: P_K_FSTRING, start: fstart, end: fend, value: partcount, flags: 0, child_start: cstart, child_count: partcount, text: "" });
    return (idf, p);
}

// Capabilities-as-values (R1): parse `mint <CapType> [(<deadline>,…)] for
// <target>`. The caller (parser_primary's IDENT path) dispatches here ONLY when
// the current ident is `mint` AND the next token is another ident — the
// two-ident shape no ordinary expression has. Mirrors the Rust parser's
// parse_mint_expr (parser.rs:4384): the optional positional `i64` deadline
// literals ride `flags` as a COUNT (their values are a type-check concern), the
// `<target>` is a full sub-expression child, and the span runs `mint`..target.
fn parser_mint(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let t: Token = toks.get(pos);
    let tcap: Token = toks.get(pos + 1);
    let capname: str = src.substr(tcap.start, tcap.end);
    let caplen: i64 = capname.len();
    let mut p: i64 = pos + 2;
    let mut pcount: i64 = 0;
    // Optional positional deadline literals: `mint Approval(2030[, …]) for t`.
    let tlp: Token = toks.get(p);
    if tlp.kind == T_LPAREN {
        p = p + 1;
        let mut scanning: bool = true;
        while scanning {
            let td: Token = toks.get(p);
            if td.kind == T_INT {
                pcount = pcount + 1;
                p = p + 1;
                let tcm: Token = toks.get(p);
                if tcm.kind == T_COMMA {
                    p = p + 1;
                } else {
                    scanning = false;
                }
            } else {
                return parser_bail(toks, p, nodes);
            }
        }
        let trp: Token = toks.get(p);
        if trp.kind == T_RPAREN {
            p = p + 1;
        } else {
            return parser_bail(toks, p, nodes);
        }
    } else {
    }
    let tfor: Token = toks.get(p);
    if tfor.kind == T_KW_FOR {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let (tgt, pt) = parser_expr(src, toks, p, nodes, kids);
    let tnode: PNode = nodes.get(tgt);
    let mut localm: Vec<i64> = Vec::new();
    let qm: i64 = localm.push(tgt);
    let cstartm: i64 = parser_kids_commit(kids, localm);
    let idm: i64 = nodes.allocate(PNode { kind: P_K_MINT, start: t.start, end: tnode.end, value: caplen, flags: pcount, child_start: cstartm, child_count: 1, text: capname });
    return (idm, pt);
}

// Effect Handlers (EH0b): scan a braced body starting at token offset `brace_off`
// (a `{`), tracking `(){}[]` depth, and return true if a `=>` appears at the
// body's own depth (depth 1). A nested `match`/block pushes deeper, so its arrows
// never trip this. Token-bounded, side-effect-free. Mirrors the oracle.
fn parser_body_has_top_level_fat_arrow(toks: Vec<Token>, brace_off: i64) -> bool {
    let mut depth: i64 = 0;
    let mut i: i64 = brace_off;
    let mut found: bool = false;
    let mut done: bool = false;
    while done == false {
        let ti: Token = toks.get(i);
        if ti.kind == T_EOF {
            done = true;
        } else {
            if ti.kind == T_LBRACE {
                depth = depth + 1;
            } else {
            }
            if ti.kind == T_LPAREN {
                depth = depth + 1;
            } else {
            }
            if ti.kind == T_LBRACKET {
                depth = depth + 1;
            } else {
            }
            if ti.kind == T_FATARROW {
                if depth == 1 {
                    found = true;
                    done = true;
                } else {
                }
            } else {
            }
            if ti.kind == T_RBRACE {
                depth = depth - 1;
                if depth == 0 {
                    done = true;
                } else {
                }
            } else {
            }
            if ti.kind == T_RPAREN {
                depth = depth - 1;
            } else {
            }
            if ti.kind == T_RBRACKET {
                depth = depth - 1;
            } else {
            }
            i = i + 1;
        }
    }
    return found;
}

// Effect Handlers (EH0b, C-PATHSEP): lookahead from a `handle` token (header at
// `hdrpos`) deciding clause-form vs bare-form. Bare shape is `Ident (, Ident)* {`
// whose body has no top-level `=>`; anything else — a non-ident header, or such a
// body with a depth-1 `=>` — is the clause form. Mirrors the oracle.
fn parser_at_clause_handle(toks: Vec<Token>, hdrpos: i64) -> bool {
    let mut i: i64 = hdrpos;
    let mut result: bool = false;
    let mut decided: bool = false;
    while decided == false {
        let ti: Token = toks.get(i);
        if ti.kind == T_IDENT {
            let tj: Token = toks.get(i + 1);
            if tj.kind == T_COMMA {
                i = i + 2;
            } else {
                if tj.kind == T_LBRACE {
                    result = parser_body_has_top_level_fat_arrow(toks, i + 1);
                    decided = true;
                } else {
                    result = true;
                    decided = true;
                }
            }
        } else {
            result = true;
            decided = true;
        }
    }
    return result;
}

// Effect Handlers (EH0b): the clause form `handle <scrutinee> { Op(x) => .. }`.
// A LEAF — locate the body `{` (first `{` at paren/bracket depth 0), depth-scan
// to its matching `}`, and emit one P_K_CLAUSE_HANDLE spanning `handle`..`}`.
// The scrutinee and clause bodies are consumed but NOT parsed into children in
// this slice (so `resume` need not be mirrored). Mirrors the oracle leaf.
fn parser_clause_handle(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut) -> (i64, i64) ! { Alloc } {
    let t0: Token = toks.get(pos);
    // Find the body `{` at paren/bracket depth 0 (the scrutinee may contain `()`).
    let mut p: i64 = pos + 1;
    let mut d0: i64 = 0;
    let mut findb: bool = true;
    while findb {
        let tb: Token = toks.get(p);
        if tb.kind == T_EOF {
            return parser_bail(toks, p, nodes);
        } else {
        }
        if tb.kind == T_LPAREN {
            d0 = d0 + 1;
        } else {
        }
        if tb.kind == T_LBRACKET {
            d0 = d0 + 1;
        } else {
        }
        if tb.kind == T_RPAREN {
            d0 = d0 - 1;
        } else {
        }
        if tb.kind == T_RBRACKET {
            d0 = d0 - 1;
        } else {
        }
        if tb.kind == T_LBRACE {
            if d0 == 0 {
                findb = false;
            } else {
                p = p + 1;
            }
        } else {
            p = p + 1;
        }
    }
    // p is at the body `{`. Depth-scan to the matching `}`.
    let mut depth: i64 = 0;
    let mut scanb: bool = true;
    let mut endpos: i64 = p;
    while scanb {
        let tc: Token = toks.get(p);
        if tc.kind == T_EOF {
            return parser_bail(toks, p, nodes);
        } else {
        }
        if tc.kind == T_LBRACE {
            depth = depth + 1;
        } else {
        }
        if tc.kind == T_LPAREN {
            depth = depth + 1;
        } else {
        }
        if tc.kind == T_LBRACKET {
            depth = depth + 1;
        } else {
        }
        if tc.kind == T_RBRACE {
            depth = depth - 1;
            if depth == 0 {
                endpos = p;
                scanb = false;
            } else {
            }
        } else {
        }
        if tc.kind == T_RPAREN {
            depth = depth - 1;
        } else {
        }
        if tc.kind == T_RBRACKET {
            depth = depth - 1;
        } else {
        }
        if scanb {
            p = p + 1;
        } else {
        }
    }
    let tclose: Token = toks.get(endpos);
    let id: i64 = nodes.allocate(PNode { kind: P_K_CLAUSE_HANDLE, start: t0.start, end: tclose.end, value: 0, flags: 0, child_start: 0, child_count: 0, text: "" });
    return (id, endpos + 1);
}

// Effect Handlers (EH0b): `perform <Effect>.<op>(args)`. A LEAF — text =
// `effect;op`; depth-scan the argument list to its matching `)`. Mirrors the
// oracle leaf (args consumed but not emitted in this slice).
fn parser_perform(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut) -> (i64, i64) ! { Alloc } {
    let t0: Token = toks.get(pos);
    let teff: Token = toks.get(pos + 1);
    let top: Token = toks.get(pos + 3);
    if top.kind == T_IDENT {
    } else {
        return parser_bail(toks, pos + 3, nodes);
    }
    let tlp: Token = toks.get(pos + 4);
    if tlp.kind == T_LPAREN {
    } else {
        return parser_bail(toks, pos + 4, nodes);
    }
    let mut p: i64 = pos + 4;
    let mut depth: i64 = 0;
    let mut scanp: bool = true;
    let mut endpos: i64 = p;
    while scanp {
        let tc: Token = toks.get(p);
        if tc.kind == T_EOF {
            return parser_bail(toks, p, nodes);
        } else {
        }
        if tc.kind == T_LPAREN {
            depth = depth + 1;
        } else {
        }
        if tc.kind == T_LBRACE {
            depth = depth + 1;
        } else {
        }
        if tc.kind == T_LBRACKET {
            depth = depth + 1;
        } else {
        }
        if tc.kind == T_RBRACE {
            depth = depth - 1;
        } else {
        }
        if tc.kind == T_RBRACKET {
            depth = depth - 1;
        } else {
        }
        if tc.kind == T_RPAREN {
            depth = depth - 1;
            if depth == 0 {
                endpos = p;
                scanp = false;
            } else {
            }
        } else {
        }
        if scanp {
            p = p + 1;
        } else {
        }
    }
    let trp: Token = toks.get(endpos);
    let effname: str = src.substr(teff.start, teff.end);
    let opname: str = src.substr(top.start, top.end);
    let j: str = effname.concat(";");
    let text: str = j.concat(opname);
    let tlen: i64 = text.len();
    let id: i64 = nodes.allocate(PNode { kind: P_K_PERFORM, start: t0.start, end: trp.end, value: tlen, flags: 0, child_start: 0, child_count: 0, text: text });
    return (id, endpos + 1);
}

fn parser_primary(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let t: Token = toks.get(pos);
    if t.kind == T_FSTR_BEGIN {
        return parser_fstring(src, toks, pos, nodes, kids);
    } else {
    }
    if t.kind == T_INT {
        let id: i64 = nodes.allocate(PNode { kind: P_K_LIT_INT, start: t.start, end: t.end, value: t.value, flags: 0, child_start: 0, child_count: 0, text: "" });
        return (id, pos + 1);
    } else {
    }
    if t.kind == T_BOOL {
        let idb: i64 = nodes.allocate(PNode { kind: P_K_LIT_BOOL, start: t.start, end: t.end, value: t.value, flags: 0, child_start: 0, child_count: 0, text: "" });
        return (idb, pos + 1);
    } else {
    }
    if t.kind == T_FLOAT {
        // span-only (AG-P4 inherits AG-L3 — no parse_f64; the value is elided).
        let idf: i64 = nodes.allocate(PNode { kind: P_K_LIT_FLOAT, start: t.start, end: t.end, value: 0, flags: 0, child_start: 0, child_count: 0, text: "" });
        return (idf, pos + 1);
    } else {
    }
    if t.kind == T_STR {
        // the DECODED value rides `text` (the lexer decoded the escapes).
        let tlen: i64 = t.text.len();
        let ids: i64 = nodes.allocate(PNode { kind: P_K_LIT_STR, start: t.start, end: t.end, value: tlen, flags: 0, child_start: 0, child_count: 0, text: t.text });
        return (ids, pos + 1);
    } else {
    }
    if t.kind == T_IDENT {
        // Capabilities-as-values (R1): `mint` is a CONTEXTUAL keyword. It leads
        // a `mint <CapType> for <target>` expression ONLY when the current ident
        // is `mint` AND the next token is another ident (the cap-type name) — a
        // shape no ordinary expression has. Mirrors parser.rs:4082 (peek =
        // cursor+1). Everywhere else (`mint(…)`, `mint::x`, `.mint()`, a bare
        // `mint` value) it falls through to the path scan as a plain identifier.
        let mname: str = src.substr(t.start, t.end);
        if mname.bytes_eq("mint") {
            let tpk: Token = toks.get(pos + 1);
            if tpk.kind == T_IDENT {
                return parser_mint(src, toks, pos, nodes, kids);
            } else {
            }
        } else {
        }
        // Effect Handlers (EH0b): `perform` is CONTEXTUAL — it leads a
        // `perform <Effect>.<op>(args)` expression ONLY on the unambiguous shape
        // `perform <Ident> .` (no ordinary expression is `ident ident`).
        if mname.bytes_eq("perform") {
            let tpi: Token = toks.get(pos + 1);
            if tpi.kind == T_IDENT {
                let tpd: Token = toks.get(pos + 2);
                if tpd.kind == T_DOT {
                    return parser_perform(src, toks, pos, nodes);
                } else {
                }
            } else {
            }
        } else {
        }
        // ── the path scan: ident (('::'|'.') ident)* ──
        let mut full: str = src.substr(t.start, t.end);
        let mut recv: str = "";
        let mut lastseg: str = full;
        let mut segcount: i64 = 1;
        let mut pend: i64 = t.end;
        let mut p: i64 = pos + 1;
        let mut scanning: bool = true;
        while scanning {
            let tj: Token = toks.get(p);
            let mut isjoin: bool = false;
            if tj.kind == T_COLONCOLON {
                isjoin = true;
            } else {
            }
            if tj.kind == T_DOT {
                isjoin = true;
            } else {
            }
            if isjoin {
                let ts: Token = toks.get(p + 1);
                let mut issegment: bool = false;
                if ts.kind == T_IDENT {
                    issegment = true;
                } else {
                }
                if tj.kind == T_DOT {
                    // `.send` / `.ask` lex as KEYWORD tokens but are valid
                    // `.`-led member segments (the oracle's
                    // expect_path_member_segment) — the actor-op names.
                    if ts.kind == T_KW_SEND {
                        issegment = true;
                    } else {
                    }
                    if ts.kind == T_KW_ASK {
                        issegment = true;
                    } else {
                    }
                } else {
                }
                if issegment {
                    let seg: str = src.substr(ts.start, ts.end);
                    recv = full;
                    lastseg = seg;
                    let j1: str = full.concat("::");
                    full = j1.concat(seg);
                    segcount = segcount + 1;
                    pend = ts.end;
                    p = p + 2;
                } else {
                    scanning = false;
                }
            } else {
                scanning = false;
            }
        }
        let tl: Token = toks.get(p);
        if tl.kind == T_LPAREN {
            // single-segment Ok/Err → ResultCtor (exactly one argument).
            let mut is_ctor: i64 = 0 - 1;
            if segcount == 1 {
                if full.bytes_eq("Ok") {
                    is_ctor = 1;
                } else {
                }
                if full.bytes_eq("Err") {
                    is_ctor = 0;
                } else {
                }
            } else {
            }
            if is_ctor >= 0 {
                let (vid, pv) = parser_expr(src, toks, p + 1, nodes, kids);
                let tr: Token = toks.get(pv);
                if tr.kind == T_RPAREN {
                    let mut localc: Vec<i64> = Vec::new();
                    let qc: i64 = localc.push(vid);
                    let cstartc: i64 = parser_kids_commit(kids, localc);
                    let idc: i64 = nodes.allocate(PNode { kind: P_K_RESULT_CTOR, start: t.start, end: tr.end, value: 0, flags: is_ctor, child_start: cstartc, child_count: 1, text: "" });
                    return (idc, pv + 1);
                } else {
                }
                return parser_bail(toks, pv, nodes);
            } else {
            }
            if segcount > 1 {
                // The actor/cap ops claim these LAST SEGMENTS before the
                // generic MethodCall (the oracle's try_parse_actor_op_expr).
                // The target path text = the LEADING segments; the op node's
                // span = path.start..rparen.end.
                if lastseg.bytes_eq("send") {
                    // send(message) — exactly one argument expression.
                    let (vid, pv) = parser_expr(src, toks, p + 1, nodes, kids);
                    let tr0: Token = toks.get(pv);
                    if tr0.kind == T_RPAREN {
                        let mut locals0: Vec<i64> = Vec::new();
                        let qs0: i64 = locals0.push(vid);
                        let cstart0: i64 = parser_kids_commit(kids, locals0);
                        let rlen0: i64 = recv.len();
                        let id0: i64 = nodes.allocate(PNode { kind: P_K_SEND, start: t.start, end: tr0.end, value: rlen0, flags: 0, child_start: cstart0, child_count: 1, text: recv });
                        return (id0, pv + 1);
                    } else {
                    }
                    return parser_bail(toks, pv, nodes);
                } else {
                }
                if lastseg.bytes_eq("ask") {
                    // ask(message, [timeout:] expr) — the label form and the
                    // bare form produce the SAME AST (no flag stored).
                    let (mid0, pv1) = parser_expr(src, toks, p + 1, nodes, kids);
                    let tc0: Token = toks.get(pv1);
                    if tc0.kind == T_COMMA {
                    } else {
                        return parser_bail(toks, pv1, nodes);
                    }
                    let mut pt0: i64 = pv1 + 1;
                    let tl0: Token = toks.get(pt0);
                    if tl0.kind == T_IDENT {
                        let lname: str = src.substr(tl0.start, tl0.end);
                        if lname.bytes_eq("timeout") {
                            let tcl0: Token = toks.get(pt0 + 1);
                            if tcl0.kind == T_COLON {
                                pt0 = pt0 + 2;
                            } else {
                            }
                        } else {
                        }
                    } else {
                    }
                    let (tid0, pv2) = parser_expr(src, toks, pt0, nodes, kids);
                    let tr1: Token = toks.get(pv2);
                    if tr1.kind == T_RPAREN {
                        let mut locals1: Vec<i64> = Vec::new();
                        let qs1: i64 = locals1.push(mid0);
                        let qs2: i64 = locals1.push(tid0);
                        let cstart1: i64 = parser_kids_commit(kids, locals1);
                        let rlen1: i64 = recv.len();
                        let id1: i64 = nodes.allocate(PNode { kind: P_K_ASK, start: t.start, end: tr1.end, value: rlen1, flags: 0, child_start: cstart1, child_count: 2, text: recv });
                        return (id1, pv2 + 1);
                    } else {
                    }
                    return parser_bail(toks, pv2, nodes);
                } else {
                }
                if lastseg.bytes_eq("restrict") {
                    // restrict(Authority) — a single IDENT, not an expression.
                    let ta0: Token = toks.get(p + 1);
                    if ta0.kind == T_IDENT {
                        let tr2: Token = toks.get(p + 2);
                        if tr2.kind == T_RPAREN {
                            let auth: str = src.substr(ta0.start, ta0.end);
                            let j0: str = recv.concat(";");
                            let rtext: str = j0.concat(auth);
                            let rtlen: i64 = rtext.len();
                            let id2: i64 = nodes.allocate(PNode { kind: P_K_CAP_RESTRICT, start: t.start, end: tr2.end, value: rtlen, flags: 0, child_start: 0, child_count: 0, text: rtext });
                            return (id2, p + 3);
                        } else {
                        }
                        return parser_bail(toks, p + 2, nodes);
                    } else {
                    }
                    return parser_bail(toks, p + 1, nodes);
                } else {
                }
                if lastseg.bytes_eq("restrict_deadline") {
                    // restrict_deadline(INT) — a raw IntLit; flags = the value.
                    let td0: Token = toks.get(p + 1);
                    if td0.kind == T_INT {
                        let tr3: Token = toks.get(p + 2);
                        if tr3.kind == T_RPAREN {
                            let rlen2: i64 = recv.len();
                            let id3: i64 = nodes.allocate(PNode { kind: P_K_CAP_RESTRICT_DEADLINE, start: t.start, end: tr3.end, value: rlen2, flags: td0.value, child_start: 0, child_count: 0, text: recv });
                            return (id3, p + 3);
                        } else {
                        }
                        return parser_bail(toks, p + 2, nodes);
                    } else {
                    }
                    return parser_bail(toks, p + 1, nodes);
                } else {
                }
                if lastseg.bytes_eq("split") {
                    let (aid0, pv3) = parser_expr(src, toks, p + 1, nodes, kids);
                    let tr4: Token = toks.get(pv3);
                    if tr4.kind == T_RPAREN {
                        let mut locals2: Vec<i64> = Vec::new();
                        let qs3: i64 = locals2.push(aid0);
                        let cstart2: i64 = parser_kids_commit(kids, locals2);
                        let rlen3: i64 = recv.len();
                        let id4: i64 = nodes.allocate(PNode { kind: P_K_CAP_SPLIT, start: t.start, end: tr4.end, value: rlen3, flags: 0, child_start: cstart2, child_count: 1, text: recv });
                        return (id4, pv3 + 1);
                    } else {
                    }
                    return parser_bail(toks, pv3, nodes);
                } else {
                }
                if lastseg.bytes_eq("draw") {
                    let (aid1, pv4) = parser_expr(src, toks, p + 1, nodes, kids);
                    let tr5: Token = toks.get(pv4);
                    if tr5.kind == T_RPAREN {
                        let mut locals3: Vec<i64> = Vec::new();
                        let qs4: i64 = locals3.push(aid1);
                        let cstart3: i64 = parser_kids_commit(kids, locals3);
                        let rlen4: i64 = recv.len();
                        let id5: i64 = nodes.allocate(PNode { kind: P_K_CAP_DRAW, start: t.start, end: tr5.end, value: rlen4, flags: 0, child_start: cstart3, child_count: 1, text: recv });
                        return (id5, pv4 + 1);
                    } else {
                    }
                    return parser_bail(toks, pv4, nodes);
                } else {
                }
                // MethodCall: receiver = a Path node over the LEADING segments
                // at the FULL path span (the oracle's quirk).
                let rlen: i64 = recv.len();
                let rid: i64 = nodes.allocate(PNode { kind: P_K_PATH, start: t.start, end: pend, value: rlen, flags: 0, child_start: 0, child_count: 0, text: recv });
                let mut localm: Vec<i64> = Vec::new();
                let qm: i64 = localm.push(rid);
                let (mend, pm) = parser_args(src, toks, p, nodes, kids, localm);
                if mend < 0 {
                    return parser_bail(toks, pm, nodes);
                } else {
                }
                let mlen: i64 = lastseg.len();
                let cstartm: i64 = parser_kids_commit(kids, localm);
                let idm: i64 = nodes.allocate(PNode { kind: P_K_METHOD, start: t.start, end: mend, value: mlen, flags: 0, child_start: cstartm, child_count: localm.len(), text: lastseg });
                return (idm, pm);
            } else {
            }
            // plain Call: the callee path rides text; the args are children.
            let mut localg: Vec<i64> = Vec::new();
            let (cend, pc) = parser_args(src, toks, p, nodes, kids, localg);
            if cend < 0 {
                return parser_bail(toks, pc, nodes);
            } else {
            }
            let flen: i64 = full.len();
            let cstartg: i64 = parser_kids_commit(kids, localg);
            let idg: i64 = nodes.allocate(PNode { kind: P_K_CALL, start: t.start, end: cend, value: flen, flags: 0, child_start: cstartg, child_count: localg.len(), text: full });
            return (idg, pc);
        } else {
        }
        if tl.kind == T_LBRACE {
            // Record construction `Name { field: value, … }` — the oracle's
            // disambiguation peek: `{` followed by IDENT `:` (otherwise the `{`
            // belongs to enclosing syntax and the path stands alone). The
            // IDENT peek guarantees p+2 is in bounds (an ident is never the
            // final Eof token). The node's text is `type;field1;field2;…`; the
            // children are the field values in source order.
            let t1: Token = toks.get(p + 1);
            if t1.kind == T_IDENT {
                let t2: Token = toks.get(p + 2);
                if t2.kind == T_COLON {
                    let mut rtext: str = full;
                    let mut localr: Vec<i64> = Vec::new();
                    let mut pr: i64 = p + 1;
                    let mut scanningr: bool = true;
                    while scanningr {
                        let tf: Token = toks.get(pr);
                        if tf.kind == T_RBRACE {
                            scanningr = false;
                        } else {
                            if tf.kind == T_EOF {
                                scanningr = false;
                            } else {
                                if tf.kind == T_IDENT {
                                    let tc2: Token = toks.get(pr + 1);
                                    if tc2.kind == T_COLON {
                                        let fname: str = src.substr(tf.start, tf.end);
                                        let j1: str = rtext.concat(";");
                                        rtext = j1.concat(fname);
                                        let (vid, pv) = parser_expr(src, toks, pr + 2, nodes, kids);
                                        let qv: i64 = localr.push(vid);
                                        pr = pv;
                                        let tcm: Token = toks.get(pr);
                                        if tcm.kind == T_COMMA {
                                            pr = pr + 1;
                                        } else {
                                            scanningr = false;
                                        }
                                    } else {
                                        return parser_bail(toks, pr + 1, nodes);
                                    }
                                } else {
                                    return parser_bail(toks, pr, nodes);
                                }
                            }
                        }
                    }
                    let trb: Token = toks.get(pr);
                    if trb.kind == T_RBRACE {
                        let rlen2: i64 = rtext.len();
                        let cstartr: i64 = parser_kids_commit(kids, localr);
                        let idr: i64 = nodes.allocate(PNode { kind: P_K_RECORD_CONSTRUCT, start: t.start, end: trb.end, value: rlen2, flags: 0, child_start: cstartr, child_count: localr.len(), text: rtext });
                        return (idr, pr + 1);
                    } else {
                    }
                    return parser_bail(toks, pr, nodes);
                } else {
                }
            } else {
            }
        } else {
        }
        let flen2: i64 = full.len();
        let id2: i64 = nodes.allocate(PNode { kind: P_K_PATH, start: t.start, end: pend, value: flen2, flags: 0, child_start: 0, child_count: 0, text: full });
        return (id2, p);
    } else {
    }
    if t.kind == T_KW_SPAWN {
        // spawn ::? <ActorType> (args [, supervision: Stop|Restart(e)]) —
        // children [actor-type, arg…, restart-expr?]; flags = 0 none / 1 Stop
        // / 2 Restart; span = spawn..`)`.
        let mut p: i64 = pos + 1;
        let tcc: Token = toks.get(p);
        if tcc.kind == T_COLONCOLON {
            p = p + 1;
        } else {
        }
        let tlt: Token = toks.get(p);
        if tlt.kind == T_LT {
            p = p + 1;
        } else {
            return parser_bail(toks, p, nodes);
        }
        let (atid, p2) = parser_type(src, toks, p, 1, nodes, kids);
        let tgt: Token = toks.get(p2);
        if tgt.kind == T_GT {
            p = p2 + 1;
        } else {
            return parser_bail(toks, p2, nodes);
        }
        let tlp: Token = toks.get(p);
        if tlp.kind == T_LPAREN {
            p = p + 1;
        } else {
            return parser_bail(toks, p, nodes);
        }
        let mut localsp: Vec<i64> = Vec::new();
        let qat: i64 = localsp.push(atid);
        let mut sflags: i64 = 0;
        let mut scanningsp: bool = true;
        while scanningsp {
            let ta2: Token = toks.get(p);
            if ta2.kind == T_RPAREN {
                scanningsp = false;
            } else {
                if ta2.kind == T_EOF {
                    scanningsp = false;
                } else {
                    if ta2.kind == T_KW_SUPERVISION {
                        scanningsp = false;
                    } else {
                        let (aid, pa) = parser_expr(src, toks, p, nodes, kids);
                        let qa: i64 = localsp.push(aid);
                        p = pa;
                        let tcm: Token = toks.get(p);
                        if tcm.kind == T_COMMA {
                            p = p + 1;
                        } else {
                            scanningsp = false;
                        }
                    }
                }
            }
        }
        let tsv: Token = toks.get(p);
        if tsv.kind == T_KW_SUPERVISION {
            let tco: Token = toks.get(p + 1);
            if tco.kind == T_COLON {
            } else {
                return parser_bail(toks, p + 1, nodes);
            }
            let tsk: Token = toks.get(p + 2);
            if tsk.kind == T_IDENT {
                let sname: str = src.substr(tsk.start, tsk.end);
                if sname.bytes_eq("Stop") {
                    sflags = 1;
                    p = p + 3;
                } else {
                    if sname.bytes_eq("Restart") {
                        let tlp2: Token = toks.get(p + 3);
                        if tlp2.kind == T_LPAREN {
                        } else {
                            return parser_bail(toks, p + 3, nodes);
                        }
                        let (mre, pm2) = parser_expr(src, toks, p + 4, nodes, kids);
                        let trp2: Token = toks.get(pm2);
                        if trp2.kind == T_RPAREN {
                        } else {
                            return parser_bail(toks, pm2, nodes);
                        }
                        let qre: i64 = localsp.push(mre);
                        sflags = 2;
                        p = pm2 + 1;
                    } else {
                        return parser_bail(toks, p + 2, nodes);
                    }
                }
            } else {
                return parser_bail(toks, p + 2, nodes);
            }
        } else {
        }
        let trf: Token = toks.get(p);
        if trf.kind == T_RPAREN {
            let cstartsp: i64 = parser_kids_commit(kids, localsp);
            let idsp: i64 = nodes.allocate(PNode { kind: P_K_SPAWN, start: t.start, end: trf.end, value: 0, flags: sflags, child_start: cstartsp, child_count: localsp.len(), text: "" });
            return (idsp, p + 1);
        } else {
        }
        return parser_bail(toks, p, nodes);
    } else {
    }
    if t.kind == T_KW_GRANT {
        // grant(cap, body) — children [cap, body]; span = grant..`)`.
        let tlp3: Token = toks.get(pos + 1);
        if tlp3.kind == T_LPAREN {
        } else {
            return parser_bail(toks, pos + 1, nodes);
        }
        let (cid, p1) = parser_expr(src, toks, pos + 2, nodes, kids);
        let tcm2: Token = toks.get(p1);
        if tcm2.kind == T_COMMA {
        } else {
            return parser_bail(toks, p1, nodes);
        }
        let (bid, p2) = parser_expr(src, toks, p1 + 1, nodes, kids);
        let trp3: Token = toks.get(p2);
        if trp3.kind == T_RPAREN {
            let mut localg2: Vec<i64> = Vec::new();
            let qg1: i64 = localg2.push(cid);
            let qg2: i64 = localg2.push(bid);
            let cstartg2: i64 = parser_kids_commit(kids, localg2);
            let idg2: i64 = nodes.allocate(PNode { kind: P_K_GRANT, start: t.start, end: trp3.end, value: 0, flags: 0, child_start: cstartg2, child_count: 2, text: "" });
            return (idg2, p2 + 1);
        } else {
        }
        return parser_bail(toks, p2, nodes);
    } else {
    }
    if t.kind == T_KW_HANDLE {
        // Effect Handlers (EH0b, C-PATHSEP): the clause form
        // `handle <e> { Op(x) => .. }` is a DISTINCT leaf node from the bare
        // row-widening form below. Disambiguate by lookahead so the bare form
        // stays byte-identical.
        if parser_at_clause_handle(toks, pos + 1) {
            return parser_clause_handle(src, toks, pos, nodes);
        } else {
        }
        // handle Eff1, Eff2 { block } — text = the effect names joined `;`;
        // child = [body]; span = handle..body.end.
        let mut htext: str = "";
        let mut hcount: i64 = 0;
        let mut p: i64 = pos + 1;
        let mut scanningh: bool = true;
        while scanningh {
            let th: Token = toks.get(p);
            if th.kind == T_LBRACE {
                scanningh = false;
            } else {
                if th.kind == T_EOF {
                    scanningh = false;
                } else {
                    if th.kind == T_IDENT {
                        let e: str = src.substr(th.start, th.end);
                        if hcount > 0 {
                            let jh: str = htext.concat(";");
                            htext = jh.concat(e);
                        } else {
                            htext = e;
                        }
                        hcount = hcount + 1;
                        p = p + 1;
                        let tcm3: Token = toks.get(p);
                        if tcm3.kind == T_COMMA {
                            p = p + 1;
                        } else {
                            scanningh = false;
                        }
                    } else {
                        return parser_bail(toks, p, nodes);
                    }
                }
            }
        }
        let (bid2, p3) = parser_block(src, toks, p, nodes, kids);
        let bnode2: PNode = nodes.get(bid2);
        let mut localh: Vec<i64> = Vec::new();
        let qh: i64 = localh.push(bid2);
        let cstarth: i64 = parser_kids_commit(kids, localh);
        let htlen: i64 = htext.len();
        let idh: i64 = nodes.allocate(PNode { kind: P_K_HANDLE, start: t.start, end: bnode2.end, value: htlen, flags: 0, child_start: cstarth, child_count: 1, text: htext });
        return (idh, p3);
    } else {
    }
    if t.kind == T_KW_DECLASSIFY {
        // declassify(value, cap) @Label? — children [value, cap]; flags = the
        // optional target taint code; the @Label sits OUTSIDE the span (the
        // oracle's span = declassify..`)`).
        let tlp4: Token = toks.get(pos + 1);
        if tlp4.kind == T_LPAREN {
        } else {
            return parser_bail(toks, pos + 1, nodes);
        }
        let (vid2, p1) = parser_expr(src, toks, pos + 2, nodes, kids);
        let tcm4: Token = toks.get(p1);
        if tcm4.kind == T_COMMA {
        } else {
            return parser_bail(toks, p1, nodes);
        }
        let (cid2, p2) = parser_expr(src, toks, p1 + 1, nodes, kids);
        let trp4: Token = toks.get(p2);
        if trp4.kind == T_RPAREN {
        } else {
            return parser_bail(toks, p2, nodes);
        }
        let (dt, p3) = parser_taint(src, toks, p2 + 1);
        if dt < 0 {
            return parser_bail(toks, p2 + 1, nodes);
        } else {
        }
        let mut locald: Vec<i64> = Vec::new();
        let qd1: i64 = locald.push(vid2);
        let qd2: i64 = locald.push(cid2);
        let cstartd: i64 = parser_kids_commit(kids, locald);
        let idd: i64 = nodes.allocate(PNode { kind: P_K_DECLASSIFY, start: t.start, end: trp4.end, value: 0, flags: dt, child_start: cstartd, child_count: 2, text: "" });
        return (idd, p3);
    } else {
    }
    if t.kind == T_KW_DECLASSIFY_CT {
        // declassify_ct(value, cap) — children [value, cap]; span = ..`)`.
        let tlp5: Token = toks.get(pos + 1);
        if tlp5.kind == T_LPAREN {
        } else {
            return parser_bail(toks, pos + 1, nodes);
        }
        let (vid3, p1) = parser_expr(src, toks, pos + 2, nodes, kids);
        let tcm5: Token = toks.get(p1);
        if tcm5.kind == T_COMMA {
        } else {
            return parser_bail(toks, p1, nodes);
        }
        let (cid3, p2) = parser_expr(src, toks, p1 + 1, nodes, kids);
        let trp5: Token = toks.get(p2);
        if trp5.kind == T_RPAREN {
            let mut localdc: Vec<i64> = Vec::new();
            let qdc1: i64 = localdc.push(vid3);
            let qdc2: i64 = localdc.push(cid3);
            let cstartdc: i64 = parser_kids_commit(kids, localdc);
            let iddc: i64 = nodes.allocate(PNode { kind: P_K_DECLASSIFY_CT, start: t.start, end: trp5.end, value: 0, flags: 0, child_start: cstartdc, child_count: 2, text: "" });
            return (iddc, p2 + 1);
        } else {
        }
        return parser_bail(toks, p2, nodes);
    } else {
    }
    if t.kind == T_KW_REGION {
        // region name(limit) { block } — text = the name; children
        // [limit, body]; span = region..body.end.
        let tn0: Token = toks.get(pos + 1);
        if tn0.kind == T_IDENT {
        } else {
            return parser_bail(toks, pos + 1, nodes);
        }
        let tlp6: Token = toks.get(pos + 2);
        if tlp6.kind == T_LPAREN {
        } else {
            return parser_bail(toks, pos + 2, nodes);
        }
        let (lid, p1) = parser_expr(src, toks, pos + 3, nodes, kids);
        let trp6: Token = toks.get(p1);
        if trp6.kind == T_RPAREN {
        } else {
            return parser_bail(toks, p1, nodes);
        }
        let (bid3, p2) = parser_block(src, toks, p1 + 1, nodes, kids);
        let bnode3: PNode = nodes.get(bid3);
        let rname2: str = src.substr(tn0.start, tn0.end);
        let rnlen: i64 = rname2.len();
        let mut localr2: Vec<i64> = Vec::new();
        let qr1: i64 = localr2.push(lid);
        let qr2: i64 = localr2.push(bid3);
        let cstartr2: i64 = parser_kids_commit(kids, localr2);
        let idr2: i64 = nodes.allocate(PNode { kind: P_K_REGION, start: t.start, end: bnode3.end, value: rnlen, flags: 0, child_start: cstartr2, child_count: 2, text: rname2 });
        return (idr2, p2);
    } else {
    }
    if t.kind == T_KW_FN {
        // closure := 'fn' params ('->' type)? block — the lowercase `fn` at
        // expression position (the capital-`Fn` TYPE lives in parser_type).
        // Children [param…, return-type?, body]; span = fn..body.end.
        let mut localcl: Vec<i64> = Vec::new();
        let (clend, clp) = parser_params(src, toks, pos + 1, nodes, kids, localcl);
        if clend < 0 {
            return parser_bail(toks, clp, nodes);
        } else {
        }
        let mut pcl: i64 = clp;
        let tacl: Token = toks.get(pcl);
        if tacl.kind == T_ARROW {
            let (tidcl, pcl2) = parser_type(src, toks, pcl + 1, 1, nodes, kids);
            let qtcl: i64 = localcl.push(tidcl);
            pcl = pcl2;
        } else {
        }
        let (bidcl, pcl3) = parser_block(src, toks, pcl, nodes, kids);
        let qbcl: i64 = localcl.push(bidcl);
        let bnodecl: PNode = nodes.get(bidcl);
        let cstartcl: i64 = parser_kids_commit(kids, localcl);
        let idcl: i64 = nodes.allocate(PNode { kind: P_K_CLOSURE, start: t.start, end: bnodecl.end, value: 0, flags: 0, child_start: cstartcl, child_count: localcl.len(), text: "" });
        return (idcl, pcl3);
    } else {
    }
    if t.kind == T_LPAREN {
        // `(e)` is grouping (no node — the oracle returns the inner Expr);
        // `(a, b, …)` is a tuple literal — the COMMA is the sole discriminator.
        // A 1-tuple `(a,)` and arity > 12 are parse errors (the oracle's T261).
        let (inner, p2) = parser_expr(src, toks, pos + 1, nodes, kids);
        let tc: Token = toks.get(p2);
        if tc.kind == T_COMMA {
            let mut locale: Vec<i64> = Vec::new();
            let qf: i64 = locale.push(inner);
            let mut pe: i64 = p2 + 1;
            let mut scanninge: bool = true;
            while scanninge {
                let te: Token = toks.get(pe);
                if te.kind == T_RPAREN {
                    scanninge = false;
                } else {
                    if te.kind == T_EOF {
                        scanninge = false;
                    } else {
                        let (eid, pe2) = parser_expr(src, toks, pe, nodes, kids);
                        let qe: i64 = locale.push(eid);
                        pe = pe2;
                        let tec: Token = toks.get(pe);
                        if tec.kind == T_COMMA {
                            pe = pe + 1;
                        } else {
                            scanninge = false;
                        }
                    }
                }
            }
            let trp: Token = toks.get(pe);
            if trp.kind == T_RPAREN {
                if locale.len() < 2 {
                    return parser_bail(toks, pe, nodes);
                } else {
                }
                if locale.len() > P_MAX_TUPLE_ARITY {
                    return parser_bail(toks, pe, nodes);
                } else {
                }
                let cstarte: i64 = parser_kids_commit(kids, locale);
                let ide: i64 = nodes.allocate(PNode { kind: P_K_TUPLE, start: t.start, end: trp.end, value: 0, flags: 0, child_start: cstarte, child_count: locale.len(), text: "" });
                return (ide, pe + 1);
            } else {
            }
            return parser_bail(toks, pe, nodes);
        } else {
        }
        if tc.kind == T_RPAREN {
            return (inner, p2 + 1);
        } else {
        }
        return parser_bail(toks, p2, nodes);
    } else {
    }
    if t.kind == T_LBRACKET {
        // Array literal `[a, b, …]` / `[]` / the repeat form `[elem; N]`.
        // The repeat form mirrors the oracle exactly: the count is a RAW
        // IntLit token in 0..=65535 and the element must be a LITERAL; it
        // expands AT PARSE TIME into N cloned elements (the oracle's
        // `vec![first; count]`). The first parsed literal IS element 0 (its
        // node is reused) and N-1 clones are allocated; for N == 0 the
        // literal's slot is OVERWRITTEN with the ArrayLit node itself
        // (Arena::set), so no orphan is ever created (ET-P4).
        let tn0: Token = toks.get(pos + 1);
        if tn0.kind == T_RBRACKET {
            let id0: i64 = nodes.allocate(PNode { kind: P_K_ARRAY, start: t.start, end: tn0.end, value: 0, flags: 0, child_start: 0, child_count: 0, text: "" });
            return (id0, pos + 2);
        } else {
        }
        let (first, pf) = parser_expr(src, toks, pos + 1, nodes, kids);
        let ts: Token = toks.get(pf);
        if ts.kind == T_SEMI {
            let fnode: PNode = nodes.get(first);
            let mut islit: bool = false;
            if fnode.kind == P_K_LIT_INT {
                islit = true;
            } else {
            }
            if fnode.kind == P_K_LIT_BOOL {
                islit = true;
            } else {
            }
            if fnode.kind == P_K_LIT_FLOAT {
                islit = true;
            } else {
            }
            if fnode.kind == P_K_LIT_STR {
                islit = true;
            } else {
            }
            if islit {
            } else {
                return parser_bail(toks, pf, nodes);
            }
            let tcnt: Token = toks.get(pf + 1);
            if tcnt.kind == T_INT {
            } else {
                return parser_bail(toks, pf + 1, nodes);
            }
            if tcnt.value > 65535 {
                return parser_bail(toks, pf + 1, nodes);
            } else {
            }
            let trb2: Token = toks.get(pf + 2);
            if trb2.kind == T_RBRACKET {
            } else {
                return parser_bail(toks, pf + 2, nodes);
            }
            if tcnt.value == 0 {
                // zero-repeat: the oracle drops the element; overwrite its
                // slot with the ArrayLit so the arena stays orphan-free.
                let ida: i64 = nodes.set(first, PNode { kind: P_K_ARRAY, start: t.start, end: trb2.end, value: 0, flags: 0, child_start: 0, child_count: 0, text: "" });
                return (ida, pf + 3);
            } else {
            }
            let mut localn: Vec<i64> = Vec::new();
            let q0: i64 = localn.push(first);
            let mut ci: i64 = 1;
            while ci < tcnt.value {
                let clone: i64 = nodes.allocate(PNode { kind: fnode.kind, start: fnode.start, end: fnode.end, value: fnode.value, flags: fnode.flags, child_start: fnode.child_start, child_count: fnode.child_count, text: fnode.text });
                let qq: i64 = localn.push(clone);
                ci = ci + 1;
            }
            let cstartn: i64 = parser_kids_commit(kids, localn);
            let idn: i64 = nodes.allocate(PNode { kind: P_K_ARRAY, start: t.start, end: trb2.end, value: 0, flags: 0, child_start: cstartn, child_count: localn.len(), text: "" });
            return (idn, pf + 3);
        } else {
        }
        let mut locala: Vec<i64> = Vec::new();
        let qa: i64 = locala.push(first);
        let mut pa: i64 = pf;
        let tca: Token = toks.get(pa);
        if tca.kind == T_COMMA {
            pa = pa + 1;
            let mut scanninga: bool = true;
            while scanninga {
                let ta: Token = toks.get(pa);
                if ta.kind == T_RBRACKET {
                    scanninga = false;
                } else {
                    if ta.kind == T_EOF {
                        scanninga = false;
                    } else {
                        let (aid, pa2) = parser_expr(src, toks, pa, nodes, kids);
                        let qaa: i64 = locala.push(aid);
                        pa = pa2;
                        let tac: Token = toks.get(pa);
                        if tac.kind == T_COMMA {
                            pa = pa + 1;
                        } else {
                            scanninga = false;
                        }
                    }
                }
            }
        } else {
        }
        let trb3: Token = toks.get(pa);
        if trb3.kind == T_RBRACKET {
            let cstarta: i64 = parser_kids_commit(kids, locala);
            let idar: i64 = nodes.allocate(PNode { kind: P_K_ARRAY, start: t.start, end: trb3.end, value: 0, flags: 0, child_start: cstarta, child_count: locala.len(), text: "" });
            return (idar, pa + 1);
        } else {
        }
        return parser_bail(toks, pa, nodes);
    } else {
    }
    return parser_bail(toks, pos, nodes);
}

// postfix := primary ('?' | '[' index-or-slice ']')*   — the oracle's
// parse_postfix_expr loop. `?` wraps in a Try; `[e]` is Index; `[lo..hi]` and
// its open forms are Slice (flags bit0 = has-start, bit1 = has-end; children
// [array, start?, end?]). Field/method access is NOT here — dots belong to the
// path scan (parse-time paths; resolution is type-check's job).
fn parser_postfix(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let (first, p1) = parser_primary(src, toks, pos, nodes, kids);
    let mut e: i64 = first;
    let mut p: i64 = p1;
    let mut going: bool = true;
    while going {
        let t: Token = toks.get(p);
        if t.kind == T_QUESTION {
            let en: PNode = nodes.get(e);
            let mut localt: Vec<i64> = Vec::new();
            let qt: i64 = localt.push(e);
            let cstartt: i64 = parser_kids_commit(kids, localt);
            let idt: i64 = nodes.allocate(PNode { kind: P_K_TRY, start: en.start, end: t.end, value: 0, flags: 0, child_start: cstartt, child_count: 1, text: "" });
            e = idt;
            p = p + 1;
        } else {
            if t.kind == T_LBRACKET {
                let en2: PNode = nodes.get(e);
                let tn: Token = toks.get(p + 1);
                if tn.kind == T_DOTDOT {
                    // `[..hi]` / `[..]` — open start.
                    let mut p2: i64 = p + 2;
                    let mut hasend: i64 = 0;
                    let mut eid: i64 = 0 - 1;
                    let te: Token = toks.get(p2);
                    if te.kind == T_RBRACKET {
                    } else {
                        let (got, p3) = parser_expr(src, toks, p2, nodes, kids);
                        eid = got;
                        hasend = 1;
                        p2 = p3;
                    }
                    let tr: Token = toks.get(p2);
                    if tr.kind == T_RBRACKET {
                        let mut locals: Vec<i64> = Vec::new();
                        let qs: i64 = locals.push(e);
                        if hasend == 1 {
                            let qe: i64 = locals.push(eid);
                        } else {
                        }
                        let cstarts: i64 = parser_kids_commit(kids, locals);
                        let ids: i64 = nodes.allocate(PNode { kind: P_K_SLICE, start: en2.start, end: tr.end, value: 0, flags: hasend * 2, child_start: cstarts, child_count: locals.len(), text: "" });
                        e = ids;
                        p = p2 + 1;
                    } else {
                        return parser_bail(toks, p2, nodes);
                    }
                } else {
                    let (fid, p2) = parser_expr(src, toks, p + 1, nodes, kids);
                    let td: Token = toks.get(p2);
                    if td.kind == T_DOTDOT {
                        // `[lo..hi]` / `[lo..]`.
                        let mut p3: i64 = p2 + 1;
                        let mut hasend2: i64 = 0;
                        let mut eid2: i64 = 0 - 1;
                        let te2: Token = toks.get(p3);
                        if te2.kind == T_RBRACKET {
                        } else {
                            let (got2, p4) = parser_expr(src, toks, p3, nodes, kids);
                            eid2 = got2;
                            hasend2 = 1;
                            p3 = p4;
                        }
                        let tr2: Token = toks.get(p3);
                        if tr2.kind == T_RBRACKET {
                            let mut locals2: Vec<i64> = Vec::new();
                            let qs2: i64 = locals2.push(e);
                            let qf2: i64 = locals2.push(fid);
                            if hasend2 == 1 {
                                let qe2: i64 = locals2.push(eid2);
                            } else {
                            }
                            let cstarts2: i64 = parser_kids_commit(kids, locals2);
                            let ids2: i64 = nodes.allocate(PNode { kind: P_K_SLICE, start: en2.start, end: tr2.end, value: 0, flags: 1 + hasend2 * 2, child_start: cstarts2, child_count: locals2.len(), text: "" });
                            e = ids2;
                            p = p3 + 1;
                        } else {
                            return parser_bail(toks, p3, nodes);
                        }
                    } else {
                        if td.kind == T_RBRACKET {
                            let mut locali: Vec<i64> = Vec::new();
                            let qi: i64 = locali.push(e);
                            let qx: i64 = locali.push(fid);
                            let cstarti: i64 = parser_kids_commit(kids, locali);
                            let idi: i64 = nodes.allocate(PNode { kind: P_K_INDEX, start: en2.start, end: td.end, value: 0, flags: 0, child_start: cstarti, child_count: 2, text: "" });
                            e = idi;
                            p = p2 + 1;
                        } else {
                            return parser_bail(toks, p2, nodes);
                        }
                    }
                }
            } else {
                going = false;
            }
        }
    }
    return (e, p);
}

// prefix := '&' 'mut'? prefix | '-' prefix | '!' prefix | primary.
// Mirrors the oracle's parse_prefix_expr exactly:
//   & / &mut  → a Borrow node (flags bit0 = mutable; span = `&`..inner.end);
//   - INT-LIT → parse-time FOLD: the literal node is PATCHED in place
//               (Arena::set — no orphan, ET-P4) to value -n, span `-`..lit.end;
//   - other   → desugar to `0 - inner` with a synthetic 0-literal AT the
//               minus token's span;
//   ! inner   → desugar to `inner == false` with a synthetic false-literal AT
//               the bang token's span (children [inner, false] — the synthetic
//               rhs PRECEDES the lhs in source; span = `!`..inner.end).
fn parser_prefix(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let t: Token = toks.get(pos);
    if t.kind == T_AMP {
        let mut p: i64 = pos + 1;
        let mut mflag: i64 = 0;
        let tm: Token = toks.get(p);
        if tm.kind == T_KW_MUT {
            mflag = 1;
            p = p + 1;
        } else {
        }
        let (inner, p2) = parser_prefix(src, toks, p, nodes, kids);
        let inode: PNode = nodes.get(inner);
        let mut local: Vec<i64> = Vec::new();
        let q: i64 = local.push(inner);
        let cstart: i64 = parser_kids_commit(kids, local);
        let idb: i64 = nodes.allocate(PNode { kind: P_K_BORROW, start: t.start, end: inode.end, value: 0, flags: mflag, child_start: cstart, child_count: 1, text: "" });
        return (idb, p2);
    } else {
    }
    if t.kind == T_MINUS {
        let (inner, p2) = parser_prefix(src, toks, pos + 1, nodes, kids);
        let inode: PNode = nodes.get(inner);
        if inode.kind == P_K_LIT_INT {
            let folded: i64 = nodes.set(inner, PNode { kind: P_K_LIT_INT, start: t.start, end: inode.end, value: 0 - inode.value, flags: 0, child_start: 0, child_count: 0, text: "" });
            return (folded, p2);
        } else {
        }
        let zid: i64 = nodes.allocate(PNode { kind: P_K_LIT_INT, start: t.start, end: t.end, value: 0, flags: 0, child_start: 0, child_count: 0, text: "" });
        let did: i64 = parser_mk_binary(T_MINUS, zid, inner, nodes, kids);
        return (did, p2);
    } else {
    }
    if t.kind == T_BANG {
        let (inner, p2) = parser_prefix(src, toks, pos + 1, nodes, kids);
        let inode: PNode = nodes.get(inner);
        let fid: i64 = nodes.allocate(PNode { kind: P_K_LIT_BOOL, start: t.start, end: t.end, value: 0, flags: 0, child_start: 0, child_count: 0, text: "" });
        let mut local2: Vec<i64> = Vec::new();
        let q1: i64 = local2.push(inner);
        let q2: i64 = local2.push(fid);
        let cstart2: i64 = parser_kids_commit(kids, local2);
        let eqid: i64 = nodes.allocate(PNode { kind: P_K_BINARY, start: t.start, end: inode.end, value: T_EQEQ, flags: 0, child_start: cstart2, child_count: 2, text: "" });
        return (eqid, p2);
    } else {
    }
    return parser_postfix(src, toks, pos, nodes, kids);
}

// multiplicative := prefix (('*'|'/'|'%') prefix)*
fn parser_mult(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let (first, p1) = parser_prefix(src, toks, pos, nodes, kids);
    let mut lhs: i64 = first;
    let mut p: i64 = p1;
    let mut going: bool = true;
    while going {
        let t: Token = toks.get(p);
        let mut op: i64 = 0;
        if t.kind == T_STAR {
            op = T_STAR;
        } else {
        }
        if t.kind == T_SLASH {
            op = T_SLASH;
        } else {
        }
        if t.kind == T_PERCENT {
            op = T_PERCENT;
        } else {
        }
        if op > 0 {
            let (rhs, p2) = parser_prefix(src, toks, p + 1, nodes, kids);
            lhs = parser_mk_binary(op, lhs, rhs, nodes, kids);
            p = p2;
        } else {
            going = false;
        }
    }
    return (lhs, p);
}

// additive := multiplicative (('+'|'-') multiplicative)*
fn parser_additive(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let (first, p1) = parser_mult(src, toks, pos, nodes, kids);
    let mut lhs: i64 = first;
    let mut p: i64 = p1;
    let mut going: bool = true;
    while going {
        let t: Token = toks.get(p);
        let mut op: i64 = 0;
        if t.kind == T_PLUS {
            op = T_PLUS;
        } else {
        }
        if t.kind == T_MINUS {
            op = T_MINUS;
        } else {
        }
        if op > 0 {
            let (rhs, p2) = parser_mult(src, toks, p + 1, nodes, kids);
            lhs = parser_mk_binary(op, lhs, rhs, nodes, kids);
            p = p2;
        } else {
            going = false;
        }
    }
    return (lhs, p);
}

// shift := additive (('<<'|'>>') additive)*
fn parser_shift(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let (first, p1) = parser_additive(src, toks, pos, nodes, kids);
    let mut lhs: i64 = first;
    let mut p: i64 = p1;
    let mut going: bool = true;
    while going {
        let t: Token = toks.get(p);
        let mut op: i64 = 0;
        if t.kind == T_LTLT {
            op = T_LTLT;
        } else {
        }
        if t.kind == T_GTGT {
            op = T_GTGT;
        } else {
        }
        if op > 0 {
            let (rhs, p2) = parser_additive(src, toks, p + 1, nodes, kids);
            lhs = parser_mk_binary(op, lhs, rhs, nodes, kids);
            p = p2;
        } else {
            going = false;
        }
    }
    return (lhs, p);
}

// bitand := shift ('&' shift)*   — the infix `&` is positional: prefix only
// consumes `&` at expression START, so `&` after a parsed operand lands here.
fn parser_bitand(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let (first, p1) = parser_shift(src, toks, pos, nodes, kids);
    let mut lhs: i64 = first;
    let mut p: i64 = p1;
    let mut going: bool = true;
    while going {
        let t: Token = toks.get(p);
        if t.kind == T_AMP {
            let (rhs, p2) = parser_shift(src, toks, p + 1, nodes, kids);
            lhs = parser_mk_binary(T_AMP, lhs, rhs, nodes, kids);
            p = p2;
        } else {
            going = false;
        }
    }
    return (lhs, p);
}

// bitor := bitand ('|' bitand)*
fn parser_bitor(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let (first, p1) = parser_bitand(src, toks, pos, nodes, kids);
    let mut lhs: i64 = first;
    let mut p: i64 = p1;
    let mut going: bool = true;
    while going {
        let t: Token = toks.get(p);
        if t.kind == T_PIPE {
            let (rhs, p2) = parser_bitand(src, toks, p + 1, nodes, kids);
            lhs = parser_mk_binary(T_PIPE, lhs, rhs, nodes, kids);
            p = p2;
        } else {
            going = false;
        }
    }
    return (lhs, p);
}

// comparison := bitor (('<'|'<='|'>'|'>=') bitor)*
fn parser_comparison(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let (first, p1) = parser_bitor(src, toks, pos, nodes, kids);
    let mut lhs: i64 = first;
    let mut p: i64 = p1;
    let mut going: bool = true;
    while going {
        let t: Token = toks.get(p);
        let mut op: i64 = 0;
        if t.kind == T_LT {
            op = T_LT;
        } else {
        }
        if t.kind == T_LTEQ {
            op = T_LTEQ;
        } else {
        }
        if t.kind == T_GT {
            op = T_GT;
        } else {
        }
        if t.kind == T_GTEQ {
            op = T_GTEQ;
        } else {
        }
        if op > 0 {
            let (rhs, p2) = parser_bitor(src, toks, p + 1, nodes, kids);
            lhs = parser_mk_binary(op, lhs, rhs, nodes, kids);
            p = p2;
        } else {
            going = false;
        }
    }
    return (lhs, p);
}

// equality := comparison (('=='|'!=') comparison)*  — the top of the climb.
fn parser_equality(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let (first, p1) = parser_comparison(src, toks, pos, nodes, kids);
    let mut lhs: i64 = first;
    let mut p: i64 = p1;
    let mut going: bool = true;
    while going {
        let t: Token = toks.get(p);
        let mut op: i64 = 0;
        if t.kind == T_EQEQ {
            op = T_EQEQ;
        } else {
        }
        if t.kind == T_BANGEQ {
            op = T_BANGEQ;
        } else {
        }
        if op > 0 {
            let (rhs, p2) = parser_comparison(src, toks, p + 1, nodes, kids);
            lhs = parser_mk_binary(op, lhs, rhs, nodes, kids);
            p = p2;
        } else {
            going = false;
        }
    }
    return (lhs, p);
}

// expr := equality   (the oracle's parse_expr).
fn parser_expr(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    return parser_equality(src, toks, pos, nodes, kids);
}

// ── types ────────────────────────────────────────────────────────────────────

// type := '(' type (',' type)* ')'              — tuple type / grouping
//       | '&' 'mut'? '[' type ']'               — slice ref
//       | '&' 'mut'? type                       — ref
//       | '[' type ';' INT ']'                  — sized array
//       | 'Fn' '(' type,* ')' '->' type         — function type
//       | path ('<' type,* '>')?                — nominal (+ eager generics)
// Mirrors the oracle's parse_type_expr. THE REF QUIRK, replicated exactly: a
// ref is a FLAG on the inner nominal node, not a wrapper — `&T` hoists the
// inner's path (K_TYPE flags: 0 plain / 1 `&` / 2 `&mut` / 3 `&[slice]` — the
// slice form DROPS a `mut`, like the oracle) and the span grows to `&`..inner.
// Generic args are CHILDREN of the nominal node; nested generics close with
// `> >` (the lexer's maximal munch makes a bare `>>` one token — the oracle
// fails it too, so identical means identical). Parametric-cap deadlines
// (`Approval(2030)`) are a later slice — the `(` is left unconsumed.
fn parser_type(src: str, toks: Vec<Token>, pos: i64, allowrow: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let t: Token = toks.get(pos);
    if t.kind == T_LPAREN {
        // tuple type / grouping `(T)` ≡ T (no node, like the oracle).
        let mut locale: Vec<i64> = Vec::new();
        let mut sawcomma: bool = false;
        let mut p: i64 = pos + 1;
        let mut scanning: bool = true;
        while scanning {
            let te: Token = toks.get(p);
            if te.kind == T_RPAREN {
                scanning = false;
            } else {
                if te.kind == T_EOF {
                    scanning = false;
                } else {
                    let (eid, p2) = parser_type(src, toks, p, 1, nodes, kids);
                    let qe: i64 = locale.push(eid);
                    p = p2;
                    let tc: Token = toks.get(p);
                    if tc.kind == T_COMMA {
                        sawcomma = true;
                        p = p + 1;
                    } else {
                        scanning = false;
                    }
                }
            }
        }
        let tr: Token = toks.get(p);
        if tr.kind == T_RPAREN {
            if sawcomma {
            } else {
                if locale.len() == 1 {
                    let only: i64 = locale.get(0);
                    return (only, p + 1);
                } else {
                }
            }
            if locale.len() < 2 {
                return parser_bail(toks, p, nodes);
            } else {
            }
            if locale.len() > P_MAX_TUPLE_ARITY {
                return parser_bail(toks, p, nodes);
            } else {
            }
            let cstart: i64 = parser_kids_commit(kids, locale);
            let idt: i64 = nodes.allocate(PNode { kind: P_K_TYPE_TUPLE, start: t.start, end: tr.end, value: 0, flags: 0, child_start: cstart, child_count: locale.len(), text: "" });
            return (idt, p + 1);
        } else {
        }
        return parser_bail(toks, p, nodes);
    } else {
    }
    if t.kind == T_AMP {
        let mut p: i64 = pos + 1;
        let mut refcode: i64 = 1;
        let tm: Token = toks.get(p);
        if tm.kind == T_KW_MUT {
            refcode = 2;
            p = p + 1;
        } else {
        }
        let tb: Token = toks.get(p);
        if tb.kind == T_LBRACKET {
            // `&[T]` — a slice ref; the mut bit is DROPPED (the oracle's).
            let (inner, p2) = parser_type(src, toks, p + 1, 1, nodes, kids);
            let tc: Token = toks.get(p2);
            if tc.kind == T_RBRACKET {
                let innode: PNode = nodes.get(inner);
                let patched: i64 = nodes.set(inner, PNode { kind: innode.kind, start: t.start, end: tc.end, value: innode.value, flags: 3, child_start: innode.child_start, child_count: innode.child_count, text: innode.text });
                return (patched, p2 + 1);
            } else {
            }
            return parser_bail(toks, p2, nodes);
        } else {
        }
        // `&T` / `&mut T` — patch the ref flag + span onto the inner node
        // (the oracle hoists the inner's path into the ref'd TypeExpr).
        let (inner2, p3) = parser_type(src, toks, p, allowrow, nodes, kids);
        let innode2: PNode = nodes.get(inner2);
        let patched2: i64 = nodes.set(inner2, PNode { kind: innode2.kind, start: t.start, end: innode2.end, value: innode2.value, flags: refcode, child_start: innode2.child_start, child_count: innode2.child_count, text: innode2.text });
        return (patched2, p3);
    } else {
    }
    if t.kind == T_LBRACKET {
        // `[T; N]` — the sized array type; N is a RAW IntLit in 0..=65535.
        let (elem, p1) = parser_type(src, toks, pos + 1, 1, nodes, kids);
        let ts: Token = toks.get(p1);
        if ts.kind == T_SEMI {
        } else {
            return parser_bail(toks, p1, nodes);
        }
        let tn: Token = toks.get(p1 + 1);
        if tn.kind == T_INT {
        } else {
            return parser_bail(toks, p1 + 1, nodes);
        }
        if tn.value > 65535 {
            return parser_bail(toks, p1 + 1, nodes);
        } else {
        }
        let tr2: Token = toks.get(p1 + 2);
        if tr2.kind == T_RBRACKET {
            let mut locala: Vec<i64> = Vec::new();
            let qa: i64 = locala.push(elem);
            let cstarta: i64 = parser_kids_commit(kids, locala);
            let ida: i64 = nodes.allocate(PNode { kind: P_K_TYPE_ARRAY, start: t.start, end: tr2.end, value: tn.value, flags: 0, child_start: cstarta, child_count: 1, text: "" });
            return (ida, p1 + 3);
        } else {
        }
        return parser_bail(toks, p1 + 2, nodes);
    } else {
    }
    if t.kind == T_IDENT {
        let first: str = src.substr(t.start, t.end);
        // `Fn(params) -> ret` — the function type (capital Fn + `(`).
        if first.bytes_eq("Fn") {
            let tl0: Token = toks.get(pos + 1);
            if tl0.kind == T_LPAREN {
                let mut localf: Vec<i64> = Vec::new();
                let mut p: i64 = pos + 2;
                let mut scanningf: bool = true;
                while scanningf {
                    let te: Token = toks.get(p);
                    if te.kind == T_RPAREN {
                        scanningf = false;
                    } else {
                        if te.kind == T_EOF {
                            scanningf = false;
                        } else {
                            let (pid, p2) = parser_type(src, toks, p, 1, nodes, kids);
                            let qp: i64 = localf.push(pid);
                            p = p2;
                            let tc: Token = toks.get(p);
                            if tc.kind == T_COMMA {
                                p = p + 1;
                            } else {
                                scanningf = false;
                            }
                        }
                    }
                }
                let tr3: Token = toks.get(p);
                if tr3.kind == T_RPAREN {
                    p = p + 1;
                } else {
                    return parser_bail(toks, p, nodes);
                }
                let ta: Token = toks.get(p);
                if ta.kind == T_ARROW {
                    p = p + 1;
                } else {
                    return parser_bail(toks, p, nodes);
                }
                let (rid, p4) = parser_type(src, toks, p, allowrow, nodes, kids);
                let qr: i64 = localf.push(rid);
                let rnode: PNode = nodes.get(rid);
                // Latent-row suffix `! { E1, E2 }` (fn-type rows): parsed ONLY when
                // this type does not sit in a declaration's return position
                // (allowrow == 0 there — the trailing row is the DECLARATION's;
                // parens/bounded positions re-enable). Mirrors the oracle's
                // suppress_fn_type_row + parse_effect_row; text reuses the
                // `;!;Eff1;Eff2` convention of parser_effect_suffix (";!" = the
                // explicit-empty row, "" = no row), value = text length, and the
                // node END extends to the row's closing token like the oracle span.
                let mut rowtext: str = "";
                let mut pend: i64 = p4;
                let mut rowend: i64 = rnode.end;
                if allowrow == 1 {
                    let (esuffix, eok, pe) = parser_effect_suffix(src, toks, p4);
                    if eok < 0 {
                        return parser_bail(toks, pe, nodes);
                    } else {
                    }
                    let elen: i64 = esuffix.len();
                    if elen > 0 {
                        rowtext = esuffix;
                        let tlast: Token = toks.get(pe - 1);
                        rowend = tlast.end;
                    } else {
                    }
                    pend = pe;
                } else {
                }
                let cstartf: i64 = parser_kids_commit(kids, localf);
                let tlen: i64 = rowtext.len();
                let idf: i64 = nodes.allocate(PNode { kind: P_K_TYPE_FN, start: t.start, end: rowend, value: tlen, flags: 0, child_start: cstartf, child_count: localf.len(), text: rowtext });
                return (idf, pend);
            } else {
            }
        } else {
        }
        // nominal path (`::`-joined segments) + eager `<args>` in type position.
        let mut full: str = first;
        let mut pend: i64 = t.end;
        let mut p: i64 = pos + 1;
        let mut scanning2: bool = true;
        while scanning2 {
            let tj: Token = toks.get(p);
            if tj.kind == T_COLONCOLON {
                let ts2: Token = toks.get(p + 1);
                if ts2.kind == T_IDENT {
                    let seg: str = src.substr(ts2.start, ts2.end);
                    let j1: str = full.concat("::");
                    full = j1.concat(seg);
                    pend = ts2.end;
                    p = p + 2;
                } else {
                    scanning2 = false;
                }
            } else {
                scanning2 = false;
            }
        }
        let mut localg: Vec<i64> = Vec::new();
        let mut gend: i64 = pend;
        let tg: Token = toks.get(p);
        if tg.kind == T_LT {
            let mut pg: i64 = p + 1;
            let mut scanning3: bool = true;
            while scanning3 {
                let te2: Token = toks.get(pg);
                if te2.kind == T_GT {
                    scanning3 = false;
                } else {
                    if te2.kind == T_EOF {
                        scanning3 = false;
                    } else {
                        let (aid, pg2) = parser_type(src, toks, pg, 1, nodes, kids);
                        let qg: i64 = localg.push(aid);
                        pg = pg2;
                        let tc2: Token = toks.get(pg);
                        if tc2.kind == T_COMMA {
                            pg = pg + 1;
                        } else {
                            scanning3 = false;
                        }
                    }
                }
            }
            let tgt: Token = toks.get(pg);
            if tgt.kind == T_GT {
                gend = tgt.end;
                p = pg + 1;
            } else {
                return parser_bail(toks, pg, nodes);
            }
        } else {
        }
        // parametric-cap USAGE `Name(2030, …)` — raw IntLit values; each
        // appends `;<value>` to the text (the name has no `;`, unambiguous).
        let tdl: Token = toks.get(p);
        if tdl.kind == T_LPAREN {
            let mut pd: i64 = p + 1;
            let mut scanningd: bool = true;
            while scanningd {
                let tdv: Token = toks.get(pd);
                if tdv.kind == T_INT {
                    let r: str = tdv.value.itoa();
                    let jd: str = full.concat(";");
                    full = jd.concat(r);
                    pd = pd + 1;
                    let tdc: Token = toks.get(pd);
                    if tdc.kind == T_COMMA {
                        pd = pd + 1;
                    } else {
                        scanningd = false;
                    }
                } else {
                    return parser_bail(toks, pd, nodes);
                }
            }
            let tdr: Token = toks.get(pd);
            if tdr.kind == T_RPAREN {
                gend = tdr.end;
                p = pd + 1;
            } else {
                return parser_bail(toks, pd, nodes);
            }
        } else {
        }
        let flen: i64 = full.len();
        let cstartn: i64 = parser_kids_commit(kids, localg);
        let idn: i64 = nodes.allocate(PNode { kind: P_K_TYPE, start: t.start, end: gend, value: flen, flags: 0, child_start: cstartn, child_count: localg.len(), text: full });
        return (idn, p);
    } else {
    }
    return parser_bail(toks, pos, nodes);
}

// Parse a `(`-led parameter list, appending K_PARAM ids to `plist`. `pos` is
// AT the `(`. Returns (end_byte, new_pos); end_byte -1 when malformed (the
// caller bails). param := IDENT ':' type annotation* — annotations are `@`-led:
// `@in REGION` (text becomes `name;region`), taint labels, `@ReadOnly`/`@Mut`.
// K_PARAM flags = mut-code (0 default / 1 readonly / 2 mut) + taint*4 +
// has-region*32; span = name.start..type.end (annotations NOT in the span —
// the oracle's param_span = name_span.join(ty.span)).
fn parser_params(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut, plist: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let t0: Token = toks.get(pos);
    if t0.kind == T_LPAREN {
    } else {
        return (0 - 1, pos);
    }
    let mut p: i64 = pos + 1;
    let mut scanning: bool = true;
    while scanning {
        let t: Token = toks.get(p);
        if t.kind == T_RPAREN {
            scanning = false;
        } else {
            if t.kind == T_EOF {
                scanning = false;
            } else {
                let tn: Token = toks.get(p);
                if tn.kind == T_IDENT {
                } else {
                    return (0 - 1, p);
                }
                let tc: Token = toks.get(p + 1);
                if tc.kind == T_COLON {
                } else {
                    return (0 - 1, p + 1);
                }
                let (tyid, p2) = parser_type(src, toks, p + 2, 1, nodes, kids);
                let mut name: str = src.substr(tn.start, tn.end);
                let mut mcode: i64 = 0;
                let mut taint: i64 = 0;
                let mut hasregion: i64 = 0;
                let mut pa: i64 = p2;
                let mut scanninga: bool = true;
                while scanninga {
                    let ta: Token = toks.get(pa);
                    if ta.kind == T_AT {
                        let ti: Token = toks.get(pa + 1);
                        if ti.kind == T_KW_IN {
                            let trg: Token = toks.get(pa + 2);
                            if trg.kind == T_IDENT {
                                let rname: str = src.substr(trg.start, trg.end);
                                let j: str = name.concat(";");
                                name = j.concat(rname);
                                hasregion = 1;
                                pa = pa + 3;
                            } else {
                                return (0 - 1, pa + 2);
                            }
                        } else {
                            if ti.kind == T_IDENT {
                                let aname: str = src.substr(ti.start, ti.end);
                                let mut known: bool = false;
                                if aname.bytes_eq("Public") {
                                    taint = 1;
                                    known = true;
                                } else {
                                }
                                if aname.bytes_eq("Internal") {
                                    taint = 2;
                                    known = true;
                                } else {
                                }
                                if aname.bytes_eq("Secret") {
                                    taint = 3;
                                    known = true;
                                } else {
                                }
                                if aname.bytes_eq("SecretCT") {
                                    taint = 4;
                                    known = true;
                                } else {
                                }
                                // Taint polymorphism. Parsed so the self-host
                                // agrees with the oracle on a `@Flow` stdlib
                                // file being syntactically clean; the taint
                                // stage refuses to VERIFY code 5 rather than
                                // decoding it as a label (tt_label_of_code).
                                if aname.bytes_eq("Flow") {
                                    taint = 5;
                                    known = true;
                                } else {
                                }
                                if aname.bytes_eq("ReadOnly") {
                                    mcode = 1;
                                    known = true;
                                } else {
                                }
                                if aname.bytes_eq("Mut") {
                                    mcode = 2;
                                    known = true;
                                } else {
                                }
                                if known {
                                } else {
                                    return (0 - 1, pa + 1);
                                }
                                pa = pa + 2;
                            } else {
                                return (0 - 1, pa + 1);
                            }
                        }
                    } else {
                        scanninga = false;
                    }
                }
                let tynode: PNode = nodes.get(tyid);
                let nlen: i64 = name.len();
                let mut localp: Vec<i64> = Vec::new();
                let qp: i64 = localp.push(tyid);
                let cstartp: i64 = parser_kids_commit(kids, localp);
                let pid: i64 = nodes.allocate(PNode { kind: P_K_PARAM, start: tn.start, end: tynode.end, value: nlen, flags: mcode + taint * 4 + hasregion * 32, child_start: cstartp, child_count: 1, text: name });
                let qq: i64 = plist.push(pid);
                p = pa;
                let tcm: Token = toks.get(p);
                if tcm.kind == T_COMMA {
                    p = p + 1;
                } else {
                    scanning = false;
                }
            }
        }
    }
    let tr: Token = toks.get(p);
    if tr.kind == T_RPAREN {
        return (tr.end, p + 1);
    } else {
    }
    return (0 - 1, p);
}

// ── statements & blocks ──────────────────────────────────────────────────────

// compound-assignment operator token → the SIMPLE operator's code (the lexer
// tag the Binary value convention uses), or 0 when `k` is not a compound op.
fn parser_compound_op(k: i64) -> i64 {
    if k == T_PLUSEQ {
        return T_PLUS;
    } else {
    }
    if k == T_MINUSEQ {
        return T_MINUS;
    } else {
    }
    if k == T_STAREQ {
        return T_STAR;
    } else {
    }
    if k == T_SLASHEQ {
        return T_SLASH;
    } else {
    }
    if k == T_PERCENTEQ {
        return T_PERCENT;
    } else {
    }
    if k == T_LTLTEQ {
        return T_LTLT;
    } else {
    }
    if k == T_GTGTEQ {
        return T_GTGT;
    } else {
    }
    if k == T_AMPEQ {
        return T_AMP;
    } else {
    }
    if k == T_PIPEEQ {
        return T_PIPE;
    } else {
    }
    return 0;
}

// Optional `@Label` taint annotation → (code, new_pos). Codes: 0 = absent,
// 1 = Public, 2 = Internal, 3 = Secret, 4 = SecretCT, 5 = Flow (taint
// polymorphism), -1 = an unknown label (the oracle's P021 — the caller
// bails). Mirrors parse_taint_annotation.
//
// The oracle admits `@Flow` only in an `fn` item's return position and
// rejects it elsewhere (P021). This helper is shared with `let`, so it
// accepts code 5 in both and does not reproduce that position rule; the
// self-host taint stage refuses to verify any function carrying code 5,
// so a `@Flow` it should have rejected is never silently approved.
fn parser_taint(src: str, toks: Vec<Token>, pos: i64) -> (i64, i64) ! { Alloc } {
    let t: Token = toks.get(pos);
    if t.kind == T_AT {
        let tn: Token = toks.get(pos + 1);
        if tn.kind == T_IDENT {
            let name: str = src.substr(tn.start, tn.end);
            if name.bytes_eq("Public") {
                return (1, pos + 2);
            } else {
            }
            if name.bytes_eq("Internal") {
                return (2, pos + 2);
            } else {
            }
            if name.bytes_eq("Secret") {
                return (3, pos + 2);
            } else {
            }
            if name.bytes_eq("SecretCT") {
                return (4, pos + 2);
            } else {
            }
            if name.bytes_eq("Flow") {
                return (5, pos + 2);
            } else {
            }
            return (0 - 1, pos + 2);
        } else {
        }
        return (0 - 1, pos + 1);
    } else {
    }
    return (0, pos);
}

// let := 'let' 'mut'? IDENT (':' type)? ('@' taint)? '=' expr ';'
// Span = let.start..semi.end; text = the name; flags = mut-bit | taint<<1;
// children = [type?, value].
fn parser_let(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let t0: Token = toks.get(pos);
    let mut p: i64 = pos + 1;
    let mut mflag: i64 = 0;
    let tm: Token = toks.get(p);
    if tm.kind == T_KW_MUT {
        mflag = 1;
        p = p + 1;
    } else {
    }
    let tn: Token = toks.get(p);
    if tn.kind == T_IDENT {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let mut local: Vec<i64> = Vec::new();
    let tc: Token = toks.get(p);
    if tc.kind == T_COLON {
        let (tid, p2) = parser_type(src, toks, p + 1, 1, nodes, kids);
        let qt: i64 = local.push(tid);
        p = p2;
    } else {
    }
    let (taint, p3) = parser_taint(src, toks, p);
    if taint < 0 {
        return parser_bail(toks, p, nodes);
    } else {
    }
    p = p3;
    let te: Token = toks.get(p);
    if te.kind == T_EQ {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let (vid, p4) = parser_expr(src, toks, p, nodes, kids);
    let qv: i64 = local.push(vid);
    let ts: Token = toks.get(p4);
    if ts.kind == T_SEMI {
        let name: str = src.substr(tn.start, tn.end);
        let nlen: i64 = name.len();
        let cstart: i64 = parser_kids_commit(kids, local);
        let id: i64 = nodes.allocate(PNode { kind: P_K_LET, start: t0.start, end: ts.end, value: nlen, flags: mflag + taint * 2, child_start: cstart, child_count: local.len(), text: name });
        return (id, p4 + 1);
    } else {
    }
    return parser_bail(toks, p4, nodes);
}

// let-tuple := 'let' '(' ('mut'? IDENT) (',' 'mut'? IDENT)* ')' (':' type)?
//              '=' expr ';'   — per-binding mut, arity 2..=12 (the oracle's
// T261 bounds). Span = let.start..semi.end; text = the binding names joined
// `;`; flags = the per-binding mut BITMASK (bit i = binding i); children =
// [type?, value].
fn parser_let_tuple(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let t0: Token = toks.get(pos);
    let mut p: i64 = pos + 2;
    let mut names: str = "";
    let mut bcount: i64 = 0;
    let mut mflags: i64 = 0;
    let mut bit: i64 = 1;
    let mut scanning: bool = true;
    while scanning {
        let t: Token = toks.get(p);
        if t.kind == T_RPAREN {
            scanning = false;
        } else {
            if t.kind == T_EOF {
                scanning = false;
            } else {
                let mut q: i64 = p;
                let tm: Token = toks.get(q);
                if tm.kind == T_KW_MUT {
                    mflags = mflags + bit;
                    q = q + 1;
                } else {
                }
                let tn: Token = toks.get(q);
                if tn.kind == T_IDENT {
                    let name: str = src.substr(tn.start, tn.end);
                    if bcount > 0 {
                        let j: str = names.concat(";");
                        names = j.concat(name);
                    } else {
                        names = name;
                    }
                    bcount = bcount + 1;
                    bit = bit * 2;
                    q = q + 1;
                } else {
                    return parser_bail(toks, q, nodes);
                }
                p = q;
                let tcm: Token = toks.get(p);
                if tcm.kind == T_COMMA {
                    p = p + 1;
                } else {
                    scanning = false;
                }
            }
        }
    }
    let tr: Token = toks.get(p);
    if tr.kind == T_RPAREN {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    if bcount < 2 {
        return parser_bail(toks, p, nodes);
    } else {
    }
    if bcount > P_MAX_TUPLE_ARITY {
        return parser_bail(toks, p, nodes);
    } else {
    }
    let mut local: Vec<i64> = Vec::new();
    let tc: Token = toks.get(p);
    if tc.kind == T_COLON {
        let (tid, p2) = parser_type(src, toks, p + 1, 1, nodes, kids);
        let qt: i64 = local.push(tid);
        p = p2;
    } else {
    }
    let te: Token = toks.get(p);
    if te.kind == T_EQ {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let (vid, p3) = parser_expr(src, toks, p, nodes, kids);
    let qv: i64 = local.push(vid);
    let ts: Token = toks.get(p3);
    if ts.kind == T_SEMI {
        let nlen: i64 = names.len();
        let cstart: i64 = parser_kids_commit(kids, local);
        let id: i64 = nodes.allocate(PNode { kind: P_K_LET_TUPLE, start: t0.start, end: ts.end, value: nlen, flags: mflags, child_start: cstart, child_count: local.len(), text: names });
        return (id, p3 + 1);
    } else {
    }
    return parser_bail(toks, p3, nodes);
}

// ── patterns (the match grammar) ─────────────────────────────────────────────

// pattern := literal | '-' INT | lo '..=' hi | '_' | IDENT | IDENT '(' b,* ')'
//          | IDENT '::' IDENT ('(' b,* ')')?
// Encodings: PAT_LIT (flags 0 = int / 1 = bool; value = the scalar — negatives
// fold like the oracle's parse_pattern_literal), PAT_LIT_STR (text = the
// decoded value), PAT_RANGE (value = lo, flags = hi; int bounds — the only
// range shape real code uses), PAT_WILDCARD, PAT_BINDING (text = the name —
// note a bare `None` IS a binding at parse time; resolution is type-check's),
// PAT_ENUM (text = `type;variant;binding…`, type EMPTY for the bare form).
fn parser_pattern(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let t: Token = toks.get(pos);
    // Array/slice destructuring `[a, _, ..rest]` (Phase 5). value = fixed-element
    // count; flags = rest kind (0 none / 1 anon `..` / 2 named); text = `;`-joined
    // element words (a binding's name, or `_` for a wildcard) then the rest name
    // iff named — byte-identical to the Rust `flatten_pattern` encoding. Elements
    // are bindings/`_` only; the rest (≤1) is the last element (else a parse bail).
    if t.kind == T_LBRACKET {
        let astart: i64 = t.start;
        let mut ap: i64 = pos + 1;
        let mut atext: str = "";
        let mut rkind: i64 = 0;
        let mut sawrest: bool = false;
        let mut aend: i64 = 0;
        let mut aclosed: bool = false;
        let mut aerr: bool = false;
        let mut ago: bool = true;
        while ago {
            let ct: Token = toks.get(ap);
            if ct.kind == T_RBRACKET {
                aend = ct.end;
                ap = ap + 1;
                aclosed = true;
                ago = false;
            } else {
                if ct.kind == T_DOTDOT {
                    if sawrest {
                        aerr = true;
                        ago = false;
                    } else {
                        let nt: Token = toks.get(ap + 1);
                        if nt.kind == T_IDENT {
                            let rname: str = src.substr(nt.start, nt.end);
                            if rname.bytes_eq("_") {
                                rkind = 1;
                                ap = ap + 2;
                            } else {
                                rkind = 2;
                                if atext.len() == 0 {
                                    let rz: str = "";
                                    atext = rz.concat(rname);
                                } else {
                                    let rj: str = atext.concat(";");
                                    atext = rj.concat(rname);
                                }
                                ap = ap + 2;
                            }
                        } else {
                            rkind = 1;
                            ap = ap + 1;
                        }
                        sawrest = true;
                    }
                } else {
                    if sawrest {
                        // a fixed element after `..rest` — suffix unsupported.
                        aerr = true;
                        ago = false;
                    } else {
                        if ct.kind == T_IDENT {
                            let elname: str = src.substr(ct.start, ct.end);
                            if atext.len() == 0 {
                                let ez: str = "";
                                atext = ez.concat(elname);
                            } else {
                                let ej: str = atext.concat(";");
                                atext = ej.concat(elname);
                            }
                            ap = ap + 1;
                        } else {
                            aerr = true;
                            ago = false;
                        }
                    }
                }
                if ago {
                    let cm: Token = toks.get(ap);
                    if cm.kind == T_COMMA {
                        ap = ap + 1;
                    } else {
                        let rb: Token = toks.get(ap);
                        if rb.kind == T_RBRACKET {
                            aend = rb.end;
                            ap = ap + 1;
                            aclosed = true;
                        } else {
                            aerr = true;
                        }
                        ago = false;
                    }
                } else {
                }
            }
        }
        if aerr {
            return parser_bail(toks, ap, nodes);
        } else {
        }
        if aclosed {
            let alen: i64 = atext.len();
            let ida: i64 = nodes.allocate(PNode { kind: P_K_PAT_ARRAY, start: astart, end: aend, value: alen, flags: rkind, child_start: 0, child_count: 0, text: atext });
            return (ida, ap);
        } else {
        }
        return parser_bail(toks, ap, nodes);
    } else {
    }
    let mut lo: i64 = 0;
    let mut lostart: i64 = 0 - 1;
    let mut loend: i64 = 0;
    let mut p: i64 = pos;
    if t.kind == T_INT {
        lo = t.value;
        lostart = t.start;
        loend = t.end;
        p = pos + 1;
    } else {
    }
    if t.kind == T_MINUS {
        let tn: Token = toks.get(pos + 1);
        if tn.kind == T_INT {
            lo = 0 - tn.value;
            lostart = t.start;
            loend = tn.end;
            p = pos + 2;
        } else {
        }
    } else {
    }
    if lostart >= 0 {
        // an int literal (possibly negative) — standalone or a range's lo.
        let td: Token = toks.get(p);
        if td.kind == T_DOTDOTEQ {
            let th: Token = toks.get(p + 1);
            if th.kind == T_INT {
                let idr: i64 = nodes.allocate(PNode { kind: P_K_PAT_RANGE, start: lostart, end: th.end, value: lo, flags: th.value, child_start: 0, child_count: 0, text: "" });
                return (idr, p + 2);
            } else {
            }
            if th.kind == T_MINUS {
                let th2: Token = toks.get(p + 2);
                if th2.kind == T_INT {
                    let idr2: i64 = nodes.allocate(PNode { kind: P_K_PAT_RANGE, start: lostart, end: th2.end, value: lo, flags: 0 - th2.value, child_start: 0, child_count: 0, text: "" });
                    return (idr2, p + 3);
                } else {
                }
            } else {
            }
            return parser_bail(toks, p + 1, nodes);
        } else {
        }
        let idl: i64 = nodes.allocate(PNode { kind: P_K_PAT_LIT, start: lostart, end: loend, value: lo, flags: 0, child_start: 0, child_count: 0, text: "" });
        return (idl, p);
    } else {
    }
    if t.kind == T_BOOL {
        let idb: i64 = nodes.allocate(PNode { kind: P_K_PAT_LIT, start: t.start, end: t.end, value: t.value, flags: 1, child_start: 0, child_count: 0, text: "" });
        return (idb, pos + 1);
    } else {
    }
    if t.kind == T_STR {
        let slen: i64 = t.text.len();
        let ids: i64 = nodes.allocate(PNode { kind: P_K_PAT_LIT_STR, start: t.start, end: t.end, value: slen, flags: 0, child_start: 0, child_count: 0, text: t.text });
        return (ids, pos + 1);
    } else {
    }
    if t.kind == T_IDENT {
        let name: str = src.substr(t.start, t.end);
        if name.bytes_eq("_") {
            let idw: i64 = nodes.allocate(PNode { kind: P_K_PAT_WILDCARD, start: t.start, end: t.end, value: 0, flags: 0, child_start: 0, child_count: 0, text: "" });
            return (idw, pos + 1);
        } else {
        }
        let tn2: Token = toks.get(pos + 1);
        if tn2.kind == T_COLONCOLON {
            let tv: Token = toks.get(pos + 2);
            if tv.kind == T_IDENT {
                let variant: str = src.substr(tv.start, tv.end);
                let j1: str = name.concat(";");
                let mut etext: str = j1.concat(variant);
                let tl: Token = toks.get(pos + 3);
                if tl.kind == T_LPAREN {
                    let (btext, bend, bp) = parser_pat_bindings(src, toks, pos + 3, etext);
                    if bend < 0 {
                        return parser_bail(toks, bp, nodes);
                    } else {
                    }
                    let elen: i64 = btext.len();
                    let ide: i64 = nodes.allocate(PNode { kind: P_K_PAT_ENUM, start: t.start, end: bend, value: elen, flags: 0, child_start: 0, child_count: 0, text: btext });
                    return (ide, bp);
                } else {
                }
                let elen2: i64 = etext.len();
                let ide2: i64 = nodes.allocate(PNode { kind: P_K_PAT_ENUM, start: t.start, end: tv.end, value: elen2, flags: 0, child_start: 0, child_count: 0, text: etext });
                return (ide2, pos + 3);
            } else {
            }
            return parser_bail(toks, pos + 2, nodes);
        } else {
        }
        if tn2.kind == T_LPAREN {
            // bare variant `Some(x)` — the oracle's type_name is EMPTY (so the
            // text starts with `;`). NOTE the bound literal: a method on a
            // string-literal receiver doesn't parse (dots extend paths only).
            let semi: str = ";";
            let j2: str = semi.concat(name);
            let (btext2, bend2, bp2) = parser_pat_bindings(src, toks, pos + 1, j2);
            if bend2 < 0 {
                return parser_bail(toks, bp2, nodes);
            } else {
            }
            let elen3: i64 = btext2.len();
            let ide3: i64 = nodes.allocate(PNode { kind: P_K_PAT_ENUM, start: t.start, end: bend2, value: elen3, flags: 0, child_start: 0, child_count: 0, text: btext2 });
            return (ide3, bp2);
        } else {
        }
        let nlen: i64 = name.len();
        let idn: i64 = nodes.allocate(PNode { kind: P_K_PAT_BINDING, start: t.start, end: t.end, value: nlen, flags: 0, child_start: 0, child_count: 0, text: name });
        return (idn, pos + 1);
    } else {
    }
    return parser_bail(toks, pos, nodes);
}

// Parse a `(`-led pattern-binding list, appending `;name` per binding to
// `acc`. `pos` is AT the `(`. Returns (text, end_byte, new_pos); end_byte -1
// when the list never closes (the caller bails). Bindings are plain idents
// (incl. `_`, which lexes as an ident).
fn parser_pat_bindings(src: str, toks: Vec<Token>, pos: i64, acc: str) -> (str, i64, i64) ! { Alloc } {
    let mut text: str = acc;
    let mut p: i64 = pos + 1;
    let mut scanning: bool = true;
    while scanning {
        let t: Token = toks.get(p);
        if t.kind == T_RPAREN {
            scanning = false;
        } else {
            if t.kind == T_EOF {
                scanning = false;
            } else {
                if t.kind == T_IDENT {
                    let b: str = src.substr(t.start, t.end);
                    let j: str = text.concat(";");
                    text = j.concat(b);
                    p = p + 1;
                    let tc: Token = toks.get(p);
                    if tc.kind == T_COMMA {
                        p = p + 1;
                    } else {
                        scanning = false;
                    }
                } else {
                    return (text, 0 - 1, p);
                }
            }
        }
    }
    let tr: Token = toks.get(p);
    if tr.kind == T_RPAREN {
        return (text, tr.end, p + 1);
    } else {
    }
    return (text, 0 - 1, p);
}

// ── control-flow statements ──────────────────────────────────────────────────

// if := 'if' expr block ('else' block)?   — PR-E1: the else branch is OPTIONAL.
// When absent, an EMPTY else block (a zero-width P_K_BLOCK at the then-block's end)
// is synthesized so P_K_IF keeps 3 children [cond, then, else] — matching the Rust
// parser's synthesized empty else for node-for-node differential parity. span =
// if..else-block.end (= then-block.end when the else is synthesized).
fn parser_if(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let t0: Token = toks.get(pos);
    let tlet: Token = toks.get(pos + 1);
    if tlet.kind == T_KW_LET {
        return parser_if_let(src, toks, pos, nodes, kids);
    } else {
    }
    let (cid, p1) = parser_expr(src, toks, pos + 1, nodes, kids);
    let (tid, p2) = parser_block(src, toks, p1, nodes, kids);
    let tnode: PNode = nodes.get(tid);
    let te: Token = toks.get(p2);
    let mut eid: i64 = 0;
    let mut p3: i64 = p2;
    let mut eend: i64 = tnode.end;
    if te.kind == T_KW_ELSE {
        let (eid2, p3b) = parser_block(src, toks, p2 + 1, nodes, kids);
        let enode: PNode = nodes.get(eid2);
        eid = eid2;
        p3 = p3b;
        eend = enode.end;
    } else {
        let mut elocal: Vec<i64> = Vec::new();
        let ecs: i64 = parser_kids_commit(kids, elocal);
        let esid: i64 = nodes.allocate(PNode { kind: P_K_BLOCK, start: tnode.end, end: tnode.end, value: 0, flags: 0, child_start: ecs, child_count: 0, text: "" });
        eid = esid;
        p3 = p2;
        eend = tnode.end;
    }
    let mut local: Vec<i64> = Vec::new();
    let q1: i64 = local.push(cid);
    let q2: i64 = local.push(tid);
    let q3: i64 = local.push(eid);
    let cstart: i64 = parser_kids_commit(kids, local);
    let id: i64 = nodes.allocate(PNode { kind: P_K_IF, start: t0.start, end: eend, value: 0, flags: 0, child_start: cstart, child_count: 3, text: "" });
    return (id, p3);
}

// while := 'while' expr block. Children [cond, body]; span = while..body.end.
fn parser_while(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let t0: Token = toks.get(pos);
    let tlet: Token = toks.get(pos + 1);
    if tlet.kind == T_KW_LET {
        return parser_while_let(src, toks, pos, nodes, kids);
    } else {
    }
    let (cid, p1) = parser_expr(src, toks, pos + 1, nodes, kids);
    let (bid, p2) = parser_block(src, toks, p1, nodes, kids);
    let bnode: PNode = nodes.get(bid);
    let mut local: Vec<i64> = Vec::new();
    let q1: i64 = local.push(cid);
    let q2: i64 = local.push(bid);
    let cstart: i64 = parser_kids_commit(kids, local);
    let id: i64 = nodes.allocate(PNode { kind: P_K_WHILE, start: t0.start, end: bnode.end, value: 0, flags: 0, child_start: cstart, child_count: 2, text: "" });
    return (id, p2);
}

// PR-E2: `if let PATTERN = E { T } else { F }` desugars to
// `match E { PATTERN => { T }, _ => { F } }` (a P_K_MATCH node, 3 children
// [scrutinee, arm1, arm2]). `else` is OPTIONAL: when absent an EMPTY F block (a
// zero-width P_K_BLOCK at the then-block's end, per PR-E1) is synthesized. The
// synthetic wildcard pattern is zero-width at F.start, so the node tree matches
// the Rust parser's desugar byte-for-byte (parser-differential parity). arm spans:
// arm1 = pattern.start..then.end, arm2 = F.start..F.end; match span = if..F.end.
fn parser_if_let(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let t0: Token = toks.get(pos);
    let (pid, p1) = parser_pattern(src, toks, pos + 2, nodes, kids);
    let teq: Token = toks.get(p1);
    if teq.kind == T_EQ {
    } else {
        return parser_bail(toks, p1, nodes);
    }
    let (sid, p2) = parser_expr(src, toks, p1 + 1, nodes, kids);
    let (tid, p3) = parser_block(src, toks, p2, nodes, kids);
    let tnode: PNode = nodes.get(tid);
    let te: Token = toks.get(p3);
    let mut fid: i64 = 0;
    let mut p4: i64 = p3;
    let mut fstart: i64 = tnode.end;
    let mut fend: i64 = tnode.end;
    if te.kind == T_KW_ELSE {
        let (fid2, p4b) = parser_block(src, toks, p3 + 1, nodes, kids);
        let fnode: PNode = nodes.get(fid2);
        fid = fid2;
        p4 = p4b;
        fstart = fnode.start;
        fend = fnode.end;
    } else {
        let mut flocal: Vec<i64> = Vec::new();
        let fcs: i64 = parser_kids_commit(kids, flocal);
        let fsid: i64 = nodes.allocate(PNode { kind: P_K_BLOCK, start: tnode.end, end: tnode.end, value: 0, flags: 0, child_start: fcs, child_count: 0, text: "" });
        fid = fsid;
        p4 = p3;
        fstart = tnode.end;
        fend = tnode.end;
    }
    let pnode: PNode = nodes.get(pid);
    let mut a1local: Vec<i64> = Vec::new();
    let qa1p: i64 = a1local.push(pid);
    let qa1b: i64 = a1local.push(tid);
    let a1cs: i64 = parser_kids_commit(kids, a1local);
    let a1id: i64 = nodes.allocate(PNode { kind: P_K_MATCH_ARM, start: pnode.start, end: tnode.end, value: 0, flags: 0, child_start: a1cs, child_count: 2, text: "" });
    let wid: i64 = nodes.allocate(PNode { kind: P_K_PAT_WILDCARD, start: fstart, end: fstart, value: 0, flags: 0, child_start: 0, child_count: 0, text: "" });
    let mut a2local: Vec<i64> = Vec::new();
    let qa2p: i64 = a2local.push(wid);
    let qa2b: i64 = a2local.push(fid);
    let a2cs: i64 = parser_kids_commit(kids, a2local);
    let a2id: i64 = nodes.allocate(PNode { kind: P_K_MATCH_ARM, start: fstart, end: fend, value: 0, flags: 0, child_start: a2cs, child_count: 2, text: "" });
    let mut mlocal: Vec<i64> = Vec::new();
    let qms: i64 = mlocal.push(sid);
    let qm1: i64 = mlocal.push(a1id);
    let qm2: i64 = mlocal.push(a2id);
    let mcs: i64 = parser_kids_commit(kids, mlocal);
    let mid: i64 = nodes.allocate(PNode { kind: P_K_MATCH, start: t0.start, end: fend, value: 0, flags: 0, child_start: mcs, child_count: 3, text: "" });
    return (mid, p4);
}

// PR-E2: `while let PATTERN = E { B }` desugars to
// `while true { match E { PATTERN => { B }, _ => { break; } } }`. The synthetic
// `true` condition is a zero-width P_K_LIT_BOOL (value 1) at the `while` keyword;
// the wildcard / break / break-block are zero-width at B.end; the inner block and
// match both span scrutinee.start..B.end. Mirrors the Rust desugar node-for-node.
fn parser_while_let(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let t0: Token = toks.get(pos);
    let (pid, p1) = parser_pattern(src, toks, pos + 2, nodes, kids);
    let teq: Token = toks.get(p1);
    if teq.kind == T_EQ {
    } else {
        return parser_bail(toks, p1, nodes);
    }
    let (sid, p2) = parser_expr(src, toks, p1 + 1, nodes, kids);
    let (bid, p3) = parser_block(src, toks, p2, nodes, kids);
    let bnode: PNode = nodes.get(bid);
    let pnode: PNode = nodes.get(pid);
    let a: i64 = bnode.end;
    // The synthetic match/inner-block span starts at the PATTERN (which in
    // `while let P = E` precedes the scrutinee), so arm1 nests in the match — the
    // ET-P6 span-containment invariant holds.
    let mstart: i64 = pnode.start;
    let mut a1local: Vec<i64> = Vec::new();
    let qa1p: i64 = a1local.push(pid);
    let qa1b: i64 = a1local.push(bid);
    let a1cs: i64 = parser_kids_commit(kids, a1local);
    let a1id: i64 = nodes.allocate(PNode { kind: P_K_MATCH_ARM, start: pnode.start, end: a, value: 0, flags: 0, child_start: a1cs, child_count: 2, text: "" });
    let brid: i64 = nodes.allocate(PNode { kind: P_K_BREAK, start: a, end: a, value: 0, flags: 0, child_start: 0, child_count: 0, text: "" });
    let mut bblocal: Vec<i64> = Vec::new();
    let qbb: i64 = bblocal.push(brid);
    let bbcs: i64 = parser_kids_commit(kids, bblocal);
    let bbid: i64 = nodes.allocate(PNode { kind: P_K_BLOCK, start: a, end: a, value: 0, flags: 0, child_start: bbcs, child_count: 1, text: "" });
    let wid: i64 = nodes.allocate(PNode { kind: P_K_PAT_WILDCARD, start: a, end: a, value: 0, flags: 0, child_start: 0, child_count: 0, text: "" });
    let mut a2local: Vec<i64> = Vec::new();
    let qa2p: i64 = a2local.push(wid);
    let qa2b: i64 = a2local.push(bbid);
    let a2cs: i64 = parser_kids_commit(kids, a2local);
    let a2id: i64 = nodes.allocate(PNode { kind: P_K_MATCH_ARM, start: a, end: a, value: 0, flags: 0, child_start: a2cs, child_count: 2, text: "" });
    let mut mlocal: Vec<i64> = Vec::new();
    let qms: i64 = mlocal.push(sid);
    let qm1: i64 = mlocal.push(a1id);
    let qm2: i64 = mlocal.push(a2id);
    let mcs: i64 = parser_kids_commit(kids, mlocal);
    let mid: i64 = nodes.allocate(PNode { kind: P_K_MATCH, start: mstart, end: a, value: 0, flags: 0, child_start: mcs, child_count: 3, text: "" });
    let mut iblocal: Vec<i64> = Vec::new();
    let qib: i64 = iblocal.push(mid);
    let ibcs: i64 = parser_kids_commit(kids, iblocal);
    let ibid: i64 = nodes.allocate(PNode { kind: P_K_BLOCK, start: mstart, end: a, value: 0, flags: 0, child_start: ibcs, child_count: 1, text: "" });
    let cid: i64 = nodes.allocate(PNode { kind: P_K_LIT_BOOL, start: t0.start, end: t0.start, value: 1, flags: 0, child_start: 0, child_count: 0, text: "" });
    let mut wlocal: Vec<i64> = Vec::new();
    let qwc: i64 = wlocal.push(cid);
    let qwb: i64 = wlocal.push(ibid);
    let wcs: i64 = parser_kids_commit(kids, wlocal);
    let widx: i64 = nodes.allocate(PNode { kind: P_K_WHILE, start: t0.start, end: a, value: 0, flags: 0, child_start: wcs, child_count: 2, text: "" });
    return (widx, p3);
}

// for-in := 'for' IDENT 'in' expr block. text = the loop variable; children
// [iterable, body]; span = for..body.end.
// RF-M4: a `..` after the first expr switches to the RANGE form
// `for v in a..b { … }` (children [start, end, body], kind P_K_FOR_RANGE) —
// recognized HERE, in for-header position only, exactly like the oracle:
// parser_expr's postfix loop stops at T_DOTDOT (`..` is only ever consumed
// inside `[…]` slice brackets), so `a..b` cleanly splits into two expressions.
// `..=` is the oracle's P029 reject — the shadow bails (its generic error
// path); no differential fixture may contain it.
fn parser_for(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let t0: Token = toks.get(pos);
    let tv: Token = toks.get(pos + 1);
    if tv.kind == T_IDENT {
    } else {
        return parser_bail(toks, pos + 1, nodes);
    }
    let ti: Token = toks.get(pos + 2);
    if ti.kind == T_KW_IN {
    } else {
        return parser_bail(toks, pos + 2, nodes);
    }
    let (xid, p1) = parser_expr(src, toks, pos + 3, nodes, kids);
    let trd: Token = toks.get(p1);
    if trd.kind == T_DOTDOTEQ {
        return parser_bail(toks, p1, nodes);
    } else {
    }
    if trd.kind == T_DOTDOT {
        let (eid, pe) = parser_expr(src, toks, p1 + 1, nodes, kids);
        let (rbid, pr) = parser_block(src, toks, pe, nodes, kids);
        let rbnode: PNode = nodes.get(rbid);
        let rvname: str = src.substr(tv.start, tv.end);
        let rvlen: i64 = rvname.len();
        let mut rlocal: Vec<i64> = Vec::new();
        let qr1: i64 = rlocal.push(xid);
        let qr2: i64 = rlocal.push(eid);
        let qr3: i64 = rlocal.push(rbid);
        let rcstart: i64 = parser_kids_commit(kids, rlocal);
        let rid: i64 = nodes.allocate(PNode { kind: P_K_FOR_RANGE, start: t0.start, end: rbnode.end, value: rvlen, flags: 0, child_start: rcstart, child_count: 3, text: rvname });
        return (rid, pr);
    } else {
    }
    let (bid, p2) = parser_block(src, toks, p1, nodes, kids);
    let bnode: PNode = nodes.get(bid);
    let vname: str = src.substr(tv.start, tv.end);
    let vlen: i64 = vname.len();
    let mut local: Vec<i64> = Vec::new();
    let q1: i64 = local.push(xid);
    let q2: i64 = local.push(bid);
    let cstart: i64 = parser_kids_commit(kids, local);
    let id: i64 = nodes.allocate(PNode { kind: P_K_FOR_IN, start: t0.start, end: bnode.end, value: vlen, flags: 0, child_start: cstart, child_count: 2, text: vname });
    return (id, p2);
}

// match := 'match' expr '{' arm* '}' — arm := pattern ('if' expr)? '=>' block,
// with OPTIONAL ',' / ';' separators (the oracle advances past either).
// Children [scrutinee, arm…]; span = match..'}'.end. Arm children
// [pattern, guard?, body]; arm flags bit0 = has-guard; arm span =
// pattern.start..body.end.
fn parser_match(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let t0: Token = toks.get(pos);
    let (sid, p1) = parser_expr(src, toks, pos + 1, nodes, kids);
    let tb: Token = toks.get(p1);
    if tb.kind == T_LBRACE {
    } else {
        return parser_bail(toks, p1, nodes);
    }
    let mut local: Vec<i64> = Vec::new();
    let qs: i64 = local.push(sid);
    let mut p: i64 = p1 + 1;
    let mut scanning: bool = true;
    while scanning {
        let t: Token = toks.get(p);
        if t.kind == T_RBRACE {
            scanning = false;
        } else {
            if t.kind == T_EOF {
                scanning = false;
            } else {
                let (pid, pp) = parser_pattern(src, toks, p, nodes, kids);
                let mut armlocal: Vec<i64> = Vec::new();
                let qp: i64 = armlocal.push(pid);
                let mut gflag: i64 = 0;
                let mut pg: i64 = pp;
                let tg: Token = toks.get(pg);
                if tg.kind == T_KW_IF {
                    let (gid, pg2) = parser_expr(src, toks, pg + 1, nodes, kids);
                    let qg: i64 = armlocal.push(gid);
                    gflag = 1;
                    pg = pg2;
                } else {
                }
                let ta: Token = toks.get(pg);
                if ta.kind == T_FATARROW {
                } else {
                    return parser_bail(toks, pg, nodes);
                }
                let (bid, pb) = parser_block(src, toks, pg + 1, nodes, kids);
                let qb: i64 = armlocal.push(bid);
                let pnode: PNode = nodes.get(pid);
                let bnode: PNode = nodes.get(bid);
                let acstart: i64 = parser_kids_commit(kids, armlocal);
                let aid: i64 = nodes.allocate(PNode { kind: P_K_MATCH_ARM, start: pnode.start, end: bnode.end, value: 0, flags: gflag, child_start: acstart, child_count: armlocal.len(), text: "" });
                let qa: i64 = local.push(aid);
                p = pb;
                let tsep: Token = toks.get(p);
                let mut issep: bool = false;
                if tsep.kind == T_COMMA {
                    issep = true;
                } else {
                }
                if tsep.kind == T_SEMI {
                    issep = true;
                } else {
                }
                if issep {
                    p = p + 1;
                } else {
                    if tsep.kind == T_RBRACE {
                    } else {
                        return parser_bail(toks, p, nodes);
                    }
                }
            }
        }
    }
    let tc: Token = toks.get(p);
    if tc.kind == T_RBRACE {
        let cstart: i64 = parser_kids_commit(kids, local);
        let id: i64 = nodes.allocate(PNode { kind: P_K_MATCH, start: t0.start, end: tc.end, value: 0, flags: 0, child_start: cstart, child_count: local.len(), text: "" });
        return (id, p + 1);
    } else {
    }
    return parser_bail(toks, p, nodes);
}

// stmt := let | let-tuple | if | match | while | for-in | break | continue
//       | 'return' expr? ';' | expr ('='|op'=') expr ';' | expr ';'
// Mirrors the oracle's parse_statement dispatch + its assignment quirk: a
// LOCAL compound `x op= rhs` desugars AT PARSE TIME to `x = x op rhs` — the
// target path is CLONED as the Binary's lhs and the Binary's span is the
// WHOLE STATEMENT's; a FIELD/INDEX compound keeps the op (the Assign node's
// `value` field carries the op code, 0 when plain). Assign children =
// [target, value]; span = stmt.start..semi.end.
fn parser_stmt(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let t: Token = toks.get(pos);
    if t.kind == T_KW_LET {
        let tn0: Token = toks.get(pos + 1);
        if tn0.kind == T_LPAREN {
            return parser_let_tuple(src, toks, pos, nodes, kids);
        } else {
        }
        return parser_let(src, toks, pos, nodes, kids);
    } else {
    }
    if t.kind == T_KW_IF {
        return parser_if(src, toks, pos, nodes, kids);
    } else {
    }
    if t.kind == T_KW_MATCH {
        return parser_match(src, toks, pos, nodes, kids);
    } else {
    }
    if t.kind == T_KW_WHILE {
        return parser_while(src, toks, pos, nodes, kids);
    } else {
    }
    if t.kind == T_KW_FOR {
        return parser_for(src, toks, pos, nodes, kids);
    } else {
    }
    if t.kind == T_KW_BREAK {
        let tn1: Token = toks.get(pos + 1);
        if tn1.kind == T_SEMI {
            let idb: i64 = nodes.allocate(PNode { kind: P_K_BREAK, start: t.start, end: tn1.end, value: 0, flags: 0, child_start: 0, child_count: 0, text: "" });
            return (idb, pos + 2);
        } else {
        }
        return parser_bail(toks, pos + 1, nodes);
    } else {
    }
    if t.kind == T_KW_CONTINUE {
        let tn2: Token = toks.get(pos + 1);
        if tn2.kind == T_SEMI {
            let idc: i64 = nodes.allocate(PNode { kind: P_K_CONTINUE, start: t.start, end: tn2.end, value: 0, flags: 0, child_start: 0, child_count: 0, text: "" });
            return (idc, pos + 2);
        } else {
        }
        return parser_bail(toks, pos + 1, nodes);
    } else {
    }
    if t.kind == T_KW_RETURN {
        let tn: Token = toks.get(pos + 1);
        if tn.kind == T_SEMI {
            let id: i64 = nodes.allocate(PNode { kind: P_K_RETURN, start: t.start, end: tn.end, value: 0, flags: 0, child_start: 0, child_count: 0, text: "" });
            return (id, pos + 2);
        } else {
        }
        let (e, p2) = parser_expr(src, toks, pos + 1, nodes, kids);
        let ts: Token = toks.get(p2);
        if ts.kind == T_SEMI {
            let mut local: Vec<i64> = Vec::new();
            let q: i64 = local.push(e);
            let cstart: i64 = parser_kids_commit(kids, local);
            let id2: i64 = nodes.allocate(PNode { kind: P_K_RETURN, start: t.start, end: ts.end, value: 0, flags: 0, child_start: cstart, child_count: 1, text: "" });
            return (id2, p2 + 1);
        } else {
        }
        return parser_bail(toks, p2, nodes);
    } else {
    }
    // expression statement OR assignment: parse the leading expression, then
    // a trailing `=` / `op=` makes it an assignment with that place as target.
    let (lhs, p1) = parser_expr(src, toks, pos, nodes, kids);
    let ta: Token = toks.get(p1);
    if ta.kind == T_EQ {
        let (vid, p2) = parser_expr(src, toks, p1 + 1, nodes, kids);
        let ts2: Token = toks.get(p2);
        if ts2.kind == T_SEMI {
            let mut locala: Vec<i64> = Vec::new();
            let q1: i64 = locala.push(lhs);
            let q2: i64 = locala.push(vid);
            let cstarta: i64 = parser_kids_commit(kids, locala);
            let ida: i64 = nodes.allocate(PNode { kind: P_K_ASSIGN, start: t.start, end: ts2.end, value: 0, flags: 0, child_start: cstarta, child_count: 2, text: "" });
            return (ida, p2 + 1);
        } else {
        }
        return parser_bail(toks, p2, nodes);
    } else {
    }
    let cop: i64 = parser_compound_op(ta.kind);
    if cop > 0 {
        let (rid, p2) = parser_expr(src, toks, p1 + 1, nodes, kids);
        let ts3: Token = toks.get(p2);
        if ts3.kind == T_SEMI {
            let lnode: PNode = nodes.get(lhs);
            let mut is_local: bool = false;
            if lnode.kind == P_K_PATH {
                // W-REACH: "::"-detection as an inline byte scan (58 = ':'). This was the
                // compiler's ONE `.contains` — it alone pulled strings::str_contains (and
                // through it the whole parse/contains stdlib cluster) into the W-emit
                // surface; the scan computes the identical boolean in the emittable subset.
                let ltxt: str = lnode.text;
                let ltn: i64 = ltxt.len();
                let mut has_cc: bool = false;
                let mut ci: i64 = 0;
                while ci + 1 < ltn {
                    if ltxt.byte_at(ci) == 58 {
                        if ltxt.byte_at(ci + 1) == 58 {
                            has_cc = true;
                            ci = ltn;
                        } else {
                            ci = ci + 1;
                        }
                    } else {
                        ci = ci + 1;
                    }
                }
                if has_cc {
                } else {
                    is_local = true;
                }
            } else {
            }
            if is_local {
                // the local desugar: value = `target op rhs`, the target path
                // CLONED as lhs, the Binary spanning the whole statement.
                let clone: i64 = nodes.allocate(PNode { kind: lnode.kind, start: lnode.start, end: lnode.end, value: lnode.value, flags: lnode.flags, child_start: lnode.child_start, child_count: lnode.child_count, text: lnode.text });
                let mut localb: Vec<i64> = Vec::new();
                let qb1: i64 = localb.push(clone);
                let qb2: i64 = localb.push(rid);
                let cstartb: i64 = parser_kids_commit(kids, localb);
                let bid: i64 = nodes.allocate(PNode { kind: P_K_BINARY, start: t.start, end: ts3.end, value: cop, flags: 0, child_start: cstartb, child_count: 2, text: "" });
                let mut localc: Vec<i64> = Vec::new();
                let qc1: i64 = localc.push(lhs);
                let qc2: i64 = localc.push(bid);
                let cstartc: i64 = parser_kids_commit(kids, localc);
                let idc: i64 = nodes.allocate(PNode { kind: P_K_ASSIGN, start: t.start, end: ts3.end, value: 0, flags: 0, child_start: cstartc, child_count: 2, text: "" });
                return (idc, p2 + 1);
            } else {
            }
            let mut locald: Vec<i64> = Vec::new();
            let qd1: i64 = locald.push(lhs);
            let qd2: i64 = locald.push(rid);
            let cstartd: i64 = parser_kids_commit(kids, locald);
            let idd: i64 = nodes.allocate(PNode { kind: P_K_ASSIGN, start: t.start, end: ts3.end, value: cop, flags: 0, child_start: cstartd, child_count: 2, text: "" });
            return (idd, p2 + 1);
        } else {
        }
        return parser_bail(toks, p2, nodes);
    } else {
    }
    if ta.kind == T_SEMI {
        let mut locale: Vec<i64> = Vec::new();
        let qe: i64 = locale.push(lhs);
        let cstarte: i64 = parser_kids_commit(kids, locale);
        let ide: i64 = nodes.allocate(PNode { kind: P_K_EXPR_STMT, start: t.start, end: ta.end, value: 0, flags: 0, child_start: cstarte, child_count: 1, text: "" });
        return (ide, p1 + 1);
    } else {
    }
    return parser_bail(toks, p1, nodes);
}

// block := '{' stmt* '}'. Span = lbrace.start .. rbrace.end (the oracle joins
// lbrace, the last statement, and rbrace — rbrace ends it).
fn parser_block(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let t0: Token = toks.get(pos);
    if t0.kind == T_LBRACE {
    } else {
        return parser_bail(toks, pos, nodes);
    }
    let mut local: Vec<i64> = Vec::new();
    let mut p: i64 = pos + 1;
    let mut scanning: bool = true;
    while scanning {
        let t: Token = toks.get(p);
        if t.kind == T_RBRACE {
            scanning = false;
        } else {
            if t.kind == T_EOF {
                scanning = false;
            } else {
                let (sid, p2) = parser_stmt(src, toks, p, nodes, kids);
                let q: i64 = local.push(sid);
                p = p2;
            }
        }
    }
    let tc: Token = toks.get(p);
    if tc.kind == T_RBRACE {
        let cstart: i64 = parser_kids_commit(kids, local);
        let id: i64 = nodes.allocate(PNode { kind: P_K_BLOCK, start: t0.start, end: tc.end, value: 0, flags: 0, child_start: cstart, child_count: local.len(), text: "" });
        return (id, p + 1);
    } else {
    }
    return parser_bail(toks, p, nodes);
}

// ── items ────────────────────────────────────────────────────────────────────

// Optional `<T: Bound + Bound, U>` type-parameter list. Appends a
// K_TYPE_PARAM per parameter (text = `name` or `name;bound1;…`; span = the
// NAME token only — the oracle's TypeParam.span ignores the bounds). Returns
// (ok, new_pos): ok < 0 on a malformed list (the caller bails); not-at-`<`
// returns (0, pos) untouched.
fn parser_type_params(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, tplist: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let t0: Token = toks.get(pos);
    if t0.kind == T_LT {
    } else {
        return (0, pos);
    }
    let mut p: i64 = pos + 1;
    let mut scanning: bool = true;
    while scanning {
        let t: Token = toks.get(p);
        if t.kind == T_GT {
            scanning = false;
        } else {
            if t.kind == T_EOF {
                scanning = false;
            } else {
                // R2/R3: the parameter KIND rides `flags`. 0 = Star (ordinary
                // value generic); 1 = State (`<@S>`, R3); 1+arity = Constructor
                // (`<F: * -> *>`, R4). A leading `@` (token-disjoint from a bare
                // ident and from `*`) marks a State-kinded binder; the `@` is
                // consumed and the param SPAN covers the NAME only (mirrors the
                // oracle's expect_ident span, parser.rs:2310-2314).
                let mut kindcode: i64 = 0;
                let mut np: i64 = p;
                if t.kind == T_AT {
                    kindcode = 1;
                    np = p + 1;
                } else {
                }
                let nt: Token = toks.get(np);
                if nt.kind == T_IDENT {
                } else {
                    return (0 - 1, np);
                }
                let mut text: str = src.substr(nt.start, nt.end);
                let mut q: i64 = np + 1;
                let tc: Token = toks.get(q);
                if tc.kind == T_COLON {
                    // R3: a State binder `@S` takes no `:` bound or kind (the
                    // oracle P028s). Bail to keep error PRESENCE parity; no clean
                    // fixture uses `<@S: …>`.
                    if kindcode == 1 {
                        return (0 - 1, q);
                    } else {
                    }
                    q = q + 1;
                    // R4: fork on the post-`:` token. A `*` begins a higher-
                    // kinded KIND annotation `<F: * -> *>` (token-disjoint from a
                    // trait-bound name); an optional `+ Bound …` may still follow.
                    // Otherwise it is the ordinary trait-bound list. Mirrors
                    // parser.rs:2336-2357.
                    let tk: Token = toks.get(q);
                    if tk.kind == T_STAR {
                        // parse `* (-> *)*`; kindcode = 1 + arrow-count, arity in
                        // [1, P_MAX_KIND_ARITY] (P027 otherwise — bail). Mirrors
                        // parse_kind (parser.rs:2400).
                        q = q + 1;
                        let mut arity: i64 = 0;
                        let mut kscan: bool = true;
                        while kscan {
                            let tar: Token = toks.get(q);
                            if tar.kind == T_ARROW {
                                q = q + 1;
                                let tst: Token = toks.get(q);
                                if tst.kind == T_STAR {
                                    q = q + 1;
                                    arity = arity + 1;
                                } else {
                                    return (0 - 1, q);
                                }
                            } else {
                                kscan = false;
                            }
                        }
                        if arity == 0 {
                            return (0 - 1, q);
                        } else {
                        }
                        if arity > P_MAX_KIND_ARITY {
                            return (0 - 1, q);
                        } else {
                        }
                        kindcode = 1 + arity;
                        let tpl: Token = toks.get(q);
                        if tpl.kind == T_PLUS {
                            q = q + 1;
                            let mut bnd2: bool = true;
                            while bnd2 {
                                let tb2: Token = toks.get(q);
                                if tb2.kind == T_IDENT {
                                    let b2: str = src.substr(tb2.start, tb2.end);
                                    let j2: str = text.concat(";");
                                    text = j2.concat(b2);
                                    q = q + 1;
                                    let tp3: Token = toks.get(q);
                                    if tp3.kind == T_PLUS {
                                        q = q + 1;
                                    } else {
                                        bnd2 = false;
                                    }
                                } else {
                                    return (0 - 1, q);
                                }
                            }
                        } else {
                        }
                    } else {
                        let mut bounding: bool = true;
                        while bounding {
                            let tb: Token = toks.get(q);
                            if tb.kind == T_IDENT {
                                let b: str = src.substr(tb.start, tb.end);
                                let j: str = text.concat(";");
                                text = j.concat(b);
                                q = q + 1;
                                let tp2: Token = toks.get(q);
                                if tp2.kind == T_PLUS {
                                    q = q + 1;
                                } else {
                                    bounding = false;
                                }
                            } else {
                                return (0 - 1, q);
                            }
                        }
                    }
                } else {
                }
                let tlen: i64 = text.len();
                let tpid: i64 = nodes.allocate(PNode { kind: P_K_TYPE_PARAM, start: nt.start, end: nt.end, value: tlen, flags: kindcode, child_start: 0, child_count: 0, text: text });
                let qq: i64 = tplist.push(tpid);
                p = q;
                let tcm: Token = toks.get(p);
                if tcm.kind == T_COMMA {
                    p = p + 1;
                } else {
                    scanning = false;
                }
            }
        }
    }
    let tg: Token = toks.get(p);
    if tg.kind == T_GT {
        return (1, p + 1);
    } else {
    }
    return (0 - 1, p);
}

// Optional `! { Eff, Eff }` effect row → (suffix, ok, new_pos). The suffix is
// `;!` for an EMPTY row and `;!;Eff1;Eff2` otherwise (the `!` marker keeps
// no-row and empty-row distinct — the oracle's None vs Some([])). ok < 0 on a
// malformed row; not-at-`!` returns ("", 0, pos).
fn parser_effect_suffix(src: str, toks: Vec<Token>, pos: i64) -> (str, i64, i64) ! { Alloc } {
    let t0: Token = toks.get(pos);
    if t0.kind == T_BANG {
    } else {
        return ("", 0, pos);
    }
    let tb: Token = toks.get(pos + 1);
    if tb.kind == T_LBRACE {
    } else {
        return ("", 0 - 1, pos + 1);
    }
    let mut suffix: str = ";!";
    let mut p: i64 = pos + 2;
    let mut scanning: bool = true;
    while scanning {
        let t: Token = toks.get(p);
        if t.kind == T_RBRACE {
            scanning = false;
        } else {
            if t.kind == T_EOF {
                scanning = false;
            } else {
                if t.kind == T_IDENT {
                    let e: str = src.substr(t.start, t.end);
                    let j: str = suffix.concat(";");
                    suffix = j.concat(e);
                    p = p + 1;
                    let tc: Token = toks.get(p);
                    if tc.kind == T_COMMA {
                        p = p + 1;
                    } else {
                        scanning = false;
                    }
                } else {
                    return ("", 0 - 1, p);
                }
            }
        }
    }
    let tr: Token = toks.get(p);
    if tr.kind == T_RBRACE {
        return (suffix, 1, p + 1);
    } else {
    }
    return ("", 0 - 1, p);
}

// Is the token at `pos` the contextual `where` keyword? (`where` lexes as a
// plain IDENT — keyword only by position, the oracle's V8.)
fn parser_at_where(src: str, toks: Vec<Token>, pos: i64) -> bool {
    let t: Token = toks.get(pos);
    if t.kind == T_IDENT {
        let w: str = src.substr(t.start, t.end);
        if w.bytes_eq("where") {
            return true;
        } else {
        }
    } else {
    }
    return false;
}

// One refinement clause at `pos` (the LHS — an IDENT field name, or `@` for a
// return-refinement): LHS RELOP [-]INT. K_REFINEMENT text = the LHS name (or
// `@`); flags = op-code + literal*8 (op: <=1 <2 >=3 >4 ==5 !=6 — the oracle's
// RefinementOp order); span = lhs.start..literal.end. Field/length-of RHS
// forms are a later slice (the clause parser bails on a non-literal RHS).
fn parser_ref_clause(src: str, toks: Vec<Token>, pos: i64, wstart: i64, nodes: Arena<PNode> @Mut) -> (i64, i64) ! { Alloc } {
    let t: Token = toks.get(pos);
    let mut lhs: str = "";
    if t.kind == T_IDENT {
        lhs = src.substr(t.start, t.end);
    } else {
        if t.kind == T_AT {
            lhs = "@";
        } else {
            return parser_bail(toks, pos, nodes);
        }
    }
    let to: Token = toks.get(pos + 1);
    let mut op: i64 = 0;
    if to.kind == T_LTEQ {
        op = 1;
    } else {
    }
    if to.kind == T_LT {
        op = 2;
    } else {
    }
    if to.kind == T_GTEQ {
        op = 3;
    } else {
    }
    if to.kind == T_GT {
        op = 4;
    } else {
    }
    if to.kind == T_EQEQ {
        op = 5;
    } else {
    }
    if to.kind == T_BANGEQ {
        op = 6;
    } else {
    }
    if op == 0 {
        return parser_bail(toks, pos + 1, nodes);
    } else {
    }
    let mut p: i64 = pos + 2;
    let mut neg: i64 = 1;
    let tv: Token = toks.get(p);
    let mut vt: Token = tv;
    if tv.kind == T_MINUS {
        neg = 0 - 1;
        p = p + 1;
        let tv2: Token = toks.get(p);
        vt = tv2;
    } else {
    }
    if vt.kind == T_INT {
        let lit: i64 = vt.value * neg;
        let llen: i64 = lhs.len();
        let id: i64 = nodes.allocate(PNode { kind: P_K_REFINEMENT, start: wstart, end: vt.end, value: llen, flags: op + lit * 8, child_start: 0, child_count: 0, text: lhs });
        return (id, p + 1);
    } else {
    }
    return parser_bail(toks, p, nodes);
}

// fn := 'pub'? 'fn' IDENT type-params? params ('->' type)? effect-row? block
// (ret-taint + where clauses are later slices). Span = (pub|fn).start ..
// body.end; flags bit0 = pub; text = name + the effect suffix; children =
// [type-param…, param…, return-type?, body] — the canonical FN child order.
fn parser_fn(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let t0: Token = toks.get(pos);
    let start: i64 = t0.start;
    let mut flags: i64 = 0;
    let mut p: i64 = pos;
    if t0.kind == T_KW_PUB {
        flags = 1;
        p = p + 1;
    } else {
    }
    let tf: Token = toks.get(p);
    if tf.kind == T_KW_FN {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let tn: Token = toks.get(p);
    if tn.kind == T_IDENT {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let mut local: Vec<i64> = Vec::new();
    let (tpok, ptp) = parser_type_params(src, toks, p, nodes, local);
    if tpok < 0 {
        return parser_bail(toks, ptp, nodes);
    } else {
    }
    p = ptp;
    let (pend, pp) = parser_params(src, toks, p, nodes, kids, local);
    if pend < 0 {
        return parser_bail(toks, pp, nodes);
    } else {
    }
    p = pp;
    // optional param-refinement `where param RELOP lit` (between `)` and
    // `->`). HELD and pushed after the return type — the canonical child
    // order is [tp…, param…, ret?, param-ref?, ret-ref?, body]. A
    // region-outlives `where region(a): region(b)` is a later slice.
    let mut prefid: i64 = 0 - 1;
    if parser_at_where(src, toks, p) {
        let tw: Token = toks.get(p + 1);
        if tw.kind == T_KW_REGION {
            return parser_bail(toks, p + 1, nodes);
        } else {
        }
        let twp: Token = toks.get(p);
        let (rid0, pr0) = parser_ref_clause(src, toks, p + 1, twp.start, nodes);
        prefid = rid0;
        p = pr0;
    } else {
    }
    let ta: Token = toks.get(p);
    if ta.kind == T_ARROW {
        let (tid, p2) = parser_type(src, toks, p + 1, 0, nodes, kids);
        let q1: i64 = local.push(tid);
        p = p2;
    } else {
    }
    // optional return-taint `@Internal` etc. — flags bits 1-3 (bit0 is pub).
    let (rtaint, prt) = parser_taint(src, toks, p);
    if rtaint < 0 {
        return parser_bail(toks, p, nodes);
    } else {
    }
    p = prt;
    // optional return-refinement `where @ RELOP lit` (after the return type).
    let mut rrefid: i64 = 0 - 1;
    if parser_at_where(src, toks, p) {
        let twr: Token = toks.get(p);
        let (rid1, pr1) = parser_ref_clause(src, toks, p + 1, twr.start, nodes);
        rrefid = rid1;
        p = pr1;
    } else {
    }
    if prefid >= 0 {
        let qpr: i64 = local.push(prefid);
    } else {
    }
    if rrefid >= 0 {
        let qrr: i64 = local.push(rrefid);
    } else {
    }
    let (esuffix, eok, pe) = parser_effect_suffix(src, toks, p);
    if eok < 0 {
        return parser_bail(toks, pe, nodes);
    } else {
    }
    p = pe;
    let (bid, p3) = parser_block(src, toks, p, nodes, kids);
    let q2: i64 = local.push(bid);
    let bn: PNode = nodes.get(bid);
    let basename: str = src.substr(tn.start, tn.end);
    let name: str = basename.concat(esuffix);
    let nlen: i64 = name.len();
    let cstart: i64 = parser_kids_commit(kids, local);
    let id: i64 = nodes.allocate(PNode { kind: P_K_FN, start: start, end: bn.end, value: nlen, flags: flags + rtaint * 2, child_start: cstart, child_count: local.len(), text: name });
    return (id, p3);
}

// use := 'pub'? 'use' path ';' — text = the `::`-joined path; flags = pub;
// span = (pub|use)..semi. A leaf.
fn parser_use(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut) -> (i64, i64) ! { Alloc } {
    let t0: Token = toks.get(pos);
    let start: i64 = t0.start;
    let mut flags: i64 = 0;
    let mut p: i64 = pos;
    if t0.kind == T_KW_PUB {
        flags = 1;
        p = p + 1;
    } else {
    }
    let tu: Token = toks.get(p);
    if tu.kind == T_KW_USE {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let tn: Token = toks.get(p);
    if tn.kind == T_IDENT {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let mut full: str = src.substr(tn.start, tn.end);
    let mut scanning: bool = true;
    while scanning {
        let tj: Token = toks.get(p);
        if tj.kind == T_COLONCOLON {
            let ts: Token = toks.get(p + 1);
            if ts.kind == T_IDENT {
                let seg: str = src.substr(ts.start, ts.end);
                let j: str = full.concat("::");
                full = j.concat(seg);
                p = p + 2;
            } else {
                scanning = false;
            }
        } else {
            scanning = false;
        }
    }
    let ts2: Token = toks.get(p);
    if ts2.kind == T_SEMI {
        let flen: i64 = full.len();
        let id: i64 = nodes.allocate(PNode { kind: P_K_USE, start: start, end: ts2.end, value: flen, flags: flags, child_start: 0, child_count: 0, text: full });
        return (id, p + 1);
    } else {
    }
    return parser_bail(toks, p, nodes);
}

// const := 'pub'? 'const' IDENT ':' type '=' literal ';' — the value is a
// bare literal TOKEN (no unary minus — the oracle's parse_literal). text =
// `name;<rendering>` (int via itoa / true / false / the decoded str bytes);
// flags = pub + lit-type*2 (0 int, 1 bool, 2 str); child = [type]; span =
// (pub|const)..semi.
fn parser_const(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let t0: Token = toks.get(pos);
    let start: i64 = t0.start;
    let mut flags: i64 = 0;
    let mut p: i64 = pos;
    if t0.kind == T_KW_PUB {
        flags = 1;
        p = p + 1;
    } else {
    }
    let tc: Token = toks.get(p);
    if tc.kind == T_KW_CONST {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let tn: Token = toks.get(p);
    if tn.kind == T_IDENT {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let tco: Token = toks.get(p);
    if tco.kind == T_COLON {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let (tyid, p2) = parser_type(src, toks, p, 1, nodes, kids);
    p = p2;
    let te: Token = toks.get(p);
    if te.kind == T_EQ {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let tv: Token = toks.get(p);
    let name: str = src.substr(tn.start, tn.end);
    let mut text: str = "";
    let mut littype: i64 = 0 - 1;
    if tv.kind == T_INT {
        let r: str = tv.value.itoa();
        let j: str = name.concat(";");
        text = j.concat(r);
        littype = 0;
    } else {
    }
    if tv.kind == T_BOOL {
        let mut b: str = "false";
        if tv.value == 1 {
            b = "true";
        } else {
        }
        let j2: str = name.concat(";");
        text = j2.concat(b);
        littype = 1;
    } else {
    }
    if tv.kind == T_STR {
        let j3: str = name.concat(";");
        text = j3.concat(tv.text);
        littype = 2;
    } else {
    }
    if littype < 0 {
        return parser_bail(toks, p, nodes);
    } else {
    }
    p = p + 1;
    let ts: Token = toks.get(p);
    if ts.kind == T_SEMI {
        let tlen: i64 = text.len();
        let mut local: Vec<i64> = Vec::new();
        let q: i64 = local.push(tyid);
        let cstart: i64 = parser_kids_commit(kids, local);
        let id: i64 = nodes.allocate(PNode { kind: P_K_CONST, start: start, end: ts.end, value: tlen, flags: flags + littype * 2, child_start: cstart, child_count: 1, text: text });
        return (id, p + 1);
    } else {
    }
    return parser_bail(toks, p, nodes);
}

// record := 'pub'? 'record' IDENT type-params? '{' (field (','|';')?)* '}' —
// field := IDENT ':' type → K_FIELD (text = name; span = name..type).
// Refinement `where` clauses are a later slice. flags = pub; children =
// [type-param…, field…]; span = (pub|record)..'}'.
fn parser_record(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let t0: Token = toks.get(pos);
    let start: i64 = t0.start;
    let mut flags: i64 = 0;
    let mut p: i64 = pos;
    if t0.kind == T_KW_PUB {
        flags = 1;
        p = p + 1;
    } else {
    }
    let tr: Token = toks.get(p);
    if tr.kind == T_KW_RECORD {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let tn: Token = toks.get(p);
    if tn.kind == T_IDENT {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let mut local: Vec<i64> = Vec::new();
    let (tpok, ptp) = parser_type_params(src, toks, p, nodes, local);
    if tpok < 0 {
        return parser_bail(toks, ptp, nodes);
    } else {
    }
    p = ptp;
    let tb: Token = toks.get(p);
    if tb.kind == T_LBRACE {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let mut scanning: bool = true;
    while scanning {
        let t: Token = toks.get(p);
        if t.kind == T_RBRACE {
            scanning = false;
        } else {
            if t.kind == T_EOF {
                scanning = false;
            } else {
                if t.kind == T_IDENT {
                } else {
                    return parser_bail(toks, p, nodes);
                }
                let tc2: Token = toks.get(p + 1);
                if tc2.kind == T_COLON {
                } else {
                    return parser_bail(toks, p + 1, nodes);
                }
                let (tyid, p2) = parser_type(src, toks, p + 2, 1, nodes, kids);
                let tynode: PNode = nodes.get(tyid);
                let fname: str = src.substr(t.start, t.end);
                let flen: i64 = fname.len();
                let mut localf: Vec<i64> = Vec::new();
                let qf: i64 = localf.push(tyid);
                let cstartf: i64 = parser_kids_commit(kids, localf);
                let fid: i64 = nodes.allocate(PNode { kind: P_K_FIELD, start: t.start, end: tynode.end, value: flen, flags: 0, child_start: cstartf, child_count: 1, text: fname });
                let qq: i64 = local.push(fid);
                p = p2;
                let tsep: Token = toks.get(p);
                let mut issep: bool = false;
                if tsep.kind == T_COMMA {
                    issep = true;
                } else {
                }
                if tsep.kind == T_SEMI {
                    issep = true;
                } else {
                }
                if issep {
                    p = p + 1;
                } else {
                    if tsep.kind == T_RBRACE {
                    } else {
                        return parser_bail(toks, p, nodes);
                    }
                }
            }
        }
    }
    let tcl: Token = toks.get(p);
    if tcl.kind == T_RBRACE {
        let mut pn: i64 = p + 1;
        // optional `where field RELOP lit` AFTER the close — the clause is a
        // child but sits OUTSIDE the record's span (the oracle's span closes
        // at `}` before the where parses — the ET-P6 exemption).
        if parser_at_where(src, toks, pn) {
            let tws: Token = toks.get(pn);
            let (wid, pw) = parser_ref_clause(src, toks, pn + 1, tws.start, nodes);
            let qw: i64 = local.push(wid);
            pn = pw;
        } else {
        }
        let name: str = src.substr(tn.start, tn.end);
        let nlen: i64 = name.len();
        let cstart: i64 = parser_kids_commit(kids, local);
        let id: i64 = nodes.allocate(PNode { kind: P_K_RECORD_DEF, start: start, end: tcl.end, value: nlen, flags: flags, child_start: cstart, child_count: local.len(), text: name });
        return (id, pn);
    } else {
    }
    return parser_bail(toks, p, nodes);
}

// enum := 'pub'? 'enum' IDENT type-params? '{' (variant ','?)* '}' — variant
// := IDENT ('(' ([IDENT ':'] type),* ')')? → K_ENUM_VARIANT (text = name;
// span = name..the previous token); each payload field → K_ENUM_FIELD (text =
// the name or EMPTY for positional; span = field-start..type). Variant
// refinements are a later slice. flags = pub; children = [type-param…,
// variant…]; span = (pub|enum)..'}'.
fn parser_enum(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let t0: Token = toks.get(pos);
    let start: i64 = t0.start;
    let mut flags: i64 = 0;
    let mut p: i64 = pos;
    if t0.kind == T_KW_PUB {
        flags = 1;
        p = p + 1;
    } else {
    }
    let te: Token = toks.get(p);
    if te.kind == T_KW_ENUM {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let tn: Token = toks.get(p);
    if tn.kind == T_IDENT {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let mut local: Vec<i64> = Vec::new();
    let (tpok, ptp) = parser_type_params(src, toks, p, nodes, local);
    if tpok < 0 {
        return parser_bail(toks, ptp, nodes);
    } else {
    }
    p = ptp;
    let tb: Token = toks.get(p);
    if tb.kind == T_LBRACE {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let mut scanning: bool = true;
    while scanning {
        let t: Token = toks.get(p);
        if t.kind == T_RBRACE {
            scanning = false;
        } else {
            if t.kind == T_EOF {
                scanning = false;
            } else {
                if t.kind == T_IDENT {
                } else {
                    return parser_bail(toks, p, nodes);
                }
                let vstart: i64 = t.start;
                let mut vend: i64 = t.end;
                let mut q: i64 = p + 1;
                let mut localv: Vec<i64> = Vec::new();
                let tl: Token = toks.get(q);
                if tl.kind == T_LPAREN {
                    q = q + 1;
                    let mut fielding: bool = true;
                    while fielding {
                        let tf: Token = toks.get(q);
                        if tf.kind == T_RPAREN {
                            fielding = false;
                        } else {
                            if tf.kind == T_EOF {
                                fielding = false;
                            } else {
                                let fstart: i64 = tf.start;
                                let mut fname: str = "";
                                let mut q2: i64 = q;
                                if tf.kind == T_IDENT {
                                    let tcn: Token = toks.get(q + 1);
                                    if tcn.kind == T_COLON {
                                        fname = src.substr(tf.start, tf.end);
                                        q2 = q + 2;
                                    } else {
                                    }
                                } else {
                                }
                                let (tyid, q3) = parser_type(src, toks, q2, 1, nodes, kids);
                                let tynode: PNode = nodes.get(tyid);
                                let fnlen: i64 = fname.len();
                                let mut localef: Vec<i64> = Vec::new();
                                let qef: i64 = localef.push(tyid);
                                let cstartef: i64 = parser_kids_commit(kids, localef);
                                let efid: i64 = nodes.allocate(PNode { kind: P_K_ENUM_FIELD, start: fstart, end: tynode.end, value: fnlen, flags: 0, child_start: cstartef, child_count: 1, text: fname });
                                let qv: i64 = localv.push(efid);
                                q = q3;
                                let tcm2: Token = toks.get(q);
                                if tcm2.kind == T_COMMA {
                                    q = q + 1;
                                } else {
                                    fielding = false;
                                }
                            }
                        }
                    }
                    let trp: Token = toks.get(q);
                    if trp.kind == T_RPAREN {
                        vend = trp.end;
                        q = q + 1;
                    } else {
                        return parser_bail(toks, q, nodes);
                    }
                } else {
                }
                // optional variant `where field RELOP lit` — a child, and the
                // variant's span EXTENDS over it (the oracle's variant_end is
                // the previous token AFTER the refinements parse).
                if parser_at_where(src, toks, q) {
                    let twv: Token = toks.get(q);
                    let (wvid, qw2) = parser_ref_clause(src, toks, q + 1, twv.start, nodes);
                    let qv2: i64 = localv.push(wvid);
                    let wnode: PNode = nodes.get(wvid);
                    vend = wnode.end;
                    q = qw2;
                } else {
                }
                let vname: str = src.substr(t.start, t.end);
                let vlen: i64 = vname.len();
                let cstartv: i64 = parser_kids_commit(kids, localv);
                let vid: i64 = nodes.allocate(PNode { kind: P_K_ENUM_VARIANT, start: vstart, end: vend, value: vlen, flags: 0, child_start: cstartv, child_count: localv.len(), text: vname });
                let ql: i64 = local.push(vid);
                p = q;
                let tcm3: Token = toks.get(p);
                if tcm3.kind == T_COMMA {
                    p = p + 1;
                } else {
                    scanning = false;
                }
            }
        }
    }
    let tcl: Token = toks.get(p);
    if tcl.kind == T_RBRACE {
        let name: str = src.substr(tn.start, tn.end);
        let nlen: i64 = name.len();
        let cstart: i64 = parser_kids_commit(kids, local);
        let id: i64 = nodes.allocate(PNode { kind: P_K_ENUM_DEF, start: start, end: tcl.end, value: nlen, flags: flags, child_start: cstart, child_count: local.len(), text: name });
        return (id, p + 1);
    } else {
    }
    return parser_bail(toks, p, nodes);
}

// impl := 'pub'? 'impl' IDENT ('for' IDENT)? type-params? '{' method* '}' —
// text = `trait;type` (the trait EMPTY for an inherent impl). Methods parse
// via parser_fn; a method's visibility is ALWAYS Public (the oracle defaults
// impl methods to Public whether or not `pub` is written) and its span starts
// at `fn` even when `pub` is present (the oracle consumes the `pub` BEFORE
// calling parse_fn with no vis-span) — both quirks replicated by consuming
// the `pub` here and PATCHING the method's flags to 1. children =
// [type-param…, method…]; span = (pub|impl)..'}'.
fn parser_impl(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let t0: Token = toks.get(pos);
    let start: i64 = t0.start;
    let mut p: i64 = pos;
    if t0.kind == T_KW_PUB {
        p = p + 1;
    } else {
    }
    let ti: Token = toks.get(p);
    if ti.kind == T_KW_IMPL {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let tn: Token = toks.get(p);
    if tn.kind == T_IDENT {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let firstname: str = src.substr(tn.start, tn.end);
    let mut traitname: str = "";
    let mut typename: str = firstname;
    let tf: Token = toks.get(p);
    if tf.kind == T_KW_FOR {
        let tt: Token = toks.get(p + 1);
        if tt.kind == T_IDENT {
            traitname = firstname;
            typename = src.substr(tt.start, tt.end);
            p = p + 2;
        } else {
            return parser_bail(toks, p + 1, nodes);
        }
    } else {
    }
    let mut local: Vec<i64> = Vec::new();
    let (tpok, ptp) = parser_type_params(src, toks, p, nodes, local);
    if tpok < 0 {
        return parser_bail(toks, ptp, nodes);
    } else {
    }
    p = ptp;
    let tb: Token = toks.get(p);
    if tb.kind == T_LBRACE {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let mut scanning: bool = true;
    while scanning {
        let t: Token = toks.get(p);
        if t.kind == T_RBRACE {
            scanning = false;
        } else {
            if t.kind == T_EOF {
                scanning = false;
            } else {
                let mut q: i64 = p;
                let tp2: Token = toks.get(q);
                if tp2.kind == T_KW_PUB {
                    q = q + 1;
                } else {
                }
                let (mid, q2) = parser_fn(src, toks, q, nodes, kids);
                let mnode: PNode = nodes.get(mid);
                if mnode.kind == P_K_FN {
                    if mnode.flags == 0 {
                        let patched: i64 = nodes.set(mid, PNode { kind: mnode.kind, start: mnode.start, end: mnode.end, value: mnode.value, flags: 1, child_start: mnode.child_start, child_count: mnode.child_count, text: mnode.text });
                    } else {
                    }
                } else {
                }
                let ql: i64 = local.push(mid);
                if q2 == q {
                    scanning = false;
                } else {
                }
                p = q2;
            }
        }
    }
    let tcl: Token = toks.get(p);
    if tcl.kind == T_RBRACE {
        let j: str = traitname.concat(";");
        let text: str = j.concat(typename);
        let tlen: i64 = text.len();
        let cstart: i64 = parser_kids_commit(kids, local);
        let id: i64 = nodes.allocate(PNode { kind: P_K_IMPL, start: start, end: tcl.end, value: tlen, flags: 0, child_start: cstart, child_count: local.len(), text: text });
        return (id, p + 1);
    } else {
    }
    return parser_bail(toks, p, nodes);
}

// trait := 'pub'? 'trait' IDENT '{' ('pub'? 'fn' IDENT params ('->' type)?
// ';')* '}' — signature-only methods → K_TRAIT_SIG (text = name; children
// [param…, return-type?]; span = fn..semi; a body-level `pub` is accepted and
// ignored). flags = pub; children = the sigs; span = (pub|trait)..'}'.
fn parser_trait(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let t0: Token = toks.get(pos);
    let start: i64 = t0.start;
    let mut flags: i64 = 0;
    let mut p: i64 = pos;
    if t0.kind == T_KW_PUB {
        flags = 1;
        p = p + 1;
    } else {
    }
    let tt: Token = toks.get(p);
    if tt.kind == T_KW_TRAIT {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let tn: Token = toks.get(p);
    if tn.kind == T_IDENT {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let tb: Token = toks.get(p);
    if tb.kind == T_LBRACE {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let mut local: Vec<i64> = Vec::new();
    let mut scanning: bool = true;
    while scanning {
        let t: Token = toks.get(p);
        if t.kind == T_RBRACE {
            scanning = false;
        } else {
            if t.kind == T_EOF {
                scanning = false;
            } else {
                if t.kind == T_KW_PUB {
                    p = p + 1;
                } else {
                }
                let tfk: Token = toks.get(p);
                if tfk.kind == T_KW_FN {
                } else {
                    return parser_bail(toks, p, nodes);
                }
                let sstart: i64 = tfk.start;
                let tsn: Token = toks.get(p + 1);
                if tsn.kind == T_IDENT {
                } else {
                    return parser_bail(toks, p + 1, nodes);
                }
                let mut locals: Vec<i64> = Vec::new();
                let (pend2, pp2) = parser_params(src, toks, p + 2, nodes, kids, locals);
                if pend2 < 0 {
                    return parser_bail(toks, pp2, nodes);
                } else {
                }
                let mut q: i64 = pp2;
                let ta2: Token = toks.get(q);
                if ta2.kind == T_ARROW {
                    let (tid2, q2) = parser_type(src, toks, q + 1, 1, nodes, kids);
                    let qs: i64 = locals.push(tid2);
                    q = q2;
                } else {
                }
                let tse: Token = toks.get(q);
                if tse.kind == T_SEMI {
                } else {
                    return parser_bail(toks, q, nodes);
                }
                let sname: str = src.substr(tsn.start, tsn.end);
                let slen: i64 = sname.len();
                let cstarts: i64 = parser_kids_commit(kids, locals);
                let sid: i64 = nodes.allocate(PNode { kind: P_K_TRAIT_SIG, start: sstart, end: tse.end, value: slen, flags: 0, child_start: cstarts, child_count: locals.len(), text: sname });
                let ql: i64 = local.push(sid);
                p = q + 1;
            }
        }
    }
    let tcl: Token = toks.get(p);
    if tcl.kind == T_RBRACE {
        let name: str = src.substr(tn.start, tn.end);
        let nlen: i64 = name.len();
        let cstart: i64 = parser_kids_commit(kids, local);
        let id: i64 = nodes.allocate(PNode { kind: P_K_TRAIT, start: start, end: tcl.end, value: nlen, flags: flags, child_start: cstart, child_count: local.len(), text: name });
        return (id, p + 1);
    } else {
    }
    return parser_bail(toks, p, nodes);
}

// extern := 'extern' STR 'fn' IDENT params ('->' type)? effect-row? ';' —
// text = `abi;name(;eff)*` (the extern row is a PLAIN list — no-row and an
// empty row are both the bare `abi;name`); children = [param…, return-type?];
// span = extern..semi. (A preceding `pub` is consumed by parser_item and
// DROPPED — the oracle's ExternFnDecl has no visibility and its span starts
// at `extern`.)
fn parser_extern(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let t0: Token = toks.get(pos);
    if t0.kind == T_KW_EXTERN {
    } else {
        return parser_bail(toks, pos, nodes);
    }
    let ta: Token = toks.get(pos + 1);
    if ta.kind == T_STR {
    } else {
        return parser_bail(toks, pos + 1, nodes);
    }
    let tf: Token = toks.get(pos + 2);
    if tf.kind == T_KW_FN {
    } else {
        return parser_bail(toks, pos + 2, nodes);
    }
    let tn: Token = toks.get(pos + 3);
    if tn.kind == T_IDENT {
    } else {
        return parser_bail(toks, pos + 3, nodes);
    }
    let mut local: Vec<i64> = Vec::new();
    let (pend, pp) = parser_params(src, toks, pos + 4, nodes, kids, local);
    if pend < 0 {
        return parser_bail(toks, pp, nodes);
    } else {
    }
    let mut p: i64 = pp;
    let tar: Token = toks.get(p);
    if tar.kind == T_ARROW {
        let (tid, p2) = parser_type(src, toks, p + 1, 0, nodes, kids);
        let q1: i64 = local.push(tid);
        p = p2;
    } else {
    }
    // optional return-taint `@Internal` etc. — the extern's flags (no pub bit).
    let (rtaint, prt) = parser_taint(src, toks, p);
    if rtaint < 0 {
        return parser_bail(toks, p, nodes);
    } else {
    }
    p = prt;
    let (esuffix, eok, pe) = parser_effect_suffix(src, toks, p);
    if eok < 0 {
        return parser_bail(toks, pe, nodes);
    } else {
    }
    p = pe;
    let ts: Token = toks.get(p);
    if ts.kind == T_SEMI {
        let name: str = src.substr(tn.start, tn.end);
        let j1: str = ta.text.concat(";");
        let base: str = j1.concat(name);
        // strip the `;!` marker — the extern row is a plain Vec (no-row and
        // an empty row are identical), so only the effect names append.
        let mut text: str = base;
        if eok == 1 {
            let names: str = esuffix.substr(2, esuffix.len());
            text = base.concat(names);
        } else {
        }
        let tlen: i64 = text.len();
        let cstart: i64 = parser_kids_commit(kids, local);
        let id: i64 = nodes.allocate(PNode { kind: P_K_EXTERN_FN, start: t0.start, end: ts.end, value: tlen, flags: rtaint, child_start: cstart, child_count: local.len(), text: text });
        return (id, p + 1);
    } else {
    }
    return parser_bail(toks, p, nodes);
}

// effect := 'effect' IDENT (';' | '{' '}') — a marker declaration. THE SPAN
// QUIRK: it ends at the NAME, not the terminator (the oracle's
// `start.join(end_span)` where end_span is the ident's). text = the name.
fn parser_effect_decl(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut) -> (i64, i64) ! { Alloc } {
    let t0: Token = toks.get(pos);
    if t0.kind == T_KW_EFFECT {
    } else {
        return parser_bail(toks, pos, nodes);
    }
    let tn: Token = toks.get(pos + 1);
    if tn.kind == T_IDENT {
    } else {
        return parser_bail(toks, pos + 1, nodes);
    }
    // Effect Handlers (EH0b): `effect Name { fn op(params) -> Ty; .. }`. The
    // operation NAMES ride the text joined `;` (like StateDef's markers); a bare
    // `effect Name;` has no suffix, so existing fixtures are unchanged. The span
    // still ends at the NAME (the operations do not extend it — the span quirk).
    let name: str = src.substr(tn.start, tn.end);
    let mut text: str = name;
    let mut p: i64 = pos + 2;
    let tt: Token = toks.get(p);
    if tt.kind == T_SEMI {
        p = p + 1;
    } else {
        if tt.kind == T_LBRACE {
            p = p + 1;
            let mut scanop: bool = true;
            while scanop {
                let to: Token = toks.get(p);
                if to.kind == T_RBRACE {
                    p = p + 1;
                    scanop = false;
                } else {
                    if to.kind == T_EOF {
                        return parser_bail(toks, p, nodes);
                    } else {
                    }
                    if to.kind == T_KW_FN {
                        let topn: Token = toks.get(p + 1);
                        if topn.kind == T_IDENT {
                        } else {
                            return parser_bail(toks, p + 1, nodes);
                        }
                        let opname: str = src.substr(topn.start, topn.end);
                        let j: str = text.concat(";");
                        text = j.concat(opname);
                        // Consume the op signature up to its terminating `;`
                        // (paren depth 0; params/types carry no top-level `;`).
                        let mut q: i64 = p + 2;
                        let mut depth: i64 = 0;
                        let mut scansig: bool = true;
                        while scansig {
                            let tq: Token = toks.get(q);
                            if tq.kind == T_EOF {
                                return parser_bail(toks, q, nodes);
                            } else {
                            }
                            if tq.kind == T_LPAREN {
                                depth = depth + 1;
                            } else {
                            }
                            if tq.kind == T_LBRACKET {
                                depth = depth + 1;
                            } else {
                            }
                            if tq.kind == T_RPAREN {
                                depth = depth - 1;
                            } else {
                            }
                            if tq.kind == T_RBRACKET {
                                depth = depth - 1;
                            } else {
                            }
                            if tq.kind == T_SEMI {
                                if depth == 0 {
                                    scansig = false;
                                } else {
                                }
                            } else {
                            }
                            q = q + 1;
                        }
                        p = q;
                    } else {
                        return parser_bail(toks, p, nodes);
                    }
                }
            }
        } else {
        }
    }
    let tlen: i64 = text.len();
    let id: i64 = nodes.allocate(PNode { kind: P_K_EFFECT_DECL, start: t0.start, end: tn.end, value: tlen, flags: 0, child_start: 0, child_count: 0, text: text });
    return (id, p);
}

// actor := 'pub'? 'entry'? 'actor' IDENT '{' (state-block | init-block |
// handler)* '}'. The three member forms collect into SLOTS and the children
// commit in slot order regardless of source order (the oracle stores them in
// three fields): [state-field…, init?, handler…]. flags = pub + entry*2;
// text = the name; span = (pub|entry|actor)..'}'.
//   state := 'state' '{' fields '}'           → K_FIELD children
//   init  := 'init' params (block | ';')      → K_ACTOR_INIT [param…, body]
//   on    := 'on' IDENT params ('->' type)? (block | ';')
//                                             → K_HANDLER [param…, ret?, body]
// (parse_body's `;` form yields an EMPTY block whose span is the semi.)
fn parser_actor(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let t0: Token = toks.get(pos);
    let start: i64 = t0.start;
    let mut flags: i64 = 0;
    let mut p: i64 = pos;
    if t0.kind == T_KW_PUB {
        flags = 1;
        p = p + 1;
    } else {
    }
    let te: Token = toks.get(p);
    if te.kind == T_KW_ENTRY {
        flags = flags + 2;
        p = p + 1;
    } else {
    }
    let tac: Token = toks.get(p);
    if tac.kind == T_KW_ACTOR {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let tn: Token = toks.get(p);
    if tn.kind == T_IDENT {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let tb: Token = toks.get(p);
    if tb.kind == T_LBRACE {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let mut fieldsl: Vec<i64> = Vec::new();
    let mut initl: Vec<i64> = Vec::new();
    let mut handlersl: Vec<i64> = Vec::new();
    let mut scanning: bool = true;
    while scanning {
        let t: Token = toks.get(p);
        if t.kind == T_RBRACE {
            scanning = false;
        } else {
            if t.kind == T_EOF {
                scanning = false;
            } else {
                if t.kind == T_KW_STATE {
                    let tsb: Token = toks.get(p + 1);
                    if tsb.kind == T_LBRACE {
                    } else {
                        return parser_bail(toks, p + 1, nodes);
                    }
                    let mut q: i64 = p + 2;
                    let mut fielding: bool = true;
                    while fielding {
                        // MUTABLE-STATE S1: skip an optional leading `mut` on a
                        // state field (the oracle parses it into Field.mutability;
                        // the shadow consumes it so a `mut` state field parses to the
                        // same P_K_FIELD shape, an inert marker with no P-node bit).
                        let tmut: Token = toks.get(q);
                        if tmut.kind == T_KW_MUT {
                            q = q + 1;
                        } else {
                        }
                        let tf: Token = toks.get(q);
                        if tf.kind == T_RBRACE {
                            fielding = false;
                        } else {
                            if tf.kind == T_EOF {
                                fielding = false;
                            } else {
                                if tf.kind == T_IDENT {
                                } else {
                                    return parser_bail(toks, q, nodes);
                                }
                                let tfc: Token = toks.get(q + 1);
                                if tfc.kind == T_COLON {
                                } else {
                                    return parser_bail(toks, q + 1, nodes);
                                }
                                let (tyid, q2) = parser_type(src, toks, q + 2, 1, nodes, kids);
                                let tynode: PNode = nodes.get(tyid);
                                let fname: str = src.substr(tf.start, tf.end);
                                let flen: i64 = fname.len();
                                let mut localf: Vec<i64> = Vec::new();
                                let qf: i64 = localf.push(tyid);
                                let cstartf: i64 = parser_kids_commit(kids, localf);
                                let fid: i64 = nodes.allocate(PNode { kind: P_K_FIELD, start: tf.start, end: tynode.end, value: flen, flags: 0, child_start: cstartf, child_count: 1, text: fname });
                                let qq: i64 = fieldsl.push(fid);
                                q = q2;
                                let tsep: Token = toks.get(q);
                                let mut issep: bool = false;
                                if tsep.kind == T_COMMA {
                                    issep = true;
                                } else {
                                }
                                if tsep.kind == T_SEMI {
                                    issep = true;
                                } else {
                                }
                                if issep {
                                    q = q + 1;
                                } else {
                                    if tsep.kind == T_RBRACE {
                                    } else {
                                        return parser_bail(toks, q, nodes);
                                    }
                                }
                            }
                        }
                    }
                    let tsc: Token = toks.get(q);
                    if tsc.kind == T_RBRACE {
                        p = q + 1;
                    } else {
                        return parser_bail(toks, q, nodes);
                    }
                } else {
                    if t.kind == T_KW_INIT {
                        let mut locali: Vec<i64> = Vec::new();
                        let (pend2, pp2) = parser_params(src, toks, p + 1, nodes, kids, locali);
                        if pend2 < 0 {
                            return parser_bail(toks, pp2, nodes);
                        } else {
                        }
                        let mut q: i64 = pp2;
                        let tib: Token = toks.get(q);
                        let mut bend: i64 = 0;
                        if tib.kind == T_SEMI {
                            let ebid: i64 = nodes.allocate(PNode { kind: P_K_BLOCK, start: tib.start, end: tib.end, value: 0, flags: 0, child_start: 0, child_count: 0, text: "" });
                            let qb: i64 = locali.push(ebid);
                            bend = tib.end;
                            q = q + 1;
                        } else {
                            let (bid, q2) = parser_block(src, toks, q, nodes, kids);
                            let qb2: i64 = locali.push(bid);
                            let bnode: PNode = nodes.get(bid);
                            bend = bnode.end;
                            q = q2;
                        }
                        let cstarti: i64 = parser_kids_commit(kids, locali);
                        let iid: i64 = nodes.allocate(PNode { kind: P_K_ACTOR_INIT, start: t.start, end: bend, value: 0, flags: 0, child_start: cstarti, child_count: locali.len(), text: "" });
                        let qi: i64 = initl.push(iid);
                        p = q;
                    } else {
                        if t.kind == T_KW_ON {
                            let thn: Token = toks.get(p + 1);
                            if thn.kind == T_IDENT {
                            } else {
                                return parser_bail(toks, p + 1, nodes);
                            }
                            let mut localh: Vec<i64> = Vec::new();
                            let (pend3, pp3) = parser_params(src, toks, p + 2, nodes, kids, localh);
                            if pend3 < 0 {
                                return parser_bail(toks, pp3, nodes);
                            } else {
                            }
                            let mut q: i64 = pp3;
                            let tha: Token = toks.get(q);
                            if tha.kind == T_ARROW {
                                let (tid2, q2) = parser_type(src, toks, q + 1, 1, nodes, kids);
                                let qh: i64 = localh.push(tid2);
                                q = q2;
                            } else {
                            }
                            let thb: Token = toks.get(q);
                            let mut hend: i64 = 0;
                            if thb.kind == T_SEMI {
                                let ebid2: i64 = nodes.allocate(PNode { kind: P_K_BLOCK, start: thb.start, end: thb.end, value: 0, flags: 0, child_start: 0, child_count: 0, text: "" });
                                let qb3: i64 = localh.push(ebid2);
                                hend = thb.end;
                                q = q + 1;
                            } else {
                                let (bid2, q3) = parser_block(src, toks, q, nodes, kids);
                                let qb4: i64 = localh.push(bid2);
                                let bnode2: PNode = nodes.get(bid2);
                                hend = bnode2.end;
                                q = q3;
                            }
                            let hname: str = src.substr(thn.start, thn.end);
                            let hlen: i64 = hname.len();
                            let cstarth: i64 = parser_kids_commit(kids, localh);
                            let hid: i64 = nodes.allocate(PNode { kind: P_K_HANDLER, start: t.start, end: hend, value: hlen, flags: 0, child_start: cstarth, child_count: localh.len(), text: hname });
                            let qh2: i64 = handlersl.push(hid);
                            p = q;
                        } else {
                            return parser_bail(toks, p, nodes);
                        }
                    }
                }
            }
        }
    }
    let tcl: Token = toks.get(p);
    if tcl.kind == T_RBRACE {
        let mut local: Vec<i64> = Vec::new();
        let mut i: i64 = 0;
        while i < fieldsl.len() {
            let f: i64 = fieldsl.get(i);
            let qf2: i64 = local.push(f);
            i = i + 1;
        }
        let mut j: i64 = 0;
        while j < initl.len() {
            let iv: i64 = initl.get(j);
            let qi2: i64 = local.push(iv);
            j = j + 1;
        }
        let mut k2: i64 = 0;
        while k2 < handlersl.len() {
            let h: i64 = handlersl.get(k2);
            let qh3: i64 = local.push(h);
            k2 = k2 + 1;
        }
        let name: str = src.substr(tn.start, tn.end);
        let nlen: i64 = name.len();
        let cstart: i64 = parser_kids_commit(kids, local);
        let id: i64 = nodes.allocate(PNode { kind: P_K_ACTOR, start: start, end: tcl.end, value: nlen, flags: flags, child_start: cstart, child_count: local.len(), text: name });
        return (id, p + 1);
    } else {
    }
    return parser_bail(toks, p, nodes);
}

// state-def := 'pub'? 'state' IDENT '{' IDENT,* '}'  (typestate, Epic 1, R3).
// text = `name;marker1;marker2;…` (protocol name + its closed marker set,
// joined `;`); value = text.len(); flags = the pub bit; a leaf; span =
// (pub|state)..'}'. Mirrors the oracle's parse_state_def (parser.rs:2158). The
// actor `state { fields }` block is named-less and parsed inside the actor, so
// a TOP-LEVEL `state` is unambiguously a protocol decl (parser.rs:457-464).
fn parser_state_def(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut) -> (i64, i64) ! { Alloc } {
    let t0: Token = toks.get(pos);
    let start: i64 = t0.start;
    let mut flags: i64 = 0;
    let mut p: i64 = pos;
    if t0.kind == T_KW_PUB {
        flags = 1;
        p = p + 1;
    } else {
    }
    let ts: Token = toks.get(p);
    if ts.kind == T_KW_STATE {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let tn: Token = toks.get(p);
    if tn.kind == T_IDENT {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let mut text: str = src.substr(tn.start, tn.end);
    let tlb: Token = toks.get(p);
    if tlb.kind == T_LBRACE {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let mut scanning: bool = true;
    while scanning {
        let tm: Token = toks.get(p);
        if tm.kind == T_RBRACE {
            scanning = false;
        } else {
            if tm.kind == T_EOF {
                scanning = false;
            } else {
                if tm.kind == T_IDENT {
                } else {
                    return parser_bail(toks, p, nodes);
                }
                let mname: str = src.substr(tm.start, tm.end);
                let jm: str = text.concat(";");
                text = jm.concat(mname);
                p = p + 1;
                let tcm: Token = toks.get(p);
                if tcm.kind == T_COMMA {
                    p = p + 1;
                } else {
                    scanning = false;
                }
            }
        }
    }
    let trb: Token = toks.get(p);
    if trb.kind == T_RBRACE {
    } else {
        return parser_bail(toks, p, nodes);
    }
    let tlen: i64 = text.len();
    let idsd: i64 = nodes.allocate(PNode { kind: P_K_STATE_DEF, start: start, end: trb.end, value: tlen, flags: flags, child_start: 0, child_count: 0, text: text });
    return (idsd, p + 1);
}

// cap-type := 'pub'? 'cap' 'type' IDENT ('(' (IDENT ':' i64),+ ')')?
//             (';' | '{' IDENT,* '}')
// text = `name;auth,auth;param,param` (authorities and parameters as
// comma-joined sublists). THE SPAN QUIRK: the semicolon form's span is
// (pub|cap)..semi (the oracle joins start, the NAME, and the semi); the
// braced form ends at '}'.
fn parser_cap_type(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut) -> (i64, i64) ! { Alloc } {
    let t0: Token = toks.get(pos);
    let start: i64 = t0.start;
    let mut flags: i64 = 0;
    let mut p: i64 = pos;
    if t0.kind == T_KW_PUB {
        flags = 1;
        p = p + 1;
    } else {
    }
    let tc: Token = toks.get(p);
    if tc.kind == T_KW_CAP {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let tt: Token = toks.get(p);
    if tt.kind == T_KW_TYPE {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let tn: Token = toks.get(p);
    if tn.kind == T_IDENT {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let mut params: str = "";
    let mut pcount: i64 = 0;
    let tlp: Token = toks.get(p);
    if tlp.kind == T_LPAREN {
        p = p + 1;
        let mut scanningp: bool = true;
        while scanningp {
            let tpn: Token = toks.get(p);
            if tpn.kind == T_RPAREN {
                scanningp = false;
            } else {
                if tpn.kind == T_EOF {
                    scanningp = false;
                } else {
                    if tpn.kind == T_IDENT {
                    } else {
                        return parser_bail(toks, p, nodes);
                    }
                    let tpc: Token = toks.get(p + 1);
                    if tpc.kind == T_COLON {
                    } else {
                        return parser_bail(toks, p + 1, nodes);
                    }
                    let tpt: Token = toks.get(p + 2);
                    if tpt.kind == T_IDENT {
                        let tyname: str = src.substr(tpt.start, tpt.end);
                        if tyname.bytes_eq("i64") {
                        } else {
                            return parser_bail(toks, p + 2, nodes);
                        }
                    } else {
                        return parser_bail(toks, p + 2, nodes);
                    }
                    let pname: str = src.substr(tpn.start, tpn.end);
                    if pcount > 0 {
                        let jp: str = params.concat(",");
                        params = jp.concat(pname);
                    } else {
                        params = pname;
                    }
                    pcount = pcount + 1;
                    p = p + 3;
                    let tcm: Token = toks.get(p);
                    if tcm.kind == T_COMMA {
                        p = p + 1;
                    } else {
                        scanningp = false;
                    }
                }
            }
        }
        let trp: Token = toks.get(p);
        if trp.kind == T_RPAREN {
            p = p + 1;
        } else {
            return parser_bail(toks, p, nodes);
        }
    } else {
    }
    let name: str = src.substr(tn.start, tn.end);
    let ts: Token = toks.get(p);
    if ts.kind == T_SEMI {
        let j1: str = name.concat(";");
        let j2: str = j1.concat(";");
        let text: str = j2.concat(params);
        let tlen: i64 = text.len();
        let id: i64 = nodes.allocate(PNode { kind: P_K_CAP_TYPE, start: start, end: ts.end, value: tlen, flags: flags, child_start: 0, child_count: 0, text: text });
        return (id, p + 1);
    } else {
    }
    let tb: Token = toks.get(p);
    if tb.kind == T_LBRACE {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let mut auths: str = "";
    let mut acount: i64 = 0;
    let mut scanninga: bool = true;
    while scanninga {
        let tan: Token = toks.get(p);
        if tan.kind == T_RBRACE {
            scanninga = false;
        } else {
            if tan.kind == T_EOF {
                scanninga = false;
            } else {
                if tan.kind == T_IDENT {
                    let aname: str = src.substr(tan.start, tan.end);
                    if acount > 0 {
                        let ja: str = auths.concat(",");
                        auths = ja.concat(aname);
                    } else {
                        auths = aname;
                    }
                    acount = acount + 1;
                    p = p + 1;
                    let tcm2: Token = toks.get(p);
                    if tcm2.kind == T_COMMA {
                        p = p + 1;
                    } else {
                        scanninga = false;
                    }
                } else {
                    return parser_bail(toks, p, nodes);
                }
            }
        }
    }
    let tcl2: Token = toks.get(p);
    if tcl2.kind == T_RBRACE {
        let j3: str = name.concat(";");
        let j4: str = j3.concat(auths);
        let j5: str = j4.concat(";");
        let text2: str = j5.concat(params);
        let tlen2: i64 = text2.len();
        let id2: i64 = nodes.allocate(PNode { kind: P_K_CAP_TYPE, start: start, end: tcl2.end, value: tlen2, flags: flags, child_start: 0, child_count: 0, text: text2 });
        return (id2, p + 1);
    } else {
    }
    return parser_bail(toks, p, nodes);
}

// item := use | const | fn | record | enum | extern | effect | impl | trait
//       | actor | cap-type. The optional leading `pub` is handled INSIDE
// each item parser; `pub extern` / `pub effect` drop the pub from the span
// like the oracle (their parsers never see the vis-span).
// alias := 'pub'? 'type' IDENT '=' type ';' — text = the alias name; value = name
// length; flags = pub bit; child = [type] (the shared type grammar); span =
// (pub|type)..semi. A bare `type` (NOT `cap type`, dispatched earlier on T_KW_CAP).
// Mirrors the Rust parse_type_alias + the harness K_TYPE_ALIAS flatten.
fn parser_alias(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let t0: Token = toks.get(pos);
    let start: i64 = t0.start;
    let mut flags: i64 = 0;
    let mut p: i64 = pos;
    if t0.kind == T_KW_PUB {
        flags = 1;
        p = p + 1;
    } else {
    }
    let tt: Token = toks.get(p);
    if tt.kind == T_KW_TYPE {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let tn: Token = toks.get(p);
    if tn.kind == T_IDENT {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let name: str = src.substr(tn.start, tn.end);
    let teq: Token = toks.get(p);
    if teq.kind == T_EQ {
        p = p + 1;
    } else {
        return parser_bail(toks, p, nodes);
    }
    let (tyid, pty) = parser_type(src, toks, p, 1, nodes, kids);
    let tsemi: Token = toks.get(pty);
    if tsemi.kind == T_SEMI {
        let mut localc: Vec<i64> = Vec::new();
        let pc: i64 = localc.push(tyid);
        let cstart: i64 = parser_kids_commit(kids, localc);
        let nlen: i64 = name.len();
        let id: i64 = nodes.allocate(PNode { kind: P_K_TYPE_ALIAS, start: start, end: tsemi.end, value: nlen, flags: flags, child_start: cstart, child_count: 1, text: name });
        return (id, pty + 1);
    } else {
    }
    return parser_bail(toks, pty, nodes);
}

fn parser_item(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let t: Token = toks.get(pos);
    let mut k: i64 = t.kind;
    let mut kpos: i64 = pos;
    if t.kind == T_KW_PUB {
        let t2: Token = toks.get(pos + 1);
        k = t2.kind;
        kpos = pos + 1;
    } else {
    }
    if k == T_KW_USE {
        return parser_use(src, toks, pos, nodes);
    } else {
    }
    if k == T_KW_CONST {
        return parser_const(src, toks, pos, nodes, kids);
    } else {
    }
    if k == T_KW_FN {
        return parser_fn(src, toks, pos, nodes, kids);
    } else {
    }
    if k == T_KW_RECORD {
        return parser_record(src, toks, pos, nodes, kids);
    } else {
    }
    if k == T_KW_ENUM {
        return parser_enum(src, toks, pos, nodes, kids);
    } else {
    }
    if k == T_KW_STATE {
        // Typestate (Epic 1, R3): a top-level `state Name { … }` protocol decl
        // (the actor `state { … }` block is parsed inside parser_actor).
        return parser_state_def(src, toks, pos, nodes);
    } else {
    }
    if k == T_KW_EXTERN {
        return parser_extern(src, toks, kpos, nodes, kids);
    } else {
    }
    if k == T_KW_EFFECT {
        return parser_effect_decl(src, toks, kpos, nodes);
    } else {
    }
    if k == T_KW_IMPL {
        return parser_impl(src, toks, pos, nodes, kids);
    } else {
    }
    if k == T_KW_TRAIT {
        return parser_trait(src, toks, pos, nodes, kids);
    } else {
    }
    if k == T_KW_ACTOR {
        return parser_actor(src, toks, pos, nodes, kids);
    } else {
    }
    if k == T_KW_ENTRY {
        return parser_actor(src, toks, pos, nodes, kids);
    } else {
    }
    if k == T_KW_CAP {
        return parser_cap_type(src, toks, pos, nodes);
    } else {
    }
    // PR-E4: a bare `type` (cap-type was claimed above on T_KW_CAP) → a type alias.
    if k == T_KW_TYPE {
        return parser_alias(src, toks, pos, nodes, kids);
    } else {
    }
    return parser_bail(toks, pos, nodes);
}

// module := ('#' '[' 'ring' '(' (inner|outer) ')' ']')? ('#' '[' 'trusted'
// ']')? 'pub'? 'module' IDENT ';' item*   (the header form; the braced form
// is a later slice). flags = ring-outer + trusted*2 + pub*4; the attributes
// do NOT extend the span — span = (pub|module-kw).start .. last-item.end (or
// .. the header semi when the module is empty). THE ROOT node.
fn parser_module(src: str, toks: Vec<Token>, pos: i64, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> (i64, i64) ! { Alloc } {
    let mut flags: i64 = 0;
    let mut p: i64 = pos;
    let mut attring: bool = true;
    while attring {
        let th: Token = toks.get(p);
        if th.kind == T_HASH {
            let tb: Token = toks.get(p + 1);
            if tb.kind == T_LBRACKET {
                let ti: Token = toks.get(p + 2);
                if ti.kind == T_KW_RING {
                    // NOTE `ring` lexes as the KEYWORD token, not an ident.
                    let tl: Token = toks.get(p + 3);
                    if tl.kind == T_LPAREN {
                        let tv: Token = toks.get(p + 4);
                        if tv.kind == T_IDENT {
                            let rname: str = src.substr(tv.start, tv.end);
                            if rname.bytes_eq("outer") {
                                flags = flags + 1;
                            } else {
                            }
                            let tr: Token = toks.get(p + 5);
                            if tr.kind == T_RPAREN {
                                let tcl: Token = toks.get(p + 6);
                                if tcl.kind == T_RBRACKET {
                                    p = p + 7;
                                } else {
                                    return parser_bail(toks, p + 6, nodes);
                                }
                            } else {
                                return parser_bail(toks, p + 5, nodes);
                            }
                        } else {
                            return parser_bail(toks, p + 4, nodes);
                        }
                    } else {
                        return parser_bail(toks, p + 3, nodes);
                    }
                } else {
                    if ti.kind == T_IDENT {
                        let aname: str = src.substr(ti.start, ti.end);
                        if aname.bytes_eq("trusted") {
                            let tcl2: Token = toks.get(p + 3);
                            if tcl2.kind == T_RBRACKET {
                                flags = flags + 2;
                                p = p + 4;
                            } else {
                                return parser_bail(toks, p + 3, nodes);
                            }
                        } else {
                            return parser_bail(toks, p + 2, nodes);
                        }
                    } else {
                        return parser_bail(toks, p + 2, nodes);
                    }
                }
            } else {
                attring = false;
            }
        } else {
            attring = false;
        }
    }
    let tp: Token = toks.get(p);
    let mut start: i64 = tp.start;
    if tp.kind == T_KW_PUB {
        flags = flags + 4;
        p = p + 1;
    } else {
    }
    let t0: Token = toks.get(p);
    if t0.kind == T_KW_MODULE {
        if flags >= 4 {
        } else {
            start = t0.start;
        }
    } else {
        return parser_bail(toks, p, nodes);
    }
    let tn: Token = toks.get(p + 1);
    if tn.kind == T_IDENT {
    } else {
        return parser_bail(toks, p + 1, nodes);
    }
    let ts: Token = toks.get(p + 2);
    if ts.kind == T_SEMI {
    } else {
        return parser_bail(toks, p + 2, nodes);
    }
    let mut local: Vec<i64> = Vec::new();
    p = p + 3;
    let mut last_end: i64 = ts.end;
    let mut scanning: bool = true;
    while scanning {
        let t: Token = toks.get(p);
        if t.kind == T_EOF {
            scanning = false;
        } else {
            // The next module begins (SH-PARSE-MM, ET-PMM-2/3): stop this module's
            // item loop so parser_parse parses it FRESH — mirroring the oracle's
            // `at_module_start` = `module` | (`pub` then `module`) | `#`. A module
            // boundary starts at:
            //   - `module` (a reserved keyword — never a top-level item), or
            //   - `pub` immediately before `module` (a `pub` module decl), or
            //   - `#` — the ONLY `#[...]` attributes in SIGIL are the MODULE
            //     attributes `#[ring(...)]`/`#[trusted]` (there are NO item-level
            //     attributes), so a `#` in item position can only open the next
            //     module's attribute run.
            // Before this guard the loop stopped on `module` ALONE, so a 2nd-or-later
            // module's leading `#[ring(outer)]`/`#[trusted]`/`pub` was fed to
            // parser_item, which bailed through it token-by-token and DROPPED the
            // module's ring/trusted/pub flags (AG-R11). None of these can legitimately
            // start a top-level item, so this never fires inside a single-module
            // source (ET-PMM-1).
            let mut at_mod: bool = false;
            if t.kind == T_KW_MODULE {
                at_mod = true;
            } else {
            }
            if t.kind == T_HASH {
                at_mod = true;
            } else {
            }
            if t.kind == T_KW_PUB {
                let tnext: Token = toks.get(p + 1);
                if tnext.kind == T_KW_MODULE {
                    at_mod = true;
                } else {
                }
            } else {
            }
            if at_mod {
                scanning = false;
            } else {
                let (iid, p2) = parser_item(src, toks, p, nodes, kids);
                let q: i64 = local.push(iid);
                let inode: PNode = nodes.get(iid);
                last_end = inode.end;
                if p2 == p {
                    // a bail AT Eof made no progress — terminate (ET-P5).
                    scanning = false;
                } else {
                }
                p = p2;
            }
        }
    }
    let name: str = src.substr(tn.start, tn.end);
    let nlen: i64 = name.len();
    let cstart: i64 = parser_kids_commit(kids, local);
    let id: i64 = nodes.allocate(PNode { kind: P_K_MODULE, start: start, end: last_end, value: nlen, flags: flags, child_start: cstart, child_count: local.len(), text: name });
    return (id, p);
}

// The entry point: parse the token stream into `nodes`/`kids`, returning the root
// NodeId. One `module` decl → the bare P_K_MODULE node (byte-identical to before,
// ET-PMM-1). Two-or-more → a P_K_PROGRAM wrapper whose children are the module nodes
// in source order (SH-PARSE-MM; mirrors the oracle's `Program{modules}`).
pub fn parser_parse(src: str, toks: Vec<Token>, nodes: Arena<PNode> @Mut, kids: Vec<i64> @Mut) -> i64 ! { Alloc } {
    let mut modules: Vec<i64> = Vec::new();
    let mut p: i64 = 0;
    let mut scanning: bool = true;
    while scanning {
        let t: Token = toks.get(p);
        if t.kind == T_EOF {
            scanning = false;
        } else {
            let (mid, p2) = parser_module(src, toks, p, nodes, kids);
            let pushed: i64 = modules.push(mid);
            if p2 == p {
                // no progress (a bail at EOF) — terminate (ET-PMM-6 / ET-P5).
                scanning = false;
            } else {
            }
            p = p2;
        }
    }
    let nmods: i64 = modules.len();
    if nmods == 1 {
        return modules.get(0);
    } else {
    }
    if nmods == 0 {
        // empty token stream: fall back to a single (bailing) module parse.
        let (only, pr) = parser_module(src, toks, 0, nodes, kids);
        return only;
    } else {
    }
    // >1 module: wrap them under a P_K_PROGRAM root. Read the first/last module spans
    // BEFORE parser_kids_commit consumes `modules`.
    let m0: PNode = nodes.get(modules.get(0));
    let mlast: PNode = nodes.get(modules.get(nmods - 1));
    let progstart: i64 = m0.start;
    let progend: i64 = mlast.end;
    let cstart: i64 = parser_kids_commit(kids, modules);
    let progid: i64 = nodes.allocate(PNode { kind: P_K_PROGRAM, start: progstart, end: progend, value: 0, flags: 0, child_start: cstart, child_count: nmods, text: "" });
    return progid;
}

// ── the differential encoder ─────────────────────────────────────────────────
// Pre-order from the root: per node `kind,start,end,value,flags,child_count;`
// (records), then `|`, then the pool — every name-bearing node's text in
// pre-order (value = its byte-length; the host length-walks). Pre-order +
// child_count reconstructs the tree, so the arena-internal child ids are
// never shipped. Records accumulate in a Vec<str> and join once — O(nodes).
fn parser_emit(nodes: Arena<PNode>, kids: Vec<i64>, id: i64, recs: Vec<str> @Mut, pool: Vec<str> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(id);
    let kstr: str = n.kind.itoa();
    let c1: str = kstr.concat(",");
    let sstr: str = n.start.itoa();
    let c2: str = c1.concat(sstr);
    let c3: str = c2.concat(",");
    let estr: str = n.end.itoa();
    let c4: str = c3.concat(estr);
    let c5: str = c4.concat(",");
    let vstr: str = n.value.itoa();
    let c6: str = c5.concat(vstr);
    let c7: str = c6.concat(",");
    let fstr: str = n.flags.itoa();
    let c8: str = c7.concat(fstr);
    let c9: str = c8.concat(",");
    let cstr: str = n.child_count.itoa();
    let c10: str = c9.concat(cstr);
    let c11: str = c10.concat(";");
    let pushedr: i64 = recs.push(c11);
    if parser_kind_has_text(n.kind) {
        let pushedp: i64 = pool.push(n.text);
    } else {
    }
    let mut emitted: i64 = 1;
    let mut i: i64 = 0;
    while i < n.child_count {
        let cid: i64 = kids.get(n.child_start + i);
        let sub: i64 = parser_emit(nodes, kids, cid, recs, pool);
        emitted = emitted + sub;
        i = i + 1;
    }
    return emitted;
}

pub fn parser_encode(nodes: Arena<PNode>, kids: Vec<i64>, root: i64) -> str ! { Alloc } {
    let mut recs: Vec<str> = Vec::new();
    let mut pool: Vec<str> = Vec::new();
    let emitted: i64 = parser_emit(nodes, kids, root, recs, pool);
    let empty: str = "";
    let recj: str = empty.join(recs);
    let poolj: str = empty.join(pool);
    let withbar: str = recj.concat("|");
    let full: str = withbar.concat(poolj);
    return full;
}
