// SH-TAINT self-hosted taint checker; see docs/specs/sh-security-checkers.md.
// (This leading comment lets the differential's `\nmodule taint_check;\n` strip match,
// exactly like lexer.sigil/parser.sigil/typecheck.sigil/ring_check.sigil — keeping all
// fns in the merged `module tool;`.)
module taint_check;

// SH-TAINT — self-hosted taint checker (prefix tt_/TT_). Composed (module header
// stripped) into taint_check_differential alongside lexer + parser + typecheck;
// reuses PNode + P_K_* (parser.sigil) and tc_seg_at (typecheck.sigil). A faithful
// PR-T1 (scalar-surface) port of the Rust oracle taint_check::check_taints for
// MIN_COVERED = the 13 codes {T001, T020-T027, T029-T032} (T028 send/ask DEMOTED —
// actor-only, AG-T13; records/closures/stdlib are PR-T2). Output is a `;`-joined
// T-code stream (one `Txxx;` per detected site); the harness dedups to a set.
//
// Lattice (ast.rs:9-43): Public(0) < Internal(1) < Secret(2) < SecretCT(3);
// lub = max; can_flow_to(target) = self <= target; is_ct = (== SecretCT). Default
// Public. Parser taint flag codes (parser_taint, 0=absent/1=Public/2=Internal/
// 3=Secret/4=SecretCT) map to a label via max(0, code-1) (absent & Public both ->
// Public). Decode per node (the CORRECTED formulas — `%4` would collapse SecretCT):
//   PARAM (flags = mcode + taint*4 + hasregion*32): code = (flags/4) % 8
//   LET   (flags = mflag + taint*2, mflag in {0,1}): code = flags/2
//   FN    (flags = pub + rtaint*2, pub in {0,1}):    code = flags/2
//   EXTERN(flags = rtaint):                          code = flags
// SIGIL has no `%`, so the PARAM modulo is `q - (q/8)*8`.

const TT_PUBLIC: i64 = 0;
const TT_INTERNAL: i64 = 1;
const TT_SECRET: i64 = 2;
const TT_SECRETCT: i64 = 3;

// A per-variable taint binding (the oracle's TaintEnv entry, scalar surface). The env
// is a flat Vec holding ONE entry per name: a re-let/assign overwrites that entry in place
// (`tt_upsert`, last-write-wins), never popped (ET-T12). A `let` that shadows an outer
// name is restored at its block's end by writing the outer binding back, and a
// control-flow merge writes the joined binding of every pre-construct name (SHP-5a; the
// join model's banner below). One entry per name keeps every lookup, clone and merge
// O(names): the append-only history this replaced made the self-compile's cost grow with
// the square of a function's length.
// `fields` (PR-T2): per-field record taint, encoded "f0=d0;f1=d1;" (d = the 1-char
// taint label 0-3) when this bind names a record local built from a literal
// RecordConstruct; "" for a scalar/whole binding. `taint` is the scalar value OR the
// record's lub-of-fields (the oracle's TaintBinding::label()), so a bare reference to
// the record local yields the lub. A field-write RAISES the whole binding to a scalar
// (fields="", taint=raised) — matching the oracle's bind() overwrite (ET-T13).
// `regions` (M6, SHP-5a): the set of regions this local may point into, as a bit mask over
// the function's region-taint map (`tt_rt_*` below); 0 for an unregioned binding.
// `tdesc` (SHP-5c-1): the descriptor of the binding's declared type (the heap-floor banner
// below) — a parameter's or annotated let's annotation, else its value's; `?` when unknown.
record TtBind { name: str, fields: str, taint: i64, regions: i64, tdesc: str }

// A function's declared parameter and return taints, decoded from P_K_PARAM/P_K_FN
// flags. TcSig carries NO taint, so this is a parallel table
// (DS-3). Keyed by the fn's BARE name (tc_seg_at(text, 0), stripping any effect
// suffix) so a bare same-module call resolves (TS-4; qualified calls are AG-T5/T7).
// SHP-5c-1: the table also holds the type facts the heap floors read, one `kind` per entry
// (`TT_SK_*`): `tdesc` is a fn's or extern's return type, a field's or payload's type, a
// const's type; `ffi` whether a fn's or method's effect row names FFI (S1).
// SHP-5c-2: a fn or method row names its node (`fnid`; -1 for the other kinds) and the impl's
// type def (`defid`; -1 for a module fn), and carries its call summary (the banner before
// `tt_sm_build`): `wm`, `mat`, `rr`, `rt` (1, 0, or -1 unknown for `mat` and `rt`), `ann`, `wt`
// (a slot mask, -1 for every slot) and `rel` (0 when a site must refuse rather than apply it).
// A `@Flow` parameter is the digit 5 in `param_taints` and a `@Flow` return reads @Public: the
// label flows in from the call (production's `param.flow` / `ret_flow` arms).
record TtSig { name: str, param_taints: str, ret_taint: i64, kind: i64, tdesc: str, ffi: bool, fnid: i64, defid: i64, wm: i64, mat: i64, rr: i64, rt: i64, ann: i64, wt: i64, rel: i64 }

// The entry kinds of the table. A name is unique within its kind.
const TT_SK_FN: i64 = 0;
const TT_SK_EXTERN: i64 = 1;
const TT_SK_FIELD: i64 = 2;
const TT_SK_VARIANT: i64 = 3;
const TT_SK_ENUM: i64 = 4;
const TT_SK_CONST: i64 = 5;
const TT_SK_METHOD: i64 = 6;
// SHP-5c-2: the sentinel row that marks the summaries live (`tt_sm_build`), and a module's
// name (a method call's receiver path may name one: `mod::f(..)`).
const TT_SK_SUM: i64 = 7;
const TT_SK_MODULE: i64 = 8;

// The index beside the table. Row numbers are semantic (`tt_sm_build`'s parallel edge arrays, a
// packed callee `row * 2 + first`, the sentinel at the end), so the table keeps its push order
// and the lookups go through this instead: `by_name` holds every row in byte order of its name,
// rows of one name in table order (so the first of a kind in a run is the first pushed, the row
// the scan this replaced returned), and `variants` holds the variant name (`;`-segment 1) of every
// TT_SK_VARIANT row, sorted. Built once by `tt_encode` after `tt_build_sigs`, and complete for
// every lookup after it: the rows `tt_sc_fn` and `tt_sm_close` rewrite keep their name and kind,
// and the one row pushed later is `tt_sm_build`'s sentinel, of a kind no lookup asks for
// (`certified_source_keeps_the_indexed_lookup_invariants` refuses a push, a rewrite or a scan
// that would break this).
record TtIdx { by_name: Vec<i64>, variants: Vec<str> }

// lub = max over the 4-level lattice.
fn tt_lub(a: i64, b: i64) -> i64 {
    if a > b {
        return a;
    } else {
    }
    return b;
}

// is_ct = (== SecretCT) = (>= SecretCT, the top).
fn tt_is_ct(t: i64) -> bool {
    if t >= TT_SECRETCT {
        return true;
    } else {
    }
    return false;
}

// A self-host-only verdict, deliberately outside the production T-code namespace. The composed
// pipeline treats it as rejection; differential code-set comparisons filter it and remain scoped
// to the supported projection. Known unsupported syntax must never look like a clean verdict.
fn tt_mark_unsupported(diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let p: i64 = diags.push("SH_TAINT_UNSUPPORTED;");
    return 0;
}

// Write `b` as the current binding of its name: overwrite the entry in place, or append
// the name's first one.
fn tt_upsert(binds: Vec<TtBind> @Mut, b: TtBind) -> i64 ! { Alloc } {
    let n: i64 = binds.len();
    let mut i: i64 = n - 1;
    while i >= 0 {
        let cur: TtBind = binds.get(i);
        if cur.name.bytes_eq(b.name) {
            let q: i64 = binds.set(i, b);
            return 0;
        }
        i = i - 1;
    }
    let p: i64 = binds.push(b);
    return 0;
}

// can_flow_to(target) = self <= target.
fn tt_can_flow(a: i64, b: i64) -> bool {
    if a > b {
        return false;
    } else {
    }
    return true;
}

// parser_taint code (0..4) -> TaintLabel discriminant (0..3): absent(0)&Public(1)->0,
// Internal(2)->1, Secret(3)->2, SecretCT(4)->3.
fn tt_label_of_code(code: i64) -> i64 {
    if code <= 1 {
        return TT_PUBLIC;
    } else {
    }
    return code - 1;
}

// PR-T2: the 1-char taint-label digit ("0".."3") for encoding a record's per-field taints.
fn tt_digit(t: i64) -> str {
    if t == 1 {
        return "1";
    } else {
    }
    if t == 2 {
        return "2";
    } else {
    }
    if t == 3 {
        return "3";
    } else {
    }
    return "0";
}

// Decode a record field's taint from the "name0=d0;name1=d1;" encoding; TT_PUBLIC if the
// field is absent (the oracle's fields.get(field).unwrap_or(Public)). ';'=59, '='=61.
fn tt_field_taint(enc: str, field: str) -> i64 {
    let n: i64 = enc.len();
    let mut segstart: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        let bc: i64 = enc.byte_at(i);
        if bc == 59 {
            let mut eq: i64 = segstart;
            let mut found: bool = false;
            let mut j: i64 = segstart;
            while j < i {
                let cc: i64 = enc.byte_at(j);
                if cc == 61 {
                    eq = j;
                    found = true;
                    j = i;
                } else {
                    j = j + 1;
                }
            }
            if found {
                let nm: str = enc.substr(segstart, eq);
                if nm.bytes_eq(field) {
                    let ds: str = enc.substr(eq + 1, i);
                    return tc_atoi(ds);
                } else {
                }
            } else {
            }
            segstart = i + 1;
        } else {
        }
        i = i + 1;
    }
    return TT_PUBLIC;
}

// The oracle's lookup_field: most-recent-first; the first binding of `base` — if it has
// encoded fields, decode `field` (Public if absent); if scalar (fields==""), return the
// scalar (a Scalar binding's field-access yields the scalar); Public if base is unbound.
fn tt_lookup_field(binds: Vec<TtBind>, base: str, field: str) -> i64 {
    let n: i64 = binds.len();
    let mut i: i64 = n - 1;
    while i >= 0 {
        let b: TtBind = binds.get(i);
        if b.name.bytes_eq(base) {
            if b.fields.len() > 0 {
                return tt_field_taint(b.fields, field);
            } else {
                return b.taint;
            }
        } else {
        }
        i = i - 1;
    }
    return TT_PUBLIC;
}

// Does a path text contain a "::" separator? `r.a` parses to a P_K_PATH text "r::a"
// (the parser normalizes `.` -> `::`, parser.sigil ~:578). ':'=58.
fn tt_path_has_sep(text: str) -> bool {
    let n: i64 = text.len();
    let mut i: i64 = 0;
    while i < n - 1 {
        let a: i64 = text.byte_at(i);
        if a == 58 {
            let b: i64 = text.byte_at(i + 1);
            if b == 58 {
                return true;
            } else {
            }
        } else {
        }
        i = i + 1;
    }
    return false;
}

// The `want`-th "::"-segment of a path. For "r::a": seg0="r" (base local), seg1="a" (the
// INNERMOST field — matching the oracle's FieldAccess-on-Local resolution; for a deeper
// `r::a::b`, seg1 is still "a", so the result == the oracle's lookup_field(r,"a")). "" if
// there are fewer than `want`+1 segments.
fn tt_path_seg(text: str, want: i64) -> str {
    let n: i64 = text.len();
    let mut seg: i64 = 0;
    let mut segstart: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        if i < n - 1 {
            let a: i64 = text.byte_at(i);
            let b: i64 = text.byte_at(i + 1);
            if a == 58 {
                if b == 58 {
                    if seg == want {
                        return text.substr(segstart, i);
                    } else {
                    }
                    seg = seg + 1;
                    segstart = i + 2;
                    i = i + 2;
                } else {
                    i = i + 1;
                }
            } else {
                i = i + 1;
            }
        } else {
            i = i + 1;
        }
    }
    if seg == want {
        return text.substr(segstart, n);
    } else {
    }
    return "";
}

// The innermost local a place expression writes through (the oracle's place_root_local):
// a P_K_PATH's base segment ("r" for `r` or `r.a`), or recursively the array of a
// P_K_INDEX (`a` for `a[i]` / `a.b[i]`). "" for a non-place node.
fn tt_place_root(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64) -> str {
    let n: PNode = nodes.get(nid);
    if n.kind == P_K_PATH {
        return tt_path_seg(n.text, 0);
    } else {
    }
    if n.kind == P_K_INDEX {
        if n.child_count >= 1 {
            let cid: i64 = kids.get(n.child_start);
            return tt_place_root(nodes, kids, cid);
        } else {
        }
    } else {
    }
    return "";
}

// Linear membership over a Vec<str>.
fn tt_name_in(names: Vec<str>, name: str) -> bool {
    let n: i64 = names.len();
    let mut i: i64 = 0;
    let mut found: bool = false;
    let mut scanning: bool = true;
    while scanning {
        if i >= n {
            scanning = false;
        } else {
            let cand: str = names.get(i);
            if cand.bytes_eq(name) {
                found = true;
                scanning = false;
            } else {
                i = i + 1;
            }
        }
    }
    return found;
}

// Module ids under `root`: a P_K_PROGRAM (83) wrapper's children, or the bare
// P_K_MODULE root (single-module). Mirrors rc_collect_modules / nr_collect_modules.
fn tt_collect_modules(nodes: Arena<PNode>, kids: Vec<i64>, root: i64, out: Vec<i64> @Mut) -> i64 ! { Alloc } {
    let rn: PNode = nodes.get(root);
    if rn.kind == P_K_PROGRAM {
        let mut i: i64 = 0;
        while i < rn.child_count {
            let cid: i64 = kids.get(rn.child_start + i);
            let pushed: i64 = out.push(cid);
            i = i + 1;
        }
    } else {
        let pushed: i64 = out.push(root);
    }
    return 0;
}

// Collect every declared extern-fn NAME across all modules (the oracle's
// universe.extern_fns). A P_K_EXTERN_FN's text is "abi;name;effect…" so the name is
// segment 1 (tc_seg_at(text, 1)). Used to classify a P_K_CALL as an ExternCall (ET-T14).
fn tt_collect_externs(nodes: Arena<PNode>, kids: Vec<i64>, mods: Vec<i64>, out: Vec<str> @Mut) -> i64 ! { Alloc } {
    let nm: i64 = mods.len();
    let mut mi: i64 = 0;
    while mi < nm {
        let mid: i64 = mods.get(mi);
        let mn: PNode = nodes.get(mid);
        let mut i: i64 = 0;
        while i < mn.child_count {
            let cid: i64 = kids.get(mn.child_start + i);
            let cn: PNode = nodes.get(cid);
            if cn.kind == P_K_EXTERN_FN {
                let enm: str = tc_seg_at(cn.text, 1);
                let p: i64 = out.push(enm);
            } else {
            }
            i = i + 1;
        }
        mi = mi + 1;
    }
    return 0;
}

// A generic fn (a P_K_FN with a P_K_TYPE_PARAM child) is SKIPPED (AG-R8 analog): the
// oracle taint-checks only MONOMORPHIZED instances, never the generic source — an
// uncalled generic produces zero typed functions, so checking its source self-host-side
// would false-fire. Skipping it is subset-safe (taint is instance-independent, so a
// CALLED generic's instance codes equal the source's — but the uncalled case must skip).
fn tt_is_generic_fn(nodes: Arena<PNode>, kids: Vec<i64>, fnid: i64) -> bool {
    let fnn: PNode = nodes.get(fnid);
    let mut i: i64 = 0;
    let mut found: bool = false;
    let mut scanning: bool = true;
    while scanning {
        if i >= fnn.child_count {
            scanning = false;
        } else {
            let cid: i64 = kids.get(fnn.child_start + i);
            let cn: PNode = nodes.get(cid);
            if cn.kind == P_K_TYPE_PARAM {
                found = true;
                scanning = false;
            } else {
                i = i + 1;
            }
        }
    }
    return found;
}

// Build the function-and-type table: for every module its functions (declared parameter
// labels in positional order, the return label, the return type's descriptor, the FFI row
// fact) and externs, and — SHP-5c-1 — the type facts the heap-floor rules read: record
// fields, enums and their variants' payloads, consts and impl methods (see `tt_edesc`).
fn tt_build_sigs(nodes: Arena<PNode>, kids: Vec<i64>, mods: Vec<i64>, out: Vec<TtSig> @Mut) -> i64 ! { Alloc } {
    let nm: i64 = mods.len();
    let mut mi: i64 = 0;
    while mi < nm {
        let mid: i64 = mods.get(mi);
        let mn: PNode = nodes.get(mid);
        let modrow: TtSig = tt_sig_row(mn.text, "", TT_PUBLIC, TT_SK_MODULE, "", false, 0 - 1, 0 - 1);
        let qmod: i64 = out.push(modrow);
        let mut i: i64 = 0;
        while i < mn.child_count {
            let cid: i64 = kids.get(mn.child_start + i);
            let cn: PNode = nodes.get(cid);
            if cn.kind == P_K_FN {
                let qf: i64 = tt_push_fn_sig(nodes, kids, cid, TT_SK_FN, "", 0 - 1, out);
            }
            if cn.kind == P_K_EXTERN_FN {
                // "abi;name;effect…"; the return type is the one type-family child.
                let rid: i64 = tc_fn_ret_typeid(nodes, kids, cid);
                let extrow: TtSig = tt_sig_row(tc_seg_at(cn.text, 1), "", TT_INTERNAL, TT_SK_EXTERN, tt_tdesc(nodes, kids, rid, 0), true, 0 - 1, 0 - 1);
                let qe: i64 = out.push(extrow);
            }
            if cn.kind == P_K_RECORD_DEF {
                let qr: i64 = tt_push_record_sigs(nodes, kids, cid, out);
            }
            if cn.kind == P_K_ENUM_DEF {
                let qn: i64 = tt_push_enum_sigs(nodes, kids, cid, out);
            }
            if cn.kind == P_K_CONST {
                // "name;value"; the one child is the declared type.
                let ctid: i64 = kids.get(cn.child_start);
                let constrow: TtSig = tt_sig_row(tc_seg_at(cn.text, 0), "", TT_PUBLIC, TT_SK_CONST, tt_tdesc(nodes, kids, ctid, 0), false, 0 - 1, 0 - 1);
                let qc: i64 = out.push(constrow);
            }
            if cn.kind == P_K_IMPL {
                // "trait;type": every method is keyed `type;method`; the type's own def (in
                // this module) names the type parameters a method's return may mention.
                let tname: str = tc_seg_at(cn.text, 1);
                let defid: i64 = tt_find_def(nodes, kids, mid, tname);
                let mut k: i64 = 0;
                while k < cn.child_count {
                    let fid: i64 = kids.get(cn.child_start + k);
                    let fnn: PNode = nodes.get(fid);
                    if fnn.kind == P_K_FN {
                        let qm: i64 = tt_push_fn_sig(nodes, kids, fid, TT_SK_METHOD, tname.concat(";"), defid, out);
                    }
                    k = k + 1;
                }
            }
            i = i + 1;
        }
        mi = mi + 1;
    }
    return 0;
}

// One fn's entry under `kind`, its name prefixed by `prefix` (empty for a top-level fn,
// `Type;` for an impl method). The return-taint occupies the low flag bits (pub bit0 +
// rtaint*2). SH-MONO MONO-3b rides a monomorph-instance marker on bit 2^20
// (mn_clone_instance) for the W-lane bare export; mask it off (keep bits 0-19) before
// decoding taint, so a monomorphized instance's declared taint reads correctly in the
// composed sh_compile pipeline (MONO-4). A source fn never has the bit, so `& 1048575` is a
// no-op everywhere else — the taint differential is unchanged. A `@Flow` parameter (code 5)
// is the digit 5, not a lattice point, and a `@Flow` return reads @Public (SHP-5c-2: the
// label is the call's). A return type that names a
// type parameter of the fn or of `defid` (the impl's type) is `?`: an instance's type is not
// in this shadow's view, and a guessed scalar or nominal could move a floor.
fn tt_push_fn_sig(nodes: Arena<PNode>, kids: Vec<i64>, fnid: i64, kind: i64, prefix: str, defid: i64, out: Vec<TtSig> @Mut) -> i64 ! { Alloc } {
    let cn: PNode = nodes.get(fnid);
    let code: i64 = (cn.flags & 1048575) / 2;
    let mut lab: i64 = tt_label_of_code(code);
    if code == 5 {
        lab = TT_PUBLIC;
    }
    let bare: str = tc_seg_at(cn.text, 0);
    let mut param_taints: str = "";
    let mut pi: i64 = 0;
    while pi < cn.child_count {
        let pid: i64 = kids.get(cn.child_start + pi);
        let pn: PNode = nodes.get(pid);
        if pn.kind == P_K_PARAM {
            let q: i64 = pn.flags / 4;
            let pcode: i64 = q - (q / 8) * 8;
            if pcode == 5 {
                param_taints = param_taints.concat("5");
            } else {
                param_taints = param_taints.concat(tt_digit(tt_label_of_code(pcode)));
            }
        }
        pi = pi + 1;
    }
    let rid: i64 = tc_fn_ret_typeid(nodes, kids, fnid);
    let mut rdesc: str = tt_tdesc(nodes, kids, rid, 0);
    if rid >= 0 {
        if tt_names_type_param(nodes, kids, fnid, rid) {
            rdesc = "?";
        }
        if defid >= 0 {
            if tt_names_type_param(nodes, kids, defid, rid) {
                rdesc = "?";
            }
        }
    }
    // S1's row fact (production's `callee_has_ffi`): the text is `name;!;effect…`.
    let ffi: bool = tc_seg_from_has(cn.text, 1, "FFI");
    let fnrow: TtSig = tt_sig_row(prefix.concat(bare), param_taints, lab, kind, rdesc, ffi, fnid, defid);
    let p: i64 = out.push(fnrow);
    return 0;
}

// The record or enum def named `name` among module `mid`'s children, or -1.
fn tt_find_def(nodes: Arena<PNode>, kids: Vec<i64>, mid: i64, name: str) -> i64 {
    let mn: PNode = nodes.get(mid);
    let mut i: i64 = 0;
    while i < mn.child_count {
        let cid: i64 = kids.get(mn.child_start + i);
        let cn: PNode = nodes.get(cid);
        let mut isdef: bool = false;
        if cn.kind == P_K_RECORD_DEF {
            isdef = true;
        }
        if cn.kind == P_K_ENUM_DEF {
            isdef = true;
        }
        if isdef {
            if cn.text.bytes_eq(name) {
                return cid;
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

// Does the type node `tid` name a type parameter declared on `defid` (a fn, record or enum),
// at its top or inside a generic argument or an array element?
fn tt_names_type_param(nodes: Arena<PNode>, kids: Vec<i64>, defid: i64, tid: i64) -> bool {
    let tn: PNode = nodes.get(tid);
    if tn.kind == P_K_TYPE_ARRAY {
        return tt_names_type_param(nodes, kids, defid, kids.get(tn.child_start));
    }
    if tn.kind != P_K_TYPE {
        return false;
    }
    let dn: PNode = nodes.get(defid);
    let tname: str = tc_seg_at(tn.text, 0);
    let mut i: i64 = 0;
    while i < dn.child_count {
        let cid: i64 = kids.get(dn.child_start + i);
        let cn: PNode = nodes.get(cid);
        if cn.kind == P_K_TYPE_PARAM {
            let pname: str = tc_seg_at(cn.text, 0);
            if pname.bytes_eq(tname) {
                return true;
            }
        }
        i = i + 1;
    }
    let mut k: i64 = 0;
    while k < tn.child_count {
        if tt_names_type_param(nodes, kids, defid, kids.get(tn.child_start + k)) {
            return true;
        }
        k = k + 1;
    }
    return false;
}

// A record's fields: `Record;field` -> the field type's descriptor, `?` when that type
// names one of the record's own type parameters (an instance's type is not in view).
fn tt_push_record_sigs(nodes: Arena<PNode>, kids: Vec<i64>, rid: i64, out: Vec<TtSig> @Mut) -> i64 ! { Alloc } {
    let rn: PNode = nodes.get(rid);
    let mut i: i64 = 0;
    while i < rn.child_count {
        let cid: i64 = kids.get(rn.child_start + i);
        let cn: PNode = nodes.get(cid);
        if cn.kind == P_K_FIELD {
            let ftid: i64 = kids.get(cn.child_start);
            let mut d: str = tt_tdesc(nodes, kids, ftid, 0);
            if tt_names_type_param(nodes, kids, rid, ftid) {
                d = "?";
            }
            let j: str = rn.text.concat(";");
            let fieldrow: TtSig = tt_sig_row(j.concat(cn.text), "", TT_PUBLIC, TT_SK_FIELD, d, false, 0 - 1, 0 - 1);
            let p: i64 = out.push(fieldrow);
        }
        i = i + 1;
    }
    return 0;
}

// An enum: its name, and `Enum;Variant;k` -> payload k's descriptor (type parameters as above).
fn tt_push_enum_sigs(nodes: Arena<PNode>, kids: Vec<i64>, eid: i64, out: Vec<TtSig> @Mut) -> i64 ! { Alloc } {
    let en: PNode = nodes.get(eid);
    let enumrow: TtSig = tt_sig_row(en.text, "", TT_PUBLIC, TT_SK_ENUM, "", false, 0 - 1, 0 - 1);
    let p0: i64 = out.push(enumrow);
    let mut i: i64 = 0;
    while i < en.child_count {
        let vid: i64 = kids.get(en.child_start + i);
        let vn: PNode = nodes.get(vid);
        if vn.kind == P_K_ENUM_VARIANT {
            let mut k: i64 = 0;
            let mut pk: i64 = 0;
            while k < vn.child_count {
                let fid: i64 = kids.get(vn.child_start + k);
                let fnn: PNode = nodes.get(fid);
                if fnn.kind == P_K_ENUM_FIELD {
                    let ftid: i64 = kids.get(fnn.child_start);
                    let mut d: str = tt_tdesc(nodes, kids, ftid, 0);
                    if tt_names_type_param(nodes, kids, eid, ftid) {
                        d = "?";
                    }
                    let j1: str = en.text.concat(";");
                    let j2: str = j1.concat(vn.text);
                    let j3: str = j2.concat(";");
                    let varrow: TtSig = tt_sig_row(j3.concat(pk.itoa()), "", TT_PUBLIC, TT_SK_VARIANT, d, false, 0 - 1, 0 - 1);
                    let p: i64 = out.push(varrow);
                    pk = pk + 1;
                }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

// Build the index of `sigs` (`TtIdx`): the stable byte order of the row names (`tc_sorted_order`
// keeps equal names in table order) and the sorted variant names.
fn tt_index_build(sigs: Vec<TtSig>) -> TtIdx ! { Alloc } {
    let n: i64 = sigs.len();
    let mut names: Vec<str> = Vec::new();
    let mut vkeys: Vec<str> = Vec::new();
    let mut i: i64 = 0;
    while i < n {
        let s: TtSig = sigs.get(i);
        let qn: i64 = names.push(s.name);
        if s.kind == TT_SK_VARIANT {
            let qv: i64 = vkeys.push(tc_seg_at(s.name, 1));
        }
        i = i + 1;
    }
    let by_name: Vec<i64> = tc_sorted_order(names);
    let vorder: Vec<i64> = tc_sorted_order(vkeys);
    let mut variants: Vec<str> = Vec::new();
    let nv: i64 = vorder.len();
    let mut j: i64 = 0;
    while j < nv {
        let qs: i64 = variants.push(vkeys.get(vorder.get(j)));
        j = j + 1;
    }
    return TtIdx { by_name: by_name, variants: variants };
}

// The first position in `by_name` whose row is named `name` or sorts after it (`n` when every row
// sorts before it): the start of the run of rows named `name`, which is in table order.
fn tt_index_first(sigs: Vec<TtSig>, sidx: TtIdx, name: str) -> i64 {
    let n: i64 = sidx.by_name.len();
    let mut lo: i64 = 0;
    let mut hi: i64 = n;
    while lo < hi {
        let mid: i64 = lo + (hi - lo) / 2;
        let ms: TtSig = sigs.get(sidx.by_name.get(mid));
        if tc_str_lt(ms.name, name) {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

// The index of the entry of `kind` named `name`, or -1: the first row of that kind in the run of
// rows named `name`.
fn tt_tab_find(sigs: Vec<TtSig>, sidx: TtIdx, kind: i64, name: str) -> i64 {
    let n: i64 = sidx.by_name.len();
    let mut at: i64 = tt_index_first(sigs, sidx, name);
    while at < n {
        let row: i64 = sidx.by_name.get(at);
        let s: TtSig = sigs.get(row);
        if !s.name.bytes_eq(name) {
            return 0 - 1;
        }
        if s.kind == kind {
            return row;
        }
        at = at + 1;
    }
    return 0 - 1;
}

// The descriptor of the entry of `kind` named `name`, `?` when the table has none.
fn tt_tab_desc(sigs: Vec<TtSig>, sidx: TtIdx, kind: i64, name: str) -> str {
    let i: i64 = tt_tab_find(sigs, sidx, kind, name);
    if i < 0 {
        return "?";
    }
    let s: TtSig = sigs.get(i);
    return s.tdesc;
}

// Declared positional parameter label of a fn entry, or -1 past its arity.
fn tt_sig_param_at(s: TtSig, index: i64) -> i64 {
    if index < s.param_taints.len() {
        return s.param_taints.byte_at(index) - 48;
    }
    return 0 - 1;
}

// Seed a function's env with its parameters' declared taints (PARAM decode
// (flags/4)%8 -> label). `%8` is `q - (q/8)*8` (no `%` in SIGIL). SHP-5c-1: each binding
// carries its type's descriptor, and a heap-typed parameter's bytes are already in linear
// memory at its label (production's `function_entry_env`, S2) — a parameter this typing
// cannot classify at a non-public label refuses.
fn tt_seed_params(nodes: Arena<PNode>, kids: Vec<i64>, fnid: i64, binds: Vec<TtBind> @Mut, fl: Vec<i64> @Mut, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let fnn: PNode = nodes.get(fnid);
    let mut i: i64 = 0;
    while i < fnn.child_count {
        let cid: i64 = kids.get(fnn.child_start + i);
        let cn: PNode = nodes.get(cid);
        if cn.kind == P_K_PARAM {
            let q: i64 = cn.flags / 4;
            let code: i64 = q - (q / 8) * 8;
            let lab: i64 = tt_label_of_code(code);
            let mut pd: str = "?";
            if cn.child_count >= 1 {
                pd = tt_tdesc(nodes, kids, kids.get(cn.child_start), 0);
            }
            if lab > TT_PUBLIC {
                let h: i64 = tt_desc_heap(pd);
                if h > 0 {
                    let qw: i64 = tt_fl_note_write(fl, lab);
                }
                if h < 0 {
                    let up: i64 = tt_mark_unsupported(diags);
                }
            }
            let p: i64 = tt_upsert(binds, TtBind { name: cn.text, fields: "", taint: lab, regions: 0, tdesc: pd });
        } else {
        }
        i = i + 1;
    }
    return 0;
}

// PR-T2 (closure E4): build the closure's capture env from the enclosing binds. SIGIL
// closures capture FREE vars BY VALUE; because the env is append-only / never-popped
// (ET-T12), the enclosing binds already carry every captured var at its SOURCE taint, so a
// referenced free var resolves to its enclosing taint (AG-T9: a referenced free var IS a
// capture). The copy also ISOLATES closure-body binds from the enclosing scope (the body's
// lets/assigns mutate the copy, never the caller's env). CRUCIALLY each capture is COLLAPSED
// to a SCALAR (fields="", taint = the bind's lub label): the oracle captures via
// `env.lookup(cap.name)` — which returns a scalar TaintLabel — and `closure_env.bind`s a
// SCALAR, so a captured RECORD reads as its lub inside the closure body (`r.a`/`r.b` both =
// the record's lub), NOT per-field. Preserving the per-field encoding here would make the
// self-host MORE precise than the oracle → it would MISS the oracle's lub-driven codes on a
// captured-record-field read (adversarial fixtures C1/C2). Records DECLARED inside the body
// are still tracked per-field (tt_stmt rebuilds their encoding) — only CAPTURES collapse.
fn tt_copy_binds(src: Vec<TtBind>, dst: Vec<TtBind> @Mut) -> i64 ! { Alloc } {
    // The env holds one entry per name (tt_upsert), so a copy IN ORDER is the env: the
    // order is what lets the joins below index a clone by the name list taken from its
    // source instead of scanning it per name (O(names), not O(names²); the self-compile
    // under the Python interpreter measured the square, SHP-5a).
    let n: i64 = src.len();
    let mut i: i64 = 0;
    while i < n {
        let b: TtBind = src.get(i);
        let p: i64 = dst.push(TtBind { name: b.name, fields: "", taint: b.taint, regions: b.regions, tdesc: b.tdesc });
        i = i + 1;
    }
    return 0;
}

// ────────────────────────────────────────────────────────────────────────────
// SHP-5c-1 — the heap floors (docs/specs/sh-security-checkers.md). Production keys two of
// its floor rules on TYPES (`is_heap_resident`, `reads_typed_memory`), which this parse-tree
// shadow recovers from syntax: a TYPE DESCRIPTOR is one byte of shape and, where a read
// projects a part out, the part's descriptor after it:
//   i          a wasm-local scalar: bool, i32, u32, i64, u64, f64, Region, unit
//   s          str                          u          u256 / i256
//   A<elem>    [T; N], &[T], a slice        V<elem>    Vec<T>          E<elem>  Arena<T>
//   M<value>   Map<K, V>                    O<inner>   Option<T>       Q<ok>    Result<T, E>
//   &<inner>   &T, &mut T                   T          tuple, fn type, slot, cap: opaque
//   N:<name>   any other nominal (record, enum, generic record)
//   ?          unknown
// Everything but `i` is heap-resident (production's `is_heap_resident`, whose only scalars
// are the six machine types, unit, an int literal and a region handle). A binding carries
// the descriptor of its declared type (a parameter's or annotated let's annotation, else its
// value's, `tt_edesc`), a fn entry its return type's. `?` is the fail-closed case: a shape
// this typing cannot classify REFUSES (SH_TAINT_UNSUPPORTED) wherever a non-public label
// would make a floor rule read it, and is inert at @Public (a @Public write raises nothing,
// a floor at @Public joins nothing) — so the all-public self-compile never pays for the
// typing and never refuses. Type aliases are refused outright (`tt_encode`): an alias of a
// scalar typed as a nominal would raise a floor production does not.
// ────────────────────────────────────────────────────────────────────────────

const TT_D_SCALAR: i64 = 105;
const TT_D_STR: i64 = 115;
const TT_D_WIDE: i64 = 117;
const TT_D_ARRAY: i64 = 65;
const TT_D_VEC: i64 = 86;
const TT_D_ARENA: i64 = 69;
const TT_D_MAP: i64 = 77;
const TT_D_OPTION: i64 = 79;
const TT_D_RESULT: i64 = 81;
const TT_D_REF: i64 = 38;
const TT_D_NOMINAL: i64 = 78;
const TT_D_UNKNOWN: i64 = 63;

// The shape byte of a descriptor (`?` for an empty one).
fn tt_desc_head(d: str) -> i64 {
    if d.len() == 0 {
        return TT_D_UNKNOWN;
    }
    return d.byte_at(0);
}

// A descriptor of shape `shape` over `inner` (a shape byte is written as a literal).
fn tt_desc_wrap(shape: str, inner: str) -> str ! { Alloc } {
    return shape.concat(inner);
}

// The descriptor with its reference shapes stripped: a field, an element or a method
// resolves through `&`.
fn tt_desc_deref(d: str) -> str {
    let mut cur: str = d;
    let mut stripping: bool = true;
    while stripping {
        if tt_desc_head(cur) == TT_D_REF {
            cur = cur.substr(1, cur.len());
        } else {
            stripping = false;
        }
    }
    return cur;
}

// Production's `is_heap_resident` over a descriptor: 1 heap-resident, 0 a wasm-local scalar,
// -1 unknown.
fn tt_desc_heap(d: str) -> i64 {
    let h: i64 = tt_desc_head(d);
    if h == TT_D_SCALAR {
        return 0;
    }
    if h == TT_D_UNKNOWN {
        return 0 - 1;
    }
    return 1;
}

// The part a projection reads out: an element, a map value, an option's or result's payload,
// a reference's referent; `?` for a shape with no part.
fn tt_desc_inner(d: str) -> str {
    let h: i64 = tt_desc_head(d);
    let mut proj: bool = false;
    if h == TT_D_ARRAY {
        proj = true;
    }
    if h == TT_D_VEC {
        proj = true;
    }
    if h == TT_D_ARENA {
        proj = true;
    }
    if h == TT_D_MAP {
        proj = true;
    }
    if h == TT_D_OPTION {
        proj = true;
    }
    if h == TT_D_RESULT {
        proj = true;
    }
    if h == TT_D_REF {
        proj = true;
    }
    if proj {
        return d.substr(1, d.len());
    }
    return "?";
}

// The name of a nominal `N:<name>` (through references), "" for any other shape.
fn tt_desc_nominal(d: str) -> str {
    let base: str = tt_desc_deref(d);
    if tt_desc_head(base) == TT_D_NOMINAL {
        return base.substr(2, base.len());
    }
    return "";
}

// The descriptor of field `field` of a value described by `d`: the record table's entry.
// SHP-5c-2: a stdlib generic record read by its shape (`self.count` in the stdlib's own
// method bodies) resolves through its record def when the stdlib text is present.
fn tt_desc_field(d: str, field: str, sigs: Vec<TtSig>, sidx: TtIdx) -> str ! { Alloc } {
    let mut nm: str = tt_desc_nominal(d);
    if nm.len() == 0 {
        nm = tt_sm_builtin_type(tt_desc_head(tt_desc_deref(d)));
    }
    if nm.len() == 0 {
        return "?";
    }
    let j: str = nm.concat(";");
    return tt_tab_desc(sigs, sidx, TT_SK_FIELD, j.concat(field));
}

// The text after the last `::` of a path (the whole text when it has none).
fn tt_last_seg(s: str) -> str {
    let c: i64 = tc_last_colons(s);
    if c < 0 {
        return s;
    }
    return s.substr(c + 2, s.len());
}

// The six machine scalars and the region handle: production's non-heap `Type`s with a name.
fn tt_scalar_name(name: str) -> bool {
    if name.bytes_eq("i64") {
        return true;
    }
    if name.bytes_eq("i32") {
        return true;
    }
    if name.bytes_eq("u32") {
        return true;
    }
    if name.bytes_eq("u64") {
        return true;
    }
    if name.bytes_eq("f64") {
        return true;
    }
    if name.bytes_eq("bool") {
        return true;
    }
    if name.bytes_eq("Region") {
        return true;
    }
    return false;
}

// Generic argument `k` of a named type node, `?` when absent.
fn tt_targ(nodes: Arena<PNode>, kids: Vec<i64>, tid: i64, k: i64, fnid: i64, defid: i64, depth: i64) -> str ! { Alloc } {
    let n: PNode = nodes.get(tid);
    if n.child_count > k {
        return tt_tdesc_tp(nodes, kids, kids.get(n.child_start + k), fnid, defid, depth + 1);
    }
    return "?";
}

// The descriptor of a type node (-1: no node, a unit return), every name read as written.
fn tt_tdesc(nodes: Arena<PNode>, kids: Vec<i64>, tid: i64, depth: i64) -> str ! { Alloc } {
    return tt_tdesc_tp(nodes, kids, tid, 0 - 1, 0 - 1, depth);
}

// The descriptor of a type node, with every leaf that names a type parameter of fn `fnid` or
// of the impl's type def `defid` (-1 for either: none) read as `?` — the scan's reading, where
// an instance's type is out of view. A slice `&[T]` and a reference `&T` are the inner node
// carrying the parser's flag (3, 1 or 2); the depth bound fails closed on a type deeper than
// any the parser produces.
fn tt_tdesc_tp(nodes: Arena<PNode>, kids: Vec<i64>, tid: i64, fnid: i64, defid: i64, depth: i64) -> str ! { Alloc } {
    if tid < 0 {
        return "i";
    }
    if depth > 16 {
        return "?";
    }
    let n: PNode = nodes.get(tid);
    let base: str = tt_tdesc_base(nodes, kids, tid, fnid, defid, depth);
    if n.flags == 3 {
        return tt_desc_wrap("A", base);
    }
    if n.flags > 0 {
        return tt_desc_wrap("&", base);
    }
    return base;
}

// A type node's descriptor by its kind and name, flags aside: a type parameter of `fnid` or
// `defid` unknown, the stdlib generics by name with their projected argument, any other name
// a nominal.
fn tt_tdesc_base(nodes: Arena<PNode>, kids: Vec<i64>, tid: i64, fnid: i64, defid: i64, depth: i64) -> str ! { Alloc } {
    let n: PNode = nodes.get(tid);
    if n.kind == P_K_TYPE_ARRAY {
        return tt_desc_wrap("A", tt_tdesc_tp(nodes, kids, kids.get(n.child_start), fnid, defid, depth + 1));
    }
    if n.kind == P_K_TYPE_TUPLE {
        return "T";
    }
    if n.kind == P_K_TYPE_FN {
        return "T";
    }
    if n.kind != P_K_TYPE {
        return "?";
    }
    // A parametric cap usage is `Name;deadline…`; a qualified name resolves by its last
    // segment.
    let name: str = tt_last_seg(tc_seg_at(n.text, 0));
    if tt_sc_is_tp(nodes, kids, fnid, defid, name) {
        return "?";
    }
    if tt_scalar_name(name) {
        return "i";
    }
    if name.bytes_eq("str") {
        return "s";
    }
    if name.bytes_eq("u256") {
        return "u";
    }
    if name.bytes_eq("i256") {
        return "u";
    }
    if name.bytes_eq("Vec") {
        return tt_desc_wrap("V", tt_targ(nodes, kids, tid, 0, fnid, defid, depth));
    }
    if name.bytes_eq("Arena") {
        return tt_desc_wrap("E", tt_targ(nodes, kids, tid, 0, fnid, defid, depth));
    }
    if name.bytes_eq("Option") {
        return tt_desc_wrap("O", tt_targ(nodes, kids, tid, 0, fnid, defid, depth));
    }
    if name.bytes_eq("Result") {
        return tt_desc_wrap("Q", tt_targ(nodes, kids, tid, 0, fnid, defid, depth));
    }
    if name.bytes_eq("Map") {
        return tt_desc_wrap("M", tt_targ(nodes, kids, tid, 1, fnid, defid, depth));
    }
    if name.bytes_eq("Slot") {
        return "T";
    }
    return tt_desc_wrap("N:", name);
}

// The descriptor of an expression's type (`?` when this shadow cannot tell): literals by
// kind, a local by its binding, a field chain through the record table, a call by its
// callee's return type, a method by the stdlib's signatures, a construct by its name.
fn tt_edesc(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, binds: Vec<TtBind>, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>) -> str ! { Alloc } {
    let n: PNode = nodes.get(nid);
    if n.kind == P_K_LIT_INT {
        return "i";
    }
    if n.kind == P_K_LIT_BOOL {
        return "i";
    }
    if n.kind == P_K_LIT_FLOAT {
        return "i";
    }
    if n.kind == P_K_LIT_STR {
        return "s";
    }
    if n.kind == P_K_FSTRING {
        return "s";
    }
    if n.kind == P_K_PATH {
        return tt_path_desc(nodes, kids, nid, binds, sigs, sidx);
    }
    if n.kind == P_K_BINARY {
        // A comparison is a Bool; arithmetic has its operands' type (u256 arithmetic is a
        // fresh 32-byte cell, production's `Type::U256`).
        if tc_binop_is_compare(n.value) {
            return "i";
        }
        let l: str = tt_edesc(nodes, kids, kids.get(n.child_start), binds, sigs, sidx, externs);
        let r: str = tt_edesc(nodes, kids, kids.get(n.child_start + 1), binds, sigs, sidx, externs);
        if tt_desc_head(l) == TT_D_WIDE {
            return "u";
        }
        if tt_desc_head(r) == TT_D_WIDE {
            return "u";
        }
        if tt_desc_head(l) == TT_D_SCALAR {
            if tt_desc_head(r) == TT_D_SCALAR {
                return "i";
            }
        }
        return "?";
    }
    if n.kind == P_K_INDEX {
        return tt_desc_inner(tt_desc_deref(tt_edesc(nodes, kids, kids.get(n.child_start), binds, sigs, sidx, externs)));
    }
    if n.kind == P_K_SLICE {
        return tt_desc_wrap("A", tt_desc_inner(tt_desc_deref(tt_edesc(nodes, kids, kids.get(n.child_start), binds, sigs, sidx, externs))));
    }
    if n.kind == P_K_TRY {
        return tt_desc_inner(tt_edesc(nodes, kids, kids.get(n.child_start), binds, sigs, sidx, externs));
    }
    if n.kind == P_K_BORROW {
        return tt_desc_wrap("&", tt_edesc(nodes, kids, kids.get(n.child_start), binds, sigs, sidx, externs));
    }
    if n.kind == P_K_DECLASSIFY {
        return tt_edesc(nodes, kids, kids.get(n.child_start), binds, sigs, sidx, externs);
    }
    if n.kind == P_K_DECLASSIFY_CT {
        return tt_edesc(nodes, kids, kids.get(n.child_start), binds, sigs, sidx, externs);
    }
    if n.kind == P_K_RESULT_CTOR {
        if n.flags == 1 {
            return tt_desc_wrap("Q", tt_edesc(nodes, kids, kids.get(n.child_start), binds, sigs, sidx, externs));
        }
        return "Q?";
    }
    if n.kind == P_K_ARRAY {
        if n.child_count > 0 {
            return tt_desc_wrap("A", tt_edesc(nodes, kids, kids.get(n.child_start), binds, sigs, sidx, externs));
        }
        return "A?";
    }
    if n.kind == P_K_RECORD_CONSTRUCT {
        return tt_desc_wrap("N:", tc_seg_at(n.text, 0));
    }
    if n.kind == P_K_CALL {
        return tt_call_desc(nodes, kids, nid, binds, sigs, sidx, externs);
    }
    if n.kind == P_K_METHOD {
        return tt_method_desc(nodes, kids, nid, binds, sigs, sidx, externs);
    }
    // A tuple, a closure, a capability operation or mint, a spawned actor: heap-resident and
    // opaque.
    let mut opaque: bool = false;
    if n.kind == P_K_TUPLE {
        opaque = true;
    }
    if n.kind == P_K_CLOSURE {
        opaque = true;
    }
    if n.kind == P_K_CAP_RESTRICT {
        opaque = true;
    }
    if n.kind == P_K_CAP_RESTRICT_DEADLINE {
        opaque = true;
    }
    if n.kind == P_K_CAP_SPLIT {
        opaque = true;
    }
    if n.kind == P_K_CAP_DRAW {
        opaque = true;
    }
    if n.kind == P_K_MINT {
        opaque = true;
    }
    if n.kind == P_K_SPAWN {
        opaque = true;
    }
    if opaque {
        return "T";
    }
    return "?";
}

// A path: a local's binding; a field chain `r::a::b` on a local through the record table; a
// unit enum variant `E::A`; a const by its name (`Mod::C` by its last segment); `None`.
fn tt_path_desc(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, binds: Vec<TtBind>, sigs: Vec<TtSig>, sidx: TtIdx) -> str ! { Alloc } {
    let n: PNode = nodes.get(nid);
    if tt_path_has_sep(n.text) {
        let base: str = tt_path_seg(n.text, 0);
        let b: TtBind = tt_env_bind(binds, base);
        if b.taint >= 0 {
            let mut d: str = b.tdesc;
            let mut k: i64 = 1;
            let mut seg: str = tt_path_seg(n.text, k);
            while seg.len() > 0 {
                d = tt_desc_field(d, seg, sigs, sidx);
                k = k + 1;
                seg = tt_path_seg(n.text, k);
            }
            return d;
        }
        if tt_tab_find(sigs, sidx, TT_SK_ENUM, base) >= 0 {
            return tt_desc_wrap("N:", base);
        }
        return tt_tab_desc(sigs, sidx, TT_SK_CONST, tt_last_seg(n.text));
    }
    let b2: TtBind = tt_env_bind(binds, n.text);
    if b2.taint >= 0 {
        return b2.tdesc;
    }
    if n.text.bytes_eq("None") {
        return "O?";
    }
    return tt_tab_desc(sigs, sidx, TT_SK_CONST, n.text);
}

// The call intrinsics whose result is a wasm local (`alloc` a pointer, `load8` a byte, the
// stores and traps unit, the constant-time ops and `u256_limb` an int).
fn tt_intrinsic_scalar(name: str) -> bool {
    if name.bytes_eq("alloc") {
        return true;
    }
    if name.bytes_eq("load8") {
        return true;
    }
    if name.bytes_eq("store8") {
        return true;
    }
    if name.bytes_eq("ct_eq") {
        return true;
    }
    if name.bytes_eq("ct_lt") {
        return true;
    }
    if name.bytes_eq("ct_select") {
        return true;
    }
    if name.bytes_eq("u256_limb") {
        return true;
    }
    if name.bytes_eq("trap") {
        return true;
    }
    if name.bytes_eq("trap_if") {
        return true;
    }
    if name.bytes_eq("slot_put") {
        return true;
    }
    if name.bytes_eq("vec_store") {
        return true;
    }
    return false;
}

// Every call the type checker lowers to an intrinsic (production's `TypedExprKind::Intrinsic`
// through a call). SHP-5c-2: the stdlib-private vector intrinsics too — user code cannot
// name them, but the stdlib's own method bodies are scanned for their summaries, where a
// `vec_load` is a raw read and a `vec_store` a raw write (the vec quarantine's allowlist
// names this file for that: it classifies the names, it never calls them).
fn tt_is_intrinsic_call(name: str) -> bool {
    if tt_intrinsic_scalar(name) {
        return true;
    }
    if name.bytes_eq("vec_load") {
        return true;
    }
    if name.bytes_eq("str_from_raw") {
        return true;
    }
    if name.bytes_eq("u256_from_i64") {
        return true;
    }
    if name.bytes_eq("u256_make") {
        return true;
    }
    if name.bytes_eq("slot_new") {
        return true;
    }
    if name.bytes_eq("slot_take") {
        return true;
    }
    return false;
}

// A call's result type: an intrinsic's fixed type, `Some`, an extern's or fn's declared
// return, a static method `Type::m`, a variant constructor `E::V(…)`, a stdlib constructor
// (`Vec::new()` and kin, whose element comes from the let's annotation), `Mod::f` by its name.
fn tt_call_desc(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, binds: Vec<TtBind>, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>) -> str ! { Alloc } {
    let n: PNode = nodes.get(nid);
    let name: str = tc_seg_at(n.text, 0);
    if tt_intrinsic_scalar(name) {
        return "i";
    }
    if name.bytes_eq("str_from_raw") {
        return "s";
    }
    if name.bytes_eq("u256_from_i64") {
        return "u";
    }
    if name.bytes_eq("u256_make") {
        return "u";
    }
    if name.bytes_eq("slot_new") {
        return "T";
    }
    if name.bytes_eq("slot_take") {
        return "T";
    }
    if name.bytes_eq("Some") {
        if n.child_count >= 1 {
            return tt_desc_wrap("O", tt_edesc(nodes, kids, kids.get(n.child_start), binds, sigs, sidx, externs));
        }
        return "O?";
    }
    if tt_name_in(externs, name) {
        return tt_tab_desc(sigs, sidx, TT_SK_EXTERN, name);
    }
    let fi: i64 = tt_tab_find(sigs, sidx, TT_SK_FN, name);
    if fi >= 0 {
        let fs: TtSig = sigs.get(fi);
        return fs.tdesc;
    }
    let c: i64 = tc_last_colons(name);
    if c >= 0 {
        let tname: str = name.substr(0, c);
        let mname: str = name.substr(c + 2, name.len());
        if tname.bytes_eq("Vec") {
            return "V?";
        }
        if tname.bytes_eq("Arena") {
            return "E?";
        }
        if tname.bytes_eq("Map") {
            return "M?";
        }
        let j: str = tname.concat(";");
        let mi: i64 = tt_tab_find(sigs, sidx, TT_SK_METHOD, j.concat(mname));
        if mi >= 0 {
            let ms: TtSig = sigs.get(mi);
            return ms.tdesc;
        }
        if tt_tab_find(sigs, sidx, TT_SK_ENUM, tname) >= 0 {
            return tt_desc_wrap("N:", tname);
        }
        return tt_tab_desc(sigs, sidx, TT_SK_FN, mname);
    }
    return "?";
}

// The stdlib and intrinsic methods whose result is a wasm local (lengths, counts, flags,
// bytes, hashes, conversions and the mutators' unit-like results).
fn tt_method_scalar(name: str) -> bool {
    if name.bytes_eq("len") {
        return true;
    }
    if name.bytes_eq("capacity") {
        return true;
    }
    if name.bytes_eq("is_empty") {
        return true;
    }
    if name.bytes_eq("as_output") {
        return true;
    }
    if name.bytes_eq("byte_at") {
        return true;
    }
    if name.bytes_eq("push") {
        return true;
    }
    if name.bytes_eq("set") {
        return true;
    }
    if name.bytes_eq("insert") {
        return true;
    }
    if name.bytes_eq("allocate") {
        return true;
    }
    if name.bytes_eq("contains") {
        return true;
    }
    if name.bytes_eq("bytes_eq") {
        return true;
    }
    if name.bytes_eq("starts_with") {
        return true;
    }
    if name.bytes_eq("ends_with") {
        return true;
    }
    if name.bytes_eq("is_char_boundary") {
        return true;
    }
    if name.bytes_eq("eq_ignore_case") {
        return true;
    }
    if name.bytes_eq("hash") {
        return true;
    }
    if name.bytes_eq("eq") {
        return true;
    }
    if name.bytes_eq("valid_up_to") {
        return true;
    }
    if name.bytes_eq("is_some") {
        return true;
    }
    if name.bytes_eq("is_none") {
        return true;
    }
    if name.bytes_eq("sum") {
        return true;
    }
    if name.bytes_eq("fold") {
        return true;
    }
    if name.bytes_eq("any") {
        return true;
    }
    if name.bytes_eq("all") {
        return true;
    }
    if name.bytes_eq("as_i32") {
        return true;
    }
    if name.bytes_eq("as_u32") {
        return true;
    }
    if name.bytes_eq("as_i64") {
        return true;
    }
    if name.bytes_eq("as_u64") {
        return true;
    }
    return false;
}

// The stdlib and intrinsic methods whose result is a `str`.
fn tt_method_str(name: str) -> bool {
    if name.bytes_eq("concat") {
        return true;
    }
    if name.bytes_eq("join") {
        return true;
    }
    if name.bytes_eq("trim") {
        return true;
    }
    if name.bytes_eq("substr") {
        return true;
    }
    if name.bytes_eq("itoa") {
        return true;
    }
    return false;
}

// A method call's result type. A user type's method is the impl table's entry; the stdlib's
// methods are typed by name from their declared signatures (stdlib/sigil/{vec,arena,map,
// option,result,strings,string,traits}.sigil and the str, array and int intrinsics), with
// the receiver's element or payload where a signature returns `T`.
fn tt_method_desc(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, binds: Vec<TtBind>, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>) -> str ! { Alloc } {
    let n: PNode = nodes.get(nid);
    let name: str = n.text;
    // SHP-5c-2: a receiver path that names an enum (a variant construction), a module (its
    // function) or a declared type (an associated function) rather than a value.
    let rid0: i64 = kids.get(n.child_start);
    let rn0: PNode = nodes.get(rid0);
    if rn0.kind == P_K_PATH {
        if !tt_path_has_sep(rn0.text) {
            let rb0: TtBind = tt_env_bind(binds, rn0.text);
            if rb0.taint < 0 {
                if tt_tab_find(sigs, sidx, TT_SK_ENUM, rn0.text) >= 0 {
                    return tt_desc_wrap("N:", rn0.text);
                }
                if tt_tab_find(sigs, sidx, TT_SK_MODULE, rn0.text) >= 0 {
                    return tt_tab_desc(sigs, sidx, TT_SK_FN, name);
                }
                let aj0: str = rn0.text.concat(";");
                let ad0: i64 = tt_tab_find(sigs, sidx, TT_SK_METHOD, aj0.concat(name));
                if ad0 >= 0 {
                    let asg0: TtSig = sigs.get(ad0);
                    return asg0.tdesc;
                }
            }
        }
    }
    let recv: str = tt_desc_deref(tt_edesc(nodes, kids, rid0, binds, sigs, sidx, externs));
    let h: i64 = tt_desc_head(recv);
    if h == TT_D_UNKNOWN {
        return "?";
    }
    if h == TT_D_NOMINAL {
        let nm: str = tt_desc_nominal(recv);
        let j: str = nm.concat(";");
        return tt_tab_desc(sigs, sidx, TT_SK_METHOD, j.concat(name));
    }
    if tt_method_scalar(name) {
        return "i";
    }
    if tt_method_str(name) {
        return "s";
    }
    if name.bytes_eq("from_bytes") {
        return "Os";
    }
    if name.bytes_eq("find") {
        return "Oi";
    }
    if name.bytes_eq("parse_i64") {
        return "Oi";
    }
    if name.bytes_eq("parse_u64") {
        return "Oi";
    }
    if name.bytes_eq("parse_i32") {
        return "Oi";
    }
    if name.bytes_eq("parse_u32") {
        return "Oi";
    }
    if name.bytes_eq("split_on") {
        return "Vs";
    }
    if name.bytes_eq("split_first") {
        return "OT";
    }
    if name.bytes_eq("ok_or") {
        return tt_desc_wrap("Q", tt_desc_inner(recv));
    }
    if name.bytes_eq("get") {
        if h == TT_D_MAP {
            return tt_desc_wrap("O", tt_desc_inner(recv));
        }
        if h == TT_D_VEC {
            return tt_desc_inner(recv);
        }
        if h == TT_D_ARENA {
            return tt_desc_inner(recv);
        }
        return "?";
    }
    if name.bytes_eq("get_or") {
        return tt_desc_inner(recv);
    }
    if name.bytes_eq("unwrap_or") {
        return tt_desc_inner(recv);
    }
    if name.bytes_eq("unwrap_or_else") {
        return tt_desc_inner(recv);
    }
    if name.bytes_eq("first") {
        if h == TT_D_ARRAY {
            return tt_desc_wrap("O", tt_desc_inner(recv));
        }
        return "?";
    }
    if name.bytes_eq("last") {
        if h == TT_D_ARRAY {
            return tt_desc_wrap("O", tt_desc_inner(recv));
        }
        return "?";
    }
    return "?";
}

// Production's `reads_typed_memory` over a parse node: 1 the expression reads bytes of a live
// typed value out of linear memory (an element, field or slice projection, a `?`, any
// intrinsic — a call or a method the type checker lowers to one — a heap-typed local, a
// `str` literal or an f-string), 0 it computes on locals or materialises a fresh cell, -1
// unknown.
fn tt_reads_typed(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, binds: Vec<TtBind>, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(nid);
    if n.kind == P_K_INDEX {
        return 1;
    }
    if n.kind == P_K_SLICE {
        return 1;
    }
    if n.kind == P_K_TRY {
        return 1;
    }
    if n.kind == P_K_LIT_STR {
        return 1;
    }
    if n.kind == P_K_FSTRING {
        return 1;
    }
    if n.kind == P_K_PATH {
        if tt_path_has_sep(n.text) {
            let base: str = tt_path_seg(n.text, 0);
            let b: TtBind = tt_env_bind(binds, base);
            if b.taint >= 0 {
                return 1;
            }
            if tt_tab_find(sigs, sidx, TT_SK_ENUM, base) >= 0 {
                return 0;
            }
            return tt_desc_reads(tt_tab_desc(sigs, sidx, TT_SK_CONST, tt_last_seg(n.text)));
        }
        let b2: TtBind = tt_env_bind(binds, n.text);
        if b2.taint >= 0 {
            return tt_desc_heap(b2.tdesc);
        }
        if n.text.bytes_eq("None") {
            return 0;
        }
        return tt_desc_reads(tt_tab_desc(sigs, sidx, TT_SK_CONST, n.text));
    }
    if n.kind == P_K_CALL {
        if tt_is_intrinsic_call(tc_seg_at(n.text, 0)) {
            return 1;
        }
        return 0;
    }
    if n.kind == P_K_METHOD {
        return tt_method_reads(nodes, kids, nid, binds, sigs, sidx, externs);
    }
    return 0;
}

// A const's read: production inlines a const as its literal, so a `str` const is a
// static-data read (S11) and a scalar const is not; an unknown const is unknown.
fn tt_desc_reads(d: str) -> i64 {
    let h: i64 = tt_desc_head(d);
    if h == TT_D_STR {
        return 1;
    }
    if h == TT_D_SCALAR {
        return 0;
    }
    return 0 - 1;
}

// The methods the type checker lowers to intrinsics, by receiver shape (methods.rs): `len`
// and `is_empty` on a str, an array or a slice; `as_output`, `byte_at` and `substr` on a
// str; `first`, `last` and `contains` on an array or a slice (a slice of `str` routes
// `contains` to the stdlib); the `as_*` conversions on a machine int. The same names on a
// Vec, a Map or a user type are calls.
fn tt_method_reads(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, binds: Vec<TtBind>, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(nid);
    let name: str = n.text;
    let mut want: i64 = 0;
    if name.bytes_eq("len") {
        want = 1;
    }
    if name.bytes_eq("is_empty") {
        want = 1;
    }
    if name.bytes_eq("as_output") {
        want = 2;
    }
    if name.bytes_eq("byte_at") {
        want = 2;
    }
    if name.bytes_eq("substr") {
        want = 2;
    }
    if name.bytes_eq("first") {
        want = 3;
    }
    if name.bytes_eq("last") {
        want = 3;
    }
    if name.bytes_eq("contains") {
        want = 4;
    }
    if name.bytes_eq("as_i32") {
        want = 5;
    }
    if name.bytes_eq("as_u32") {
        want = 5;
    }
    if name.bytes_eq("as_i64") {
        want = 5;
    }
    if name.bytes_eq("as_u64") {
        want = 5;
    }
    if want == 0 {
        return 0;
    }
    let recv: str = tt_desc_deref(tt_edesc(nodes, kids, kids.get(n.child_start), binds, sigs, sidx, externs));
    let h: i64 = tt_desc_head(recv);
    if h == TT_D_UNKNOWN {
        return 0 - 1;
    }
    if want == 1 {
        if h == TT_D_STR {
            return 1;
        }
        if h == TT_D_ARRAY {
            return 1;
        }
        return 0;
    }
    if want == 2 {
        if h == TT_D_STR {
            return 1;
        }
        return 0;
    }
    if want == 3 {
        if h == TT_D_ARRAY {
            return 1;
        }
        return 0;
    }
    if want == 4 {
        if h == TT_D_ARRAY {
            let eh: i64 = tt_desc_head(tt_desc_inner(recv));
            if eh == TT_D_STR {
                return 0;
            }
            if eh == TT_D_UNKNOWN {
                return 0 - 1;
            }
            return 1;
        }
        return 0;
    }
    if h == TT_D_SCALAR {
        return 1;
    }
    return 0;
}

// The descriptor of the current binding of `name`, `?` when unbound.
fn tt_env_desc(binds: Vec<TtBind>, name: str) -> str ! { Alloc } {
    let b: TtBind = tt_env_bind(binds, name);
    return b.tdesc;
}

// ── The floors: production's `HeapFloors`, [raw_load, typed_read], one pair per function,
// monotone (only `tt_fl_raise` writes them, upward) and path-insensitive: like `rtm` the
// pair is shared by every branch, arm and loop pass, so a floor one branch raises is raised
// for the rest of the function. Each note names its production twin.
fn tt_fl_raise(fl: Vec<i64> @Mut, raw: i64, typed: i64) -> i64 {
    let q0: i64 = fl.set(0, tt_lub(fl.get(0), raw));
    let q1: i64 = fl.set(1, tt_lub(fl.get(1), typed));
    return 0;
}

// Are the floors still at a snapshot (a loop pass that raised one did not converge)?
fn tt_fl_same(fl: Vec<i64>, raw: i64, typed: i64) -> bool {
    if fl.get(0) != raw {
        return false;
    }
    if fl.get(1) != typed {
        return false;
    }
    return true;
}

// S2 (`note_memory_write`): a non-public value — its label already joined with the
// effective pc — was written into linear memory; every later raw load may return it.
fn tt_fl_note_write(fl: Vec<i64> @Mut, written: i64) -> i64 {
    if written > TT_PUBLIC {
        let q: i64 = tt_fl_raise(fl, written, TT_PUBLIC);
    }
    return 0;
}

// S6/S7 (`note_secret_address_write`, `note_typed_place_write`): a write through a projected
// place, or at a non-public address — the memory image is the observation, so typed reads
// are floored too.
fn tt_fl_note_typed_write(fl: Vec<i64> @Mut, written: i64) -> i64 {
    if written > TT_PUBLIC {
        let q: i64 = tt_fl_raise(fl, written, written);
    }
    return 0;
}

// S4 (`note_raw_store`): a raw store at an unchecked address may sit inside a live typed
// aggregate, so typed reads are floored as well as raw loads.
fn tt_fl_note_raw_store(fl: Vec<i64> @Mut, written: i64) -> i64 {
    let q1: i64 = tt_fl_note_write(fl, written);
    let q2: i64 = tt_fl_note_typed_write(fl, written);
    return 0;
}

// S1 (`note_ffi_boundary`): the host wrote guest memory at the bump pointer; everything a
// raw load returns is @Internal at best.
fn tt_fl_note_ffi(fl: Vec<i64> @Mut) -> i64 {
    return tt_fl_raise(fl, TT_INTERNAL, TT_PUBLIC);
}

// Forward the refusals a discarded sink collected: production evaluates an assignment
// place's indices and a loop guard's fixpoint passes into a throwaway sink, but a shape
// this shadow cannot type must still refuse.
fn tt_forward_refusals(diags: Vec<str> @Mut, sink: Vec<str>) -> i64 ! { Alloc } {
    let n: i64 = sink.len();
    let mut i: i64 = 0;
    while i < n {
        let d: str = sink.get(i);
        if d.bytes_eq("SH_TAINT_UNSUPPORTED;") {
            let p: i64 = diags.push(d);
        }
        i = i + 1;
    }
    return 0;
}

// Production's choke point (`compute_expr_taint`): every expression passes here once, with
// `t0` = its base label joined with the effective pc. S4 — a read of typed memory joins the
// typed-read floor. S2 — a heap-resident value that is not a plain read of a local (whose
// bytes were noted when it was bound) is bytes in linear memory a later raw load can reach,
// so its label raises the raw-load floor. Both are keyed on types this shadow recovers
// syntactically (the banner above): an unknown shape refuses when the label at stake is not
// @Public and is inert when it is.
fn tt_floor_expr(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, binds: Vec<TtBind>, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>, t0: i64, fl: Vec<i64> @Mut, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(nid);
    let mut t: i64 = t0;
    if fl.get(1) > TT_PUBLIC {
        let rt: i64 = tt_reads_typed(nodes, kids, nid, binds, sigs, sidx, externs);
        if rt > 0 {
            t = tt_lub(t, fl.get(1));
        }
        if rt < 0 {
            let ur: i64 = tt_mark_unsupported(diags);
        }
    }
    if t > TT_PUBLIC {
        let mut plain_local: bool = false;
        if n.kind == P_K_PATH {
            if !tt_path_has_sep(n.text) {
                let b: TtBind = tt_env_bind(binds, n.text);
                if b.taint >= 0 {
                    plain_local = true;
                }
            }
        }
        if !plain_local {
            let h: i64 = tt_desc_heap(tt_edesc(nodes, kids, nid, binds, sigs, sidx, externs));
            if h > 0 {
                let qw: i64 = tt_fl_note_write(fl, t);
            }
            if h < 0 {
                let uh: i64 = tt_mark_unsupported(diags);
            }
        }
    }
    return t;
}

// S1 for a user type's method `x.m(…)`: the impl table's entry says whether its row names
// FFI (production routes the call to `Type::m` and asks `callee_has_ffi`). The stdlib's
// methods never do (a builtin shape has no impl entry).
fn tt_method_ffi(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, binds: Vec<TtBind>, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>, fl: Vec<i64> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(nid);
    let nm: str = tt_desc_nominal(tt_edesc(nodes, kids, kids.get(n.child_start), binds, sigs, sidx, externs));
    if nm.len() == 0 {
        return 0;
    }
    let j: str = nm.concat(";");
    let mi: i64 = tt_tab_find(sigs, sidx, TT_SK_METHOD, j.concat(n.text));
    if mi >= 0 {
        let ms: TtSig = sigs.get(mi);
        if ms.ffi {
            let q: i64 = tt_fl_note_ffi(fl);
        }
    }
    return 0;
}

// S1 for a static call `Type::m(…)` with no fn entry: the impl table's row fact.
fn tt_static_ffi(sigs: Vec<TtSig>, sidx: TtIdx, name: str, fl: Vec<i64> @Mut) -> i64 ! { Alloc } {
    let c: i64 = tc_last_colons(name);
    if c < 0 {
        return 0;
    }
    let tname: str = name.substr(0, c);
    let j: str = tname.concat(";");
    let mi: i64 = tt_tab_find(sigs, sidx, TT_SK_METHOD, j.concat(name.substr(c + 2, name.len())));
    if mi >= 0 {
        let ms: TtSig = sigs.get(mi);
        if ms.ffi {
            let q: i64 = tt_fl_note_ffi(fl);
        }
    }
    return 0;
}

// SHP-5c-1: the amount of a `split` or `draw` is observable by the host (the call, the trap,
// the child's fuel): @SecretCT is T027, any other non-public label T001; the new capability
// is authority, not data — @Public (production's CapSplit / CapDraw arms).
fn tt_cap_amount(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, binds: Vec<TtBind>, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>, pc: i64, rtm: Vec<i64> @Mut, fl: Vec<i64> @Mut, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let amt: i64 = tt_child0(nodes, kids, nid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
    if tt_is_ct(amt) {
        let d: i64 = diags.push("T027;");
    } else {
        if amt > TT_PUBLIC {
            let d2: i64 = diags.push("T001;");
        }
    }
    return TT_PUBLIC;
}

// S6: the address taint of a projected place (production's `place_address_taint`): the join
// of the index expressions along the place, @Public for a bare field chain. The indices are
// evaluated for their effect on the floors and regions with their diagnostics discarded, as
// production does; a refusal raised there still surfaces.
fn tt_place_addr(nodes: Arena<PNode>, kids: Vec<i64>, pid: i64, binds: Vec<TtBind>, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>, pc: i64, rtm: Vec<i64> @Mut, fl: Vec<i64> @Mut, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let pn: PNode = nodes.get(pid);
    if pn.kind == P_K_INDEX {
        let base: i64 = tt_place_addr(nodes, kids, kids.get(pn.child_start), binds, sigs, sidx, externs, pc, rtm, fl, diags);
        let mut sink: Vec<str> = Vec::new();
        let it: i64 = tt_expr(nodes, kids, kids.get(pn.child_start + 1), binds, sigs, sidx, externs, pc, rtm, fl, sink);
        let qf: i64 = tt_forward_refusals(diags, sink);
        return tt_lub(base, it);
    }
    return TT_PUBLIC;
}

// A write through a projected place (`r.f = v`, `a[i] = v`) lands in linear memory: S2 notes
// the value, S7 floors typed reads (a typed read through any alias reads it back), and S6
// floors both by the place's address taint (which cell changed is an observation of its own).
// `eff` is the value's label joined with the effective pc.
fn tt_fl_note_place_write(nodes: Arena<PNode>, kids: Vec<i64>, pid: i64, eff: i64, binds: Vec<TtBind>, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>, pc: i64, rtm: Vec<i64> @Mut, fl: Vec<i64> @Mut, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let q1: i64 = tt_fl_note_write(fl, eff);
    let q2: i64 = tt_fl_note_typed_write(fl, eff);
    let addr: i64 = tt_place_addr(nodes, kids, pid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
    let q3: i64 = tt_fl_note_typed_write(fl, tt_lub(addr, pc));
    return 0;
}

// ────────────────────────────────────────────────────────────────────────────
// The expression-taint walk (the oracle's compute_expr_taint). Returns
// base(kind) lub pc, emitting CT codes (T024/T025/T026/T027/T029/T031/T032 +
// the filtered T028) at the point of detection. `pc` is threaded BY VALUE (never
// holds SecretCT — control flow rejects it before descent, ET-T10). SHP-5c-1: the
// result passes the heap-floor choke point (`tt_floor_expr`) exactly once, here.
// ────────────────────────────────────────────────────────────────────────────
fn tt_expr(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, binds: Vec<TtBind>, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>, pc: i64, rtm: Vec<i64> @Mut, fl: Vec<i64> @Mut, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(nid);
    let mut base: i64 = TT_PUBLIC;

    if n.kind == P_K_LIT_INT {
        base = TT_PUBLIC;
    } else {
        if n.kind == P_K_LIT_BOOL {
            base = TT_PUBLIC;
        } else {
            if n.kind == P_K_LIT_FLOAT {
                base = TT_PUBLIC;
            } else {
                if n.kind == P_K_LIT_STR {
                    base = TT_PUBLIC;
                } else {
                    if n.kind == P_K_PATH {
                        // A dotted path "r::a" (parser normalizes `r.a`) is a field
                        // access on a local (PR-T2): base = seg0, innermost field = seg1
                        // -> per-field lookup. A bare local -> scalar lookup. A qualified
                        // global path (`Mod::CONST`) has no bound base -> Public (matching
                        // the oracle, whose const/variant path taint is Public).
                        if tt_path_has_sep(n.text) {
                            let pbase: str = tt_path_seg(n.text, 0);
                            let pfield: str = tt_path_seg(n.text, 1);
                            base = tt_lookup_field(binds, pbase, pfield);
                        } else {
                            base = tt_read(binds, rtm, n.text);
                        }
                    } else {
                        if n.kind == P_K_BINARY {
                            let lid: i64 = kids.get(n.child_start);
                            let rid: i64 = kids.get(n.child_start + 1);
                            let l: i64 = tt_expr(nodes, kids, lid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
                            let r: i64 = tt_expr(nodes, kids, rid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
                            // T026 — variable-time division: a `/` (T_SLASH=22) with a
                            // @SecretCT operand.
                            if n.value == 22 {
                                if tt_is_ct(l) {
                                    let d: i64 = diags.push("T026;");
                                } else {
                                    if tt_is_ct(r) {
                                        let d2: i64 = diags.push("T026;");
                                    } else {
                                    }
                                }
                            } else {
                            }
                            base = tt_lub(l, r);
                        } else {
                            if n.kind == P_K_INDEX {
                                let aid: i64 = kids.get(n.child_start);
                                let iid: i64 = kids.get(n.child_start + 1);
                                let arr: i64 = tt_expr(nodes, kids, aid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
                                let idx: i64 = tt_expr(nodes, kids, iid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
                                // T024 — secret-dependent index.
                                if tt_is_ct(idx) {
                                    let d: i64 = diags.push("T024;");
                                } else {
                                }
                                base = tt_lub(arr, idx);
                            } else {
                                if n.kind == P_K_CALL {
                                    base = tt_call(nodes, kids, nid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
                                } else {
                                    if n.kind == P_K_DECLASSIFY {
                                        // T031 — declassify rejects a @SecretCT input.
                                        let vid: i64 = kids.get(n.child_start);
                                        let v: i64 = tt_expr(nodes, kids, vid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
                                        // descend the cap child too (side-effect taint, ET-T6).
                                        if n.child_count >= 2 {
                                            let cid2: i64 = kids.get(n.child_start + 1);
                                            let cc: i64 = tt_expr(nodes, kids, cid2, binds, sigs, sidx, externs, pc, rtm, fl, diags);
                                        } else {
                                        }
                                        if tt_is_ct(v) {
                                            let d: i64 = diags.push("T031;");
                                        } else {
                                        }
                                        base = TT_PUBLIC;
                                    } else {
                                        if n.kind == P_K_DECLASSIFY_CT {
                                            // T032 — declassify_ct REQUIRES a @SecretCT input.
                                            let vid: i64 = kids.get(n.child_start);
                                            let v: i64 = tt_expr(nodes, kids, vid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
                                            if n.child_count >= 2 {
                                                let cid3: i64 = kids.get(n.child_start + 1);
                                                let cc3: i64 = tt_expr(nodes, kids, cid3, binds, sigs, sidx, externs, pc, rtm, fl, diags);
                                            } else {
                                            }
                                            if tt_is_ct(v) {
                                            } else {
                                                let d: i64 = diags.push("T032;");
                                            }
                                            base = TT_SECRET;
                                        } else {
                                            if n.kind == P_K_REGION {
                                                // T029 — secret-dependent region size (child0 = limit).
                                                let lid2: i64 = kids.get(n.child_start);
                                                let lim: i64 = tt_expr(nodes, kids, lid2, binds, sigs, sidx, externs, pc, rtm, fl, diags);
                                                if tt_is_ct(lim) {
                                                    let d: i64 = diags.push("T029;");
                                                } else {
                                                }
                                                // Region bodies are not part of the curated shadow.
                                                // Keep the supported limit diagnostic, but make the
                                                // incomplete body verdict fail closed in composed use.
                                                let ur: i64 = tt_mark_unsupported(diags);
                                                base = TT_PUBLIC;
                                            } else {
                                                base = tt_expr_rest(nodes, kids, nid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return tt_floor_expr(nodes, kids, nid, binds, sigs, sidx, externs, tt_lub(base, pc), fl, diags);
}

// The remaining (lub-of-children / propagation) expr kinds, split out to keep the
// if/else nesting under control. Every arm returns a BASE (pc is folded by the caller
// tt_expr's final lub). A genuinely-unmapped kind returns TT_PUBLIC (subset-safe: never
// a false code; any consequential miss surfaces as a differential mismatch — ET-T1).
fn tt_expr_rest(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, binds: Vec<TtBind>, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>, pc: i64, rtm: Vec<i64> @Mut, fl: Vec<i64> @Mut, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(nid);
    if n.kind == P_K_METHOD {
        // The receiver and the arguments in order (production evaluates a lowered method's
        // arguments as a call's, the receiver first), then the callee production lowers the
        // call to (`tt_sm_resolve_method`, SHP-5c-2). An intrinsic (.len()/.byte_at()/
        // .as_i32()/…) inherits lub(receiver, args) — none of the oracle's intrinsic-method
        // arms emit a CT code. A fn or impl-method row is a call: each argument against its
        // declared label (the receiver against `self`'s), S1 for a row naming FFI (SHP-5c-1,
        // after the arguments, as production orders it) and the row's summary at the site
        // (S5, S8). A receiver path naming a module or a type is not an argument. A callee
        // this shadow cannot name refuses while the summaries are live. While they are not
        // (an inert program: `tt_sm_build`), every value is @Public and the callee's identity
        // cannot change the verdict, so the SHP-5c-1 arm (lub of receiver and arguments, S1)
        // stands and the per-call resolution scans are skipped (measured: with them, the
        // compiler's own self-compile costs about four times its SHP-5c-1 fuel).
        if !tt_sm_live(sigs) {
            let mt0: i64 = tt_lub_children(nodes, kids, nid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
            let qm0: i64 = tt_method_ffi(nodes, kids, nid, binds, sigs, sidx, externs, fl);
            return mt0;
        }
        let r: i64 = tt_sm_resolve_method(nodes, kids, nid, binds, sigs, sidx, externs);
        let mut mfirst: i64 = 0;
        if r >= 0 {
            mfirst = r - (r / 2) * 2;
        }
        if r == tt_sm_ctor() {
            mfirst = 1;
        }
        let mut margs: Vec<i64> = Vec::new();
        let mut mlub: i64 = TT_PUBLIC;
        let mut mi: i64 = mfirst;
        while mi < n.child_count {
            let mcid: i64 = kids.get(n.child_start + mi);
            let mt: i64 = tt_expr(nodes, kids, mcid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
            let mp: i64 = margs.push(mt);
            mlub = tt_lub(mlub, mt);
            mi = mi + 1;
        }
        if r >= 0 {
            let mrow: i64 = r / 2;
            let msg: TtSig = sigs.get(mrow);
            if msg.ffi {
                let qmf: i64 = tt_fl_note_ffi(fl);
            }
            let qca: i64 = tt_check_args(msg, margs, diags);
            let mrf: i64 = tt_sm_site(nodes, kids, nid, mfirst, mrow, mlub, binds, sigs, sidx, pc, rtm, fl, diags);
            return tt_lub(tt_lub(msg.ret_taint, mlub), mrf);
        }
        if r == tt_sm_unknown() {
            let um: i64 = tt_mark_unsupported(diags);
        }
        return mlub;
    } else {
    }
    if n.kind == P_K_BORROW {
        return tt_child0(nodes, kids, nid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
    } else {
    }
    if n.kind == P_K_TRY {
        return tt_child0(nodes, kids, nid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
    } else {
    }
    if n.kind == P_K_RESULT_CTOR {
        return tt_lub_children(nodes, kids, nid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
    } else {
    }
    if n.kind == P_K_ARRAY {
        return tt_lub_children(nodes, kids, nid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
    } else {
    }
    if n.kind == P_K_TUPLE {
        return tt_lub_children(nodes, kids, nid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
    } else {
    }
    if n.kind == P_K_SLICE {
        // lub(array, start?, end?) — no CT-rejection (a slice is not an index sink).
        return tt_lub_children(nodes, kids, nid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
    } else {
    }
    if n.kind == P_K_RECORD_CONSTRUCT {
        // PR-T1: a record value collapses to the lub of its fields (per-field tracking
        // is PR-T2).
        return tt_lub_children(nodes, kids, nid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
    } else {
    }
    if n.kind == P_K_FSTRING {
        return tt_lub_children(nodes, kids, nid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
    } else {
    }
    if n.kind == P_K_GRANT {
        // S9: a grant invokes its body here. A closure literal body is the closure arm's
        // (refused there); any other body — a local holding a closure — names no callee, and
        // production takes its program-wide bound at the site, which this shadow does not
        // apply: refused while the summaries are live (a grant child count other than two
        // refuses too, fail closed).
        let gt: i64 = tt_lub_children(nodes, kids, nid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
        if tt_sm_live(sigs) {
            let mut gnamed: bool = false;
            if n.child_count == 2 {
                let gbn: PNode = nodes.get(kids.get(n.child_start + 1));
                if gbn.kind == P_K_CLOSURE {
                    gnamed = true;
                }
            }
            if !gnamed {
                let ug: i64 = tt_mark_unsupported(diags);
            }
        }
        return gt;
    } else {
    }
    if n.kind == P_K_SEND {
        // T028 is DEMOTED (AG-T13, actor-only) — the arm exists for walk-totality and
        // is filtered out of CORE_T_CODES, so emitting it is harmless. base = lub(args).
        let any: i64 = tt_lub_children(nodes, kids, nid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
        if tt_is_ct(any) {
            let d: i64 = diags.push("T028;");
        } else {
        }
        return any;
    } else {
    }
    if n.kind == P_K_ASK {
        let any2: i64 = tt_lub_children(nodes, kids, nid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
        if tt_is_ct(any2) {
            let d: i64 = diags.push("T028;");
        } else {
        }
        return any2;
    } else {
    }
    if n.kind == P_K_CLOSURE {
        // E4 (PR-T2) — DESCEND the closure body with captures seeded (the inverse of
        // SH-RING's P_K_CLOSURE skip). Children = [param…, return-type?, body]; the body
        // is the LAST child (a P_K_BLOCK). The enclosing `binds` already carry every
        // captured free var at its source taint (ET-T12 append-only env), so copy them
        // into a fresh mutable env (the capture env, AG-T9), then seed the closure's OWN
        // params at their DECLARED taints (production lambda-lifting preserves them),
        // after captures so a same-named parameter shadows its capture. Walk as a FRESH function
        // context: pc resets to TT_PUBLIC and fnret = TT_PUBLIC. The closure surface
        // carries no return-taint annotation (the parser parses no taint after a closure
        // `-> type`), so the oracle's lifted closure fn is likewise Public — the
        // closure-return T001/T030 checks are FAITHFUL, not over-firing. Any in-body CT
        // code (T020-T029) on a captured @SecretCT value fires here — the E4 deliverable.
        // The closure EXPRESSION's own value-taint is under-approximated to PUBLIC (AG-T14,
        // the AG-G19 value-flow pattern): the oracle's closure value-taint = lub of
        // captures, so a SecretCT-capturing closure bound to an un-annotated `let` emits a
        // value-flow T001 — that downgrade-at-binding is OUT-of-core, subset-safe (a miss,
        // never a false code). In-core reject fixtures bind the closure to a taint-
        // absorbing let (`let g @SecretCT = …`) so the oracle emits ONLY the in-body code.
        // Capture-value taint is not represented precisely in this parse-tree shadow. Continue
        // producing the curated differential codes, but make standalone/pipeline use reject.
        let u: i64 = tt_mark_unsupported(diags);
        if n.child_count >= 1 {
            let bodyid: i64 = kids.get(n.child_start + n.child_count - 1);
            let bn: PNode = nodes.get(bodyid);
            if bn.kind == P_K_BLOCK {
                let mut cbinds: Vec<TtBind> = Vec::new();
                let cp: i64 = tt_copy_binds(binds, cbinds);
                let sp: i64 = tt_seed_params(nodes, kids, nid, cbinds, fl, diags);
                let mut cbrk: Vec<TtBind> = Vec::new();
                let mut ccnt: Vec<TtBind> = Vec::new();
                let mut cnames: Vec<str> = Vec::new();
                let rb: i64 = tt_block(nodes, kids, bodyid, cbinds, sigs, sidx, externs, TT_PUBLIC, TT_PUBLIC, TT_PUBLIC, cbrk, ccnt, cnames, 0, rtm, fl, diags);
            } else {
            }
        } else {
        }
        return TT_PUBLIC;
    } else {
    }
    if n.kind == P_K_CAP_RESTRICT {
        return TT_PUBLIC;
    } else {
    }
    if n.kind == P_K_CAP_RESTRICT_DEADLINE {
        return TT_PUBLIC;
    } else {
    }
    if n.kind == P_K_CAP_SPLIT {
        return tt_cap_amount(nodes, kids, nid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
    } else {
    }
    if n.kind == P_K_CAP_DRAW {
        return tt_cap_amount(nodes, kids, nid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
    } else {
    }
    if n.kind == P_K_MINT {
        return TT_PUBLIC;
    } else {
    }
    if n.kind == P_K_SPAWN {
        // Actor init signatures are not present in this shadow's taint table.
        let u2: i64 = tt_mark_unsupported(diags);
        return TT_PUBLIC;
    } else {
    }
    // Any other expression kind is outside the declared shadow subset. Mark it explicitly rather
    // than silently manufacturing a Public label.
    let u3: i64 = tt_mark_unsupported(diags);
    return TT_PUBLIC;
}

// tt_expr of a node's child[0].
fn tt_child0(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, binds: Vec<TtBind>, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>, pc: i64, rtm: Vec<i64> @Mut, fl: Vec<i64> @Mut, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(nid);
    if n.child_count >= 1 {
        let cid: i64 = kids.get(n.child_start);
        return tt_expr(nodes, kids, cid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
    } else {
    }
    return TT_PUBLIC;
}

// The lub of tt_expr over ALL children (also evaluates each for its CT side-effects).
fn tt_lub_children(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, binds: Vec<TtBind>, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>, pc: i64, rtm: Vec<i64> @Mut, fl: Vec<i64> @Mut, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(nid);
    let mut acc: i64 = TT_PUBLIC;
    let mut i: i64 = 0;
    while i < n.child_count {
        let cid: i64 = kids.get(n.child_start + i);
        let t: i64 = tt_expr(nodes, kids, cid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
        acc = tt_lub(acc, t);
        i = i + 1;
    }
    return acc;
}

// A P_K_CALL — classified BY NAME (ET-T14: the parse tree has no Intrinsic/Extern/
// Indirect node kinds). All args are evaluated first (side-effect taint), then:
//   alloc            -> T029 iff arg0 CT; base = lub(args)
//   load8 / store8   -> T025 iff arg0 CT; base = lub(args) — SHP-5c-1: a load joins the
//                       raw-load floor (S1/S2), a store raises both floors (S4/S6)
//   vec_load/vec_store -> T025 iff arg0 OR arg1 CT (NOT the value/bound); base = lub(args);
//                       SHP-5c-2: the same raw read and raw write as load8 / store8
//   str_from_raw     -> base = lub(args) joined with the raw-load floor (a deferred read)
//   <extern name>    -> base = Internal; T027 iff ANY arg CT; the raw floor is @Internal (S1)
//   <other>          -> base = lub(sig ret-taint, args, the floors the callee reads — S8)
//                       (a plain Call; other intrinsic names — ct_*/slot_*/u256_* — have no
//                       declared fn so default Public, giving lub(args), matching their
//                       oracle arms); a callee whose row names FFI raises the raw floor
//                       (S1); its summary raises the floors and taints the regions of the
//                       arguments it writes through (S5, SHP-5c-2)
fn tt_call(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, binds: Vec<TtBind>, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>, pc: i64, rtm: Vec<i64> @Mut, fl: Vec<i64> @Mut, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(nid);
    let name: str = tc_seg_at(n.text, 0);
    let mut argslub: i64 = TT_PUBLIC;
    let mut arg0: i64 = TT_PUBLIC;
    let mut arg1: i64 = TT_PUBLIC;
    let mut anyct: bool = false;
    let mut argtaints: Vec<i64> = Vec::new();
    // SHP-5c-3: a call's explicit type arguments lead its children (`flags` counts them);
    // the value arguments start after them.
    let mut i: i64 = n.flags;
    while i < n.child_count {
        let cid: i64 = kids.get(n.child_start + i);
        let t: i64 = tt_expr(nodes, kids, cid, binds, sigs, sidx, externs, pc, rtm, fl, diags);
        if i == n.flags {
            arg0 = t;
        } else {
        }
        if i == n.flags + 1 {
            arg1 = t;
        } else {
        }
        if tt_is_ct(t) {
            anyct = true;
        } else {
        }
        let ap: i64 = argtaints.push(t);
        argslub = tt_lub(argslub, t);
        i = i + 1;
    }

    if name.bytes_eq("alloc") {
        if tt_is_ct(arg0) {
            let d: i64 = diags.push("T029;");
        } else {
        }
        return argslub;
    } else {
    }
    if name.bytes_eq("load8") {
        if tt_is_ct(arg0) {
            let d: i64 = diags.push("T025;");
        } else {
        }
        // SHP-5c-1: a raw read returns whatever is at the address — the raw-load floor.
        return tt_lub(argslub, fl.get(0));
    } else {
    }
    if name.bytes_eq("vec_load") {
        // SHP-5c-2: the stdlib's element load — a raw read at base + index (production's
        // VecLoad arm: T025 on a @SecretCT base or index, the raw-load floor on the result).
        if tt_is_ct(arg0) {
            let dv: i64 = diags.push("T025;");
        }
        if tt_is_ct(arg1) {
            let dv2: i64 = diags.push("T025;");
        }
        return tt_lub(argslub, fl.get(0));
    }
    if name.bytes_eq("str_from_raw") {
        // SHP-5c-1: a forged `str` view is a deferred raw read; the floor applies at the forge.
        return tt_lub(argslub, fl.get(0));
    }
    let mut raw_store: bool = false;
    if name.bytes_eq("store8") {
        raw_store = true;
        if tt_is_ct(arg0) {
            let d: i64 = diags.push("T025;");
        } else {
        }
    }
    if name.bytes_eq("vec_store") {
        // SHP-5c-2: the stdlib's element store — a raw write at base + index (production's
        // VecStore arm: T025 on a @SecretCT base or index; the write itself below).
        raw_store = true;
        if tt_is_ct(arg0) {
            let ds: i64 = diags.push("T025;");
        }
        if tt_is_ct(arg1) {
            let ds2: i64 = diags.push("T025;");
        }
    }
    if raw_store {
        // M6 — a raw store taints the region of EVERY operand that names one (the oracle's
        // RawWrite arm: which operand is the address is never consulted — a pointer passed
        // as the value is over-attributed, fail closed) with the join of all operands and
        // the effective pc, so a pointer that reaches a sink unread carries what was
        // written through it or through an alias. An operand with no region — a
        // parameter, a callee result, a load, other arithmetic — taints nothing: the open
        // surface production discloses as HF-1, mirrored as-is.
        let written: i64 = tt_lub(argslub, pc);
        let mut si: i64 = 0;
        while si < n.child_count {
            let scid: i64 = kids.get(n.child_start + si);
            let sregs: i64 = tt_regions_of_expr(nodes, kids, scid, binds);
            let sq: i64 = tt_rt_raise(rtm, sregs, written);
            si = si + 1;
        }
        // SHP-5c-1 (S4/S6): the same join raises both floors — the stored bytes sit at an
        // unchecked address any later raw load, or a typed read of whatever aggregate the
        // address landed in, can reach.
        let qs: i64 = tt_fl_note_raw_store(fl, written);
        return argslub;
    } else {
    }
    if tt_name_in(externs, name) {
        // FFI is an @Internal value boundary. @SecretCT keeps its dedicated T027;
        // ordinary @Secret payloads emit T001.
        if anyct {
            let d: i64 = diags.push("T027;");
        } else {
        }
        let mut fi: i64 = 0;
        while fi < argtaints.len() {
            let ft: i64 = argtaints.get(fi);
            if !tt_is_ct(ft) {
                if !tt_can_flow(ft, TT_INTERNAL) {
                    let d2: i64 = diags.push("T001;");
                } else {
                }
            } else {
            }
            fi = fi + 1;
        }
        // SHP-5c-1 (S1): the host wrote its result at the guest's bump pointer.
        let qx: i64 = tt_fl_note_ffi(fl);
        return TT_INTERNAL;
    } else {
    }
    // Plain direct call: each argument must satisfy the callee's declared label.
    // A missing signature denotes an intrinsic, a constructor, a static method or a
    // closure-typed local in this parse-tree shadow; those are handled conservatively
    // elsewhere (SHP-5c-1: a static method's FFI row still raises the floor, S1).
    let si: i64 = tt_tab_find(sigs, sidx, TT_SK_FN, name);
    if si < 0 {
        let qst: i64 = tt_static_ffi(sigs, sidx, name, fl);
        // SHP-5c-2: a callee with no row has a summary production applies and this shadow
        // cannot — refuse while the summaries are live (an intrinsic or a variant
        // construction has none).
        let qun: i64 = tt_sm_unresolved(name, sigs, sidx, diags);
        return argslub;
    }
    let sg: TtSig = sigs.get(si);
    // SHP-5c-1 (S1): a callee whose effect row names FFI may have made the host write guest
    // memory before returning (production's `callee_has_ffi`).
    if sg.ffi {
        let qff: i64 = tt_fl_note_ffi(fl);
    }
    let qca: i64 = tt_check_args(sg, argtaints, diags);
    // SHP-5c-2 (S5, S8): the callee's summary at this site; the floors it reads join the
    // result, with the callee's return label and the arguments.
    let rf: i64 = tt_sm_site(nodes, kids, nid, 0, si, argslub, binds, sigs, sidx, pc, rtm, fl, diags);
    return tt_lub(tt_lub(sg.ret_taint, argslub), rf);
}

// ────────────────────────────────────────────────────────────────────────────
// The control-flow join model (SHP-5a; docs/specs/taint-join-soundness.md). The oracle's
// taint checker is flow-sensitive: a branch starts from a snapshot of the env, and the paths
// that fall through are joined by lub over the names bound BEFORE the construct (SC-T1,
// SC-T2); a loop iterates its body to a fixpoint joined with the zero-iteration path and
// every `continue` (SC-T3), and joins every `break` at its exit; a `let` that shadows an
// outer name is restored at its block's end; and reaching the code after a one-sided early
// exit is control-dependent on the guard (the continuation taint). The helpers below give
// the append-only env those operations: a branch, an arm or a loop pass walks a CLONE of the
// env, and the join is PUSHED onto the parent env, one entry per pre-construct name, so a
// name bound inside never escapes. `break`/`continue` capture one FRAME per jump: the
// current binding of every pre-loop name, in `prenames` order, appended to the loop's flat
// collector (`brk`/`cnt`, `m` entries per frame). The walker threads `pc` (the lexical pc)
// and `cont` (the continuation) and hands `tt_expr` their join, the oracle's `effective_pc`.
// The heap floors (SHP-5c-1) and the region taint (M6) are function-scoped and monotone, so
// neither is part of a path's state: a branch raises them for the rest of the function.
// ────────────────────────────────────────────────────────────────────────────

// The latest binding of `name`, or an absent marker (taint -1, no fields) when `binds` has
// none; a lookup treats the two alike (Public), and a restore pushes Public for the marker.
fn tt_env_bind(binds: Vec<TtBind>, name: str) -> TtBind ! { Alloc } {
    let n: i64 = binds.len();
    let mut i: i64 = n - 1;
    while i >= 0 {
        let b: TtBind = binds.get(i);
        if b.name.bytes_eq(name) {
            return b;
        }
        i = i - 1;
    }
    return TtBind { name: name, fields: "", taint: 0 - 1, regions: 0, tdesc: "?" };
}

// ────────────────────────────────────────────────────────────────────────────
// M6 — region-based memory taint (SHP-5a), the oracle's intra-procedural alias model:
// each BOUND `alloc` is a region (keyed by its call node, so a loop body's site names the
// same region on every fixpoint pass — the oracle's stable-id rule); a pointer local carries
// its source's regions through `let q = out` / `let q = out + i` / `q = alloc(8) + k`; a
// raw store taints every operand's regions; and every read of a local folds its regions'
// current taint. The map `rtm` holds (alloc node id, taint) pairs — region k is pair k —
// and a binding's `regions` is a bit mask over k. FAILURE DIRECTION: a function naming
// more than 62 regions is refused (SH_TAINT_UNSUPPORTED), never silently unregioned. What
// the oracle attributes to no region (a parameter, a callee result, a load, other
// arithmetic — its disclosed HF-1 surface) is unregioned here too; the intraprocedural heap
// floors are mirrored (SHP-5c-1, above) and the call-site summaries (S5/S8) since SHP-5c-2
// (the banner before `tt_sm_build`).
// ────────────────────────────────────────────────────────────────────────────

// 2^k, for 0 <= k < 63.
fn tt_pow2(k: i64) -> i64 {
    let mut p: i64 = 1;
    let mut i: i64 = 0;
    while i < k {
        p = p * 2;
        i = i + 1;
    }
    return p;
}

// Bit k of a region mask.
fn tt_mask_has(mask: i64, k: i64) -> bool {
    let q: i64 = mask / tt_pow2(k);
    if q - (q / 2) * 2 == 1 {
        return true;
    }
    return false;
}

// The union of two region masks.
fn tt_mask_union(a: i64, b: i64) -> i64 {
    if a == b {
        return a;
    }
    let mut acc: i64 = 0;
    let mut ra: i64 = a;
    let mut rb: i64 = b;
    let mut p: i64 = 1;
    while ra + rb > 0 {
        let ba: i64 = ra - (ra / 2) * 2;
        let bb: i64 = rb - (rb / 2) * 2;
        if ba + bb > 0 {
            acc = acc + p;
        }
        ra = ra / 2;
        rb = rb / 2;
        p = p * 2;
    }
    return acc;
}

// The pair index of the region minted for alloc node `nid`, or -1.
fn tt_rt_index(rtm: Vec<i64>, nid: i64) -> i64 {
    let n: i64 = rtm.len() / 2;
    let mut i: i64 = 0;
    while i < n {
        if rtm.get(i * 2) == nid {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// The mask of the region for alloc node `nid`, minting it at @Public on first sight. -1 when
// the function already names 62 regions (the caller refuses: fail closed).
fn tt_rt_mint(rtm: Vec<i64> @Mut, nid: i64) -> i64 ! { Alloc } {
    let idx: i64 = tt_rt_index(rtm, nid);
    if idx >= 0 {
        return tt_pow2(idx);
    }
    let n: i64 = rtm.len() / 2;
    if n >= 62 {
        return 0 - 1;
    }
    let p1: i64 = rtm.push(nid);
    let p2: i64 = rtm.push(TT_PUBLIC);
    return tt_pow2(n);
}

// Raise every region in `mask` to at least `t` (region taint only ever rises).
fn tt_rt_raise(rtm: Vec<i64> @Mut, mask: i64, t: i64) -> i64 {
    let n: i64 = rtm.len() / 2;
    let mut k: i64 = 0;
    while k < n {
        if tt_mask_has(mask, k) {
            let cur: i64 = rtm.get(k * 2 + 1);
            let q: i64 = rtm.set(k * 2 + 1, tt_lub(cur, t));
        }
        k = k + 1;
    }
    return 0;
}

// The join of the current taint of every region in `mask`.
fn tt_rt_fold(rtm: Vec<i64>, mask: i64) -> i64 {
    let n: i64 = rtm.len() / 2;
    let mut acc: i64 = TT_PUBLIC;
    let mut k: i64 = 0;
    while k < n {
        if tt_mask_has(mask, k) {
            acc = tt_lub(acc, rtm.get(k * 2 + 1));
        }
        k = k + 1;
    }
    return acc;
}

// Top-taint every region: the fail-closed state of a fixpoint that did not converge.
fn tt_rt_top(rtm: Vec<i64> @Mut) -> i64 {
    let n: i64 = rtm.len() / 2;
    let mut k: i64 = 0;
    while k < n {
        let q: i64 = rtm.set(k * 2 + 1, TT_SECRET);
        k = k + 1;
    }
    return 0;
}

// A copy of the region-taint map, and whether the map still equals one: a loop pass that
// minted or raised a region did not converge, whatever its bindings say.
fn tt_rt_snapshot(rtm: Vec<i64>, out: Vec<i64> @Mut) -> i64 ! { Alloc } {
    let n: i64 = rtm.len();
    let mut i: i64 = 0;
    while i < n {
        let p: i64 = out.push(rtm.get(i));
        i = i + 1;
    }
    return 0;
}

fn tt_rt_same(rtm: Vec<i64>, snap: Vec<i64>) -> bool {
    let n: i64 = rtm.len();
    if snap.len() != n {
        return false;
    }
    let mut i: i64 = 0;
    while i < n {
        if rtm.get(i) != snap.get(i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Append every entry of `src` to the diagnostic sink.
fn tt_push_strs(diags: Vec<str> @Mut, src: Vec<str>) -> i64 ! { Alloc } {
    let n: i64 = src.len();
    let mut i: i64 = 0;
    while i < n {
        let p: i64 = diags.push(src.get(i));
        i = i + 1;
    }
    return 0;
}

// A read of a local: its binding's taint joined with its regions' current taint (the
// oracle's lookup) — an alias sees a secret stored through a sibling pointer.
fn tt_read(binds: Vec<TtBind>, rtm: Vec<i64>, name: str) -> i64 ! { Alloc } {
    let b: TtBind = tt_env_bind(binds, name);
    if b.taint < 0 {
        return TT_PUBLIC;
    }
    return tt_lub(b.taint, tt_rt_fold(rtm, b.regions));
}

// The regions the current binding of `name` points into; 0 when unbound.
fn tt_outer_regions(binds: Vec<TtBind>, name: str) -> i64 ! { Alloc } {
    let b: TtBind = tt_env_bind(binds, name);
    if b.taint < 0 {
        return 0;
    }
    return b.regions;
}

// The regions a pointer expression USED (stored through) may point into: a local's, or the
// union over a `+`/`-` chain (the oracle's region_of_expr). Mints nothing: `store8(alloc(8),
// s)` is attributed to no region, exactly as production attributes it.
fn tt_regions_of_expr(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, binds: Vec<TtBind>) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(nid);
    if n.kind == P_K_PATH {
        if tt_path_has_sep(n.text) {
            return 0;
        }
        return tt_outer_regions(binds, n.text);
    }
    if n.kind == P_K_BINARY {
        if n.value == T_PLUS {
            let l: i64 = tt_regions_of_expr(nodes, kids, kids.get(n.child_start), binds);
            let r: i64 = tt_regions_of_expr(nodes, kids, kids.get(n.child_start + 1), binds);
            return tt_mask_union(l, r);
        }
        if n.value == T_MINUS {
            let l2: i64 = tt_regions_of_expr(nodes, kids, kids.get(n.child_start), binds);
            let r2: i64 = tt_regions_of_expr(nodes, kids, kids.get(n.child_start + 1), binds);
            return tt_mask_union(l2, r2);
        }
    }
    return 0;
}

// The regions a local BOUND to this value points into (the oracle's regions_of_bound_value):
// every `alloc` leaf of its `+`/`-` chain mints a region, every regioned local leaf
// contributes its own, anything else contributes nothing. Minting order is the left-to-right
// walk, and a site's region is keyed by its node, so every pass names the same regions.
fn tt_regions_of_value(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, binds: Vec<TtBind>, rtm: Vec<i64> @Mut, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(nid);
    if n.kind == P_K_CALL {
        let name: str = tc_seg_at(n.text, 0);
        if name.bytes_eq("alloc") {
            let m: i64 = tt_rt_mint(rtm, nid);
            if m < 0 {
                // More regions than the mask can name: refuse rather than drop one.
                let u: i64 = tt_mark_unsupported(diags);
                return 0;
            }
            return m;
        }
        return 0;
    }
    if n.kind == P_K_PATH {
        if tt_path_has_sep(n.text) {
            return 0;
        }
        return tt_outer_regions(binds, n.text);
    }
    if n.kind == P_K_BINARY {
        if n.value == T_PLUS {
            let l: i64 = tt_regions_of_value(nodes, kids, kids.get(n.child_start), binds, rtm, diags);
            let r: i64 = tt_regions_of_value(nodes, kids, kids.get(n.child_start + 1), binds, rtm, diags);
            return tt_mask_union(l, r);
        }
        if n.value == T_MINUS {
            let l2: i64 = tt_regions_of_value(nodes, kids, kids.get(n.child_start), binds, rtm, diags);
            let r2: i64 = tt_regions_of_value(nodes, kids, kids.get(n.child_start + 1), binds, rtm, diags);
            return tt_mask_union(l2, r2);
        }
    }
    return 0;
}

// A faithful copy, fields kept: the env a branch, an arm or a loop pass starts from.
fn tt_clone_binds(src: Vec<TtBind>, dst: Vec<TtBind> @Mut) -> i64 ! { Alloc } {
    // An ordered copy, fields kept (see tt_copy_binds on the order).
    let n: i64 = src.len();
    let mut i: i64 = 0;
    while i < n {
        let b: TtBind = src.get(i);
        let p: i64 = dst.push(TtBind { name: b.name, fields: b.fields, taint: b.taint, regions: b.regions, tdesc: b.tdesc });
        i = i + 1;
    }
    return 0;
}

// The distinct names `binds` holds, in first-bound order: the names a merge is restricted to.
fn tt_env_names(binds: Vec<TtBind>, out: Vec<str> @Mut) -> i64 ! { Alloc } {
    // One entry per name, in env order: the list indexes the env and every clone of it.
    let n: i64 = binds.len();
    let mut i: i64 = 0;
    while i < n {
        let b: TtBind = binds.get(i);
        let p: i64 = out.push(b.name);
        i = i + 1;
    }
    return 0;
}

// The binding of name `j` of `names` in `binds`: entry `j` when it carries that name (an env
// and every clone of it share the order the names were read in), else the scan. A name
// absent from `binds` is the absent marker, as tt_env_bind gives it.
fn tt_bind_at(binds: Vec<TtBind>, names: Vec<str>, j: i64) -> TtBind ! { Alloc } {
    let nm: str = names.get(j);
    if j < binds.len() {
        let b: TtBind = binds.get(j);
        if b.name.bytes_eq(nm) {
            return b;
        }
    }
    return tt_env_bind(binds, nm);
}

// The index of `name` in `names`, or -1.
fn tt_name_index(names: Vec<str>, name: str) -> i64 {
    let n: i64 = names.len();
    let mut i: i64 = 0;
    while i < n {
        let nm: str = names.get(i);
        if nm.bytes_eq(name) {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// The k-th `name=d` segment of a field encoding, or "" past the end. ';'=59.
fn tt_field_seg(enc: str, k: i64) -> str {
    let n: i64 = enc.len();
    let mut segstart: i64 = 0;
    let mut idx: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        if enc.byte_at(i) == 59 {
            if idx == k {
                return enc.substr(segstart, i);
            }
            idx = idx + 1;
            segstart = i + 1;
        }
        i = i + 1;
    }
    return "";
}

// The name before the `=` of a `name=d` segment. '='=61.
fn tt_seg_name(seg: str) -> str {
    let n: i64 = seg.len();
    let mut i: i64 = 0;
    while i < n {
        if seg.byte_at(i) == 61 {
            return seg.substr(0, i);
        }
        i = i + 1;
    }
    return seg;
}

// The taint after the `=` of a `name=d` segment.
fn tt_seg_taint(seg: str) -> i64 {
    let n: i64 = seg.len();
    let mut i: i64 = 0;
    while i < n {
        if seg.byte_at(i) == 61 {
            let ds: str = seg.substr(i + 1, n);
            return tc_atoi(ds);
        }
        i = i + 1;
    }
    return TT_PUBLIC;
}

// Does the encoding name `field`? `tt_field_taint` answers Public for an absent field, which
// a join must tell from a Public one: the absent side contributes its WHOLE label.
fn tt_field_present(enc: str, field: str) -> bool {
    let mut k: i64 = 0;
    let mut seg: str = tt_field_seg(enc, k);
    while seg.len() > 0 {
        let sn: str = tt_seg_name(seg);
        if sn.bytes_eq(field) {
            return true;
        }
        k = k + 1;
        seg = tt_field_seg(enc, k);
    }
    return false;
}

// One `name=d;` segment appended to an encoding.
fn tt_enc_push(enc: str, name: str, t: i64) -> str ! { Alloc } {
    let e1: str = enc.concat(name);
    let e2: str = e1.concat("=");
    let e3: str = e2.concat(tt_digit(t));
    return e3.concat(";");
}

// The oracle's join_binding on two records: the union of both field sets, each field the lub
// of its two taints, a field absent on one side taking that side's whole label.
fn tt_join_fields(ea: str, la: i64, eb: str, lb: i64) -> str ! { Alloc } {
    let mut enc: str = "";
    let mut k: i64 = 0;
    let mut sa: str = tt_field_seg(ea, k);
    while sa.len() > 0 {
        let nm: str = tt_seg_name(sa);
        let ta: i64 = tt_seg_taint(sa);
        let mut tb: i64 = lb;
        if tt_field_present(eb, nm) {
            tb = tt_field_taint(eb, nm);
        }
        enc = tt_enc_push(enc, nm, tt_lub(ta, tb));
        k = k + 1;
        sa = tt_field_seg(ea, k);
    }
    k = 0;
    let mut sb: str = tt_field_seg(eb, k);
    while sb.len() > 0 {
        let nm2: str = tt_seg_name(sb);
        if !tt_field_present(ea, nm2) {
            let tb2: i64 = tt_seg_taint(sb);
            enc = tt_enc_push(enc, nm2, tt_lub(la, tb2));
        }
        k = k + 1;
        sb = tt_field_seg(eb, k);
    }
    return enc;
}

// The oracle's join_binding: two records join field by field; anything else is the scalar lub
// of the two labels (a record's label is the lub of its fields, which `taint` already holds).
fn tt_join_bind(a: TtBind, b: TtBind) -> TtBind ! { Alloc } {
    let lub: i64 = tt_lub(a.taint, b.taint);
    // M6: a local rebound to a different region on one path points into EVERY candidate
    // after the merge (the oracle's join_regions union) — fail closed, never fewer.
    let rg: i64 = tt_mask_union(a.regions, b.regions);
    // SHP-5c-1: a name's declared type is the same on every path; two descriptors that
    // disagree are the fail-closed unknown.
    let mut td: str = a.tdesc;
    if !a.tdesc.bytes_eq(b.tdesc) {
        td = "?";
    }
    if a.fields.len() > 0 {
        if b.fields.len() > 0 {
            let enc: str = tt_join_fields(a.fields, a.taint, b.fields, b.taint);
            return TtBind { name: a.name, fields: enc, taint: lub, regions: rg, tdesc: td };
        }
    }
    return TtBind { name: a.name, fields: "", taint: lub, regions: rg, tdesc: td };
}

// Does every one of the `m` names hold the same binding in `a` and `b` (one entry per name)?
fn tt_env_equal(a: Vec<TtBind>, b: Vec<TtBind>, m: i64) -> bool {
    let mut j: i64 = 0;
    while j < m {
        let x: TtBind = a.get(j);
        let y: TtBind = b.get(j);
        if x.taint != y.taint {
            return false;
        }
        if !x.fields.bytes_eq(y.fields) {
            return false;
        }
        if x.regions != y.regions {
            return false;
        }
        j = j + 1;
    }
    return true;
}

// Overwrite `head` (one entry per name) with `next`.
fn tt_env_assign(head: Vec<TtBind> @Mut, next: Vec<TtBind>, m: i64) -> i64 {
    let mut j: i64 = 0;
    while j < m {
        let q: i64 = head.set(j, next.get(j));
        j = j + 1;
    }
    return 0;
}

// Top-taint every entry of a loop head, both floors and every region: the fail-closed state
// of a fixpoint that did not converge within its bound (the oracle's unreachable arm, which
// does the same).
fn tt_env_top(head: Vec<TtBind> @Mut, m: i64, rtm: Vec<i64> @Mut, fl: Vec<i64> @Mut) -> i64 ! { Alloc } {
    let qr: i64 = tt_rt_top(rtm);
    let qf: i64 = tt_fl_raise(fl, TT_SECRET, TT_SECRET);
    let mut j: i64 = 0;
    while j < m {
        let b: TtBind = head.get(j);
        let q: i64 = head.set(j, TtBind { name: b.name, fields: "", taint: TT_SECRET, regions: b.regions, tdesc: b.tdesc });
        j = j + 1;
    }
    return 0;
}

// Fold one falling-through path into `acc` (one entry per name, `names` order): the first path
// seeds it, every later one joins into it (the oracle's merge_branch_bindings). A path that
// never rebound a name holds its pre-construct binding, since every path started from a clone.
fn tt_merge_path(acc: Vec<TtBind> @Mut, names: Vec<str>, path: Vec<TtBind>, first: bool) -> i64 ! { Alloc } {
    let m: i64 = names.len();
    let mut j: i64 = 0;
    while j < m {
        let b: TtBind = tt_bind_at(path, names, j);
        if first {
            let p: i64 = acc.push(b);
        } else {
            let cur: TtBind = acc.get(j);
            let q: i64 = acc.set(j, tt_join_bind(cur, b));
        }
        j = j + 1;
    }
    return 0;
}

// The oracle's join_envs_into: for every pre-loop name, pre ⊔ base ⊔ each captured frame, one
// entry per name in `names` order pushed onto the EMPTY `out` (`frames` holds a frame of
// `names.len()` entries per jump).
fn tt_loop_join(out: Vec<TtBind> @Mut, names: Vec<str>, pre: Vec<TtBind>, base: Vec<TtBind>, frames: Vec<TtBind>) -> i64 ! { Alloc } {
    let m: i64 = names.len();
    let nf: i64 = frames.len();
    let mut j: i64 = 0;
    while j < m {
        let pb: TtBind = tt_bind_at(pre, names, j);
        let bb: TtBind = tt_bind_at(base, names, j);
        let p: i64 = out.push(tt_join_bind(pb, bb));
        let mut k: i64 = j;
        while k < nf {
            let cur: TtBind = out.get(j);
            let fb: TtBind = frames.get(k);
            let q: i64 = out.set(j, tt_join_bind(cur, fb));
            k = k + m;
        }
        j = j + 1;
    }
    return 0;
}

// Write every entry of `acc` into the env: the merged state becomes the current binding of
// each name, and the entries a path wrote stay in ITS clone.
fn tt_push_all(binds: Vec<TtBind> @Mut, acc: Vec<TtBind>) -> i64 ! { Alloc } {
    let n: i64 = acc.len();
    let mut j: i64 = 0;
    while j < n {
        let b: TtBind = acc.get(j);
        let p: i64 = tt_upsert(binds, TtBind { name: b.name, fields: b.fields, taint: b.taint, regions: b.regions, tdesc: b.tdesc });
        j = j + 1;
    }
    return 0;
}

// A `break`/`continue` frame: the current binding of every pre-loop name, in order.
fn tt_capture(binds: Vec<TtBind>, names: Vec<str>, frames: Vec<TtBind> @Mut) -> i64 ! { Alloc } {
    let m: i64 = names.len();
    let mut j: i64 = 0;
    while j < m {
        let p: i64 = frames.push(tt_bind_at(binds, names, j));
        j = j + 1;
    }
    return 0;
}

// The oracle's restore_shadowed on the captured frames: every frame appended since `from` (the
// collector's length when the block began) has name `j`'s entry set to `b`.
fn tt_patch_frames(frames: Vec<TtBind> @Mut, from: i64, m: i64, j: i64, b: TtBind) -> i64 ! { Alloc } {
    let n: i64 = frames.len();
    let mut idx: i64 = from + j;
    while idx < n {
        let q: i64 = frames.set(idx, TtBind { name: b.name, fields: b.fields, taint: b.taint, regions: b.regions, tdesc: b.tdesc });
        idx = idx + m;
    }
    return 0;
}

// Record what a `let` in this block shadows, once per name (the oracle's Shadow list).
fn tt_note_shadow(binds: Vec<TtBind>, name: str, shadows: Vec<TtBind> @Mut) -> i64 ! { Alloc } {
    let n: i64 = shadows.len();
    let mut i: i64 = 0;
    while i < n {
        let s: TtBind = shadows.get(i);
        if s.name.bytes_eq(name) {
            return 0;
        }
        i = i + 1;
    }
    let p: i64 = shadows.push(tt_env_bind(binds, name));
    return 0;
}

// The walker's result: bit 0 = the statement or block diverged, the rest = the continuation.
fn tt_pack(div: i64, cont: i64) -> i64 {
    return div + cont * 2;
}

fn tt_div_of(r: i64) -> i64 {
    return r - (r / 2) * 2;
}

fn tt_cont_of(r: i64) -> i64 {
    return r / 2;
}

// Bind every name a pattern binds at `taint` (the oracle's bind_pattern_taint over Binding,
// EnumVariant and Array patterns), pushing each name on `out` for the arm-end restore. An enum
// pattern's text is `Type;Variant;b0;b1…` and an array pattern's the element words then a
// named rest; `_` binds nothing. SHP-5c-1: `sd` is the scrutinee's type descriptor — a whole
// binding takes it, a variant's payload its enum entry, an array element the scrutinee's
// element and the named rest (the last word when flags = 2) a slice of it.
fn tt_bind_pattern(nodes: Arena<PNode>, kids: Vec<i64>, patid: i64, taint: i64, binds: Vec<TtBind> @Mut, out: Vec<str> @Mut, sd: str, sigs: Vec<TtSig>, sidx: TtIdx) -> i64 ! { Alloc } {
    let pat: PNode = nodes.get(patid);
    if pat.kind == P_K_PAT_BINDING {
        let p: i64 = tt_upsert(binds, TtBind { name: pat.text, fields: "", taint: taint, regions: tt_outer_regions(binds, pat.text), tdesc: sd });
        let o: i64 = out.push(pat.text);
        return 0;
    }
    let mut first: i64 = 0 - 1;
    if pat.kind == P_K_PAT_ENUM {
        first = 2;
    }
    if pat.kind == P_K_PAT_ARRAY {
        first = 0;
    }
    if first < 0 {
        return 0;
    }
    let nwords: i64 = tc_seg_count(pat.text);
    let elem: str = tt_desc_inner(tt_desc_deref(sd));
    let mut k: i64 = first;
    let mut scan: bool = true;
    while scan {
        let nm: str = tc_seg_at(pat.text, k);
        if nm.len() > 0 {
            if !nm.bytes_eq("_") {
                let mut bd: str = elem;
                if pat.kind == P_K_PAT_ENUM {
                    let ename: str = tt_last_seg(tc_seg_at(pat.text, 0));
                    let j1: str = ename.concat(";");
                    let j2: str = j1.concat(tc_seg_at(pat.text, 1));
                    let j3: str = j2.concat(";");
                    let pk: i64 = k - 2;
                    bd = tt_tab_desc(sigs, sidx, TT_SK_VARIANT, j3.concat(pk.itoa()));
                }
                if pat.flags == 2 {
                    if k == nwords - 1 {
                        bd = tt_desc_wrap("A", elem);
                    }
                }
                let p2: i64 = tt_upsert(binds, TtBind { name: nm, fields: "", taint: taint, regions: tt_outer_regions(binds, nm), tdesc: bd });
                let o2: i64 = out.push(nm);
            }
            k = k + 1;
        } else {
            scan = false;
        }
    }
    return 0;
}

// ────────────────────────────────────────────────────────────────────────────
// The statement walk (the oracle's check_stmt_seq / check_stmt). `binds` is the env the
// sequence runs in (@Mut, append-only); a construct that branches walks clones and pushes the
// join (see above). `pc` is the lexical pc and `cont` the continuation (the oracle's `pc_taint`
// and `continuation_taint`); `fnret` is the fn's declared return taint (already lub'd with
// Internal for tool_main). `brk`/`cnt` collect the enclosing loop's `break`/`continue` frames
// over `prenames`, its pre-loop names; `ld` is the loop depth, 0 outside any loop. The result
// packs the divergence bit and the continuation (`tt_pack`).
// ────────────────────────────────────────────────────────────────────────────
fn tt_block(nodes: Arena<PNode>, kids: Vec<i64>, blockid: i64, binds: Vec<TtBind> @Mut, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>, fnret: i64, pc: i64, cont: i64, brk: Vec<TtBind> @Mut, cnt: Vec<TtBind> @Mut, prenames: Vec<str>, ld: i64, rtm: Vec<i64> @Mut, fl: Vec<i64> @Mut, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let bn: PNode = nodes.get(blockid);
    let bb: i64 = brk.len();
    let cb: i64 = cnt.len();
    let mut shadows: Vec<TtBind> = Vec::new();
    let mut c: i64 = cont;
    let mut div: i64 = 0;
    let mut i: i64 = 0;
    while i < bn.child_count {
        // Stop at the first diverging statement: the rest of the sequence is unreachable, so its
        // taint-lowering updates must not apply on the exit path (task #252, root cause 1).
        if div == 0 {
            let sid: i64 = kids.get(bn.child_start + i);
            let s: PNode = nodes.get(sid);
            if s.kind == P_K_LET {
                let sh: i64 = tt_note_shadow(binds, s.text, shadows);
            }
            if s.kind == P_K_LET_TUPLE {
                let mut ti: i64 = 0;
                let mut tscan: bool = true;
                while tscan {
                    let tnm: str = tc_seg_at(s.text, ti);
                    if tnm.len() > 0 {
                        let sh2: i64 = tt_note_shadow(binds, tnm, shadows);
                        ti = ti + 1;
                    } else {
                        tscan = false;
                    }
                }
            }
            let r: i64 = tt_stmt(nodes, kids, sid, binds, sigs, sidx, externs, fnret, pc, c, brk, cnt, prenames, ld, rtm, fl, diags);
            c = tt_cont_of(r);
            div = tt_div_of(r);
        }
        i = i + 1;
    }
    // Restore every name a `let` here shadowed to its outer binding (root cause 3), in the env
    // and in every frame a `break`/`continue` captured inside this block.
    let m: i64 = prenames.len();
    let mut k: i64 = shadows.len() - 1;
    while k >= 0 {
        let sh: TtBind = shadows.get(k);
        let mut rt: i64 = sh.taint;
        let mut rf: str = sh.fields;
        if rt < 0 {
            rt = TT_PUBLIC;
            rf = "";
        }
        let pr: i64 = tt_upsert(binds, TtBind { name: sh.name, fields: rf, taint: rt, regions: sh.regions, tdesc: sh.tdesc });
        let j: i64 = tt_name_index(prenames, sh.name);
        if j >= 0 {
            let q1: i64 = tt_patch_frames(brk, bb, m, j, TtBind { name: sh.name, fields: rf, taint: rt, regions: sh.regions, tdesc: sh.tdesc });
            let q2: i64 = tt_patch_frames(cnt, cb, m, j, TtBind { name: sh.name, fields: rf, taint: rt, regions: sh.regions, tdesc: sh.tdesc });
        }
        k = k - 1;
    }
    return tt_pack(div, c);
}

// A `for` loop over a body whose pc is fixed at entry (the oracle's ForRange / ForIn arms):
// the variable carries the bounds' or iterable's taint `bt` joined with the pc, the body runs
// to the loop-head fixpoint and once for real from it, the exit joins the head with every
// `break`, and the outer binding the variable shadowed, if any, is restored.
fn tt_for_loop(nodes: Arena<PNode>, kids: Vec<i64>, bid: i64, var: str, bt: i64, vd: str, binds: Vec<TtBind> @Mut, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>, fnret: i64, pc: i64, cont: i64, ld: i64, rtm: Vec<i64> @Mut, fl: Vec<i64> @Mut, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let bpc: i64 = tt_lub(pc, bt);
    let vt: i64 = tt_lub(bt, bpc);
    let pv: TtBind = tt_env_bind(binds, var);
    let vr: i64 = tt_outer_regions(binds, var);
    let mut names: Vec<str> = Vec::new();
    let qn: i64 = tt_env_names(binds, names);
    let m: i64 = names.len();
    let mut empty: Vec<TtBind> = Vec::new();
    let mut head: Vec<TtBind> = Vec::new();
    let qh: i64 = tt_loop_join(head, names, binds, binds, empty);
    let mut passes: i64 = 0;
    let mut forced: bool = false;
    let mut stable: bool = false;
    while !stable {
        let mut env: Vec<TtBind> = Vec::new();
        let qc: i64 = tt_clone_binds(head, env);
        let qv: i64 = tt_upsert(env, TtBind { name: var, fields: "", taint: vt, regions: vr, tdesc: vd });
        // Each pass walks into its own sink from a snapshot of the region taint. A pass that
        // leaves the head, the regions and their taint unchanged walked the body from the
        // converged state — it IS the oracle's real pass (one more walk from the same head
        // would repeat it), so its sink is kept and every earlier pass's is dropped.
        let mut pdiags: Vec<str> = Vec::new();
        let mut rsnap: Vec<i64> = Vec::new();
        let qs: i64 = tt_rt_snapshot(rtm, rsnap);
        // SHP-5c-1: the floors are loop-carried state too (a store late in one iteration
        // precedes a load early in the next): a pass that raised one did not converge.
        let fraw: i64 = fl.get(0);
        let ftyped: i64 = fl.get(1);
        let mut ibrk: Vec<TtBind> = Vec::new();
        let mut icnt: Vec<TtBind> = Vec::new();
        let rb: i64 = tt_block(nodes, kids, bid, env, sigs, sidx, externs, fnret, bpc, cont, ibrk, icnt, names, ld + 1, rtm, fl, pdiags);
        let mut next: Vec<TtBind> = Vec::new();
        let qj: i64 = tt_loop_join(next, names, binds, env, icnt);
        let mut same: bool = forced;
        if !same {
            if tt_env_equal(next, head, m) {
                if tt_rt_same(rtm, rsnap) {
                    if tt_fl_same(fl, fraw, ftyped) {
                        same = true;
                    }
                }
            }
        }
        if same {
            stable = true;
            let qd: i64 = tt_push_strs(diags, pdiags);
            // The exit: head ⊔ every `break`, over the pre-loop names.
            let mut out: Vec<TtBind> = Vec::new();
            let qo: i64 = tt_loop_join(out, names, binds, head, ibrk);
            let qp: i64 = tt_push_all(binds, out);
        } else {
            let qa: i64 = tt_env_assign(head, next, m);
            passes = passes + 1;
            // BOUND, sized to the state (the oracle's rule): names × 4 levels, the two floors ×
            // 4, regions × 4, and names × regions candidate-set elements, re-read every pass as
            // the body mints.
            let rn: i64 = rtm.len() / 2;
            let bound: i64 = m * 4 + 12 + rn * 4 + m * rn;
            if passes >= bound {
                // Fails CLOSED: top-taint every pre-loop name, both floors and every region
                // (the oracle's unreachable arm); the next pass reports from that head.
                let qt: i64 = tt_env_top(head, m, rtm, fl);
                forced = true;
            }
        }
    }
    // The loop variable is body-scoped: an outer binding of its name is restored.
    if pv.taint >= 0 {
        let qr: i64 = tt_upsert(binds, TtBind { name: pv.name, fields: pv.fields, taint: pv.taint, regions: pv.regions, tdesc: pv.tdesc });
    }
    return tt_pack(0, cont);
}

fn tt_stmt(nodes: Arena<PNode>, kids: Vec<i64>, sid: i64, binds: Vec<TtBind> @Mut, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>, fnret: i64, pc: i64, cont: i64, brk: Vec<TtBind> @Mut, cnt: Vec<TtBind> @Mut, prenames: Vec<str>, ld: i64, rtm: Vec<i64> @Mut, fl: Vec<i64> @Mut, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let s: PNode = nodes.get(sid);
    // Every expression folds the oracle's effective pc: the lexical pc joined with the
    // continuation that survives an earlier one-sided exit.
    let epc: i64 = tt_lub(pc, cont);

    if s.kind == P_K_LET {
        // value = the LAST child (children = [type?, value]); taint annotation = flags/2.
        let vid: i64 = kids.get(s.child_start + s.child_count - 1);
        let expr_taint: i64 = tt_expr(nodes, kids, vid, binds, sigs, sidx, externs, epc, rtm, fl, diags);
        let code: i64 = s.flags / 2;
        let declared: i64 = tt_label_of_code(code);
        // T030 — upcast @Internal/@Secret INTO a @SecretCT binding.
        if tt_is_ct(declared) {
            if expr_taint == TT_INTERNAL {
                let d: i64 = diags.push("T030;");
            } else {
                if expr_taint == TT_SECRET {
                    let d2: i64 = diags.push("T030;");
                }
            }
        }
        // T001 — downgrade without declassify.
        if !tt_can_flow(expr_taint, declared) {
            let d3: i64 = diags.push("T001;");
        }
        let effective: i64 = tt_lub(tt_lub(expr_taint, declared), epc);
        // SHP-5c-1: the binding's type descriptor — the annotation's, else the value's.
        let mut ld: str = "?";
        if s.child_count >= 2 {
            ld = tt_tdesc(nodes, kids, kids.get(s.child_start), 0);
        } else {
            ld = tt_edesc(nodes, kids, vid, binds, sigs, sidx, externs);
        }
        // PR-T2: a `let r = R { a: e0, b: e1 };` binds r PER FIELD (the oracle's
        // bind_record) so a later `r.a` read returns field a's taint, not the lub. The
        // record-construct text is "Name;f0;f1;…" (field i name = tc_seg_at(text, i+1));
        // child i is field i's value. (The whole-record value taint — for the T030/T001
        // checks above + a bare `r` reference — is `effective`/the lub, already computed
        // via tt_expr(vid). The per-field re-eval mirrors the oracle's double-eval; any
        // CT code fires on both sides and dedups to the set.)
        let vn: PNode = nodes.get(vid);
        if vn.kind == P_K_RECORD_CONSTRUCT {
            let mut enc: str = "";
            let mut lub: i64 = TT_PUBLIC;
            let mut fi: i64 = 0;
            while fi < vn.child_count {
                let fcid: i64 = kids.get(vn.child_start + fi);
                let ft: i64 = tt_expr(nodes, kids, fcid, binds, sigs, sidx, externs, epc, rtm, fl, diags);
                let fname: str = tc_seg_at(vn.text, fi + 1);
                enc = tt_enc_push(enc, fname, ft);
                lub = tt_lub(lub, ft);
                fi = fi + 1;
            }
            let pr: i64 = tt_upsert(binds, TtBind { name: s.text, fields: enc, taint: lub, regions: 0, tdesc: ld });
        } else {
            // M6 — the regions the bound value points into: every `alloc` leaf of its `+`/`-`
            // chain mints one, every regioned local leaf contributes its own; anything else
            // leaves the name unregioned (a reused name must not keep a stale region).
            let lrg: i64 = tt_regions_of_value(nodes, kids, vid, binds, rtm, diags);
            let p: i64 = tt_upsert(binds, TtBind { name: s.text, fields: "", taint: effective, regions: lrg, tdesc: ld });
        }
        return tt_pack(0, cont);
    }

    if s.kind == P_K_LET_TUPLE {
        // `let (a, b) = e;` — the oracle DESUGARS tuple lets into scalar lets before its taint
        // pass, so per-element taints ride the desugared bindings. This shadow keeps its
        // all-public projection: a public RHS under a public effective pc binds every name
        // public (text = the names joined with `;`; the grammar carries NO taint annotation on
        // tuple bindings, so there is no declared-label check to mirror). A nonpublic RHS, or a
        // nonpublic pc (which the value carries, since `tt_expr` folds it), is outside the
        // projection and fails closed.
        let tvid: i64 = kids.get(s.child_start + s.child_count - 1);
        let trhs: i64 = tt_expr(nodes, kids, tvid, binds, sigs, sidx, externs, epc, rtm, fl, diags);
        if trhs > TT_PUBLIC {
            let ult: i64 = tt_mark_unsupported(diags);
        } else {
            let mut tni: i64 = 0;
            let mut tscan: bool = true;
            while tscan {
                let tnm: str = tc_seg_at(s.text, tni);
                if tnm.len() > 0 {
                    let tpb: i64 = tt_upsert(binds, TtBind { name: tnm, fields: "", taint: TT_PUBLIC, regions: 0, tdesc: "?" });
                    tni = tni + 1;
                } else {
                    tscan = false;
                }
            }
        }
        return tt_pack(0, cont);
    }

    if s.kind == P_K_ASSIGN {
        // children = [place, value]; value field = cop (0 = simple, !=0 = compound).
        let pid: i64 = kids.get(s.child_start);
        let vid: i64 = kids.get(s.child_start + 1);
        let expr_taint: i64 = tt_expr(nodes, kids, vid, binds, sigs, sidx, externs, epc, rtm, fl, diags);
        let pn: PNode = nodes.get(pid);
        let mut eff: i64 = tt_lub(expr_taint, epc);
        if pn.kind == P_K_PATH {
            if tt_path_has_sep(pn.text) {
                // field write `r.a = e` -> RAISE the root container's WHOLE taint to a
                // scalar (the oracle's place_root_local + bind(lub) — a sound
                // over-approximation; ET-T13).
                // SHP-5c-1 (S2/S6/S7): the write lands in linear memory.
                let qfw: i64 = tt_fl_note_place_write(nodes, kids, pid, eff, binds, sigs, sidx, externs, epc, rtm, fl, diags);
                let root: str = tt_path_seg(pn.text, 0);
                let rr: i64 = tt_lub(eff, tt_read(binds, rtm, root));
                let pr: i64 = tt_upsert(binds, TtBind { name: root, fields: "", taint: rr, regions: tt_outer_regions(binds, root), tdesc: tt_env_desc(binds, root) });
            } else {
                // bare local: a compound assign (`x += y`) folds in x's current taint;
                // a simple assign overwrites.
                if s.value != 0 {
                    eff = tt_lub(eff, tt_read(binds, rtm, pn.text));
                }
                // M6 — rebinding a pointer local re-derives its regions from the value (a
                // local compound assign is `x = x op rhs` from the parser, so `p = p + 8` keeps
                // p's region and `p = alloc(8)` drops the old one — no false alias positive).
                let arg: i64 = tt_regions_of_value(nodes, kids, vid, binds, rtm, diags);
                let p: i64 = tt_upsert(binds, TtBind { name: pn.text, fields: "", taint: eff, regions: arg, tdesc: tt_env_desc(binds, pn.text) });
            }
        } else {
            // index write `arr[i] = e` (P_K_INDEX) -> raise the array's root local.
            // SHP-5c-1 (S2/S6/S7): the write lands in linear memory, at the index's address.
            let qfw2: i64 = tt_fl_note_place_write(nodes, kids, pid, eff, binds, sigs, sidx, externs, epc, rtm, fl, diags);
            let root2: str = tt_place_root(nodes, kids, pid);
            if root2.len() > 0 {
                let r2: i64 = tt_lub(eff, tt_read(binds, rtm, root2));
                let pr2: i64 = tt_upsert(binds, TtBind { name: root2, fields: "", taint: r2, regions: tt_outer_regions(binds, root2), tdesc: tt_env_desc(binds, root2) });
            }
        }
        return tt_pack(0, cont);
    }

    if s.kind == P_K_EXPR_STMT {
        if s.child_count >= 1 {
            let eid: i64 = kids.get(s.child_start);
            let en: PNode = nodes.get(eid);
            if en.kind == P_K_REGION {
                // SHP-5c-3: a region STATEMENT — its body is a block of this function.
                return tt_region_stmt(nodes, kids, eid, binds, sigs, sidx, externs, fnret, pc, cont, brk, cnt, prenames, ld, rtm, fl, diags);
            }
            let t: i64 = tt_expr(nodes, kids, eid, binds, sigs, sidx, externs, epc, rtm, fl, diags);
        }
        return tt_pack(0, cont);
    }

    if s.kind == P_K_RETURN {
        if s.child_count >= 1 {
            let vid: i64 = kids.get(s.child_start);
            let return_taint: i64 = tt_expr(nodes, kids, vid, binds, sigs, sidx, externs, epc, rtm, fl, diags);
            // T030 — upcast into a @SecretCT return.
            if tt_is_ct(fnret) {
                if return_taint == TT_INTERNAL {
                    let d: i64 = diags.push("T030;");
                } else {
                    if return_taint == TT_SECRET {
                        let d2: i64 = diags.push("T030;");
                    }
                }
            }
            // T001 — downgrade at return.
            if !tt_can_flow(return_taint, fnret) {
                let d3: i64 = diags.push("T001;");
            }
        }
        // `return` leaves the function: the rest of the block is unreachable.
        return tt_pack(1, cont);
    }

    if s.kind == P_K_IF {
        // children = [cond, then, else] (the parser synthesizes an empty else block).
        let cid: i64 = kids.get(s.child_start);
        let cond: i64 = tt_expr(nodes, kids, cid, binds, sigs, sidx, externs, epc, rtm, fl, diags);
        // T020 — a @SecretCT branch is rejected before descent, so the pc never holds SecretCT.
        if tt_is_ct(cond) {
            let d: i64 = diags.push("T020;");
            return tt_pack(0, cont);
        }
        let bpc: i64 = tt_lub(pc, cond);
        let mut names: Vec<str> = Vec::new();
        let qn: i64 = tt_env_names(binds, names);
        let mut tenv: Vec<TtBind> = Vec::new();
        let qt: i64 = tt_clone_binds(binds, tenv);
        let tid: i64 = kids.get(s.child_start + 1);
        let rt: i64 = tt_block(nodes, kids, tid, tenv, sigs, sidx, externs, fnret, bpc, cont, brk, cnt, prenames, ld, rtm, fl, diags);
        let mut eenv: Vec<TtBind> = Vec::new();
        let qe: i64 = tt_clone_binds(binds, eenv);
        let eid: i64 = kids.get(s.child_start + 2);
        let re: i64 = tt_block(nodes, kids, eid, eenv, sigs, sidx, externs, fnret, bpc, cont, brk, cnt, prenames, ld, rtm, fl, diags);
        let tdiv: i64 = tt_div_of(rt);
        let ediv: i64 = tt_div_of(re);
        // Merge ONLY the branches that fall through (a diverging branch never reaches the code
        // after the `if`), by lub over the pre-branch names (SC-T1, SC-T2).
        let mut acc: Vec<TtBind> = Vec::new();
        let mut nmaps: i64 = 0;
        if tdiv == 0 {
            let q1: i64 = tt_merge_path(acc, names, tenv, true);
            nmaps = 1;
        }
        if ediv == 0 {
            let mut efirst: bool = true;
            if nmaps > 0 {
                efirst = false;
            }
            let q2: i64 = tt_merge_path(acc, names, eenv, efirst);
            nmaps = nmaps + 1;
        }
        if nmaps > 0 {
            let q3: i64 = tt_push_all(binds, acc);
        }
        // The continuation inherits every falling-through branch's; if exactly one branch
        // exits, reaching the code after also reveals the condition.
        let mut c2: i64 = cont;
        if tdiv == 0 {
            c2 = tt_lub(c2, tt_cont_of(rt));
        }
        if ediv == 0 {
            c2 = tt_lub(c2, tt_cont_of(re));
        }
        if tdiv != ediv {
            c2 = tt_lub(c2, cond);
        }
        // The `if` diverges only if BOTH branches do.
        let mut div: i64 = 0;
        if tdiv == 1 {
            if ediv == 1 {
                div = 1;
            }
        }
        return tt_pack(div, c2);
    }

    if s.kind == P_K_WHILE {
        let cid: i64 = kids.get(s.child_start);
        let cond: i64 = tt_expr(nodes, kids, cid, binds, sigs, sidx, externs, epc, rtm, fl, diags);
        // T021 — a @SecretCT loop guard.
        if tt_is_ct(cond) {
            let d: i64 = diags.push("T021;");
            return tt_pack(0, cont);
        }
        let bid: i64 = kids.get(s.child_start + 1);
        let mut names: Vec<str> = Vec::new();
        let qn: i64 = tt_env_names(binds, names);
        let m: i64 = names.len();
        let mut empty: Vec<TtBind> = Vec::new();
        // The loop-head fixpoint (SC-T3): head = pre ⊔ fall-through(head) ⊔ every `continue`.
        // The guard is re-derived from each head (a guard variable can turn secret inside the
        // loop). Each pass walks into its own sink from a snapshot of the region taint; the
        // pass that leaves the head, the regions and their taint unchanged walked the body from
        // the converged state — it IS the oracle's real pass, so its sink is kept and every
        // earlier pass's is dropped.
        let mut head: Vec<TtBind> = Vec::new();
        let qh: i64 = tt_loop_join(head, names, binds, binds, empty);
        let mut passes: i64 = 0;
        let mut forced: bool = false;
        let mut stable: bool = false;
        while !stable {
            let mut env: Vec<TtBind> = Vec::new();
            let qc: i64 = tt_clone_binds(head, env);
            let mut pdiags: Vec<str> = Vec::new();
            let mut rsnap: Vec<i64> = Vec::new();
            let qs: i64 = tt_rt_snapshot(rtm, rsnap);
            // SHP-5c-1: the floors are loop-carried state too; a pass that raised one did not
            // converge. The guard's own diagnostics were reported by the entry check above; a
            // guard that became @SecretCT through the loop is T021 from the stabilized head
            // (below). A refusal the guard raises surfaces from any pass.
            let fraw: i64 = fl.get(0);
            let ftyped: i64 = fl.get(1);
            let mut gsink: Vec<str> = Vec::new();
            let ct: i64 = tt_expr(nodes, kids, cid, env, sigs, sidx, externs, epc, rtm, fl, gsink);
            let qg: i64 = tt_forward_refusals(diags, gsink);
            let mut ibrk: Vec<TtBind> = Vec::new();
            let mut icnt: Vec<TtBind> = Vec::new();
            let rb: i64 = tt_block(nodes, kids, bid, env, sigs, sidx, externs, fnret, tt_lub(pc, ct), cont, ibrk, icnt, names, ld + 1, rtm, fl, pdiags);
            let mut next: Vec<TtBind> = Vec::new();
            let qj: i64 = tt_loop_join(next, names, binds, env, icnt);
            let mut same: bool = forced;
            if !same {
                if tt_env_equal(next, head, m) {
                    if tt_rt_same(rtm, rsnap) {
                        if tt_fl_same(fl, fraw, ftyped) {
                            same = true;
                        }
                    }
                }
            }
            if same {
                stable = true;
                if tt_is_ct(ct) {
                    // The oracle rejects from the stabilized head without walking the body for
                    // real: the env stays pre-loop, the body's diagnostics are not reported.
                    let d2: i64 = diags.push("T021;");
                    return tt_pack(0, cont);
                }
                let qd: i64 = tt_push_strs(diags, pdiags);
                // The exit: head ⊔ every `break`, over the pre-loop names.
                let mut out: Vec<TtBind> = Vec::new();
                let qo: i64 = tt_loop_join(out, names, binds, head, ibrk);
                let qp: i64 = tt_push_all(binds, out);
            } else {
                let qa: i64 = tt_env_assign(head, next, m);
                passes = passes + 1;
                // BOUND, sized to the state (the oracle's rule): names × 4 levels, the two
                // floors × 4, regions × 4, and names × regions candidate-set elements, re-read
                // every pass as the body mints.
                let rn: i64 = rtm.len() / 2;
                let bound: i64 = m * 4 + 12 + rn * 4 + m * rn;
                if passes >= bound {
                    // Fails CLOSED: top-taint every pre-loop name, both floors and every
                    // region (the oracle's unreachable arm); the next pass reports from that
                    // head.
                    let qt: i64 = tt_env_top(head, m, rtm, fl);
                    forced = true;
                }
            }
        }
        return tt_pack(0, cont);
    }

    if s.kind == P_K_FOR_RANGE {
        // children = [start, end, body]; text = the loop variable. The bounds fix the
        // iteration count at entry: T022 if either is @SecretCT, else the body pc is fixed.
        let sid0: i64 = kids.get(s.child_start);
        let eid0: i64 = kids.get(s.child_start + 1);
        let st: i64 = tt_expr(nodes, kids, sid0, binds, sigs, sidx, externs, epc, rtm, fl, diags);
        let en: i64 = tt_expr(nodes, kids, eid0, binds, sigs, sidx, externs, epc, rtm, fl, diags);
        let bt: i64 = tt_lub(st, en);
        if tt_is_ct(bt) {
            let d: i64 = diags.push("T022;");
            return tt_pack(0, cont);
        }
        let bid: i64 = kids.get(s.child_start + 2);
        return tt_for_loop(nodes, kids, bid, s.text, bt, "i", binds, sigs, sidx, externs, fnret, pc, cont, ld, rtm, fl, diags);
    }

    if s.kind == P_K_FOR_IN {
        // children = [iterable, body]; text = loop var.
        let iid: i64 = kids.get(s.child_start);
        let it: i64 = tt_expr(nodes, kids, iid, binds, sigs, sidx, externs, epc, rtm, fl, diags);
        if tt_is_ct(it) {
            let d: i64 = diags.push("T022;");
            return tt_pack(0, cont);
        }
        let bid: i64 = kids.get(s.child_start + 1);
        // SHP-5c-1: the element binds at the iterable's element type.
        let vd: str = tt_desc_inner(tt_desc_deref(tt_edesc(nodes, kids, iid, binds, sigs, sidx, externs)));
        return tt_for_loop(nodes, kids, bid, s.text, it, vd, binds, sigs, sidx, externs, fnret, pc, cont, ld, rtm, fl, diags);
    }

    if s.kind == P_K_MATCH {
        // children = [scrutinee, arm, arm, …]; arm children [pattern, guard?, body].
        let scid: i64 = kids.get(s.child_start);
        let scrut: i64 = tt_expr(nodes, kids, scid, binds, sigs, sidx, externs, epc, rtm, fl, diags);
        if tt_is_ct(scrut) {
            let d: i64 = diags.push("T023;");
            return tt_pack(0, cont);
        }
        let selpc: i64 = tt_lub(pc, scrut);
        // SHP-5c-1: the patterns' names bind at the scrutinee's type.
        let sd: str = tt_edesc(nodes, kids, scid, binds, sigs, sidx, externs);
        let mut names: Vec<str> = Vec::new();
        let qn: i64 = tt_env_names(binds, names);
        let m: i64 = prenames.len();
        let mut acc: Vec<TtBind> = Vec::new();
        let mut nmaps: i64 = 0;
        let mut alldiv: i64 = 0;
        if s.child_count > 1 {
            alldiv = 1;
        }
        let mut contv: i64 = cont;
        let mut divt: i64 = TT_PUBLIC;
        let mut ai: i64 = 1;
        while ai < s.child_count {
            let armid: i64 = kids.get(s.child_start + ai);
            let arm: PNode = nodes.get(armid);
            // A guard joins the selection pc in the oracle; this projection does not model it.
            if arm.child_count >= 3 {
                let ug: i64 = tt_mark_unsupported(diags);
            }
            // Each arm starts from the pre-match env (SC-T4) with its pattern's names bound at
            // the scrutinee's taint joined with the effective pc; those names are arm-scoped.
            let mut env: Vec<TtBind> = Vec::new();
            let qc: i64 = tt_clone_binds(binds, env);
            let mut patnames: Vec<str> = Vec::new();
            if arm.child_count >= 1 {
                let patid: i64 = kids.get(arm.child_start);
                let qb: i64 = tt_bind_pattern(nodes, kids, patid, tt_lub(scrut, tt_lub(selpc, cont)), env, patnames, sd, sigs, sidx);
            }
            let bb: i64 = brk.len();
            let cb: i64 = cnt.len();
            let mut armdiv: i64 = 0;
            let mut armcont: i64 = cont;
            if arm.child_count >= 1 {
                let bodyid: i64 = kids.get(arm.child_start + arm.child_count - 1);
                let bn2: PNode = nodes.get(bodyid);
                if bn2.kind == P_K_BLOCK {
                    let rb: i64 = tt_block(nodes, kids, bodyid, env, sigs, sidx, externs, fnret, selpc, cont, brk, cnt, prenames, ld, rtm, fl, diags);
                    armdiv = tt_div_of(rb);
                    armcont = tt_cont_of(rb);
                } else {
                    let ub: i64 = tt_mark_unsupported(diags);
                }
            }
            // Restore the pattern's names to their pre-match binding, in the arm env and in any
            // frame a `break`/`continue` captured inside the arm (root cause 3).
            let np: i64 = patnames.len();
            let mut pi: i64 = 0;
            while pi < np {
                let pn: str = patnames.get(pi);
                let pv: TtBind = tt_env_bind(binds, pn);
                let mut rt: i64 = pv.taint;
                let mut rf: str = pv.fields;
                if rt < 0 {
                    rt = TT_PUBLIC;
                    rf = "";
                }
                let qr: i64 = tt_upsert(env, TtBind { name: pn, fields: rf, taint: rt, regions: pv.regions, tdesc: pv.tdesc });
                let j: i64 = tt_name_index(prenames, pn);
                if j >= 0 {
                    let q1: i64 = tt_patch_frames(brk, bb, m, j, TtBind { name: pn, fields: rf, taint: rt, regions: pv.regions, tdesc: pv.tdesc });
                    let q2: i64 = tt_patch_frames(cnt, cb, m, j, TtBind { name: pn, fields: rf, taint: rt, regions: pv.regions, tdesc: pv.tdesc });
                }
                pi = pi + 1;
            }
            // Only the arms that fall through reach the merge and the continuation; a diverging
            // arm contributes its control dependence instead.
            if armdiv == 0 {
                let mut afirst: bool = true;
                if nmaps > 0 {
                    afirst = false;
                }
                let qm: i64 = tt_merge_path(acc, names, env, afirst);
                nmaps = nmaps + 1;
                contv = tt_lub(contv, armcont);
                alldiv = 0;
            } else {
                divt = tt_lub(divt, tt_lub(selpc, armcont));
            }
            ai = ai + 1;
        }
        if nmaps > 0 {
            let qp: i64 = tt_push_all(binds, acc);
        }
        let mut c2: i64 = cont;
        if alldiv == 0 {
            c2 = tt_lub(contv, divt);
        }
        return tt_pack(alldiv, c2);
    }

    if s.kind == P_K_BREAK {
        // `break` jumps to the loop EXIT with the current env: capture the pre-loop names'
        // bindings for the exit join, and the rest of this block is unreachable. Outside a loop
        // the statement has no target (the type checker refuses it): fail closed.
        if ld == 0 {
            let ubr: i64 = tt_mark_unsupported(diags);
        } else {
            let qb: i64 = tt_capture(binds, prenames, brk);
        }
        return tt_pack(1, cont);
    }
    if s.kind == P_K_CONTINUE {
        // `continue` jumps to the loop HEAD: the fixpoint folds its frame in.
        if ld == 0 {
            let uco: i64 = tt_mark_unsupported(diags);
        } else {
            let qc: i64 = tt_capture(binds, prenames, cnt);
        }
        return tt_pack(1, cont);
    }
    // Any other statement kind is outside this checker projection.
    let us: i64 = tt_mark_unsupported(diags);
    return tt_pack(0, cont);
}

// Does this fn carry `@Flow` (parser code 5) on its return or any parameter?
// Taint POLYMORPHISM is outside this checker's projection: the oracle verifies
// such a body once per admissible label, which this projection does not do, and
// code 5 is not a lattice point — `tt_label_of_code` would decode it to 4, one
// above SecretCT, and every comparison downstream would be meaningless. Detect
// it so the caller can refuse rather than compute a fictional verdict.
fn tt_fn_uses_flow(nodes: Arena<PNode>, kids: Vec<i64>, fnid: i64) -> bool {
    let fnn: PNode = nodes.get(fnid);
    let rcode: i64 = (fnn.flags & 1048575) / 2;
    if rcode == 5 {
        return true;
    } else {
    }
    let mut i: i64 = 0;
    while i < fnn.child_count {
        let cid: i64 = kids.get(fnn.child_start + i);
        let cn: PNode = nodes.get(cid);
        if cn.kind == P_K_PARAM {
            let q: i64 = cn.flags / 4;
            let pcode: i64 = q - (q / 8) * 8;
            if pcode == 5 {
                return true;
            } else {
            }
        } else {
        }
        i = i + 1;
    }
    return false;
}

// ────────────────────────────────────────────────────────────────────────────
// The call-site summaries (SHP-5c-2; production's `CallSummary`, `scan_function` and
// `call_summaries`). A call's effect on the caller's heap is the callee's SUMMARY: whether
// it can have written linear memory at an existing address (`wm`: a raw store, a slot write,
// a projected-place assignment), built a heap-resident value into fresh cells (`mat`), read
// memory raw (`rr`) or typed (`rt`); the bound on the labels it mints itself (`ann`, every
// annotation in it, @Internal if it calls the host); and the parameter slots a raw write
// reachable from it can go through (`wt`, a bit mask over the parameters, -1 for every
// slot). Each fn row of the table carries its summary: a syntactic scan of the body
// (`tt_sc_*`), then the bounded closure over the call graph (`tt_sm_close`) — production's
// two steps, in its order. A call site then joins the floors the callee reads into its
// result (S8), raises the caller's floors by what the callee writes at the site's taint
// (S5) and taints the regions of the arguments it writes through (S5, region side):
// `tt_sm_site`.
// The scan is syntactic and typed by SHP-5c-1's descriptors, so two of its facts are
// three-valued (`mat`, `rt`: 1, 0, -1 unknown), and a row is reliable (`rel`) only when
// every callee it reaches is one this shadow names: a closure, an actor or effect
// operation, a call through a local, a callee with no row or with two rows under one bare
// name, more than 62 parameters, or a closure of the call graph that does not converge
// make a row unreliable. FAILURE DIRECTION: a site whose callee this shadow cannot name (a
// call through a local, a `grant` of a closure held in a local, a name with no row), a site
// that consults an unreliable row, and an unknown fact that would decide a floor all refuse
// (SH_TAINT_UNSUPPORTED); production takes its program-wide bound there, which this shadow
// cannot reproduce, and it never guesses. The pass runs only when the program can carry a
// non-public value at all (`tt_sm_signals`: a label — an effect operation's parameter label
// included, read off its K_PARAM like any parameter's — a flow signature, an extern, an FFI
// row, a `declassify_ct`);
// without one every site taint, floor and annotation is @Public and no summary changes a
// verdict, so the all-public self-compile pays one tree walk and skips the rest.
// ────────────────────────────────────────────────────────────────────────────

// The resolution markers of `tt_sm_resolve_method` (a row packs as `row * 2 + first`).
fn tt_sm_intrinsic() -> i64 {
    return 0 - 1;
}

fn tt_sm_unknown() -> i64 {
    return 0 - 2;
}

fn tt_sm_ctor() -> i64 {
    return 0 - 3;
}

// A table row with no summary yet: the defaults every row starts from (`tt_build_sigs`).
fn tt_sig_row(name: str, param_taints: str, ret_taint: i64, kind: i64, tdesc: str, ffi: bool, fnid: i64, defid: i64) -> TtSig ! { Alloc } {
    return TtSig { name: name, param_taints: param_taints, ret_taint: ret_taint, kind: kind, tdesc: tdesc, ffi: ffi, fnid: fnid, defid: defid, wm: 0, mat: 0, rr: 0, rt: 0, ann: TT_PUBLIC, wt: 0, rel: 1 };
}

// The summaries are live iff the table ends in the sentinel row `tt_sm_build` pushes.
fn tt_sm_live(sigs: Vec<TtSig>) -> bool {
    let n: i64 = sigs.len();
    if n == 0 {
        return false;
    }
    let s: TtSig = sigs.get(n - 1);
    if s.kind == TT_SK_SUM {
        return true;
    }
    return false;
}

// Slot `i`'s bit; every slot (-1) past the mask, as production's `SlotSet::slot`.
fn tt_sm_slot(i: i64) -> i64 {
    if i >= 62 {
        return 0 - 1;
    }
    return tt_pow2(i);
}

// The union of two slot sets; every-slot absorbs.
fn tt_sm_mask_lub(a: i64, b: i64) -> i64 {
    if a < 0 {
        return 0 - 1;
    }
    if b < 0 {
        return 0 - 1;
    }
    return tt_mask_union(a, b);
}

// Whether a slot set covers slot `i`.
fn tt_sm_covers(mask: i64, i: i64) -> bool {
    if mask < 0 {
        return true;
    }
    if i >= 62 {
        return false;
    }
    return tt_mask_has(mask, i);
}

// The join of two three-valued facts: known true wins, then unknown, then known false.
fn tt_sm_tri_lub(a: i64, b: i64) -> i64 {
    if a == 1 {
        return 1;
    }
    if b == 1 {
        return 1;
    }
    if a < 0 {
        return 0 - 1;
    }
    if b < 0 {
        return 0 - 1;
    }
    return 0;
}

// The fn row named `name`, or -1 when the table has none or more than one: production
// resolves a bare name two modules declare by scope, which this shadow does not know. The run
// of rows named `name` holds every candidate.
fn tt_sm_fn_row(sigs: Vec<TtSig>, sidx: TtIdx, name: str) -> i64 {
    let n: i64 = sidx.by_name.len();
    let mut found: i64 = 0 - 1;
    let mut at: i64 = tt_index_first(sigs, sidx, name);
    while at < n {
        let row: i64 = sidx.by_name.get(at);
        let s: TtSig = sigs.get(row);
        if !s.name.bytes_eq(name) {
            return found;
        }
        if s.kind == TT_SK_FN {
            if found >= 0 {
                return 0 - 1;
            }
            found = row;
        }
        at = at + 1;
    }
    return found;
}

// The fn row named `name` packed with `first`, or the unknown marker.
fn tt_sm_fn_packed(sigs: Vec<TtSig>, sidx: TtIdx, name: str, first: i64) -> i64 {
    let row: i64 = tt_sm_fn_row(sigs, sidx, name);
    if row < 0 {
        return tt_sm_unknown();
    }
    return row * 2 + first;
}

// Whether `name` constructs a payload-carrying variant of a declared enum (production's
// EnumConstruct: a value, not a call): a binary search of the sorted variant names.
fn tt_sm_is_variant(sidx: TtIdx, name: str) -> bool {
    let n: i64 = sidx.variants.len();
    let mut lo: i64 = 0;
    let mut hi: i64 = n;
    while lo < hi {
        let mid: i64 = lo + (hi - lo) / 2;
        if tc_str_lt(sidx.variants.get(mid), name) {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo < n {
        let v: str = sidx.variants.get(lo);
        if v.bytes_eq(name) {
            return true;
        }
    }
    return false;
}

// The stdlib record or enum a descriptor shape stands for, "" for the rest.
fn tt_sm_builtin_type(h: i64) -> str {
    if h == TT_D_VEC {
        return "Vec";
    }
    if h == TT_D_ARENA {
        return "Arena";
    }
    if h == TT_D_MAP {
        return "Map";
    }
    if h == TT_D_OPTION {
        return "Option";
    }
    if h == TT_D_RESULT {
        return "Result";
    }
    return "";
}

// The `str` methods the type checker lowers to intrinsics (methods.rs).
fn tt_sm_str_intrinsic(m: str) -> bool {
    if m.bytes_eq("len") {
        return true;
    }
    if m.bytes_eq("is_empty") {
        return true;
    }
    if m.bytes_eq("as_output") {
        return true;
    }
    if m.bytes_eq("byte_at") {
        return true;
    }
    if m.bytes_eq("substr") {
        return true;
    }
    return false;
}

// The `str` methods the type checker routes to a stdlib fn `str_<m>` with the receiver as
// the first argument (`strings`, `string` and `traits`).
fn tt_sm_str_routed(m: str) -> bool {
    if m.bytes_eq("find") {
        return true;
    }
    if m.bytes_eq("contains") {
        return true;
    }
    if m.bytes_eq("starts_with") {
        return true;
    }
    if m.bytes_eq("ends_with") {
        return true;
    }
    if m.bytes_eq("split_on") {
        return true;
    }
    if m.bytes_eq("trim") {
        return true;
    }
    if m.bytes_eq("parse_i64") {
        return true;
    }
    if m.bytes_eq("is_char_boundary") {
        return true;
    }
    if m.bytes_eq("bytes_eq") {
        return true;
    }
    if m.bytes_eq("parse_u64") {
        return true;
    }
    if m.bytes_eq("parse_i32") {
        return true;
    }
    if m.bytes_eq("parse_u32") {
        return true;
    }
    if m.bytes_eq("eq_ignore_case") {
        return true;
    }
    if m.bytes_eq("split_first") {
        return true;
    }
    if m.bytes_eq("concat") {
        return true;
    }
    if m.bytes_eq("join") {
        return true;
    }
    if m.bytes_eq("hash") {
        return true;
    }
    if m.bytes_eq("eq") {
        return true;
    }
    return false;
}

// The machine-int conversions, intrinsics.
fn tt_sm_int_intrinsic(m: str) -> bool {
    if m.bytes_eq("as_i32") {
        return true;
    }
    if m.bytes_eq("as_u32") {
        return true;
    }
    if m.bytes_eq("as_i64") {
        return true;
    }
    if m.bytes_eq("as_u64") {
        return true;
    }
    return false;
}

// The array and slice methods that are intrinsics (`contains` depends on the element).
fn tt_sm_array_intrinsic(m: str) -> bool {
    if m.bytes_eq("len") {
        return true;
    }
    if m.bytes_eq("is_empty") {
        return true;
    }
    if m.bytes_eq("first") {
        return true;
    }
    if m.bytes_eq("last") {
        return true;
    }
    return false;
}

// The callee production lowers a P_K_METHOD to, packed as `row * 2 + first` — `first` is
// the index of the child that is the callee's first argument: 0 when the receiver is a
// value (it becomes `self`), 1 when the receiver path names a module (`mod::f(..)`) or a
// type (`Type::f(..)`) — or a marker: an intrinsic, a variant construction (`E::V(..)`), a
// callee this shadow cannot name. A method call the monomorph expander pre-resolved (its
// flag bit 2^21; the text is the instance's name) is that instance's row.
fn tt_sm_resolve_method(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, binds: Vec<TtBind>, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(nid);
    if n.child_count < 1 {
        return tt_sm_unknown();
    }
    let q: i64 = n.flags / 2097152;
    if q - (q / 2) * 2 == 1 {
        return tt_sm_fn_packed(sigs, sidx, n.text, 0);
    }
    let rid: i64 = kids.get(n.child_start);
    let rn: PNode = nodes.get(rid);
    if rn.kind == P_K_PATH {
        if !tt_path_has_sep(rn.text) {
            let rb: TtBind = tt_env_bind(binds, rn.text);
            if rb.taint < 0 {
                if tt_tab_find(sigs, sidx, TT_SK_ENUM, rn.text) >= 0 {
                    return tt_sm_ctor();
                }
                if tt_tab_find(sigs, sidx, TT_SK_MODULE, rn.text) >= 0 {
                    return tt_sm_fn_packed(sigs, sidx, n.text, 1);
                }
                let aj: str = rn.text.concat(";");
                let arow: i64 = tt_tab_find(sigs, sidx, TT_SK_METHOD, aj.concat(n.text));
                if arow >= 0 {
                    return arow * 2 + 1;
                }
                return tt_sm_unknown();
            }
        }
    }
    let recv: str = tt_desc_deref(tt_edesc(nodes, kids, rid, binds, sigs, sidx, externs));
    let h: i64 = tt_desc_head(recv);
    if h == TT_D_NOMINAL {
        let nm: str = tt_desc_nominal(recv);
        let nj: str = nm.concat(";");
        let nrow: i64 = tt_tab_find(sigs, sidx, TT_SK_METHOD, nj.concat(n.text));
        if nrow >= 0 {
            return nrow * 2;
        }
        return tt_sm_unknown();
    }
    if h == TT_D_STR {
        if tt_sm_str_intrinsic(n.text) {
            return tt_sm_intrinsic();
        }
        if tt_sm_str_routed(n.text) {
            let sp: str = "str_";
            return tt_sm_fn_packed(sigs, sidx, sp.concat(n.text), 0);
        }
        return tt_sm_unknown();
    }
    if h == TT_D_SCALAR {
        if tt_sm_int_intrinsic(n.text) {
            return tt_sm_intrinsic();
        }
        if n.text.bytes_eq("itoa") {
            return tt_sm_fn_packed(sigs, sidx, "str_itoa", 0);
        }
        if n.text.bytes_eq("from_bytes") {
            return tt_sm_fn_packed(sigs, sidx, "str_from_bytes", 0);
        }
        if n.text.bytes_eq("valid_up_to") {
            return tt_sm_fn_packed(sigs, sidx, "str_valid_up_to", 0);
        }
        // `to_string`, `hash`, `eq`: the stdlib fn depends on the int's width or on the
        // scalar being a bool, which the scalar descriptor does not keep.
        return tt_sm_unknown();
    }
    if h == TT_D_ARRAY {
        if tt_sm_array_intrinsic(n.text) {
            return tt_sm_intrinsic();
        }
        if n.text.bytes_eq("contains") {
            let eh: i64 = tt_desc_head(tt_desc_inner(recv));
            if eh == TT_D_STR {
                return tt_sm_fn_packed(sigs, sidx, "__sigil_slice_str_contains", 0);
            }
            if eh == TT_D_SCALAR {
                return tt_sm_intrinsic();
            }
        }
        return tt_sm_unknown();
    }
    let tn: str = tt_sm_builtin_type(h);
    if tn.len() > 0 {
        let tj: str = tn.concat(";");
        let trow: i64 = tt_tab_find(sigs, sidx, TT_SK_METHOD, tj.concat(n.text));
        if trow >= 0 {
            return trow * 2;
        }
    }
    return tt_sm_unknown();
}

// Each argument against the callee's declared parameter label (production's
// check_argument_taint): T030 for an @Internal or @Secret source into a @SecretCT parameter,
// T001 for a label that cannot flow to the declared one. A `@Flow` parameter (digit 5)
// accepts every label but @SecretCT, which is T030 (production's `param.flow` arm).
fn tt_check_args(sg: TtSig, argtaints: Vec<i64>, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let na: i64 = argtaints.len();
    let mut ci: i64 = 0;
    while ci < na {
        let declared: i64 = tt_sig_param_at(sg, ci);
        let source: i64 = argtaints.get(ci);
        if declared == 5 {
            if tt_is_ct(source) {
                let d5: i64 = diags.push("T030;");
            }
        } else {
            if declared >= 0 {
                if tt_is_ct(declared) {
                    if source == TT_INTERNAL {
                        let d3: i64 = diags.push("T030;");
                    } else {
                        if source == TT_SECRET {
                            let d3b: i64 = diags.push("T030;");
                        } else {
                        }
                    }
                } else {
                }
                if !tt_can_flow(source, declared) {
                    let d4: i64 = diags.push("T001;");
                } else {
                }
            } else {
            }
        }
        ci = ci + 1;
    }
    return 0;
}

// A plain call to a name with no fn row while the summaries are live: an intrinsic or a
// variant construction has no summary; anything else — a call through a closure-typed local,
// a name this shadow cannot place — has one production applies and this shadow cannot.
fn tt_sm_unresolved(name: str, sigs: Vec<TtSig>, sidx: TtIdx, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    if !tt_sm_live(sigs) {
        return 0;
    }
    if tt_is_intrinsic_call(name) {
        return 0;
    }
    if name.bytes_eq("Some") {
        return 0;
    }
    if tt_sm_is_variant(sidx, name) {
        return 0;
    }
    let u: i64 = tt_mark_unsupported(diags);
    return 0;
}

// Row `row`'s summary applied at the call site `nid`, whose children from `first` on are
// the callee's arguments (slot = child index - first; `argslub` their join, under the
// effective pc). S8: the floors the callee reads, returned to join the result. S5: the
// floors its writes raise, at the join of the site's taint with the callee's own bound;
// region side: the regions of every argument it writes through. @Public and nothing raised
// while the summaries are not live (an inert program).
fn tt_sm_site(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, first: i64, row: i64, argslub: i64, binds: Vec<TtBind>, sigs: Vec<TtSig>, sidx: TtIdx, pc: i64, rtm: Vec<i64> @Mut, fl: Vec<i64> @Mut, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    if !tt_sm_live(sigs) {
        return TT_PUBLIC;
    }
    let sg: TtSig = sigs.get(row);
    if sg.rel == 0 {
        let u0: i64 = tt_mark_unsupported(diags);
        return TT_PUBLIC;
    }
    if sg.kind == TT_SK_FN {
        if tt_sm_fn_row(sigs, sidx, sg.name) < 0 {
            let u1: i64 = tt_mark_unsupported(diags);
            return TT_PUBLIC;
        }
    }
    let mut rf: i64 = TT_PUBLIC;
    if sg.rr == 1 {
        rf = tt_lub(rf, fl.get(0));
    }
    if sg.rt == 1 {
        rf = tt_lub(rf, fl.get(1));
    }
    if sg.rt < 0 {
        if fl.get(1) > TT_PUBLIC {
            let u2: i64 = tt_mark_unsupported(diags);
        }
    }
    let site: i64 = tt_lub(tt_lub(argslub, pc), rf);
    let written: i64 = tt_lub(sg.ann, site);
    if written > TT_PUBLIC {
        let mut raw: i64 = TT_PUBLIC;
        let mut typed: i64 = TT_PUBLIC;
        if sg.wm == 1 {
            raw = written;
            typed = written;
        } else {
            if sg.mat == 1 {
                raw = written;
            }
            if sg.mat < 0 {
                let u3: i64 = tt_mark_unsupported(diags);
            }
        }
        let qf: i64 = tt_fl_raise(fl, raw, typed);
        let n: PNode = nodes.get(nid);
        let mut ci: i64 = first;
        while ci < n.child_count {
            if tt_sm_covers(sg.wt, ci - first) {
                let regs: i64 = tt_regions_of_expr(nodes, kids, kids.get(n.child_start + ci), binds);
                let qr: i64 = tt_rt_raise(rtm, regs, written);
            }
            ci = ci + 1;
        }
    }
    return rf;
}

// ── The scan of one fn body (production's `scan_function`, `scan_stmts`, `scan_expr`).
// `st` is the running state: [wm, mat, rr, rt, ann, ext, unk, wt, mentioned, rel]. `rn`/`rm`
// is the rooted map (name -> slot set): by name over the whole body and monotone, as
// production's (a pointer that ever derived from a parameter stays attributed to it).
// `ec`/`ea`/`eo`/`er` are the current pass's edges: callee row (-1: unnamed), argument
// count, offset into `er`, and the arguments' roots. `binds` is the descriptor env; a nested
// block, arm or loop body scans a clone of it, so a use reads its own binding's type.

// Set a three-valued fact: known true wins, unknown never hides a known true.
fn tt_sc_tri(st: Vec<i64> @Mut, i: i64, v: i64) -> i64 {
    if v == 1 {
        let q: i64 = st.set(i, 1);
        return 0;
    }
    if v < 0 {
        if st.get(i) == 0 {
            let q2: i64 = st.set(i, 0 - 1);
        }
    }
    return 0;
}

// The slots a local is rooted in (none for a name never rooted).
fn tt_sc_roots_of(rn: Vec<str>, rm: Vec<i64>, name: str) -> i64 {
    let n: i64 = rn.len();
    let mut i: i64 = 0;
    while i < n {
        let s: str = rn.get(i);
        if s.bytes_eq(name) {
            return rm.get(i);
        }
        i = i + 1;
    }
    return 0;
}

// Root `name` in `roots` (a `let` or a rebind), monotone.
fn tt_sc_root(rn: Vec<str> @Mut, rm: Vec<i64> @Mut, name: str, roots: i64) -> i64 ! { Alloc } {
    let n: i64 = rn.len();
    let mut i: i64 = 0;
    while i < n {
        let s: str = rn.get(i);
        if s.bytes_eq(name) {
            let q: i64 = rm.set(i, tt_sm_mask_lub(rm.get(i), roots));
            return 0;
        }
        i = i + 1;
    }
    let p1: i64 = rn.push(name);
    let p2: i64 = rm.push(roots);
    return 0;
}

// A mention of a rooted local: what `tt_sc_roots` collects for the enclosing `let`,
// argument or store operand.
fn tt_sc_mention(st: Vec<i64> @Mut, rn: Vec<str>, rm: Vec<i64>, name: str) -> i64 {
    let q: i64 = st.set(8, tt_sm_mask_lub(st.get(8), tt_sc_roots_of(rn, rm, name)));
    return 0;
}

// Whether `name` is a type parameter of fn `fnid` or of the impl's type def `defid`.
fn tt_sc_is_tp(nodes: Arena<PNode>, kids: Vec<i64>, fnid: i64, defid: i64, name: str) -> bool {
    let mut owner: i64 = fnid;
    let mut pass: i64 = 0;
    while pass < 2 {
        if owner >= 0 {
            let own: PNode = nodes.get(owner);
            let mut i: i64 = 0;
            while i < own.child_count {
                let cid: i64 = kids.get(own.child_start + i);
                let cn: PNode = nodes.get(cid);
                if cn.kind == P_K_TYPE_PARAM {
                    let pname: str = tc_seg_at(cn.text, 0);
                    if pname.bytes_eq(name) {
                        return true;
                    }
                }
                i = i + 1;
            }
        }
        owner = defid;
        pass = pass + 1;
    }
    return false;
}

// The descriptor of a declared type inside fn `fnid` (of impl type def `defid`): every leaf that
// names a type parameter of either reads as `?` — an instance's type is not in this shadow's
// view — so `self: Vec<T>` is `V?`, a vector of unknown element, and its fields still type
// through the record rows.
fn tt_sc_tdesc(nodes: Arena<PNode>, kids: Vec<i64>, tid: i64, fnid: i64, defid: i64) -> str ! { Alloc } {
    return tt_tdesc_tp(nodes, kids, tid, fnid, defid, 0);
}

// The slots the locals mentioned anywhere inside `nid` are rooted in (production's
// `scan_roots`): the expression is scanned, and what it mentioned is returned and kept in
// the outer running join.
fn tt_sc_roots(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, fnid: i64, defid: i64, binds: Vec<TtBind> @Mut, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>, st: Vec<i64> @Mut, rn: Vec<str> @Mut, rm: Vec<i64> @Mut, ec: Vec<i64> @Mut, ea: Vec<i64> @Mut, eo: Vec<i64> @Mut, er: Vec<i64> @Mut) -> i64 ! { Alloc } {
    let outer: i64 = st.get(8);
    let q0: i64 = st.set(8, 0);
    let s: i64 = tt_sc_expr(nodes, kids, nid, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
    let roots: i64 = st.get(8);
    let q1: i64 = st.set(8, tt_sm_mask_lub(outer, roots));
    return roots;
}

// Scan the children of `nid` from `first` on as operands.
fn tt_sc_children(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, first: i64, fnid: i64, defid: i64, binds: Vec<TtBind> @Mut, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>, st: Vec<i64> @Mut, rn: Vec<str> @Mut, rm: Vec<i64> @Mut, ec: Vec<i64> @Mut, ea: Vec<i64> @Mut, eo: Vec<i64> @Mut, er: Vec<i64> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(nid);
    let mut i: i64 = first;
    while i < n.child_count {
        let s: i64 = tt_sc_expr(nodes, kids, kids.get(n.child_start + i), fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
        i = i + 1;
    }
    return 0;
}

// The join of the roots of the children of `nid` from `first` on (each scanned).
fn tt_sc_children_roots(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, first: i64, fnid: i64, defid: i64, binds: Vec<TtBind> @Mut, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>, st: Vec<i64> @Mut, rn: Vec<str> @Mut, rm: Vec<i64> @Mut, ec: Vec<i64> @Mut, ea: Vec<i64> @Mut, eo: Vec<i64> @Mut, er: Vec<i64> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(nid);
    let mut acc: i64 = 0;
    let mut i: i64 = first;
    while i < n.child_count {
        let r: i64 = tt_sc_roots(nodes, kids, kids.get(n.child_start + i), fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
        acc = tt_sm_mask_lub(acc, r);
        i = i + 1;
    }
    return 0 + acc;
}

// A call edge to `row` (-1: a callee with no row) whose arguments are the children of
// `nid` from `first` on, each scanned for its roots. The edge's argument slots are reserved
// in `er` before any argument is scanned and each is filled after its argument: a call
// nested in an argument records its own edge, and its own roots, past this block, so this
// edge's roots stay together at its offset (production keeps a vector per edge).
fn tt_sc_edge(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, first: i64, row: i64, fnid: i64, defid: i64, binds: Vec<TtBind> @Mut, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>, st: Vec<i64> @Mut, rn: Vec<str> @Mut, rm: Vec<i64> @Mut, ec: Vec<i64> @Mut, ea: Vec<i64> @Mut, eo: Vec<i64> @Mut, er: Vec<i64> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(nid);
    let mut argc: i64 = n.child_count - first;
    if argc < 0 {
        argc = 0;
    }
    let off: i64 = er.len();
    let p0: i64 = ec.push(row);
    let p1: i64 = ea.push(argc);
    let p2: i64 = eo.push(off);
    let mut z: i64 = 0;
    while z < argc {
        let p3: i64 = er.push(0);
        z = z + 1;
    }
    let mut i: i64 = 0;
    while i < argc {
        let r: i64 = tt_sc_roots(nodes, kids, kids.get(n.child_start + first + i), fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
        let p4: i64 = er.set(off + i, r);
        i = i + 1;
    }
    if row < 0 {
        let q: i64 = st.set(9, 0);
    }
    return 0;
}

// A plain call (production's Intrinsic, ExternCall, EnumConstruct, IndirectCall and Call
// arms, classified by name as `tt_call` does).
fn tt_sc_call(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, fnid: i64, defid: i64, binds: Vec<TtBind> @Mut, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>, st: Vec<i64> @Mut, rn: Vec<str> @Mut, rm: Vec<i64> @Mut, ec: Vec<i64> @Mut, ea: Vec<i64> @Mut, eo: Vec<i64> @Mut, er: Vec<i64> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(nid);
    let name: str = tc_seg_at(n.text, 0);
    if tt_is_intrinsic_call(name) {
        // The one classification the intraprocedural arm also uses (production's
        // `intrinsic_memory`): a raw read, a raw write through the join of every operand's
        // roots (which operand is the address is not consulted — fail closed), a checked
        // write; the rest touch no memory of the caller's. The value arguments start after
        // the explicit type-arg children (`flags`, SHP-5c-3: `slot_new::<C>()`).
        let ops: i64 = tt_sc_children_roots(nodes, kids, nid, n.flags, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
        let mut raw_read: bool = false;
        if name.bytes_eq("load8") {
            raw_read = true;
        }
        if name.bytes_eq("vec_load") {
            raw_read = true;
        }
        if name.bytes_eq("str_from_raw") {
            raw_read = true;
        }
        if raw_read {
            let q0: i64 = st.set(2, 1);
        }
        let mut raw_write: bool = false;
        if name.bytes_eq("store8") {
            raw_write = true;
        }
        if name.bytes_eq("vec_store") {
            raw_write = true;
        }
        if raw_write {
            let q1: i64 = st.set(0, 1);
            let q2: i64 = st.set(7, tt_sm_mask_lub(st.get(7), ops));
        }
        if name.bytes_eq("slot_put") {
            let q3: i64 = st.set(0, 1);
        }
        if name.bytes_eq("slot_take") {
            let q4: i64 = st.set(0, 1);
        }
        return 0;
    }
    if name.bytes_eq("Some") {
        return tt_sc_children(nodes, kids, nid, 0, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
    }
    if tt_sm_is_variant(sidx, name) {
        return tt_sc_children(nodes, kids, nid, 0, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
    }
    if tt_name_in(externs, name) {
        let q5: i64 = st.set(5, 1);
        return tt_sc_children(nodes, kids, nid, 0, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
    }
    let lb: TtBind = tt_env_bind(binds, name);
    if lb.taint >= 0 {
        // A call through a local: production's IndirectCall names no target and takes the
        // program-wide bound; every argument and the local's own roots are handed over.
        let q6: i64 = st.set(6, 1);
        let handed: i64 = tt_sc_children_roots(nodes, kids, nid, 0, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
        let q7: i64 = st.set(7, tt_sm_mask_lub(st.get(7), tt_sm_mask_lub(handed, tt_sc_roots_of(rn, rm, name))));
        return 0;
    }
    let row: i64 = tt_sm_fn_row(sigs, sidx, name);
    return tt_sc_edge(nodes, kids, nid, 0, row, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
}

// A method call: the callee production lowers it to (`tt_sm_resolve_method`).
fn tt_sc_method(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, fnid: i64, defid: i64, binds: Vec<TtBind> @Mut, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>, st: Vec<i64> @Mut, rn: Vec<str> @Mut, rm: Vec<i64> @Mut, ec: Vec<i64> @Mut, ea: Vec<i64> @Mut, eo: Vec<i64> @Mut, er: Vec<i64> @Mut) -> i64 ! { Alloc } {
    let r: i64 = tt_sm_resolve_method(nodes, kids, nid, binds, sigs, sidx, externs);
    if r >= 0 {
        let row: i64 = r / 2;
        let first: i64 = r - (r / 2) * 2;
        return tt_sc_edge(nodes, kids, nid, first, row, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
    }
    if r == tt_sm_ctor() {
        return tt_sc_children(nodes, kids, nid, 1, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
    }
    if r == tt_sm_intrinsic() {
        // None of the method intrinsics reads or writes raw memory; the children are
        // operands (the typed read they make is the choke point's).
        return tt_sc_children(nodes, kids, nid, 0, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
    }
    return tt_sc_edge(nodes, kids, nid, 0, 0 - 1, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
}

// One expression (production's `scan_expr`): its typed-read and materialisation facts at
// the two choke points, then its kind.
fn tt_sc_expr(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, fnid: i64, defid: i64, binds: Vec<TtBind> @Mut, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>, st: Vec<i64> @Mut, rn: Vec<str> @Mut, rm: Vec<i64> @Mut, ec: Vec<i64> @Mut, ea: Vec<i64> @Mut, eo: Vec<i64> @Mut, er: Vec<i64> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(nid);
    if n.kind == P_K_BLOCK {
        return tt_sc_block(nodes, kids, nid, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
    }
    let rt: i64 = tt_reads_typed(nodes, kids, nid, binds, sigs, sidx, externs);
    let q0: i64 = tt_sc_tri(st, 3, rt);
    let mut plain: bool = false;
    if n.kind == P_K_PATH {
        if !tt_path_has_sep(n.text) {
            let pb: TtBind = tt_env_bind(binds, n.text);
            if pb.taint >= 0 {
                plain = true;
            }
        }
    }
    if !plain {
        // S5 (round 4): any heap-resident value that is not a plain re-read of a local was
        // built into fresh cells here.
        let q1: i64 = tt_sc_tri(st, 1, tt_desc_heap(tt_edesc(nodes, kids, nid, binds, sigs, sidx, externs)));
    }
    if n.kind == P_K_PATH {
        if tt_path_has_sep(n.text) {
            let base: str = tt_path_seg(n.text, 0);
            let bb: TtBind = tt_env_bind(binds, base);
            if bb.taint >= 0 {
                let q2: i64 = tt_sc_mention(st, rn, rm, base);
            }
        } else {
            if plain {
                let q3: i64 = tt_sc_mention(st, rn, rm, n.text);
            }
        }
        return 0;
    }
    if n.kind == P_K_CALL {
        return tt_sc_call(nodes, kids, nid, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
    }
    if n.kind == P_K_METHOD {
        return tt_sc_method(nodes, kids, nid, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
    }
    if n.kind == P_K_CLOSURE {
        // S9: the lifted body is a callee production names by its own row; this shadow has
        // none for it.
        let q4: i64 = st.set(9, 0);
        return 0;
    }
    let mut unnamed: bool = false;
    if n.kind == P_K_SEND {
        unnamed = true;
    }
    if n.kind == P_K_ASK {
        unnamed = true;
    }
    if n.kind == P_K_SPAWN {
        unnamed = true;
    }
    if n.kind == P_K_PERFORM {
        unnamed = true;
    }
    if n.kind == P_K_CLAUSE_HANDLE {
        unnamed = true;
    }
    if unnamed {
        // An actor's handler or an effect's clause is not a named callee: every pointer
        // handed over may be written through, and the summary takes the program-wide bound,
        // which this shadow does not apply.
        let q5: i64 = st.set(6, 1);
        let handed: i64 = tt_sc_children_roots(nodes, kids, nid, 0, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
        let q6: i64 = st.set(7, tt_sm_mask_lub(st.get(7), handed));
        return 0;
    }
    if n.kind == P_K_GRANT {
        // children [cap, body]: a closure literal body is reached as a call edge in
        // production (S9); any other body names no target.
        let qc: i64 = tt_sc_expr(nodes, kids, kids.get(n.child_start), fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
        if n.child_count >= 2 {
            let gbid: i64 = kids.get(n.child_start + 1);
            let gbn: PNode = nodes.get(gbid);
            let handed2: i64 = tt_sc_roots(nodes, kids, gbid, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
            if gbn.kind != P_K_CLOSURE {
                let q7: i64 = st.set(6, 1);
                let q8: i64 = st.set(7, tt_sm_mask_lub(st.get(7), handed2));
            }
        }
        return 0;
    }
    if n.kind == P_K_HANDLE {
        return tt_sc_children(nodes, kids, nid, 0, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
    }
    if n.kind == P_K_REGION {
        return tt_sc_children(nodes, kids, nid, 0, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
    }
    let mut operands: bool = false;
    if n.kind == P_K_LIT_INT {
        operands = true;
    }
    if n.kind == P_K_LIT_BOOL {
        operands = true;
    }
    if n.kind == P_K_LIT_FLOAT {
        operands = true;
    }
    if n.kind == P_K_LIT_STR {
        operands = true;
    }
    if n.kind == P_K_BINARY {
        operands = true;
    }
    if n.kind == P_K_INDEX {
        operands = true;
    }
    if n.kind == P_K_SLICE {
        operands = true;
    }
    if n.kind == P_K_TRY {
        operands = true;
    }
    if n.kind == P_K_BORROW {
        operands = true;
    }
    if n.kind == P_K_DECLASSIFY {
        operands = true;
    }
    if n.kind == P_K_DECLASSIFY_CT {
        operands = true;
    }
    if n.kind == P_K_RESULT_CTOR {
        operands = true;
    }
    if n.kind == P_K_ARRAY {
        operands = true;
    }
    if n.kind == P_K_TUPLE {
        operands = true;
    }
    if n.kind == P_K_RECORD_CONSTRUCT {
        operands = true;
    }
    if n.kind == P_K_FSTRING {
        operands = true;
    }
    if n.kind == P_K_CAP_RESTRICT {
        operands = true;
    }
    if n.kind == P_K_CAP_RESTRICT_DEADLINE {
        operands = true;
    }
    if n.kind == P_K_CAP_SPLIT {
        operands = true;
    }
    if n.kind == P_K_CAP_DRAW {
        operands = true;
    }
    if n.kind == P_K_MINT {
        operands = true;
    }
    if !operands {
        // A kind this scan does not know: fail closed.
        let q9: i64 = st.set(9, 0);
    }
    return tt_sc_children(nodes, kids, nid, 0, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
}

// SHP-5c-3: `region name(limit) { body }` as a statement. Production: T029 on a @SecretCT
// limit (the allocation size is observable through the heap layout), then the body as a
// block of the enclosing function at the same pc, with the name bound to the region handle
// (a public integer-shaped value). Production's T254 lattice — a value born in the body may not
// reach a sink of a shallower region — is not mirrored; in its place the scalar-only rule
// (tt_region_body_scalar) admits a body and refuses (the marker) every other, so no region
// program reads clean where the lattice rejects it. The body's environment is a copy of the
// enclosing one, as production's is; a write through a binding made before the body
// (`p.x = secret`) changes that binding's label, which the merge below carries out. A bare
// outer name cannot be rebound in the body (production's T042, mirrored by the tc).
fn tt_region_stmt(nodes: Arena<PNode>, kids: Vec<i64>, rid: i64, binds: Vec<TtBind> @Mut, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>, fnret: i64, pc: i64, cont: i64, brk: Vec<TtBind> @Mut, cnt: Vec<TtBind> @Mut, prenames: Vec<str>, ld: i64, rtm: Vec<i64> @Mut, fl: Vec<i64> @Mut, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let rn: PNode = nodes.get(rid);
    let epc: i64 = tt_lub(pc, cont);
    if rn.child_count != 2 {
        let u0: i64 = tt_mark_unsupported(diags);
        return tt_pack(0, cont);
    }
    let lid: i64 = kids.get(rn.child_start);
    let lim: i64 = tt_expr(nodes, kids, lid, binds, sigs, sidx, externs, epc, rtm, fl, diags);
    if tt_is_ct(lim) {
        let d29: i64 = diags.push("T029;");
    }
    let bid: i64 = kids.get(rn.child_start + 1);
    let mut names: Vec<str> = Vec::new();
    let qn0: i64 = tt_env_names(binds, names);
    let hb: TtBind = TtBind { name: rn.text, fields: "", taint: TT_PUBLIC, regions: 0, tdesc: "i" };
    let mut scratch: Vec<TtBind> = Vec::new();
    let qc: i64 = tt_clone_binds(binds, scratch);
    let qh: i64 = tt_upsert(scratch, hb);
    let ok: bool = tt_region_body_scalar(nodes, kids, bid, names, scratch, sigs, sidx, externs);
    if !ok {
        let u1: i64 = tt_mark_unsupported(diags);
        return tt_pack(0, cont);
    }
    let mut env: Vec<TtBind> = Vec::new();
    let qe: i64 = tt_clone_binds(binds, env);
    let qh2: i64 = tt_upsert(env, hb);
    let r: i64 = tt_block(nodes, kids, bid, env, sigs, sidx, externs, fnret, pc, cont, brk, cnt, prenames, ld, rtm, fl, diags);
    let mut acc: Vec<TtBind> = Vec::new();
    let q1: i64 = tt_merge_path(acc, names, env, true);
    let q2: i64 = tt_push_all(binds, acc);
    return tt_pack(0, tt_cont_of(r));
}

// SHP-5c-3: the scalar-only rule for a region body. Every `let` binds a scalar (the
// annotation's descriptor, else the value's); every expression statement and assigned value is
// scalar-only (tt_region_expr_scalar); any other statement kind (control flow — production's
// T068 — a tuple let) fails the rule. `outer` names the bindings in scope before the body:
// a bare reference to one is not born in the region, whatever its type. `env` is a scratch
// copy of the environment, extended with the body's lets so later statements resolve.
fn tt_region_body_scalar(nodes: Arena<PNode>, kids: Vec<i64>, bid: i64, outer: Vec<str>, env: Vec<TtBind> @Mut, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>) -> bool ! { Alloc } {
    let bn: PNode = nodes.get(bid);
    let mut i: i64 = 0;
    while i < bn.child_count {
        let s: PNode = nodes.get(kids.get(bn.child_start + i));
        let mut known: bool = false;
        if s.kind == P_K_LET {
            known = true;
            let vid: i64 = kids.get(s.child_start + s.child_count - 1);
            let mut d: str = "?";
            if s.child_count >= 2 {
                d = tt_tdesc(nodes, kids, kids.get(s.child_start), 0);
            } else {
                d = tt_edesc(nodes, kids, vid, env, sigs, sidx, externs);
            }
            if tt_desc_head(d) != TT_D_SCALAR {
                return false;
            }
            if !tt_region_expr_scalar(nodes, kids, vid, outer, env, sigs, sidx, externs) {
                return false;
            }
            let qb: i64 = tt_upsert(env, TtBind { name: s.text, fields: "", taint: TT_PUBLIC, regions: 0, tdesc: d });
        }
        if s.kind == P_K_EXPR_STMT {
            known = true;
            if s.child_count >= 1 {
                if !tt_region_expr_scalar(nodes, kids, kids.get(s.child_start), outer, env, sigs, sidx, externs) {
                    return false;
                }
            }
        }
        if s.kind == P_K_ASSIGN {
            known = true;
            if s.child_count != 2 {
                return false;
            }
            let avid: i64 = kids.get(s.child_start + 1);
            if tt_desc_head(tt_edesc(nodes, kids, avid, env, sigs, sidx, externs)) != TT_D_SCALAR {
                return false;
            }
            if !tt_region_expr_scalar(nodes, kids, avid, outer, env, sigs, sidx, externs) {
                return false;
            }
        }
        if !known {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// SHP-5c-3: an expression inside a region body is scalar-only when it constructs no heap value
// and hands no region-born value to a call: a literal or a name; an arithmetic or comparison
// over scalar-only operands; a call or method whose every argument (and receiver) is a scalar
// or a bare name bound before the body, each argument itself scalar-only; an index, a try, a
// declassify over scalar-only operands. A construct (record, array, tuple, closure, f-string,
// result), a slice, a borrow, a capability operation and every other kind fail the rule.
fn tt_region_expr_scalar(nodes: Arena<PNode>, kids: Vec<i64>, eid: i64, outer: Vec<str>, env: Vec<TtBind>, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>) -> bool ! { Alloc } {
    let n: PNode = nodes.get(eid);
    if n.kind == P_K_LIT_INT {
        return true;
    }
    if n.kind == P_K_LIT_BOOL {
        return true;
    }
    if n.kind == P_K_LIT_FLOAT {
        return true;
    }
    if n.kind == P_K_LIT_STR {
        return true;
    }
    if n.kind == P_K_PATH {
        return true;
    }
    if n.kind == P_K_BINARY {
        if !tt_region_expr_scalar(nodes, kids, kids.get(n.child_start), outer, env, sigs, sidx, externs) {
            return false;
        }
        return tt_region_expr_scalar(nodes, kids, kids.get(n.child_start + 1), outer, env, sigs, sidx, externs);
    }
    let mut passthrough: bool = false;
    if n.kind == P_K_INDEX {
        passthrough = true;
    }
    if n.kind == P_K_TRY {
        passthrough = true;
    }
    if n.kind == P_K_DECLASSIFY {
        passthrough = true;
    }
    if n.kind == P_K_DECLASSIFY_CT {
        passthrough = true;
    }
    if passthrough {
        let mut pi: i64 = 0;
        while pi < n.child_count {
            if !tt_region_expr_scalar(nodes, kids, kids.get(n.child_start + pi), outer, env, sigs, sidx, externs) {
                return false;
            }
            pi = pi + 1;
        }
        return true;
    }
    let mut iscall: bool = n.kind == P_K_CALL;
    if n.kind == P_K_METHOD {
        iscall = true;
    }
    if iscall {
        // A call's arguments start after its type-arg children; a method's receiver is its
        // first child and is held to the same rule as an argument.
        let mut ai: i64 = n.flags;
        while ai < n.child_count {
            let aid: i64 = kids.get(n.child_start + ai);
            let an: PNode = nodes.get(aid);
            let mut handed_ok: bool = tt_desc_head(tt_edesc(nodes, kids, aid, env, sigs, sidx, externs)) == TT_D_SCALAR;
            if an.kind == P_K_PATH {
                if !tt_path_has_sep(an.text) {
                    if tt_name_index(outer, an.text) >= 0 {
                        handed_ok = true;
                    }
                }
            }
            if !handed_ok {
                return false;
            }
            if !tt_region_expr_scalar(nodes, kids, aid, outer, env, sigs, sidx, externs) {
                return false;
            }
            ai = ai + 1;
        }
        return true;
    }
    return false;
}

// A block: its statements over a clone of the env, so its `let`s never escape it.
fn tt_sc_block(nodes: Arena<PNode>, kids: Vec<i64>, bid: i64, fnid: i64, defid: i64, binds: Vec<TtBind>, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>, st: Vec<i64> @Mut, rn: Vec<str> @Mut, rm: Vec<i64> @Mut, ec: Vec<i64> @Mut, ea: Vec<i64> @Mut, eo: Vec<i64> @Mut, er: Vec<i64> @Mut) -> i64 ! { Alloc } {
    let bn: PNode = nodes.get(bid);
    let mut env: Vec<TtBind> = Vec::new();
    let qc: i64 = tt_clone_binds(binds, env);
    let mut i: i64 = 0;
    while i < bn.child_count {
        let s: i64 = tt_sc_stmt(nodes, kids, kids.get(bn.child_start + i), fnid, defid, env, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
        i = i + 1;
    }
    return 0;
}

// A loop body with its variable bound at `vd`, over a clone of the env.
fn tt_sc_loop_body(nodes: Arena<PNode>, kids: Vec<i64>, bid: i64, var: str, vd: str, fnid: i64, defid: i64, binds: Vec<TtBind>, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>, st: Vec<i64> @Mut, rn: Vec<str> @Mut, rm: Vec<i64> @Mut, ec: Vec<i64> @Mut, ea: Vec<i64> @Mut, eo: Vec<i64> @Mut, er: Vec<i64> @Mut) -> i64 ! { Alloc } {
    let mut env: Vec<TtBind> = Vec::new();
    let qc: i64 = tt_clone_binds(binds, env);
    let qv: i64 = tt_upsert(env, TtBind { name: var, fields: "", taint: 0, regions: 0, tdesc: vd });
    return tt_sc_block(nodes, kids, bid, fnid, defid, env, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
}

// One statement (production's `scan_stmts`).
fn tt_sc_stmt(nodes: Arena<PNode>, kids: Vec<i64>, sid: i64, fnid: i64, defid: i64, binds: Vec<TtBind> @Mut, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>, st: Vec<i64> @Mut, rn: Vec<str> @Mut, rm: Vec<i64> @Mut, ec: Vec<i64> @Mut, ea: Vec<i64> @Mut, eo: Vec<i64> @Mut, er: Vec<i64> @Mut) -> i64 ! { Alloc } {
    let s: PNode = nodes.get(sid);
    if s.kind == P_K_LET {
        // The annotation bound, then the name rooted wherever its value mentions a rooted
        // local, then its type for the uses that follow.
        let code: i64 = s.flags / 2;
        let q0: i64 = st.set(4, tt_lub(st.get(4), tt_label_of_code(code)));
        let vid: i64 = kids.get(s.child_start + s.child_count - 1);
        let roots: i64 = tt_sc_roots(nodes, kids, vid, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
        let q1: i64 = tt_sc_root(rn, rm, s.text, roots);
        let mut ld: str = "?";
        if s.child_count >= 2 {
            ld = tt_sc_tdesc(nodes, kids, kids.get(s.child_start), fnid, defid);
        } else {
            ld = tt_edesc(nodes, kids, vid, binds, sigs, sidx, externs);
        }
        let q2: i64 = tt_upsert(binds, TtBind { name: s.text, fields: "", taint: 0, regions: 0, tdesc: ld });
        return 0;
    }
    if s.kind == P_K_LET_TUPLE {
        // Production desugars the tuple let into one let per name, each over the value.
        let tvid: i64 = kids.get(s.child_start + s.child_count - 1);
        let troots: i64 = tt_sc_roots(nodes, kids, tvid, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
        let mut ti: i64 = 0;
        let mut tscan: bool = true;
        while tscan {
            let tnm: str = tc_seg_at(s.text, ti);
            if tnm.len() > 0 {
                let q3: i64 = tt_sc_root(rn, rm, tnm, troots);
                let q4: i64 = tt_upsert(binds, TtBind { name: tnm, fields: "", taint: 0, regions: 0, tdesc: "?" });
                ti = ti + 1;
            } else {
                tscan = false;
            }
        }
        return 0;
    }
    if s.kind == P_K_ASSIGN {
        // A bare `x = v` rebinds a local (rooted like a `let`); any other place writes a cell
        // of linear memory (fail closed: the default arm is the memory-writing one), and the
        // place's own reads count.
        let pid: i64 = kids.get(s.child_start);
        let vid2: i64 = kids.get(s.child_start + 1);
        let pn: PNode = nodes.get(pid);
        let mut local: bool = false;
        if pn.kind == P_K_PATH {
            if !tt_path_has_sep(pn.text) {
                local = true;
            }
        }
        if local {
            let aroots: i64 = tt_sc_roots(nodes, kids, vid2, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
            let q5: i64 = tt_sc_root(rn, rm, pn.text, aroots);
            return 0;
        }
        let q6: i64 = st.set(0, 1);
        let qp: i64 = tt_sc_expr(nodes, kids, pid, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
        let vroots: i64 = tt_sc_roots(nodes, kids, vid2, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
        return 0;
    }
    if s.kind == P_K_EXPR_STMT {
        if s.child_count >= 1 {
            let qe: i64 = tt_sc_expr(nodes, kids, kids.get(s.child_start), fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
        }
        return 0;
    }
    if s.kind == P_K_RETURN {
        if s.child_count >= 1 {
            let qr: i64 = tt_sc_expr(nodes, kids, kids.get(s.child_start), fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
        }
        return 0;
    }
    if s.kind == P_K_IF {
        let qi: i64 = tt_sc_expr(nodes, kids, kids.get(s.child_start), fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
        let qt: i64 = tt_sc_block(nodes, kids, kids.get(s.child_start + 1), fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
        let qel: i64 = tt_sc_block(nodes, kids, kids.get(s.child_start + 2), fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
        return 0;
    }
    if s.kind == P_K_WHILE {
        let qw: i64 = tt_sc_expr(nodes, kids, kids.get(s.child_start), fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
        let qb: i64 = tt_sc_block(nodes, kids, kids.get(s.child_start + 1), fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
        return 0;
    }
    if s.kind == P_K_FOR_RANGE {
        let qs: i64 = tt_sc_expr(nodes, kids, kids.get(s.child_start), fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
        let qn: i64 = tt_sc_expr(nodes, kids, kids.get(s.child_start + 1), fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
        return tt_sc_loop_body(nodes, kids, kids.get(s.child_start + 2), s.text, "i", fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
    }
    if s.kind == P_K_FOR_IN {
        let iid: i64 = kids.get(s.child_start);
        let qit: i64 = tt_sc_expr(nodes, kids, iid, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
        let vd: str = tt_desc_inner(tt_desc_deref(tt_edesc(nodes, kids, iid, binds, sigs, sidx, externs)));
        return tt_sc_loop_body(nodes, kids, kids.get(s.child_start + 1), s.text, vd, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
    }
    if s.kind == P_K_MATCH {
        // children = [scrutinee, arm, …]; arm children [pattern, guard?, body]. A `str`
        // literal pattern reads the interned literal (S11).
        let scid: i64 = kids.get(s.child_start);
        let qsc: i64 = tt_sc_expr(nodes, kids, scid, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
        let sd: str = tt_edesc(nodes, kids, scid, binds, sigs, sidx, externs);
        let mut ai: i64 = 1;
        while ai < s.child_count {
            let armid: i64 = kids.get(s.child_start + ai);
            let arm: PNode = nodes.get(armid);
            let mut env: Vec<TtBind> = Vec::new();
            let qc: i64 = tt_clone_binds(binds, env);
            if arm.child_count >= 1 {
                let patid: i64 = kids.get(arm.child_start);
                let pat: PNode = nodes.get(patid);
                if pat.kind == P_K_PAT_LIT_STR {
                    let qps: i64 = st.set(3, 1);
                }
                let mut patnames: Vec<str> = Vec::new();
                let qb: i64 = tt_bind_pattern(nodes, kids, patid, 0, env, patnames, sd, sigs, sidx);
            }
            if arm.child_count >= 3 {
                let qg: i64 = tt_sc_expr(nodes, kids, kids.get(arm.child_start + 1), fnid, defid, env, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
            }
            if arm.child_count >= 2 {
                let bodyid: i64 = kids.get(arm.child_start + arm.child_count - 1);
                let qab: i64 = tt_sc_expr(nodes, kids, bodyid, fnid, defid, env, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
            }
            ai = ai + 1;
        }
        return 0;
    }
    if s.kind == P_K_BREAK {
        return 0;
    }
    if s.kind == P_K_CONTINUE {
        return 0;
    }
    // A statement kind this scan does not know: fail closed.
    let qu: i64 = st.set(9, 0);
    return 0;
}

// The edges of a converged pass, appended to the global edge arrays under row `row`.
fn tt_sc_commit(row: i64, ec: Vec<i64>, ea: Vec<i64>, eo: Vec<i64>, er: Vec<i64>, gec: Vec<i64> @Mut, gea: Vec<i64> @Mut, geo: Vec<i64> @Mut, ger: Vec<i64> @Mut, gs: Vec<i64> @Mut, gn: Vec<i64> @Mut) -> i64 ! { Alloc } {
    let base: i64 = ger.len();
    let q0: i64 = gs.set(row, gec.len());
    let q1: i64 = gn.set(row, ec.len());
    let ne: i64 = ec.len();
    let mut i: i64 = 0;
    while i < ne {
        let p0: i64 = gec.push(ec.get(i));
        let p1: i64 = gea.push(ea.get(i));
        let p2: i64 = geo.push(base + eo.get(i));
        i = i + 1;
    }
    let nr: i64 = er.len();
    let mut k: i64 = 0;
    while k < nr {
        let p3: i64 = ger.push(er.get(k));
        k = k + 1;
    }
    return 0;
}

// Scan the fn `fnid` into row `row`: its direct summary before the closure, and its edges.
// The rooted map is a fixpoint (a local bound before a loop whose back-edge rebinds it):
// the body is re-scanned until no name gains a slot, and the attributions of the LAST pass
// are kept; a body past the bound writes through every slot (fail closed).
fn tt_sc_fn(nodes: Arena<PNode>, kids: Vec<i64>, row: i64, sigs: Vec<TtSig> @Mut, sidx: TtIdx, externs: Vec<str>, gec: Vec<i64> @Mut, gea: Vec<i64> @Mut, geo: Vec<i64> @Mut, ger: Vec<i64> @Mut, gs: Vec<i64> @Mut, gn: Vec<i64> @Mut) -> i64 ! { Alloc } {
    let sg: TtSig = sigs.get(row);
    let fnid: i64 = sg.fnid;
    let defid: i64 = sg.defid;
    let fnn: PNode = nodes.get(fnid);
    let body: i64 = tc_fn_body(nodes, kids, fnid);
    let mut st: Vec<i64> = Vec::new();
    let s0: i64 = st.push(0);
    let s1: i64 = st.push(0);
    let s2: i64 = st.push(0);
    let s3: i64 = st.push(0);
    let s4: i64 = st.push(TT_PUBLIC);
    let s5: i64 = st.push(0);
    let s6: i64 = st.push(0);
    let s7: i64 = st.push(0);
    let s8: i64 = st.push(0);
    let s9: i64 = st.push(1);
    let mut rn: Vec<str> = Vec::new();
    let mut rm: Vec<i64> = Vec::new();
    // The parameters: the annotation bound (a `@Flow` label is a placeholder, not a source)
    // and the slots, in declaration order.
    let mut slot: i64 = 0;
    let mut i: i64 = 0;
    while i < fnn.child_count {
        let cid: i64 = kids.get(fnn.child_start + i);
        let cn: PNode = nodes.get(cid);
        if cn.kind == P_K_PARAM {
            let q: i64 = cn.flags / 4;
            let code: i64 = q - (q / 8) * 8;
            if code != 5 {
                let qa: i64 = st.set(4, tt_lub(st.get(4), tt_label_of_code(code)));
            }
            if slot >= 62 {
                let qs: i64 = st.set(9, 0);
            }
            let qr: i64 = tt_sc_root(rn, rm, cn.text, tt_sm_slot(slot));
            slot = slot + 1;
        }
        i = i + 1;
    }
    let rcode: i64 = (fnn.flags & 1048575) / 2;
    if rcode != 5 {
        let qrt: i64 = st.set(4, tt_lub(st.get(4), tt_label_of_code(rcode)));
    }
    let mut passes: i64 = 0;
    let mut stable: bool = false;
    while !stable {
        let before: i64 = rn.len();
        let mut snap: Vec<i64> = Vec::new();
        let mut k: i64 = 0;
        while k < before {
            let ps: i64 = snap.push(rm.get(k));
            k = k + 1;
        }
        let r7: i64 = st.set(7, 0);
        let r8: i64 = st.set(8, 0);
        let mut ec: Vec<i64> = Vec::new();
        let mut ea: Vec<i64> = Vec::new();
        let mut eo: Vec<i64> = Vec::new();
        let mut er: Vec<i64> = Vec::new();
        let mut binds: Vec<TtBind> = Vec::new();
        let mut pi: i64 = 0;
        while pi < fnn.child_count {
            let pcid: i64 = kids.get(fnn.child_start + pi);
            let pcn: PNode = nodes.get(pcid);
            if pcn.kind == P_K_PARAM {
                let mut pd: str = "?";
                if pcn.child_count >= 1 {
                    pd = tt_sc_tdesc(nodes, kids, kids.get(pcn.child_start), fnid, defid);
                }
                let qp: i64 = tt_upsert(binds, TtBind { name: pcn.text, fields: "", taint: 0, regions: 0, tdesc: pd });
            }
            pi = pi + 1;
        }
        if body >= 0 {
            let qb: i64 = tt_sc_block(nodes, kids, body, fnid, defid, binds, sigs, sidx, externs, st, rn, rm, ec, ea, eo, er);
        }
        let mut same: bool = true;
        if rn.len() != before {
            same = false;
        } else {
            let mut j: i64 = 0;
            while j < before {
                if rm.get(j) != snap.get(j) {
                    same = false;
                }
                j = j + 1;
            }
        }
        if same {
            stable = true;
            let qc: i64 = tt_sc_commit(row, ec, ea, eo, er, gec, gea, geo, ger, gs, gn);
        } else {
            passes = passes + 1;
            if passes > 65 * rn.len() + 2 {
                let qt: i64 = st.set(7, 0 - 1);
                stable = true;
                let qc2: i64 = tt_sc_commit(row, ec, ea, eo, er, gec, gea, geo, ger, gs, gn);
            }
        }
    }
    let mut ann: i64 = st.get(4);
    if st.get(5) == 1 {
        // An FFI result is @Internal by rule, not by annotation.
        ann = tt_lub(ann, TT_INTERNAL);
    }
    let mut rel: i64 = st.get(9);
    if st.get(6) == 1 {
        rel = 0;
    }
    let qw: i64 = sigs.set(row, TtSig { name: sg.name, param_taints: sg.param_taints, ret_taint: sg.ret_taint, kind: sg.kind, tdesc: sg.tdesc, ffi: sg.ffi, fnid: sg.fnid, defid: sg.defid, wm: st.get(0), mat: st.get(1), rr: st.get(2), rt: st.get(3), ann: ann, wt: st.get(7), rel: rel });
    return 0;
}

// The call-graph closure (production's `call_summaries`): every fn row joined with what it
// can reach, round after round until no row changes. A row absorbs each callee's facts (not
// its slots: which of the caller's slots those map to is decided per edge through the
// arguments' roots) and the reliability of every callee; an unnamed callee makes it
// unreliable. The bound is this shadow's own lattice height per fn row, 73 — seven flag steps
// (`wm`, `rr` and `rel` one each; `mat` and `rt` three-valued, two each), three label steps,
// and 62 slot bits plus All (production's 72 counts its four two-valued flags and 64 slot
// bits) — times the fn rows, plus 4: every round but the last raises a fact, so the loop
// ends inside it. FAILURE DIRECTION: a closure that does not converge inside the bound makes
// every fn row unreliable.
fn tt_sm_close(sigs: Vec<TtSig> @Mut, gec: Vec<i64>, gea: Vec<i64>, geo: Vec<i64>, ger: Vec<i64>, gs: Vec<i64>, gn: Vec<i64>) -> i64 ! { Alloc } {
    let rows: i64 = sigs.len();
    let mut fnrows: i64 = 0;
    let mut k: i64 = 0;
    while k < rows {
        let sk: TtSig = sigs.get(k);
        if sk.fnid >= 0 {
            fnrows = fnrows + 1;
        }
        k = k + 1;
    }
    let rounds: i64 = fnrows * 73 + 4;
    let mut r: i64 = 0;
    while r < rounds {
        let mut changed: bool = false;
        let mut row: i64 = 0;
        while row < rows {
            let sg: TtSig = sigs.get(row);
            if sg.fnid >= 0 {
                let mut wm: i64 = sg.wm;
                let mut mat: i64 = sg.mat;
                let mut rr: i64 = sg.rr;
                let mut rt: i64 = sg.rt;
                let mut ann: i64 = sg.ann;
                let mut wt: i64 = sg.wt;
                let mut rel: i64 = sg.rel;
                let e0: i64 = gs.get(row);
                let en: i64 = gn.get(row);
                let mut e: i64 = e0;
                while e < e0 + en {
                    let callee: i64 = gec.get(e);
                    if callee < 0 {
                        rel = 0;
                    } else {
                        let cs: TtSig = sigs.get(callee);
                        if cs.wm == 1 {
                            wm = 1;
                        }
                        mat = tt_sm_tri_lub(mat, cs.mat);
                        if cs.rr == 1 {
                            rr = 1;
                        }
                        rt = tt_sm_tri_lub(rt, cs.rt);
                        ann = tt_lub(ann, cs.ann);
                        if cs.rel == 0 {
                            rel = 0;
                        }
                        let argc: i64 = gea.get(e);
                        let off: i64 = geo.get(e);
                        let mut a: i64 = 0;
                        while a < argc {
                            if tt_sm_covers(cs.wt, a) {
                                wt = tt_sm_mask_lub(wt, ger.get(off + a));
                            }
                            a = a + 1;
                        }
                    }
                    e = e + 1;
                }
                let mut differs: bool = false;
                if wm != sg.wm {
                    differs = true;
                }
                if mat != sg.mat {
                    differs = true;
                }
                if rr != sg.rr {
                    differs = true;
                }
                if rt != sg.rt {
                    differs = true;
                }
                if ann != sg.ann {
                    differs = true;
                }
                if wt != sg.wt {
                    differs = true;
                }
                if rel != sg.rel {
                    differs = true;
                }
                if differs {
                    let qw: i64 = sigs.set(row, TtSig { name: sg.name, param_taints: sg.param_taints, ret_taint: sg.ret_taint, kind: sg.kind, tdesc: sg.tdesc, ffi: sg.ffi, fnid: sg.fnid, defid: sg.defid, wm: wm, mat: mat, rr: rr, rt: rt, ann: ann, wt: wt, rel: rel });
                    changed = true;
                }
            }
            row = row + 1;
        }
        if !changed {
            return 1;
        }
        r = r + 1;
    }
    let mut row2: i64 = 0;
    while row2 < rows {
        let sg2: TtSig = sigs.get(row2);
        if sg2.fnid >= 0 {
            let qu: i64 = sigs.set(row2, TtSig { name: sg2.name, param_taints: sg2.param_taints, ret_taint: sg2.ret_taint, kind: sg2.kind, tdesc: sg2.tdesc, ffi: sg2.ffi, fnid: sg2.fnid, defid: sg2.defid, wm: sg2.wm, mat: sg2.mat, rr: sg2.rr, rt: sg2.rt, ann: sg2.ann, wt: sg2.wt, rel: 0 });
        }
        row2 = row2 + 1;
    }
    return 0;
}

// Whether the program can carry a non-public value at all (`out[0]` set when it can): a
// non-public or `@Flow` label on a parameter, a `let` or a fn's return, an extern
// declaration, a fn whose row names FFI, a `declassify_ct`. The parameter arm reads every
// K_PARAM the walk reaches, an effect operation's among them (the operation is a child of its
// declaration, its parameters children of the operation), so a non-public label there counts
// too: production's program-wide bound folds those labels in. Without one no site taint,
// floor or annotation is ever above @Public, so no summary can change a verdict.
fn tt_sm_signals(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, out: Vec<i64> @Mut) -> i64 {
    if out.get(0) == 1 {
        return 0;
    }
    let n: PNode = nodes.get(nid);
    let mut hit: bool = false;
    if n.kind == P_K_PARAM {
        let q: i64 = n.flags / 4;
        let code: i64 = q - (q / 8) * 8;
        if code == 5 {
            hit = true;
        }
        if tt_label_of_code(code) > TT_PUBLIC {
            hit = true;
        }
    }
    if n.kind == P_K_LET {
        if tt_label_of_code(n.flags / 2) > TT_PUBLIC {
            hit = true;
        }
    }
    if n.kind == P_K_FN {
        let rcode: i64 = (n.flags & 1048575) / 2;
        if rcode == 5 {
            hit = true;
        }
        if tt_label_of_code(rcode) > TT_PUBLIC {
            hit = true;
        }
        if tc_seg_from_has(n.text, 1, "FFI") {
            hit = true;
        }
    }
    if n.kind == P_K_EXTERN_FN {
        hit = true;
    }
    if n.kind == P_K_DECLASSIFY_CT {
        hit = true;
    }
    if hit {
        let q0: i64 = out.set(0, 1);
        return 0;
    }
    let mut i: i64 = 0;
    while i < n.child_count {
        let qc: i64 = tt_sm_signals(nodes, kids, kids.get(n.child_start + i), out);
        i = i + 1;
    }
    return 0;
}

// Build the summaries into the table: skipped when the program is inert; else every fn row
// is scanned, the closure runs, and the sentinel row marks the summaries live.
fn tt_sm_build(nodes: Arena<PNode>, kids: Vec<i64>, root: i64, sigs: Vec<TtSig> @Mut, sidx: TtIdx, externs: Vec<str>) -> i64 ! { Alloc } {
    let mut sig: Vec<i64> = Vec::new();
    let p0: i64 = sig.push(0);
    let qs: i64 = tt_sm_signals(nodes, kids, root, sig);
    if sig.get(0) == 0 {
        return 0;
    }
    let rows: i64 = sigs.len();
    let mut gec: Vec<i64> = Vec::new();
    let mut gea: Vec<i64> = Vec::new();
    let mut geo: Vec<i64> = Vec::new();
    let mut ger: Vec<i64> = Vec::new();
    let mut gs: Vec<i64> = Vec::new();
    let mut gn: Vec<i64> = Vec::new();
    let mut i: i64 = 0;
    while i < rows {
        let p1: i64 = gs.push(0);
        let p2: i64 = gn.push(0);
        i = i + 1;
    }
    let mut row: i64 = 0;
    while row < rows {
        let sg: TtSig = sigs.get(row);
        if sg.fnid >= 0 {
            let qf: i64 = tt_sc_fn(nodes, kids, row, sigs, sidx, externs, gec, gea, geo, ger, gs, gn);
        }
        row = row + 1;
    }
    let qc: i64 = tt_sm_close(sigs, gec, gea, geo, ger, gs, gn);
    let sentinel: TtSig = tt_sig_row("", "", TT_PUBLIC, TT_SK_SUM, "", false, 0 - 1, 0 - 1);
    let p3: i64 = sigs.push(sentinel);
    return 1;
}

// Check one non-generic top-level fn: seed params, compute the declared return-taint
// (with the tool_main exception), walk the body.
fn tt_check_fn(nodes: Arena<PNode>, kids: Vec<i64>, fnid: i64, sigs: Vec<TtSig>, sidx: TtIdx, externs: Vec<str>, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    // A `@Flow` signature is an explicit non-verdict here (SH_TAINT_UNSUPPORTED),
    // which the composed pipeline treats as a taint-stage rejection. Returning a
    // clean verdict on a body this projection cannot check would be a fail-OPEN.
    if tt_fn_uses_flow(nodes, kids, fnid) {
        let uf: i64 = tt_mark_unsupported(diags);
        return 0;
    } else {
    }
    let fnn: PNode = nodes.get(fnid);
    let mut binds: Vec<TtBind> = Vec::new();
    // SHP-5c-1: the function's heap floors, [raw_load, typed_read] — function-scoped and
    // monotone like the region map; clean at entry (production's S3 switch is off), then
    // raised by any heap-typed parameter at a non-public label.
    let mut fl: Vec<i64> = Vec::new();
    let f0: i64 = fl.push(TT_PUBLIC);
    let f1: i64 = fl.push(TT_PUBLIC);
    let sp: i64 = tt_seed_params(nodes, kids, fnid, binds, fl, diags);
    let code: i64 = fnn.flags / 2;
    let mut fnret: i64 = tt_label_of_code(code);
    // tool_main exception: a fn whose BARE name is exactly "tool_main" may return
    // @Internal (the FFI bridge) — declared = ret_taint lub Internal. Byte-exact match
    // (NOT ends_with — that would false-match `my_tool_main`).
    let bare: str = tc_seg_at(fnn.text, 0);
    if bare.bytes_eq("tool_main") {
        fnret = tt_lub(fnret, TT_INTERNAL);
    } else {
    }
    let body: i64 = tc_fn_body(nodes, kids, fnid);
    if body >= 0 {
        let mut brk: Vec<TtBind> = Vec::new();
        let mut cnt: Vec<TtBind> = Vec::new();
        let mut prenames: Vec<str> = Vec::new();
        // M6: the function's region-taint map, (alloc site, taint) pairs — function-scoped and
        // monotone, so one map serves every branch, arm and loop pass of the body.
        let mut rtm: Vec<i64> = Vec::new();
        let rb: i64 = tt_block(nodes, kids, body, binds, sigs, sidx, externs, fnret, TT_PUBLIC, TT_PUBLIC, brk, cnt, prenames, 0, rtm, fl, diags);
    } else {
    }
    return 0;
}

// Emit the `;`-joined T-code stream for the parsed program. Build the sig + extern
// tables once across all modules, then taint-check each non-generic top-level P_K_FN
// (actor handlers — P_K_ACTOR subtrees — are NOT walked; AG-T11).
pub fn tt_encode(nodes: Arena<PNode>, kids: Vec<i64>, root: i64) -> str ! { Alloc } {
    let mut diags: Vec<str> = Vec::new();

    let mut mods: Vec<i64> = Vec::new();
    let cm: i64 = tt_collect_modules(nodes, kids, root, mods);
    let nmod: i64 = mods.len();

    let mut sigs: Vec<TtSig> = Vec::new();
    let bs: i64 = tt_build_sigs(nodes, kids, mods, sigs);
    // The index beside the table: built once here, complete for every lookup below (`TtIdx`).
    let sidx: TtIdx = tt_index_build(sigs);
    let mut externs: Vec<str> = Vec::new();
    let ce: i64 = tt_collect_externs(nodes, kids, mods, externs);
    // SHP-5c-2: the call summaries, into the fn rows (skipped when no value can be non-public).
    let qsm: i64 = tt_sm_build(nodes, kids, root, sigs, sidx, externs);

    let mut mi: i64 = 0;
    while mi < nmod {
        let mid: i64 = mods.get(mi);
        let mn: PNode = nodes.get(mid);
        let mut i: i64 = 0;
        while i < mn.child_count {
            let cid: i64 = kids.get(mn.child_start + i);
            let cn: PNode = nodes.get(cid);
            if cn.kind == P_K_FN {
                let gen: bool = tt_is_generic_fn(nodes, kids, cid);
                if gen {
                } else {
                    let r: i64 = tt_check_fn(nodes, kids, cid, sigs, sidx, externs, diags);
                }
            } else {
                if cn.kind == P_K_ACTOR {
                    // Actor init/handler signatures and state are not modeled by this shadow.
                    let ua: i64 = tt_mark_unsupported(diags);
                } else {
                }
                if cn.kind == P_K_TYPE_ALIAS {
                    // SHP-5c-1: an alias is not resolved by this shadow's typing (the heap-floor
                    // banner): refuse rather than type an alias of a scalar as a nominal.
                    let ut: i64 = tt_mark_unsupported(diags);
                }
            }
            i = i + 1;
        }
        mi = mi + 1;
    }

    let empty: str = "";
    let diagj: str = empty.join(diags);
    return diagj;
}
