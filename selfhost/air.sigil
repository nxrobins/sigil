// Self-hosted AIR lowering and WebAssembly emission. The differential harness strips
// this module header when composing the compiler tool.
module air;

// The cv_* path is the sole lowering implementation. It mirrors the Rust AIR, memory,
// fuel, and Wasm stages with operand-exact differential coverage. Unsupported forms
// emit poison rather than plausible output; `ai_encode_wasm` is the production entry.

// The AirType token of a TYPE node (mirrors `lower_type`). `typeid < 0` (an absent return
// annotation) is Unit. A recognized scalar -> its token; a recognized composite (Str /
// Named-record / Array / Ref / Slice / Tuple) -> "Ptr". An unsupported type emits the
// "<skip>" sentinel, which the exact lowering path converts to poison.
fn ai_airtype_of_typenode(nodes: Arena<PNode>, kids: Vec<i64>, typeid: i64, rdefs: Vec<TcRec>) -> str {
    if typeid < 0 {
        return "Unit";
    } else {
    }
    let topcode: i64 = tc_type_topcode(nodes, kids, typeid, rdefs);
    if topcode == TC_T_UNIT {
        return "Unit";
    } else {
    }
    if topcode == TC_T_BOOL {
        return "Bool";
    } else {
    }
    if topcode == TC_T_I32 {
        return "I32";
    } else {
    }
    if topcode == TC_T_U32 {
        return "U32";
    } else {
    }
    if topcode == TC_T_I64 {
        return "I64";
    } else {
    }
    if topcode == TC_T_U64 {
        return "U64";
    } else {
    }
    if topcode == TC_T_F64 {
        return "F64";
    } else {
    }
    if topcode == TC_T_STR {
        return "Ptr";
    } else {
    }
    if topcode == TC_T_ARRAY {
        return "Ptr";
    } else {
    }
    if topcode == TC_T_REF {
        return "Ptr";
    } else {
    }
    if topcode == TC_T_SLICE {
        return "Ptr";
    } else {
    }
    if topcode == TC_T_TUPLE {
        return "Ptr";
    } else {
    }
    if topcode >= TC_REC_BASE {
        return "Ptr";
    } else {
    }
    // CAP-MATCH: a GENERIC-ENUM instance annotation (`Option<i64>`) is a heap POINTER —
    // the oracle types it Ptr (its render label). Before this, the fall-through "<skip>"
    // poisoned any CALL that wrote an Option-typed let dst in the W lane (a param could
    // carry "<skip>"; a call dst cannot). Concrete enums already resolve via TC_REC_BASE.
    let tnn: PNode = nodes.get(typeid);
    if tnn.child_count >= 1 {
        let nre2: i64 = rdefs.len();
        let mut rei2: i64 = 0;
        while rei2 < nre2 {
            let rcand2: TcRec = rdefs.get(rei2);
            let rne2: bool = rcand2.name.bytes_eq(tnn.text);
            if rne2 {
                if rcand2.vnames.len() > 0 {
                    if rcand2.tpnames.len() > 0 {
                        return "Ptr";
                    } else {
                    }
                } else {
                }
                rei2 = nre2;
            } else {
                rei2 = rei2 + 1;
            }
        }
    } else {
    }
    return "<skip>";
}

// True iff `t` is the SKIP sentinel emitted by ai_airtype_of_typenode.
fn ai_is_skip(t: str) -> bool {
    let s: str = "<skip>";
    return t.bytes_eq(s);
}

// Module ids under `root`: a P_K_PROGRAM (83) wrapper's children, or the bare P_K_MODULE
// root (single-module). Clone of ec_collect_modules / nr_collect_modules.
fn ai_collect_modules(nodes: Arena<PNode>, kids: Vec<i64>, root: i64, out: Vec<i64> @Mut) -> i64 ! { Alloc } {
    let rn: PNode = nodes.get(root);
    if rn.kind == P_K_PROGRAM {
        let mut i: i64 = 0;
        while i < rn.child_count {
            let cid: i64 = kids.get(rn.child_start + i);
            let pushed: i64 = out.push(cid);
            i = i + 1;
        }
    } else {
        let pushed: i64 = out.push(root);
    }
    return 0;
}

// Is this P_K_FN a generic SOURCE fn (has a P_K_TYPE_PARAM child)? Such fns are SKIPPED
// (AG-AIR-5): the oracle lowers only MONOMORPHIZED instances, never the generic source —
// an uncalled generic produces zero AirFunctions. Clone of ec_is_generic_fn.
fn ai_is_generic_fn(nodes: Arena<PNode>, kids: Vec<i64>, fnid: i64) -> bool {
    let fnn: PNode = nodes.get(fnid);
    let mut i: i64 = 0;
    let mut found: bool = false;
    let mut scanning: bool = true;
    while scanning {
        if i >= fnn.child_count {
            scanning = false;
        } else {
            let cid: i64 = kids.get(fnn.child_start + i);
            let cn: PNode = nodes.get(cid);
            if cn.kind == P_K_TYPE_PARAM {
                found = true;
                scanning = false;
            } else {
                i = i + 1;
            }
        }
    }
    return found;
}

fn ai_method_name(impl_text: str, method_text: str) -> str ! { Alloc } {
    let type_name: str = tc_seg_at(impl_text, 1);
    let method: str = tc_seg_at(method_text, 0);
    let sep: str = type_name.concat("__");
    return sep.concat(method);
}


// A single decimal digit (0-9) as a str.
fn ai_digit_char(d: i64) -> str {
    if d == 0 {
        return "0";
    } else {
    }
    if d == 1 {
        return "1";
    } else {
    }
    if d == 2 {
        return "2";
    } else {
    }
    if d == 3 {
        return "3";
    } else {
    }
    if d == 4 {
        return "4";
    } else {
    }
    if d == 5 {
        return "5";
    } else {
    }
    if d == 6 {
        return "6";
    } else {
    }
    if d == 7 {
        return "7";
    } else {
    }
    if d == 8 {
        return "8";
    } else {
    }
    return "9";
}

// A non-negative i64 as decimal (SIGIL has no `%`, so lo = n - hi*10).
fn ai_int_to_str(n: i64) -> str ! { Alloc } {
    if n < 10 {
        return ai_digit_char(n);
    } else {
    }
    let hi: i64 = n / 10;
    let lo: i64 = n - hi * 10;
    let hs: str = ai_int_to_str(hi);
    let ls: str = ai_digit_char(lo);
    return hs.concat(ls);
}


// True iff node `inner`'s span lies within node `outer`'s span (subtree membership).
fn rf_contains(nodes: Arena<PNode>, outer: i64, inner: i64) -> bool {
    let outn: PNode = nodes.get(outer);
    let inn: PNode = nodes.get(inner);
    if outn.start <= inn.start {
        if inn.end <= outn.end {
            return true;
        } else {
        }
    } else {
    }
    return false;
}

// True iff `name` equals one of `text`'s `;`-separated segments with index >= fromseg.
// Binder texts are ASCII idents joined with `;`, so byte-indexed substr is safe.
fn rf_name_in_segs(text: str, name: str, fromseg: i64) -> bool {
    let tl: i64 = text.len();
    let mut seg: i64 = 0;
    let mut st: i64 = 0;
    let mut i: i64 = 0;
    while i <= tl {
        let mut isend: bool = false;
        if i == tl {
            isend = true;
        } else {
            let ch: str = text.substr(i, i + 1);
            if ch.bytes_eq(";") {
                isend = true;
            } else {
            }
        }
        if isend {
            if seg >= fromseg {
                let part: str = text.substr(st, i);
                if part.bytes_eq(name) {
                    return true;
                } else {
                }
            } else {
            }
            seg = seg + 1;
            st = i + 1;
        } else {
        }
        i = i + 1;
    }
    return false;
}

// RF-M4: is node `mid` a BINDER that (re)binds `name`? Mirrors the oracle's
// stmt_rebinds_name + pattern_binds_name (statements.rs:2889-2921): let /
// let-tuple / for-in / for-range vars, match binding/enum/array pattern names.
// P_K_CLOSURE is the CALLER's fail-closed refusal (see rf_body_refuses).
fn rf_binds_name(nodes: Arena<PNode>, mid: i64, name: str) -> bool {
    let n: PNode = nodes.get(mid);
    if n.kind == P_K_LET {
        return n.text.bytes_eq(name);
    } else {
    }
    if n.kind == P_K_FOR_IN {
        return n.text.bytes_eq(name);
    } else {
    }
    if n.kind == P_K_FOR_RANGE {
        return n.text.bytes_eq(name);
    } else {
    }
    if n.kind == P_K_PAT_BINDING {
        return n.text.bytes_eq(name);
    } else {
    }
    if n.kind == P_K_LET_TUPLE {
        return rf_name_in_segs(n.text, name, 0);
    } else {
    }
    if n.kind == P_K_PAT_ENUM {
        // text = `type;variant;binding1;…` — bindings start at segment 2.
        return rf_name_in_segs(n.text, name, 2);
    } else {
    }
    if n.kind == P_K_PAT_ARRAY {
        // text = `;`-joined element words (`_` for wildcards) + the rest name.
        return rf_name_in_segs(n.text, name, 0);
    } else {
    }
    return false;
}

// RF-M4: the shadow-proof body pre-scan — true iff the loop BODY (`bodyid`)
// REFUSES the bounds fact for `name`: any binder in its subtree rebinds it
// (this includes a nested same-name loop, refusing the OUTER loop's fact
// exactly like the oracle), OR the body contains a P_K_CLOSURE ANYWHERE
// (fail-closed: the oracle BARRIERS closures — the fact stays alive outside
// them — but no covered fixture contains one, so the shadow refuses the whole
// loop; a closure fixture fails loudly one-sided, never silently diverges).
fn rf_body_refuses(nodes: Arena<PNode>, bodyid: i64, name: str) -> bool {
    let total: i64 = nodes.len();
    let mut i: i64 = 0;
    while i < total {
        let within: bool = rf_contains(nodes, bodyid, i);
        if within {
            let mn: PNode = nodes.get(i);
            if mn.kind == P_K_CLOSURE {
                return true;
            } else {
            }
            let b: bool = rf_binds_name(nodes, i, name);
            if b {
                return true;
            } else {
            }
        } else {
        }
        i = i + 1;
    }
    return false;
}

// RF-M4: the innermost fn-LIKE node (free fn / impl method P_K_FN, actor
// init/handler) whose span contains node `eid`, or -1. If the innermost
// enclosure is a P_K_CLOSURE the answer is -1 (fail-closed: no elision inside
// a closure — the oracle empties the fact channel there).
fn rf_enclosing_fn(nodes: Arena<PNode>, eid: i64) -> i64 {
    let total: i64 = nodes.len();
    let mut best: i64 = 0 - 1;
    let mut bestw: i64 = 0;
    let mut i: i64 = 0;
    while i < total {
        let mn: PNode = nodes.get(i);
        let mut fnlike: bool = false;
        if mn.kind == P_K_FN {
            fnlike = true;
        } else {
        }
        if mn.kind == P_K_ACTOR_INIT {
            fnlike = true;
        } else {
        }
        if mn.kind == P_K_HANDLER {
            fnlike = true;
        } else {
        }
        if mn.kind == P_K_CLOSURE {
            fnlike = true;
        } else {
        }
        if fnlike {
            if i == eid {
            } else {
                let cont: bool = rf_contains(nodes, i, eid);
                if cont {
                    let w: i64 = mn.end - mn.start;
                    if best < 0 {
                        best = i;
                        bestw = w;
                    } else {
                        if w < bestw {
                            best = i;
                            bestw = w;
                        } else {
                        }
                    }
                } else {
                }
            }
        } else {
        }
        i = i + 1;
    }
    if best >= 0 {
        let bn: PNode = nodes.get(best);
        if bn.kind == P_K_CLOSURE {
            return 0 - 1;
        } else {
        }
    } else {
    }
    return best;
}

// True iff `text`'s segment 0 equals `name` (a P_K_PARAM's text is `name` or
// `name;region` when `@in r` is present).
fn rf_seg0_eq(text: str, name: str) -> bool {
    let s0: str = tc_seg_at(text, 0);
    return s0.bytes_eq(name);
}

// RF-M4: the STATIC size of the fixed-array DECLARATION of `name` inside fn
// `fnid` — a P_K_PARAM (text seg 0 == name) or an annotated P_K_LET (text ==
// name) whose type child (child 0) is a PLAIN P_K_TYPE_ARRAY (flags 0 — no
// ref/slice rider; its `value` IS the size, the same field tc_tmangle reads).
// EXACTLY ONE candidate or -1: a shadowed/ambiguous name fails closed (the
// AG-REG-SHADOW discipline, corpus-excluded). An UN-annotated array let never
// resolves here (child 0 is the value expr) — also fail-closed, and already
// out of every covered lane (the F5 annotation requirement).
fn rf_decl_array_size(nodes: Arena<PNode>, kids: Vec<i64>, fnid: i64, name: str) -> i64 {
    let total: i64 = nodes.len();
    let mut found: i64 = 0 - 1;
    let mut count: i64 = 0;
    let mut i: i64 = 0;
    while i < total {
        let within: bool = rf_contains(nodes, fnid, i);
        if within {
            let mn: PNode = nodes.get(i);
            let mut namehit: bool = false;
            if mn.kind == P_K_PARAM {
                namehit = rf_seg0_eq(mn.text, name);
            } else {
            }
            if mn.kind == P_K_LET {
                namehit = mn.text.bytes_eq(name);
            } else {
            }
            if namehit {
                if mn.child_count >= 1 {
                    let tid: i64 = kids.get(mn.child_start);
                    let tn: PNode = nodes.get(tid);
                    if tn.kind == P_K_TYPE_ARRAY {
                        if tn.flags == 0 {
                            found = tn.value;
                            count = count + 1;
                        } else {
                        }
                    } else {
                    }
                } else {
                }
            } else {
            }
        } else {
        }
        i = i + 1;
    }
    if count == 1 {
        return found;
    } else {
    }
    return 0 - 1;
}

// RF-M4 (UP-LENGTH): the covered `arr.len()` END form — a P_K_METHOD `len`
// with NO args (child_count == 1) whose receiver (child 0) is a bare-local
// P_K_PATH declared in the enclosing fn as a plain fixed array. Returns the
// STATIC size — the K the CHECKER substitutes as an i64 literal in the typed
// tree (statements.rs UP-LENGTH), so the oracle AIR mats a CONSTANT for the
// bound, never a len load — or -1 when the end is not this form (an uncovered
// len receiver fences the fn; it never mis-lowers).
fn rf_len_end_k(nodes: Arena<PNode>, kids: Vec<i64>, endid: i64) -> i64 {
    let en: PNode = nodes.get(endid);
    if en.kind == P_K_METHOD {
    } else {
        return 0 - 1;
    }
    let isl: bool = en.text.bytes_eq("len");
    if isl {
    } else {
        return 0 - 1;
    }
    if en.child_count == 1 {
    } else {
        return 0 - 1;
    }
    let rcvid: i64 = kids.get(en.child_start);
    let rn: PNode = nodes.get(rcvid);
    if rn.kind == P_K_PATH {
    } else {
        return 0 - 1;
    }
    let rq0: i64 = tc_last_colons(rn.text);
    let rq: bool = rq0 >= 0;
    if rq {
        return 0 - 1;
    } else {
    }
    let fnid: i64 = rf_enclosing_fn(nodes, endid);
    if fnid >= 0 {
    } else {
        return 0 - 1;
    }
    return rf_decl_array_size(nodes, kids, fnid, rn.text);
}

// RF-M2: the bounds fact for ONE range loop — its exclusive upper bound K, IFF
// every gate holds (statements.rs:975-1021): start is the surface literal `0`;
// the end resolves statically (an int literal, or the covered `arr.len()`);
// K >= 1 (an empty loop makes no claims); the body pre-scan finds NO rebinding
// of the var. Returns K, or -1 (no fact).
fn rf_fact_k(nodes: Arena<PNode>, kids: Vec<i64>, loopid: i64) -> i64 {
    let ln: PNode = nodes.get(loopid);
    if ln.kind == P_K_FOR_RANGE {
    } else {
        return 0 - 1;
    }
    let startid: i64 = kids.get(ln.child_start);
    let sn: PNode = nodes.get(startid);
    if sn.kind == P_K_LIT_INT {
    } else {
        return 0 - 1;
    }
    if sn.value == 0 {
    } else {
        return 0 - 1;
    }
    let endid: i64 = kids.get(ln.child_start + 1);
    let en: PNode = nodes.get(endid);
    let mut k: i64 = 0 - 1;
    if en.kind == P_K_LIT_INT {
        k = en.value;
    } else {
        k = rf_len_end_k(nodes, kids, endid);
    }
    if k >= 1 {
    } else {
        return 0 - 1;
    }
    let bodyid: i64 = kids.get(ln.child_start + 2);
    let refuses: bool = rf_body_refuses(nodes, bodyid, ln.text);
    if refuses {
        return 0 - 1;
    } else {
    }
    return k;
}

// RF-M2/M4: the RANGE elision predicate for `arr[v]` (the second
// `bounds_proven` setter, expressions.rs:2743): the index node's array AND
// index children are bare-local paths; the INNERMOST enclosing P_K_FOR_RANGE
// whose var == the index name carries a fact K; and K <= N, N = the indexed
// array's declared size ([0, K-1] ⊆ [0, N-1] with lo pinned 0 — no RF-M3
// interval tightening here). A straddle (K > N) keeps the runtime chain on
// both sides — never a claim.
fn rf_index_elided(nodes: Arena<PNode>, kids: Vec<i64>, ixid: i64) -> bool {
    let n: PNode = nodes.get(ixid);
    if n.kind == P_K_INDEX {
    } else {
        return false;
    }
    let arrid: i64 = kids.get(n.child_start);
    let an: PNode = nodes.get(arrid);
    if an.kind == P_K_PATH {
    } else {
        return false;
    }
    let aq0: i64 = tc_last_colons(an.text);
    let aq: bool = aq0 >= 0;
    if aq {
        return false;
    } else {
    }
    let idxid: i64 = kids.get(n.child_start + 1);
    let dn: PNode = nodes.get(idxid);
    if dn.kind == P_K_PATH {
    } else {
        return false;
    }
    let dq0: i64 = tc_last_colons(dn.text);
    let dq: bool = dq0 >= 0;
    if dq {
        return false;
    } else {
    }
    let fnid: i64 = rf_enclosing_fn(nodes, ixid);
    if fnid >= 0 {
    } else {
        return false;
    }
    // The innermost P_K_FOR_RANGE with text == the index var whose span
    // contains this index (max start = deepest; spans nest). An outer
    // same-name loop can never sneak in: its own pre-scan refuses its fact
    // when an inner loop rebinds the name — exactly the oracle's `.rev()`
    // innermost-fact lookup.
    let total: i64 = nodes.len();
    let mut loopid: i64 = 0 - 1;
    let mut loopstart: i64 = 0 - 1;
    let mut i: i64 = 0;
    while i < total {
        let mn: PNode = nodes.get(i);
        if mn.kind == P_K_FOR_RANGE {
            let namehit: bool = mn.text.bytes_eq(dn.text);
            if namehit {
                let cont: bool = rf_contains(nodes, i, ixid);
                if cont {
                    if mn.start > loopstart {
                        loopid = i;
                        loopstart = mn.start;
                    } else {
                    }
                } else {
                }
            } else {
            }
        } else {
        }
        i = i + 1;
    }
    if loopid >= 0 {
    } else {
        return false;
    }
    let k: i64 = rf_fact_k(nodes, kids, loopid);
    if k >= 1 {
    } else {
        return false;
    }
    let nsize: i64 = rf_decl_array_size(nodes, kids, fnid, an.text);
    if nsize >= 1 {
    } else {
        return false;
    }
    if k <= nsize {
        return true;
    } else {
    }
    return false;
}


// ═════════════════════════════════════════════════════════════════════════════
// The operand-exact AIR builder (docs/specs/sh-air.md).
// The CV lane produces one line per fn — `tail|params|ret|locals|blocks` — with REAL VarIds,
// compared against the harness `oracle_cv_projection` by EXACT string equality. The lowering
// mirror is ALLOCATE-THEN-RECURSE (X6): a to_var dst is freshed BEFORE its operands are lowered;
// a let dst is freshed before its value — matching air.rs:1813/1440, the discipline the KIND
// lanes never saw. `cv_fresh` is the ONLY id source; the locals Vec doubles as the counter
// (next id = param_count + locals.len()). Unsupported forms emit CVS_POISON → a `!` in the
// render, which can never match an oracle render → one-sided LOUD (the CV fail-closed).
// ═════════════════════════════════════════════════════════════════════════════

// The CV env binding: a name -> (VarId, airtype token). Params + lets, append-only per fn.
record CvBind { name: str, var: i64, ty: str, rec: i64, elem: str, tuptys: str, esize: i64 }

// The flat CV stmt arena record (the PNode idiom): kind + generic operand slots.
// CVS_AS_INT: a=dst, b=the literal. CVS_AS_BOOL: a=dst, b=1/0. CVS_AS_VAR: a=dst, b=src.
// CVS_AS_BIN: a=dst, b=lhs, c=the P_K_BINARY op TOKEN code, d=rhs. CVS_POISON: none.
record CvStmt { kind: i64, a: i64, b: i64, c: i64, d: i64, s: str }

const CVS_AS_INT: i64 = 1;
const CVS_AS_BOOL: i64 = 2;
const CVS_AS_VAR: i64 = 3;
const CVS_AS_BIN: i64 = 4;
// SH-AIR-CV-2: the trap intrinsic's TrapIf (a=cond), the for-in len load (a=dst, b=base — always
// @0:U32), and the for-in element load (a=dst, b=base, c=idx, d=elem width, s=elem ty — always +4).
const CVS_TRAP: i64 = 5;
const CVS_LF_LEN: i64 = 6;
const CVS_LD_ELEM: i64 = 7;
// SH-AIR-CV-3: the general field read/write (real offsets), the user free-fn call (the arg list
// pre-rendered into `s` at emission — args are already ids), and the pre-memory BumpAlloc.
const CVS_LF2: i64 = 8;
const CVS_SF: i64 = 9;
const CVS_CALL: i64 = 10;
const CVS_BA: i64 = 11;
// SH-AIR-CV-4: the string-literal data-ptr Assign (s=content), the record-construct Assign
// (s = the pre-rendered `name=vN` list), the index StoreDynamic, and WrapI64.
const CVS_AS_STR: i64 = 12;
const CVS_AS_REC: i64 = 13;
const CVS_SD: i64 = 14;
const CVS_WRAP: i64 = 15;
const CVS_FUEL: i64 = 16;
// B-VEC: the vec/alloc intrinsic kinds. LD0/SD0 mirror LD_ELEM/SD but with memarg OFFSET 0
// (vec buffers are header-less; the array kinds bake the 4-byte length header). IALLOC is the
// alloc builtin call: i32-operand -> call 4 (the sigil.alloc import) -> i64.extend_i32_u -> set.
const CVS_LD0: i64 = 17;
const CVS_SD0: i64 = 18;
const CVS_IALLOC: i64 = 19;
// W-STR-A: the str-intrinsic vocabulary. EXT_U32 = i64.extend_i32_u (173, the u32 len -> i64
// widen); LD8 = i32.load8_u (45, align 0 offset 0 — the UTF-8 byte probe); CTSEL = wasm
// select (27, the constant-time boundary-index clamp).
const CVS_EXT_U32: i64 = 20;
const CVS_LD8: i64 = 21;
const CVS_CTSEL: i64 = 22;
// W-STR-B: ST8 = i32.store8 (58, align 0 offset 0 — the string-builder byte write).
const CVS_ST8: i64 = 23;
const CVS_POISON: i64 = 99;

// Terminator kinds (CV-1: returns; CV-2: the full alphabet).
const CVT_RET_NONE: i64 = 1;
const CVT_RET_SOME: i64 = 2;
const CVT_JMP: i64 = 3;
const CVT_LOOP: i64 = 4;
const CVT_BR: i64 = 5;
const CVT_DISP: i64 = 6;
const CVT_UNR: i64 = 7;

// SH-AIR-CV-2: one lowered block — id, a CONTIGUOUS stmt range [stmt_start, stmt_start+stmt_count)
// into the per-fn CvStmt Vec, and the terminator (term kind + targets; tm = the Br merge or -1 for
// None). Blocks are pushed in EMISSION order, which is NOT id order (a Dispatch's exit block is
// allocated before the arm chain but pushed last) — the serializer preserves push order.
record CvBlock { id: i64, stmt_start: i64, stmt_count: i64, term: i64, ta: i64, tb: i64, tc2: i64, tm: i64 }

// A non-negative OR negative i64 as decimal (the parser folds `-5` into a NEGATIVE
// P_K_LIT_INT.value; ai_int_to_str is non-negative-only).
fn cv_i64_str(n: i64) -> str ! { Alloc } {
    if n < 0 {
        let p: str = ai_int_to_str(0 - n);
        let m: str = "-";
        return m.concat(p);
    } else {
    }
    return ai_int_to_str(n);
}

// The P_K_BINARY op TOKEN code -> the oracle `BinaryOp` Debug token (ast.rs:1393). An unknown
// code renders `?OP` — unmatchable against any oracle render (loud, fail-closed).
fn cv_op_tok(op: i64) -> str {
    if op == T_PLUS {
        return "Add";
    } else {
    }
    if op == T_MINUS {
        return "Sub";
    } else {
    }
    if op == T_STAR {
        return "Mul";
    } else {
    }
    if op == T_SLASH {
        return "Div";
    } else {
    }
    if op == T_PERCENT {
        return "Mod";
    } else {
    }
    if op == T_LT {
        return "Lt";
    } else {
    }
    if op == T_GT {
        return "Gt";
    } else {
    }
    if op == T_EQEQ {
        return "Eq";
    } else {
    }
    if op == T_BANGEQ {
        return "NotEq";
    } else {
    }
    if op == T_LTEQ {
        return "LtEq";
    } else {
    }
    if op == T_GTEQ {
        return "GtEq";
    } else {
    }
    if op == T_LTLT {
        return "Shl";
    } else {
    }
    if op == T_GTGT {
        return "Shr";
    } else {
    }
    if op == T_AMP {
        return "BitAnd";
    } else {
    }
    if op == T_PIPE {
        return "BitOr";
    } else {
    }
    return "?OP";
}

// True iff the op is a comparison (the oracle types a comparison Bool, air lowering dst type).
fn cv_op_is_cmp(op: i64) -> bool {
    if op == T_EQEQ {
        return true;
    } else {
    }
    if op == T_BANGEQ {
        return true;
    } else {
    }
    if op == T_LT {
        return true;
    } else {
    }
    if op == T_GT {
        return true;
    } else {
    }
    if op == T_LTEQ {
        return true;
    } else {
    }
    if op == T_GTEQ {
        return true;
    } else {
    }
    return false;
}

// Env lookups (mirror tc_bind_lookup's linear scan; LAST binding wins for shadowing — scan from
// the end).
fn cv_env_var(env: Vec<CvBind>, name: str) -> i64 {
    let n: i64 = env.len();
    let mut i: i64 = n - 1;
    while i >= 0 {
        let b: CvBind = env.get(i);
        let eq: bool = b.name.bytes_eq(name);
        if eq {
            return b.var;
        } else {
        }
        i = i - 1;
    }
    return 0 - 1;
}

fn cv_elem_of_typenode(nodes: Arena<PNode>, kids: Vec<i64>, tid: i64, rdefs: Vec<TcRec>) -> str ! { Alloc } {
    if tid < 0 {
        return "";
    } else {
    }
    let tn: PNode = nodes.get(tid);
    if tn.kind == P_K_TYPE_ARRAY {
        let elid: i64 = kids.get(tn.child_start);
        return ai_airtype_of_typenode(nodes, kids, elid, rdefs);
    } else {
    }
    // W-STR-A: str PROVENANCE rides `elem` as the `$str` sentinel (no array token collides —
    // real elems are AirType tokens). The binding's `ty` stays "Ptr" (the CV render contract:
    // lower_type maps Str -> Ptr), so renders + locals are byte-unchanged; only the str-
    // intrinsic method dispatch reads the sentinel (cv_env_isstr).
    let ttop: i64 = tc_type_topcode(nodes, kids, tid, rdefs);
    if ttop == TC_T_STR {
        return "$str";
    } else {
    }
    // CAP-MATCH: a GENERIC-ENUM annotation (`Option<i64>`) records its INSTANCE payload
    // token in `elem` (the same provenance channel Vec elems and $str ride) so the match
    // lowering can extract `Some(x)` at the instance width. Concrete enums, records, and
    // everything else keep "" (byte-unchanged); an Option local is never a str/vec
    // receiver, so the elem readers cannot misroute on it.
    if tn.child_count >= 1 {
        let nre: i64 = rdefs.len();
        let mut rei: i64 = 0;
        while rei < nre {
            let rcand: TcRec = rdefs.get(rei);
            let rne: bool = rcand.name.bytes_eq(tn.text);
            if rne {
                if rcand.vnames.len() > 0 {
                    if rcand.tpnames.len() > 0 {
                        let tgid: i64 = kids.get(tn.child_start);
                        return ai_airtype_of_typenode(nodes, kids, tgid, rdefs);
                    } else {
                    }
                } else {
                }
                rei = nre;
            } else {
                rei = rei + 1;
            }
        }
    } else {
    }
    return "";
}

// W-STR-A: true iff `name` binds a str value (the `$str` elem sentinel).
fn cv_env_isstr(env: Vec<CvBind>, name: str) -> bool {
    let n: i64 = env.len();
    let mut i: i64 = 0;
    let mut found: bool = false;
    while i < n {
        let b: CvBind = env.get(i);
        if b.name.bytes_eq(name) {
            found = b.elem.bytes_eq("$str");
        } else {
        }
        i = i + 1;
    }
    return found;
}

fn cv_env_elem(env: Vec<CvBind>, name: str) -> str {
    let n: i64 = env.len();
    let mut i: i64 = n - 1;
    while i >= 0 {
        let b: CvBind = env.get(i);
        let eq: bool = b.name.bytes_eq(name);
        if eq {
            return b.elem;
        } else {
        }
        i = i - 1;
    }
    return "";
}

fn cv_env_rec(env: Vec<CvBind>, name: str) -> i64 {
    let n: i64 = env.len();
    let mut i: i64 = n - 1;
    while i >= 0 {
        let b: CvBind = env.get(i);
        let eq: bool = b.name.bytes_eq(name);
        if eq {
            return b.rec;
        } else {
        }
        i = i - 1;
    }
    return 0 - 1;
}

fn cv_env_esize(env: Vec<CvBind>, name: str) -> i64 {
    let n: i64 = env.len();
    let mut i: i64 = n - 1;
    while i >= 0 {
        let b: CvBind = env.get(i);
        if b.name.bytes_eq(name) {
            return b.esize;
        } else {
        }
        i = i - 1;
    }
    return 0;
}

fn cv_env_tytok(env: Vec<CvBind>, name: str) -> str {
    let n: i64 = env.len();
    let mut i: i64 = n - 1;
    while i >= 0 {
        let b: CvBind = env.get(i);
        let eq: bool = b.name.bytes_eq(name);
        if eq {
            return b.ty;
        } else {
        }
        i = i - 1;
    }
    return "?";
}

// The type token a fresh dst gets for `eid` (mirror lower_type(&expr.ty) on the scalar surface):
// an int lit -> I64; a bool lit -> Bool; a bare local -> its env type; a binary -> Bool if a
// comparison else the lhs type. Anything else -> "?" (poisons the render — loud).
fn cv_expr_tytok(nodes: Arena<PNode>, kids: Vec<i64>, eid: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, cnames: Vec<str>, cvals: Vec<i64>) -> str {
    let n: PNode = nodes.get(eid);
    if n.kind == P_K_LIT_INT {
        return "I64";
    } else {
    }
    if n.kind == P_K_LIT_BOOL {
        return "Bool";
    } else {
    }
    if n.kind == P_K_PATH {
        let cc: i64 = tc_last_colons(n.text);
        if cc >= 0 {
            let tlen: i64 = n.text.len();
            let fbase: str = n.text.substr(0, cc);
            let fseg: str = n.text.substr(cc + 2, tlen);
            let brec: i64 = cv_env_rec(env, fbase);
            if brec >= 0 {
                return cv_field_tok(rdefs, brec, fseg);
            } else {
            }
            return "Ptr";
        } else {
        }
        // W-CONST: a const reference types I64 (the inlined IntLit).
        let ttok: str = cv_env_tytok(env, n.text);
        let tunk: bool = ttok.bytes_eq("?");
        if tunk {
            let tcv: i64 = cv_ctbl_find(cnames, cvals, n.text);
            if tcv >= 0 {
                return "I64";
            } else {
            }
        } else {
        }
        return ttok;
    } else {
    }
    if n.kind == P_K_CALL {
        let cc3: i64 = tc_last_colons(n.text);
        if cc3 < 0 {
            // B-VEC: the memory intrinsics have no user sig — pin their ret tokens (alloc: i64;
            // vec_load: the ELEM token via the witness (W-ELEM; "?" poisons at the caller);
            // vec_store: unit) so let-bound results type.
            let ia: bool = n.text.bytes_eq("alloc");
            if ia {
                return "I64";
            } else {
            }
            let il: bool = n.text.bytes_eq("vec_load");
            if il {
                let velem: str = cv_vec_elem_tok(nodes, kids, eid, env, rdefs);
                return velem;
            } else {
            }
            let iw: bool = n.text.bytes_eq("vec_store");
            if iw {
                return "Unit";
            } else {
            }
            // W-STR-B: store8's expr-stmt dst is the phantom Unit local.
            let i8: bool = n.text.bytes_eq("store8");
            if i8 {
                return "Unit";
            } else {
            }
            // W-STRRAW: str_from_raw wraps (ptr, len) into a fresh str HEADER -> Ptr.
            let ifr: bool = n.text.bytes_eq("str_from_raw");
            if ifr {
                return "Ptr";
            } else {
            }
            return cv_sig_ret_tok(sigs, n.text);
        } else {
        }
        return "?";
    } else {
    }
    if n.kind == P_K_TUPLE {
        return "Ptr";
    } else {
    }
    if n.kind == P_K_RECORD_CONSTRUCT {
        return "Ptr";
    } else {
    }
    if n.kind == P_K_ARRAY {
        return "Ptr";
    } else {
    }
    if n.kind == P_K_LIT_STR {
        return "Ptr";
    } else {
    }
    if n.kind == P_K_METHOD {
        // ST-2: a dot-method `p.get()` — its type is the method's RET type (the
        // `Type::method` sig key); an enum ctor `E::B(x)` → Ptr (child0 is an enum).
        if n.child_count >= 1 {
            let mtrid: i64 = kids.get(n.child_start);
            let mtrn: PNode = nodes.get(mtrid);
            // W-STR-A: str intrinsic method ret tokens (len/byte_at -> I64; substr -> Ptr —
            // a str value's token is Ptr by the render contract). Gate = the `$str` elem
            // sentinel on a bare-path receiver binding.
            let mut mtisstr: bool = false;
            if mtrn.kind == P_K_PATH {
                let mtcc: i64 = tc_last_colons(mtrn.text);
                if mtcc < 0 {
                    mtisstr = cv_env_isstr(env, mtrn.text);
                } else {
                    // CAP-LOCALS (capstone Finding 2A): a one-hop str FIELD receiver types
                    // its intrinsic methods identically to a bare one (the W-STR-FIELD
                    // gate). Without this, a field-str .len() in EXPRESSION position (an if
                    // condition) freshed its temp from the fall-through token (Ptr) instead
                    // of I64 — a same-length SILENT locals-width divergence. Let-bound and
                    // return positions were immune (dst from the annotation / fn ret).
                    let mttl: i64 = mtrn.text.len();
                    let mtfb: str = mtrn.text.substr(0, mtcc);
                    let mtfs: str = mtrn.text.substr(mtcc + 2, mttl);
                    let mtbr: i64 = cv_env_rec(env, mtfb);
                    if mtbr >= 0 {
                        mtisstr = cv_field_isstr(rdefs, mtbr, mtfs);
                    } else {
                    }
                }
            } else {
            }
            if mtisstr {
                let wsl: bool = n.text.bytes_eq("len");
                if wsl {
                    return "I64";
                } else {
                }
                let wsb: bool = n.text.bytes_eq("byte_at");
                if wsb {
                    return "I64";
                } else {
                }
                let wss: bool = n.text.bytes_eq("substr");
                if wss {
                    return "Ptr";
                } else {
                }
                let wdc: bool = n.text.bytes_eq("concat");
                if wdc {
                    return "Ptr";
                } else {
                }
                let wdj: bool = n.text.bytes_eq("join");
                if wdj {
                    return "Ptr";
                } else {
                }
                let wde: bool = n.text.bytes_eq("bytes_eq");
                if wde {
                    return "Bool";
                } else {
                }
                let wdt: bool = n.text.bytes_eq("contains");
                if wdt {
                    return "Bool";
                } else {
                }
                // Stage-3-0: `s.as_output()` packs a str header into the forge return i64.
                let wao: bool = n.text.bytes_eq("as_output");
                if wao {
                    return "I64";
                } else {
                }
            } else {
            }
            // W-STR-B: `.itoa()` on a bare I64 binding -> Ptr (str_itoa's pair).
            if mtrn.kind == P_K_PATH {
                let itcc: i64 = tc_last_colons(mtrn.text);
                if itcc < 0 {
                    let ittok: str = cv_env_tytok(env, mtrn.text);
                    let iti: bool = ittok.bytes_eq("I64");
                    if iti {
                        let wit: bool = n.text.bytes_eq("itoa");
                        if wit {
                            return "Ptr";
                        } else {
                        }
                        // Stage-3-0: `ptr.from_bytes(len)` -> str_from_bytes -> Option<str> (tok Ptr).
                        let wfb: bool = n.text.bytes_eq("from_bytes");
                        if wfb {
                            return "Ptr";
                        } else {
                        }
                    } else {
                    }
                } else {
                }
            } else {
            }
            if mtrn.kind == P_K_PATH {
                let mtrr: i64 = cv_recv_rec(env, rdefs, mtrn.text);
                if mtrr >= 0 {
                    let mtrec: TcRec = rdefs.get(mtrr);
                    // SH-MONO MONO-7: pre-resolved generic-method call (flag 2^21) — the instance
                    // is a top-level fn, so its ret sig is keyed by n.text (the free-fn key), not
                    // `{Type}::{method}` (which would be `Box__i64::get` -> a miss -> wrong tok).
                    let mtpre7: i64 = n.flags & 2097152;
                    if mtpre7 > 0 {
                        return cv_sig_ret_tok(sigs, n.text);
                    } else {
                    }
                    let mtsep: str = mtrec.name.concat("::");
                    let mtkey: str = mtsep.concat(tc_seg_at(n.text, 0));
                    return cv_sig_ret_tok(sigs, mtkey);
                } else {
                }
            } else {
            }
        } else {
        }
        return "Ptr";
    } else {
    }
    if n.kind == P_K_INDEX {
        let rxid: i64 = kids.get(n.child_start);
        let rxn: PNode = nodes.get(rxid);
        if rxn.kind == P_K_PATH {
            return cv_env_elem(env, rxn.text);
        } else {
        }
        return "?";
    } else {
    }
    if n.kind == P_K_BINARY {
        let isc: bool = cv_op_is_cmp(n.value);
        if isc {
            return "Bool";
        } else {
        }
        let lid: i64 = kids.get(n.child_start);
        let ln2: PNode = nodes.get(lid);
        if ln2.kind == P_K_LIT_INT {
            let rid: i64 = kids.get(n.child_start + 1);
            let rn2: PNode = nodes.get(rid);
            if rn2.kind == P_K_LIT_INT {
            } else {
                return cv_expr_tytok(nodes, kids, rid, env, rdefs, sigs, cnames, cvals);
            }
        } else {
        }
        return cv_expr_tytok(nodes, kids, lid, env, rdefs, sigs, cnames, cvals);
    } else {
    }
    return "?";
}

// SH-WASM W3: the binary's OPERAND ty — the non-literal side's token (both
// literal -> "I64", the default int; the INTO-arith case overrides with dstty).
// The oracle's typed AST unifies operand tys, so a literal operand inherits the
// other side's type — bare inference wrongly defaulted it to I64 on u32/bool
// operands (caught by the W3 wasm byte-diff).
fn cv_binop_operand_ty(nodes: Arena<PNode>, kids: Vec<i64>, n: PNode, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, cnames: Vec<str>, cvals: Vec<i64>) -> str ! { Alloc } {
    let lid: i64 = kids.get(n.child_start);
    let rid: i64 = kids.get(n.child_start + 1);
    let ln2: PNode = nodes.get(lid);
    let rn2: PNode = nodes.get(rid);
    if ln2.kind == P_K_LIT_INT {
        if rn2.kind == P_K_LIT_INT {
            return "I64";
        } else {
            return cv_expr_tytok(nodes, kids, rid, env, rdefs, sigs, cnames, cvals);
        }
    } else {
    }
    return cv_expr_tytok(nodes, kids, lid, env, rdefs, sigs, cnames, cvals);
}

// Mat one binary operand: a LITERAL freshes with the OPERAND ty (see above);
// anything else goes through cv_to_var unchanged.
fn cv_binop_mat(nodes: Arena<PNode>, kids: Vec<i64>, cid: i64, opty: str, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let cn2: PNode = nodes.get(cid);
    if cn2.kind == P_K_LIT_INT {
        let d: i64 = cv_fresh(opty, base, locals);
        let q: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: d, b: cn2.value, c: 0, d: 0, s: "" });
        return d;
    } else {
    }
    let v: i64 = cv_to_var(nodes, kids, cid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
    return v;
}

// THE ONLY id source (X6). The locals Vec doubles as the counter: id = base + locals.len()
// (base = the param count), and the rendered `v{id}:{ty}` entry is pushed at fresh time — the
// locals table falls out in fresh order for free (matching the oracle's fresh_local push).
fn cv_fresh(ty: str, base: i64, locals: Vec<str> @Mut) -> i64 ! { Alloc } {
    let id: i64 = base + locals.len();
    let ids: str = cv_i64_str(id);
    let vlead: str = "v";
    let va: str = vlead.concat(ids);
    let vb: str = va.concat(":");
    let vc: str = vb.concat(ty);
    let q: i64 = locals.push(vc);
    return id;
}

// SH-AIR-CV-2: the block-id counter. Allocation order ≠ push order (unlike locals), so the
// locals-Vec trick doesn't apply — a dedicated push-counter Vec does: id = len after a dummy push.
// The entry block is 0 (never freshed); the first fresh_block returns 1 (mirrors next_block init 1,
// air.rs:1387).
// RF-M4: the ty token of LOCAL var `v` (>= base), parsed from its `vN:Ty` locals
// entry (all-ASCII). Used by the continue arm to size the injected `__one` from
// the FRAME's counter — U32 for for-in, I64 for range-for (the oracle's
// LoopFrame.continue_incr width, air.rs:1861-1864). A param id (v < base — no
// loop counter is ever a param; both loops fresh theirs) returns "" — an
// unmatchable local entry, loud-not-silent (the ?OP discipline).
fn cv_local_tytok(v: i64, base: i64, locals: Vec<str>) -> str {
    if v < base {
        return "";
    } else {
    }
    let ent: str = locals.get(v - base);
    let el: i64 = ent.len();
    let mut i: i64 = 0;
    while i < el {
        let ch: str = ent.substr(i, i + 1);
        if ch.bytes_eq(":") {
            return ent.substr(i + 1, el);
        } else {
        }
        i = i + 1;
    }
    return "";
}

fn cv_fresh_block(bctr: Vec<i64> @Mut) -> i64 ! { Alloc } {
    let q: i64 = bctr.push(0);
    return bctr.len();
}

// SH-FUEL F2: multiplicity arithmetic under the SHARED clamp (2^40 — the oracle's
// FUEL_MULT_CLAMP; air.rs `fuel_mul_clamped`). -1 = unbounded, poisoning the product.
// The division guard gives EXACTLY min(a*b, CLAMP) without overflowing i64: for
// 0 <= a,b <= CLAMP, `a > CLAMP/b` (integer div) iff a*b > CLAMP.
fn cv_mclamp(a: i64, b: i64) -> i64 {
    if a < 0 {
        return 0 - 1;
    } else {
    }
    if b < 0 {
        return 0 - 1;
    } else {
    }
    if b == 0 {
        return 0;
    } else {
    }
    let lim: i64 = 1099511627776;
    let guard: i64 = lim / b;
    if a > guard {
        return lim;
    } else {
    }
    return a * b;
}

// SH-FUEL F2: clamped add (inputs are already <= CLAMP, so the sum fits i64).
fn cv_aclamp(a: i64, b: i64) -> i64 {
    let s: i64 = a + b;
    let lim: i64 = 1099511627776;
    if s > lim {
        return lim;
    } else {
    }
    return s;
}

// SH-AIR-CV-2: flush the current block — record its contiguous stmt range + terminator, in
// emission order. SH-FUEL F2: `mult` is the block's static execution multiplicity (product
// of enclosing literal for-range bounds; -1 = unbounded), pushed to the PARALLEL `bmults`
// arena — blocks[j] <-> bmults[j] in flush order, an alignment cv_mem_lower and
// cv_fuel_insert both preserve (each maps exactly one input block to one output block, in
// order). Mirrors the oracle's AirFunction::block_static_multiplicity.
fn cv_flush(blocks: Vec<CvBlock> @Mut, id: i64, mark: i64, endlen: i64, term: i64, ta: i64, tb: i64, tc2: i64, tm: i64, bmults: Vec<i64> @Mut, mult: i64) -> i64 ! { Alloc } {
    let q: i64 = blocks.push(CvBlock { id: id, stmt_start: mark, stmt_count: endlen - mark, term: term, ta: ta, tb: tb, tc2: tc2, tm: tm });
    let qm: i64 = bmults.push(mult);
    return 0;
}

// SH-AIR-CV-2: clone the env for a branch/body recursion (mirrors the oracle's `env.clone()` —
// branch bindings never leak to the sibling branch or the remainder).
fn cv_env_clone(src: Vec<CvBind>) -> Vec<CvBind> ! { Alloc } {
    let mut dst: Vec<CvBind> = Vec::new();
    let n: i64 = src.len();
    let mut i: i64 = 0;
    while i < n {
        let b: CvBind = src.get(i);
        let q: i64 = dst.push(CvBind { name: b.name, var: b.var, ty: b.ty, rec: b.rec, elem: b.elem, tuptys: b.tuptys, esize: b.esize });
        i = i + 1;
    }
    return dst;
}

// The airtype-token width (AirType::width, air.rs:562).
fn cv_ty_width(tok: str) -> i64 {
    let w8a: bool = tok.bytes_eq("I64");
    if w8a {
        return 8;
    } else {
    }
    let w8b: bool = tok.bytes_eq("U64");
    if w8b {
        return 8;
    } else {
    }
    let w8c: bool = tok.bytes_eq("F64");
    if w8c {
        return 8;
    } else {
    }
    let w0: bool = tok.bytes_eq("Unit");
    if w0 {
        return 0;
    } else {
    }
    return 4;
}

fn cv_ty_known(tok: str) -> bool {
    if tok.bytes_eq("I32") { return true; } else {}
    if tok.bytes_eq("U32") { return true; } else {}
    if tok.bytes_eq("I64") { return true; } else {}
    if tok.bytes_eq("U64") { return true; } else {}
    if tok.bytes_eq("F64") { return true; } else {}
    if tok.bytes_eq("Bool") { return true; } else {}
    if tok.bytes_eq("Ptr") { return true; } else {}
    return tok.bytes_eq("Unit");
}

// SH-AIR-CV-3: a type-annotation node's RECORD identity — the rdefs index when the topcode is a
// record/enum code (>= TC_REC_BASE; enums share the space — their empty fnames make any field
// lookup fail loud), else -1.
fn cv_rec_of_typenode(nodes: Arena<PNode>, kids: Vec<i64>, tid: i64, rdefs: Vec<TcRec>) -> i64 {
    if tid < 0 {
        return 0 - 1;
    } else {
    }
    let code: i64 = tc_type_topcode(nodes, kids, tid, rdefs);
    if code >= TC_REC_BASE {
        return code - TC_REC_BASE;
    } else {
    }
    // AG6-3: a child-bearing generic-ENUM instance annotation (`Option<str>`) — tc_type_topcode
    // returns UNHANDLED for the targ-bearing node (records are pre-rewritten to a bare mangle by
    // mn_expand_records so never reach here; enums are NOT rewritten, keeping the targ child that
    // the match's `elem` lens needs). Resolve to the (generic) enum's rdef index so a generic-enum
    // method receiver (cv_recv_rec) AND a match-on-self both resolve instead of poisoning. is_enum-
    // gated: a stray child-bearing RECORD annotation still returns -1 (its per-instance field
    // layout would be wrong from the generic def) — byte-unchanged, since it returned -1 before too.
    let tn: PNode = nodes.get(tid);
    if tn.kind == P_K_TYPE {
        if tn.child_count > 0 {
            let bcode: i64 = tc_code_of_name(tn.text, rdefs);
            if bcode >= TC_REC_BASE {
                let bidx: i64 = bcode - TC_REC_BASE;
                let brec: TcRec = rdefs.get(bidx);
                if brec.is_enum {
                    return bidx;
                } else {
                }
            } else {
            }
        } else {
        }
    } else {
    }
    return 0 - 1;
}

// SH-AIR-CV-3: a TC type CODE -> the airtype token (the code-level twin of ai_airtype_of_typenode's
// mapping; every composite collapses to Ptr via lower_type).
fn cv_tcode_tok(code: i64) -> str {
    if code == TC_T_UNIT {
        return "Unit";
    } else {
    }
    if code == TC_T_BOOL {
        return "Bool";
    } else {
    }
    if code == TC_T_I32 {
        return "I32";
    } else {
    }
    if code == TC_T_U32 {
        return "U32";
    } else {
    }
    if code == TC_T_I64 {
        return "I64";
    } else {
    }
    if code == TC_T_U64 {
        return "U64";
    } else {
    }
    if code == TC_T_F64 {
        return "F64";
    } else {
    }
    if code == TC_T_STR {
        return "Ptr";
    } else {
    }
    if code == TC_T_ARRAY {
        return "Ptr";
    } else {
    }
    if code == TC_T_REF {
        return "Ptr";
    } else {
    }
    if code == TC_T_SLICE {
        return "Ptr";
    } else {
    }
    if code == TC_T_TUPLE {
        return "Ptr";
    } else {
    }
    if code >= TC_REC_BASE {
        return "Ptr";
    } else {
    }
    return "?";
}

// SH-AIR-CV-3: the field OFFSET — cumulative decl-order widths over rdefs fnames/ftags
// (air.rs:728). -1 = the field is not on the record (fails loud).
fn cv_field_off(rdefs: Vec<TcRec>, ridx: i64, fname: str) -> i64 {
    let rec: TcRec = rdefs.get(ridx);
    let n: i64 = rec.fnames.len();
    let mut off: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        let fn2: str = rec.fnames.get(i);
        let eq: bool = fn2.bytes_eq(fname);
        if eq {
            return off;
        } else {
        }
        let ft: i64 = rec.ftags.get(i);
        let ftok: str = cv_tcode_tok(ft);
        off = off + cv_ty_width(ftok);
        i = i + 1;
    }
    return 0 - 1;
}

// SH-AIR-CV-3: the field's airtype token ("?" = not found — poisons loud).
fn cv_field_tok(rdefs: Vec<TcRec>, ridx: i64, fname: str) -> str {
    let rec: TcRec = rdefs.get(ridx);
    let n: i64 = rec.fnames.len();
    let mut i: i64 = 0;
    while i < n {
        let fn2: str = rec.fnames.get(i);
        let eq: bool = fn2.bytes_eq(fname);
        if eq {
            let ft: i64 = rec.ftags.get(i);
            return cv_tcode_tok(ft);
        } else {
        }
        i = i + 1;
    }
    return "?";
}

// SH-AIR-CV-3: the enum cell size — 4 (the i32 tag) + the max variant payload width
// (air.rs:1097-1124; vstarts/vcounts index the flat vptags).
fn cv_enum_total_size(rdefs: Vec<TcRec>, ridx: i64) -> i64 {
    let rec: TcRec = rdefs.get(ridx);
    let nv: i64 = rec.vnames.len();
    let mut maxp: i64 = 0;
    let mut v: i64 = 0;
    while v < nv {
        let vs: i64 = rec.vstarts.get(v);
        let vc: i64 = rec.vcounts.get(v);
        let mut pw: i64 = 0;
        let mut k2: i64 = 0;
        while k2 < vc {
            let pt: i64 = rec.vptags.get(vs + k2);
            let ptok: str = cv_tcode_tok(pt);
            pw = pw + cv_ty_width(ptok);
            k2 = k2 + 1;
        }
        if pw > maxp {
            maxp = pw;
        } else {
        }
        v = v + 1;
    }
    return 4 + maxp;
}

// Exact instance size from one width per declared type parameter. A negative width means the
// caller could not resolve that parameter, so the result is 0 and the constructor must poison.
fn cv_enum_size_with_widths(rdefs: Vec<TcRec>, ridx: i64, widths: Vec<i64>) -> i64 {
    let rec: TcRec = rdefs.get(ridx);
    let ntp: i64 = rec.tpnames.len();
    if ntp == 0 {
        return 0;
    } else {
    }
    if widths.len() != ntp {
        return 0;
    } else {
    }
    let mut wi: i64 = 0;
    while wi < ntp {
        if widths.get(wi) < 0 {
            return 0;
        } else {
        }
        wi = wi + 1;
    }
    let nv: i64 = rec.vnames.len();
    let mut maxp: i64 = 0;
    let mut v: i64 = 0;
    while v < nv {
        let vs: i64 = rec.vstarts.get(v);
        let vc: i64 = rec.vcounts.get(v);
        let mut pw: i64 = 0;
        let mut k2: i64 = 0;
        while k2 < vc {
            let ptp: i64 = rec.vptp.get(vs + k2);
            if ptp >= 0 {
                if ptp >= ntp {
                    return 0;
                } else {
                }
                pw = pw + widths.get(ptp);
            } else {
                let pt: i64 = rec.vptags.get(vs + k2);
                let ptok: str = cv_tcode_tok(pt);
                pw = pw + cv_ty_width(ptok);
            }
            k2 = k2 + 1;
        }
        if pw > maxp {
            maxp = pw;
        } else {
        }
        v = v + 1;
    }
    return 4 + maxp;
}

// AG6-6/SR-010: resolve every generic-enum type argument from an expected type node. This is
// deliberately all-parameter, unlike the old `elem` side channel, so Result<T,E>-shaped enums
// cannot silently fall back to the generic definition's placeholder widths.
fn cv_enum_inst_size(nodes: Arena<PNode>, kids: Vec<i64>, rdefs: Vec<TcRec>, ridx: i64, tid: i64) -> i64 ! { Alloc } {
    if tid < 0 {
        return 0;
    } else {
    }
    let rec: TcRec = rdefs.get(ridx);
    let ntp: i64 = rec.tpnames.len();
    let tn: PNode = nodes.get(tid);
    if ntp == 0 {
        return 0;
    } else {
    }
    if tn.child_count != ntp {
        return 0;
    } else {
    }
    let mut widths: Vec<i64> = Vec::new();
    let mut i: i64 = 0;
    while i < ntp {
        let atid: i64 = kids.get(tn.child_start + i);
        let tok: str = ai_airtype_of_typenode(nodes, kids, atid, rdefs);
        if cv_ty_known(tok) {
            let qw: i64 = widths.push(cv_ty_width(tok));
        } else {
            let qw0: i64 = widths.push(0 - 1);
        }
        i = i + 1;
    }
    return cv_enum_size_with_widths(rdefs, ridx, widths);
}

// SH-AIR-CV-3: the FuncId — the name's index in the decl-order free-fn registry (-1 = unknown).
fn cv_fid_find(fids: Vec<str>, name: str) -> i64 {
    let n: i64 = fids.len();
    let mut i: i64 = 0;
    while i < n {
        let f: str = fids.get(i);
        let eq: bool = f.bytes_eq(name);
        if eq {
            return i;
        } else {
        }
        i = i + 1;
    }
    return 0 - 1;
}

// SH-AIR-CV-3: the callee's ret token via TcSig.ret ("?" = unknown callee — poisons loud).
fn cv_sig_ret_tok(sigs: Vec<TcSig>, name: str) -> str {
    let idx: i64 = tc_sig_find(sigs, name);
    if idx >= 0 {
    } else {
        return "?";
    }
    let sig: TcSig = sigs.get(idx);
    // W-TUPLE: a COMPOSITE return rides ret_detail with ret = TC_T_UNIT (PR-5i) — the
    // VALUE is the aggregate POINTER (the oracle's Call{dst: Some}). Without this the
    // call emits dst=-1 (the Unit convention) and the W arm taints defensively.
    if sig.ret == TC_T_UNIT {
        if sig.ret_detail.len() > 0 {
            return "Ptr";
        } else {
        }
    } else {
    }
    return cv_tcode_tok(sig.ret);
}

// SH-AIR-CV-2: the for-in element type token — walk the fn's P_K_PARAM children for the iterable's
// name; its type node must be a P_K_TYPE_ARRAY whose single child is the elem type. "" = not an
// array-annotated param (a local-array iterable is CV-4; the caller poisons — AG-CV2-LOCALARR).
fn cv_forin_elem_ty(nodes: Arena<PNode>, kids: Vec<i64>, fnid: i64, itername: str, rdefs: Vec<TcRec>) -> str ! { Alloc } {
    let fnode: PNode = nodes.get(fnid);
    let mut pi: i64 = 0;
    while pi < fnode.child_count {
        let pcid: i64 = kids.get(fnode.child_start + pi);
        let pcn: PNode = nodes.get(pcid);
        if pcn.kind == P_K_PARAM {
            let nm: bool = pcn.text.bytes_eq(itername);
            if nm {
                if pcn.child_count >= 1 {
                    let ptid: i64 = kids.get(pcn.child_start);
                    let ptn: PNode = nodes.get(ptid);
                    if ptn.kind == P_K_TYPE_ARRAY {
                        let elid: i64 = kids.get(ptn.child_start);
                        return ai_airtype_of_typenode(nodes, kids, elid, rdefs);
                    } else {
                    }
                } else {
                }
                return "";
            } else {
            }
        } else {
        }
        pi = pi + 1;
    }
    return "";
}

// SH-AIR-CV-2: serialize ONE terminator (the harness cv_render_term mirror).
fn cv_ser_term(term: i64, ta: i64, tb: i64, tc2: i64, tm: i64) -> str ! { Alloc } {
    let mut ps: Vec<str> = Vec::new();
    if term == CVT_RET_NONE {
        let q0: i64 = ps.push("Ret");
    } else {
        if term == CVT_RET_SOME {
            let ra: str = cv_i64_str(ta);
            let q1: i64 = ps.push("Ret v");
            let q2: i64 = ps.push(ra);
        } else {
            if term == CVT_JMP {
                let ja: str = cv_i64_str(ta);
                let q3: i64 = ps.push("Jmp b");
                let q4: i64 = ps.push(ja);
            } else {
                if term == CVT_LOOP {
                    let la: str = cv_i64_str(ta);
                    let lb: str = cv_i64_str(tb);
                    let lc: str = cv_i64_str(tc2);
                    let q5: i64 = ps.push("Loop v");
                    let q6: i64 = ps.push(la);
                    let q7: i64 = ps.push(" b");
                    let q8: i64 = ps.push(lb);
                    let q9: i64 = ps.push(" b");
                    let q10: i64 = ps.push(lc);
                } else {
                    if term == CVT_BR {
                        let ba: str = cv_i64_str(ta);
                        let bb: str = cv_i64_str(tb);
                        let bc: str = cv_i64_str(tc2);
                        let q11: i64 = ps.push("Br v");
                        let q12: i64 = ps.push(ba);
                        let q13: i64 = ps.push(" b");
                        let q14: i64 = ps.push(bb);
                        let q15: i64 = ps.push(" b");
                        let q16: i64 = ps.push(bc);
                        if tm >= 0 {
                            let bm: str = cv_i64_str(tm);
                            let q17: i64 = ps.push(" m=b");
                            let q18: i64 = ps.push(bm);
                        } else {
                            let q19: i64 = ps.push(" m=_");
                        }
                    } else {
                        if term == CVT_DISP {
                            let da: str = cv_i64_str(ta);
                            let db: str = cv_i64_str(tb);
                            let q20: i64 = ps.push("Disp b");
                            let q21: i64 = ps.push(da);
                            let q22: i64 = ps.push(" b");
                            let q23: i64 = ps.push(db);
                        } else {
                            if term == CVT_UNR {
                                let q24: i64 = ps.push("Unr");
                            } else {
                                let q25: i64 = ps.push("!TERM");
                            }
                        }
                    }
                }
            }
        }
    }
    let glue: str = "";
    return glue.join(ps);
}

// SH-AIR-CV-4: the index BOUNDS-CHECK chain for a NON-literal index (a literal index is
// bounds_proven — the #442 elision skips the whole chain WITHOUT allocating): the len load, the
// I64/U64 wrap, the GtEq compare, and the trap. The LD/SD afterwards index by the ORIGINAL var.
fn cv_index_check(nodes: Arena<PNode>, kids: Vec<i64>, idxid: i64, idxv: i64, arrv: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let ln: i64 = cv_fresh("U32", base, locals);
    let qlf: i64 = stmts.push(CvStmt { kind: CVS_LF2, a: ln, b: arrv, c: 0, d: 0, s: "U32" });
    let idty: str = cv_expr_tytok(nodes, kids, idxid, env, rdefs, sigs, cnames, cvals);
    let mut cmpv: i64 = idxv;
    let w64a: bool = idty.bytes_eq("I64");
    let w64b: bool = idty.bytes_eq("U64");
    let mut w64: bool = w64a;
    if w64b {
        w64 = true;
    } else {
    }
    if w64 {
        let wv: i64 = cv_fresh("U32", base, locals);
        let qw: i64 = stmts.push(CvStmt { kind: CVS_WRAP, a: wv, b: idxv, c: 0, d: 0, s: "" });
        cmpv = wv;
    } else {
    }
    let oob: i64 = cv_fresh("Bool", base, locals);
    let qb: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: oob, b: cmpv, c: T_GTEQ, d: ln, s: "" });
    let qt: i64 = stmts.push(CvStmt { kind: CVS_TRAP, a: oob, b: 0, c: 0, d: 0, s: "" });
    return 0;
}

// W-ELEM: the element token for a vec_load call node — recovered from the Vec<T> WITNESS
// (the 4th intrinsic arg; vec.sigil's designed elem channel: "the element type is recovered
// at each access from the Vec<T> witness"). The witness must be a bare path bound in env as
// a cloned `Vec__{elem}` record; the elem mangle classifies into the CLOSED set
// {i64 -> I64, str -> Ptr, rdefs-known record -> Ptr} (X-WE1). Anything else (narrow ints,
// bool, f64, unknown) returns "?" and the CALLER poisons — fail-closed, never a defaulted
// width. The slot STRIDE stays 8 regardless (X-WE3); only the access width follows the token.
fn cv_vec_elem_tok(nodes: Arena<PNode>, kids: Vec<i64>, eid: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>) -> str {
    let n: PNode = nodes.get(eid);
    if n.child_count == 4 {
    } else {
        return "?";
    }
    let wid: i64 = kids.get(n.child_start + 3);
    let wn: PNode = nodes.get(wid);
    if wn.kind == P_K_PATH {
    } else {
        return "?";
    }
    let wcc: i64 = tc_last_colons(wn.text);
    if wcc < 0 {
    } else {
        return "?";
    }
    let ridx: i64 = cv_env_rec(env, wn.text);
    if ridx >= 0 {
    } else {
        return "?";
    }
    let rec: TcRec = rdefs.get(ridx);
    // bind the field to a bare $str local FIRST — a field-receiver str method is itself
    // outside the W-emit surface (the W-STR-FIELD lesson: the shadow must self-compile).
    let rname: str = rec.name;
    let rlen: i64 = rname.len();
    if rlen > 5 {
    } else {
        return "?";
    }
    let pref: str = rname.substr(0, 5);
    let prok: bool = pref.bytes_eq("Vec__");
    if prok {
    } else {
        return "?";
    }
    let elem: str = rname.substr(5, rlen);
    let isi64: bool = elem.bytes_eq("i64");
    if isi64 {
        return "I64";
    } else {
    }
    // W-VECBOOL: bool elems are i32-CLASS (probe-pinned: plain i32 load/store align-2 at
    // slot stride 8 — NO byte-width ops; the instance fn types carry i32). The wa
    // fall-through already maps Bool -> 0x28/0x36 + align 2; only this gate was missing.
    let isbool: bool = elem.bytes_eq("bool");
    if isbool {
        return "Bool";
    } else {
    }
    let isstr: bool = elem.bytes_eq("str");
    if isstr {
        return "Ptr";
    } else {
    }
    // a known record elem (incl. a nested Vec__.. instance) is a heap pointer.
    let nrec: i64 = rdefs.len();
    let mut i: i64 = 0;
    while i < nrec {
        let cand: TcRec = rdefs.get(i);
        let cname: str = cand.name;
        let ceq: bool = cname.bytes_eq(elem);
        if ceq {
            return "Ptr";
        } else {
        }
        i = i + 1;
    }
    return "?";
}

// B-VEC: the memory-intrinsic emitter (alloc / vec_load / vec_store — no user sig/fid; every
// stdlib Vec method body calls them). Returns the dst var, or -2 when the callee is not one of
// the three (the caller falls through to the fid path). dstgiven >= 0 = the into-dst arm's
// target; else a fresh dst (X6: dst BEFORE args). Sequences mirror the oracle exactly
// (air.rs:2458-2556 + emit_vec_bound_trap): args materialize in order; the bound trap =
// wrap(idx), wrap(bound), GtEq, TrapIf; the i64 buf wraps to a Ptr base; elem_size 8, memarg
// offset 0 (header-less — the LD0/SD0 kinds). W-ELEM: the ACCESS width follows the element
// token (i64 elems -> i64 ops; record/str elems -> Ptr, i32 ops + i32 locals — the oracle's
// lower_type rule); the slot stride stays 8. Narrow elems (Vec<bool>/i32) POISON loud.
fn cv_emit_vecintr(nodes: Arena<PNode>, kids: Vec<i64>, dstgiven: i64, eid: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(eid);
    let isal: bool = n.text.bytes_eq("alloc");
    let isld: bool = n.text.bytes_eq("vec_load");
    let isst: bool = n.text.bytes_eq("vec_store");
    // W-STR-B: store8(ptr, byte) — the string-builder byte write (IntrinsicStore8).
    let is8: bool = n.text.bytes_eq("store8");
    if is8 {
        if n.child_count >= 2 {
        } else {
            let q8p: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            return 0 - 1;
        }
        let p8id: i64 = kids.get(n.child_start);
        let v8id: i64 = kids.get(n.child_start + 1);
        let p8: i64 = cv_to_var(nodes, kids, p8id, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        let v8: i64 = cv_to_var(nodes, kids, v8id, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        let q8: i64 = stmts.push(CvStmt { kind: CVS_ST8, a: p8, b: v8, c: 0, d: 0, s: "" });
        // NO dst-assign (the pin: IntrinsicStore8 alone); the expr-stmt walker's phantom
        // Unit dst (dstgiven) is returned unreferenced, mirroring the oracle's skipped local.
        if dstgiven >= 0 {
            return dstgiven;
        } else {
        }
        let d8: i64 = cv_fresh("Unit", base, locals);
        return d8;
    } else {
    }
    // W-STRRAW: str_from_raw(ptr, len) -> a FRESH 8-byte str header (data_ptr @0, len @4),
    // mirroring the string-LITERAL header (cv_emit_string) but with RUNTIME ptr/len. The
    // stdlib always passes i64 args (alloc's result + an i64 length), so each wraps to U32
    // directly (the oracle's zero-extend branch is for narrow args, never emitted by the
    // stdlib). ORDER (X6 + air.rs:3082): dst first, args materialize, then wrap-ptr, wrap-len,
    // BumpAlloc(dst,8,4), store ptr@0, store len@4.
    let isfr: bool = n.text.bytes_eq("str_from_raw");
    if isfr {
        if n.child_count == 2 {
            let mut dst: i64 = dstgiven;
            if dst < 0 {
                dst = cv_fresh("Ptr", base, locals);
            } else {
            }
            let p0id: i64 = kids.get(n.child_start);
            let a0: i64 = cv_to_var(nodes, kids, p0id, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            let l0id: i64 = kids.get(n.child_start + 1);
            let a1: i64 = cv_to_var(nodes, kids, l0id, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            let dpu: i64 = cv_fresh("U32", base, locals);
            let qfw1: i64 = stmts.push(CvStmt { kind: CVS_WRAP, a: dpu, b: a0, c: 0, d: 0, s: "" });
            let lnu: i64 = cv_fresh("U32", base, locals);
            let qfw2: i64 = stmts.push(CvStmt { kind: CVS_WRAP, a: lnu, b: a1, c: 0, d: 0, s: "" });
            let qfba: i64 = stmts.push(CvStmt { kind: CVS_BA, a: dst, b: 8, c: 4, d: 0, s: "" });
            let qfs1: i64 = stmts.push(CvStmt { kind: CVS_SF, a: dst, b: dpu, c: 0, d: 0, s: "U32" });
            let qfs2: i64 = stmts.push(CvStmt { kind: CVS_SF, a: dst, b: lnu, c: 4, d: 0, s: "U32" });
            return dst;
        } else {
        }
        return 0 - 2;
    } else {
    }
    if isal {
        if n.child_count == 1 {
            let mut dst: i64 = dstgiven;
            if dst < 0 {
                dst = cv_fresh("I64", base, locals);
            } else {
            }
            let a0id: i64 = kids.get(n.child_start);
            let a0: i64 = cv_to_var(nodes, kids, a0id, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            let qi: i64 = stmts.push(CvStmt { kind: CVS_IALLOC, a: dst, b: a0, c: 0, d: 0, s: "" });
            return dst;
        } else {
        }
        return 0 - 2;
    } else {
    }
    let mut isvec: bool = isld;
    if isst {
        isvec = true;
    } else {
    }
    if isvec {
        if n.child_count == 4 {
            // W-ELEM: the elem token (load: from the witness, the 4th arg; store: from the
            // VALUE's env binding — the store signature carries no witness, but its value is
            // always the bare `val`/`e` path in vec.sigil). "?"/unbound is fail-closed
            // POISON — never a defaulted width (X-WE1/X-WE2).
            let mut etok: str = "?";
            if isld {
                etok = cv_vec_elem_tok(nodes, kids, eid, env, rdefs);
            } else {
                let vvid: i64 = kids.get(n.child_start + 3);
                let vvn: PNode = nodes.get(vvid);
                if vvn.kind == P_K_PATH {
                    let vvcc: i64 = tc_last_colons(vvn.text);
                    if vvcc < 0 {
                        etok = cv_env_tytok(env, vvn.text);
                    } else {
                    }
                } else {
                }
            }
            let mut eunk: bool = etok.bytes_eq("?");
            let e0: bool = etok.bytes_eq("");
            if e0 {
                eunk = true;
            } else {
            }
            if eunk {
                let qep: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                return 0 - 1;
            } else {
            }
            let mut dst: i64 = dstgiven;
            if dst < 0 {
                if isld {
                    dst = cv_fresh(etok, base, locals);
                } else {
                    dst = cv_fresh("Unit", base, locals);
                }
            } else {
            }
            let b0id: i64 = kids.get(n.child_start);
            let a0: i64 = cv_to_var(nodes, kids, b0id, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            let b1id: i64 = kids.get(n.child_start + 1);
            let a1: i64 = cv_to_var(nodes, kids, b1id, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            let b2id: i64 = kids.get(n.child_start + 2);
            let a2: i64 = cv_to_var(nodes, kids, b2id, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            let b3id: i64 = kids.get(n.child_start + 3);
            let a3: i64 = cv_to_var(nodes, kids, b3id, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            let w1: i64 = cv_fresh("U32", base, locals);
            let qw1: i64 = stmts.push(CvStmt { kind: CVS_WRAP, a: w1, b: a1, c: 0, d: 0, s: "" });
            let w2: i64 = cv_fresh("U32", base, locals);
            let qw2: i64 = stmts.push(CvStmt { kind: CVS_WRAP, a: w2, b: a2, c: 0, d: 0, s: "" });
            let oob: i64 = cv_fresh("Bool", base, locals);
            let qb: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: oob, b: w1, c: T_GTEQ, d: w2, s: "" });
            let qt: i64 = stmts.push(CvStmt { kind: CVS_TRAP, a: oob, b: 0, c: 0, d: 0, s: "" });
            let bp: i64 = cv_fresh("Ptr", base, locals);
            let qbp: i64 = stmts.push(CvStmt { kind: CVS_WRAP, a: bp, b: a0, c: 0, d: 0, s: "" });
            if isld {
                let qld: i64 = stmts.push(CvStmt { kind: CVS_LD0, a: dst, b: bp, c: a1, d: 8, s: etok });
            } else {
                let qsd: i64 = stmts.push(CvStmt { kind: CVS_SD0, a: bp, b: a3, c: a1, d: 8, s: etok });
                let qz: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: dst, b: 0, c: 0, d: 0, s: "" });
            }
            return dst;
        } else {
        }
        return 0 - 2;
    } else {
    }
    return 0 - 2;
}

// SH-AIR-CV-4: the shared construct-body emitters (dst already chosen — to_var freshes it first,
// into receives it): the ARRAY expansion, the STRING header, the RECORD-construct Assign, and the
// ENUM ctor (unit + payload). Each mirrors the probe-pinned pre-memory shape.
fn cv_emit_array(nodes: Arena<PNode>, kids: Vec<i64>, ad: i64, eid: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(eid);
    let cnt: i64 = n.child_count;
    if cnt == 0 {
        let qba0: i64 = stmts.push(CvStmt { kind: CVS_BA, a: ad, b: 4, c: 8, d: 0, s: "" });
        let ln0: i64 = cv_fresh("U32", base, locals);
        let ql0: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: ln0, b: 0, c: 0, d: 0, s: "" });
        let qs0: i64 = stmts.push(CvStmt { kind: CVS_SF, a: ad, b: ln0, c: 0, d: 0, s: "U32" });
        return 0;
    } else {
    }
    let el0: i64 = kids.get(n.child_start);
    let etok: str = cv_expr_tytok(nodes, kids, el0, env, rdefs, sigs, cnames, cvals);
    let ew: i64 = cv_ty_width(etok);
    let qba: i64 = stmts.push(CvStmt { kind: CVS_BA, a: ad, b: 4 + cnt * ew, c: 8, d: 0, s: "" });
    let ln: i64 = cv_fresh("U32", base, locals);
    let ql: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: ln, b: cnt, c: 0, d: 0, s: "" });
    let qs: i64 = stmts.push(CvStmt { kind: CVS_SF, a: ad, b: ln, c: 0, d: 0, s: "U32" });
    let mut ei: i64 = 0;
    while ei < cnt {
        let evid: i64 = kids.get(n.child_start + ei);
        let ev: i64 = cv_to_var(nodes, kids, evid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        let qse: i64 = stmts.push(CvStmt { kind: CVS_SF, a: ad, b: ev, c: 4 + ei * ew, d: 0, s: etok });
        ei = ei + 1;
    }
    return 0;
}

// W-STR-FIELD: is `fseg` a str-typed field of `rdefs[ridx]` (ftag == TC_T_STR)? A Vec
// field also answers `.len()`, so the str-method dispatch MUST gate on the field type.
// The Vec fields bind to annotated locals FIRST (bare-receiver methods resolve post-W-MOD;
// a direct field-receiver Vec method is still outside the mn surface — the W-ELEM lesson).
fn cv_field_isstr(rdefs: Vec<TcRec>, ridx: i64, fseg: str) -> bool {
    let rec: TcRec = rdefs.get(ridx);
    let fns: Vec<str> = rec.fnames;
    let fts: Vec<i64> = rec.ftags;
    let n: i64 = fns.len();
    let mut i: i64 = 0;
    let mut found: bool = false;
    while i < n {
        let fn2: str = fns.get(i);
        if fn2.bytes_eq(fseg) {
            let ft: i64 = fts.get(i);
            found = ft == TC_T_STR;
        } else {
        }
        i = i + 1;
    }
    return found;
}

// W-STR-FIELD: the NO-EMIT receiver discriminator for the str-method emitters. Returns
// 2 = a one-hop str-typed FIELD access (`rn::text` — env-record base + TC_T_STR field),
// 1 = a bare-path $str binding (the W-STR-A shape), 0 = neither (the caller falls through
// to the record/ST-2 paths). A deeper chain misses cv_env_rec on its colon-bearing base -> 0.
fn cv_str_receiver_ok(nodes: Arena<PNode>, kids: Vec<i64>, rid: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>) -> i64 {
    let rn: PNode = nodes.get(rid);
    if rn.kind == P_K_PATH {
    } else {
        return 0;
    }
    let rtext: str = rn.text;
    let rcc: i64 = tc_last_colons(rtext);
    if rcc < 0 {
        let risstr: bool = cv_env_isstr(env, rtext);
        if risstr {
            return 1;
        } else {
            return 0;
        }
    } else {
    }
    let tlen: i64 = rtext.len();
    let fbase: str = rtext.substr(0, rcc);
    let fseg: str = rtext.substr(rcc + 2, tlen);
    let brec: i64 = cv_env_rec(env, fbase);
    if brec >= 0 {
    } else {
        return 0;
    }
    let fstr: bool = cv_field_isstr(rdefs, brec, fseg);
    if fstr {
        return 2;
    } else {
        return 0;
    }
}

// W-STR-FIELD: materialize the (already ok-gated) str receiver to its pair-pointer var.
// Bare $str -> the existing env var (NO emission); a one-hop field -> cv_to_var (the reg1
// LoadField-Ptr temp — the oracle's exact shape). The caller freshes its dst FIRST (the
// pinned order: dst, receiver, args). Returns -1 unresolvable (the caller poisons).
fn cv_str_receiver_var(nodes: Arena<PNode>, kids: Vec<i64>, rid: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let rn: PNode = nodes.get(rid);
    if rn.kind == P_K_PATH {
    } else {
        return 0 - 1;
    }
    let rtext: str = rn.text;
    let rcc: i64 = tc_last_colons(rtext);
    if rcc < 0 {
        let rv: i64 = cv_env_var(env, rtext);
        return rv;
    } else {
    }
    let fv: i64 = cv_to_var(nodes, kids, rid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
    return fv;
}

// W-STR-B: the str-method DESUGAR emitter — the five stdlib-backed methods lower to a PLAIN
// Call of the module-qualified stdlib fn with the receiver as arg0 (the oracle's tc desugar;
// Phase-0: Call{dst, FuncId, [recv, ...args]}, no wrapping). Gate: a bare-path receiver that is
// $str-sentinel (concat/bytes_eq/join/contains) or I64-token (itoa). Returns dst, or -2 when
// not a desugar method (the caller falls through).
fn cv_emit_strdesugar(nodes: Arena<PNode>, kids: Vec<i64>, dstgiven: i64, eid: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(eid);
    if n.kind == P_K_METHOD {
    } else {
        return 0 - 2;
    }
    if n.child_count >= 1 {
    } else {
        return 0 - 2;
    }
    let mut target: str = "";
    let mut rettok: str = "";
    let mut wantstr: bool = true;
    let dcc: bool = n.text.bytes_eq("concat");
    if dcc {
        target = "str_concat";
        rettok = "Ptr";
    } else {
    }
    let dbe: bool = n.text.bytes_eq("bytes_eq");
    if dbe {
        target = "str_bytes_eq";
        rettok = "Bool";
    } else {
    }
    let djn: bool = n.text.bytes_eq("join");
    if djn {
        target = "str_join";
        rettok = "Ptr";
    } else {
    }
    let dct: bool = n.text.bytes_eq("contains");
    if dct {
        target = "str_contains";
        rettok = "Bool";
    } else {
    }
    let dit: bool = n.text.bytes_eq("itoa");
    if dit {
        target = "str_itoa";
        rettok = "Ptr";
        wantstr = false;
    } else {
    }
    // Stage-3-0: `ptr.from_bytes(len)` on an i64 receiver -> `str_from_bytes(ptr, len)` (methods.rs:880).
    // The forge INPUT boundary (validates raw bytes into an Option<str>, tok Ptr). Like itoa: an I64
    // receiver + the trailing len arg the shared arg-loop appends. The other half of the with-driver
    // tool_main the selfhost never had to emit (the driver-less library has no forge entry).
    let dfb: bool = n.text.bytes_eq("from_bytes");
    if dfb {
        target = "str_from_bytes";
        rettok = "Ptr";
        wantstr = false;
    } else {
    }
    if target.len() > 0 {
    } else {
        return 0 - 2;
    }
    let rid: i64 = kids.get(n.child_start);
    // W-STR-FIELD: the wantstr methods take a bare $str binding OR a one-hop str-typed field
    // access (the ok gate is NO-EMIT); itoa stays bare-I64-only. Order: dst freshes FIRST,
    // then the receiver materializes (a field hop = the reg1 LoadField-Ptr temp), then args.
    if wantstr {
        let rok: i64 = cv_str_receiver_ok(nodes, kids, rid, env, rdefs);
        if rok > 0 {
        } else {
            return 0 - 2;
        }
    } else {
        // W-FIELDITOA: itoa takes a bare I64 binding OR a one-hop I64-typed field access
        // (`tv::value` — the parser_const/tc_emit_expr shape); mirrors the wantstr gate.
        let rn: PNode = nodes.get(rid);
        if rn.kind == P_K_PATH {
        } else {
            return 0 - 2;
        }
        let rcc: i64 = tc_last_colons(rn.text);
        if rcc < 0 {
            let rtok: str = cv_env_tytok(env, rn.text);
            let ri64: bool = rtok.bytes_eq("I64");
            if ri64 {
            } else {
                return 0 - 2;
            }
        } else {
            let rtext: str = rn.text;
            let tlen: i64 = rtext.len();
            let fbase: str = rtext.substr(0, rcc);
            let fseg: str = rtext.substr(rcc + 2, tlen);
            let brec: i64 = cv_env_rec(env, fbase);
            if brec >= 0 {
            } else {
                return 0 - 2;
            }
            let ftok: str = cv_field_tok(rdefs, brec, fseg);
            let fi64: bool = ftok.bytes_eq("I64");
            if fi64 {
            } else {
                return 0 - 2;
            }
        }
    }
    let fid: i64 = cv_fid_find(fids, target);
    if fid < 0 {
        let qpo: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0 - 1;
    } else {
    }
    // X6: dst freshes BEFORE the receiver/arg materialization (the pinned order).
    let mut dst: i64 = dstgiven;
    if dst < 0 {
        dst = cv_fresh(rettok, base, locals);
    } else {
    }
    let mut rv: i64 = 0 - 1;
    if wantstr {
        rv = cv_str_receiver_var(nodes, kids, rid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
    } else {
        // W-FIELDITOA: a field receiver materializes via cv_to_var (the reg1 LoadField-I64
        // temp) AFTER the dst freshed — the same pinned (dst, receiver, args) order.
        let rn3: PNode = nodes.get(rid);
        let rcc3: i64 = tc_last_colons(rn3.text);
        if rcc3 < 0 {
            rv = cv_env_var(env, rn3.text);
        } else {
            rv = cv_to_var(nodes, kids, rid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        }
    }
    if rv < 0 {
        let qp1: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0 - 1;
    } else {
    }
    let mut cargs: Vec<str> = Vec::new();
    let rvs: str = cv_i64_str(rv);
    let vld0: str = "v";
    let rvv: str = vld0.concat(rvs);
    let qr: i64 = cargs.push(rvv);
    let mut ai: i64 = 1;
    while ai < n.child_count {
        let aid: i64 = kids.get(n.child_start + ai);
        let av: i64 = cv_to_var(nodes, kids, aid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        let avs: str = cv_i64_str(av);
        let vld: str = "v";
        let avv: str = vld.concat(avs);
        let qa: i64 = cargs.push(avv);
        ai = ai + 1;
    }
    let asp: str = " ";
    let sargs: str = asp.join(cargs);
    let qc: i64 = stmts.push(CvStmt { kind: CVS_CALL, a: dst, b: fid, c: 0, d: 0, s: sargs });
    return dst;
}

// W-STR-A: the str-intrinsic METHOD emitter (len / byte_at / substr on a Str-token
// receiver). Returns the dst var, or -2 when not a str intrinsic (the caller falls through).
// Sequences + fresh ORDER mirror the oracle exactly (wstra_phase0_probe pins; X6 dst-first).
fn cv_emit_strintr(nodes: Arena<PNode>, kids: Vec<i64>, dstgiven: i64, eid: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(eid);
    if n.kind == P_K_METHOD {
    } else {
        return 0 - 2;
    }
    if n.child_count >= 1 {
    } else {
        return 0 - 2;
    }
    let isln: bool = n.text.bytes_eq("len");
    let isba: bool = n.text.bytes_eq("byte_at");
    let issu: bool = n.text.bytes_eq("substr");
    let isao: bool = n.text.bytes_eq("as_output");
    let mut known: bool = isln;
    if isba {
        known = true;
    } else {
    }
    if issu {
        known = true;
    } else {
    }
    if isao {
        known = true;
    } else {
    }
    if known {
    } else {
        return 0 - 2;
    }
    // W-STR-FIELD: a bare-path $str binding OR a one-hop str-typed field access (`rn::text`).
    // The gate is NO-EMIT (cv_str_receiver_ok); each arm freshes its dst FIRST, then
    // materializes the receiver (a field hop = the reg1 LoadField-Ptr temp), then the args —
    // the pinned oracle order (dst, receiver, args; wsf2 probes). Any other shape falls
    // through to the record/ST-2 paths.
    let rid: i64 = kids.get(n.child_start);
    let rok: i64 = cv_str_receiver_ok(nodes, kids, rid, env, rdefs);
    if rok > 0 {
    } else {
        return 0 - 2;
    }
    if isln {
        let mut dst: i64 = dstgiven;
        if dst < 0 {
            dst = cv_fresh("I64", base, locals);
        } else {
        }
        let rv: i64 = cv_str_receiver_var(nodes, kids, rid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        if rv < 0 {
            let qpo: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            return 0 - 1;
        } else {
        }
        let t0: i64 = cv_fresh("U32", base, locals);
        let ql: i64 = stmts.push(CvStmt { kind: CVS_LF2, a: t0, b: rv, c: 4, d: 0, s: "U32" });
        let qe: i64 = stmts.push(CvStmt { kind: CVS_EXT_U32, a: dst, b: t0, c: 0, d: 0, s: "" });
        return dst;
    } else {
    }
    if isba {
        if n.child_count >= 2 {
        } else {
            let qp1: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            return 0 - 1;
        }
        let mut dst: i64 = dstgiven;
        if dst < 0 {
            dst = cv_fresh("I64", base, locals);
        } else {
        }
        let rv: i64 = cv_str_receiver_var(nodes, kids, rid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        if rv < 0 {
            let qpb: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            return 0 - 1;
        } else {
        }
        let a0id: i64 = kids.get(n.child_start + 1);
        let a0: i64 = cv_to_var(nodes, kids, a0id, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        let w0: i64 = cv_fresh("U32", base, locals);
        let qw: i64 = stmts.push(CvStmt { kind: CVS_WRAP, a: w0, b: a0, c: 0, d: 0, s: "" });
        let ln0: i64 = cv_fresh("U32", base, locals);
        let ql2: i64 = stmts.push(CvStmt { kind: CVS_LF2, a: ln0, b: rv, c: 4, d: 0, s: "U32" });
        let ob: i64 = cv_fresh("Bool", base, locals);
        let qc: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: ob, b: w0, c: T_GTEQ, d: ln0, s: "" });
        let qt: i64 = stmts.push(CvStmt { kind: CVS_TRAP, a: ob, b: 0, c: 0, d: 0, s: "" });
        let bp: i64 = cv_fresh("U32", base, locals);
        let qp: i64 = stmts.push(CvStmt { kind: CVS_LF2, a: bp, b: rv, c: 0, d: 0, s: "U32" });
        let ad: i64 = cv_fresh("U32", base, locals);
        let qa: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: ad, b: bp, c: T_PLUS, d: w0, s: "" });
        let qld: i64 = stmts.push(CvStmt { kind: CVS_LD8, a: dst, b: ad, c: 0, d: 0, s: "" });
        return dst;
    } else {
    }
    // Stage-3-0: `s.as_output()` -> StrAsOutput (air.rs:3301). Packs the str fat-pointer
    // header into the forge return `(data_ptr << 32) | len`: load data_ptr (u32 @0) + len
    // (u32 @4), zero-extend each to i64, then shift + or. Fresh ORDER mirrors the oracle
    // (dst, receiver, dptr_u32, dptr, len_u32, len, shift, shifted). This is the ONLY forge-ABI
    // boundary intrinsic with no SIGIL-source alternative — required for the selfhost to emit a
    // runnable tool_main (the Thompson-closure with-driver capstone).
    if isao {
        let mut dst: i64 = dstgiven;
        if dst < 0 {
            dst = cv_fresh("I64", base, locals);
        } else {
        }
        let rv: i64 = cv_str_receiver_var(nodes, kids, rid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        if rv < 0 {
            let qpa: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            return 0 - 1;
        } else {
        }
        let dpu: i64 = cv_fresh("U32", base, locals);
        let qdp: i64 = stmts.push(CvStmt { kind: CVS_LF2, a: dpu, b: rv, c: 0, d: 0, s: "U32" });
        let dp: i64 = cv_fresh("I64", base, locals);
        let qde: i64 = stmts.push(CvStmt { kind: CVS_EXT_U32, a: dp, b: dpu, c: 0, d: 0, s: "" });
        let lnu: i64 = cv_fresh("U32", base, locals);
        let qlf: i64 = stmts.push(CvStmt { kind: CVS_LF2, a: lnu, b: rv, c: 4, d: 0, s: "U32" });
        let ln: i64 = cv_fresh("I64", base, locals);
        let qle: i64 = stmts.push(CvStmt { kind: CVS_EXT_U32, a: ln, b: lnu, c: 0, d: 0, s: "" });
        let sh: i64 = cv_fresh("I64", base, locals);
        let qsh: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: sh, b: 32, c: 0, d: 0, s: "" });
        let shd: i64 = cv_fresh("I64", base, locals);
        let qsl: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: shd, b: dp, c: T_LTLT, d: sh, s: "" });
        let qor: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: dst, b: shd, c: T_PIPE, d: ln, s: "" });
        return dst;
    } else {
    }
    if n.child_count >= 3 {
    } else {
        let qp2: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0 - 1;
    }
    let mut dst: i64 = dstgiven;
    if dst < 0 {
        dst = cv_fresh("Ptr", base, locals);
    } else {
    }
    let rv: i64 = cv_str_receiver_var(nodes, kids, rid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
    if rv < 0 {
        let qps: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0 - 1;
    } else {
    }
    let aid: i64 = kids.get(n.child_start + 1);
    let bid: i64 = kids.get(n.child_start + 2);
    let av: i64 = cv_to_var(nodes, kids, aid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
    let bv: i64 = cv_to_var(nodes, kids, bid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
    let l4: i64 = cv_fresh("U32", base, locals);
    let q1: i64 = stmts.push(CvStmt { kind: CVS_LF2, a: l4, b: rv, c: 4, d: 0, s: "U32" });
    let l5: i64 = cv_fresh("I64", base, locals);
    let q2: i64 = stmts.push(CvStmt { kind: CVS_EXT_U32, a: l5, b: l4, c: 0, d: 0, s: "" });
    let z6: i64 = cv_fresh("I64", base, locals);
    let q3: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: z6, b: 0, c: 0, d: 0, s: "" });
    let c7: i64 = cv_fresh("Bool", base, locals);
    let q4: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: c7, b: av, c: T_LT, d: z6, s: "" });
    let q5: i64 = stmts.push(CvStmt { kind: CVS_TRAP, a: c7, b: 0, c: 0, d: 0, s: "" });
    let c8: i64 = cv_fresh("Bool", base, locals);
    let q6: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: c8, b: bv, c: T_LT, d: z6, s: "" });
    let q7: i64 = stmts.push(CvStmt { kind: CVS_TRAP, a: c8, b: 0, c: 0, d: 0, s: "" });
    let c9: i64 = cv_fresh("Bool", base, locals);
    let q8: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: c9, b: av, c: T_GT, d: bv, s: "" });
    let q9: i64 = stmts.push(CvStmt { kind: CVS_TRAP, a: c9, b: 0, c: 0, d: 0, s: "" });
    let c10: i64 = cv_fresh("Bool", base, locals);
    let q10: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: c10, b: bv, c: T_GT, d: l5, s: "" });
    let q11: i64 = stmts.push(CvStmt { kind: CVS_TRAP, a: c10, b: 0, c: 0, d: 0, s: "" });
    let w11: i64 = cv_fresh("U32", base, locals);
    let q12: i64 = stmts.push(CvStmt { kind: CVS_WRAP, a: w11, b: av, c: 0, d: 0, s: "" });
    let w12: i64 = cv_fresh("U32", base, locals);
    let q13: i64 = stmts.push(CvStmt { kind: CVS_WRAP, a: w12, b: bv, c: 0, d: 0, s: "" });
    let p13: i64 = cv_fresh("U32", base, locals);
    let q14: i64 = stmts.push(CvStmt { kind: CVS_LF2, a: p13, b: rv, c: 0, d: 0, s: "U32" });
    let mut ei: i64 = 0;
    while ei < 2 {
        let mut ev: i64 = av;
        if ei == 1 {
            ev = bv;
        } else {
        }
        let z14: i64 = cv_fresh("I64", base, locals);
        let qz: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: z14, b: 0, c: 0, d: 0, s: "" });
        let m15: i64 = cv_fresh("Bool", base, locals);
        let qm1: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: m15, b: ev, c: T_LT, d: l5, s: "" });
        let m16: i64 = cv_fresh("Bool", base, locals);
        let qm2: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: m16, b: ev, c: T_GT, d: z14, s: "" });
        let m17: i64 = cv_fresh("Bool", base, locals);
        let qm3: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: m17, b: m16, c: T_AMP, d: m15, s: "" });
        let s18: i64 = cv_fresh("I64", base, locals);
        let qs: i64 = stmts.push(CvStmt { kind: CVS_CTSEL, a: s18, b: m15, c: ev, d: z14, s: "" });
        let w19: i64 = cv_fresh("U32", base, locals);
        let qw2: i64 = stmts.push(CvStmt { kind: CVS_WRAP, a: w19, b: s18, c: 0, d: 0, s: "" });
        let a20: i64 = cv_fresh("U32", base, locals);
        let qa2: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: a20, b: p13, c: T_PLUS, d: w19, s: "" });
        let b21: i64 = cv_fresh("I64", base, locals);
        let qb2: i64 = stmts.push(CvStmt { kind: CVS_LD8, a: b21, b: a20, c: 0, d: 0, s: "" });
        let k22: i64 = cv_fresh("I64", base, locals);
        let qk: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: k22, b: 192, c: 0, d: 0, s: "" });
        let x23: i64 = cv_fresh("I64", base, locals);
        let qx: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: x23, b: b21, c: T_AMP, d: k22, s: "" });
        let k24: i64 = cv_fresh("I64", base, locals);
        let qk2: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: k24, b: 128, c: 0, d: 0, s: "" });
        let e25: i64 = cv_fresh("Bool", base, locals);
        let qe2: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: e25, b: x23, c: T_EQEQ, d: k24, s: "" });
        let f26: i64 = cv_fresh("Bool", base, locals);
        let qf: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: f26, b: m17, c: T_AMP, d: e25, s: "" });
        let qt2: i64 = stmts.push(CvStmt { kind: CVS_TRAP, a: f26, b: 0, c: 0, d: 0, s: "" });
        ei = ei + 1;
    }
    // NO explicit CVS_FUEL here: the shared fuel machinery already inserts the per-alloc
    // decrement before a CVS_BA (the oracle's FuelDecrement in the pin came from fuel::insert).
    let qba: i64 = stmts.push(CvStmt { kind: CVS_BA, a: dst, b: 8, c: 4, d: 0, s: "" });
    let n40: i64 = cv_fresh("U32", base, locals);
    let qn1: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: n40, b: p13, c: T_PLUS, d: w11, s: "" });
    let qsf1: i64 = stmts.push(CvStmt { kind: CVS_SF, a: dst, b: n40, c: 0, d: 0, s: "U32" });
    let n41: i64 = cv_fresh("U32", base, locals);
    let qn2: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: n41, b: w12, c: T_MINUS, d: w11, s: "" });
    let qsf2: i64 = stmts.push(CvStmt { kind: CVS_SF, a: dst, b: n41, c: 4, d: 0, s: "U32" });
    return dst;
}

fn cv_emit_string(sd: i64, text: str, base: i64, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let qba: i64 = stmts.push(CvStmt { kind: CVS_BA, a: sd, b: 8, c: 4, d: 0, s: "" });
    let dp: i64 = cv_fresh("U32", base, locals);
    let qdp: i64 = stmts.push(CvStmt { kind: CVS_AS_STR, a: dp, b: 0, c: 0, d: 0, s: text });
    let qs1: i64 = stmts.push(CvStmt { kind: CVS_SF, a: sd, b: dp, c: 0, d: 0, s: "U32" });
    let ln: i64 = cv_fresh("U32", base, locals);
    let bl: i64 = text.len();
    let qln: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: ln, b: bl, c: 0, d: 0, s: "" });
    let qs2: i64 = stmts.push(CvStmt { kind: CVS_SF, a: sd, b: ln, c: 4, d: 0, s: "U32" });
    return 0;
}

fn cv_emit_rec(nodes: Arena<PNode>, kids: Vec<i64>, rd: i64, eid: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(eid);
    let mut wnames: Vec<str> = Vec::new();
    let mut wvars: Vec<i64> = Vec::new();
    let mut ri: i64 = 0;
    while ri < n.child_count {
        let fvid: i64 = kids.get(n.child_start + ri);
        let fv: i64 = cv_to_var(nodes, kids, fvid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        let fnm: str = tc_seg_at(n.text, ri + 1);
        let qn: i64 = wnames.push(fnm);
        let qv: i64 = wvars.push(fv);
        ri = ri + 1;
    }
    // Mats stay WRITTEN-order (evaluation order); the rendered pair list follows
    // DECL order — the oracle normalizes RecordConstruct.fields to the registry's
    // decl order (air.rs lower_record_construct, the field-order soundness fix).
    let rnm: str = tc_seg_at(n.text, 0);
    let rcode: i64 = tc_code_of_name(rnm, rdefs);
    let mut rfs: Vec<str> = Vec::new();
    let nw: i64 = wnames.len();
    if rcode >= TC_REC_BASE {
        let ridx: i64 = rcode - TC_REC_BASE;
        let rrec: TcRec = rdefs.get(ridx);
        let nf: i64 = rrec.fnames.len();
        let mut di: i64 = 0;
        while di < nf {
            let dn: str = rrec.fnames.get(di);
            let mut wi: i64 = 0;
            while wi < nw {
                let wn: str = wnames.get(wi);
                let same: bool = wn.bytes_eq(dn);
                if same {
                    let fv2: i64 = wvars.get(wi);
                    let fvs: str = cv_i64_str(fv2);
                    let fp0: str = dn.concat("=v");
                    let fp1: str = fp0.concat(fvs);
                    let qf: i64 = rfs.push(fp1);
                } else {
                }
                wi = wi + 1;
            }
            di = di + 1;
        }
    } else {
        // not a record decl (can't typecheck) — render an empty pair list: the
        // mismatch diffs loud against the oracle.
    }
    let rsp: str = " ";
    let rstr: str = rsp.join(rfs);
    let qr: i64 = stmts.push(CvStmt { kind: CVS_AS_REC, a: rd, b: 0, c: 0, d: 0, s: rstr });
    return 0;
}

// ST-3: the `;`-joined element-type tokens of a P_K_TYPE_TUPLE annotation ("I64;I64"),
// or "" if not a tuple type. Widths for the destructure come from cv_ty_width per seg.
fn cv_tuptys_of_typenode(nodes: Arena<PNode>, kids: Vec<i64>, tid: i64, rdefs: Vec<TcRec>) -> str ! { Alloc } {
    if tid < 0 {
        return "";
    } else {
    }
    let n: PNode = nodes.get(tid);
    if n.kind == P_K_TYPE_TUPLE {
    } else {
        return "";
    }
    let mut ts: Vec<str> = Vec::new();
    let mut i: i64 = 0;
    while i < n.child_count {
        let ecid: i64 = kids.get(n.child_start + i);
        let etok: str = ai_airtype_of_typenode(nodes, kids, ecid, rdefs);
        let q: i64 = ts.push(etok);
        i = i + 1;
    }
    let semi: str = ";";
    return semi.join(ts);
}

// ST-3: the tuptys of an env binding (last-wins), or "" (mirrors cv_env_rec).
fn cv_env_tuptys(env: Vec<CvBind>, name: str) -> str {
    let n: i64 = env.len();
    let mut i: i64 = n - 1;
    while i >= 0 {
        let b: CvBind = env.get(i);
        let eq: bool = b.name.bytes_eq(name);
        if eq {
            return b.tuptys;
        } else {
        }
        i = i - 1;
    }
    return "";
}

// ST-3: a tuple CONSTRUCT `(e0, e1, …)` -> a positional `Rec(0=vN 1=vM …)` (field names are
// the indices; positional = decl order, no #457 normalize). cv_mem_lower expands it via the
// VALUE var widths — no synthetic TcRec needed. Mats first (X6: dst freshed by the caller).
fn cv_emit_tuple(nodes: Arena<PNode>, kids: Vec<i64>, td: i64, eid: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(eid);
    let mut rfs: Vec<str> = Vec::new();
    let mut ti: i64 = 0;
    while ti < n.child_count {
        let evid: i64 = kids.get(n.child_start + ti);
        let ev: i64 = cv_to_var(nodes, kids, evid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        let inm: str = cv_i64_str(ti);
        let evs: str = cv_i64_str(ev);
        let fp0: str = inm.concat("=v");
        let fp1: str = fp0.concat(evs);
        let qf: i64 = rfs.push(fp1);
        ti = ti + 1;
    }
    let rsp: str = " ";
    let rstr: str = rsp.join(rfs);
    let qr: i64 = stmts.push(CvStmt { kind: CVS_AS_REC, a: td, b: 0, c: 0, d: 0, s: rstr });
    return 0;
}

// CAP-MATCH: does `name` name a VARIANT of any enum rdef? (variant names are enum-unique,
// AG-ST-AMBIGVARIANT) — returns the rdef index or -1.
fn cv_variant_find(rdefs: Vec<TcRec>, name: str) -> i64 {
    let n: i64 = rdefs.len();
    let mut i: i64 = 0;
    while i < n {
        let rc: TcRec = rdefs.get(i);
        let nv: i64 = rc.vnames.len();
        let mut v: i64 = 0;
        while v < nv {
            let vn: str = rc.vnames.get(v);
            if vn.bytes_eq(name) {
                return i;
            } else {
            }
            v = v + 1;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn cv_enum_ctor_inst_size(nodes: Arena<PNode>, kids: Vec<i64>, eid: i64, eridx: i64, vidx: i64, pstart: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, cnames: Vec<str>, cvals: Vec<i64>) -> i64 ! { Alloc } {
    let rec: TcRec = rdefs.get(eridx);
    let ntp: i64 = rec.tpnames.len();
    if ntp == 0 {
        return cv_enum_total_size(rdefs, eridx);
    } else {
    }
    let mut widths: Vec<i64> = Vec::new();
    let mut wi: i64 = 0;
    while wi < ntp {
        let qw: i64 = widths.push(0 - 1);
        wi = wi + 1;
    }
    let n: PNode = nodes.get(eid);
    let vs: i64 = rec.vstarts.get(vidx);
    let vc: i64 = rec.vcounts.get(vidx);
    let argc: i64 = n.child_count - pstart;
    if argc != vc {
        return 0;
    } else {
    }
    let mut ai: i64 = 0;
    while ai < argc {
        let ptp: i64 = rec.vptp.get(vs + ai);
        if ptp >= 0 {
            if ptp >= ntp {
                return 0;
            } else {
            }
            let argid: i64 = kids.get(n.child_start + pstart + ai);
            let tok: str = cv_expr_tytok(nodes, kids, argid, env, rdefs, sigs, cnames, cvals);
            if cv_ty_known(tok) {
                let width: i64 = cv_ty_width(tok);
                let old: i64 = widths.get(ptp);
                if old >= 0 {
                    if old != width {
                        return 0;
                    } else {
                    }
                } else {
                }
                let qs: i64 = widths.set(ptp, width);
            } else {
                return 0;
            }
        } else {
        }
        ai = ai + 1;
    }
    return cv_enum_size_with_widths(rdefs, eridx, widths);
}

fn cv_emit_enum_ctor(nodes: Arena<PNode>, kids: Vec<i64>, ed: i64, eid: i64, eridx: i64, vidx: i64, pstart: i64, esz: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(eid);
    // CAP-ENUM (capstone, scalar): a GENERIC enum's def sizes its T payloads at width 4
    // (un-substituted), so `Some(x: i64)` under-allocated 8 where the oracle's INSTANCE
    // cell is 12 — a SILENT wrong-size alloc (the stores were always arg-token-correct).
    // The cell must at least hold what THIS ctor stores: size = max(def size, 4 + the
    // actual arg widths). Concrete enums are byte-UNCHANGED (their def size is already
    // the max over variants); unit ctors (None) never reach this fn's alloc with args.
    // A generic enum's SMALLER payload-bearing variant stays divergent (AG: zero
    // instances — Option's only payload variant is Some; the tuple payload is CAP-ENUM's
    // second sub-slice).
    let erec: TcRec = rdefs.get(eridx);
    let mut tsz0: i64 = esz;
    if tsz0 <= 0 {
        tsz0 = cv_enum_ctor_inst_size(nodes, kids, eid, eridx, vidx, pstart, env, rdefs, sigs, cnames, cvals);
    } else {
    }
    if erec.tpnames.len() > 0 {
        if tsz0 <= 0 {
            let qpoison: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            return 0;
        } else {
        }
    } else {
    }
    if tsz0 <= 0 {
        tsz0 = cv_enum_total_size(rdefs, eridx);
    } else {
    }
    let mut argw: i64 = 0;
    let mut pw0: i64 = pstart;
    while pw0 < n.child_count {
        let awid: i64 = kids.get(n.child_start + pw0);
        let awty: str = cv_expr_tytok(nodes, kids, awid, env, rdefs, sigs, cnames, cvals);
        argw = argw + cv_ty_width(awty);
        pw0 = pw0 + 1;
    }
    let mut tsz: i64 = tsz0;
    if 4 + argw > tsz {
        tsz = 4 + argw;
    } else {
    }
    let qba: i64 = stmts.push(CvStmt { kind: CVS_BA, a: ed, b: tsz, c: 4, d: 0, s: "" });
    let tg: i64 = cv_fresh("I32", base, locals);
    let qtg: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: tg, b: vidx, c: 0, d: 0, s: "" });
    let qsf: i64 = stmts.push(CvStmt { kind: CVS_SF, a: ed, b: tg, c: 0, d: 0, s: "I32" });
    let mut acc: i64 = 4;
    let mut pi2: i64 = pstart;
    while pi2 < n.child_count {
        let agid: i64 = kids.get(n.child_start + pi2);
        let av: i64 = cv_to_var(nodes, kids, agid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        let aty: str = cv_expr_tytok(nodes, kids, agid, env, rdefs, sigs, cnames, cvals);
        let qsp: i64 = stmts.push(CvStmt { kind: CVS_SF, a: ed, b: av, c: acc, d: 0, s: aty });
        acc = acc + cv_ty_width(aty);
        pi2 = pi2 + 1;
    }
    return 0;
}

// Mirror `lower_expr_to_var` (air.rs:1789) on the CV-1 surface. A bare local returns its env id
// with NO alloc and NO stmt; everything else freshes a dst FIRST (X6) then produces into it.
// B-DISPATCH: the RECORD index of a method receiver path — bare (`v` -> env rec) or ONE field
// hop (`self::store` -> the base's env rec, then the field's ftag when it names a record). -1
// when unresolvable (the caller poisons loud). Mirrors the oracle's receiver typing; deeper
// chains (`a::b::c`) stay out (the tc AG-G19 targ-threading line).
fn cv_recv_rec(env: Vec<CvBind>, rdefs: Vec<TcRec>, text: str) -> i64 {
    let cc: i64 = tc_last_colons(text);
    if cc < 0 {
        return cv_env_rec(env, text);
    } else {
    }
    let tlen: i64 = text.len();
    let fbase: str = text.substr(0, cc);
    let fseg: str = text.substr(cc + 2, tlen);
    let bcc: i64 = tc_last_colons(fbase);
    if bcc >= 0 {
        return 0 - 1;
    } else {
    }
    let brec: i64 = cv_env_rec(env, fbase);
    if brec < 0 {
        return 0 - 1;
    } else {
    }
    let r: TcRec = rdefs.get(brec);
    let nf: i64 = r.fnames.len();
    let mut i: i64 = 0;
    while i < nf {
        let fname: str = r.fnames.get(i);
        if fname.bytes_eq(fseg) {
            let ftag: i64 = r.ftags.get(i);
            if ftag >= TC_REC_BASE {
                return ftag - TC_REC_BASE;
            } else {
            }
            return 0 - 1;
        } else {
        }
        i = i + 1;
    }
    return 0 - 1;
}

// W-CONST: the top-level const table lookup (name -> the literal value; -1 = miss). The
// oracle INLINES every const reference as a fresh IntLit temp — no globals, no memory.
fn cv_ctbl_find(cnames: Vec<str>, cvals: Vec<i64>, name: str) -> i64 {
    let n: i64 = cnames.len();
    let mut i: i64 = 0;
    while i < n {
        let c: str = cnames.get(i);
        if c.bytes_eq(name) {
            return cvals.get(i);
        } else {
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn cv_fn_param_typeid(sigs: Vec<TcSig>, name: str, param_index: i64) -> i64 {
    let sidx: i64 = tc_sig_find(sigs, name);
    if sidx < 0 {
        return 0 - 1;
    } else {
    }
    let sig: TcSig = sigs.get(sidx);
    if param_index < 0 {
        return 0 - 1;
    } else {
    }
    if param_index >= sig.param_typeids.len() {
        return 0 - 1;
    } else {
    }
    return sig.param_typeids.get(param_index);
}

fn cv_expr_is_enum_ctor_for(nodes: Arena<PNode>, kids: Vec<i64>, eid: i64, ridx: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, fids: Vec<str>) -> bool {
    let n: PNode = nodes.get(eid);
    if n.kind == P_K_PATH {
        let cc: i64 = tc_last_colons(n.text);
        let mut variant: str = n.text;
        if cc >= 0 {
            let base: str = n.text.substr(0, cc);
            if cv_env_var(env, base) >= 0 {
                return false;
            } else {
            }
            let rec: TcRec = rdefs.get(ridx);
            if base.bytes_eq(rec.name) {
            } else {
                return false;
            }
            variant = n.text.substr(cc + 2, n.text.len());
        } else {
        }
        let vidx: i64 = tc_variant_index(rdefs, ridx, variant);
        if vidx >= 0 {
            let rec2: TcRec = rdefs.get(ridx);
            return rec2.vcounts.get(vidx) == 0;
        } else {
        }
        return false;
    } else {
    }
    if n.kind == P_K_CALL {
        if cv_fid_find(fids, n.text) >= 0 {
            return false;
        } else {
        }
        return tc_variant_index(rdefs, ridx, n.text) >= 0;
    } else {
    }
    if n.kind == P_K_METHOD {
        if n.child_count > 0 {
            let recv_id: i64 = kids.get(n.child_start);
            let recv: PNode = nodes.get(recv_id);
            if recv.kind == P_K_PATH {
                let rec3: TcRec = rdefs.get(ridx);
                if recv.text.bytes_eq(rec3.name) {
                    return tc_variant_index(rdefs, ridx, n.text) >= 0;
                } else {
                }
            } else {
            }
        } else {
        }
    } else {
    }
    return false;
}

fn cv_to_var_expected(nodes: Arena<PNode>, kids: Vec<i64>, eid: i64, expected_tid: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let ridx: i64 = cv_rec_of_typenode(nodes, kids, expected_tid, rdefs);
    if ridx >= 0 {
        let rec: TcRec = rdefs.get(ridx);
        if rec.is_enum {
            if cv_expr_is_enum_ctor_for(nodes, kids, eid, ridx, env, rdefs, fids) {
            let mut esize: i64 = 0;
            if rec.tpnames.len() == 0 {
                esize = cv_enum_total_size(rdefs, ridx);
            } else {
                esize = cv_enum_inst_size(nodes, kids, rdefs, ridx, expected_tid);
            }
            if esize <= 0 {
                let qp: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                return 0;
            } else {
            }
            let dst: i64 = cv_fresh("Ptr", base, locals);
            let qi: i64 = cv_into(nodes, kids, dst, eid, base, env, rdefs, sigs, fids, cnames, cvals, "Ptr", ridx, esize, locals, stmts);
            return dst;
            } else {
            }
        } else {
        }
    } else {
    }
    return cv_to_var(nodes, kids, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
}

fn cv_to_var(nodes: Arena<PNode>, kids: Vec<i64>, eid: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(eid);
    if n.kind == P_K_PATH {
        let cc: i64 = tc_last_colons(n.text);
        if cc >= 0 {
            // SH-AIR-CV-3: a field READ (fresh dst + LF with the real offset) or an enum UNIT
            // construct (the pre-memory BA/tag/SF cell — the Ptr dst freshes FIRST, then the I32
            // tag; air.rs:3555 via the alloc-then-recurse split).
            let tlen: i64 = n.text.len();
            let fbase: str = n.text.substr(0, cc);
            let fseg: str = n.text.substr(cc + 2, tlen);
            let bvar: i64 = cv_env_var(env, fbase);
            let brec: i64 = cv_env_rec(env, fbase);
            if bvar >= 0 {
                if brec >= 0 {
                    let foff: i64 = cv_field_off(rdefs, brec, fseg);
                    if foff >= 0 {
                        let ftok: str = cv_field_tok(rdefs, brec, fseg);
                        let fd: i64 = cv_fresh(ftok, base, locals);
                        let qlf: i64 = stmts.push(CvStmt { kind: CVS_LF2, a: fd, b: bvar, c: foff, d: 0, s: ftok });
                        return fd;
                    } else {
                    }
                } else {
                }
            } else {
            }
            let ecode: i64 = tc_code_of_name(fbase, rdefs);
            if ecode >= TC_REC_BASE {
                let eridx: i64 = ecode - TC_REC_BASE;
                let erec: TcRec = rdefs.get(eridx);
                if erec.is_enum {
                    let vidx: i64 = tc_variant_index(rdefs, eridx, fseg);
                    if vidx >= 0 {
                        if erec.tpnames.len() > 0 {
                            let qpu: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                            return 0;
                        } else {
                        }
                        let ed: i64 = cv_fresh("Ptr", base, locals);
                        let tsz: i64 = cv_enum_total_size(rdefs, eridx);
                        let qba: i64 = stmts.push(CvStmt { kind: CVS_BA, a: ed, b: tsz, c: 4, d: 0, s: "" });
                        let etg: i64 = cv_fresh("I32", base, locals);
                        let qtg: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: etg, b: vidx, c: 0, d: 0, s: "" });
                        let qsf: i64 = stmts.push(CvStmt { kind: CVS_SF, a: ed, b: etg, c: 0, d: 0, s: "I32" });
                        return ed;
                    } else {
                    }
                } else {
                }
            } else {
            }
            let qpq: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            return 0;
        } else {
        }
        let v: i64 = cv_env_var(env, n.text);
        if v >= 0 {
            return v;
        } else {
        }
        // ST-1: a BARE unit enum variant `A` — a fallback AFTER the local miss
        // (X-ST1 precedence: local > variant). Mirrors the qualified E::A cell.
        let bvcode: i64 = tc_enum_of_variant(rdefs, n.text);
        if bvcode >= TC_REC_BASE {
            let bveridx: i64 = bvcode - TC_REC_BASE;
            let bvvidx: i64 = tc_variant_index(rdefs, bveridx, n.text);
            let bverec: TcRec = rdefs.get(bveridx);
            if bverec.tpnames.len() > 0 {
                let qpbu: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                return 0;
            } else {
            }
            let bved: i64 = cv_fresh("Ptr", base, locals);
            let bvtsz: i64 = cv_enum_total_size(rdefs, bveridx);
            let bvba: i64 = stmts.push(CvStmt { kind: CVS_BA, a: bved, b: bvtsz, c: 4, d: 0, s: "" });
            let bvtg: i64 = cv_fresh("I32", base, locals);
            let bvat: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: bvtg, b: bvvidx, c: 0, d: 0, s: "" });
            let bvsf: i64 = stmts.push(CvStmt { kind: CVS_SF, a: bved, b: bvtg, c: 0, d: 0, s: "I32" });
            return bved;
        } else {
        }
        // W-CONST: a top-level const reference (env + variant both missed) INLINES as a
        // fresh IntLit temp (the oracle's lowering; reference order = fresh order).
        let cvv: i64 = cv_ctbl_find(cnames, cvals, n.text);
        if cvv >= 0 {
            let cd: i64 = cv_fresh("I64", base, locals);
            let qci: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: cd, b: cvv, c: 0, d: 0, s: "" });
            return cd;
        } else {
        }
        let qp: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    } else {
    }
    if n.kind == P_K_CALL {
        let ccc: i64 = tc_last_colons(n.text);
        if ccc < 0 {
            // B-VEC: the memory intrinsics dispatch BEFORE the fid lookup (no user sig/fid).
            let vi: i64 = cv_emit_vecintr(nodes, kids, 0 - 1, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            if vi >= 0 {
                return vi;
            } else {
            }
            let fid: i64 = cv_fid_find(fids, n.text);
            if fid >= 0 {
                // X6: the call dst freshes BEFORE the args; dst renders None iff the callee
                // returns Unit (call_dst, air.rs:5183) — the Unit dst is a PHANTOM local.
                let rtok: str = cv_sig_ret_tok(sigs, n.text);
                let cd: i64 = cv_fresh(rtok, base, locals);
                let mut cargs: Vec<str> = Vec::new();
                let mut cai: i64 = 0;
                while cai < n.child_count {
                    let agid: i64 = kids.get(n.child_start + cai);
                    let aptid: i64 = cv_fn_param_typeid(sigs, n.text, cai);
                    let av2: i64 = cv_to_var_expected(nodes, kids, agid, aptid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                    let avs: str = cv_i64_str(av2);
                    let vld: str = "v";
                    let avv: str = vld.concat(avs);
                    let qav: i64 = cargs.push(avv);
                    cai = cai + 1;
                }
                let asp: str = " ";
                let argstr: str = asp.join(cargs);
                let mut cdst: i64 = cd;
                let isu: bool = rtok.bytes_eq("Unit");
                if isu {
                    cdst = 0 - 1;
                } else {
                }
                let qcl: i64 = stmts.push(CvStmt { kind: CVS_CALL, a: cdst, b: fid, c: 0, d: 0, s: argstr });
                return cd;
            } else {
            }
            // ST-1: a BARE payload enum variant `B(x)` — a fallback AFTER the
            // free-fn miss (X-ST1). A bare call's args start at child 0 (pstart).
            let pvcode: i64 = tc_enum_of_variant(rdefs, n.text);
            if pvcode >= TC_REC_BASE {
                let pveridx: i64 = pvcode - TC_REC_BASE;
                let pvvidx: i64 = tc_variant_index(rdefs, pveridx, n.text);
                let pved: i64 = cv_fresh("Ptr", base, locals);
                let pvq: i64 = cv_emit_enum_ctor(nodes, kids, pved, eid, pveridx, pvvidx, 0, 0, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                return pved;
            } else {
            }
        } else {
        }
        let qpc: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    } else {
    }
    if n.kind == P_K_LIT_INT {
        let d1: i64 = cv_fresh("I64", base, locals);
        let q1: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: d1, b: n.value, c: 0, d: 0, s: "" });
        return d1;
    } else {
    }
    if n.kind == P_K_LIT_BOOL {
        let d2: i64 = cv_fresh("Bool", base, locals);
        let q2: i64 = stmts.push(CvStmt { kind: CVS_AS_BOOL, a: d2, b: n.value, c: 0, d: 0, s: "" });
        return d2;
    } else {
    }
    if n.kind == P_K_BINARY {
        let ty: str = cv_expr_tytok(nodes, kids, eid, env, rdefs, sigs, cnames, cvals);
        let d3: i64 = cv_fresh(ty, base, locals);
        let opty: str = cv_binop_operand_ty(nodes, kids, n, env, rdefs, sigs, cnames, cvals);
        let lid: i64 = kids.get(n.child_start);
        let rid: i64 = kids.get(n.child_start + 1);
        let lv: i64 = cv_binop_mat(nodes, kids, lid, opty, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        let rv: i64 = cv_binop_mat(nodes, kids, rid, opty, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        let q3: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: d3, b: lv, c: n.value, d: rv, s: "" });
        return d3;
    } else {
    }
    if n.kind == P_K_TUPLE {
        let ttd: i64 = cv_fresh("Ptr", base, locals);
        let qtt: i64 = cv_emit_tuple(nodes, kids, ttd, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        return ttd;
    } else {
    }
    if n.kind == P_K_RECORD_CONSTRUCT {
        let rd: i64 = cv_fresh("Ptr", base, locals);
        let qe1: i64 = cv_emit_rec(nodes, kids, rd, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        return rd;
    } else {
    }
    if n.kind == P_K_ARRAY {
        let ad: i64 = cv_fresh("Ptr", base, locals);
        let qe2: i64 = cv_emit_array(nodes, kids, ad, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        return ad;
    } else {
    }
    if n.kind == P_K_LIT_STR {
        let sd: i64 = cv_fresh("Ptr", base, locals);
        let qe3: i64 = cv_emit_string(sd, n.text, base, locals, stmts);
        return sd;
    } else {
    }
    if n.kind == P_K_METHOD {
        // W-STR-A: str intrinsic methods (len/byte_at/substr on a Str-token receiver)
        // dispatch BEFORE the enum-ctor/ST-2 paths (no fid, no record).
        let sdi: i64 = cv_emit_strintr(nodes, kids, 0 - 1, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        if sdi >= 0 {
            return sdi;
        } else {
        }
        if sdi == 0 - 1 {
            // poison pushed — return the SAFE var id (the cv_to_var convention; a negative
            // id would flow into wb_uleb and never terminate).
            return 0;
        } else {
        }
        // W-STR-B: the stdlib-desugar methods (concat/bytes_eq/join/contains/itoa).
        let sdd: i64 = cv_emit_strdesugar(nodes, kids, 0 - 1, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        if sdd >= 0 {
            return sdd;
        } else {
        }
        if sdd == 0 - 1 {
            return 0;
        } else {
        }
        // SH-AIR-CV-4: the enum PAYLOAD ctor `E::B(args)` (2c's detection: child0 resolves via
        // rdefs to is_enum + the text is a variant). A real dot-method PANICS the oracle.
        if n.child_count >= 1 {
            let mrid: i64 = kids.get(n.child_start);
            let mrn: PNode = nodes.get(mrid);
            if mrn.kind == P_K_PATH {
                let mcode: i64 = tc_code_of_name(mrn.text, rdefs);
                if mcode >= TC_REC_BASE {
                    let meridx: i64 = mcode - TC_REC_BASE;
                    let merec: TcRec = rdefs.get(meridx);
                    if merec.is_enum {
                        let mvidx: i64 = tc_variant_index(rdefs, meridx, n.text);
                        if mvidx >= 0 {
                            let med: i64 = cv_fresh("Ptr", base, locals);
                            let qe4: i64 = cv_emit_enum_ctor(nodes, kids, med, eid, meridx, mvidx, 1, 0, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                            return med;
                        } else {
                        }
                    } else {
                    }
                } else {
                }
                // ST-2: a DOT-METHOD `p.get(args)` — child0 is a record VALUE
                // (mrv a local, mrr its record). Desugar to Call({Type}__{method},
                // [receiver, ...args]) — the oracle's type-check desugar; receiver
                // is arg0 (X-ST2). Not-a-record → falls through to POISON (loud).
                // B-DISPATCH: the receiver may be a bare local (`p.get()`) OR one field hop
                // (`self.store.push(..)` — a colon path). cv_recv_rec resolves the record
                // either way; a COLON receiver materializes via cv_to_var (the LoadField
                // temp) AFTER the call dst freshes (X6 — the oracle lowers receiver as arg0).
                let mcol: i64 = tc_last_colons(mrn.text);
                let mut mgate: bool = false;
                if mcol < 0 {
                    let mbv: i64 = cv_env_var(env, mrn.text);
                    if mbv >= 0 {
                        mgate = true;
                    } else {
                    }
                } else {
                    mgate = true;
                }
                let mrr: i64 = cv_recv_rec(env, rdefs, mrn.text);
                if mgate {
                    if mrr >= 0 {
                        let mrec2: TcRec = rdefs.get(mrr);
                        let mtail: str = tc_seg_at(n.text, 0);
                        // SH-MONO MONO-7: a PRE-RESOLVED generic-method call (mn_expand set flag
                        // 2^21 + patched n.text to the full instance mangle `Box__get__i64`).
                        // Use n.text DIRECTLY as the fid key AND the free-fn ret-sig key (the
                        // instance is a top-level fn, registered under that name) — the ordinary
                        // `{Type}__{method}` mangle would yield `Box__i64__get` (wrong order).
                        // Byte-safe: only mn_expand sets 2^21, so every non-monomorph W-lane
                        // composition takes the else-branch and emits identical bytes.
                        let mpre7: i64 = n.flags & 2097152;
                        let mut mmang: str = "";
                        let mut mrkey: str = "";
                        if mpre7 > 0 {
                            mmang = n.text;
                            mrkey = n.text;
                        } else {
                            let msep: str = mrec2.name.concat("__");
                            mmang = msep.concat(mtail);
                            let mrsep: str = mrec2.name.concat("::");
                            mrkey = mrsep.concat(mtail);
                        }
                        let mfid: i64 = cv_fid_find(fids, mmang);
                        if mfid >= 0 {
                            let mrtok: str = cv_sig_ret_tok(sigs, mrkey);
                            let mcd: i64 = cv_fresh(mrtok, base, locals);
                            let mut mrv: i64 = 0 - 1;
                            if mcol < 0 {
                                mrv = cv_env_var(env, mrn.text);
                            } else {
                                mrv = cv_to_var(nodes, kids, mrid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                            }
                            let mut margs: Vec<str> = Vec::new();
                            let mlead: str = "v";
                            let mrv0: str = mlead.concat(cv_i64_str(mrv));
                            let qm0: i64 = margs.push(mrv0);
                            let mut mmi: i64 = 1;
                            while mmi < n.child_count {
                                let magid: i64 = kids.get(n.child_start + mmi);
                                let mav: i64 = cv_to_var(nodes, kids, magid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                                let mavv: str = mlead.concat(cv_i64_str(mav));
                                let qma: i64 = margs.push(mavv);
                                mmi = mmi + 1;
                            }
                            let msp: str = " ";
                            let margstr: str = msp.join(margs);
                            let mut mdst: i64 = mcd;
                            let misu: bool = mrtok.bytes_eq("Unit");
                            if misu {
                                mdst = 0 - 1;
                            } else {
                            }
                            let qmcl: i64 = stmts.push(CvStmt { kind: CVS_CALL, a: mdst, b: mfid, c: 0, d: 0, s: margstr });
                            return mcd;
                        } else {
                        }
                    } else {
                    }
                } else {
                }
            } else {
            }
        } else {
        }
        let qpm: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    } else {
    }
    if n.kind == P_K_INDEX {
        // SH-AIR-CV-4: the index READ — dst first (X6), then the index mat, then the bounds
        // chain (elided for a literal index, #442), then LD by the ORIGINAL index var.
        let xrid: i64 = kids.get(n.child_start);
        let xrn: PNode = nodes.get(xrid);
        let mut xok: bool = false;
        let mut arrv: i64 = 0 - 1;
        let mut etok: str = "";
        if xrn.kind == P_K_PATH {
            arrv = cv_env_var(env, xrn.text);
            etok = cv_env_elem(env, xrn.text);
            if arrv >= 0 {
                if etok.len() > 0 {
                    xok = true;
                } else {
                }
            } else {
            }
        } else {
        }
        if xok {
            let xd: i64 = cv_fresh(etok, base, locals);
            let xiid: i64 = kids.get(n.child_start + 1);
            let xin: PNode = nodes.get(xiid);
            let xiv: i64 = cv_to_var(nodes, kids, xiid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            if xin.kind == P_K_LIT_INT {
            } else {
                // RF-M2: a covered range-for loop var elides the chain too (rf_index_elided).
                let xre: bool = rf_index_elided(nodes, kids, eid);
                if xre {
                } else {
                    let qch: i64 = cv_index_check(nodes, kids, xiid, xiv, arrv, base, env, rdefs, sigs, cnames, cvals, locals, stmts);
                }
            }
            let xw: i64 = cv_ty_width(etok);
            let qld: i64 = stmts.push(CvStmt { kind: CVS_LD_ELEM, a: xd, b: arrv, c: xiv, d: xw, s: etok });
            return xd;
        } else {
        }
        let qpx: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    } else {
    }
    let qz: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
    return 0;
}

// Mirror `lower_expr_into(dst, e)` (air.rs:1839) on the CV-1 surface: a local -> the never-elided
// `Var` copy; a literal -> DIRECTLY into dst (no temp — Phase-0 `let_lit`); a binary -> operand
// to_vars (freshed AFTER dst — X6) then the Bin into dst.
// `drec`/`dsz` carry an expected enum identity and its exact concrete cell size. A generic enum
// constructor without that context or complete payload inference poisons instead of using the
// generic definition's placeholder widths.
fn cv_into(nodes: Arena<PNode>, kids: Vec<i64>, dst: i64, eid: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, dstty: str, drec: i64, dsz: i64, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(eid);
    if n.kind == P_K_PATH {
        let cc: i64 = tc_last_colons(n.text);
        if cc >= 0 {
            // SH-AIR-CV-3 (into): a field READ loads DIRECTLY into dst (reg1's no-trailing-Assign
            // rule at operand level); an enum UNIT constructs into the given dst.
            let tlen: i64 = n.text.len();
            let fbase: str = n.text.substr(0, cc);
            let fseg: str = n.text.substr(cc + 2, tlen);
            let bvar: i64 = cv_env_var(env, fbase);
            let brec: i64 = cv_env_rec(env, fbase);
            if bvar >= 0 {
                if brec >= 0 {
                    let foff: i64 = cv_field_off(rdefs, brec, fseg);
                    if foff >= 0 {
                        let ftok: str = cv_field_tok(rdefs, brec, fseg);
                        let qlf: i64 = stmts.push(CvStmt { kind: CVS_LF2, a: dst, b: bvar, c: foff, d: 0, s: ftok });
                        return 0;
                    } else {
                    }
                } else {
                }
            } else {
            }
            let ecode: i64 = tc_code_of_name(fbase, rdefs);
            if ecode >= TC_REC_BASE {
                let eridx: i64 = ecode - TC_REC_BASE;
                let erec: TcRec = rdefs.get(eridx);
                if erec.is_enum {
                    let vidx: i64 = tc_variant_index(rdefs, eridx, fseg);
                    if vidx >= 0 {
                        if erec.tpnames.len() > 0 {
                            if dsz <= 0 {
                                let qpu: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                                return 0;
                            } else {
                            }
                        } else {
                        }
                        let mut tsz: i64 = cv_enum_total_size(rdefs, eridx);
                        if dsz > 0 {
                            tsz = dsz;
                        } else {
                        }
                        let qba: i64 = stmts.push(CvStmt { kind: CVS_BA, a: dst, b: tsz, c: 4, d: 0, s: "" });
                        let etg: i64 = cv_fresh("I32", base, locals);
                        let qtg: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: etg, b: vidx, c: 0, d: 0, s: "" });
                        let qsf: i64 = stmts.push(CvStmt { kind: CVS_SF, a: dst, b: etg, c: 0, d: 0, s: "I32" });
                        return 0;
                    } else {
                    }
                } else {
                }
            } else {
            }
            let qpq: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            return 0;
        } else {
        }
        let v: i64 = cv_env_var(env, n.text);
        if v >= 0 {
            let q0: i64 = stmts.push(CvStmt { kind: CVS_AS_VAR, a: dst, b: v, c: 0, d: 0, s: "" });
            return 0;
        } else {
        }
        // ST-1: a BARE unit enum variant `A` into dst (X-ST1 fallback).
        let mut bveridx: i64 = 0 - 1;
        if drec >= 0 {
            let dr: TcRec = rdefs.get(drec);
            if dr.is_enum {
                if tc_variant_index(rdefs, drec, n.text) >= 0 {
                    bveridx = drec;
                } else {
                }
            } else {
            }
        } else {
        }
        if bveridx < 0 {
            let bvcode: i64 = tc_enum_of_variant(rdefs, n.text);
            if bvcode >= TC_REC_BASE {
                bveridx = bvcode - TC_REC_BASE;
            } else {
            }
        } else {
        }
        if bveridx >= 0 {
            let bvvidx: i64 = tc_variant_index(rdefs, bveridx, n.text);
            let bverec: TcRec = rdefs.get(bveridx);
            if bverec.tpnames.len() > 0 {
                if dsz <= 0 {
                    let qpbu: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                    return 0;
                } else {
                }
            } else {
            }
            let mut bvtsz: i64 = cv_enum_total_size(rdefs, bveridx);
            if dsz > 0 {
                bvtsz = dsz;
            } else {
            }
            let bvba: i64 = stmts.push(CvStmt { kind: CVS_BA, a: dst, b: bvtsz, c: 4, d: 0, s: "" });
            let bvtg: i64 = cv_fresh("I32", base, locals);
            let bvat: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: bvtg, b: bvvidx, c: 0, d: 0, s: "" });
            let bvsf: i64 = stmts.push(CvStmt { kind: CVS_SF, a: dst, b: bvtg, c: 0, d: 0, s: "I32" });
            return 0;
        } else {
        }
        // W-INTOCONST: a top-level const reference as the INTO value (env + variant both
        // missed) INLINES as Assign dst IntLit — the assign-RHS twin of cv_to_var's W-CONST
        // fallback (`op = T_PLUS;` — the shape behind the whole parser-binop/tc/tt cluster).
        let cvv2: i64 = cv_ctbl_find(cnames, cvals, n.text);
        if cvv2 >= 0 {
            let qci2: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: dst, b: cvv2, c: 0, d: 0, s: "" });
            return 0;
        } else {
        }
        let qp: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    } else {
    }
    if n.kind == P_K_CALL {
        let ccc: i64 = tc_last_colons(n.text);
        if ccc < 0 {
            // B-VEC: the memory intrinsics dispatch BEFORE the fid lookup (into the given dst).
            let vi2: i64 = cv_emit_vecintr(nodes, kids, dst, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            if vi2 >= 0 {
                return 0;
            } else {
            }
            let fid: i64 = cv_fid_find(fids, n.text);
            if fid >= 0 {
                let mut cargs: Vec<str> = Vec::new();
                let mut cai: i64 = 0;
                while cai < n.child_count {
                    let agid: i64 = kids.get(n.child_start + cai);
                    let aptid: i64 = cv_fn_param_typeid(sigs, n.text, cai);
                    let av2: i64 = cv_to_var_expected(nodes, kids, agid, aptid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                    let avs: str = cv_i64_str(av2);
                    let vld: str = "v";
                    let avv: str = vld.concat(avs);
                    let qav: i64 = cargs.push(avv);
                    cai = cai + 1;
                }
                let asp: str = " ";
                let argstr: str = asp.join(cargs);
                let mut cdst: i64 = dst;
                let isu: bool = dstty.bytes_eq("Unit");
                if isu {
                    cdst = 0 - 1;
                } else {
                }
                let qcl: i64 = stmts.push(CvStmt { kind: CVS_CALL, a: cdst, b: fid, c: 0, d: 0, s: argstr });
                return 0;
            } else {
            }
            // ST-1: a BARE payload enum variant `B(x)` into dst (X-ST1 fallback).
            let mut pveridx: i64 = 0 - 1;
            if drec >= 0 {
                let drp: TcRec = rdefs.get(drec);
                if drp.is_enum {
                    if tc_variant_index(rdefs, drec, n.text) >= 0 {
                        pveridx = drec;
                    } else {
                    }
                } else {
                }
            } else {
            }
            if pveridx < 0 {
                let pvcode: i64 = tc_enum_of_variant(rdefs, n.text);
                if pvcode >= TC_REC_BASE {
                    pveridx = pvcode - TC_REC_BASE;
                } else {
                }
            } else {
            }
            if pveridx >= 0 {
                let pvvidx: i64 = tc_variant_index(rdefs, pveridx, n.text);
                let pvq: i64 = cv_emit_enum_ctor(nodes, kids, dst, eid, pveridx, pvvidx, 0, dsz, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                return 0;
            } else {
            }
        } else {
        }
        let qpc: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    } else {
    }
    if n.kind == P_K_LIT_INT {
        let q1: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: dst, b: n.value, c: 0, d: 0, s: "" });
        return 0;
    } else {
    }
    if n.kind == P_K_LIT_BOOL {
        let q2: i64 = stmts.push(CvStmt { kind: CVS_AS_BOOL, a: dst, b: n.value, c: 0, d: 0, s: "" });
        return 0;
    } else {
    }
    if n.kind == P_K_BINARY {
        let isc2: bool = cv_op_is_cmp(n.value);
        let mut opty: str = dstty;
        if isc2 {
            opty = cv_binop_operand_ty(nodes, kids, n, env, rdefs, sigs, cnames, cvals);
        } else {
        }
        let lid: i64 = kids.get(n.child_start);
        let rid: i64 = kids.get(n.child_start + 1);
        let lv: i64 = cv_binop_mat(nodes, kids, lid, opty, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        let rv: i64 = cv_binop_mat(nodes, kids, rid, opty, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        let q3: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: dst, b: lv, c: n.value, d: rv, s: "" });
        return 0;
    } else {
    }
    if n.kind == P_K_TUPLE {
        let qtt: i64 = cv_emit_tuple(nodes, kids, dst, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        return 0;
    } else {
    }
    if n.kind == P_K_RECORD_CONSTRUCT {
        let qe1: i64 = cv_emit_rec(nodes, kids, dst, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        return 0;
    } else {
    }
    if n.kind == P_K_ARRAY {
        let qe2: i64 = cv_emit_array(nodes, kids, dst, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        return 0;
    } else {
    }
    if n.kind == P_K_LIT_STR {
        let qe3: i64 = cv_emit_string(dst, n.text, base, locals, stmts);
        return 0;
    } else {
    }
    if n.kind == P_K_METHOD {
        if n.child_count >= 1 {
            let mrid: i64 = kids.get(n.child_start);
            let mrn: PNode = nodes.get(mrid);
            if mrn.kind == P_K_PATH {
                let mcode: i64 = tc_code_of_name(mrn.text, rdefs);
                if mcode >= TC_REC_BASE {
                    let meridx: i64 = mcode - TC_REC_BASE;
                    let merec: TcRec = rdefs.get(meridx);
                    if merec.is_enum {
                        let mvidx: i64 = tc_variant_index(rdefs, meridx, n.text);
                        if mvidx >= 0 {
                            let qe4: i64 = cv_emit_enum_ctor(nodes, kids, dst, eid, meridx, mvidx, 1, dsz, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                            return 0;
                        } else {
                        }
                    } else {
                    }
                } else {
                }
                // W-STR-A: str intrinsics into dst (the dst was allocated by the caller).
                let sdi2: i64 = cv_emit_strintr(nodes, kids, dst, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                if sdi2 > 0 - 2 {
                    return 0;
                } else {
                }
                // W-STR-B: the desugar methods into dst.
                let sdd2: i64 = cv_emit_strdesugar(nodes, kids, dst, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                if sdd2 > 0 - 2 {
                    return 0;
                } else {
                }
                // ST-2: a DOT-METHOD into dst — Call({Type}__{method}, [recv, ...args])
                // with the call dst = the given dst (into-position, no trailing copy).
                // B-DISPATCH: the receiver may be a COLON path (one field hop) — cv_recv_rec +
                // cv_to_var materialization (the dst was allocated by the caller already).
                let m2col: i64 = tc_last_colons(mrn.text);
                let mut m2gate: bool = false;
                if m2col < 0 {
                    let m2bv: i64 = cv_env_var(env, mrn.text);
                    if m2bv >= 0 {
                        m2gate = true;
                    } else {
                    }
                } else {
                    m2gate = true;
                }
                let mrr: i64 = cv_recv_rec(env, rdefs, mrn.text);
                if m2gate {
                    if mrr >= 0 {
                        let mrec2: TcRec = rdefs.get(mrr);
                        let mtail: str = tc_seg_at(n.text, 0);
                        // SH-MONO MONO-7: pre-resolved generic-method call (flag 2^21) -> n.text.
                        let mpre7b: i64 = n.flags & 2097152;
                        let mut mmang: str = "";
                        if mpre7b > 0 {
                            mmang = n.text;
                        } else {
                            let msep: str = mrec2.name.concat("__");
                            mmang = msep.concat(mtail);
                        }
                        let mfid: i64 = cv_fid_find(fids, mmang);
                        if mfid >= 0 {
                            let mut mrv: i64 = 0 - 1;
                            if m2col < 0 {
                                mrv = cv_env_var(env, mrn.text);
                            } else {
                                mrv = cv_to_var(nodes, kids, mrid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                            }
                            let mut margs: Vec<str> = Vec::new();
                            let mlead: str = "v";
                            let mrv0: str = mlead.concat(cv_i64_str(mrv));
                            let qm0: i64 = margs.push(mrv0);
                            let mut mmi: i64 = 1;
                            while mmi < n.child_count {
                                let magid: i64 = kids.get(n.child_start + mmi);
                                let mav: i64 = cv_to_var(nodes, kids, magid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                                let mavv: str = mlead.concat(cv_i64_str(mav));
                                let qma: i64 = margs.push(mavv);
                                mmi = mmi + 1;
                            }
                            let msp: str = " ";
                            let margstr: str = msp.join(margs);
                            let qmcl: i64 = stmts.push(CvStmt { kind: CVS_CALL, a: dst, b: mfid, c: 0, d: 0, s: margstr });
                            return 0;
                        } else {
                        }
                    } else {
                    }
                } else {
                }
            } else {
            }
        } else {
        }
        let qpm: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    } else {
    }
    if n.kind == P_K_INDEX {
        let xrid: i64 = kids.get(n.child_start);
        let xrn: PNode = nodes.get(xrid);
        let mut xok: bool = false;
        let mut arrv: i64 = 0 - 1;
        let mut etok: str = "";
        if xrn.kind == P_K_PATH {
            arrv = cv_env_var(env, xrn.text);
            etok = cv_env_elem(env, xrn.text);
            if arrv >= 0 {
                if etok.len() > 0 {
                    xok = true;
                } else {
                }
            } else {
            }
        } else {
        }
        if xok {
            let xiid: i64 = kids.get(n.child_start + 1);
            let xin: PNode = nodes.get(xiid);
            let xiv: i64 = cv_to_var(nodes, kids, xiid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            if xin.kind == P_K_LIT_INT {
            } else {
                // RF-M2: a covered range-for loop var elides the chain too (rf_index_elided).
                let xre: bool = rf_index_elided(nodes, kids, eid);
                if xre {
                } else {
                    let qch: i64 = cv_index_check(nodes, kids, xiid, xiv, arrv, base, env, rdefs, sigs, cnames, cvals, locals, stmts);
                }
            }
            let xw: i64 = cv_ty_width(etok);
            let qld: i64 = stmts.push(CvStmt { kind: CVS_LD_ELEM, a: dst, b: arrv, c: xiv, d: xw, s: etok });
            return 0;
        } else {
        }
        let qpx: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    } else {
    }
    let qz: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
    return 0;
}

// Serialize ONE CvStmt to its render token (the harness cv_render_stmt mirror). Built by pushing
// pieces into a Vec and joining (the selfhost bind-first idiom; join not concat — X9).
fn cv_ser_stmt(st: CvStmt) -> str ! { Alloc } {
    let mut ps: Vec<str> = Vec::new();
    if st.kind == CVS_AS_INT {
        let ia: str = cv_i64_str(st.a);
        let ib: str = cv_i64_str(st.b);
        let q0: i64 = ps.push("As v");
        let q1: i64 = ps.push(ia);
        let q2: i64 = ps.push("=Int(");
        let q3: i64 = ps.push(ib);
        let q4: i64 = ps.push(")");
    } else {
        if st.kind == CVS_AS_BOOL {
            let ba: str = cv_i64_str(st.a);
            let q5: i64 = ps.push("As v");
            let q6: i64 = ps.push(ba);
            if st.b == 1 {
                let q7: i64 = ps.push("=Bool(true)");
            } else {
                let q8: i64 = ps.push("=Bool(false)");
            }
        } else {
            if st.kind == CVS_AS_VAR {
                let ca: str = cv_i64_str(st.a);
                let cb: str = cv_i64_str(st.b);
                let q9: i64 = ps.push("As v");
                let q10: i64 = ps.push(ca);
                let q11: i64 = ps.push("=Var(v");
                let q12: i64 = ps.push(cb);
                let q13: i64 = ps.push(")");
            } else {
                if st.kind == CVS_AS_BIN {
                    let da: str = cv_i64_str(st.a);
                    let db: str = cv_i64_str(st.b);
                    let dop: str = cv_op_tok(st.c);
                    let dd: str = cv_i64_str(st.d);
                    let q14: i64 = ps.push("As v");
                    let q15: i64 = ps.push(da);
                    let q16: i64 = ps.push("=Bin(v");
                    let q17: i64 = ps.push(db);
                    let q18: i64 = ps.push(" ");
                    let q19: i64 = ps.push(dop);
                    let q20: i64 = ps.push(" v");
                    let q21: i64 = ps.push(dd);
                    let q22: i64 = ps.push(")");
                } else {
                    if st.kind == CVS_TRAP {
                        let ta1: str = cv_i64_str(st.a);
                        let q30: i64 = ps.push("Trap v");
                        let q31: i64 = ps.push(ta1);
                    } else {
                        if st.kind == CVS_LF_LEN {
                            let fa: str = cv_i64_str(st.a);
                            let fb: str = cv_i64_str(st.b);
                            let q32: i64 = ps.push("LF v");
                            let q33: i64 = ps.push(fa);
                            let q34: i64 = ps.push("<-v");
                            let q35: i64 = ps.push(fb);
                            let q36: i64 = ps.push("@0:U32");
                        } else {
                            if st.kind == CVS_LD_ELEM {
                                let ea: str = cv_i64_str(st.a);
                                let eb: str = cv_i64_str(st.b);
                                let ec: str = cv_i64_str(st.c);
                                let ed: str = cv_i64_str(st.d);
                                let q37: i64 = ps.push("LD v");
                                let q38: i64 = ps.push(ea);
                                let q39: i64 = ps.push("<-v");
                                let q40: i64 = ps.push(eb);
                                let q41: i64 = ps.push("[v");
                                let q42: i64 = ps.push(ec);
                                let q43: i64 = ps.push("]*");
                                let q44: i64 = ps.push(ed);
                                let q45: i64 = ps.push("+4:");
                                let q46: i64 = ps.push(st.s);
                            } else {
                                if st.kind == CVS_LF2 {
                                    let ga: str = cv_i64_str(st.a);
                                    let gb: str = cv_i64_str(st.b);
                                    let gc: str = cv_i64_str(st.c);
                                    let q50: i64 = ps.push("LF v");
                                    let q51: i64 = ps.push(ga);
                                    let q52: i64 = ps.push("<-v");
                                    let q53: i64 = ps.push(gb);
                                    let q54: i64 = ps.push("@");
                                    let q55: i64 = ps.push(gc);
                                    let q56: i64 = ps.push(":");
                                    let q57: i64 = ps.push(st.s);
                                } else {
                                    if st.kind == CVS_SF {
                                        let ha: str = cv_i64_str(st.a);
                                        let hb: str = cv_i64_str(st.b);
                                        let hc: str = cv_i64_str(st.c);
                                        let q58: i64 = ps.push("SF v");
                                        let q59: i64 = ps.push(ha);
                                        let q60: i64 = ps.push("@");
                                        let q61: i64 = ps.push(hc);
                                        let q62: i64 = ps.push("<-v");
                                        let q63: i64 = ps.push(hb);
                                        let q64: i64 = ps.push(":");
                                        let q65: i64 = ps.push(st.s);
                                    } else {
                                        if st.kind == CVS_CALL {
                                            let cb: str = cv_i64_str(st.b);
                                            if st.a >= 0 {
                                                let ca: str = cv_i64_str(st.a);
                                                let q66: i64 = ps.push("Call v");
                                                let q67: i64 = ps.push(ca);
                                                let q68: i64 = ps.push("=f");
                                                let q69: i64 = ps.push(cb);
                                            } else {
                                                let q70: i64 = ps.push("Call f");
                                                let q71: i64 = ps.push(cb);
                                            }
                                            let q72: i64 = ps.push("(");
                                            let q73: i64 = ps.push(st.s);
                                            let q74: i64 = ps.push(")");
                                        } else {
                                            if st.kind == CVS_BA {
                                                let ja: str = cv_i64_str(st.a);
                                                let jb: str = cv_i64_str(st.b);
                                                let jc: str = cv_i64_str(st.c);
                                                let q75: i64 = ps.push("BA v");
                                                let q76: i64 = ps.push(ja);
                                                let q77: i64 = ps.push(" ");
                                                let q78: i64 = ps.push(jb);
                                                let q79: i64 = ps.push("/");
                                                let q80: i64 = ps.push(jc);
                                            } else {
                                                if st.kind == CVS_AS_STR {
                                                    let ka: str = cv_i64_str(st.a);
                                                    let q81: i64 = ps.push("As v");
                                                    let q82: i64 = ps.push(ka);
                                                    let q83: i64 = ps.push("=Str(");
                                                    let q84: i64 = ps.push(st.s);
                                                    let q85: i64 = ps.push(")");
                                                } else {
                                                    if st.kind == CVS_AS_REC {
                                                        let la: str = cv_i64_str(st.a);
                                                        let q86: i64 = ps.push("As v");
                                                        let q87: i64 = ps.push(la);
                                                        let q88: i64 = ps.push("=Rec(");
                                                        let q89: i64 = ps.push(st.s);
                                                        let q90: i64 = ps.push(")");
                                                    } else {
                                                        if st.kind == CVS_SD {
                                                            let ma: str = cv_i64_str(st.a);
                                                            let mb: str = cv_i64_str(st.b);
                                                            let mc: str = cv_i64_str(st.c);
                                                            let md: str = cv_i64_str(st.d);
                                                            let q91: i64 = ps.push("SD v");
                                                            let q92: i64 = ps.push(ma);
                                                            let q93: i64 = ps.push("[v");
                                                            let q94: i64 = ps.push(mc);
                                                            let q95: i64 = ps.push("]*");
                                                            let q96: i64 = ps.push(md);
                                                            let q97: i64 = ps.push("+4<-v");
                                                            let q98: i64 = ps.push(mb);
                                                            let q99: i64 = ps.push(":");
                                                            let q100: i64 = ps.push(st.s);
                                                        } else {
                                                            if st.kind == CVS_WRAP {
                                                                let na2: str = cv_i64_str(st.a);
                                                                let nb2: str = cv_i64_str(st.b);
                                                                let q101: i64 = ps.push("Wrap v");
                                                                let q102: i64 = ps.push(na2);
                                                                let q103: i64 = ps.push("<-v");
                                                                let q104: i64 = ps.push(nb2);
                                                            } else {
                                                                if st.kind == CVS_FUEL {
                                                                    let oa2: str = cv_i64_str(st.a);
                                                                    let q105: i64 = ps.push("Fuel ");
                                                                    let q106: i64 = ps.push(oa2);
                                                                } else {
                                                                    let q23: i64 = ps.push("!");
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    let glue: str = "";
    return glue.join(ps);
}

// SH-AIR-CV-2: does this MATCH guarantee a return — all arm bodies diverge (the typechecker's
// exhaustive+all-arms rule, statements.rs:2492; a type-clean all-arms-returning match is
// necessarily exhaustive, so the parse-level check is all-arms).
fn cv_match_arms_diverge(nodes: Arena<PNode>, kids: Vec<i64>, mid: i64) -> bool {
    let mn: PNode = nodes.get(mid);
    let na: i64 = mn.child_count;
    if na > 1 {
    } else {
        return false;
    }
    let mut j: i64 = 1;
    while j < na {
        let aid: i64 = kids.get(mn.child_start + j);
        let an: PNode = nodes.get(aid);
        let abid: i64 = kids.get(an.child_start + an.child_count - 1);
        let ad: bool = cv_block_diverges(nodes, kids, abid);
        if ad {
        } else {
            return false;
        }
        j = j + 1;
    }
    return true;
}

// SH-AIR-CV-2: does this stmt list GUARANTEE a return — the mirror of the typechecker's
// `guaranteed_return` (statements.rs:486-889): a `return` (744) / a `trap();` (the Never
// expr-stmt, 685) / an `if` whose BOTH branches guarantee (1969) / a match whose arms all
// guarantee (2492). While/for-in/break/continue never guarantee. The typed AST DROPS every stmt
// after the first guaranteed one (the check_block break, 886) — the walker mirrors that
// truncation, which is what elides the merge block on a both-branches-return if.
fn cv_block_diverges(nodes: Arena<PNode>, kids: Vec<i64>, bnid: i64) -> bool {
    let bn: PNode = nodes.get(bnid);
    let n: i64 = bn.child_count;
    let mut i: i64 = 0;
    while i < n {
        let sid: i64 = kids.get(bn.child_start + i);
        let sn: PNode = nodes.get(sid);
        if sn.kind == P_K_RETURN {
            return true;
        } else {
        }
        if sn.kind == P_K_EXPR_STMT {
            if sn.child_count > 0 {
                let xid: i64 = kids.get(sn.child_start);
                let xn: PNode = nodes.get(xid);
                if xn.kind == P_K_CALL {
                    let it: bool = xn.text.bytes_eq("trap");
                    if it {
                        return true;
                    } else {
                    }
                } else {
                }
            } else {
            }
        } else {
        }
        if sn.kind == P_K_IF {
            if sn.child_count == 3 {
                let tb: i64 = kids.get(sn.child_start + 1);
                let eb: i64 = kids.get(sn.child_start + 2);
                let td: bool = cv_block_diverges(nodes, kids, tb);
                if td {
                    let ed: bool = cv_block_diverges(nodes, kids, eb);
                    if ed {
                        return true;
                    } else {
                    }
                } else {
                }
            } else {
            }
        } else {
        }
        if sn.kind == P_K_MATCH {
            let md: bool = cv_match_arms_diverge(nodes, kids, sid);
            if md {
                return true;
            } else {
            }
        } else {
        }
        i = i + 1;
    }
    return false;
}

// SH-AIR-CV-2: the recursive block walker — the mirror of `lower_statements` (air.rs:1420-1755).
// Walks ONE stmt list (`bnid` = a P_K_BLOCK) emitting into `cur0`, flushing blocks (in emission
// order) at every terminator point, and recursing into branch/loop/arm bodies with a CLONED env
// (the oracle's `env.clone()` — branch bindings never leak). `cont` = the continuation block
// (-1 = None: the epilogue is `Ret`); `brk`/`cnt` = the innermost loop's break/continue targets
// (-1 outside a loop — a stray break renders `Jmp b-1`, unmatchable → loud); `inc` = the for-in
// idx var for continue's inline increment (-1 for while). X6 for blocks: then/else/merge (and the
// while/for trios) are freshed BEFORE their bodies are lowered.
// W-TUPLE: parse a tuple ret-detail mangle (`$tupleN__a_b_...`) to the `;`-joined AirType
// token list ("I64;I64"). An unknown atom yields "" (the caller poisons LOUD).
fn cv_tuptys_of_mangle(detail: str) -> str ! { Alloc } {
    let pfx: bool = tc_str_starts(detail, "$tuple");
    if pfx {
    } else {
        return "";
    }
    let dl: i64 = detail.len();
    // find the `__` separator after the count digits.
    let mut sep: i64 = 0 - 1;
    let mut si: i64 = 6;
    while si + 1 < dl {
        if detail.byte_at(si) == 95 {
            if detail.byte_at(si + 1) == 95 {
                sep = si;
                si = dl;
            } else {
                si = si + 1;
            }
        } else {
            si = si + 1;
        }
    }
    if sep < 0 {
        return "";
    } else {
    }
    let atoms: str = detail.substr(sep + 2, dl);
    // split on `$` (the injective-mangle separator: $tupleN__e0$e1$...), map each atom.
    let mut toks: Vec<str> = Vec::new();
    let al: i64 = atoms.len();
    let mut a0: i64 = 0;
    let mut ai: i64 = 0;
    while ai <= al {
        let mut cut: bool = false;
        if ai == al {
            cut = true;
        } else {
            if atoms.byte_at(ai) == 36 {
                cut = true;
            } else {
            }
        }
        if cut {
            let atom: str = atoms.substr(a0, ai);
            let mut tok: str = "";
            if atom.bytes_eq("i64") {
                tok = "I64";
            } else {
            }
            if atom.bytes_eq("u64") {
                tok = "U64";
            } else {
            }
            if atom.bytes_eq("u32") {
                tok = "U32";
            } else {
            }
            if atom.bytes_eq("i32") {
                tok = "I32";
            } else {
            }
            if atom.bytes_eq("bool") {
                tok = "Bool";
            } else {
            }
            if atom.bytes_eq("str") {
                tok = "Ptr";
            } else {
            }
            if tok.len() > 0 {
                let qt: i64 = toks.push(tok);
            } else {
                return "";
            }
            a0 = ai + 1;
        } else {
        }
        ai = ai + 1;
    }
    let semi: str = ";";
    return semi.join(toks);
}

// W-TUPELEM: parse the SAME tuple ret-detail mangle to the `;`-joined per-element str
// PROVENANCE sentinels — `$str` for a str atom, `-` (a non-empty positional placeholder,
// never stored) for the other known scalars, "" whole-result on any unknown atom (the
// caller's token gate poisons that shape LOUD already). Deliberately NOT a Ptr-token lens:
// Ptr goes ambiguous the day the atom map learns records, and a record mis-tagged $str
// would route a `len`-named method into the strintr arm — silent wrong bytes. The atom set
// MUST stay in lockstep with cv_tuptys_of_mangle; a desync degrades to a missing sentinel
// (loud poison), never a mis-tag.
fn cv_tupelems_of_mangle(detail: str) -> str ! { Alloc } {
    let pfx: bool = tc_str_starts(detail, "$tuple");
    if pfx {
    } else {
        return "";
    }
    let dl: i64 = detail.len();
    let mut sep: i64 = 0 - 1;
    let mut si: i64 = 6;
    while si + 1 < dl {
        if detail.byte_at(si) == 95 {
            if detail.byte_at(si + 1) == 95 {
                sep = si;
                si = dl;
            } else {
                si = si + 1;
            }
        } else {
            si = si + 1;
        }
    }
    if sep < 0 {
        return "";
    } else {
    }
    let atoms: str = detail.substr(sep + 2, dl);
    let mut toks: Vec<str> = Vec::new();
    let al: i64 = atoms.len();
    let mut a0: i64 = 0;
    let mut ai: i64 = 0;
    while ai <= al {
        let mut cut: bool = false;
        if ai == al {
            cut = true;
        } else {
            if atoms.byte_at(ai) == 36 {
                cut = true;
            } else {
            }
        }
        if cut {
            let atom: str = atoms.substr(a0, ai);
            let mut tok: str = "";
            if atom.bytes_eq("str") {
                tok = "$str";
            } else {
            }
            if atom.bytes_eq("i64") {
                tok = "-";
            } else {
            }
            if atom.bytes_eq("u64") {
                tok = "-";
            } else {
            }
            if atom.bytes_eq("u32") {
                tok = "-";
            } else {
            }
            if atom.bytes_eq("i32") {
                tok = "-";
            } else {
            }
            if atom.bytes_eq("bool") {
                tok = "-";
            } else {
            }
            if tok.len() > 0 {
                let qt: i64 = toks.push(tok);
            } else {
                return "";
            }
            a0 = ai + 1;
        } else {
        }
        ai = ai + 1;
    }
    let semi: str = ";";
    return semi.join(toks);
}

fn cv_walk_stmts(nodes: Arena<PNode>, kids: Vec<i64>, bnid: i64, cur0: i64, cont: i64, brk: i64, cnt: i64, inc: i64, fnid: i64, base: i64, env0: Vec<CvBind>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut, blocks: Vec<CvBlock> @Mut, bctr: Vec<i64> @Mut, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, amult: i64, bmults: Vec<i64> @Mut) -> i64 ! { Alloc } {
    let mut env: Vec<CvBind> = cv_env_clone(env0);
    let bn: PNode = nodes.get(bnid);
    let n: i64 = bn.child_count;
    let mut cur: i64 = cur0;
    let mut mark: i64 = stmts.len();
    let mut i: i64 = 0;
    while i < n {
        let sid: i64 = kids.get(bn.child_start + i);
        let sn: PNode = nodes.get(sid);
        let k: i64 = sn.kind;
        if k == P_K_LET {
            if sn.child_count == 2 {
                let ltid: i64 = kids.get(sn.child_start);
                let ltok: str = ai_airtype_of_typenode(nodes, kids, ltid, rdefs);
                let lvid: i64 = kids.get(sn.child_start + 1);
                let lvn: PNode = nodes.get(lvid);
                let mut ld: i64 = 0;
                let erec0: i64 = cv_rec_of_typenode(nodes, kids, ltid, rdefs);
                let mut lesz: i64 = 0;
                if erec0 >= 0 {
                    let er0: TcRec = rdefs.get(erec0);
                    if er0.is_enum {
                        if er0.tpnames.len() == 0 {
                            lesz = cv_enum_total_size(rdefs, erec0);
                        } else {
                            lesz = cv_enum_inst_size(nodes, kids, rdefs, erec0, ltid);
                        }
                    } else {
                    }
                } else {
                }
                if lvn.kind == P_K_TUPLE {
                    // CAP-MATCH re-pin (supersedes the ST-3 note): the oracle BINDS the
                    // let name to the construct var directly (a rename, NO copy); the
                    // temp+copy the ST-3 corpus pinned belongs to the DESTRUCTURE
                    // (`let (x, y) = q` materializes q via a copy temp — see the
                    // path-RHS arm). Render-proven on both shapes: `let pair = (a,b);
                    // Some(pair)` has NO copy; `let q = (a,b); let (x,y) = q` has one.
                    ld = cv_to_var(nodes, kids, lvid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                } else {
                    ld = cv_fresh(ltok, base, locals);
                    // AG6-6: resolve the annotation's generic-enum INSTANCE size BEFORE lowering
                    // the RHS, so a unit-variant construct (`let e: E<i64> = E::N;`) allocates the
                    // instance cell, not the un-substituted def cell. 0 for every non-enum and
                    // every unresolvable annotation — those keep the def size byte-for-byte.
                    let ql: i64 = cv_into(nodes, kids, ld, lvid, base, env, rdefs, sigs, fids, cnames, cvals, ltok, erec0, lesz, locals, stmts);
                }
                let lrec: i64 = cv_rec_of_typenode(nodes, kids, ltid, rdefs);
                let lelem: str = cv_elem_of_typenode(nodes, kids, ltid, rdefs);
                let ltup: str = cv_tuptys_of_typenode(nodes, kids, ltid, rdefs);
                let qb: i64 = env.push(CvBind { name: sn.text, var: ld, ty: ltok, rec: lrec, elem: lelem, tuptys: ltup, esize: lesz });
            } else {
                // B-LET: an UNANNOTATED let — the local types from the VALUE (cv_expr_tytok,
                // intrinsic-aware). An underivable type ("?") POISONS loud. The env binding
                // carries no rec/elem/tuptys (a record-typed use through it poisons at the
                // USE site — fail-closed, never wrong bytes).
                if sn.child_count == 1 {
                    let uvid: i64 = kids.get(sn.child_start);
                    let utok: str = cv_expr_tytok(nodes, kids, uvid, env, rdefs, sigs, cnames, cvals);
                    let uunk: bool = utok.bytes_eq("?");
                    if uunk {
                        let qp0: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                    } else {
                        let ud: i64 = cv_fresh(utok, base, locals);
                        let qu: i64 = cv_into(nodes, kids, ud, uvid, base, env, rdefs, sigs, fids, cnames, cvals, utok, 0 - 1, 0, locals, stmts);
                        let qub: i64 = env.push(CvBind { name: sn.text, var: ud, ty: utok, rec: 0 - 1, elem: "", tuptys: "", esize: 0 });
                    }
                } else {
                    let qp1: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                }
            }
            i = i + 1;
        } else {
            if k == P_K_LET_TUPLE {
                // ST-3: `let (x, y) = t` — the RHS (last child) is a tuple LOCAL;
                // destructure to per-element LoadFields at accumulated offsets. The
                // element types come from an explicit (T1,T2) annotation (child0) or
                // the local's tuptys. A non-local RHS / non-tuple falls to POISON.
                let ltrhs: i64 = kids.get(sn.child_start + sn.child_count - 1);
                let ltrn: PNode = nodes.get(ltrhs);
                let mut ltdone: bool = false;
                // W-TUPLE: a CALL RHS (`let (x, y) = f(...)` — the parser's dominant shape):
                // the call materializes via cv_to_var (dst-first, the pair ptr), the element
                // tokens derive from the callee sig's ret_detail ($tupleN__a_b_...); an
                // unresolvable sig/mangle falls through to POISON.
                if ltrn.kind == P_K_CALL {
                    let ltcc: i64 = tc_last_colons(ltrn.text);
                    if ltcc < 0 {
                        let ltsi: i64 = tc_sig_find(sigs, ltrn.text);
                        if ltsi >= 0 {
                            let ltsg: TcSig = sigs.get(ltsi);
                            let cttys: str = cv_tuptys_of_mangle(ltsg.ret_detail);
                            if cttys.len() > 0 {
                                let celems: str = cv_tupelems_of_mangle(ltsg.ret_detail);
                                let ctvar: i64 = cv_to_var(nodes, kids, ltrhs, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                                let mut cboff: i64 = 0;
                                let mut cbi: i64 = 0;
                                let mut cgo: bool = true;
                                while cgo {
                                    let cbname: str = tc_seg_at(sn.text, cbi);
                                    if cbname.len() == 0 {
                                        cgo = false;
                                    } else {
                                        let cetok: str = tc_seg_at(cttys, cbi);
                                        let cel0: str = tc_seg_at(celems, cbi);
                                        let mut celem: str = "";
                                        if cel0.bytes_eq("$str") {
                                            celem = "$str";
                                        } else {
                                        }
                                        let cxd: i64 = cv_fresh(cetok, base, locals);
                                        let cqlf: i64 = stmts.push(CvStmt { kind: CVS_LF2, a: cxd, b: ctvar, c: cboff, d: 0, s: cetok });
                                        let cqbx: i64 = env.push(CvBind { name: cbname, var: cxd, ty: cetok, rec: 0 - 1, elem: celem, tuptys: "", esize: 0 });
                                        cboff = cboff + cv_ty_width(cetok);
                                        cbi = cbi + 1;
                                    }
                                }
                                ltdone = true;
                            } else {
                            }
                        } else {
                        }
                    } else {
                    }
                } else {
                }
                if ltdone {
                } else {
                if ltrn.kind == P_K_PATH {
                    let tlc: i64 = tc_last_colons(ltrn.text);
                    if tlc < 0 {
                        let tvar: i64 = cv_env_var(env, ltrn.text);
                        if tvar >= 0 {
                            let mut ttys: str = "";
                            if sn.child_count >= 2 {
                                let ltyid: i64 = kids.get(sn.child_start);
                                ttys = cv_tuptys_of_typenode(nodes, kids, ltyid, rdefs);
                            } else {
                            }
                            if ttys.len() > 0 {
                            } else {
                                ttys = cv_env_tuptys(env, ltrn.text);
                            }
                            if ttys.len() > 0 {
