// Self-hosted AIR lowering and WebAssembly emission. The differential harness strips
// this module header when composing the compiler tool.
module air;

// The cv_* path is the sole lowering implementation. It mirrors the Rust AIR, memory,
// fuel, and Wasm stages with operand-exact differential coverage. Unsupported forms
// emit poison rather than plausible output; `ai_encode_wasm` is the production entry.

// The AirType token of a TYPE node (mirrors `lower_type`). `typeid < 0` (an absent return
// annotation) is Unit. A recognized scalar -> its token; a recognized composite (Str /
// Named-record / Array / Ref / Slice / Tuple) -> "Ptr". An unsupported type emits the
// "<skip>" sentinel, which the exact lowering path converts to poison.
fn ai_airtype_of_typenode(nodes: Arena<PNode>, kids: Vec<i64>, typeid: i64, rdefs: Vec<TcRec>) -> str {
    if typeid < 0 {
        return "Unit";
    } else {
    }
    let topcode: i64 = tc_type_topcode(nodes, kids, typeid, rdefs);
    if topcode == TC_T_UNIT {
        return "Unit";
    } else {
    }
    if topcode == TC_T_BOOL {
        return "Bool";
    } else {
    }
    if topcode == TC_T_I32 {
        return "I32";
    } else {
    }
    if topcode == TC_T_U32 {
        return "U32";
    } else {
    }
    if topcode == TC_T_I64 {
        return "I64";
    } else {
    }
    if topcode == TC_T_U64 {
        return "U64";
    } else {
    }
    if topcode == TC_T_F64 {
        return "F64";
    } else {
    }
    if topcode == TC_T_STR {
        return "Ptr";
    } else {
    }
    if topcode == TC_T_ARRAY {
        return "Ptr";
    } else {
    }
    if topcode == TC_T_REF {
        return "Ptr";
    } else {
    }
    if topcode == TC_T_SLICE {
        return "Ptr";
    } else {
    }
    if topcode == TC_T_TUPLE {
        return "Ptr";
    } else {
    }
    if topcode >= TC_REC_BASE {
        return "Ptr";
    } else {
    }
    // CAP-MATCH: a GENERIC-ENUM instance annotation (`Option<i64>`) is a heap POINTER —
    // the oracle types it Ptr (its render label). Before this, the fall-through "<skip>"
    // poisoned any CALL that wrote an Option-typed let dst in the W lane (a param could
    // carry "<skip>"; a call dst cannot). Concrete enums already resolve via TC_REC_BASE.
    let tnn: PNode = nodes.get(typeid);
    if tnn.child_count >= 1 {
        let nre2: i64 = rdefs.len();
        let mut rei2: i64 = 0;
        while rei2 < nre2 {
            let rcand2: TcRec = rdefs.get(rei2);
            let rne2: bool = rcand2.name.bytes_eq(tnn.text);
            if rne2 {
                if rcand2.vnames.len() > 0 {
                    if rcand2.tpnames.len() > 0 {
                        return "Ptr";
                    } else {
                    }
                } else {
                }
                rei2 = nre2;
            } else {
                rei2 = rei2 + 1;
            }
        }
    } else {
    }
    // SHP-5c-3: `Slot<C>` of a declared cap type is a heap pointer, the oracle's
    // `lower_type(Named("Slot", [Cap]))`.
    if tnn.kind == P_K_TYPE {
        if tnn.flags == 0 {
            if tnn.child_count == 1 {
                if tnn.text.bytes_eq("Slot") {
                    let sctn: PNode = nodes.get(kids.get(tnn.child_start));
                    let scname: str = tc_seg_at(sctn.text, 0);
                    let scdecl: str = ai_cap_decl_text(nodes, scname);
                    if scdecl.len() > 0 {
                        return "Ptr";
                    }
                }
            }
        }
    }
    // SHP-0b: a region handle is an i64 token, the oracle's `lower_type(Type::Region)`. Left to
    // the "<skip>" fallback it became an i32 parameter, a different signature.
    if tnn.kind == P_K_TYPE {
        if tnn.child_count == 0 {
            if tnn.text.bytes_eq("Region") {
                return "I64";
            }
            // SHP-5b: a capability type — plain (`Fuel`) or a parametric usage, whose text
            // is `Approval;2030` (the parser appends the deadline literals) — is a
            // pointer-width handle, the oracle's `lower_type(Type::Cap)`. The decl is found
            // by an arena scan, paid only on this fallback, which a poison-free compile
            // does not reach (every annotation of the certified source resolves above).
            let capname: str = tc_seg_at(tnn.text, 0);
            let capdecl: str = ai_cap_decl_text(nodes, capname);
            if capdecl.len() > 0 {
                return "Ptr";
            }
        }
    }
    return "<skip>";
}

// SHP-5b: the `name;auths;params` text of the `cap type` decl named `name`, "" when the
// program declares none. An arena scan: the lowering holds no module root, and a program
// with cap decls is small (the self-compile has none).
fn ai_cap_decl_text(nodes: Arena<PNode>, name: str) -> str {
    let total: i64 = nodes.len();
    let mut i: i64 = 0;
    while i < total {
        let mn: PNode = nodes.get(i);
        if mn.kind == P_K_CAP_TYPE {
            if rf_seg0_eq(mn.text, name) {
                return mn.text;
            }
        }
        i = i + 1;
    }
    return "";
}

// True iff `t` is the SKIP sentinel emitted by ai_airtype_of_typenode.
fn ai_is_skip(t: str) -> bool {
    let s: str = "<skip>";
    return t.bytes_eq(s);
}

// SHP-0b: the program-level refusals (docs/specs/self-host-backend-parity.md, SR-029). The
// emitter resolves no type alias and cannot recover what the parser could not read, so a program
// that needs any of these is refused whole: an actor in an outer-ring module (SHP-2b: production's
// outer module carries only the fuel and alloc imports, so its messaging cannot be emitted there),
// a type alias (its uses would be lowered at a guessed width), a 256-bit integer type or literal, a call to a higher-kinded generic fn, or a
// P_K_ERR node (a construct the parser skipped, which the emitted module would silently omit). Only nodes REACHABLE from `root` count: the parser can
// leave orphan error nodes behind when it backtracks, and those are not part of the program.
// Fails closed: the first offending node names the refusal; "" means none.
fn ai_program_refusal(nodes: Arena<PNode>, kids: Vec<i64>, root: i64) -> str ! { Alloc } {
    let mut hkts: Vec<str> = Vec::new();
    let mut calls: Vec<str> = Vec::new();
    let mut work: Vec<i64> = Vec::new();
    let q0: i64 = work.push(root);
    let mut wi: i64 = 0;
    while wi < work.len() {
        let id: i64 = work.get(wi);
        let n: PNode = nodes.get(id);
        if n.kind == P_K_ERR {
            return "<parse-error>";
        }
        if n.kind == P_K_TYPE_ALIAS {
            return "<type-alias>";
        }
        // A generic fn with a higher-kinded type parameter (`<F: * -> *>`, kind code 2 and up)
        // is recorded here, and every call by name, so the CALLED ones are refused below. An
        // instance of one is a type the emitter cannot lower: its walk ran off the node arena
        // and trapped. An uncalled one emits nothing and stays byte-identical.
        if n.kind == P_K_FN {
            let mut fk: i64 = 0;
            while fk < n.child_count {
                let fkid: i64 = kids.get(n.child_start + fk);
                let fkn: PNode = nodes.get(fkid);
                if fkn.kind == P_K_TYPE_PARAM {
                    if fkn.flags >= 2 {
                        let hkn: str = tc_seg_at(n.text, 0);
                        let qhk: i64 = hkts.push(hkn);
                    }
                }
                fk = fk + 1;
            }
        }
        if n.kind == P_K_CALL {
            let qcl: i64 = calls.push(n.text);
        }
        // An integer literal above `i64::MAX` is a `u256` to the oracle, which builds its cell;
        // the lexer here wraps it to an i64. The emitter never sees the source text, so the
        // literal is read from its span: a decimal one has at least 19 digits, a hex one at least
        // 17 hex digits, or 16 with the top bit set (span 18, a wrapped negative value). Fails
        // closed: a long literal that fits (19 decimal digits up to `i64::MAX`, a folded
        // negative of 17 digits) is refused too.
        if n.kind == P_K_LIT_INT {
            let lspan: i64 = n.end - n.start;
            if lspan >= 19 {
                return "<wide-literal>";
            }
            if lspan == 18 {
                if n.value < 0 {
                    return "<wide-literal>";
                }
            }
        }
        // A 256-bit integer is a pointer to a 32-byte cell the emitter never builds: it lowers
        // a `u256` value as a scalar, so any program that names the type is refused.
        if n.kind == P_K_TYPE {
            if n.text.bytes_eq("u256") {
                return "<u256>";
            }
            if n.text.bytes_eq("i256") {
                return "<i256>";
            }
        }
        if n.kind == P_K_MODULE {
            let half: i64 = n.flags / 2;
            let outer: i64 = n.flags - half * 2;
            if outer == 1 {
                let mut oc: i64 = 0;
                while oc < n.child_count {
                    let ocid: i64 = kids.get(n.child_start + oc);
                    let ocn: PNode = nodes.get(ocid);
                    if ocn.kind == P_K_ACTOR {
                        return "<outer-ring-actor>";
                    }
                    oc = oc + 1;
                }
            }
        }
        let mut c: i64 = 0;
        while c < n.child_count {
            let cid: i64 = kids.get(n.child_start + c);
            let qc: i64 = work.push(cid);
            c = c + 1;
        }
        wi = wi + 1;
    }
    let mut hi: i64 = 0;
    while hi < hkts.len() {
        let hname: str = hkts.get(hi);
        let mut ci: i64 = 0;
        while ci < calls.len() {
            let cname: str = calls.get(ci);
            if cname.bytes_eq(hname) {
                return "<higher-kinded>";
            }
            ci = ci + 1;
        }
        hi = hi + 1;
    }
    return ai_extern_refusal(nodes, kids, root);
}

// SHP-2b: the extern calls whose resolution here differs from the oracle's, refused whole. The
// oracle registers each extern in its declaring module only, resolves a call in the caller's
// module, and makes it an FFI call only when it resolved to an extern (`universe.extern_fns`,
// keyed by qualified name, in type_check calls.rs). The sig table here is program-wide and keyed
// by bare name. The two agree on every call to an extern declared once, in the caller's module,
// under a name no fn shares, and on nothing else:
// - an extern name declared twice: the oracle types each call by its own module's declaration,
//   this compiler by the first;
// - an extern name that a fn also has: the oracle resolves each call to whichever of the two the
//   caller's module holds, and one sig per name cannot tell them apart;
// - a bare call to an extern declared only in another module: the oracle rejects it (T062), this
//   type check accepts it;
// - an extern named like an oracle intrinsic (ai_is_intrinsic_name): the oracle resolves the
//   intrinsic first, so it never calls such an extern, and this compiler would call it.
// Fails closed: "" only when no such shape occurs.
fn ai_extern_refusal(nodes: Arena<PNode>, kids: Vec<i64>, root: i64) -> str ! { Alloc } {
    let mut mods: Vec<i64> = Vec::new();
    let cm: i64 = ai_collect_modules(nodes, kids, root, mods);
    let mut xnames: Vec<str> = Vec::new();
    let mut xmods: Vec<i64> = Vec::new();
    let mut fnames: Vec<str> = Vec::new();
    let mut mi: i64 = 0;
    while mi < mods.len() {
        let mid: i64 = mods.get(mi);
        let mn: PNode = nodes.get(mid);
        let mut c: i64 = 0;
        while c < mn.child_count {
            let cid: i64 = kids.get(mn.child_start + c);
            let cn: PNode = nodes.get(cid);
            if cn.kind == P_K_EXTERN_FN {
                let xn: str = tc_seg_at(cn.text, 1);
                let seen: i64 = cv_fid_find(xnames, xn);
                if seen >= 0 {
                    return "<extern-declared-twice>";
                }
                let intr: bool = ai_is_intrinsic_name(xn);
                if intr {
                    return "<extern-named-like-an-intrinsic>";
                }
                let qx: i64 = xnames.push(xn);
                let qxm: i64 = xmods.push(mi);
            }
            if cn.kind == P_K_FN {
                let qf: i64 = fnames.push(tc_seg_at(cn.text, 0));
            }
            c = c + 1;
        }
        mi = mi + 1;
    }
    let mut xi: i64 = 0;
    while xi < xnames.len() {
        let shared: i64 = cv_fid_find(fnames, xnames.get(xi));
        if shared >= 0 {
            return "<extern-named-like-a-fn>";
        }
        xi = xi + 1;
    }
    let mut cmi: i64 = 0;
    while cmi < mods.len() {
        let mut work: Vec<i64> = Vec::new();
        let qw: i64 = work.push(mods.get(cmi));
        let mut wi: i64 = 0;
        while wi < work.len() {
            let wid: i64 = work.get(wi);
            let n: PNode = nodes.get(wid);
            if n.kind == P_K_CALL {
                let ncc: i64 = tc_last_colons(n.text);
                if ncc < 0 {
                    let xk: i64 = cv_fid_find(xnames, n.text);
                    if xk >= 0 {
                        if xmods.get(xk) != cmi {
                            return "<extern-of-another-module>";
                        }
                    }
                }
            }
            let mut k: i64 = 0;
            while k < n.child_count {
                let qk: i64 = work.push(kids.get(n.child_start + k));
                k = k + 1;
            }
            wi = wi + 1;
        }
        cmi = cmi + 1;
    }
    return "";
}

// Is `name` one of the oracle's intrinsics (resolve_intrinsic_call in type_check
// expressions/intrinsics.rs)? The oracle resolves these names before any fn or extern.
// `shp2_extern_named_like_an_intrinsic_is_refused` reads the oracle's list and holds this one to
// every name on it, so an intrinsic the oracle adds fails that test until it is added here.
fn ai_is_intrinsic_name(name: str) -> bool {
    let names: str = "alloc;load8;store8;slot_new;slot_put;slot_take;ct_eq;ct_select;ct_lt;vec_store;vec_load;str_from_raw;u256_from_i64;u256_make;u256_limb;trap_if;trap";
    let mut i: i64 = 0;
    let mut found: bool = false;
    let mut scanning: bool = true;
    while scanning {
        let cand: str = tc_seg_at(names, i);
        if cand.len() == 0 {
            scanning = false;
        } else {
            if cand.bytes_eq(name) {
                found = true;
                scanning = false;
            } else {
                i = i + 1;
            }
        }
    }
    return found;
}

// Module ids under `root`: a P_K_PROGRAM (83) wrapper's children, or the bare P_K_MODULE
// root (single-module). Clone of ec_collect_modules / nr_collect_modules.
fn ai_collect_modules(nodes: Arena<PNode>, kids: Vec<i64>, root: i64, out: Vec<i64> @Mut) -> i64 ! { Alloc } {
    let rn: PNode = nodes.get(root);
    if rn.kind == P_K_PROGRAM {
        let mut i: i64 = 0;
        while i < rn.child_count {
            let cid: i64 = kids.get(rn.child_start + i);
            let pushed: i64 = out.push(cid);
            i = i + 1;
        }
    } else {
        let pushed: i64 = out.push(root);
    }
    return 0;
}

// Is this P_K_FN a generic SOURCE fn (has a P_K_TYPE_PARAM child)? Such fns are SKIPPED
// (AG-AIR-5): the oracle lowers only MONOMORPHIZED instances, never the generic source —
// an uncalled generic produces zero AirFunctions. Clone of ec_is_generic_fn.
fn ai_is_generic_fn(nodes: Arena<PNode>, kids: Vec<i64>, fnid: i64) -> bool {
    let fnn: PNode = nodes.get(fnid);
    let mut i: i64 = 0;
    let mut found: bool = false;
    let mut scanning: bool = true;
    while scanning {
        if i >= fnn.child_count {
            scanning = false;
        } else {
            let cid: i64 = kids.get(fnn.child_start + i);
            let cn: PNode = nodes.get(cid);
            if cn.kind == P_K_TYPE_PARAM {
                found = true;
                scanning = false;
            } else {
                i = i + 1;
            }
        }
    }
    return found;
}

fn ai_method_name(impl_text: str, method_text: str) -> str ! { Alloc } {
    let type_name: str = tc_seg_at(impl_text, 1);
    let method: str = tc_seg_at(method_text, 0);
    let sep: str = type_name.concat("__");
    return sep.concat(method);
}


// A single decimal digit (0-9) as a str.
fn ai_digit_char(d: i64) -> str {
    if d == 0 {
        return "0";
    } else {
    }
    if d == 1 {
        return "1";
    } else {
    }
    if d == 2 {
        return "2";
    } else {
    }
    if d == 3 {
        return "3";
    } else {
    }
    if d == 4 {
        return "4";
    } else {
    }
    if d == 5 {
        return "5";
    } else {
    }
    if d == 6 {
        return "6";
    } else {
    }
    if d == 7 {
        return "7";
    } else {
    }
    if d == 8 {
        return "8";
    } else {
    }
    return "9";
}

// A non-negative i64 as decimal (SIGIL has no `%`, so lo = n - hi*10).
fn ai_int_to_str(n: i64) -> str ! { Alloc } {
    if n < 10 {
        return ai_digit_char(n);
    } else {
    }
    let hi: i64 = n / 10;
    let lo: i64 = n - hi * 10;
    let hs: str = ai_int_to_str(hi);
    let ls: str = ai_digit_char(lo);
    return hs.concat(ls);
}


// True iff node `inner`'s span lies within node `outer`'s span (subtree membership).
fn rf_contains(nodes: Arena<PNode>, outer: i64, inner: i64) -> bool {
    let outn: PNode = nodes.get(outer);
    let inn: PNode = nodes.get(inner);
    if outn.start <= inn.start {
        if inn.end <= outn.end {
            return true;
        } else {
        }
    } else {
    }
    return false;
}

// True iff `name` equals one of `text`'s `;`-separated segments with index >= fromseg.
// Binder texts are ASCII idents joined with `;`, so byte-indexed substr is safe.
fn rf_name_in_segs(text: str, name: str, fromseg: i64) -> bool {
    let tl: i64 = text.len();
    let mut seg: i64 = 0;
    let mut st: i64 = 0;
    let mut i: i64 = 0;
    while i <= tl {
        let mut isend: bool = false;
        if i == tl {
            isend = true;
        } else {
            let ch: str = text.substr(i, i + 1);
            if ch.bytes_eq(";") {
                isend = true;
            } else {
            }
        }
        if isend {
            if seg >= fromseg {
                let part: str = text.substr(st, i);
                if part.bytes_eq(name) {
                    return true;
                } else {
                }
            } else {
            }
            seg = seg + 1;
            st = i + 1;
        } else {
        }
        i = i + 1;
    }
    return false;
}

// RF-M4: is node `mid` a BINDER that (re)binds `name`? Mirrors the oracle's
// stmt_rebinds_name + pattern_binds_name (statements.rs:2889-2921): let /
// let-tuple / for-in / for-range vars, match binding/enum/array pattern names.
// P_K_CLOSURE is the CALLER's fail-closed refusal (see rf_body_refuses).
fn rf_binds_name(nodes: Arena<PNode>, mid: i64, name: str) -> bool {
    let n: PNode = nodes.get(mid);
    if n.kind == P_K_LET {
        return n.text.bytes_eq(name);
    } else {
    }
    if n.kind == P_K_FOR_IN {
        return n.text.bytes_eq(name);
    } else {
    }
    if n.kind == P_K_FOR_RANGE {
        return n.text.bytes_eq(name);
    } else {
    }
    if n.kind == P_K_PAT_BINDING {
        return n.text.bytes_eq(name);
    } else {
    }
    if n.kind == P_K_LET_TUPLE {
        return rf_name_in_segs(n.text, name, 0);
    } else {
    }
    if n.kind == P_K_PAT_ENUM {
        // text = `type;variant;binding1;…` — bindings start at segment 2.
        return rf_name_in_segs(n.text, name, 2);
    } else {
    }
    if n.kind == P_K_PAT_ARRAY {
        // text = `;`-joined element words (`_` for wildcards) + the rest name.
        return rf_name_in_segs(n.text, name, 0);
    } else {
    }
    return false;
}

// RF-M4: the shadow-proof body pre-scan — true iff the loop BODY (`bodyid`)
// REFUSES the bounds fact for `name`: any binder in its subtree rebinds it
// (this includes a nested same-name loop, refusing the OUTER loop's fact
// exactly like the oracle), OR the body contains a P_K_CLOSURE ANYWHERE
// (fail-closed: the oracle BARRIERS closures — the fact stays alive outside
// them — but no covered fixture contains one, so the shadow refuses the whole
// loop; a closure fixture fails loudly one-sided, never silently diverges).
fn rf_body_refuses(nodes: Arena<PNode>, bodyid: i64, name: str) -> bool {
    let total: i64 = nodes.len();
    let mut i: i64 = 0;
    while i < total {
        let within: bool = rf_contains(nodes, bodyid, i);
        if within {
            let mn: PNode = nodes.get(i);
            if mn.kind == P_K_CLOSURE {
                return true;
            } else {
            }
            let b: bool = rf_binds_name(nodes, i, name);
            if b {
                return true;
            } else {
            }
        } else {
        }
        i = i + 1;
    }
    return false;
}

// RF-M4: the innermost fn-LIKE node (free fn / impl method P_K_FN, actor
// init/handler) whose span contains node `eid`, or -1. If the innermost
// enclosure is a P_K_CLOSURE the answer is -1 (fail-closed: no elision inside
// a closure — the oracle empties the fact channel there).
fn rf_enclosing_fn(nodes: Arena<PNode>, eid: i64) -> i64 {
    let total: i64 = nodes.len();
    let mut best: i64 = 0 - 1;
    let mut bestw: i64 = 0;
    let mut i: i64 = 0;
    while i < total {
        let mn: PNode = nodes.get(i);
        let mut fnlike: bool = false;
        if mn.kind == P_K_FN {
            fnlike = true;
        } else {
        }
        if mn.kind == P_K_ACTOR_INIT {
            fnlike = true;
        } else {
        }
        if mn.kind == P_K_HANDLER {
            fnlike = true;
        } else {
        }
        if mn.kind == P_K_CLOSURE {
            fnlike = true;
        } else {
        }
        if fnlike {
            if i == eid {
            } else {
                let cont: bool = rf_contains(nodes, i, eid);
                if cont {
                    let w: i64 = mn.end - mn.start;
                    if best < 0 {
                        best = i;
                        bestw = w;
                    } else {
                        if w < bestw {
                            best = i;
                            bestw = w;
                        } else {
                        }
                    }
                } else {
                }
            }
        } else {
        }
        i = i + 1;
    }
    if best >= 0 {
        let bn: PNode = nodes.get(best);
        if bn.kind == P_K_CLOSURE {
            return 0 - 1;
        } else {
        }
    } else {
    }
    return best;
}

// True iff `text`'s segment 0 equals `name` (a P_K_PARAM's text is `name` or
// `name;region` when `@in r` is present).
fn rf_seg0_eq(text: str, name: str) -> bool {
    let s0: str = tc_seg_at(text, 0);
    return s0.bytes_eq(name);
}

// RF-M4: the STATIC size of the fixed-array DECLARATION of `name` inside fn
// `fnid` — a P_K_PARAM (text seg 0 == name) or an annotated P_K_LET (text ==
// name) whose type child (child 0) is a PLAIN P_K_TYPE_ARRAY (flags 0 — no
// ref/slice rider; its `value` IS the size, the same field tc_tmangle reads).
// EXACTLY ONE candidate or -1: a shadowed/ambiguous name fails closed (the
// AG-REG-SHADOW discipline, corpus-excluded). An UN-annotated array let never
// resolves here (child 0 is the value expr) — also fail-closed, and already
// out of every covered lane (the F5 annotation requirement).
fn rf_decl_array_size(nodes: Arena<PNode>, kids: Vec<i64>, fnid: i64, name: str) -> i64 {
    let total: i64 = nodes.len();
    let mut found: i64 = 0 - 1;
    let mut count: i64 = 0;
    let mut i: i64 = 0;
    while i < total {
        let within: bool = rf_contains(nodes, fnid, i);
        if within {
            let mn: PNode = nodes.get(i);
            let mut namehit: bool = false;
            if mn.kind == P_K_PARAM {
                namehit = rf_seg0_eq(mn.text, name);
            } else {
            }
            if mn.kind == P_K_LET {
                namehit = mn.text.bytes_eq(name);
            } else {
            }
            if namehit {
                if mn.child_count >= 1 {
                    let tid: i64 = kids.get(mn.child_start);
                    let tn: PNode = nodes.get(tid);
                    if tn.kind == P_K_TYPE_ARRAY {
                        if tn.flags == 0 {
                            found = tn.value;
                            count = count + 1;
                        } else {
                        }
                    } else {
                    }
                } else {
                }
            } else {
            }
        } else {
        }
        i = i + 1;
    }
    if count == 1 {
        return found;
    } else {
    }
    return 0 - 1;
}

// RF-M4 (UP-LENGTH): the covered `arr.len()` END form — a P_K_METHOD `len`
// with NO args (child_count == 1) whose receiver (child 0) is a bare-local
// P_K_PATH declared in the enclosing fn as a plain fixed array. Returns the
// STATIC size — the K the CHECKER substitutes as an i64 literal in the typed
// tree (statements.rs UP-LENGTH), so the oracle AIR mats a CONSTANT for the
// bound, never a len load — or -1 when the end is not this form (an uncovered
// len receiver fences the fn; it never mis-lowers).
fn rf_len_end_k(nodes: Arena<PNode>, kids: Vec<i64>, endid: i64) -> i64 {
    let en: PNode = nodes.get(endid);
    if en.kind == P_K_METHOD {
    } else {
        return 0 - 1;
    }
    let isl: bool = en.text.bytes_eq("len");
    if isl {
    } else {
        return 0 - 1;
    }
    if en.child_count == 1 {
    } else {
        return 0 - 1;
    }
    let rcvid: i64 = kids.get(en.child_start);
    let rn: PNode = nodes.get(rcvid);
    if rn.kind == P_K_PATH {
    } else {
        return 0 - 1;
    }
    let rq0: i64 = tc_last_colons(rn.text);
    let rq: bool = rq0 >= 0;
    if rq {
        return 0 - 1;
    } else {
    }
    let fnid: i64 = rf_enclosing_fn(nodes, endid);
    if fnid >= 0 {
    } else {
        return 0 - 1;
    }
    return rf_decl_array_size(nodes, kids, fnid, rn.text);
}

// RF-M2: the bounds fact for ONE range loop — its exclusive upper bound K, IFF
// every gate holds (statements.rs:975-1021): start is the surface literal `0`;
// the end resolves statically (an int literal, or the covered `arr.len()`);
// K >= 1 (an empty loop makes no claims); the body pre-scan finds NO rebinding
// of the var. Returns K, or -1 (no fact).
fn rf_fact_k(nodes: Arena<PNode>, kids: Vec<i64>, loopid: i64) -> i64 {
    let ln: PNode = nodes.get(loopid);
    if ln.kind == P_K_FOR_RANGE {
    } else {
        return 0 - 1;
    }
    let startid: i64 = kids.get(ln.child_start);
    let sn: PNode = nodes.get(startid);
    if sn.kind == P_K_LIT_INT {
    } else {
        return 0 - 1;
    }
    if sn.value == 0 {
    } else {
        return 0 - 1;
    }
    let endid: i64 = kids.get(ln.child_start + 1);
    let en: PNode = nodes.get(endid);
    let mut k: i64 = 0 - 1;
    if en.kind == P_K_LIT_INT {
        k = en.value;
    } else {
        k = rf_len_end_k(nodes, kids, endid);
    }
    if k >= 1 {
    } else {
        return 0 - 1;
    }
    let bodyid: i64 = kids.get(ln.child_start + 2);
    let refuses: bool = rf_body_refuses(nodes, bodyid, ln.text);
    if refuses {
        return 0 - 1;
    } else {
    }
    return k;
}

// RF-M2/M4: the RANGE elision predicate for `arr[v]` (the second
// `bounds_proven` setter, expressions.rs:2743): the index node's array AND
// index children are bare-local paths; the INNERMOST enclosing P_K_FOR_RANGE
// whose var == the index name carries a fact K; and K <= N, N = the indexed
// array's declared size ([0, K-1] ⊆ [0, N-1] with lo pinned 0 — no RF-M3
// interval tightening here). A straddle (K > N) keeps the runtime chain on
// both sides — never a claim.
fn rf_index_elided(nodes: Arena<PNode>, kids: Vec<i64>, ixid: i64) -> bool {
    let n: PNode = nodes.get(ixid);
    if n.kind == P_K_INDEX {
    } else {
        return false;
    }
    let arrid: i64 = kids.get(n.child_start);
    let an: PNode = nodes.get(arrid);
    if an.kind == P_K_PATH {
    } else {
        return false;
    }
    let aq0: i64 = tc_last_colons(an.text);
    let aq: bool = aq0 >= 0;
    if aq {
        return false;
    } else {
    }
    let idxid: i64 = kids.get(n.child_start + 1);
    let dn: PNode = nodes.get(idxid);
    if dn.kind == P_K_PATH {
    } else {
        return false;
    }
    let dq0: i64 = tc_last_colons(dn.text);
    let dq: bool = dq0 >= 0;
    if dq {
        return false;
    } else {
    }
    let fnid: i64 = rf_enclosing_fn(nodes, ixid);
    if fnid >= 0 {
    } else {
        return false;
    }
    let loopid: i64 = rf_innermost_loop(nodes, ixid, dn.text);
    if loopid < 0 {
        return false;
    }
    let k: i64 = rf_fact_k(nodes, kids, loopid);
    if k >= 1 {
    } else {
        return false;
    }
    let nsize: i64 = rf_decl_array_size(nodes, kids, fnid, an.text);
    if nsize >= 1 {
    } else {
        return false;
    }
    if k <= nsize {
        return true;
    } else {
    }
    return false;
}

// RF-M3 is production's: the type checker TIGHTENS a range-loop index's interval with the
// narrowing clauses of the guards around the access (`if i < 5 { .. a[i] .. }`, refinement.rs)
// and then elides the check, keeps it, rejects the access (T278) or makes no claim. This
// emitter carries no refinement channel, so an access whose loop variable a guard between the
// loop and the access NAMES is POISONED (SHP-5a; before it the taint shadow refused every
// range-for, so the shape never reached this emitter): production's bytes there follow the
// tightened interval and can differ in either direction. A guard that names only other
// variables cannot tighten the index — the oracle keeps only clauses on the index's own name
// — so it is left to `rf_index_elided`.
fn rf_mentions(nodes: Arena<PNode>, kids: Vec<i64>, nid: i64, name: str) -> bool {
    let n: PNode = nodes.get(nid);
    if n.kind == P_K_PATH {
        if n.text.bytes_eq(name) {
            return true;
        }
    }
    let mut i: i64 = 0;
    while i < n.child_count {
        let cid: i64 = kids.get(n.child_start + i);
        if rf_mentions(nodes, kids, cid, name) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// The innermost P_K_FOR_RANGE over `name` whose span contains `ixid` (max start = deepest;
// spans nest), or -1. An outer same-name loop can never sneak in: its own pre-scan refuses its
// fact when an inner loop rebinds the name — exactly the oracle's `.rev()` innermost-fact lookup.
// Shared by rf_index_elided and rf_index_guarded: one walk of the arena each.
fn rf_innermost_loop(nodes: Arena<PNode>, ixid: i64, name: str) -> i64 {
    let total: i64 = nodes.len();
    let mut loopid: i64 = 0 - 1;
    let mut loopstart: i64 = 0 - 1;
    let mut i: i64 = 0;
    while i < total {
        let mn: PNode = nodes.get(i);
        if mn.kind == P_K_FOR_RANGE {
            let namehit: bool = mn.text.bytes_eq(name);
            if namehit {
                let cont: bool = rf_contains(nodes, i, ixid);
                if cont {
                    if mn.start > loopstart {
                        loopid = i;
                        loopstart = mn.start;
                    }
                }
            }
        }
        i = i + 1;
    }
    return loopid;
}

// Does the `if` condition `cid` narrow `name` in production's eyes? extract_narrowing_predicate
// takes exactly `<name> RELOP <int literal>` or the reverse, RELOP one of the six comparisons;
// a `while` or `match` never narrows, nor does a condition that computes with the name.
fn rf_narrows_var(nodes: Arena<PNode>, kids: Vec<i64>, cid: i64, name: str) -> bool {
    let c: PNode = nodes.get(cid);
    if c.kind != P_K_BINARY {
        return false;
    }
    let cmp: bool = cv_op_is_cmp(c.value);
    if !cmp {
        return false;
    }
    if c.child_count != 2 {
        return false;
    }
    let lid: i64 = kids.get(c.child_start);
    let rid: i64 = kids.get(c.child_start + 1);
    let l: PNode = nodes.get(lid);
    let r: PNode = nodes.get(rid);
    if l.kind == P_K_PATH {
        let lhit: bool = l.text.bytes_eq(name);
        if lhit {
            if r.kind == P_K_LIT_INT {
                return true;
            }
        }
    }
    if r.kind == P_K_PATH {
        let rhit: bool = r.text.bytes_eq(name);
        if rhit {
            if l.kind == P_K_LIT_INT {
                return true;
            }
        }
    }
    return false;
}

// Is the `arr[v]` access `ixid` one production's RF-M3 may narrow: `v` the variable of an
// enclosing range-for whose fact holds (rf_fact_k), `arr` a declared fixed array, and an `if`
// between the loop and the access whose condition narrows `v` (rf_narrows_var)? Production then
// tightens the fact's interval with the guard and may elide the bounds check, or keep it where
// the fact alone would have elided (a contradictory guard makes no claim), so the emitter poisons
// the access rather than guess. Without a fact, a fixed array or a narrowing `if`, production
// and this emitter agree already, and nothing is poisoned (SHP-5b, the #815 review).
fn rf_index_guarded(nodes: Arena<PNode>, kids: Vec<i64>, ixid: i64) -> bool {
    let n: PNode = nodes.get(ixid);
    if n.kind != P_K_INDEX {
        return false;
    }
    let arrid: i64 = kids.get(n.child_start);
    let an: PNode = nodes.get(arrid);
    if an.kind != P_K_PATH {
        return false;
    }
    let aq0: i64 = tc_last_colons(an.text);
    if aq0 >= 0 {
        return false;
    }
    let idxid: i64 = kids.get(n.child_start + 1);
    let dn: PNode = nodes.get(idxid);
    if dn.kind != P_K_PATH {
        return false;
    }
    let dq0: i64 = tc_last_colons(dn.text);
    if dq0 >= 0 {
        return false;
    }
    let fnid: i64 = rf_enclosing_fn(nodes, ixid);
    if fnid < 0 {
        return false;
    }
    let loopid: i64 = rf_innermost_loop(nodes, ixid, dn.text);
    if loopid < 0 {
        return false;
    }
    let k: i64 = rf_fact_k(nodes, kids, loopid);
    if k < 1 {
        return false;
    }
    let nsize: i64 = rf_decl_array_size(nodes, kids, fnid, an.text);
    if nsize < 1 {
        return false;
    }
    let total: i64 = nodes.len();
    let mut j: i64 = 0;
    while j < total {
        let g: PNode = nodes.get(j);
        if g.kind == P_K_IF {
            if g.child_count >= 1 {
                let inloop: bool = rf_contains(nodes, loopid, j);
                if inloop {
                    let holds: bool = rf_contains(nodes, j, ixid);
                    if holds {
                        let cid: i64 = kids.get(g.child_start);
                        let narrows: bool = rf_narrows_var(nodes, kids, cid, dn.text);
                        if narrows {
                            return true;
                        }
                    }
                }
            }
        }
        j = j + 1;
    }
    return false;
}


// ═════════════════════════════════════════════════════════════════════════════
// The operand-exact AIR builder (docs/specs/sh-air.md).
// The CV lane produces one line per fn — `tail|params|ret|locals|blocks` — with REAL VarIds,
// compared against the harness `oracle_cv_projection` by EXACT string equality. The lowering
// mirror is ALLOCATE-THEN-RECURSE (X6): a to_var dst is freshed BEFORE its operands are lowered;
// a let dst is freshed before its value — matching air.rs:1813/1440, the discipline the KIND
// lanes never saw. `cv_fresh` is the ONLY id source; the locals Vec doubles as the counter
// (next id = param_count + locals.len()). Unsupported forms emit CVS_POISON → a `!` in the
// render, which can never match an oracle render → one-sided LOUD (the CV fail-closed).
// ═════════════════════════════════════════════════════════════════════════════

// The CV env binding: a name -> (VarId, airtype token). Params + lets, append-only per fn.
record CvBind { name: str, var: i64, ty: str, rec: i64, elem: str, tuptys: str, esize: i64 }

// The flat CV stmt arena record (the PNode idiom): kind + generic operand slots.
// CVS_AS_INT: a=dst, b=the literal. CVS_AS_BOOL: a=dst, b=1/0. CVS_AS_VAR: a=dst, b=src.
// CVS_AS_BIN: a=dst, b=lhs, c=the P_K_BINARY op TOKEN code, d=rhs. CVS_POISON: none.
record CvStmt { kind: i64, a: i64, b: i64, c: i64, d: i64, s: str }

const CVS_AS_INT: i64 = 1;
const CVS_AS_BOOL: i64 = 2;
const CVS_AS_VAR: i64 = 3;
const CVS_AS_BIN: i64 = 4;
// SH-AIR-CV-2: the trap intrinsic's TrapIf (a=cond), the for-in len load (a=dst, b=base — always
// @0:U32), and the for-in element load (a=dst, b=base, c=idx, d=elem width, s=elem ty — always +4).
const CVS_TRAP: i64 = 5;
const CVS_LF_LEN: i64 = 6;
const CVS_LD_ELEM: i64 = 7;
// SH-AIR-CV-3: the general field read/write (real offsets), the user free-fn call (the arg list
// pre-rendered into `s` at emission — args are already ids), and the pre-memory BumpAlloc.
const CVS_LF2: i64 = 8;
const CVS_SF: i64 = 9;
const CVS_CALL: i64 = 10;
const CVS_BA: i64 = 11;
// SH-AIR-CV-4: the string-literal data-ptr Assign (s=content), the record-construct Assign
// (s = the pre-rendered `name=vN` list), the index StoreDynamic, and WrapI64.
const CVS_AS_STR: i64 = 12;
const CVS_AS_REC: i64 = 13;
const CVS_SD: i64 = 14;
const CVS_WRAP: i64 = 15;
const CVS_FUEL: i64 = 16;
// B-VEC: the vec/alloc intrinsic kinds. LD0/SD0 mirror LD_ELEM/SD but with memarg OFFSET 0
// (vec buffers are header-less; the array kinds bake the 4-byte length header). IALLOC is the
// alloc builtin call: i32-operand -> call the ring's sigil.alloc import (4 inner, 1 outer) ->
// i64.extend_i32_u -> set.
const CVS_LD0: i64 = 17;
const CVS_SD0: i64 = 18;
const CVS_IALLOC: i64 = 19;
// W-STR-A: the str-intrinsic vocabulary. EXT_U32 = i64.extend_i32_u (173, the u32 len -> i64
// widen); LD8 = i32.load8_u (45, align 0 offset 0 — the UTF-8 byte probe, and since SHP-1 the
// user `load8`); CTSEL = the constant-time select, emitted as the oracle's branchless mask, never
// wasm select (27).
const CVS_EXT_U32: i64 = 20;
const CVS_LD8: i64 = 21;
const CVS_CTSEL: i64 = 22;
// W-STR-B: ST8 = i64.store8 (60, align 0 offset 0 — the string-builder byte write).
const CVS_ST8: i64 = 23;
// SHP-1: the constant-time compares (IntrinsicCtEq / IntrinsicCtLt), 8-byte operands only.
// A CVS_CTLT's d is its order: 1 for two U64 (unsigned), 0 for two I64 (signed).
const CVS_CTEQ: i64 = 24;
const CVS_CTLT: i64 = 25;
// SHP-2b: the oracle's ExternCall. a=dst (-1 when the extern returns Unit: call_dst gives None),
// s = `name|vA vB …` (the callee name, then the pre-rendered args). No fuel, as in the oracle
// (fuel.rs charges a Call and the messaging statements only), so it must never be a CVS_CALL; the
// emitter calls the ring's FFI import. A Unit dst is off-surface, as at a CVS_CALL: the oracle's
// type check rejects a call to a Unit-returning fn (T073), extern or not, so the emitter refuses it.
const CVS_EXTERN: i64 = 26;
// SHP-5b: the oracle's SecurityRelease (a=dst, b=src, c=cap, d=the dead ownership sink; wasm.rs
// copies src to dst and cap to the sink) and its non-slice Borrow (a=dst, b=src: a local copy).
const CVS_RELEASE: i64 = 27;
const CVS_BORROW: i64 = 28;
// SHP-5b: the oracle's CapRestrict (a=dst, b=src, c=the restriction mask; s=the authority, or
// "" for the full-mask restrict_deadline) and CapSplit / CapDraw (a=dst, b=src, c=amount; d=1
// for draw), one kind since wasm.rs emits both through the one cap_split import.
const CVS_CAPRESTRICT: i64 = 29;
const CVS_CAPSPLIT: i64 = 30;
// SHP-5c-3: the oracle's SlotNew (a=dst), SlotPut (a=slot, b=cap) and SlotTake (a=dst, b=slot)
// — the 8-byte slot cell's tag and cap words at offsets 0 and 4, written and read with 4-byte
// stores and loads at alignment 0 (wasm.rs `mem_arg(0|4, 0)`); and RegionBegin (a=the U32 save
// local) / RegionEnd (a=save, b=the limit local, c=1 when the limit is 8 bytes wide and is
// wrapped before the compare) — the BUMP_PTR snapshot, and the net-allocation trap + rewind.
const CVS_SLOTNEW: i64 = 31;
const CVS_SLOTPUT: i64 = 32;
const CVS_SLOTTAKE: i64 = 33;
const CVS_RBEGIN: i64 = 34;
const CVS_REND: i64 = 35;
const CVS_POISON: i64 = 99;

// Terminator kinds (CV-1: returns; CV-2: the full alphabet).
const CVT_RET_NONE: i64 = 1;
const CVT_RET_SOME: i64 = 2;
const CVT_JMP: i64 = 3;
const CVT_LOOP: i64 = 4;
const CVT_BR: i64 = 5;
const CVT_DISP: i64 = 6;
const CVT_UNR: i64 = 7;

// SH-AIR-CV-2: one lowered block — id, a CONTIGUOUS stmt range [stmt_start, stmt_start+stmt_count)
// into the per-fn CvStmt Vec, and the terminator (term kind + targets; tm = the Br merge or -1 for
// None). Blocks are pushed in EMISSION order, which is NOT id order (a Dispatch's exit block is
// allocated before the arm chain but pushed last) — the serializer preserves push order.
record CvBlock { id: i64, stmt_start: i64, stmt_count: i64, term: i64, ta: i64, tb: i64, tc2: i64, tm: i64 }

// A non-negative OR negative i64 as decimal (the parser folds `-5` into a NEGATIVE
// P_K_LIT_INT.value; ai_int_to_str is non-negative-only).
fn cv_i64_str(n: i64) -> str ! { Alloc } {
    if n < 0 {
        let p: str = ai_int_to_str(0 - n);
        let m: str = "-";
        return m.concat(p);
    } else {
    }
    return ai_int_to_str(n);
}

// The P_K_BINARY op TOKEN code -> the oracle `BinaryOp` Debug token (ast.rs:1393). An unknown
// code renders `?OP` — unmatchable against any oracle render (loud, fail-closed).
fn cv_op_tok(op: i64) -> str {
    if op == T_PLUS {
        return "Add";
    } else {
    }
    if op == T_MINUS {
        return "Sub";
    } else {
    }
    if op == T_STAR {
        return "Mul";
    } else {
    }
    if op == T_SLASH {
        return "Div";
    } else {
    }
    if op == T_PERCENT {
        return "Mod";
    } else {
    }
    if op == T_LT {
        return "Lt";
    } else {
    }
    if op == T_GT {
        return "Gt";
    } else {
    }
    if op == T_EQEQ {
        return "Eq";
    } else {
    }
    if op == T_BANGEQ {
        return "NotEq";
    } else {
    }
    if op == T_LTEQ {
        return "LtEq";
    } else {
    }
    if op == T_GTEQ {
        return "GtEq";
    } else {
    }
    if op == T_LTLT {
        return "Shl";
    } else {
    }
    if op == T_GTGT {
        return "Shr";
    } else {
    }
    if op == T_AMP {
        return "BitAnd";
    } else {
    }
    if op == T_PIPE {
        return "BitOr";
    } else {
    }
    return "?OP";
}

// True iff the op is a comparison (the oracle types a comparison Bool, air lowering dst type).
fn cv_op_is_cmp(op: i64) -> bool {
    if op == T_EQEQ {
        return true;
    } else {
    }
    if op == T_BANGEQ {
        return true;
    } else {
    }
    if op == T_LT {
        return true;
    } else {
    }
    if op == T_GT {
        return true;
    } else {
    }
    if op == T_LTEQ {
        return true;
    } else {
    }
    if op == T_GTEQ {
        return true;
    } else {
    }
    return false;
}

// Env lookups (mirror tc_bind_lookup's linear scan; LAST binding wins for shadowing — scan from
// the end).
fn cv_env_var(env: Vec<CvBind>, name: str) -> i64 {
    let n: i64 = env.len();
    let mut i: i64 = n - 1;
    while i >= 0 {
        let b: CvBind = env.get(i);
        let eq: bool = b.name.bytes_eq(name);
        if eq {
            return b.var;
        } else {
        }
        i = i - 1;
    }
    return 0 - 1;
}

fn cv_elem_of_typenode(nodes: Arena<PNode>, kids: Vec<i64>, tid: i64, rdefs: Vec<TcRec>) -> str ! { Alloc } {
    if tid < 0 {
        return "";
    } else {
    }
    let tn: PNode = nodes.get(tid);
    if tn.kind == P_K_TYPE_ARRAY {
        let elid: i64 = kids.get(tn.child_start);
        return ai_airtype_of_typenode(nodes, kids, elid, rdefs);
    } else {
    }
    // W-STR-A: str PROVENANCE rides `elem` as the `$str` sentinel (no array token collides —
    // real elems are AirType tokens). The binding's `ty` stays "Ptr" (the CV render contract:
    // lower_type maps Str -> Ptr), so renders + locals are byte-unchanged; only the str-
    // intrinsic method dispatch reads the sentinel (cv_env_isstr).
    let ttop: i64 = tc_type_topcode(nodes, kids, tid, rdefs);
    if ttop == TC_T_STR {
        return "$str";
    } else {
    }
    // CAP-MATCH: a GENERIC-ENUM annotation (`Option<i64>`) records its INSTANCE payload
    // token in `elem` (the same provenance channel Vec elems and $str ride) so the match
    // lowering can extract `Some(x)` at the instance width. Concrete enums, records, and
    // everything else keep "" (byte-unchanged); an Option local is never a str/vec
    // receiver, so the elem readers cannot misroute on it.
    if tn.child_count >= 1 {
        let nre: i64 = rdefs.len();
        let mut rei: i64 = 0;
        while rei < nre {
            let rcand: TcRec = rdefs.get(rei);
            let rne: bool = rcand.name.bytes_eq(tn.text);
            if rne {
                if rcand.vnames.len() > 0 {
                    if rcand.tpnames.len() > 0 {
                        let tgid: i64 = kids.get(tn.child_start);
                        return ai_airtype_of_typenode(nodes, kids, tgid, rdefs);
                    } else {
                    }
                } else {
                }
                rei = nre;
            } else {
                rei = rei + 1;
            }
        }
    } else {
    }
    return "";
}

// W-STR-A: true iff `name` binds a str value (the `$str` elem sentinel).
fn cv_env_isstr(env: Vec<CvBind>, name: str) -> bool {
    let n: i64 = env.len();
    let mut i: i64 = 0;
    let mut found: bool = false;
    while i < n {
        let b: CvBind = env.get(i);
        if b.name.bytes_eq(name) {
            found = b.elem.bytes_eq("$str");
        } else {
        }
        i = i + 1;
    }
    return found;
}

fn cv_env_elem(env: Vec<CvBind>, name: str) -> str {
    let n: i64 = env.len();
    let mut i: i64 = n - 1;
    while i >= 0 {
        let b: CvBind = env.get(i);
        let eq: bool = b.name.bytes_eq(name);
        if eq {
            return b.elem;
        } else {
        }
        i = i - 1;
    }
    return "";
}

fn cv_env_rec(env: Vec<CvBind>, name: str) -> i64 {
    let n: i64 = env.len();
    let mut i: i64 = n - 1;
    while i >= 0 {
        let b: CvBind = env.get(i);
        let eq: bool = b.name.bytes_eq(name);
        if eq {
            return b.rec;
        } else {
        }
        i = i - 1;
    }
    return 0 - 1;
}

fn cv_env_esize(env: Vec<CvBind>, name: str) -> i64 {
    let n: i64 = env.len();
    let mut i: i64 = n - 1;
    while i >= 0 {
        let b: CvBind = env.get(i);
        if b.name.bytes_eq(name) {
            return b.esize;
        } else {
        }
        i = i - 1;
    }
    return 0;
}

fn cv_env_tytok(env: Vec<CvBind>, name: str) -> str {
    let n: i64 = env.len();
    let mut i: i64 = n - 1;
    while i >= 0 {
        let b: CvBind = env.get(i);
        let eq: bool = b.name.bytes_eq(name);
        if eq {
            return b.ty;
        } else {
        }
        i = i - 1;
    }
    return "?";
}

// The type token a fresh dst gets for `eid` (mirror lower_type(&expr.ty) on the scalar surface):
// an int lit -> I64; a bool lit -> Bool; a bare local -> its env type; a binary -> Bool if a
// comparison else the lhs type. Anything else -> "?" (poisons the render — loud).
fn cv_expr_tytok(nodes: Arena<PNode>, kids: Vec<i64>, eid: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, cnames: Vec<str>, cvals: Vec<i64>) -> str {
    let n: PNode = nodes.get(eid);
    if n.kind == P_K_LIT_INT {
        return "I64";
    } else {
    }
    if n.kind == P_K_LIT_BOOL {
        return "Bool";
    } else {
    }
    if n.kind == P_K_PATH {
        let cc: i64 = tc_last_colons(n.text);
        if cc >= 0 {
            let tlen: i64 = n.text.len();
            let fbase: str = n.text.substr(0, cc);
            let fseg: str = n.text.substr(cc + 2, tlen);
            let brec: i64 = cv_env_rec(env, fbase);
            if brec >= 0 {
                return cv_field_tok(rdefs, brec, fseg);
            } else {
            }
            return "Ptr";
        } else {
        }
        // W-CONST: a const reference types I64 (the inlined IntLit).
        let ttok: str = cv_env_tytok(env, n.text);
        let tunk: bool = ttok.bytes_eq("?");
        if tunk {
            let tcv: i64 = cv_ctbl_find(cnames, cvals, n.text);
            if tcv >= 0 {
                return "I64";
            } else {
            }
            // SHP-5c-3: an enclosing region's name is its i64 handle.
            if cv_region_name_encloses(nodes, eid, n.text) {
                return "I64";
            }
        } else {
        }
        return ttok;
    } else {
    }
    if n.kind == P_K_CALL {
        let cc3: i64 = tc_last_colons(n.text);
        if cc3 < 0 {
            // B-VEC: the memory intrinsics have no user sig — pin their ret tokens (alloc: i64;
            // vec_load: the ELEM token via the witness (W-ELEM; "?" poisons at the caller);
            // vec_store: unit) so let-bound results type.
            let ia: bool = n.text.bytes_eq("alloc");
            if ia {
                return "I64";
            } else {
            }
            let il: bool = n.text.bytes_eq("vec_load");
            if il {
                let velem: str = cv_vec_elem_tok(nodes, kids, eid, env, rdefs);
                return velem;
            } else {
            }
            let iw: bool = n.text.bytes_eq("vec_store");
            if iw {
                return "Unit";
            } else {
            }
            // W-STR-B: store8's expr-stmt dst is the phantom Unit local.
            let i8: bool = n.text.bytes_eq("store8");
            if i8 {
                return "Unit";
            } else {
            }
            // W-STRRAW: str_from_raw wraps (ptr, len) into a fresh str HEADER -> Ptr.
            let ifr: bool = n.text.bytes_eq("str_from_raw");
            if ifr {
                return "Ptr";
            } else {
            }
            // SHP-5c-3: a slot is a pointer (`Slot<C>`), a taken cap a pointer, a put Unit.
            let isn: bool = n.text.bytes_eq("slot_new");
            if isn {
                return "Ptr";
            }
            let ist: bool = n.text.bytes_eq("slot_take");
            if ist {
                return "Ptr";
            }
            let isp: bool = n.text.bytes_eq("slot_put");
            if isp {
                return "Unit";
            }
            return cv_sig_ret_tok(sigs, n.text);
        } else {
        }
        return "?";
    } else {
    }
    if n.kind == P_K_TUPLE {
        return "Ptr";
    } else {
    }
    if n.kind == P_K_RECORD_CONSTRUCT {
        return "Ptr";
    } else {
    }
    if n.kind == P_K_ARRAY {
        return "Ptr";
    } else {
    }
    // SHP-5b: a release types as its value; a borrow and the capability ops are Ptr (lower_type).
    if n.kind == P_K_DECLASSIFY {
        if n.child_count == 2 {
            let rvid: i64 = kids.get(n.child_start);
            let rvt: str = cv_expr_tytok(nodes, kids, rvid, env, rdefs, sigs, cnames, cvals);
            return rvt;
        }
        return "?";
    }
    if n.kind == P_K_DECLASSIFY_CT {
        if n.child_count == 2 {
            let rcvid: i64 = kids.get(n.child_start);
            let rcvt: str = cv_expr_tytok(nodes, kids, rcvid, env, rdefs, sigs, cnames, cvals);
            return rcvt;
        }
        return "?";
    }
    if n.kind == P_K_BORROW {
        return "Ptr";
    }
    if n.kind == P_K_CAP_RESTRICT {
        return "Ptr";
    }
    if n.kind == P_K_CAP_RESTRICT_DEADLINE {
        return "Ptr";
    }
    if n.kind == P_K_CAP_SPLIT {
        return "Ptr";
    }
    if n.kind == P_K_CAP_DRAW {
        return "Ptr";
    }
    if n.kind == P_K_LIT_STR {
        return "Ptr";
    } else {
    }
    if n.kind == P_K_METHOD {
        // ST-2: a dot-method `p.get()` — its type is the method's RET type (the
        // `Type::method` sig key); an enum ctor `E::B(x)` → Ptr (child0 is an enum).
        if n.child_count >= 1 {
            let mtrid: i64 = kids.get(n.child_start);
            let mtrn: PNode = nodes.get(mtrid);
            // W-STR-A: str intrinsic method ret tokens (len/byte_at -> I64; substr -> Ptr —
            // a str value's token is Ptr by the render contract). Gate = the `$str` elem
            // sentinel on a bare-path receiver binding.
            let mut mtisstr: bool = false;
            if mtrn.kind == P_K_PATH {
                let mtcc: i64 = tc_last_colons(mtrn.text);
                if mtcc < 0 {
                    mtisstr = cv_env_isstr(env, mtrn.text);
                } else {
                    // CAP-LOCALS (capstone Finding 2A): a one-hop str FIELD receiver types
                    // its intrinsic methods identically to a bare one (the W-STR-FIELD
                    // gate). Without this, a field-str .len() in EXPRESSION position (an if
                    // condition) freshed its temp from the fall-through token (Ptr) instead
                    // of I64 — a same-length SILENT locals-width divergence. Let-bound and
                    // return positions were immune (dst from the annotation / fn ret).
                    let mttl: i64 = mtrn.text.len();
                    let mtfb: str = mtrn.text.substr(0, mtcc);
                    let mtfs: str = mtrn.text.substr(mtcc + 2, mttl);
                    let mtbr: i64 = cv_env_rec(env, mtfb);
                    if mtbr >= 0 {
                        mtisstr = cv_field_isstr(rdefs, mtbr, mtfs);
                    } else {
                    }
                }
            } else {
            }
            if mtisstr {
                let wsl: bool = n.text.bytes_eq("len");
                if wsl {
                    return "I64";
                } else {
                }
                let wsb: bool = n.text.bytes_eq("byte_at");
                if wsb {
                    return "I64";
                } else {
                }
                let wss: bool = n.text.bytes_eq("substr");
                if wss {
                    return "Ptr";
                } else {
                }
                let wdc: bool = n.text.bytes_eq("concat");
                if wdc {
                    return "Ptr";
                } else {
                }
                let wdj: bool = n.text.bytes_eq("join");
                if wdj {
                    return "Ptr";
                } else {
                }
                let wde: bool = n.text.bytes_eq("bytes_eq");
                if wde {
                    return "Bool";
                } else {
                }
                let wdt: bool = n.text.bytes_eq("contains");
                if wdt {
                    return "Bool";
                } else {
                }
                // Stage-3-0: `s.as_output()` packs a str header into the forge return i64.
                let wao: bool = n.text.bytes_eq("as_output");
                if wao {
                    return "I64";
                } else {
                }
            } else {
            }
            // W-STR-B: `.itoa()` on a bare I64 binding -> Ptr (str_itoa's pair).
            if mtrn.kind == P_K_PATH {
                let itcc: i64 = tc_last_colons(mtrn.text);
                if itcc < 0 {
                    let ittok: str = cv_env_tytok(env, mtrn.text);
                    let iti: bool = ittok.bytes_eq("I64");
                    if iti {
                        let wit: bool = n.text.bytes_eq("itoa");
                        if wit {
                            return "Ptr";
                        } else {
                        }
                        // Stage-3-0: `ptr.from_bytes(len)` -> str_from_bytes -> Option<str> (tok Ptr).
                        let wfb: bool = n.text.bytes_eq("from_bytes");
                        if wfb {
                            return "Ptr";
                        } else {
                        }
                    } else {
                    }
                } else {
                }
            } else {
            }
            if mtrn.kind == P_K_PATH {
                let mtrr: i64 = cv_recv_rec(env, rdefs, mtrn.text);
                if mtrr >= 0 {
                    let mtrec: TcRec = rdefs.get(mtrr);
                    // SH-MONO MONO-7: pre-resolved generic-method call (flag 2^21) — the instance
                    // is a top-level fn, so its ret sig is keyed by n.text (the free-fn key), not
                    // `{Type}::{method}` (which would be `Box__i64::get` -> a miss -> wrong tok).
                    let mtpre7: i64 = n.flags & 2097152;
                    if mtpre7 > 0 {
                        return cv_sig_ret_tok(sigs, n.text);
                    } else {
                    }
                    let mtsep: str = mtrec.name.concat("::");
                    let mtkey: str = mtsep.concat(tc_seg_at(n.text, 0));
                    return cv_sig_ret_tok(sigs, mtkey);
                } else {
                }
            } else {
            }
        } else {
        }
        return "Ptr";
    } else {
    }
    if n.kind == P_K_INDEX {
        let rxid: i64 = kids.get(n.child_start);
        let rxn: PNode = nodes.get(rxid);
        if rxn.kind == P_K_PATH {
            return cv_env_elem(env, rxn.text);
        } else {
        }
        return "?";
    } else {
    }
    if n.kind == P_K_BINARY {
        let isc: bool = cv_op_is_cmp(n.value);
        if isc {
            return "Bool";
        } else {
        }
        let lid: i64 = kids.get(n.child_start);
        let rid: i64 = kids.get(n.child_start + 1);
        // SHP-0b: an operand the oracle types from context alone (a literal, or literal
        // arithmetic) takes the other operand's type, as the oracle unifies them; only a bare
        // literal on the left was recognised, so `(1 + 2) * x` typed as I64 for an `i32` x.
        if cv_expr_literal_typed(nodes, kids, lid) {
            if !cv_expr_literal_typed(nodes, kids, rid) {
                return cv_expr_tytok(nodes, kids, rid, env, rdefs, sigs, cnames, cvals);
            }
        }
        return cv_expr_tytok(nodes, kids, lid, env, rdefs, sigs, cnames, cvals);
    } else {
    }
    return "?";
}

// SH-WASM W3: the binary's OPERAND ty — the non-literal side's token (both
// literal -> "I64", the default int; the INTO-arith case overrides with dstty).
// The oracle's typed AST unifies operand tys, so a literal operand inherits the
// other side's type — bare inference wrongly defaulted it to I64 on u32/bool
// operands (caught by the W3 wasm byte-diff).
fn cv_binop_operand_ty(nodes: Arena<PNode>, kids: Vec<i64>, n: PNode, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, cnames: Vec<str>, cvals: Vec<i64>) -> str ! { Alloc } {
    let lid: i64 = kids.get(n.child_start);
    let rid: i64 = kids.get(n.child_start + 1);
    // SHP-0b: as in cv_expr_tytok, a literal-typed operand (not only a bare literal) takes the
    // other operand's type; two of them default to I64.
    if cv_expr_literal_typed(nodes, kids, lid) {
        if cv_expr_literal_typed(nodes, kids, rid) {
            return "I64";
        }
        return cv_expr_tytok(nodes, kids, rid, env, rdefs, sigs, cnames, cvals);
    }
    return cv_expr_tytok(nodes, kids, lid, env, rdefs, sigs, cnames, cvals);
}

// Mat one binary operand: a LITERAL freshes with the OPERAND ty (see above);
// anything else goes through cv_to_var unchanged.
fn cv_binop_mat(nodes: Arena<PNode>, kids: Vec<i64>, cid: i64, opty: str, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let cn2: PNode = nodes.get(cid);
    if cn2.kind == P_K_LIT_INT {
        let d: i64 = cv_fresh(opty, base, locals);
        let q: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: d, b: cn2.value, c: 0, d: 0, s: "" });
        return d;
    } else {
    }
    // SHP-0b: an operand the oracle types from context alone (literal arithmetic such as the
    // `1 + 2` in `x < 1 + 2`) takes the operation's operand type too: the oracle unifies it with
    // the other operand. It is lowered into a fresh dst of that type, as the let path lowers its
    // value (dst first, then its own operands, the oracle's order), so the arithmetic inside it
    // runs at that type. cv_to_var typed it on its own, as I64.
    if cv_tok_is_int(opty) {
        if cv_expr_literal_typed(nodes, kids, cid) {
            let dl: i64 = cv_fresh(opty, base, locals);
            let qdl: i64 = cv_into(nodes, kids, dl, cid, base, env, rdefs, sigs, fids, cnames, cvals, opty, 0 - 1, 0, 0 - 1, locals, stmts);
            return dl;
        }
    }
    let v: i64 = cv_to_var(nodes, kids, cid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
    return v;
}

// SHP-0b: the type token of a var built in this function: a fresh local's from `locals`, a
// parameter's from its env binding, "" when neither knows it.
fn cv_built_var_tok(v: i64, base: i64, env: Vec<CvBind>, locals: Vec<str>) -> str ! { Alloc } {
    if v >= base {
        return cv_local_tytok(v, base, locals);
    }
    let n: i64 = env.len();
    let mut i: i64 = 0;
    while i < n {
        let b: CvBind = env.get(i);
        if b.var == v {
            return b.ty;
        }
        i = i + 1;
    }
    return "";
}

// SHP-0b: true iff `t` is an 8-byte integer token (I64, U64).
fn cv_tok_is_wide_int(t: str) -> bool {
    if t.bytes_eq("I64") {
        return true;
    }
    return t.bytes_eq("U64");
}

// SHP-0b: true iff `t` is an integer token of either width (I64, U64, I32, U32).
fn cv_tok_is_int(t: str) -> bool {
    if cv_tok_is_wide_int(t) {
        return true;
    }
    if t.bytes_eq("I32") {
        return true;
    }
    return t.bytes_eq("U32");
}

// SHP-0b: true iff the oracle types `eid` from its context alone: an integer literal, or
// arithmetic whose operands are all such (the parser folds a unary minus into the literal, or
// spells it `0 - x`). Its width is the slot's, so only a slot whose type this lowering knows can
// type it; everywhere else it would default to I64 where the oracle chose the slot's type.
fn cv_expr_literal_typed(nodes: Arena<PNode>, kids: Vec<i64>, eid: i64) -> bool {
    let n: PNode = nodes.get(eid);
    if n.kind == P_K_LIT_INT {
        return true;
    }
    if n.kind != P_K_BINARY {
        return false;
    }
    if cv_op_is_cmp(n.value) {
        return false;
    }
    let lid: i64 = kids.get(n.child_start);
    let rid: i64 = kids.get(n.child_start + 1);
    if !cv_expr_literal_typed(nodes, kids, lid) {
        return false;
    }
    return cv_expr_literal_typed(nodes, kids, rid);
}

// SHP-0b: lower `eid` for a slot whose declared type token is `stok` (a call argument, a return
// value, a record field, an array element, a field or element write), the way the oracle types
// a value by the slot it is written to. A bare integer literal takes the slot's integer type
// directly. Any other value must already carry exactly `stok`, or the slot is refused: the
// oracle would have typed it by the slot, and this lowering typed it on its own (the width, or
// the signedness of its arithmetic, would differ). When this lowering does not know the slot's
// type (`stok` is not a known token), a value the oracle types from context alone
// (`cv_expr_literal_typed`) is refused for the same reason; any other value types itself.
// Fails closed: a value whose own token is unknown is refused against a known slot.
fn cv_slot_var(nodes: Arena<PNode>, kids: Vec<i64>, eid: i64, stok: str, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    if !cv_ty_known(stok) {
        if cv_expr_literal_typed(nodes, kids, eid) {
            let qpu: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            return 0;
        }
        return cv_to_var(nodes, kids, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
    }
    let n: PNode = nodes.get(eid);
    if n.kind == P_K_LIT_INT {
        if cv_tok_is_int(stok) {
            let ld: i64 = cv_fresh(stok, base, locals);
            let ql: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: ld, b: n.value, c: 0, d: 0, s: "" });
            return ld;
        }
    }
    let v: i64 = cv_to_var(nodes, kids, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
    let vt: str = cv_built_var_tok(v, base, env, locals);
    if !vt.bytes_eq(stok) {
        let qpm: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
    }
    return v;
}

// THE ONLY id source (X6). The locals Vec doubles as the counter: id = base + locals.len()
// (base = the param count), and the rendered `v{id}:{ty}` entry is pushed at fresh time — the
// locals table falls out in fresh order for free (matching the oracle's fresh_local push).
fn cv_fresh(ty: str, base: i64, locals: Vec<str> @Mut) -> i64 ! { Alloc } {
    let id: i64 = base + locals.len();
    let ids: str = cv_i64_str(id);
    let vlead: str = "v";
    let va: str = vlead.concat(ids);
    let vb: str = va.concat(":");
    let vc: str = vb.concat(ty);
    let q: i64 = locals.push(vc);
    return id;
}

// SH-AIR-CV-2: the block-id counter. Allocation order ≠ push order (unlike locals), so the
// locals-Vec trick doesn't apply — a dedicated push-counter Vec does: id = len after a dummy push.
// The entry block is 0 (never freshed); the first fresh_block returns 1 (mirrors next_block init 1,
// air.rs:1387).
// RF-M4: the ty token of LOCAL var `v` (>= base), parsed from its `vN:Ty` locals
// entry (all-ASCII). Used by the continue arm to size the injected `__one` from
// the FRAME's counter — U32 for for-in, I64 for range-for (the oracle's
// LoopFrame.continue_incr width, air.rs:1861-1864). A param id (v < base — no
// loop counter is ever a param; both loops fresh theirs) returns "" — an
// unmatchable local entry, loud-not-silent (the ?OP discipline).
fn cv_local_tytok(v: i64, base: i64, locals: Vec<str>) -> str {
    if v < base {
        return "";
    } else {
    }
    // SHP-0b: total. A lowering that poisons returns var 0 as its safe id, which names no local
    // when the function has no parameters and no locals yet; "" (unknown) rather than a trap.
    if v - base >= locals.len() {
        return "";
    }
    let ent: str = locals.get(v - base);
    let el: i64 = ent.len();
    let mut i: i64 = 0;
    while i < el {
        let ch: str = ent.substr(i, i + 1);
        if ch.bytes_eq(":") {
            return ent.substr(i + 1, el);
        } else {
        }
        i = i + 1;
    }
    return "";
}

fn cv_fresh_block(bctr: Vec<i64> @Mut) -> i64 ! { Alloc } {
    let q: i64 = bctr.push(0);
    return bctr.len();
}

// SH-FUEL F2: multiplicity arithmetic under the SHARED clamp (2^40 — the oracle's
// FUEL_MULT_CLAMP; air.rs `fuel_mul_clamped`). -1 = unbounded, poisoning the product.
// The division guard gives EXACTLY min(a*b, CLAMP) without overflowing i64: for
// 0 <= a,b <= CLAMP, `a > CLAMP/b` (integer div) iff a*b > CLAMP.
fn cv_mclamp(a: i64, b: i64) -> i64 {
    if a < 0 {
        return 0 - 1;
    } else {
    }
    if b < 0 {
        return 0 - 1;
    } else {
    }
    if b == 0 {
        return 0;
    } else {
    }
    let lim: i64 = 1099511627776;
    let guard: i64 = lim / b;
    if a > guard {
        return lim;
    } else {
    }
    return a * b;
}

// SH-FUEL F2: clamped add (inputs are already <= CLAMP, so the sum fits i64).
fn cv_aclamp(a: i64, b: i64) -> i64 {
    let s: i64 = a + b;
    let lim: i64 = 1099511627776;
    if s > lim {
        return lim;
    } else {
    }
    return s;
}

// SH-AIR-CV-2: flush the current block — record its contiguous stmt range + terminator, in
// emission order. SH-FUEL F2: `mult` is the block's static execution multiplicity (product
// of enclosing literal for-range bounds; -1 = unbounded), pushed to the PARALLEL `bmults`
// arena — blocks[j] <-> bmults[j] in flush order, an alignment cv_mem_lower and
// cv_fuel_insert both preserve (each maps exactly one input block to one output block, in
// order). Mirrors the oracle's AirFunction::block_static_multiplicity.
fn cv_flush(blocks: Vec<CvBlock> @Mut, id: i64, mark: i64, endlen: i64, term: i64, ta: i64, tb: i64, tc2: i64, tm: i64, bmults: Vec<i64> @Mut, mult: i64) -> i64 ! { Alloc } {
    let q: i64 = blocks.push(CvBlock { id: id, stmt_start: mark, stmt_count: endlen - mark, term: term, ta: ta, tb: tb, tc2: tc2, tm: tm });
    let qm: i64 = bmults.push(mult);
    return 0;
}

// SH-AIR-CV-2: clone the env for a branch/body recursion (mirrors the oracle's `env.clone()` —
// branch bindings never leak to the sibling branch or the remainder).
fn cv_env_clone(src: Vec<CvBind>) -> Vec<CvBind> ! { Alloc } {
    let mut dst: Vec<CvBind> = Vec::new();
    let n: i64 = src.len();
    let mut i: i64 = 0;
    while i < n {
        let b: CvBind = src.get(i);
        let q: i64 = dst.push(CvBind { name: b.name, var: b.var, ty: b.ty, rec: b.rec, elem: b.elem, tuptys: b.tuptys, esize: b.esize });
        i = i + 1;
    }
    return dst;
}

// The airtype-token width (AirType::width, air.rs:562).
fn cv_ty_width(tok: str) -> i64 {
    let w8a: bool = tok.bytes_eq("I64");
    if w8a {
        return 8;
    } else {
    }
    let w8b: bool = tok.bytes_eq("U64");
    if w8b {
        return 8;
    } else {
    }
    let w8c: bool = tok.bytes_eq("F64");
    if w8c {
        return 8;
    } else {
    }
    let w0: bool = tok.bytes_eq("Unit");
    if w0 {
        return 0;
    } else {
    }
    return 4;
}

fn cv_ty_known(tok: str) -> bool {
    if tok.bytes_eq("I32") { return true; } else {}
    if tok.bytes_eq("U32") { return true; } else {}
    if tok.bytes_eq("I64") { return true; } else {}
    if tok.bytes_eq("U64") { return true; } else {}
    if tok.bytes_eq("F64") { return true; } else {}
    if tok.bytes_eq("Bool") { return true; } else {}
    if tok.bytes_eq("Ptr") { return true; } else {}
    return tok.bytes_eq("Unit");
}

// SH-AIR-CV-3: a type-annotation node's RECORD identity — the rdefs index when the topcode is a
// record/enum code (>= TC_REC_BASE; enums share the space — their empty fnames make any field
// lookup fail loud), else -1.
fn cv_rec_of_typenode(nodes: Arena<PNode>, kids: Vec<i64>, tid: i64, rdefs: Vec<TcRec>) -> i64 {
    if tid < 0 {
        return 0 - 1;
    } else {
    }
    let code: i64 = tc_type_topcode(nodes, kids, tid, rdefs);
    if code >= TC_REC_BASE {
        return code - TC_REC_BASE;
    } else {
    }
    // AG6-3: a child-bearing generic-ENUM instance annotation (`Option<str>`) — tc_type_topcode
    // returns UNHANDLED for the targ-bearing node (records are pre-rewritten to a bare mangle by
    // mn_expand_records so never reach here; enums are NOT rewritten, keeping the targ child that
    // the match's `elem` lens needs). Resolve to the (generic) enum's rdef index so a generic-enum
    // method receiver (cv_recv_rec) AND a match-on-self both resolve instead of poisoning. is_enum-
    // gated: a stray child-bearing RECORD annotation still returns -1 (its per-instance field
    // layout would be wrong from the generic def) — byte-unchanged, since it returned -1 before too.
    let tn: PNode = nodes.get(tid);
    if tn.kind == P_K_TYPE {
        if tn.child_count > 0 {
            let bcode: i64 = tc_code_of_name(tn.text, rdefs);
            if bcode >= TC_REC_BASE {
                let bidx: i64 = bcode - TC_REC_BASE;
                let brec: TcRec = rdefs.get(bidx);
                if brec.is_enum {
                    return bidx;
                } else {
                }
            } else {
            }
        } else {
        }
    } else {
    }
    return 0 - 1;
}

// SH-AIR-CV-3: a TC type CODE -> the airtype token (the code-level twin of ai_airtype_of_typenode's
// mapping; every composite collapses to Ptr via lower_type).
fn cv_tcode_tok(code: i64) -> str {
    if code == TC_T_UNIT {
        return "Unit";
    } else {
    }
    if code == TC_T_BOOL {
        return "Bool";
    } else {
    }
    if code == TC_T_I32 {
        return "I32";
    } else {
    }
    if code == TC_T_U32 {
        return "U32";
    } else {
    }
    if code == TC_T_I64 {
        return "I64";
    } else {
    }
    if code == TC_T_U64 {
        return "U64";
    } else {
    }
    if code == TC_T_F64 {
        return "F64";
    } else {
    }
    if code == TC_T_STR {
        return "Ptr";
    } else {
    }
    if code == TC_T_ARRAY {
        return "Ptr";
    } else {
    }
    if code == TC_T_REF {
        return "Ptr";
    } else {
    }
    if code == TC_T_SLICE {
        return "Ptr";
    } else {
    }
    if code == TC_T_TUPLE {
        return "Ptr";
    } else {
    }
    if code >= TC_REC_BASE {
        return "Ptr";
    } else {
    }
    return "?";
}

// SH-AIR-CV-3: the field OFFSET — cumulative decl-order widths over rdefs fnames/ftags
// (air.rs:728). -1 = the field is not on the record (fails loud).
fn cv_field_off(rdefs: Vec<TcRec>, ridx: i64, fname: str) -> i64 {
    let rec: TcRec = rdefs.get(ridx);
    let n: i64 = rec.fnames.len();
    let mut off: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        let fn2: str = rec.fnames.get(i);
        let eq: bool = fn2.bytes_eq(fname);
        if eq {
            return off;
        } else {
        }
        let ft: i64 = rec.ftags.get(i);
        let ftok: str = cv_tcode_tok(ft);
        off = off + cv_ty_width(ftok);
        i = i + 1;
    }
    return 0 - 1;
}

// SH-AIR-CV-3: the field's airtype token ("?" = not found — poisons loud).
fn cv_field_tok(rdefs: Vec<TcRec>, ridx: i64, fname: str) -> str {
    let rec: TcRec = rdefs.get(ridx);
    let n: i64 = rec.fnames.len();
    let mut i: i64 = 0;
    while i < n {
        let fn2: str = rec.fnames.get(i);
        let eq: bool = fn2.bytes_eq(fname);
        if eq {
            let ft: i64 = rec.ftags.get(i);
            return cv_tcode_tok(ft);
        } else {
        }
        i = i + 1;
    }
    return "?";
}

// SH-AIR-CV-3: the enum cell size — 4 (the i32 tag) + the max variant payload width
// (air.rs:1097-1124; vstarts/vcounts index the flat vptags).
fn cv_enum_total_size(rdefs: Vec<TcRec>, ridx: i64) -> i64 {
    let rec: TcRec = rdefs.get(ridx);
    let nv: i64 = rec.vnames.len();
    let mut maxp: i64 = 0;
    let mut v: i64 = 0;
    while v < nv {
        let vs: i64 = rec.vstarts.get(v);
        let vc: i64 = rec.vcounts.get(v);
        let mut pw: i64 = 0;
        let mut k2: i64 = 0;
        while k2 < vc {
            let pt: i64 = rec.vptags.get(vs + k2);
            let ptok: str = cv_tcode_tok(pt);
            pw = pw + cv_ty_width(ptok);
            k2 = k2 + 1;
        }
        if pw > maxp {
            maxp = pw;
        } else {
        }
        v = v + 1;
    }
    return 4 + maxp;
}

// Exact instance size from one width per declared type parameter. A negative width means the
// caller could not resolve that parameter, so the result is 0 and the constructor must poison.
fn cv_enum_size_with_widths(rdefs: Vec<TcRec>, ridx: i64, widths: Vec<i64>) -> i64 {
    let rec: TcRec = rdefs.get(ridx);
    let ntp: i64 = rec.tpnames.len();
    if ntp == 0 {
        return 0;
    } else {
    }
    if widths.len() != ntp {
        return 0;
    } else {
    }
    let mut wi: i64 = 0;
    while wi < ntp {
        if widths.get(wi) < 0 {
            return 0;
        } else {
        }
        wi = wi + 1;
    }
    let nv: i64 = rec.vnames.len();
    let mut maxp: i64 = 0;
    let mut v: i64 = 0;
    while v < nv {
        let vs: i64 = rec.vstarts.get(v);
        let vc: i64 = rec.vcounts.get(v);
        let mut pw: i64 = 0;
        let mut k2: i64 = 0;
        while k2 < vc {
            let ptp: i64 = rec.vptp.get(vs + k2);
            if ptp >= 0 {
                if ptp >= ntp {
                    return 0;
                } else {
                }
                pw = pw + widths.get(ptp);
            } else {
                let pt: i64 = rec.vptags.get(vs + k2);
                let ptok: str = cv_tcode_tok(pt);
                pw = pw + cv_ty_width(ptok);
            }
            k2 = k2 + 1;
        }
        if pw > maxp {
            maxp = pw;
        } else {
        }
        v = v + 1;
    }
    return 4 + maxp;
}

// AG6-6/SR-010: resolve every generic-enum type argument from an expected type node. This is
// deliberately all-parameter, unlike the old `elem` side channel, so Result<T,E>-shaped enums
// cannot silently fall back to the generic definition's placeholder widths.
fn cv_enum_inst_size(nodes: Arena<PNode>, kids: Vec<i64>, rdefs: Vec<TcRec>, ridx: i64, tid: i64) -> i64 ! { Alloc } {
    if tid < 0 {
        return 0;
    } else {
    }
    let rec: TcRec = rdefs.get(ridx);
    let ntp: i64 = rec.tpnames.len();
    let tn: PNode = nodes.get(tid);
    if ntp == 0 {
        return 0;
    } else {
    }
    if tn.child_count != ntp {
        return 0;
    } else {
    }
    let mut widths: Vec<i64> = Vec::new();
    let mut i: i64 = 0;
    while i < ntp {
        let atid: i64 = kids.get(tn.child_start + i);
        let tok: str = ai_airtype_of_typenode(nodes, kids, atid, rdefs);
        if cv_ty_known(tok) {
            let qw: i64 = widths.push(cv_ty_width(tok));
        } else {
            let qw0: i64 = widths.push(0 - 1);
        }
        i = i + 1;
    }
    return cv_enum_size_with_widths(rdefs, ridx, widths);
}

// SH-AIR-CV-3: the FuncId — the name's index in the decl-order free-fn registry (-1 = unknown).
fn cv_fid_find(fids: Vec<str>, name: str) -> i64 {
    let n: i64 = fids.len();
    let nl: i64 = name.len();
    let mut i: i64 = 0;
    while i < n {
        let f: str = fids.get(i);
        // bytes_eq compares lengths first; testing them here saves the call per miss.
        if f.len() == nl {
            if f.bytes_eq(name) {
                return i;
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

// SH-AIR-CV-3: the callee's ret token via TcSig.ret ("?" = unknown callee — poisons loud).
fn cv_sig_ret_tok(sigs: Vec<TcSig>, name: str) -> str {
    let idx: i64 = tc_sig_find(sigs, name);
    if idx >= 0 {
    } else {
        return "?";
    }
    let sig: TcSig = sigs.get(idx);
    // W-TUPLE: a COMPOSITE return rides ret_detail with ret = TC_T_UNIT (PR-5i) — the
    // VALUE is the aggregate POINTER (the oracle's Call{dst: Some}). Without this the
    // call emits dst=-1 (the Unit convention) and the W arm taints defensively.
    if sig.ret == TC_T_UNIT {
        if sig.ret_detail.len() > 0 {
            return "Ptr";
        } else {
        }
    } else {
    }
    return cv_tcode_tok(sig.ret);
}

// SH-AIR-CV-2: the for-in element type token — walk the fn's P_K_PARAM children for the iterable's
// name; its type node must be a P_K_TYPE_ARRAY whose single child is the elem type. "" = not an
// array-annotated param (a local-array iterable is CV-4; the caller poisons — AG-CV2-LOCALARR).
fn cv_forin_elem_ty(nodes: Arena<PNode>, kids: Vec<i64>, fnid: i64, itername: str, rdefs: Vec<TcRec>) -> str ! { Alloc } {
    let fnode: PNode = nodes.get(fnid);
    let mut pi: i64 = 0;
    while pi < fnode.child_count {
        let pcid: i64 = kids.get(fnode.child_start + pi);
        let pcn: PNode = nodes.get(pcid);
        if pcn.kind == P_K_PARAM {
            let nm: bool = pcn.text.bytes_eq(itername);
            if nm {
                if pcn.child_count >= 1 {
                    let ptid: i64 = kids.get(pcn.child_start);
                    let ptn: PNode = nodes.get(ptid);
                    if ptn.kind == P_K_TYPE_ARRAY {
                        let elid: i64 = kids.get(ptn.child_start);
                        return ai_airtype_of_typenode(nodes, kids, elid, rdefs);
                    } else {
                    }
                } else {
                }
                return "";
            } else {
            }
        } else {
        }
        pi = pi + 1;
    }
    return "";
}

// SH-AIR-CV-2: serialize ONE terminator (the harness cv_render_term mirror).
fn cv_ser_term(term: i64, ta: i64, tb: i64, tc2: i64, tm: i64) -> str ! { Alloc } {
    let mut ps: Vec<str> = Vec::new();
    if term == CVT_RET_NONE {
        let q0: i64 = ps.push("Ret");
    } else {
        if term == CVT_RET_SOME {
            let ra: str = cv_i64_str(ta);
            let q1: i64 = ps.push("Ret v");
            let q2: i64 = ps.push(ra);
        } else {
            if term == CVT_JMP {
                let ja: str = cv_i64_str(ta);
                let q3: i64 = ps.push("Jmp b");
                let q4: i64 = ps.push(ja);
            } else {
                if term == CVT_LOOP {
                    let la: str = cv_i64_str(ta);
                    let lb: str = cv_i64_str(tb);
                    let lc: str = cv_i64_str(tc2);
                    let q5: i64 = ps.push("Loop v");
                    let q6: i64 = ps.push(la);
                    let q7: i64 = ps.push(" b");
                    let q8: i64 = ps.push(lb);
                    let q9: i64 = ps.push(" b");
                    let q10: i64 = ps.push(lc);
                } else {
                    if term == CVT_BR {
                        let ba: str = cv_i64_str(ta);
                        let bb: str = cv_i64_str(tb);
                        let bc: str = cv_i64_str(tc2);
                        let q11: i64 = ps.push("Br v");
                        let q12: i64 = ps.push(ba);
                        let q13: i64 = ps.push(" b");
                        let q14: i64 = ps.push(bb);
                        let q15: i64 = ps.push(" b");
                        let q16: i64 = ps.push(bc);
                        if tm >= 0 {
                            let bm: str = cv_i64_str(tm);
                            let q17: i64 = ps.push(" m=b");
                            let q18: i64 = ps.push(bm);
                        } else {
                            let q19: i64 = ps.push(" m=_");
                        }
                    } else {
                        if term == CVT_DISP {
                            let da: str = cv_i64_str(ta);
                            let db: str = cv_i64_str(tb);
                            let q20: i64 = ps.push("Disp b");
                            let q21: i64 = ps.push(da);
                            let q22: i64 = ps.push(" b");
                            let q23: i64 = ps.push(db);
                        } else {
                            if term == CVT_UNR {
                                let q24: i64 = ps.push("Unr");
                            } else {
                                let q25: i64 = ps.push("!TERM");
                            }
                        }
                    }
                }
            }
        }
    }
    let glue: str = "";
    return glue.join(ps);
}

// SH-AIR-CV-4: the index BOUNDS-CHECK chain for a NON-literal index (a literal index is
// bounds_proven — the #442 elision skips the whole chain WITHOUT allocating): the len load, the
// I64/U64 wrap, the GtEq compare, and the trap. The LD/SD afterwards index by the ORIGINAL var.
// An I32 index is copied into a fresh U32 where an 8-byte one wraps (the oracle's
// index_for_bounds_check), so the compare is unsigned and a negative index traps.
fn cv_index_check(nodes: Arena<PNode>, kids: Vec<i64>, idxid: i64, idxv: i64, arrv: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let ln: i64 = cv_fresh("U32", base, locals);
    let qlf: i64 = stmts.push(CvStmt { kind: CVS_LF2, a: ln, b: arrv, c: 0, d: 0, s: "U32" });
    let idty: str = cv_expr_tytok(nodes, kids, idxid, env, rdefs, sigs, cnames, cvals);
    let mut cmpv: i64 = idxv;
    let w64a: bool = idty.bytes_eq("I64");
    let w64b: bool = idty.bytes_eq("U64");
    let mut w64: bool = w64a;
    if w64b {
        w64 = true;
    } else {
    }
    if w64 {
        let wv: i64 = cv_fresh("U32", base, locals);
        let qw: i64 = stmts.push(CvStmt { kind: CVS_WRAP, a: wv, b: idxv, c: 0, d: 0, s: "" });
        cmpv = wv;
    } else {
    }
    if idty.bytes_eq("I32") {
        let cv: i64 = cv_fresh("U32", base, locals);
        let qcv: i64 = stmts.push(CvStmt { kind: CVS_AS_VAR, a: cv, b: idxv, c: 0, d: 0, s: "" });
        cmpv = cv;
    }
    let oob: i64 = cv_fresh("Bool", base, locals);
    let qb: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: oob, b: cmpv, c: T_GTEQ, d: ln, s: "" });
    let qt: i64 = stmts.push(CvStmt { kind: CVS_TRAP, a: oob, b: 0, c: 0, d: 0, s: "" });
    return 0;
}

// W-ELEM: the element token for a vec_load call node — recovered from the Vec<T> WITNESS
// (the 4th intrinsic arg; vec.sigil's designed elem channel: "the element type is recovered
// at each access from the Vec<T> witness"). The witness must be a bare path bound in env as
// a cloned `Vec__{elem}` record; the elem mangle classifies into the CLOSED set
// {i64 -> I64, str -> Ptr, rdefs-known record -> Ptr} (X-WE1). Anything else (narrow ints,
// bool, f64, unknown) returns "?" and the CALLER poisons — fail-closed, never a defaulted
// width. The slot STRIDE stays 8 regardless (X-WE3); only the access width follows the token.
fn cv_vec_elem_tok(nodes: Arena<PNode>, kids: Vec<i64>, eid: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>) -> str {
    let n: PNode = nodes.get(eid);
    if n.child_count == 4 {
    } else {
        return "?";
    }
    let wid: i64 = kids.get(n.child_start + 3);
    let wn: PNode = nodes.get(wid);
    if wn.kind == P_K_PATH {
    } else {
        return "?";
    }
    let wcc: i64 = tc_last_colons(wn.text);
    if wcc < 0 {
    } else {
        return "?";
    }
    let ridx: i64 = cv_env_rec(env, wn.text);
    if ridx >= 0 {
    } else {
        return "?";
    }
    let rec: TcRec = rdefs.get(ridx);
    // bind the field to a bare $str local FIRST — a field-receiver str method is itself
    // outside the W-emit surface (the W-STR-FIELD lesson: the shadow must self-compile).
    let rname: str = rec.name;
    let rlen: i64 = rname.len();
    if rlen > 5 {
    } else {
        return "?";
    }
    let pref: str = rname.substr(0, 5);
    let prok: bool = pref.bytes_eq("Vec__");
    if prok {
    } else {
        return "?";
    }
    let elem: str = rname.substr(5, rlen);
    let isi64: bool = elem.bytes_eq("i64");
    if isi64 {
        return "I64";
    } else {
    }
    // W-VECBOOL: bool elems are i32-CLASS (probe-pinned: plain i32 load/store align-2 at
    // slot stride 8 — NO byte-width ops; the instance fn types carry i32). The wa
    // fall-through already maps Bool -> 0x28/0x36 + align 2; only this gate was missing.
    let isbool: bool = elem.bytes_eq("bool");
    if isbool {
        return "Bool";
    } else {
    }
    let isstr: bool = elem.bytes_eq("str");
    if isstr {
        return "Ptr";
    } else {
    }
    // a known record elem (incl. a nested Vec__.. instance) is a heap pointer.
    let nrec: i64 = rdefs.len();
    let mut i: i64 = 0;
    while i < nrec {
        let cand: TcRec = rdefs.get(i);
        let cname: str = cand.name;
        let ceq: bool = cname.bytes_eq(elem);
        if ceq {
            return "Ptr";
        } else {
        }
        i = i + 1;
    }
    return "?";
}

// B-VEC: the intrinsic emitter (no user sig/fid): the memory intrinsics every stdlib Vec method
// body calls (alloc / vec_load / vec_store), the byte intrinsics (store8, load8), str_from_raw,
// and the constant-time ct_eq / ct_lt / ct_select. Returns the dst var; or 0, the safe var,
// after pushing POISON for one of these it refuses (a wrong argument count, or a width it cannot
// type), so a refused intrinsic never falls through to a same-named user fn; or -2 when the
// callee is none of them (the caller falls through to the fid path). dstgiven >= 0 = the into-dst
// arm's target; else a fresh dst (X6: dst BEFORE args). Sequences mirror the oracle exactly
// (air.rs:2458-2556 + emit_vec_bound_trap): args materialize in order; the bound trap =
// wrap(idx), wrap(bound), GtEq, TrapIf; the i64 buf wraps to a Ptr base; elem_size 8, memarg
// offset 0 (header-less — the LD0/SD0 kinds). W-ELEM: the ACCESS width follows the element
// token (i64 elems -> i64 ops; record/str elems -> Ptr, i32 ops + i32 locals — the oracle's
// lower_type rule); the slot stride stays 8. Narrow elems (Vec<bool>/i32) POISON loud.
// SHP-5c-3: does a `region` named `name` enclose node `eid`? An arena scan, paid only on the
// path a bound name has already missed.
fn cv_region_name_encloses(nodes: Arena<PNode>, eid: i64, name: str) -> bool {
    let total: i64 = nodes.len();
    let mut i: i64 = 0;
    while i < total {
        let mn: PNode = nodes.get(i);
        if mn.kind == P_K_REGION {
            if mn.text.bytes_eq(name) {
                if rf_contains(nodes, i, eid) {
                    return true;
                }
            }
        }
        i = i + 1;
    }
    return false;
}

// SHP-5c-3: the slot intrinsics — the oracle's SlotNew / SlotPut / SlotTake (air.rs, the
// Intrinsic arm). The dst freshes BEFORE the operands (X6); `slot_put`'s Unit dst then takes
// the oracle's placeholder `Assign dst IntLit(0)` after the statement. Fails closed: a
// `slot_new` with other than one type argument naming a declared cap type, or with arguments;
// an operand or dst that is not a pointer-typed local (a slot, a cap); a `slot_put`/`slot_take`
// carrying type arguments (no intrinsic in the oracle; the type checker refuses it first).
fn cv_emit_slotintr(nodes: Arena<PNode>, kids: Vec<i64>, dstgiven: i64, eid: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(eid);
    let issn: bool = n.text.bytes_eq("slot_new");
    if issn {
        let snargs: i64 = n.child_count - n.flags;
        let mut snok: bool = n.flags == 1;
        if snargs != 0 {
            snok = false;
        }
        if snok {
            let sntn: PNode = nodes.get(kids.get(n.child_start));
            if sntn.kind != P_K_TYPE {
                snok = false;
            }
            let sncap: str = tc_seg_at(sntn.text, 0);
            let sndecl: str = ai_cap_decl_text(nodes, sncap);
            if sndecl.len() == 0 {
                snok = false;
            }
        }
        if !snok {
            let qsn0: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            return 0;
        }
        let mut snd: i64 = dstgiven;
        if snd < 0 {
            snd = cv_fresh("Ptr", base, locals);
        }
        let sndt: str = cv_built_var_tok(snd, base, env, locals);
        let sndok: bool = sndt.bytes_eq("Ptr");
        if !sndok {
            let qsn1: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        }
        let qsn2: i64 = stmts.push(CvStmt { kind: CVS_SLOTNEW, a: snd, b: 0, c: 0, d: 0, s: "" });
        return snd;
    }
    let issp: bool = n.text.bytes_eq("slot_put");
    if issp {
        let mut spok: bool = n.flags == 0;
        if n.child_count != 2 {
            spok = false;
        }
        if !spok {
            let qsp0: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            return 0;
        }
        let mut spd: i64 = dstgiven;
        if spd < 0 {
            spd = cv_fresh("Unit", base, locals);
        }
        let sps: i64 = cv_to_var(nodes, kids, kids.get(n.child_start), base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        let spc: i64 = cv_to_var(nodes, kids, kids.get(n.child_start + 1), base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        let spst: str = cv_built_var_tok(sps, base, env, locals);
        let spct: str = cv_built_var_tok(spc, base, env, locals);
        let spdt: str = cv_built_var_tok(spd, base, env, locals);
        let mut spt: bool = spst.bytes_eq("Ptr");
        if !spct.bytes_eq("Ptr") {
            spt = false;
        }
        if !spdt.bytes_eq("Unit") {
            spt = false;
        }
        if !spt {
            let qsp1: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        }
        let qsp2: i64 = stmts.push(CvStmt { kind: CVS_SLOTPUT, a: sps, b: spc, c: 0, d: 0, s: "" });
        let qsp3: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: spd, b: 0, c: 0, d: 0, s: "" });
        return spd;
    }
    let isst: bool = n.text.bytes_eq("slot_take");
    if isst {
        let mut stok: bool = n.flags == 0;
        if n.child_count != 1 {
            stok = false;
        }
        if !stok {
            let qst0: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            return 0;
        }
        let mut std: i64 = dstgiven;
        if std < 0 {
            std = cv_fresh("Ptr", base, locals);
        }
        let sts: i64 = cv_to_var(nodes, kids, kids.get(n.child_start), base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        let stst: str = cv_built_var_tok(sts, base, env, locals);
        let stdt: str = cv_built_var_tok(std, base, env, locals);
        let mut stt: bool = stst.bytes_eq("Ptr");
        if !stdt.bytes_eq("Ptr") {
            stt = false;
        }
        if !stt {
            let qst1: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        }
        let qst2: i64 = stmts.push(CvStmt { kind: CVS_SLOTTAKE, a: std, b: sts, c: 0, d: 0, s: "" });
        return std;
    }
    return 0 - 2;
}

fn cv_emit_vecintr(nodes: Arena<PNode>, kids: Vec<i64>, dstgiven: i64, eid: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(eid);
    // SHP-5c-3: the slot intrinsics dispatch first (cv_emit_slotintr; -2 = not one of them).
    let slr: i64 = cv_emit_slotintr(nodes, kids, dstgiven, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
    if slr >= 0 {
        return slr;
    }
    let isal: bool = n.text.bytes_eq("alloc");
    let isld: bool = n.text.bytes_eq("vec_load");
    let isst: bool = n.text.bytes_eq("vec_store");
    // W-STR-B: store8(ptr, byte) — the string-builder byte write (IntrinsicStore8).
    let is8: bool = n.text.bytes_eq("store8");
    if is8 {
        if n.child_count != 2 {
            let q8p: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            return 0;
        }
        let p8id: i64 = kids.get(n.child_start);
        let v8id: i64 = kids.get(n.child_start + 1);
        let p8: i64 = cv_to_var(nodes, kids, p8id, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        let v8: i64 = cv_to_var(nodes, kids, v8id, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        let q8: i64 = stmts.push(CvStmt { kind: CVS_ST8, a: p8, b: v8, c: 0, d: 0, s: "" });
        // NO dst-assign (the pin: IntrinsicStore8 alone); the expr-stmt walker's phantom
        // Unit dst (dstgiven) is returned unreferenced, mirroring the oracle's skipped local.
        if dstgiven >= 0 {
            return dstgiven;
        } else {
        }
        let d8: i64 = cv_fresh("Unit", base, locals);
        return d8;
    } else {
    }
    // SHP-1: load8(ptr), the user byte read (the oracle's IntrinsicLoad8). The I64 dst freshes
    // BEFORE the pointer materializes (X6, the oracle's dst-before-args); CVS_LD8 wraps an 8-byte
    // pointer to i32 before i32.load8_u. Fails closed: a pointer token that is not an integer, or
    // a dst that is not I64, is refused rather than loaded at a guessed width.
    let isl8: bool = n.text.bytes_eq("load8");
    if isl8 {
        if n.child_count == 1 {
            let mut l8d: i64 = dstgiven;
            if l8d < 0 {
                l8d = cv_fresh("I64", base, locals);
            }
            let l8id: i64 = kids.get(n.child_start);
            let l8p: i64 = cv_to_var(nodes, kids, l8id, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            let l8pt: str = cv_built_var_tok(l8p, base, env, locals);
            let l8dt: str = cv_built_var_tok(l8d, base, env, locals);
            let l8pok: bool = cv_tok_is_int(l8pt);
            let l8dok: bool = l8dt.bytes_eq("I64");
            if !l8pok {
                let ql8p: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            }
            if !l8dok {
                let ql8d: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            }
            let ql8: i64 = stmts.push(CvStmt { kind: CVS_LD8, a: l8d, b: l8p, c: 0, d: 0, s: "" });
            return l8d;
        }
        let qa8: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    }
    // SHP-1: the constant-time intrinsics (the oracle's IntrinsicCtEq, IntrinsicCtLt and
    // IntrinsicCtSelect). The dst freshes BEFORE the operands (X6), which lower in source order.
    // Production applies i64 opcodes to the operands as given, so a 4-byte operand yields a module
    // that does not validate: an operand that is not 8 bytes wide, a select condition that is not
    // Bool, or a dst of any other type is refused. ct_lt also needs one signedness (below).
    let isce: bool = n.text.bytes_eq("ct_eq");
    let iscl: bool = n.text.bytes_eq("ct_lt");
    let mut isc2: bool = isce;
    if iscl {
        isc2 = true;
    }
    if isc2 {
        if n.child_count == 2 {
            let mut c2d: i64 = dstgiven;
            if c2d < 0 {
                c2d = cv_fresh("Bool", base, locals);
            }
            let c2lid: i64 = kids.get(n.child_start);
            let c2l: i64 = cv_to_var(nodes, kids, c2lid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            let c2rid: i64 = kids.get(n.child_start + 1);
            let c2r: i64 = cv_to_var(nodes, kids, c2rid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            let c2lt: str = cv_built_var_tok(c2l, base, env, locals);
            let c2rt: str = cv_built_var_tok(c2r, base, env, locals);
            let c2dt: str = cv_built_var_tok(c2d, base, env, locals);
            let c2lok: bool = cv_tok_is_wide_int(c2lt);
            let c2rok: bool = cv_tok_is_wide_int(c2rt);
            let c2dok: bool = c2dt.bytes_eq("Bool");
            if !c2lok {
                let qc2l: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            }
            if !c2rok {
                let qc2r: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            }
            if !c2dok {
                let qc2d: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            }
            let mut c2k: i64 = CVS_CTEQ;
            let mut c2u: i64 = 0;
            if iscl {
                // ct_lt's order is its operands' signedness, the oracle's `unsigned` flag: d = 1
                // for two U64, 0 for two I64. Production checks a literal beside a u64 as a u64,
                // but a literal lowers to an I64 local here, so the seed refuses that pair with
                // every other mixed one rather than pick an order.
                c2k = CVS_CTLT;
                let mut c2lu: i64 = 0;
                if c2lt.bytes_eq("U64") {
                    c2lu = 1;
                }
                let mut c2ru: i64 = 0;
                if c2rt.bytes_eq("U64") {
                    c2ru = 1;
                }
                if c2lu != c2ru {
                    let qc2m: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                }
                c2u = c2lu;
            }
            let qc2: i64 = stmts.push(CvStmt { kind: c2k, a: c2d, b: c2l, c: c2r, d: c2u, s: "" });
            return c2d;
        }
        let qa2: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    }
    let iscs: bool = n.text.bytes_eq("ct_select");
    if iscs {
        if n.child_count == 3 {
            let mut c3d: i64 = dstgiven;
            if c3d < 0 {
                c3d = cv_fresh("I64", base, locals);
            }
            let c3cid: i64 = kids.get(n.child_start);
            let c3c: i64 = cv_to_var(nodes, kids, c3cid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            let c3tid: i64 = kids.get(n.child_start + 1);
            let c3t: i64 = cv_to_var(nodes, kids, c3tid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            let c3eid: i64 = kids.get(n.child_start + 2);
            let c3e: i64 = cv_to_var(nodes, kids, c3eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            let c3ct: str = cv_built_var_tok(c3c, base, env, locals);
            let c3tt: str = cv_built_var_tok(c3t, base, env, locals);
            let c3et: str = cv_built_var_tok(c3e, base, env, locals);
            let c3dt: str = cv_built_var_tok(c3d, base, env, locals);
            let c3cok: bool = c3ct.bytes_eq("Bool");
            let c3tok: bool = cv_tok_is_wide_int(c3tt);
            let c3eok: bool = cv_tok_is_wide_int(c3et);
            let c3dok: bool = c3dt.bytes_eq("I64");
            if !c3cok {
                let qc3c: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            }
            if !c3tok {
                let qc3t: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            }
            if !c3eok {
                let qc3e: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            }
            if !c3dok {
                let qc3d: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            }
            let qc3: i64 = stmts.push(CvStmt { kind: CVS_CTSEL, a: c3d, b: c3c, c: c3t, d: c3e, s: "" });
            return c3d;
        }
        let qa3: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    }
    // W-STRRAW: str_from_raw(ptr, len) -> a FRESH 8-byte str header (data_ptr @0, len @4),
    // mirroring the string-LITERAL header (cv_emit_string) but with RUNTIME ptr/len. The
    // stdlib always passes i64 args (alloc's result + an i64 length), so each wraps to U32
    // directly (the oracle's zero-extend branch is for narrow args, never emitted by the
    // stdlib). ORDER (X6 + air.rs:3082): dst first, args materialize, then wrap-ptr, wrap-len,
    // BumpAlloc(dst,8,4), store ptr@0, store len@4.
    let isfr: bool = n.text.bytes_eq("str_from_raw");
    if isfr {
        if n.child_count == 2 {
            let mut dst: i64 = dstgiven;
            if dst < 0 {
                dst = cv_fresh("Ptr", base, locals);
            } else {
            }
            let p0id: i64 = kids.get(n.child_start);
            let a0: i64 = cv_to_var(nodes, kids, p0id, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            let l0id: i64 = kids.get(n.child_start + 1);
            let a1: i64 = cv_to_var(nodes, kids, l0id, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            let dpu: i64 = cv_fresh("U32", base, locals);
            let qfw1: i64 = stmts.push(CvStmt { kind: CVS_WRAP, a: dpu, b: a0, c: 0, d: 0, s: "" });
            let lnu: i64 = cv_fresh("U32", base, locals);
            let qfw2: i64 = stmts.push(CvStmt { kind: CVS_WRAP, a: lnu, b: a1, c: 0, d: 0, s: "" });
            let qfba: i64 = stmts.push(CvStmt { kind: CVS_BA, a: dst, b: 8, c: 4, d: 0, s: "" });
            let qfs1: i64 = stmts.push(CvStmt { kind: CVS_SF, a: dst, b: dpu, c: 0, d: 0, s: "U32" });
            let qfs2: i64 = stmts.push(CvStmt { kind: CVS_SF, a: dst, b: lnu, c: 4, d: 0, s: "U32" });
            return dst;
        } else {
        }
        let qafr: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    } else {
    }
    if isal {
        if n.child_count == 1 {
            let mut dst: i64 = dstgiven;
            if dst < 0 {
                dst = cv_fresh("I64", base, locals);
            } else {
            }
            let a0id: i64 = kids.get(n.child_start);
            let a0: i64 = cv_to_var(nodes, kids, a0id, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            let qi: i64 = stmts.push(CvStmt { kind: CVS_IALLOC, a: dst, b: a0, c: 0, d: 0, s: "" });
            return dst;
        } else {
        }
        let qaal: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    } else {
    }
    let mut isvec: bool = isld;
    if isst {
        isvec = true;
    } else {
    }
    if isvec {
        if n.child_count == 4 {
            // W-ELEM: the elem token (load: from the witness, the 4th arg; store: from the
            // VALUE's env binding — the store signature carries no witness, but its value is
            // always the bare `val`/`e` path in vec.sigil). "?"/unbound is fail-closed
            // POISON — never a defaulted width (X-WE1/X-WE2).
            let mut etok: str = "?";
            if isld {
                etok = cv_vec_elem_tok(nodes, kids, eid, env, rdefs);
            } else {
                let vvid: i64 = kids.get(n.child_start + 3);
                let vvn: PNode = nodes.get(vvid);
                if vvn.kind == P_K_PATH {
                    let vvcc: i64 = tc_last_colons(vvn.text);
                    if vvcc < 0 {
                        etok = cv_env_tytok(env, vvn.text);
                    } else {
                    }
                } else {
                }
            }
            let mut eunk: bool = etok.bytes_eq("?");
            let e0: bool = etok.bytes_eq("");
            if e0 {
                eunk = true;
            } else {
            }
            if eunk {
                let qep: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                return 0;
            } else {
            }
            let mut dst: i64 = dstgiven;
            if dst < 0 {
                if isld {
                    dst = cv_fresh(etok, base, locals);
                } else {
                    dst = cv_fresh("Unit", base, locals);
                }
            } else {
            }
            let b0id: i64 = kids.get(n.child_start);
            let a0: i64 = cv_to_var(nodes, kids, b0id, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            let b1id: i64 = kids.get(n.child_start + 1);
            let a1: i64 = cv_to_var(nodes, kids, b1id, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            let b2id: i64 = kids.get(n.child_start + 2);
            let a2: i64 = cv_to_var(nodes, kids, b2id, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            let b3id: i64 = kids.get(n.child_start + 3);
            let a3: i64 = cv_to_var(nodes, kids, b3id, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            let w1: i64 = cv_fresh("U32", base, locals);
            let qw1: i64 = stmts.push(CvStmt { kind: CVS_WRAP, a: w1, b: a1, c: 0, d: 0, s: "" });
            let w2: i64 = cv_fresh("U32", base, locals);
            let qw2: i64 = stmts.push(CvStmt { kind: CVS_WRAP, a: w2, b: a2, c: 0, d: 0, s: "" });
            let oob: i64 = cv_fresh("Bool", base, locals);
            let qb: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: oob, b: w1, c: T_GTEQ, d: w2, s: "" });
            let qt: i64 = stmts.push(CvStmt { kind: CVS_TRAP, a: oob, b: 0, c: 0, d: 0, s: "" });
            let bp: i64 = cv_fresh("Ptr", base, locals);
            let qbp: i64 = stmts.push(CvStmt { kind: CVS_WRAP, a: bp, b: a0, c: 0, d: 0, s: "" });
            if isld {
                let qld: i64 = stmts.push(CvStmt { kind: CVS_LD0, a: dst, b: bp, c: a1, d: 8, s: etok });
            } else {
                let qsd: i64 = stmts.push(CvStmt { kind: CVS_SD0, a: bp, b: a3, c: a1, d: 8, s: etok });
                let qz: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: dst, b: 0, c: 0, d: 0, s: "" });
            }
            return dst;
        } else {
        }
        let qavec: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    } else {
    }
    return 0 - 2;
}

// SH-AIR-CV-4: the shared construct-body emitters (dst already chosen — to_var freshes it first,
// into receives it): the ARRAY expansion, the STRING header, the RECORD-construct Assign, and the
// ENUM ctor (unit + payload). Each mirrors the probe-pinned pre-memory shape.
// SHP-0b: `eexp` is the element token the array's slot dictates. "" when no slot dictates one
// (an unannotated let): the first element's token sets it and every element must carry it. A
// known token when the slot is an array type this lowering can read (an annotated let, a call or
// method argument, a return, a record field, an element of such an array). Any other text when a
// slot dictates an element type this lowering cannot see (an assignment, a tuple element, an enum
// payload): an element the oracle types from context alone is refused there, since the oracle
// typed it by that unseen slot. `etid` is the element type's node when the slot's is in view, or
// -1: an array or construct element is then typed by it (cv_typed_compound). Every other element
// goes through cv_slot_var against the element token, so a literal takes it and any other element
// must already carry it, except a tuple element of an unannotated array (SR-032): no slot types
// it, so its elements type themselves (cv_emit_tuple's -1), where cv_to_var would treat its slot
// as hidden. Fails closed: an element type this lowering cannot size is refused.
fn cv_emit_array(nodes: Arena<PNode>, kids: Vec<i64>, ad: i64, eid: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, eexp: str, etid: i64, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(eid);
    let cnt: i64 = n.child_count;
    if cnt == 0 {
        let qba0: i64 = stmts.push(CvStmt { kind: CVS_BA, a: ad, b: 4, c: 8, d: 0, s: "" });
        let ln0: i64 = cv_fresh("U32", base, locals);
        let ql0: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: ln0, b: 0, c: 0, d: 0, s: "" });
        let qs0: i64 = stmts.push(CvStmt { kind: CVS_SF, a: ad, b: ln0, c: 0, d: 0, s: "U32" });
        return 0;
    } else {
    }
    let el0: i64 = kids.get(n.child_start);
    let mut etok: str = eexp;
    if !cv_ty_known(eexp) {
        etok = cv_expr_tytok(nodes, kids, el0, env, rdefs, sigs, cnames, cvals);
        if eexp.len() > 0 {
            let mut li: i64 = 0;
            while li < cnt {
                let lid: i64 = kids.get(n.child_start + li);
                if cv_expr_literal_typed(nodes, kids, lid) {
                    let qpl: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                    return 0;
                }
                li = li + 1;
            }
        }
    }
    if !cv_ty_known(etok) {
        let qpk: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    }
    let ew: i64 = cv_ty_width(etok);
    let qba: i64 = stmts.push(CvStmt { kind: CVS_BA, a: ad, b: 4 + cnt * ew, c: 8, d: 0, s: "" });
    let ln: i64 = cv_fresh("U32", base, locals);
    let ql: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: ln, b: cnt, c: 0, d: 0, s: "" });
    let qs: i64 = stmts.push(CvStmt { kind: CVS_SF, a: ad, b: ln, c: 0, d: 0, s: "U32" });
    let mut ei: i64 = 0;
    while ei < cnt {
        let evid: i64 = kids.get(n.child_start + ei);
        let mut ev: i64 = cv_typed_compound(nodes, kids, evid, etid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        if ev < 0 {
            let evn: PNode = nodes.get(evid);
            let mut own: bool = false;
            if eexp.len() == 0 {
                if evn.kind == P_K_TUPLE {
                    own = etok.bytes_eq("Ptr");
                }
            }
            if own {
                ev = cv_fresh("Ptr", base, locals);
                let qot: i64 = cv_emit_tuple(nodes, kids, ev, evid, 0 - 1, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            } else {
                ev = cv_slot_var(nodes, kids, evid, etok, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            }
        }
        let qse: i64 = stmts.push(CvStmt { kind: CVS_SF, a: ad, b: ev, c: 4 + ei * ew, d: 0, s: etok });
        ei = ei + 1;
    }
    return 0;
}

// W-STR-FIELD: is `fseg` a str-typed field of `rdefs[ridx]` (ftag == TC_T_STR)? A Vec
// field also answers `.len()`, so the str-method dispatch MUST gate on the field type.
// The Vec fields bind to annotated locals FIRST (bare-receiver methods resolve post-W-MOD;
// a direct field-receiver Vec method is still outside the mn surface — the W-ELEM lesson).
fn cv_field_isstr(rdefs: Vec<TcRec>, ridx: i64, fseg: str) -> bool {
    let rec: TcRec = rdefs.get(ridx);
    let fns: Vec<str> = rec.fnames;
    let fts: Vec<i64> = rec.ftags;
    let n: i64 = fns.len();
    let mut i: i64 = 0;
    let mut found: bool = false;
    while i < n {
        let fn2: str = fns.get(i);
        if fn2.bytes_eq(fseg) {
            let ft: i64 = fts.get(i);
            found = ft == TC_T_STR;
        } else {
        }
        i = i + 1;
    }
    return found;
}

// W-STR-FIELD: the NO-EMIT receiver discriminator for the str-method emitters. Returns
// 2 = a one-hop str-typed FIELD access (`rn::text` — env-record base + TC_T_STR field),
// 1 = a bare-path $str binding (the W-STR-A shape), 0 = neither (the caller falls through
// to the record/ST-2 paths). A deeper chain misses cv_env_rec on its colon-bearing base -> 0.
fn cv_str_receiver_ok(nodes: Arena<PNode>, kids: Vec<i64>, rid: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>) -> i64 {
    let rn: PNode = nodes.get(rid);
    if rn.kind == P_K_PATH {
    } else {
        return 0;
    }
    let rtext: str = rn.text;
    let rcc: i64 = tc_last_colons(rtext);
    if rcc < 0 {
        let risstr: bool = cv_env_isstr(env, rtext);
        if risstr {
            return 1;
        } else {
            return 0;
        }
    } else {
    }
    let tlen: i64 = rtext.len();
    let fbase: str = rtext.substr(0, rcc);
    let fseg: str = rtext.substr(rcc + 2, tlen);
    let brec: i64 = cv_env_rec(env, fbase);
    if brec >= 0 {
    } else {
        return 0;
    }
    let fstr: bool = cv_field_isstr(rdefs, brec, fseg);
    if fstr {
        return 2;
    } else {
        return 0;
    }
}

// W-STR-FIELD: materialize the (already ok-gated) str receiver to its pair-pointer var.
// Bare $str -> the existing env var (NO emission); a one-hop field -> cv_to_var (the reg1
// LoadField-Ptr temp — the oracle's exact shape). The caller freshes its dst FIRST (the
// pinned order: dst, receiver, args). Returns -1 unresolvable (the caller poisons).
fn cv_str_receiver_var(nodes: Arena<PNode>, kids: Vec<i64>, rid: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let rn: PNode = nodes.get(rid);
    if rn.kind == P_K_PATH {
    } else {
        return 0 - 1;
    }
    let rtext: str = rn.text;
    let rcc: i64 = tc_last_colons(rtext);
    if rcc < 0 {
        let rv: i64 = cv_env_var(env, rtext);
        return rv;
    } else {
    }
    let fv: i64 = cv_to_var(nodes, kids, rid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
    return fv;
}

// W-STR-B: the str-method DESUGAR emitter — the five stdlib-backed methods lower to a PLAIN
// Call of the module-qualified stdlib fn with the receiver as arg0 (the oracle's tc desugar;
// Phase-0: Call{dst, FuncId, [recv, ...args]}, no wrapping). Gate: a bare-path receiver that is
// $str-sentinel (concat/bytes_eq/join/contains) or I64-token (itoa). Returns dst, or -2 when
// not a desugar method (the caller falls through).
fn cv_emit_strdesugar(nodes: Arena<PNode>, kids: Vec<i64>, dstgiven: i64, eid: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(eid);
    if n.kind == P_K_METHOD {
    } else {
        return 0 - 2;
    }
    if n.child_count >= 1 {
    } else {
        return 0 - 2;
    }
    let mut target: str = "";
    let mut rettok: str = "";
    let mut wantstr: bool = true;
    let dcc: bool = n.text.bytes_eq("concat");
    if dcc {
        target = "str_concat";
        rettok = "Ptr";
    } else {
    }
    let dbe: bool = n.text.bytes_eq("bytes_eq");
    if dbe {
        target = "str_bytes_eq";
        rettok = "Bool";
    } else {
    }
    let djn: bool = n.text.bytes_eq("join");
    if djn {
        target = "str_join";
        rettok = "Ptr";
    } else {
    }
    let dct: bool = n.text.bytes_eq("contains");
    if dct {
        target = "str_contains";
        rettok = "Bool";
    } else {
    }
    let dit: bool = n.text.bytes_eq("itoa");
    if dit {
        target = "str_itoa";
        rettok = "Ptr";
        wantstr = false;
    } else {
    }
    // Stage-3-0: `ptr.from_bytes(len)` on an i64 receiver -> `str_from_bytes(ptr, len)` (methods.rs:880).
    // The forge INPUT boundary (validates raw bytes into an Option<str>, tok Ptr). Like itoa: an I64
    // receiver + the trailing len arg the shared arg-loop appends. The other half of the with-driver
    // tool_main the selfhost never had to emit (the driver-less library has no forge entry).
    let dfb: bool = n.text.bytes_eq("from_bytes");
    if dfb {
        target = "str_from_bytes";
        rettok = "Ptr";
        wantstr = false;
    } else {
    }
    if target.len() > 0 {
    } else {
        return 0 - 2;
    }
    let rid: i64 = kids.get(n.child_start);
    // W-STR-FIELD: the wantstr methods take a bare $str binding OR a one-hop str-typed field
    // access (the ok gate is NO-EMIT); itoa stays bare-I64-only. Order: dst freshes FIRST,
    // then the receiver materializes (a field hop = the reg1 LoadField-Ptr temp), then args.
    if wantstr {
        let rok: i64 = cv_str_receiver_ok(nodes, kids, rid, env, rdefs);
        if rok > 0 {
        } else {
            return 0 - 2;
        }
    } else {
        // W-FIELDITOA: itoa takes a bare I64 binding OR a one-hop I64-typed field access
        // (`tv::value` — the parser_const/tc_emit_expr shape); mirrors the wantstr gate.
        let rn: PNode = nodes.get(rid);
        if rn.kind == P_K_PATH {
        } else {
            return 0 - 2;
        }
        let rcc: i64 = tc_last_colons(rn.text);
        if rcc < 0 {
            let rtok: str = cv_env_tytok(env, rn.text);
            let ri64: bool = rtok.bytes_eq("I64");
            if ri64 {
            } else {
                return 0 - 2;
            }
        } else {
            let rtext: str = rn.text;
            let tlen: i64 = rtext.len();
            let fbase: str = rtext.substr(0, rcc);
            let fseg: str = rtext.substr(rcc + 2, tlen);
            let brec: i64 = cv_env_rec(env, fbase);
            if brec >= 0 {
            } else {
                return 0 - 2;
            }
            let ftok: str = cv_field_tok(rdefs, brec, fseg);
            let fi64: bool = ftok.bytes_eq("I64");
            if fi64 {
            } else {
                return 0 - 2;
            }
        }
    }
    let fid: i64 = cv_fid_find(fids, target);
    if fid < 0 {
        let qpo: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0 - 1;
    } else {
    }
    // X6: dst freshes BEFORE the receiver/arg materialization (the pinned order).
    let mut dst: i64 = dstgiven;
    if dst < 0 {
        dst = cv_fresh(rettok, base, locals);
    } else {
    }
    let mut rv: i64 = 0 - 1;
    if wantstr {
        rv = cv_str_receiver_var(nodes, kids, rid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
    } else {
        // W-FIELDITOA: a field receiver materializes via cv_to_var (the reg1 LoadField-I64
        // temp) AFTER the dst freshed — the same pinned (dst, receiver, args) order.
        let rn3: PNode = nodes.get(rid);
        let rcc3: i64 = tc_last_colons(rn3.text);
        if rcc3 < 0 {
            rv = cv_env_var(env, rn3.text);
        } else {
            rv = cv_to_var(nodes, kids, rid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        }
    }
    if rv < 0 {
        let qp1: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0 - 1;
    } else {
    }
    let mut cargs: Vec<str> = Vec::new();
    let rvs: str = cv_i64_str(rv);
    let vld0: str = "v";
    let rvv: str = vld0.concat(rvs);
    let qr: i64 = cargs.push(rvv);
    let mut ai: i64 = 1;
    while ai < n.child_count {
        let aid: i64 = kids.get(n.child_start + ai);
        let av: i64 = cv_to_var(nodes, kids, aid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        let avs: str = cv_i64_str(av);
        let vld: str = "v";
        let avv: str = vld.concat(avs);
        let qa: i64 = cargs.push(avv);
        ai = ai + 1;
    }
    let asp: str = " ";
    let sargs: str = asp.join(cargs);
    let qc: i64 = stmts.push(CvStmt { kind: CVS_CALL, a: dst, b: fid, c: 0, d: 0, s: sargs });
    return dst;
}

// W-STR-A: the str-intrinsic METHOD emitter (len / byte_at / substr on a Str-token
// receiver). Returns the dst var, or -2 when not a str intrinsic (the caller falls through).
// Sequences + fresh ORDER mirror the oracle exactly (wstra_phase0_probe pins; X6 dst-first).
fn cv_emit_strintr(nodes: Arena<PNode>, kids: Vec<i64>, dstgiven: i64, eid: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(eid);
    if n.kind == P_K_METHOD {
    } else {
        return 0 - 2;
    }
    if n.child_count >= 1 {
    } else {
        return 0 - 2;
    }
    let isln: bool = n.text.bytes_eq("len");
    let isba: bool = n.text.bytes_eq("byte_at");
    let issu: bool = n.text.bytes_eq("substr");
    let isao: bool = n.text.bytes_eq("as_output");
    let mut known: bool = isln;
    if isba {
        known = true;
    } else {
    }
    if issu {
        known = true;
    } else {
    }
    if isao {
        known = true;
    } else {
    }
    if known {
    } else {
        return 0 - 2;
    }
    // W-STR-FIELD: a bare-path $str binding OR a one-hop str-typed field access (`rn::text`).
    // The gate is NO-EMIT (cv_str_receiver_ok); each arm freshes its dst FIRST, then
    // materializes the receiver (a field hop = the reg1 LoadField-Ptr temp), then the args —
    // the pinned oracle order (dst, receiver, args; wsf2 probes). Any other shape falls
    // through to the record/ST-2 paths.
    let rid: i64 = kids.get(n.child_start);
    let rok: i64 = cv_str_receiver_ok(nodes, kids, rid, env, rdefs);
    if rok > 0 {
    } else {
        return 0 - 2;
    }
    if isln {
        let mut dst: i64 = dstgiven;
        if dst < 0 {
            dst = cv_fresh("I64", base, locals);
        } else {
        }
        let rv: i64 = cv_str_receiver_var(nodes, kids, rid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        if rv < 0 {
            let qpo: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            return 0 - 1;
        } else {
        }
        let t0: i64 = cv_fresh("U32", base, locals);
        let ql: i64 = stmts.push(CvStmt { kind: CVS_LF2, a: t0, b: rv, c: 4, d: 0, s: "U32" });
        let qe: i64 = stmts.push(CvStmt { kind: CVS_EXT_U32, a: dst, b: t0, c: 0, d: 0, s: "" });
        return dst;
    } else {
    }
    if isba {
        if n.child_count >= 2 {
        } else {
            let qp1: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            return 0 - 1;
        }
        let mut dst: i64 = dstgiven;
        if dst < 0 {
            dst = cv_fresh("I64", base, locals);
        } else {
        }
        let rv: i64 = cv_str_receiver_var(nodes, kids, rid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        if rv < 0 {
            let qpb: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            return 0 - 1;
        } else {
        }
        let a0id: i64 = kids.get(n.child_start + 1);
        let a0: i64 = cv_to_var(nodes, kids, a0id, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        // SHP-0b: only an 8-byte index wraps to U32 (the oracle's StrByteAt); a U32 index is used
        // as it is (wrapping it emitted i32.wrap_i64 on an i32, a module that does not validate).
        // An I32 index is copied into a fresh U32 local, the oracle's typed copy with the bits
        // unchanged, so the bounds check compares unsigned and a negative index traps. Any other
        // token is refused.
        let a0t: str = cv_built_var_tok(a0, base, env, locals);
        let a0wide: bool = cv_tok_is_wide_int(a0t);
        let a0u32: bool = a0t.bytes_eq("U32");
        let a0i32: bool = a0t.bytes_eq("I32");
        let mut a0ok: bool = a0wide;
        if a0u32 {
            a0ok = true;
        }
        if a0i32 {
            a0ok = true;
        }
        if !a0ok {
            let qpi: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        }
        let mut w0: i64 = a0;
        if a0wide {
            w0 = cv_fresh("U32", base, locals);
            let qw: i64 = stmts.push(CvStmt { kind: CVS_WRAP, a: w0, b: a0, c: 0, d: 0, s: "" });
        }
        if a0i32 {
            w0 = cv_fresh("U32", base, locals);
            let qc0: i64 = stmts.push(CvStmt { kind: CVS_AS_VAR, a: w0, b: a0, c: 0, d: 0, s: "" });
        }
        let ln0: i64 = cv_fresh("U32", base, locals);
        let ql2: i64 = stmts.push(CvStmt { kind: CVS_LF2, a: ln0, b: rv, c: 4, d: 0, s: "U32" });
        let ob: i64 = cv_fresh("Bool", base, locals);
        let qc: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: ob, b: w0, c: T_GTEQ, d: ln0, s: "" });
        let qt: i64 = stmts.push(CvStmt { kind: CVS_TRAP, a: ob, b: 0, c: 0, d: 0, s: "" });
        let bp: i64 = cv_fresh("U32", base, locals);
        let qp: i64 = stmts.push(CvStmt { kind: CVS_LF2, a: bp, b: rv, c: 0, d: 0, s: "U32" });
        let ad: i64 = cv_fresh("U32", base, locals);
        let qa: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: ad, b: bp, c: T_PLUS, d: w0, s: "" });
        let qld: i64 = stmts.push(CvStmt { kind: CVS_LD8, a: dst, b: ad, c: 0, d: 0, s: "" });
        return dst;
    } else {
    }
    // Stage-3-0: `s.as_output()` -> StrAsOutput (air.rs:3301). Packs the str fat-pointer
    // header into the forge return `(data_ptr << 32) | len`: load data_ptr (u32 @0) + len
    // (u32 @4), zero-extend each to i64, then shift + or. Fresh ORDER mirrors the oracle
    // (dst, receiver, dptr_u32, dptr, len_u32, len, shift, shifted). This is the ONLY forge-ABI
    // boundary intrinsic with no SIGIL-source alternative — required for the selfhost to emit a
    // runnable tool_main (the Thompson-closure with-driver capstone).
    if isao {
        let mut dst: i64 = dstgiven;
        if dst < 0 {
            dst = cv_fresh("I64", base, locals);
        } else {
        }
        let rv: i64 = cv_str_receiver_var(nodes, kids, rid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        if rv < 0 {
            let qpa: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            return 0 - 1;
        } else {
        }
        let dpu: i64 = cv_fresh("U32", base, locals);
        let qdp: i64 = stmts.push(CvStmt { kind: CVS_LF2, a: dpu, b: rv, c: 0, d: 0, s: "U32" });
        let dp: i64 = cv_fresh("I64", base, locals);
        let qde: i64 = stmts.push(CvStmt { kind: CVS_EXT_U32, a: dp, b: dpu, c: 0, d: 0, s: "" });
        let lnu: i64 = cv_fresh("U32", base, locals);
        let qlf: i64 = stmts.push(CvStmt { kind: CVS_LF2, a: lnu, b: rv, c: 4, d: 0, s: "U32" });
        let ln: i64 = cv_fresh("I64", base, locals);
        let qle: i64 = stmts.push(CvStmt { kind: CVS_EXT_U32, a: ln, b: lnu, c: 0, d: 0, s: "" });
        let sh: i64 = cv_fresh("I64", base, locals);
        let qsh: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: sh, b: 32, c: 0, d: 0, s: "" });
        let shd: i64 = cv_fresh("I64", base, locals);
        let qsl: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: shd, b: dp, c: T_LTLT, d: sh, s: "" });
        let qor: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: dst, b: shd, c: T_PIPE, d: ln, s: "" });
        return dst;
    } else {
    }
    if n.child_count >= 3 {
    } else {
        let qp2: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0 - 1;
    }
    let mut dst: i64 = dstgiven;
    if dst < 0 {
        dst = cv_fresh("Ptr", base, locals);
    } else {
    }
    let rv: i64 = cv_str_receiver_var(nodes, kids, rid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
    if rv < 0 {
        let qps: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0 - 1;
    } else {
    }
    let aid: i64 = kids.get(n.child_start + 1);
    let bid: i64 = kids.get(n.child_start + 2);
    let av: i64 = cv_to_var(nodes, kids, aid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
    let bv: i64 = cv_to_var(nodes, kids, bid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
    // SHP-0b: the bounds checks below compare at I64. The oracle widens 4-byte bounds to i64
    // first (i64.extend_i32_u), so a bound of any type but I64 is refused rather than compared
    // narrow and unsigned.
    let avt: str = cv_built_var_tok(av, base, env, locals);
    let bvt: str = cv_built_var_tok(bv, base, env, locals);
    let avok: bool = avt.bytes_eq("I64");
    let bvok: bool = bvt.bytes_eq("I64");
    if !avok {
        let qpb1: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
    }
    if !bvok {
        let qpb2: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
    }
    let l4: i64 = cv_fresh("U32", base, locals);
    let q1: i64 = stmts.push(CvStmt { kind: CVS_LF2, a: l4, b: rv, c: 4, d: 0, s: "U32" });
    let l5: i64 = cv_fresh("I64", base, locals);
    let q2: i64 = stmts.push(CvStmt { kind: CVS_EXT_U32, a: l5, b: l4, c: 0, d: 0, s: "" });
    let z6: i64 = cv_fresh("I64", base, locals);
    let q3: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: z6, b: 0, c: 0, d: 0, s: "" });
    let c7: i64 = cv_fresh("Bool", base, locals);
    let q4: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: c7, b: av, c: T_LT, d: z6, s: "" });
    let q5: i64 = stmts.push(CvStmt { kind: CVS_TRAP, a: c7, b: 0, c: 0, d: 0, s: "" });
    let c8: i64 = cv_fresh("Bool", base, locals);
    let q6: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: c8, b: bv, c: T_LT, d: z6, s: "" });
    let q7: i64 = stmts.push(CvStmt { kind: CVS_TRAP, a: c8, b: 0, c: 0, d: 0, s: "" });
    let c9: i64 = cv_fresh("Bool", base, locals);
    let q8: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: c9, b: av, c: T_GT, d: bv, s: "" });
    let q9: i64 = stmts.push(CvStmt { kind: CVS_TRAP, a: c9, b: 0, c: 0, d: 0, s: "" });
    let c10: i64 = cv_fresh("Bool", base, locals);
    let q10: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: c10, b: bv, c: T_GT, d: l5, s: "" });
    let q11: i64 = stmts.push(CvStmt { kind: CVS_TRAP, a: c10, b: 0, c: 0, d: 0, s: "" });
    let w11: i64 = cv_fresh("U32", base, locals);
    let q12: i64 = stmts.push(CvStmt { kind: CVS_WRAP, a: w11, b: av, c: 0, d: 0, s: "" });
    let w12: i64 = cv_fresh("U32", base, locals);
    let q13: i64 = stmts.push(CvStmt { kind: CVS_WRAP, a: w12, b: bv, c: 0, d: 0, s: "" });
    let p13: i64 = cv_fresh("U32", base, locals);
    let q14: i64 = stmts.push(CvStmt { kind: CVS_LF2, a: p13, b: rv, c: 0, d: 0, s: "U32" });
    let mut ei: i64 = 0;
    while ei < 2 {
        let mut ev: i64 = av;
        if ei == 1 {
            ev = bv;
        } else {
        }
        let z14: i64 = cv_fresh("I64", base, locals);
        let qz: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: z14, b: 0, c: 0, d: 0, s: "" });
        let m15: i64 = cv_fresh("Bool", base, locals);
        let qm1: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: m15, b: ev, c: T_LT, d: l5, s: "" });
        let m16: i64 = cv_fresh("Bool", base, locals);
        let qm2: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: m16, b: ev, c: T_GT, d: z14, s: "" });
        let m17: i64 = cv_fresh("Bool", base, locals);
        let qm3: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: m17, b: m16, c: T_AMP, d: m15, s: "" });
        let s18: i64 = cv_fresh("I64", base, locals);
        let qs: i64 = stmts.push(CvStmt { kind: CVS_CTSEL, a: s18, b: m15, c: ev, d: z14, s: "" });
        let w19: i64 = cv_fresh("U32", base, locals);
        let qw2: i64 = stmts.push(CvStmt { kind: CVS_WRAP, a: w19, b: s18, c: 0, d: 0, s: "" });
        let a20: i64 = cv_fresh("U32", base, locals);
        let qa2: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: a20, b: p13, c: T_PLUS, d: w19, s: "" });
        let b21: i64 = cv_fresh("I64", base, locals);
        let qb2: i64 = stmts.push(CvStmt { kind: CVS_LD8, a: b21, b: a20, c: 0, d: 0, s: "" });
        let k22: i64 = cv_fresh("I64", base, locals);
        let qk: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: k22, b: 192, c: 0, d: 0, s: "" });
        let x23: i64 = cv_fresh("I64", base, locals);
        let qx: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: x23, b: b21, c: T_AMP, d: k22, s: "" });
        let k24: i64 = cv_fresh("I64", base, locals);
        let qk2: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: k24, b: 128, c: 0, d: 0, s: "" });
        let e25: i64 = cv_fresh("Bool", base, locals);
        let qe2: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: e25, b: x23, c: T_EQEQ, d: k24, s: "" });
        let f26: i64 = cv_fresh("Bool", base, locals);
        let qf: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: f26, b: m17, c: T_AMP, d: e25, s: "" });
        let qt2: i64 = stmts.push(CvStmt { kind: CVS_TRAP, a: f26, b: 0, c: 0, d: 0, s: "" });
        ei = ei + 1;
    }
    // NO explicit CVS_FUEL here: the shared fuel machinery already inserts the per-alloc
    // decrement before a CVS_BA (the oracle's FuelDecrement in the pin came from fuel::insert).
    let qba: i64 = stmts.push(CvStmt { kind: CVS_BA, a: dst, b: 8, c: 4, d: 0, s: "" });
    let n40: i64 = cv_fresh("U32", base, locals);
    let qn1: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: n40, b: p13, c: T_PLUS, d: w11, s: "" });
    let qsf1: i64 = stmts.push(CvStmt { kind: CVS_SF, a: dst, b: n40, c: 0, d: 0, s: "U32" });
    let n41: i64 = cv_fresh("U32", base, locals);
    let qn2: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: n41, b: w12, c: T_MINUS, d: w11, s: "" });
    let qsf2: i64 = stmts.push(CvStmt { kind: CVS_SF, a: dst, b: n41, c: 4, d: 0, s: "U32" });
    return dst;
}

fn cv_emit_string(sd: i64, text: str, base: i64, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let qba: i64 = stmts.push(CvStmt { kind: CVS_BA, a: sd, b: 8, c: 4, d: 0, s: "" });
    let dp: i64 = cv_fresh("U32", base, locals);
    let qdp: i64 = stmts.push(CvStmt { kind: CVS_AS_STR, a: dp, b: 0, c: 0, d: 0, s: text });
    let qs1: i64 = stmts.push(CvStmt { kind: CVS_SF, a: sd, b: dp, c: 0, d: 0, s: "U32" });
    let ln: i64 = cv_fresh("U32", base, locals);
    let bl: i64 = text.len();
    let qln: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: ln, b: bl, c: 0, d: 0, s: "" });
    let qs2: i64 = stmts.push(CvStmt { kind: CVS_SF, a: sd, b: ln, c: 4, d: 0, s: "U32" });
    return 0;
}

// SHP-0b: the record code whose field types a construct of `rcode` writes to: the instance
// `drec` names when `rcode` is a generic record and `drec` one of its monomorphized instances
// (named `{generic}__...`, with no type parameters of its own), else `rcode` itself.
fn cv_rec_instance_code(rdefs: Vec<TcRec>, rcode: i64, drec: i64) -> i64 {
    if rcode < TC_REC_BASE {
        return rcode;
    }
    if drec < 0 {
        return rcode;
    }
    let grec: TcRec = rdefs.get(rcode - TC_REC_BASE);
    if grec.tpnames.len() == 0 {
        return rcode;
    }
    let irec: TcRec = rdefs.get(drec);
    if irec.is_enum {
        return rcode;
    }
    if irec.tpnames.len() > 0 {
        return rcode;
    }
    let ipre: str = grec.name.concat("__");
    let plen: i64 = ipre.len();
    if irec.name.len() <= plen {
        return rcode;
    }
    let ihead: str = irec.name.substr(0, plen);
    if !ihead.bytes_eq(ipre) {
        return rcode;
    }
    return drec + TC_REC_BASE;
}

// SHP-0b: the declared type token of field `fnm` in the record with code `rcode`, the slot a
// record construct writes that field's value to. "?" (an untracked slot) for a field typed by
// one of the record's type parameters: the construct names the generic definition, and the
// instance the oracle lays out is not known here. Also "?" for an unknown field or a non-record
// code, which the construct's own render fails on.
fn cv_rec_field_slot_tok(rdefs: Vec<TcRec>, rcode: i64, fnm: str) -> str {
    if rcode < TC_REC_BASE {
        return "?";
    }
    let ridx: i64 = rcode - TC_REC_BASE;
    let rrec: TcRec = rdefs.get(ridx);
    let nf: i64 = rrec.fnames.len();
    let mut i: i64 = 0;
    while i < nf {
        let dn: str = rrec.fnames.get(i);
        if dn.bytes_eq(fnm) {
            if i < rrec.fparmtp.len() {
                let tp: i64 = rrec.fparmtp.get(i);
                if tp >= 0 {
                    return "?";
                }
            }
            return cv_field_tok(rdefs, ridx, fnm);
        }
        i = i + 1;
    }
    return "?";
}

// `drec` is the record index the construct's slot declares (an annotated let, an assignment, a
// call argument or return), or -1. SHP-0b: a construct of a GENERIC record names the generic
// definition, whose type-parameter fields have no width here; when the slot declares one of its
// instances (`Box__i32` — monomorphization rewrites the annotation, not the construct), the
// instance's field types are the slots the values are typed by, as the oracle lays the instance
// out. Without one, a type-parameter field is an untracked slot (cv_rec_field_slot_tok).
fn cv_emit_rec(nodes: Arena<PNode>, kids: Vec<i64>, rd: i64, eid: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, drec: i64, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(eid);
    let rnm: str = tc_seg_at(n.text, 0);
    let rcode: i64 = tc_code_of_name(rnm, rdefs);
    let scode: i64 = cv_rec_instance_code(rdefs, rcode, drec);
    let mut wnames: Vec<str> = Vec::new();
    let mut wvars: Vec<i64> = Vec::new();
    let mut ri: i64 = 0;
    while ri < n.child_count {
        let fvid: i64 = kids.get(n.child_start + ri);
        let fnm: str = tc_seg_at(n.text, ri + 1);
        // SHP-0b: the field's declared type decides the value's (cv_slot_var), and an array or
        // construct value's parts are typed by it in turn (cv_typed_compound). The memory pass
        // lays a construct out by its value tokens, as the oracle's does, so a value typed on
        // its own (an I64 literal in an `i32` field) moved every later field while every read
        // used the declared offsets.
        let ftok: str = cv_rec_field_slot_tok(rdefs, scode, fnm);
        let mut ftid: i64 = 0 - 1;
        if scode >= TC_REC_BASE {
            ftid = cv_rec_field_tid(rdefs, scode - TC_REC_BASE, fnm);
        }
        let mut fv: i64 = cv_typed_compound(nodes, kids, fvid, ftid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        if fv < 0 {
            fv = cv_slot_var(nodes, kids, fvid, ftok, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        }
        let qn: i64 = wnames.push(fnm);
        let qv: i64 = wvars.push(fv);
        ri = ri + 1;
    }
    // Mats stay WRITTEN-order (evaluation order); the rendered pair list follows
    // DECL order — the oracle normalizes RecordConstruct.fields to the registry's
    // decl order (air.rs lower_record_construct, the field-order soundness fix).
    let mut rfs: Vec<str> = Vec::new();
    let nw: i64 = wnames.len();
    if rcode >= TC_REC_BASE {
        let ridx: i64 = rcode - TC_REC_BASE;
        let rrec: TcRec = rdefs.get(ridx);
        let nf: i64 = rrec.fnames.len();
        let mut di: i64 = 0;
        while di < nf {
            let dn: str = rrec.fnames.get(di);
            let mut wi: i64 = 0;
            while wi < nw {
                let wn: str = wnames.get(wi);
                let same: bool = wn.bytes_eq(dn);
                if same {
                    let fv2: i64 = wvars.get(wi);
                    let fvs: str = cv_i64_str(fv2);
                    let fp0: str = dn.concat("=v");
                    let fp1: str = fp0.concat(fvs);
                    let qf: i64 = rfs.push(fp1);
                } else {
                }
                wi = wi + 1;
            }
            di = di + 1;
        }
    } else {
        // not a record decl (can't typecheck) — render an empty pair list: the
        // mismatch diffs loud against the oracle.
    }
    let rsp: str = " ";
    let rstr: str = rsp.join(rfs);
    let qr: i64 = stmts.push(CvStmt { kind: CVS_AS_REC, a: rd, b: 0, c: 0, d: 0, s: rstr });
    return 0;
}

// ST-3: the `;`-joined element-type tokens of a P_K_TYPE_TUPLE annotation ("I64;I64"),
// or "" if not a tuple type. Widths for the destructure come from cv_ty_width per seg.
fn cv_tuptys_of_typenode(nodes: Arena<PNode>, kids: Vec<i64>, tid: i64, rdefs: Vec<TcRec>) -> str ! { Alloc } {
    if tid < 0 {
        return "";
    } else {
    }
    let n: PNode = nodes.get(tid);
    if n.kind == P_K_TYPE_TUPLE {
    } else {
        return "";
    }
    let mut ts: Vec<str> = Vec::new();
    let mut i: i64 = 0;
    while i < n.child_count {
        let ecid: i64 = kids.get(n.child_start + i);
        let etok: str = ai_airtype_of_typenode(nodes, kids, ecid, rdefs);
        let q: i64 = ts.push(etok);
        i = i + 1;
    }
    let semi: str = ";";
    return semi.join(ts);
}

// ST-3: the tuptys of an env binding (last-wins), or "" (mirrors cv_env_rec).
fn cv_env_tuptys(env: Vec<CvBind>, name: str) -> str {
    let n: i64 = env.len();
    let mut i: i64 = n - 1;
    while i >= 0 {
        let b: CvBind = env.get(i);
        let eq: bool = b.name.bytes_eq(name);
        if eq {
            return b.tuptys;
        } else {
        }
        i = i - 1;
    }
    return "";
}

// ST-3: a tuple CONSTRUCT `(e0, e1, …)` -> a positional `Rec(0=vN 1=vM …)` (field names are
// the indices; positional = decl order, no #457 normalize). cv_mem_lower expands it via the
// VALUE var widths — no synthetic TcRec needed. Mats first (X6: dst freshed by the caller).
// SR-032: a tuple literal is typed by the slot it is written to, as production types it. The
// memory pass lays a tuple out by its element tokens, as production's does, while every read
// uses the slot's element types, so an element typed on its own (an I64 literal in an `i32`
// element) moved every later element. `stid` names the slot: a type node (>= 0) whose element
// types are the elements' slots (cv_to_var_expected: a bare literal takes its element's integer
// type, an array or construct its element's type, a nested tuple recurses); -1, production
// gives this tuple no slot (an unannotated `let`, an expression statement, an unannotated
// array's element), so each element types itself, as before SR-032; -2, production types it by
// a slot this lowering cannot see (an assignment, a value lowered without its slot's type node),
// so an element production types from context alone (cv_expr_literal_typed) is refused. A nested
// tuple element inherits -1 or -2, and a type node that is not a tuple of this arity counts as -2.
fn cv_emit_tuple(nodes: Arena<PNode>, kids: Vec<i64>, td: i64, eid: i64, stid: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(eid);
    let mut slotted: bool = false;
    let mut hidden: bool = stid < 0 - 1;
    if stid >= 0 {
        let sn: PNode = nodes.get(stid);
        if sn.kind == P_K_TYPE_TUPLE {
            if sn.child_count == n.child_count {
                slotted = true;
            }
        }
        if !slotted {
            hidden = true;
        }
    }
    let mut rfs: Vec<str> = Vec::new();
    let mut ti: i64 = 0;
    while ti < n.child_count {
        let evid: i64 = kids.get(n.child_start + ti);
        let evn: PNode = nodes.get(evid);
        let mut ev: i64 = 0;
        if slotted {
            let stn: PNode = nodes.get(stid);
            let etid: i64 = kids.get(stn.child_start + ti);
            ev = cv_to_var_expected(nodes, kids, evid, etid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        } else {
            if evn.kind == P_K_TUPLE {
                let mut nstid: i64 = 0 - 1;
                if hidden {
                    nstid = 0 - 2;
                }
                ev = cv_fresh("Ptr", base, locals);
                let qnt: i64 = cv_emit_tuple(nodes, kids, ev, evid, nstid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            } else {
                if hidden {
                    if cv_expr_literal_typed(nodes, kids, evid) {
                        let qph: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                        return 0;
                    }
                }
                ev = cv_to_var(nodes, kids, evid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            }
        }
        let inm: str = cv_i64_str(ti);
        let evs: str = cv_i64_str(ev);
        let fp0: str = inm.concat("=v");
        let fp1: str = fp0.concat(evs);
        let qf: i64 = rfs.push(fp1);
        ti = ti + 1;
    }
    let rsp: str = " ";
    let rstr: str = rsp.join(rfs);
    let qr: i64 = stmts.push(CvStmt { kind: CVS_AS_REC, a: td, b: 0, c: 0, d: 0, s: rstr });
    return 0;
}

// CAP-MATCH: does `name` name a VARIANT of any enum rdef? (variant names are enum-unique,
// AG-ST-AMBIGVARIANT) — returns the rdef index or -1.
fn cv_variant_find(rdefs: Vec<TcRec>, name: str) -> i64 {
    let n: i64 = rdefs.len();
    let mut i: i64 = 0;
    while i < n {
        let rc: TcRec = rdefs.get(i);
        let nv: i64 = rc.vnames.len();
        let mut v: i64 = 0;
        while v < nv {
            let vn: str = rc.vnames.get(v);
            if vn.bytes_eq(name) {
                return i;
            } else {
            }
            v = v + 1;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn cv_enum_ctor_inst_size(nodes: Arena<PNode>, kids: Vec<i64>, eid: i64, eridx: i64, vidx: i64, pstart: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, cnames: Vec<str>, cvals: Vec<i64>) -> i64 ! { Alloc } {
    let rec: TcRec = rdefs.get(eridx);
    let ntp: i64 = rec.tpnames.len();
    if ntp == 0 {
        return cv_enum_total_size(rdefs, eridx);
    } else {
    }
    let mut widths: Vec<i64> = Vec::new();
    let mut wi: i64 = 0;
    while wi < ntp {
        let qw: i64 = widths.push(0 - 1);
        wi = wi + 1;
    }
    let n: PNode = nodes.get(eid);
    let vs: i64 = rec.vstarts.get(vidx);
    let vc: i64 = rec.vcounts.get(vidx);
    let argc: i64 = n.child_count - pstart;
    if argc != vc {
        return 0;
    } else {
    }
    let mut ai: i64 = 0;
    while ai < argc {
        let ptp: i64 = rec.vptp.get(vs + ai);
        if ptp >= 0 {
            if ptp >= ntp {
                return 0;
            } else {
            }
            let argid: i64 = kids.get(n.child_start + pstart + ai);
            let tok: str = cv_expr_tytok(nodes, kids, argid, env, rdefs, sigs, cnames, cvals);
            if cv_ty_known(tok) {
                let width: i64 = cv_ty_width(tok);
                let old: i64 = widths.get(ptp);
                if old >= 0 {
                    if old != width {
                        return 0;
                    } else {
                    }
                } else {
                }
                let qs: i64 = widths.set(ptp, width);
            } else {
                return 0;
            }
        } else {
        }
        ai = ai + 1;
    }
    return cv_enum_size_with_widths(rdefs, eridx, widths);
}

// SR-032: the token argument `argid` of payload `pk` (of the variant whose `vc` payloads start
// at `vs` in `erec`) is lowered and laid out at, when its slot types it, as production types it:
// a payload typed by one of the enum's type parameters takes the instance's type argument
// (cv_inst_arg_tok) when the instance type node `itid` is in view, and a bare integer literal in
// a payload of a known integer type takes that type. "" otherwise: the argument already carries
// its payload's type (cv_emit_enum_ctor refused it if not), or no slot types it.
fn cv_payload_slot_tok(nodes: Arena<PNode>, kids: Vec<i64>, erec: TcRec, vs: i64, pk: i64, vc: i64, itid: i64, argid: i64, rdefs: Vec<TcRec>) -> str ! { Alloc } {
    if pk >= vc {
        return "";
    }
    let mut ptp: i64 = 0 - 1;
    if vs + pk < erec.vptp.len() {
        ptp = erec.vptp.get(vs + pk);
    }
    if ptp >= 0 {
        if itid < 0 {
            return "";
        }
        let itok: str = cv_inst_arg_tok(nodes, kids, itid, ptp, rdefs);
        if !cv_ty_known(itok) {
            return "";
        }
        return itok;
    }
    let an: PNode = nodes.get(argid);
    if an.kind != P_K_LIT_INT {
        return "";
    }
    let ptok: str = cv_tcode_tok(erec.vptags.get(vs + pk));
    if !cv_tok_is_int(ptok) {
        return "";
    }
    return ptok;
}

// SR-032: the token of type argument `ptp` of the generic-enum instance type node `itid`
// (`E<i32>` -> I32 for its first parameter), or "" when `itid` names no instance with that many
// type arguments.
fn cv_inst_arg_tok(nodes: Arena<PNode>, kids: Vec<i64>, itid: i64, ptp: i64, rdefs: Vec<TcRec>) -> str ! { Alloc } {
    if itid < 0 {
        return "";
    }
    let tn: PNode = nodes.get(itid);
    if ptp >= tn.child_count {
        return "";
    }
    let atid: i64 = kids.get(tn.child_start + ptp);
    return ai_airtype_of_typenode(nodes, kids, atid, rdefs);
}

// `itid` (SR-032) is the slot's instance type node, with cv_into's encoding: >= 0 names it,
// -1 means production gives the construct no slot, -2 a slot this lowering cannot see.
fn cv_emit_enum_ctor(nodes: Arena<PNode>, kids: Vec<i64>, ed: i64, eid: i64, eridx: i64, vidx: i64, pstart: i64, esz: i64, itid: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(eid);
    // CAP-ENUM (capstone, scalar): a GENERIC enum's def sizes its T payloads at width 4
    // (un-substituted), so `Some(x: i64)` under-allocated 8 where the oracle's INSTANCE
    // cell is 12 — a SILENT wrong-size alloc (the stores were always arg-token-correct).
    // The cell must at least hold what THIS ctor stores: size = max(def size, 4 + the
    // actual arg widths). Concrete enums are byte-UNCHANGED (their def size is already
    // the max over variants); unit ctors (None) never reach this fn's alloc with args.
    // A generic enum's SMALLER payload-bearing variant stays divergent (AG: zero
    // instances — Option's only payload variant is Some; the tuple payload is CAP-ENUM's
    // second sub-slice).
    let erec: TcRec = rdefs.get(eridx);
    let mut tsz0: i64 = esz;
    if tsz0 <= 0 {
        tsz0 = cv_enum_ctor_inst_size(nodes, kids, eid, eridx, vidx, pstart, env, rdefs, sigs, cnames, cvals);
    } else {
    }
    if erec.tpnames.len() > 0 {
        if tsz0 <= 0 {
            let qpoison: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            return 0;
        } else {
        }
    } else {
    }
    if tsz0 <= 0 {
        tsz0 = cv_enum_total_size(rdefs, eridx);
    } else {
    }
    // SHP-0b: the payloads are laid out below by each argument's token, so every argument must
    // carry its payload slot's type, as the oracle types it (SR-032: each argument is typed by its
    // payload slot). In a payload of a known scalar type, a bare integer literal takes the
    // payload's integer type (cv_payload_slot_tok: `E::V(3, 40)` with `V(i32, i64)` stores the `3`
    // in 4 bytes); literal arithmetic, which this lowering types I64 on its own, is accepted only
    // in an `i64` payload, as at every slot (cv_slot_var); any other argument must already carry
    // the payload's type. A payload typed by one of the enum's type parameters takes the
    // instance's type argument: with the instance's type node in view (`itid`) the argument is
    // lowered as a value written to a slot of that type (cv_slot_var) and laid out at its width
    // (`let e: E<i32> = E::V(3);` stores an i32); with no slot in production (-1) a literal keeps
    // its I64 default there, as here; and a literal-typed argument under a slot this lowering
    // cannot see (-2) is refused, since production typed it by an instance unknown here. A
    // payload whose declared type this lowering does not track (a record, `str`, an array, a
    // tuple: vptags holds scalar codes only) is an untracked slot, as in cv_slot_var: a
    // literal-typed argument is refused, and any other types itself, except a tuple literal,
    // whose elements the oracle would type by the payload's element types. Any other mismatch is
    // refused.
    let vs0: i64 = erec.vstarts.get(vidx);
    let vc0: i64 = erec.vcounts.get(vidx);
    let mut pn0: i64 = pstart;
    while pn0 < n.child_count {
        let pnid: i64 = kids.get(n.child_start + pn0);
        let pk: i64 = pn0 - pstart;
        let mut pok: bool = false;
        if pk < vc0 {
            let ptag: i64 = erec.vptags.get(vs0 + pk);
            let mut ptp: i64 = 0 - 1;
            if vs0 + pk < erec.vptp.len() {
                ptp = erec.vptp.get(vs0 + pk);
            }
            let plit: bool = cv_expr_literal_typed(nodes, kids, pnid);
            if ptp >= 0 {
                pok = true;
                if plit {
                    if itid >= 0 {
                        // The cell is the instance's only when the caller sized it (esz); the
                        // fallback below sizes it by the literal's own I64 token.
                        let pitok: str = cv_inst_arg_tok(nodes, kids, itid, ptp, rdefs);
                        pok = cv_ty_known(pitok);
                        if esz <= 0 {
                            pok = false;
                        }
                    }
                    if itid < 0 - 1 {
                        pok = false;
                    }
                }
            }
            if ptp < 0 {
                let ptok: str = cv_tcode_tok(ptag);
                if plit {
                    pok = ptok.bytes_eq("I64");
                    let pnn: PNode = nodes.get(pnid);
                    if pnn.kind == P_K_LIT_INT {
                        pok = cv_tok_is_int(ptok);
                    }
                }
                if !plit {
                    if cv_ty_known(ptok) {
                        let pat: str = cv_expr_tytok(nodes, kids, pnid, env, rdefs, sigs, cnames, cvals);
                        pok = pat.bytes_eq(ptok);
                    }
                    if !cv_ty_known(ptok) {
                        let pnk: PNode = nodes.get(pnid);
                        pok = pnk.kind != P_K_TUPLE;
                    }
                }
            }
        }
        if !pok {
            let qpp: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            return 0;
        }
        pn0 = pn0 + 1;
    }
    let mut argw: i64 = 0;
    let mut pw0: i64 = pstart;
    while pw0 < n.child_count {
        let awid: i64 = kids.get(n.child_start + pw0);
        let mut awty: str = cv_expr_tytok(nodes, kids, awid, env, rdefs, sigs, cnames, cvals);
        let awtok: str = cv_payload_slot_tok(nodes, kids, erec, vs0, pw0 - pstart, vc0, itid, awid, rdefs);
        if awtok.len() > 0 {
            awty = awtok;
        }
        argw = argw + cv_ty_width(awty);
        pw0 = pw0 + 1;
    }
    let mut tsz: i64 = tsz0;
    if 4 + argw > tsz {
        tsz = 4 + argw;
    } else {
    }
    let qba: i64 = stmts.push(CvStmt { kind: CVS_BA, a: ed, b: tsz, c: 4, d: 0, s: "" });
    let tg: i64 = cv_fresh("I32", base, locals);
    let qtg: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: tg, b: vidx, c: 0, d: 0, s: "" });
    let qsf: i64 = stmts.push(CvStmt { kind: CVS_SF, a: ed, b: tg, c: 0, d: 0, s: "I32" });
    let mut acc: i64 = 4;
    let mut pi2: i64 = pstart;
    while pi2 < n.child_count {
        let agid: i64 = kids.get(n.child_start + pi2);
        let aitok: str = cv_payload_slot_tok(nodes, kids, erec, vs0, pi2 - pstart, vc0, itid, agid, rdefs);
        let mut av: i64 = 0;
        let mut aty: str = "";
        if aitok.len() > 0 {
            av = cv_slot_var(nodes, kids, agid, aitok, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            aty = aitok;
        } else {
            av = cv_to_var(nodes, kids, agid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            aty = cv_expr_tytok(nodes, kids, agid, env, rdefs, sigs, cnames, cvals);
        }
        let qsp: i64 = stmts.push(CvStmt { kind: CVS_SF, a: ed, b: av, c: acc, d: 0, s: aty });
        acc = acc + cv_ty_width(aty);
        pi2 = pi2 + 1;
    }
    return 0;
}

// Mirror `lower_expr_to_var` (air.rs:1789) on the CV-1 surface. A bare local returns its env id
// with NO alloc and NO stmt; everything else freshes a dst FIRST (X6) then produces into it.
// B-DISPATCH: the RECORD index of a method receiver path — bare (`v` -> env rec) or ONE field
// hop (`self::store` -> the base's env rec, then the field's ftag when it names a record). -1
// when unresolvable (the caller poisons loud). Mirrors the oracle's receiver typing; deeper
// chains (`a::b::c`) stay out (the tc AG-G19 targ-threading line).
fn cv_recv_rec(env: Vec<CvBind>, rdefs: Vec<TcRec>, text: str) -> i64 {
    let cc: i64 = tc_last_colons(text);
    if cc < 0 {
        return cv_env_rec(env, text);
    } else {
    }
    let tlen: i64 = text.len();
    let fbase: str = text.substr(0, cc);
    let fseg: str = text.substr(cc + 2, tlen);
    let bcc: i64 = tc_last_colons(fbase);
    if bcc >= 0 {
        return 0 - 1;
    } else {
    }
    let brec: i64 = cv_env_rec(env, fbase);
    if brec < 0 {
        return 0 - 1;
    } else {
    }
    let r: TcRec = rdefs.get(brec);
    let nf: i64 = r.fnames.len();
    let mut i: i64 = 0;
    while i < nf {
        let fname: str = r.fnames.get(i);
        if fname.bytes_eq(fseg) {
            let ftag: i64 = r.ftags.get(i);
            if ftag >= TC_REC_BASE {
                return ftag - TC_REC_BASE;
            } else {
            }
            return 0 - 1;
        } else {
        }
        i = i + 1;
    }
    return 0 - 1;
}

// W-CONST: the top-level const table lookup (name -> the literal value; -1 = miss). The
// oracle INLINES every const reference as a fresh IntLit temp — no globals, no memory.
fn cv_ctbl_find(cnames: Vec<str>, cvals: Vec<i64>, name: str) -> i64 {
    let n: i64 = cnames.len();
    let mut i: i64 = 0;
    while i < n {
        let c: str = cnames.get(i);
        if c.bytes_eq(name) {
            return cvals.get(i);
        } else {
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn cv_fn_param_typeid(sigs: Vec<TcSig>, name: str, param_index: i64) -> i64 {
    let sidx: i64 = tc_sig_find(sigs, name);
    if sidx < 0 {
        return 0 - 1;
    } else {
    }
    let sig: TcSig = sigs.get(sidx);
    if param_index < 0 {
        return 0 - 1;
    } else {
    }
    if param_index >= sig.param_typeids.len() {
        return 0 - 1;
    } else {
    }
    return sig.param_typeids.get(param_index);
}

// SR-032: the slot a call argument is lowered against (cv_to_var_expected). In a call to a
// monomorphized free-function instance (TcSig.inst), a tuple, array, record or enum parameter is
// a slot this lowering cannot see: the instance's parameter is fully substituted, while
// production pins such an argument only once the arguments before it have bound every type
// parameter its declared type mentions (`g((n, 4), n)` for `t: (T, i32), a: T` types the `4` as
// an i64 in production). So the argument is lowered against a hidden slot (-2), and a literal part
// of it is refused rather than typed by a slot production may not have used. A scalar or `str`
// parameter keeps its slot: production narrows a literal argument there once the instance is
// known (Fallback 1).
fn cv_call_arg_tid(nodes: Arena<PNode>, kids: Vec<i64>, sigs: Vec<TcSig>, name: str, param_index: i64, rdefs: Vec<TcRec>) -> i64 {
    let tid: i64 = cv_fn_param_typeid(sigs, name, param_index);
    if tid < 0 {
        return tid;
    }
    let sidx: i64 = tc_sig_find(sigs, name);
    let sig: TcSig = sigs.get(sidx);
    if sig.inst == 0 {
        return tid;
    }
    let tn: PNode = nodes.get(tid);
    if tn.kind == P_K_TYPE_TUPLE {
        return 0 - 2;
    }
    if tn.kind == P_K_TYPE_ARRAY {
        return 0 - 2;
    }
    if cv_rec_of_typenode(nodes, kids, tid, rdefs) >= 0 {
        return 0 - 2;
    }
    return tid;
}

fn cv_expr_is_enum_ctor_for(nodes: Arena<PNode>, kids: Vec<i64>, eid: i64, ridx: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, fids: Vec<str>) -> bool {
    let n: PNode = nodes.get(eid);
    if n.kind == P_K_PATH {
        let cc: i64 = tc_last_colons(n.text);
        let mut variant: str = n.text;
        if cc >= 0 {
            let base: str = n.text.substr(0, cc);
            if cv_env_var(env, base) >= 0 {
                return false;
            } else {
            }
            let rec: TcRec = rdefs.get(ridx);
            if base.bytes_eq(rec.name) {
            } else {
                return false;
            }
            variant = n.text.substr(cc + 2, n.text.len());
        } else {
        }
        let vidx: i64 = tc_variant_index(rdefs, ridx, variant);
        if vidx >= 0 {
            let rec2: TcRec = rdefs.get(ridx);
            return rec2.vcounts.get(vidx) == 0;
        } else {
        }
        return false;
    } else {
    }
    if n.kind == P_K_CALL {
        if cv_fid_find(fids, n.text) >= 0 {
            return false;
        } else {
        }
        return tc_variant_index(rdefs, ridx, n.text) >= 0;
    } else {
    }
    if n.kind == P_K_METHOD {
        if n.child_count > 0 {
            let recv_id: i64 = kids.get(n.child_start);
            let recv: PNode = nodes.get(recv_id);
            if recv.kind == P_K_PATH {
                let rec3: TcRec = rdefs.get(ridx);
                if recv.text.bytes_eq(rec3.name) {
                    return tc_variant_index(rdefs, ridx, n.text) >= 0;
                } else {
                }
            } else {
            }
        } else {
        }
    } else {
    }
    return false;
}

// SHP-0b: the element type node of an array type node `tid`, or -1 when `tid` is not one (or is
// absent).
fn cv_array_elem_tid(nodes: Arena<PNode>, kids: Vec<i64>, tid: i64) -> i64 {
    if tid < 0 {
        return 0 - 1;
    }
    let tn: PNode = nodes.get(tid);
    if tn.kind != P_K_TYPE_ARRAY {
        return 0 - 1;
    }
    return kids.get(tn.child_start);
}

// SHP-0b: the declared type node of field `fnm` in the record at `rdefs[ridx]`, or -1 (an unknown
// field, or one with no type node).
fn cv_rec_field_tid(rdefs: Vec<TcRec>, ridx: i64, fnm: str) -> i64 {
    let rec: TcRec = rdefs.get(ridx);
    let nf: i64 = rec.fnames.len();
    let mut i: i64 = 0;
    while i < nf {
        let dn: str = rec.fnames.get(i);
        if dn.bytes_eq(fnm) {
            if i < rec.ftids.len() {
                return rec.ftids.get(i);
            }
            return 0 - 1;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// SHP-0b: the record a slot of declared type node `tid` names, for a construct written to it.
// That is cv_rec_of_typenode's answer, or, for a generic record named with concrete type
// arguments (`Box<i64>`: monomorphization leaves a cloned instance's field types child-bearing),
// the instance monomorphization cloned for them (`Box__i64`, the mangle mn_rec_mangle forms).
// -1 when there is none: the construct then names its own definition, whose type-parameter
// fields are untracked slots.
fn cv_rec_inst_of_typenode(nodes: Arena<PNode>, kids: Vec<i64>, tid: i64, rdefs: Vec<TcRec>) -> i64 ! { Alloc } {
    if tid < 0 {
        return 0 - 1;
    }
    let r: i64 = cv_rec_of_typenode(nodes, kids, tid, rdefs);
    if r >= 0 {
        return r;
    }
    let tn: PNode = nodes.get(tid);
    if tn.kind != P_K_TYPE {
        return 0 - 1;
    }
    if tn.child_count == 0 {
        return 0 - 1;
    }
    let mut inst: str = tn.text.concat("__");
    let mut i: i64 = 0;
    while i < tn.child_count {
        let cid: i64 = kids.get(tn.child_start + i);
        let cn: PNode = nodes.get(cid);
        if cn.kind != P_K_TYPE {
            return 0 - 1;
        }
        if cn.child_count > 0 {
            return 0 - 1;
        }
        if i > 0 {
            inst = inst.concat("$");
        }
        inst = inst.concat(cn.text);
        i = i + 1;
    }
    let code: i64 = tc_code_of_name(inst, rdefs);
    if code < TC_REC_BASE {
        return 0 - 1;
    }
    let irec: TcRec = rdefs.get(code - TC_REC_BASE);
    if irec.is_enum {
        return 0 - 1;
    }
    if irec.tpnames.len() > 0 {
        return 0 - 1;
    }
    return code - TC_REC_BASE;
}

// SHP-0b: lower an array literal, a record construct or (SR-032) a tuple literal `eid` written
// to a slot of declared type node `tid` (a record field, an array element). The array's elements
// take the slot's element type, the construct's fields its record's types and the tuple's
// elements the slot's element types, as the oracle types a compound value by its slot all the
// way down. -1 for any other value, or when `tid` is absent: the caller lowers
// the value by the slot's token (cv_slot_var).
fn cv_typed_compound(nodes: Arena<PNode>, kids: Vec<i64>, eid: i64, tid: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    if tid < 0 {
        return 0 - 1;
    }
    let n: PNode = nodes.get(eid);
    if n.kind == P_K_ARRAY {
        let mut eel: str = cv_array_elem_tok(nodes, kids, tid, rdefs);
        if eel.len() == 0 {
            eel = "?";
        }
        let etid: i64 = cv_array_elem_tid(nodes, kids, tid);
        let ad: i64 = cv_fresh("Ptr", base, locals);
        let qa: i64 = cv_emit_array(nodes, kids, ad, eid, base, env, rdefs, sigs, fids, cnames, cvals, eel, etid, locals, stmts);
        return ad;
    }
    if n.kind == P_K_RECORD_CONSTRUCT {
        let xrec: i64 = cv_rec_inst_of_typenode(nodes, kids, tid, rdefs);
        let rd: i64 = cv_fresh("Ptr", base, locals);
        let qr: i64 = cv_emit_rec(nodes, kids, rd, eid, base, env, rdefs, sigs, fids, cnames, cvals, xrec, locals, stmts);
        return rd;
    }
    if n.kind == P_K_TUPLE {
        // SR-032: a tuple literal's elements are typed by the slot's tuple type.
        let tud: i64 = cv_fresh("Ptr", base, locals);
        let qtu: i64 = cv_emit_tuple(nodes, kids, tud, eid, tid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        return tud;
    }
    return 0 - 1;
}

// SHP-0b: the element token of an array type node `tid`, or "" when `tid` is not one (or is
// absent). The slot an array literal is written to dictates its element type through this.
fn cv_array_elem_tok(nodes: Arena<PNode>, kids: Vec<i64>, tid: i64, rdefs: Vec<TcRec>) -> str ! { Alloc } {
    if tid < 0 {
        return "";
    }
    let tn: PNode = nodes.get(tid);
    if tn.kind != P_K_TYPE_ARRAY {
        return "";
    }
    let elid: i64 = kids.get(tn.child_start);
    return ai_airtype_of_typenode(nodes, kids, elid, rdefs);
}

fn cv_to_var_expected(nodes: Arena<PNode>, kids: Vec<i64>, eid: i64, expected_tid: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let ridx: i64 = cv_rec_of_typenode(nodes, kids, expected_tid, rdefs);
    if ridx >= 0 {
        let rec: TcRec = rdefs.get(ridx);
        if rec.is_enum {
            if cv_expr_is_enum_ctor_for(nodes, kids, eid, ridx, env, rdefs, fids) {
            let mut esize: i64 = 0;
            if rec.tpnames.len() == 0 {
                esize = cv_enum_total_size(rdefs, ridx);
            } else {
                esize = cv_enum_inst_size(nodes, kids, rdefs, ridx, expected_tid);
            }
            if esize <= 0 {
                let qp: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                return 0;
            } else {
            }
            let dst: i64 = cv_fresh("Ptr", base, locals);
            let qi: i64 = cv_into(nodes, kids, dst, eid, base, env, rdefs, sigs, fids, cnames, cvals, "Ptr", ridx, esize, expected_tid, locals, stmts);
            return dst;
            } else {
            }
        } else {
        }
    } else {
    }
    // SHP-0b: the slot's declared type decides the value's, as the oracle types a value by the
    // slot it is written to (cv_slot_var); an array literal takes the slot's element type. An
    // absent or unreadable declared type is an untracked slot ("?").
    let mut stok: str = "?";
    if expected_tid >= 0 {
        stok = ai_airtype_of_typenode(nodes, kids, expected_tid, rdefs);
    }
    let en: PNode = nodes.get(eid);
    if en.kind == P_K_TUPLE {
        // SR-032: a tuple literal's elements are typed by the slot's tuple type; an absent or
        // unreadable declared type is a slot this lowering cannot see (-2).
        let mut xtid: i64 = expected_tid;
        if xtid < 0 {
            xtid = 0 - 2;
        }
        let xtd: i64 = cv_fresh("Ptr", base, locals);
        let qxt: i64 = cv_emit_tuple(nodes, kids, xtd, eid, xtid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        return xtd;
    }
    if en.kind == P_K_RECORD_CONSTRUCT {
        let xrec: i64 = cv_rec_of_typenode(nodes, kids, expected_tid, rdefs);
        let xd: i64 = cv_fresh("Ptr", base, locals);
        let qxr: i64 = cv_emit_rec(nodes, kids, xd, eid, base, env, rdefs, sigs, fids, cnames, cvals, xrec, locals, stmts);
        return xd;
    }
    if en.kind == P_K_ARRAY {
        let mut eel: str = cv_array_elem_tok(nodes, kids, expected_tid, rdefs);
        if eel.len() == 0 {
            eel = "?";
        }
        let eetid: i64 = cv_array_elem_tid(nodes, kids, expected_tid);
        let ad: i64 = cv_fresh("Ptr", base, locals);
        let qea: i64 = cv_emit_array(nodes, kids, ad, eid, base, env, rdefs, sigs, fids, cnames, cvals, eel, eetid, locals, stmts);
        return ad;
    }
    return cv_slot_var(nodes, kids, eid, stok, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
}

// SHP-2b: a call to a declared extern, lowered as the oracle's lower_extern_call into `dst`: the
// args left to right, each typed by its param slot, then the CVS_EXTERN stmt, with a = `dst`, or
// -1 when `isunit` (call_dst gives None for a Unit return), s = `name|vA vB …`, and c = the name's
// length (cv_extern_args reads it back). An extern whose return type is unknown ("?") is refused,
// as at a direct call.
fn cv_lower_extern(nodes: Arena<PNode>, kids: Vec<i64>, eid: i64, dst: i64, isunit: bool, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(eid);
    let rtok: str = cv_sig_ret_tok(sigs, n.text);
    if rtok.bytes_eq("?") {
        let qp: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
    }
    let mut args: Vec<str> = Vec::new();
    let mut ai: i64 = 0;
    while ai < n.child_count {
        let agid: i64 = kids.get(n.child_start + ai);
        let aptid: i64 = cv_fn_param_typeid(sigs, n.text, ai);
        let av: i64 = cv_to_var_expected(nodes, kids, agid, aptid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        let avs: str = cv_i64_str(av);
        let vld: str = "v";
        let qa: i64 = args.push(vld.concat(avs));
        ai = ai + 1;
    }
    let sp: str = " ";
    let argstr: str = sp.join(args);
    let n0: str = n.text.concat("|");
    let xs: str = n0.concat(argstr);
    let mut xdst: i64 = dst;
    if isunit {
        xdst = 0 - 1;
    }
    let nlen: i64 = n.text.len();
    let qc: i64 = stmts.push(CvStmt { kind: CVS_EXTERN, a: xdst, b: 0, c: nlen, d: 0, s: xs });
    return 0;
}

// SHP-5b: does `name`, in the fn `fnid`, bind a fixed array: a param or an annotated let of an
// array type, or a let whose value is an array literal? The oracle borrows such a binding as a
// slice (a fat-pointer header it allocates), which this lane does not mirror.
fn cv_name_binds_array(nodes: Arena<PNode>, kids: Vec<i64>, fnid: i64, name: str) -> bool {
    let total: i64 = nodes.len();
    let mut i: i64 = 0;
    while i < total {
        let within: bool = rf_contains(nodes, fnid, i);
        if within {
            let mn: PNode = nodes.get(i);
            let mut namehit: bool = false;
            if mn.kind == P_K_PARAM {
                namehit = rf_seg0_eq(mn.text, name);
            }
            if mn.kind == P_K_LET {
                namehit = mn.text.bytes_eq(name);
            }
            if namehit {
                let mut ci: i64 = 0;
                while ci < mn.child_count {
                    let cid: i64 = kids.get(mn.child_start + ci);
                    let cn: PNode = nodes.get(cid);
                    if cn.kind == P_K_TYPE_ARRAY {
                        return true;
                    }
                    if cn.kind == P_K_ARRAY {
                        return true;
                    }
                    ci = ci + 1;
                }
            }
        }
        i = i + 1;
    }
    return false;
}

// SHP-5b: the index of `name` among the comma-joined segments of `csv`, -1 when absent — the cap
// checker's cap_index_in_csv, cloned so this file composes on its own (air_differential builds its
// tool from the lexer, the parser, the type check and this file only).
fn ai_csv_index(csv: str, name: str) -> i64 {
    let len: i64 = csv.len();
    let mut idx: i64 = 0;
    let mut segstart: i64 = 0;
    let mut i: i64 = 0;
    while i < len {
        let b: i64 = csv.byte_at(i);
        if b == TC_BYTE_COMMA {
            let seg: str = csv.substr(segstart, i);
            if seg.bytes_eq(name) {
                return idx;
            }
            idx = idx + 1;
            segstart = i + 1;
        }
        i = i + 1;
    }
    let last: str = csv.substr(segstart, len);
    if last.bytes_eq(name) {
        return idx;
    }
    return 0 - 1;
}

// SHP-5b: the authority count of a cap type's `auths` segment: 0 when empty, else the comma count
// plus one (the checker's cap_auth_count, cloned as above).
fn ai_auth_count(auths: str) -> i64 {
    let len: i64 = auths.len();
    if len == 0 {
        return 0;
    }
    let mut commas: i64 = 0;
    let mut i: i64 = 0;
    while i < len {
        let b: i64 = auths.byte_at(i);
        if b == TC_BYTE_COMMA {
            commas = commas + 1;
        }
        i = i + 1;
    }
    return commas + 1;
}

// SHP-5b: 2^k by doubling (the subset has no shift): the authority bit at index k, and one more
// than the full mask of k authorities.
fn ai_pow2(k: i64) -> i64 {
    let mut v: i64 = 1;
    let mut i: i64 = 0;
    while i < k {
        v = v * 2;
        i = i + 1;
    }
    return v;
}

// SHP-5b: is `k` one of the four capability-op expression kinds?
fn cv_is_capop_kind(k: i64) -> bool {
    if k == P_K_CAP_RESTRICT {
        return true;
    }
    if k == P_K_CAP_RESTRICT_DEADLINE {
        return true;
    }
    if k == P_K_CAP_SPLIT {
        return true;
    }
    if k == P_K_CAP_DRAW {
        return true;
    }
    return false;
}

// SHP-5b: the cap type a bare annotation names (`Fuel`, or the parametric usage
// `Approval;2030`), "" for every other type node. A reference or a composite is not a cap
// value (the oracle's T100 on such a receiver).
fn cv_cap_type_of_typenode(nodes: Arena<PNode>, tid: i64) -> str {
    let tn: PNode = nodes.get(tid);
    if tn.kind != P_K_TYPE {
        return "";
    }
    if tn.flags != 0 {
        return "";
    }
    if tn.child_count != 0 {
        return "";
    }
    let nm: str = tc_seg_at(tn.text, 0);
    let decl: str = ai_cap_decl_text(nodes, nm);
    if decl.len() == 0 {
        return "";
    }
    return nm;
}

// SHP-5b: the cap type `name` is bound to within `fnid`, as cap_let_type reads it: a param's
// or an annotated let's annotation, or, for an unannotated let, the type of the cap op's
// receiver (MI-3). "" when no binding names a cap type, or two bindings of the name disagree:
// this scan cannot order a shadowing against the use, so it refuses rather than guesses.
// `depth` bounds the receiver chain.
fn cv_cap_type_of_name(nodes: Arena<PNode>, kids: Vec<i64>, fnid: i64, name: str, depth: i64) -> str {
    if depth <= 0 {
        return "";
    }
    let total: i64 = nodes.len();
    let mut found: str = "";
    let mut i: i64 = 0;
    while i < total {
        let within: bool = rf_contains(nodes, fnid, i);
        if within {
            let mn: PNode = nodes.get(i);
            let mut hit: bool = false;
            let mut cand: str = "";
            if mn.kind == P_K_PARAM {
                let pname: bool = rf_seg0_eq(mn.text, name);
                if pname {
                    hit = true;
                    if mn.child_count >= 1 {
                        let ptid: i64 = kids.get(mn.child_start);
                        cand = cv_cap_type_of_typenode(nodes, ptid);
                    }
                }
            }
            if mn.kind == P_K_LET {
                let lname: bool = mn.text.bytes_eq(name);
                if lname {
                    hit = true;
                    if mn.child_count == 2 {
                        let ltid: i64 = kids.get(mn.child_start);
                        cand = cv_cap_type_of_typenode(nodes, ltid);
                    }
                    if mn.child_count == 1 {
                        let lvid: i64 = kids.get(mn.child_start);
                        let lvn: PNode = nodes.get(lvid);
                        let lvop: bool = cv_is_capop_kind(lvn.kind);
                        if lvop {
                            let recv: str = tc_seg_at(lvn.text, 0);
                            cand = cv_cap_type_of_name(nodes, kids, fnid, recv, depth - 1);
                        }
                        // SHP-5c-3: `let t = slot_take(s)` — the cap type of s's slot.
                        if lvn.kind == P_K_CALL {
                            if lvn.text.bytes_eq("slot_take") {
                                if lvn.flags == 0 {
                                    if lvn.child_count == 1 {
                                        let stan: PNode = nodes.get(kids.get(lvn.child_start));
                                        if stan.kind == P_K_PATH {
                                            cand = cv_slot_cap_of_name(nodes, kids, fnid, stan.text, depth - 1);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if hit {
                if cand.len() == 0 {
                    return "";
                }
                if found.len() == 0 {
                    found = cand;
                } else {
                    let same: bool = found.bytes_eq(cand);
                    if !same {
                        return "";
                    }
                }
            }
        }
        i = i + 1;
    }
    return found;
}

// SHP-5c-3: the cap type of a `Slot<C>` type node (a declared cap C), "" otherwise.
fn cv_slot_cap_of_typenode(nodes: Arena<PNode>, kids: Vec<i64>, tid: i64) -> str {
    let tn: PNode = nodes.get(tid);
    if tn.kind != P_K_TYPE {
        return "";
    }
    if tn.flags != 0 {
        return "";
    }
    if tn.child_count != 1 {
        return "";
    }
    if !tn.text.bytes_eq("Slot") {
        return "";
    }
    return cv_cap_type_of_typenode(nodes, kids.get(tn.child_start));
}

// SHP-5c-3: the cap type of the slot `name` is bound to within `fnid`, as cv_cap_type_of_name
// reads a cap's: a `Slot<C>` param or annotated let, an unannotated let bound to
// `slot_new::<C>()` or to another slot-bound name. "" when no binding names one, or two
// bindings disagree (the shadowing discipline of cv_cap_type_of_name).
fn cv_slot_cap_of_name(nodes: Arena<PNode>, kids: Vec<i64>, fnid: i64, name: str, depth: i64) -> str {
    if depth <= 0 {
        return "";
    }
    let total: i64 = nodes.len();
    let mut found: str = "";
    let mut i: i64 = 0;
    while i < total {
        let within: bool = rf_contains(nodes, fnid, i);
        if within {
            let mn: PNode = nodes.get(i);
            let mut hit: bool = false;
            let mut cand: str = "";
            if mn.kind == P_K_PARAM {
                let pname: bool = rf_seg0_eq(mn.text, name);
                if pname {
                    hit = true;
                    if mn.child_count >= 1 {
                        cand = cv_slot_cap_of_typenode(nodes, kids, kids.get(mn.child_start));
                    }
                }
            }
            if mn.kind == P_K_LET {
                let lname: bool = mn.text.bytes_eq(name);
                if lname {
                    hit = true;
                    if mn.child_count == 2 {
                        cand = cv_slot_cap_of_typenode(nodes, kids, kids.get(mn.child_start));
                    }
                    if mn.child_count == 1 {
                        let lvn: PNode = nodes.get(kids.get(mn.child_start));
                        if lvn.kind == P_K_CALL {
                            if lvn.text.bytes_eq("slot_new") {
                                if lvn.flags >= 1 {
                                    cand = cv_cap_type_of_typenode(nodes, kids.get(lvn.child_start));
                                }
                            }
                        }
                        if lvn.kind == P_K_PATH {
                            cand = cv_slot_cap_of_name(nodes, kids, fnid, lvn.text, depth - 1);
                        }
                    }
                }
            }
            if hit {
                if cand.len() == 0 {
                    return "";
                }
                if found.len() == 0 {
                    found = cand;
                } else {
                    let same: bool = found.bytes_eq(cand);
                    if !same {
                        return "";
                    }
                }
            }
        }
        i = i + 1;
    }
    return found;
}

// SHP-5b: `recv.restrict(auth)`, `recv.restrict_deadline(n)`, `recv.split(amount)` and
// `recv.draw(amount)` into `dst` — the oracle's lower_cap_restrict / lower_cap_split /
// lower_cap_draw (air.rs). The receiver is a name resolved in the env (no fresh local). A
// restrict carries the authority's bit, its index in the receiver's cap type decl
// (AuthorityRegistry); a restrict_deadline the full mask (capability_tc.rs: the no-op
// authority restrict). split and draw lower the i64 amount AFTER the receiver is resolved and
// share one kind (one host import, wasm.rs). Anything this cannot read exactly — a receiver
// that is not a Ptr local, a name whose cap type the fn's bindings do not fix, an authority
// the type does not declare, a non-i64 amount — poisons.
fn cv_emit_capop(nodes: Arena<PNode>, kids: Vec<i64>, dst: i64, eid: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(eid);
    let recv: str = tc_seg_at(n.text, 0);
    let src: i64 = cv_env_var(env, recv);
    if src < 0 {
        let qp0: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    }
    let rtok: str = cv_env_tytok(env, recv);
    let rptr: bool = rtok.bytes_eq("Ptr");
    if !rptr {
        let qp1: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    }
    let fnid: i64 = rf_enclosing_fn(nodes, eid);
    if fnid < 0 {
        let qp2: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    }
    let ctype: str = cv_cap_type_of_name(nodes, kids, fnid, recv, 64);
    if ctype.len() == 0 {
        let qp3: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    }
    let decl: str = ai_cap_decl_text(nodes, ctype);
    let auths: str = tc_seg_at(decl, 1);
    if n.kind == P_K_CAP_RESTRICT {
        let auth: str = tc_seg_at(n.text, 1);
        let aidx: i64 = ai_csv_index(auths, auth);
        if aidx < 0 {
            let qp4: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            return 0;
        }
        let bit: i64 = ai_pow2(aidx);
        let qr: i64 = stmts.push(CvStmt { kind: CVS_CAPRESTRICT, a: dst, b: src, c: bit, d: 0, s: auth });
        return 0;
    }
    if n.kind == P_K_CAP_RESTRICT_DEADLINE {
        let count: i64 = ai_auth_count(auths);
        let full: i64 = ai_pow2(count) - 1;
        let qd: i64 = stmts.push(CvStmt { kind: CVS_CAPRESTRICT, a: dst, b: src, c: full, d: 0, s: "" });
        return 0;
    }
    if n.child_count != 1 {
        let qp5: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    }
    let aid: i64 = kids.get(n.child_start);
    let atok: str = cv_expr_tytok(nodes, kids, aid, env, rdefs, sigs, cnames, cvals);
    let ai64: bool = atok.bytes_eq("I64");
    if !ai64 {
        let qp6: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    }
    let amt: i64 = cv_to_var(nodes, kids, aid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
    let mut isdraw: i64 = 0;
    if n.kind == P_K_CAP_DRAW {
        isdraw = 1;
    }
    let qs: i64 = stmts.push(CvStmt { kind: CVS_CAPSPLIT, a: dst, b: src, c: amt, d: isdraw, s: "" });
    return 0;
}

// SHP-5b: the oracle's Declassify / DeclassifyCt lowering (air.rs lower_expr_into_at): the value's
// src local is freshed FIRST (`__release_src`, the value's type), the value is lowered into it,
// the cap operand becomes a var (a bare local reuses its own), then the dead ownership sink is
// freshed (`__declassify_cap`, Ptr), and one SecurityRelease{dst, src, cap, sink} follows. The
// constant-time stage differs only in the taint contract, which this lane does not carry. A
// value whose type this lane cannot name poisons (fail closed).
fn cv_emit_release(nodes: Arena<PNode>, kids: Vec<i64>, dst: i64, eid: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(eid);
    if n.child_count != 2 {
        let qp0: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    }
    let vid: i64 = kids.get(n.child_start);
    let cid: i64 = kids.get(n.child_start + 1);
    let vtok: str = cv_expr_tytok(nodes, kids, vid, env, rdefs, sigs, cnames, cvals);
    let vknown: bool = cv_ty_known(vtok);
    if !vknown {
        let qp1: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    }
    let src: i64 = cv_fresh(vtok, base, locals);
    let qv: i64 = cv_into(nodes, kids, src, vid, base, env, rdefs, sigs, fids, cnames, cvals, vtok, 0 - 1, 0, 0 - 1, locals, stmts);
    let capv: i64 = cv_to_var(nodes, kids, cid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
    let sink: i64 = cv_fresh("Ptr", base, locals);
    let qr: i64 = stmts.push(CvStmt { kind: CVS_RELEASE, a: dst, b: src, c: capv, d: sink, s: "" });
    return 0;
}

// SHP-5b: the oracle's non-slice Borrow (air.rs TypedExprKind::Borrow): the inner to a var, then
// Borrow{dst, src}, a pointer copy in wasm.rs. Only a bare, unqualified local of a pointer type
// that binds no fixed array is mirrored: an array borrow decays to a slice (a fat-pointer header
// the oracle allocates), a range borrow is its own lowering, and an element-typed binding (an
// array, a vec) is left to those; all poison, as no accepted program holds one.
fn cv_emit_borrow(nodes: Arena<PNode>, kids: Vec<i64>, dst: i64, eid: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(eid);
    if n.child_count != 1 {
        let qp0: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    }
    let iid: i64 = kids.get(n.child_start);
    let inn: PNode = nodes.get(iid);
    if inn.kind != P_K_PATH {
        let qp1: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    }
    let cc: i64 = tc_last_colons(inn.text);
    if cc >= 0 {
        let qp2: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    }
    let itok: str = cv_env_tytok(env, inn.text);
    let iptr: bool = itok.bytes_eq("Ptr");
    if !iptr {
        let qp3: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    }
    let ielem: str = cv_env_elem(env, inn.text);
    let ielen: i64 = ielem.len();
    if ielen > 0 {
        let qp4: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    }
    let fnid: i64 = rf_enclosing_fn(nodes, eid);
    if fnid < 0 {
        let qp5: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    }
    let isarr: bool = cv_name_binds_array(nodes, kids, fnid, inn.text);
    if isarr {
        let qp6: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    }
    let src: i64 = cv_to_var(nodes, kids, iid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
    let qb: i64 = stmts.push(CvStmt { kind: CVS_BORROW, a: dst, b: src, c: 0, d: 0, s: "" });
    return 0;
}

fn cv_to_var(nodes: Arena<PNode>, kids: Vec<i64>, eid: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(eid);
    if n.kind == P_K_PATH {
        let cc: i64 = tc_last_colons(n.text);
        if cc >= 0 {
            // SH-AIR-CV-3: a field READ (fresh dst + LF with the real offset) or an enum UNIT
            // construct (the pre-memory BA/tag/SF cell — the Ptr dst freshes FIRST, then the I32
            // tag; air.rs:3555 via the alloc-then-recurse split).
            let tlen: i64 = n.text.len();
            let fbase: str = n.text.substr(0, cc);
            let fseg: str = n.text.substr(cc + 2, tlen);
            let bvar: i64 = cv_env_var(env, fbase);
            let brec: i64 = cv_env_rec(env, fbase);
            if bvar >= 0 {
                if brec >= 0 {
                    let foff: i64 = cv_field_off(rdefs, brec, fseg);
                    if foff >= 0 {
                        let ftok: str = cv_field_tok(rdefs, brec, fseg);
                        let fd: i64 = cv_fresh(ftok, base, locals);
                        let qlf: i64 = stmts.push(CvStmt { kind: CVS_LF2, a: fd, b: bvar, c: foff, d: 0, s: ftok });
                        return fd;
                    } else {
                    }
                } else {
                }
            } else {
            }
            let ecode: i64 = tc_code_of_name(fbase, rdefs);
            if ecode >= TC_REC_BASE {
                let eridx: i64 = ecode - TC_REC_BASE;
                let erec: TcRec = rdefs.get(eridx);
                if erec.is_enum {
                    let vidx: i64 = tc_variant_index(rdefs, eridx, fseg);
                    if vidx >= 0 {
                        if erec.tpnames.len() > 0 {
                            let qpu: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                            return 0;
                        } else {
                        }
                        let ed: i64 = cv_fresh("Ptr", base, locals);
                        let tsz: i64 = cv_enum_total_size(rdefs, eridx);
                        let qba: i64 = stmts.push(CvStmt { kind: CVS_BA, a: ed, b: tsz, c: 4, d: 0, s: "" });
                        let etg: i64 = cv_fresh("I32", base, locals);
                        let qtg: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: etg, b: vidx, c: 0, d: 0, s: "" });
                        let qsf: i64 = stmts.push(CvStmt { kind: CVS_SF, a: ed, b: etg, c: 0, d: 0, s: "I32" });
                        return ed;
                    } else {
                    }
                } else {
                }
            } else {
            }
            let qpq: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            return 0;
        } else {
        }
        let v: i64 = cv_env_var(env, n.text);
        if v >= 0 {
            return v;
        } else {
        }
        // ST-1: a BARE unit enum variant `A` — a fallback AFTER the local miss
        // (X-ST1 precedence: local > variant). Mirrors the qualified E::A cell.
        // SR-032 review: a bare variant that several enums declare takes the enum of the
        // slot it is written to, in production. With no slot in view here (an argument of a
        // generic instance, whose slot cv_call_arg_tid hides, or a record field), the first
        // declaring enum below may not be that one, so the variant is refused.
        if tc_count_enums_with_variant(rdefs, n.text) >= 2 {
            let qamb1: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            return 0;
        }
        let bvcode: i64 = tc_enum_of_variant(rdefs, n.text);
        if bvcode >= TC_REC_BASE {
            let bveridx: i64 = bvcode - TC_REC_BASE;
            let bvvidx: i64 = tc_variant_index(rdefs, bveridx, n.text);
            let bverec: TcRec = rdefs.get(bveridx);
            if bverec.tpnames.len() > 0 {
                let qpbu: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                return 0;
            } else {
            }
            let bved: i64 = cv_fresh("Ptr", base, locals);
            let bvtsz: i64 = cv_enum_total_size(rdefs, bveridx);
            let bvba: i64 = stmts.push(CvStmt { kind: CVS_BA, a: bved, b: bvtsz, c: 4, d: 0, s: "" });
            let bvtg: i64 = cv_fresh("I32", base, locals);
            let bvat: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: bvtg, b: bvvidx, c: 0, d: 0, s: "" });
            let bvsf: i64 = stmts.push(CvStmt { kind: CVS_SF, a: bved, b: bvtg, c: 0, d: 0, s: "I32" });
            return bved;
        } else {
        }
        // W-CONST: a top-level const reference (env + variant both missed) INLINES as a
        // fresh IntLit temp (the oracle's lowering; reference order = fresh order).
        let cvv: i64 = cv_ctbl_find(cnames, cvals, n.text);
        if cvv >= 0 {
            let cd: i64 = cv_fresh("I64", base, locals);
            let qci: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: cd, b: cvv, c: 0, d: 0, s: "" });
            return cd;
        } else {
        }
        // SHP-5c-3: a lexical region's name used as a value — the oracle materialises the inert
        // `0` handle into a fresh i64 local per use (air.rs materialize_region_handle; the
        // block binds no local for the name).
        if cv_region_name_encloses(nodes, eid, n.text) {
            let rhd: i64 = cv_fresh("I64", base, locals);
            let qrh: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: rhd, b: 0, c: 0, d: 0, s: "" });
            return rhd;
        }
        let qp: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    } else {
    }
    if n.kind == P_K_CALL {
        let ccc: i64 = tc_last_colons(n.text);
        if ccc < 0 {
            // B-VEC: the memory intrinsics dispatch BEFORE the fid lookup (no user sig/fid).
            let vi: i64 = cv_emit_vecintr(nodes, kids, 0 - 1, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            if vi >= 0 {
                return vi;
            } else {
            }
            let fid: i64 = cv_fid_find(fids, n.text);
            if fid >= 0 {
                // X6: the call dst freshes BEFORE the args; dst renders None iff the callee
                // returns Unit (call_dst, air.rs:5183) — the Unit dst is a PHANTOM local.
                let rtok: str = cv_sig_ret_tok(sigs, n.text);
                // SHP-0b: an unknown return type ("?") is refused, as at the method call.
                let runk: bool = rtok.bytes_eq("?");
                if runk {
                    let qpr: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                }
                let cd: i64 = cv_fresh(rtok, base, locals);
                let mut cargs: Vec<str> = Vec::new();
                let mut cai: i64 = 0;
                while cai < n.child_count {
                    let agid: i64 = kids.get(n.child_start + cai);
                    let aptid: i64 = cv_call_arg_tid(nodes, kids, sigs, n.text, cai, rdefs);
                    let av2: i64 = cv_to_var_expected(nodes, kids, agid, aptid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                    let avs: str = cv_i64_str(av2);
                    let vld: str = "v";
                    let avv: str = vld.concat(avs);
                    let qav: i64 = cargs.push(avv);
                    cai = cai + 1;
                }
                let asp: str = " ";
                let argstr: str = asp.join(cargs);
                let mut cdst: i64 = cd;
                let isu: bool = rtok.bytes_eq("Unit");
                if isu {
                    cdst = 0 - 1;
                } else {
                }
                let qcl: i64 = stmts.push(CvStmt { kind: CVS_CALL, a: cdst, b: fid, c: 0, d: 0, s: argstr });
                return cd;
            } else {
            }
            // SHP-2b: a call to a declared extern (no fid; its sig carries is_extern): the dst
            // freshes BEFORE the args (X6, as at a free call), then cv_lower_extern.
            let xsi: i64 = tc_sig_find(sigs, n.text);
            if xsi >= 0 {
                let xsg: TcSig = sigs.get(xsi);
                if xsg.is_extern {
                    let xrtok: str = cv_sig_ret_tok(sigs, n.text);
                    let xd: i64 = cv_fresh(xrtok, base, locals);
                    let xunit: bool = xrtok.bytes_eq("Unit");
                    let qxl: i64 = cv_lower_extern(nodes, kids, eid, xd, xunit, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                    return xd;
                }
            }
            // ST-1: a BARE payload enum variant `B(x)` — a fallback AFTER the
            // free-fn miss (X-ST1). A bare call's args start at child 0 (pstart).
            // SR-032 review: a bare variant that several enums declare takes the enum of the
            // slot it is written to, in production. With no slot in view here (an argument of a
            // generic instance, whose slot cv_call_arg_tid hides, or a record field), the first
            // declaring enum below may not be that one, so the variant is refused.
            if tc_count_enums_with_variant(rdefs, n.text) >= 2 {
                let qamb2: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                return 0;
            }
            let pvcode: i64 = tc_enum_of_variant(rdefs, n.text);
            if pvcode >= TC_REC_BASE {
                let pveridx: i64 = pvcode - TC_REC_BASE;
                let pvvidx: i64 = tc_variant_index(rdefs, pveridx, n.text);
                let pved: i64 = cv_fresh("Ptr", base, locals);
                let pvq: i64 = cv_emit_enum_ctor(nodes, kids, pved, eid, pveridx, pvvidx, 0, 0, 0 - 2, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                return pved;
            } else {
            }
        } else {
        }
        let qpc: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    } else {
    }
    if n.kind == P_K_LIT_INT {
        let d1: i64 = cv_fresh("I64", base, locals);
        let q1: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: d1, b: n.value, c: 0, d: 0, s: "" });
        return d1;
    } else {
    }
    if n.kind == P_K_LIT_BOOL {
        let d2: i64 = cv_fresh("Bool", base, locals);
        let q2: i64 = stmts.push(CvStmt { kind: CVS_AS_BOOL, a: d2, b: n.value, c: 0, d: 0, s: "" });
        return d2;
    } else {
    }
    if n.kind == P_K_BINARY {
        let ty: str = cv_expr_tytok(nodes, kids, eid, env, rdefs, sigs, cnames, cvals);
        let d3: i64 = cv_fresh(ty, base, locals);
        let opty: str = cv_binop_operand_ty(nodes, kids, n, env, rdefs, sigs, cnames, cvals);
        let lid: i64 = kids.get(n.child_start);
        let rid: i64 = kids.get(n.child_start + 1);
        let lv: i64 = cv_binop_mat(nodes, kids, lid, opty, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        let rv: i64 = cv_binop_mat(nodes, kids, rid, opty, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        let q3: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: d3, b: lv, c: n.value, d: rv, s: "" });
        return d3;
    } else {
    }
    if n.kind == P_K_TUPLE {
        // SR-032: lowered here without its slot's type node, so the slot is hidden (-2).
        let ttd: i64 = cv_fresh("Ptr", base, locals);
        let qtt: i64 = cv_emit_tuple(nodes, kids, ttd, eid, 0 - 2, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        return ttd;
    } else {
    }
    if n.kind == P_K_RECORD_CONSTRUCT {
        let rd: i64 = cv_fresh("Ptr", base, locals);
        let qe1: i64 = cv_emit_rec(nodes, kids, rd, eid, base, env, rdefs, sigs, fids, cnames, cvals, 0 - 1, locals, stmts);
        return rd;
    } else {
    }
    if n.kind == P_K_ARRAY {
        let ad: i64 = cv_fresh("Ptr", base, locals);
        let qe2: i64 = cv_emit_array(nodes, kids, ad, eid, base, env, rdefs, sigs, fids, cnames, cvals, "?", 0 - 1, locals, stmts);
        return ad;
    } else {
    }
    if n.kind == P_K_LIT_STR {
        let sd: i64 = cv_fresh("Ptr", base, locals);
        let qe3: i64 = cv_emit_string(sd, n.text, base, locals, stmts);
        return sd;
    } else {
    }
    if n.kind == P_K_METHOD {
        // W-STR-A: str intrinsic methods (len/byte_at/substr on a Str-token receiver)
        // dispatch BEFORE the enum-ctor/ST-2 paths (no fid, no record).
        let sdi: i64 = cv_emit_strintr(nodes, kids, 0 - 1, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        if sdi >= 0 {
            return sdi;
        } else {
        }
        if sdi == 0 - 1 {
            // poison pushed — return the SAFE var id (the cv_to_var convention; a negative
            // id would flow into wb_uleb and never terminate).
            return 0;
        } else {
        }
        // W-STR-B: the stdlib-desugar methods (concat/bytes_eq/join/contains/itoa).
        let sdd: i64 = cv_emit_strdesugar(nodes, kids, 0 - 1, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        if sdd >= 0 {
            return sdd;
        } else {
        }
        if sdd == 0 - 1 {
            return 0;
        } else {
        }
        // SH-AIR-CV-4: the enum PAYLOAD ctor `E::B(args)` (2c's detection: child0 resolves via
        // rdefs to is_enum + the text is a variant). A real dot-method PANICS the oracle.
        if n.child_count >= 1 {
            let mrid: i64 = kids.get(n.child_start);
            let mrn: PNode = nodes.get(mrid);
            if mrn.kind == P_K_PATH {
                let mcode: i64 = tc_code_of_name(mrn.text, rdefs);
                if mcode >= TC_REC_BASE {
                    let meridx: i64 = mcode - TC_REC_BASE;
                    let merec: TcRec = rdefs.get(meridx);
                    if merec.is_enum {
                        let mvidx: i64 = tc_variant_index(rdefs, meridx, n.text);
                        if mvidx >= 0 {
                            let med: i64 = cv_fresh("Ptr", base, locals);
                            let qe4: i64 = cv_emit_enum_ctor(nodes, kids, med, eid, meridx, mvidx, 1, 0, 0 - 2, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                            return med;
                        } else {
                        }
                    } else {
                    }
                } else {
                }
                // ST-2: a DOT-METHOD `p.get(args)` — child0 is a record VALUE
                // (mrv a local, mrr its record). Desugar to Call({Type}__{method},
                // [receiver, ...args]) — the oracle's type-check desugar; receiver
                // is arg0 (X-ST2). Not-a-record → falls through to POISON (loud).
                // B-DISPATCH: the receiver may be a bare local (`p.get()`) OR one field hop
                // (`self.store.push(..)` — a colon path). cv_recv_rec resolves the record
                // either way; a COLON receiver materializes via cv_to_var (the LoadField
                // temp) AFTER the call dst freshes (X6 — the oracle lowers receiver as arg0).
                let mcol: i64 = tc_last_colons(mrn.text);
                let mut mgate: bool = false;
                if mcol < 0 {
                    let mbv: i64 = cv_env_var(env, mrn.text);
                    if mbv >= 0 {
                        mgate = true;
                    } else {
                    }
                } else {
                    mgate = true;
                }
                let mrr: i64 = cv_recv_rec(env, rdefs, mrn.text);
                if mgate {
                    if mrr >= 0 {
                        let mrec2: TcRec = rdefs.get(mrr);
                        let mtail: str = tc_seg_at(n.text, 0);
                        // SH-MONO MONO-7: a PRE-RESOLVED generic-method call (mn_expand set flag
                        // 2^21 + patched n.text to the full instance mangle `Box__get__i64`).
                        // Use n.text DIRECTLY as the fid key AND the free-fn ret-sig key (the
                        // instance is a top-level fn, registered under that name) — the ordinary
                        // `{Type}__{method}` mangle would yield `Box__i64__get` (wrong order).
                        // Byte-safe: only mn_expand sets 2^21, so every non-monomorph W-lane
                        // composition takes the else-branch and emits identical bytes.
                        let mpre7: i64 = n.flags & 2097152;
                        let mut mmang: str = "";
                        let mut mrkey: str = "";
                        if mpre7 > 0 {
                            mmang = n.text;
                            mrkey = n.text;
                        } else {
                            let msep: str = mrec2.name.concat("__");
                            mmang = msep.concat(mtail);
                            let mrsep: str = mrec2.name.concat("::");
                            mrkey = mrsep.concat(mtail);
                        }
                        let mfid: i64 = cv_fid_find(fids, mmang);
                        if mfid >= 0 {
                            let mrtok: str = cv_sig_ret_tok(sigs, mrkey);
                            // SHP-0b: a callee whose return type is unknown ("?", no registered
                            // signature) is refused. Its dst became a "?" local the call then
                            // stored into, a result a void method does not have.
                            let munk: bool = mrtok.bytes_eq("?");
                            if munk {
                                let qpm: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                            }
                            let mcd: i64 = cv_fresh(mrtok, base, locals);
                            let mut mrv: i64 = 0 - 1;
                            if mcol < 0 {
                                mrv = cv_env_var(env, mrn.text);
                            } else {
                                mrv = cv_to_var(nodes, kids, mrid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                            }
                            let mut margs: Vec<str> = Vec::new();
                            let mlead: str = "v";
                            let mrv0: str = mlead.concat(cv_i64_str(mrv));
                            let qm0: i64 = margs.push(mrv0);
                            let mut mmi: i64 = 1;
                            while mmi < n.child_count {
                                let magid: i64 = kids.get(n.child_start + mmi);
                                // SHP-0b: argument k is the method's parameter k (`self` is 0),
                                // typed by that slot like a free call's (cv_to_var_expected).
                                let maptid: i64 = cv_fn_param_typeid(sigs, mrkey, mmi);
                                let mav: i64 = cv_to_var_expected(nodes, kids, magid, maptid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                                let mavv: str = mlead.concat(cv_i64_str(mav));
                                let qma: i64 = margs.push(mavv);
                                mmi = mmi + 1;
                            }
                            let msp: str = " ";
                            let margstr: str = msp.join(margs);
                            let mut mdst: i64 = mcd;
                            let misu: bool = mrtok.bytes_eq("Unit");
                            if misu {
                                mdst = 0 - 1;
                            } else {
                            }
                            let qmcl: i64 = stmts.push(CvStmt { kind: CVS_CALL, a: mdst, b: mfid, c: 0, d: 0, s: margstr });
                            return mcd;
                        } else {
                        }
                    } else {
                    }
                } else {
                }
            } else {
            }
        } else {
        }
        let qpm: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    } else {
    }
    if n.kind == P_K_INDEX {
        // SH-AIR-CV-4: the index READ — dst first (X6), then the index mat, then the bounds
        // chain (elided for a literal index, #442), then LD by the ORIGINAL index var.
        let xrid: i64 = kids.get(n.child_start);
        let xrn: PNode = nodes.get(xrid);
        let mut xok: bool = false;
        let mut arrv: i64 = 0 - 1;
        let mut etok: str = "";
        if xrn.kind == P_K_PATH {
            arrv = cv_env_var(env, xrn.text);
            etok = cv_env_elem(env, xrn.text);
            if arrv >= 0 {
                if etok.len() > 0 {
                    xok = true;
                } else {
                }
            } else {
            }
        } else {
        }
        if xok {
            let xd: i64 = cv_fresh(etok, base, locals);
            let xiid: i64 = kids.get(n.child_start + 1);
            let xin: PNode = nodes.get(xiid);
            let xiv: i64 = cv_to_var(nodes, kids, xiid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            if xin.kind == P_K_LIT_INT {
            } else {
                // RF-M3 (SHP-5a): an access a guard on its loop var narrows is poisoned.
                let xrg: bool = rf_index_guarded(nodes, kids, eid);
                if xrg {
                    let qpg: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                    return 0;
                }
                // RF-M2: a covered range-for loop var elides the chain too (rf_index_elided).
                let xre: bool = rf_index_elided(nodes, kids, eid);
                if xre {
                } else {
                    let qch: i64 = cv_index_check(nodes, kids, xiid, xiv, arrv, base, env, rdefs, sigs, cnames, cvals, locals, stmts);
                }
            }
            let xw: i64 = cv_ty_width(etok);
            let qld: i64 = stmts.push(CvStmt { kind: CVS_LD_ELEM, a: xd, b: arrv, c: xiv, d: xw, s: etok });
            return xd;
        } else {
        }
        let qpx: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    } else {
    }
    // SHP-5b: a release types as its value, a borrow as Ptr (lower_expr_to_var: a fresh dst,
    // then the into lowering).
    if n.kind == P_K_DECLASSIFY {
        let rlt: str = cv_expr_tytok(nodes, kids, eid, env, rdefs, sigs, cnames, cvals);
        let rlk: bool = cv_ty_known(rlt);
        if !rlk {
            let qrlp: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            return 0;
        }
        let rld: i64 = cv_fresh(rlt, base, locals);
        let qrl: i64 = cv_emit_release(nodes, kids, rld, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        return rld;
    }
    if n.kind == P_K_DECLASSIFY_CT {
        let rct: str = cv_expr_tytok(nodes, kids, eid, env, rdefs, sigs, cnames, cvals);
        let rck: bool = cv_ty_known(rct);
        if !rck {
            let qrcp: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            return 0;
        }
        let rcd: i64 = cv_fresh(rct, base, locals);
        let qrc: i64 = cv_emit_release(nodes, kids, rcd, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        return rcd;
    }
    if n.kind == P_K_BORROW {
        let bwd: i64 = cv_fresh("Ptr", base, locals);
        let qbw: i64 = cv_emit_borrow(nodes, kids, bwd, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        return bwd;
    }
    let capop: bool = cv_is_capop_kind(n.kind);
    if capop {
        let cod: i64 = cv_fresh("Ptr", base, locals);
        let qco: i64 = cv_emit_capop(nodes, kids, cod, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        return cod;
    }
    let qz: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
    return 0;
}

// Mirror `lower_expr_into(dst, e)` (air.rs:1839) on the CV-1 surface: a local -> the never-elided
// `Var` copy; a literal -> DIRECTLY into dst (no temp — Phase-0 `let_lit`); a binary -> operand
// to_vars (freshed AFTER dst — X6) then the Bin into dst.
// `drec`/`dsz` carry an expected enum identity and its exact concrete cell size. A generic enum
// constructor without that context or complete payload inference poisons instead of using the
// generic definition's placeholder widths.
// SR-032: `dtid` is the destination slot's type node, or -1 when production gives the value no
// slot (an unannotated `let`, an expression statement), or -2 when production types it by a slot
// this lowering cannot see; a tuple literal (cv_emit_tuple) and a generic enum construct's
// type-parameter payloads (cv_emit_enum_ctor) are typed by it.
fn cv_into(nodes: Arena<PNode>, kids: Vec<i64>, dst: i64, eid: i64, base: i64, env: Vec<CvBind>, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, dstty: str, drec: i64, dsz: i64, dtid: i64, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut) -> i64 ! { Alloc } {
    let n: PNode = nodes.get(eid);
    if n.kind == P_K_PATH {
        let cc: i64 = tc_last_colons(n.text);
        if cc >= 0 {
            // SH-AIR-CV-3 (into): a field READ loads DIRECTLY into dst (reg1's no-trailing-Assign
            // rule at operand level); an enum UNIT constructs into the given dst.
            let tlen: i64 = n.text.len();
            let fbase: str = n.text.substr(0, cc);
            let fseg: str = n.text.substr(cc + 2, tlen);
            let bvar: i64 = cv_env_var(env, fbase);
            let brec: i64 = cv_env_rec(env, fbase);
            if bvar >= 0 {
                if brec >= 0 {
                    let foff: i64 = cv_field_off(rdefs, brec, fseg);
                    if foff >= 0 {
                        let ftok: str = cv_field_tok(rdefs, brec, fseg);
                        let qlf: i64 = stmts.push(CvStmt { kind: CVS_LF2, a: dst, b: bvar, c: foff, d: 0, s: ftok });
                        return 0;
                    } else {
                    }
                } else {
                }
            } else {
            }
            let ecode: i64 = tc_code_of_name(fbase, rdefs);
            if ecode >= TC_REC_BASE {
                let eridx: i64 = ecode - TC_REC_BASE;
                let erec: TcRec = rdefs.get(eridx);
                if erec.is_enum {
                    let vidx: i64 = tc_variant_index(rdefs, eridx, fseg);
                    if vidx >= 0 {
                        if erec.tpnames.len() > 0 {
                            if dsz <= 0 {
                                let qpu: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                                return 0;
                            } else {
                            }
                        } else {
                        }
                        let mut tsz: i64 = cv_enum_total_size(rdefs, eridx);
                        if dsz > 0 {
                            tsz = dsz;
                        } else {
                        }
                        let qba: i64 = stmts.push(CvStmt { kind: CVS_BA, a: dst, b: tsz, c: 4, d: 0, s: "" });
                        let etg: i64 = cv_fresh("I32", base, locals);
                        let qtg: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: etg, b: vidx, c: 0, d: 0, s: "" });
                        let qsf: i64 = stmts.push(CvStmt { kind: CVS_SF, a: dst, b: etg, c: 0, d: 0, s: "I32" });
                        return 0;
                    } else {
                    }
                } else {
                }
            } else {
            }
            let qpq: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            return 0;
        } else {
        }
        let v: i64 = cv_env_var(env, n.text);
        if v >= 0 {
            let q0: i64 = stmts.push(CvStmt { kind: CVS_AS_VAR, a: dst, b: v, c: 0, d: 0, s: "" });
            return 0;
        } else {
        }
        // ST-1: a BARE unit enum variant `A` into dst (X-ST1 fallback).
        let mut bveridx: i64 = 0 - 1;
        if drec >= 0 {
            let dr: TcRec = rdefs.get(drec);
            if dr.is_enum {
                if tc_variant_index(rdefs, drec, n.text) >= 0 {
                    bveridx = drec;
                } else {
                }
            } else {
            }
        } else {
        }
        if bveridx < 0 {
            // SR-032 review: the destination's enum did not declare the variant, so no slot
            // decides which enum several declarers mean; refused (see cv_to_var's ST-1).
            if tc_count_enums_with_variant(rdefs, n.text) >= 2 {
                let qamb3: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                return 0;
            }
            let bvcode: i64 = tc_enum_of_variant(rdefs, n.text);
            if bvcode >= TC_REC_BASE {
                bveridx = bvcode - TC_REC_BASE;
            } else {
            }
        } else {
        }
        if bveridx >= 0 {
            let bvvidx: i64 = tc_variant_index(rdefs, bveridx, n.text);
            let bverec: TcRec = rdefs.get(bveridx);
            if bverec.tpnames.len() > 0 {
                if dsz <= 0 {
                    let qpbu: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                    return 0;
                } else {
                }
            } else {
            }
            let mut bvtsz: i64 = cv_enum_total_size(rdefs, bveridx);
            if dsz > 0 {
                bvtsz = dsz;
            } else {
            }
            let bvba: i64 = stmts.push(CvStmt { kind: CVS_BA, a: dst, b: bvtsz, c: 4, d: 0, s: "" });
            let bvtg: i64 = cv_fresh("I32", base, locals);
            let bvat: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: bvtg, b: bvvidx, c: 0, d: 0, s: "" });
            let bvsf: i64 = stmts.push(CvStmt { kind: CVS_SF, a: dst, b: bvtg, c: 0, d: 0, s: "I32" });
            return 0;
        } else {
        }
        // W-INTOCONST: a top-level const reference as the INTO value (env + variant both
        // missed) INLINES as Assign dst IntLit — the assign-RHS twin of cv_to_var's W-CONST
        // fallback (`op = T_PLUS;` — the shape behind the whole parser-binop/tc/tt cluster).
        let cvv2: i64 = cv_ctbl_find(cnames, cvals, n.text);
        if cvv2 >= 0 {
            let qci2: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: dst, b: cvv2, c: 0, d: 0, s: "" });
            return 0;
        } else {
        }
        // SHP-5c-3: a lexical region's name into dst is `Assign dst IntLit(0)`, the oracle's
        // inert handle (air.rs lower_expr_into, the `Type::Region` local arm).
        if cv_region_name_encloses(nodes, eid, n.text) {
            let qrh2: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: dst, b: 0, c: 0, d: 0, s: "" });
            return 0;
        }
        let qp: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    } else {
    }
    if n.kind == P_K_CALL {
        let ccc: i64 = tc_last_colons(n.text);
        if ccc < 0 {
            // B-VEC: the memory intrinsics dispatch BEFORE the fid lookup (into the given dst).
            let vi2: i64 = cv_emit_vecintr(nodes, kids, dst, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            if vi2 >= 0 {
                return 0;
            } else {
            }
            let fid: i64 = cv_fid_find(fids, n.text);
            if fid >= 0 {
                let mut cargs: Vec<str> = Vec::new();
                let mut cai: i64 = 0;
                while cai < n.child_count {
                    let agid: i64 = kids.get(n.child_start + cai);
                    let aptid: i64 = cv_call_arg_tid(nodes, kids, sigs, n.text, cai, rdefs);
                    let av2: i64 = cv_to_var_expected(nodes, kids, agid, aptid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                    let avs: str = cv_i64_str(av2);
                    let vld: str = "v";
                    let avv: str = vld.concat(avs);
                    let qav: i64 = cargs.push(avv);
                    cai = cai + 1;
                }
                let asp: str = " ";
                let argstr: str = asp.join(cargs);
                let mut cdst: i64 = dst;
                let isu: bool = dstty.bytes_eq("Unit");
                if isu {
                    cdst = 0 - 1;
                } else {
                }
                let qcl: i64 = stmts.push(CvStmt { kind: CVS_CALL, a: cdst, b: fid, c: 0, d: 0, s: argstr });
                return 0;
            } else {
            }
            // SHP-2b: a call to a declared extern, into the given dst (cv_lower_extern, as in
            // cv_to_var).
            let xsi2: i64 = tc_sig_find(sigs, n.text);
            if xsi2 >= 0 {
                let xsg2: TcSig = sigs.get(xsi2);
                if xsg2.is_extern {
                    let xunit2: bool = dstty.bytes_eq("Unit");
                    let qxl2: i64 = cv_lower_extern(nodes, kids, eid, dst, xunit2, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                    return 0;
                }
            }
            // ST-1: a BARE payload enum variant `B(x)` into dst (X-ST1 fallback).
            let mut pveridx: i64 = 0 - 1;
            if drec >= 0 {
                let drp: TcRec = rdefs.get(drec);
                if drp.is_enum {
                    if tc_variant_index(rdefs, drec, n.text) >= 0 {
                        pveridx = drec;
                    } else {
                    }
                } else {
                }
            } else {
            }
            if pveridx < 0 {
                // SR-032 review: as for the unit variant above.
                if tc_count_enums_with_variant(rdefs, n.text) >= 2 {
                    let qamb4: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                    return 0;
                }
                let pvcode: i64 = tc_enum_of_variant(rdefs, n.text);
                if pvcode >= TC_REC_BASE {
                    pveridx = pvcode - TC_REC_BASE;
                } else {
                }
            } else {
            }
            if pveridx >= 0 {
                let pvvidx: i64 = tc_variant_index(rdefs, pveridx, n.text);
                let pvq: i64 = cv_emit_enum_ctor(nodes, kids, dst, eid, pveridx, pvvidx, 0, dsz, dtid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                return 0;
            } else {
            }
        } else {
        }
        let qpc: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    } else {
    }
    if n.kind == P_K_LIT_INT {
        let q1: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: dst, b: n.value, c: 0, d: 0, s: "" });
        return 0;
    } else {
    }
    if n.kind == P_K_LIT_BOOL {
        let q2: i64 = stmts.push(CvStmt { kind: CVS_AS_BOOL, a: dst, b: n.value, c: 0, d: 0, s: "" });
        return 0;
    } else {
    }
    if n.kind == P_K_BINARY {
        let isc2: bool = cv_op_is_cmp(n.value);
        let mut opty: str = dstty;
        if isc2 {
            opty = cv_binop_operand_ty(nodes, kids, n, env, rdefs, sigs, cnames, cvals);
        } else {
        }
        let lid: i64 = kids.get(n.child_start);
        let rid: i64 = kids.get(n.child_start + 1);
        let lv: i64 = cv_binop_mat(nodes, kids, lid, opty, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        let rv: i64 = cv_binop_mat(nodes, kids, rid, opty, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        let q3: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: dst, b: lv, c: n.value, d: rv, s: "" });
        return 0;
    } else {
    }
    if n.kind == P_K_TUPLE {
        let qtt: i64 = cv_emit_tuple(nodes, kids, dst, eid, dtid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        return 0;
    } else {
    }
    if n.kind == P_K_RECORD_CONSTRUCT {
        let qe1: i64 = cv_emit_rec(nodes, kids, dst, eid, base, env, rdefs, sigs, fids, cnames, cvals, drec, locals, stmts);
        return 0;
    } else {
    }
    if n.kind == P_K_ARRAY {
        let qe2: i64 = cv_emit_array(nodes, kids, dst, eid, base, env, rdefs, sigs, fids, cnames, cvals, "?", 0 - 1, locals, stmts);
        return 0;
    } else {
    }
    if n.kind == P_K_LIT_STR {
        let qe3: i64 = cv_emit_string(dst, n.text, base, locals, stmts);
        return 0;
    } else {
    }
    if n.kind == P_K_METHOD {
        if n.child_count >= 1 {
            let mrid: i64 = kids.get(n.child_start);
            let mrn: PNode = nodes.get(mrid);
            if mrn.kind == P_K_PATH {
                let mcode: i64 = tc_code_of_name(mrn.text, rdefs);
                if mcode >= TC_REC_BASE {
                    let meridx: i64 = mcode - TC_REC_BASE;
                    let merec: TcRec = rdefs.get(meridx);
                    if merec.is_enum {
                        let mvidx: i64 = tc_variant_index(rdefs, meridx, n.text);
                        if mvidx >= 0 {
                            let qe4: i64 = cv_emit_enum_ctor(nodes, kids, dst, eid, meridx, mvidx, 1, dsz, dtid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                            return 0;
                        } else {
                        }
                    } else {
                    }
                } else {
                }
                // W-STR-A: str intrinsics into dst (the dst was allocated by the caller).
                let sdi2: i64 = cv_emit_strintr(nodes, kids, dst, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                if sdi2 > 0 - 2 {
                    return 0;
                } else {
                }
                // W-STR-B: the desugar methods into dst.
                let sdd2: i64 = cv_emit_strdesugar(nodes, kids, dst, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                if sdd2 > 0 - 2 {
                    return 0;
                } else {
                }
                // ST-2: a DOT-METHOD into dst — Call({Type}__{method}, [recv, ...args])
                // with the call dst = the given dst (into-position, no trailing copy).
                // B-DISPATCH: the receiver may be a COLON path (one field hop) — cv_recv_rec +
                // cv_to_var materialization (the dst was allocated by the caller already).
                let m2col: i64 = tc_last_colons(mrn.text);
                let mut m2gate: bool = false;
                if m2col < 0 {
                    let m2bv: i64 = cv_env_var(env, mrn.text);
                    if m2bv >= 0 {
                        m2gate = true;
                    } else {
                    }
                } else {
                    m2gate = true;
                }
                let mrr: i64 = cv_recv_rec(env, rdefs, mrn.text);
                if m2gate {
                    if mrr >= 0 {
                        let mrec2: TcRec = rdefs.get(mrr);
                        let mtail: str = tc_seg_at(n.text, 0);
                        // SH-MONO MONO-7: pre-resolved generic-method call (flag 2^21) -> n.text.
                        let mpre7b: i64 = n.flags & 2097152;
                        let mut mmang: str = "";
                        let mut mrkeyb: str = "";
                        if mpre7b > 0 {
                            mmang = n.text;
                            mrkeyb = n.text;
                        } else {
                            let msep: str = mrec2.name.concat("__");
                            mmang = msep.concat(mtail);
                            let mrsepb: str = mrec2.name.concat("::");
                            mrkeyb = mrsepb.concat(mtail);
                        }
                        let mfid: i64 = cv_fid_find(fids, mmang);
                        if mfid >= 0 {
                            // SHP-0b: a value-position call stores its result into `dst`, so a
                            // void callee (or one whose return type is unknown) is refused: the
                            // store emitted a `local.set` with nothing on the stack (an expression
                            // statement `b.poke();` lowers here).
                            let mrtokb: str = cv_sig_ret_tok(sigs, mrkeyb);
                            let mvoid: bool = mrtokb.bytes_eq("Unit");
                            let munkb: bool = mrtokb.bytes_eq("?");
                            if mvoid {
                                let qpv: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                            }
                            if munkb {
                                let qpk: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                            }
                            let mut mrv: i64 = 0 - 1;
                            if m2col < 0 {
                                mrv = cv_env_var(env, mrn.text);
                            } else {
                                mrv = cv_to_var(nodes, kids, mrid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                            }
                            let mut margs: Vec<str> = Vec::new();
                            let mlead: str = "v";
                            let mrv0: str = mlead.concat(cv_i64_str(mrv));
                            let qm0: i64 = margs.push(mrv0);
                            let mut mmi: i64 = 1;
                            while mmi < n.child_count {
                                let magid: i64 = kids.get(n.child_start + mmi);
                                // SHP-0b: argument k is the method's parameter k (`self` is 0),
                                // typed by that slot like a free call's (cv_to_var_expected).
                                let maptid: i64 = cv_fn_param_typeid(sigs, mrkeyb, mmi);
                                let mav: i64 = cv_to_var_expected(nodes, kids, magid, maptid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                                let mavv: str = mlead.concat(cv_i64_str(mav));
                                let qma: i64 = margs.push(mavv);
                                mmi = mmi + 1;
                            }
                            let msp: str = " ";
                            let margstr: str = msp.join(margs);
                            let qmcl: i64 = stmts.push(CvStmt { kind: CVS_CALL, a: dst, b: mfid, c: 0, d: 0, s: margstr });
                            return 0;
                        } else {
                        }
                    } else {
                    }
                } else {
                }
            } else {
            }
        } else {
        }
        let qpm: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    } else {
    }
    if n.kind == P_K_INDEX {
        let xrid: i64 = kids.get(n.child_start);
        let xrn: PNode = nodes.get(xrid);
        let mut xok: bool = false;
        let mut arrv: i64 = 0 - 1;
        let mut etok: str = "";
        if xrn.kind == P_K_PATH {
            arrv = cv_env_var(env, xrn.text);
            etok = cv_env_elem(env, xrn.text);
            if arrv >= 0 {
                if etok.len() > 0 {
                    xok = true;
                } else {
                }
            } else {
            }
        } else {
        }
        if xok {
            let xiid: i64 = kids.get(n.child_start + 1);
            let xin: PNode = nodes.get(xiid);
            let xiv: i64 = cv_to_var(nodes, kids, xiid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
            if xin.kind == P_K_LIT_INT {
            } else {
                // RF-M3 (SHP-5a): an access a guard on its loop var narrows is poisoned.
                let xrg2: bool = rf_index_guarded(nodes, kids, eid);
                if xrg2 {
                    let qpg2: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                    return 0;
                }
                // RF-M2: a covered range-for loop var elides the chain too (rf_index_elided).
                let xre: bool = rf_index_elided(nodes, kids, eid);
                if xre {
                } else {
                    let qch: i64 = cv_index_check(nodes, kids, xiid, xiv, arrv, base, env, rdefs, sigs, cnames, cvals, locals, stmts);
                }
            }
            let xw: i64 = cv_ty_width(etok);
            let qld: i64 = stmts.push(CvStmt { kind: CVS_LD_ELEM, a: dst, b: arrv, c: xiv, d: xw, s: etok });
            return 0;
        } else {
        }
        let qpx: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
        return 0;
    } else {
    }
    // SHP-5b: a release and a borrow into the given dst (the oracle's lower_expr_into arms).
    if n.kind == P_K_DECLASSIFY {
        let qri: i64 = cv_emit_release(nodes, kids, dst, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        return 0;
    }
    if n.kind == P_K_DECLASSIFY_CT {
        let qrci: i64 = cv_emit_release(nodes, kids, dst, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        return 0;
    }
    if n.kind == P_K_BORROW {
        let qbi: i64 = cv_emit_borrow(nodes, kids, dst, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        return 0;
    }
    let capopi: bool = cv_is_capop_kind(n.kind);
    if capopi {
        let cslot: bool = dstty.bytes_eq("Ptr");
        if !cslot {
            let qcp: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
            return 0;
        }
        let qci: i64 = cv_emit_capop(nodes, kids, dst, eid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
        return 0;
    }
    let qz: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
    return 0;
}

// Serialize ONE CvStmt to its render token (the harness cv_render_stmt mirror). Built by pushing
// pieces into a Vec and joining (the selfhost bind-first idiom; join not concat — X9).
// SHP-5b: the render of the kinds this slice adds, reached after the chain in cv_ser_stmt; "!"
// for any other kind (the poison render, which can never match an oracle line).
fn cv_ser_shp5b(st: CvStmt, ps: Vec<str> @Mut) -> i64 ! { Alloc } {
    if st.kind == CVS_RELEASE {
        let ra: str = cv_i64_str(st.a);
        let rb: str = cv_i64_str(st.b);
        let rc: str = cv_i64_str(st.c);
        let rd: str = cv_i64_str(st.d);
        let q0: i64 = ps.push("Rel v");
        let q1: i64 = ps.push(ra);
        let q2: i64 = ps.push("<-v");
        let q3: i64 = ps.push(rb);
        let q4: i64 = ps.push(" cap v");
        let q5: i64 = ps.push(rc);
        let q6: i64 = ps.push(" sink v");
        let q7: i64 = ps.push(rd);
        return 0;
    }
    if st.kind == CVS_BORROW {
        let ba: str = cv_i64_str(st.a);
        let bb: str = cv_i64_str(st.b);
        let q8: i64 = ps.push("Borrow v");
        let q9: i64 = ps.push(ba);
        let q10: i64 = ps.push("<-v");
        let q11: i64 = ps.push(bb);
        return 0;
    }
    if st.kind == CVS_CAPRESTRICT {
        let xa: str = cv_i64_str(st.a);
        let xb: str = cv_i64_str(st.b);
        let xc: str = cv_i64_str(st.c);
        let q13: i64 = ps.push("Restrict v");
        let q14: i64 = ps.push(xa);
        let q15: i64 = ps.push("<-v");
        let q16: i64 = ps.push(xb);
        let q17: i64 = ps.push(" mask ");
        let q18: i64 = ps.push(xc);
        return 0;
    }
    if st.kind == CVS_CAPSPLIT {
        let ya: str = cv_i64_str(st.a);
        let yb: str = cv_i64_str(st.b);
        let yc: str = cv_i64_str(st.c);
        if st.d == 1 {
            let q19: i64 = ps.push("Draw v");
        } else {
            let q20: i64 = ps.push("Split v");
        }
        let q21: i64 = ps.push(ya);
        let q22: i64 = ps.push("<-v");
        let q23: i64 = ps.push(yb);
        let q24: i64 = ps.push(" amount v");
        let q25: i64 = ps.push(yc);
        return 0;
    }
    // SHP-5c-3: the slot and region kinds (the harness cv_render_stmt mirror).
    if st.kind == CVS_SLOTNEW {
        let q26: i64 = ps.push("SlotNew v");
        let q27: i64 = ps.push(cv_i64_str(st.a));
        return 0;
    }
    if st.kind == CVS_SLOTPUT {
        let q28: i64 = ps.push("SlotPut v");
        let q29: i64 = ps.push(cv_i64_str(st.a));
        let q30: i64 = ps.push(" cap v");
        let q31: i64 = ps.push(cv_i64_str(st.b));
        return 0;
    }
    if st.kind == CVS_SLOTTAKE {
        let q32: i64 = ps.push("SlotTake v");
        let q33: i64 = ps.push(cv_i64_str(st.a));
        let q34: i64 = ps.push("<-v");
        let q35: i64 = ps.push(cv_i64_str(st.b));
        return 0;
    }
    if st.kind == CVS_RBEGIN {
        let q36: i64 = ps.push("RBegin v");
        let q37: i64 = ps.push(cv_i64_str(st.a));
        return 0;
    }
    if st.kind == CVS_REND {
        let q38: i64 = ps.push("REnd v");
        let q39: i64 = ps.push(cv_i64_str(st.a));
        let q40: i64 = ps.push(" lim v");
        let q41: i64 = ps.push(cv_i64_str(st.b));
        return 0;
    }
    let q12: i64 = ps.push("!");
    return 0;
}

fn cv_ser_stmt(st: CvStmt) -> str ! { Alloc } {
    let mut ps: Vec<str> = Vec::new();
    if st.kind == CVS_AS_INT {
        let ia: str = cv_i64_str(st.a);
        let ib: str = cv_i64_str(st.b);
        let q0: i64 = ps.push("As v");
        let q1: i64 = ps.push(ia);
        let q2: i64 = ps.push("=Int(");
        let q3: i64 = ps.push(ib);
        let q4: i64 = ps.push(")");
    } else {
        if st.kind == CVS_AS_BOOL {
            let ba: str = cv_i64_str(st.a);
            let q5: i64 = ps.push("As v");
            let q6: i64 = ps.push(ba);
            if st.b == 1 {
                let q7: i64 = ps.push("=Bool(true)");
            } else {
                let q8: i64 = ps.push("=Bool(false)");
            }
        } else {
            if st.kind == CVS_AS_VAR {
                let ca: str = cv_i64_str(st.a);
                let cb: str = cv_i64_str(st.b);
                let q9: i64 = ps.push("As v");
                let q10: i64 = ps.push(ca);
                let q11: i64 = ps.push("=Var(v");
                let q12: i64 = ps.push(cb);
                let q13: i64 = ps.push(")");
            } else {
                if st.kind == CVS_AS_BIN {
                    let da: str = cv_i64_str(st.a);
                    let db: str = cv_i64_str(st.b);
                    let dop: str = cv_op_tok(st.c);
                    let dd: str = cv_i64_str(st.d);
                    let q14: i64 = ps.push("As v");
                    let q15: i64 = ps.push(da);
                    let q16: i64 = ps.push("=Bin(v");
                    let q17: i64 = ps.push(db);
                    let q18: i64 = ps.push(" ");
                    let q19: i64 = ps.push(dop);
                    let q20: i64 = ps.push(" v");
                    let q21: i64 = ps.push(dd);
                    let q22: i64 = ps.push(")");
                } else {
                    if st.kind == CVS_TRAP {
                        let ta1: str = cv_i64_str(st.a);
                        let q30: i64 = ps.push("Trap v");
                        let q31: i64 = ps.push(ta1);
                    } else {
                        if st.kind == CVS_LF_LEN {
                            let fa: str = cv_i64_str(st.a);
                            let fb: str = cv_i64_str(st.b);
                            let q32: i64 = ps.push("LF v");
                            let q33: i64 = ps.push(fa);
                            let q34: i64 = ps.push("<-v");
                            let q35: i64 = ps.push(fb);
                            let q36: i64 = ps.push("@0:U32");
                        } else {
                            if st.kind == CVS_LD_ELEM {
                                let ea: str = cv_i64_str(st.a);
                                let eb: str = cv_i64_str(st.b);
                                let ec: str = cv_i64_str(st.c);
                                let ed: str = cv_i64_str(st.d);
                                let q37: i64 = ps.push("LD v");
                                let q38: i64 = ps.push(ea);
                                let q39: i64 = ps.push("<-v");
                                let q40: i64 = ps.push(eb);
                                let q41: i64 = ps.push("[v");
                                let q42: i64 = ps.push(ec);
                                let q43: i64 = ps.push("]*");
                                let q44: i64 = ps.push(ed);
                                let q45: i64 = ps.push("+4:");
                                let q46: i64 = ps.push(st.s);
                            } else {
                                if st.kind == CVS_LF2 {
                                    let ga: str = cv_i64_str(st.a);
                                    let gb: str = cv_i64_str(st.b);
                                    let gc: str = cv_i64_str(st.c);
                                    let q50: i64 = ps.push("LF v");
                                    let q51: i64 = ps.push(ga);
                                    let q52: i64 = ps.push("<-v");
                                    let q53: i64 = ps.push(gb);
                                    let q54: i64 = ps.push("@");
                                    let q55: i64 = ps.push(gc);
                                    let q56: i64 = ps.push(":");
                                    let q57: i64 = ps.push(st.s);
                                } else {
                                    if st.kind == CVS_SF {
                                        let ha: str = cv_i64_str(st.a);
                                        let hb: str = cv_i64_str(st.b);
                                        let hc: str = cv_i64_str(st.c);
                                        let q58: i64 = ps.push("SF v");
                                        let q59: i64 = ps.push(ha);
                                        let q60: i64 = ps.push("@");
                                        let q61: i64 = ps.push(hc);
                                        let q62: i64 = ps.push("<-v");
                                        let q63: i64 = ps.push(hb);
                                        let q64: i64 = ps.push(":");
                                        let q65: i64 = ps.push(st.s);
                                    } else {
                                        if st.kind == CVS_CALL {
                                            let cb: str = cv_i64_str(st.b);
                                            if st.a >= 0 {
                                                let ca: str = cv_i64_str(st.a);
                                                let q66: i64 = ps.push("Call v");
                                                let q67: i64 = ps.push(ca);
                                                let q68: i64 = ps.push("=f");
                                                let q69: i64 = ps.push(cb);
                                            } else {
                                                let q70: i64 = ps.push("Call f");
                                                let q71: i64 = ps.push(cb);
                                            }
                                            let q72: i64 = ps.push("(");
                                            let q73: i64 = ps.push(st.s);
                                            let q74: i64 = ps.push(")");
                                        } else {
                                            if st.kind == CVS_BA {
                                                let ja: str = cv_i64_str(st.a);
                                                let jb: str = cv_i64_str(st.b);
                                                let jc: str = cv_i64_str(st.c);
                                                let q75: i64 = ps.push("BA v");
                                                let q76: i64 = ps.push(ja);
                                                let q77: i64 = ps.push(" ");
                                                let q78: i64 = ps.push(jb);
                                                let q79: i64 = ps.push("/");
                                                let q80: i64 = ps.push(jc);
                                            } else {
                                                if st.kind == CVS_AS_STR {
                                                    let ka: str = cv_i64_str(st.a);
                                                    let q81: i64 = ps.push("As v");
                                                    let q82: i64 = ps.push(ka);
                                                    let q83: i64 = ps.push("=Str(");
                                                    let q84: i64 = ps.push(st.s);
                                                    let q85: i64 = ps.push(")");
                                                } else {
                                                    if st.kind == CVS_AS_REC {
                                                        let la: str = cv_i64_str(st.a);
                                                        let q86: i64 = ps.push("As v");
                                                        let q87: i64 = ps.push(la);
                                                        let q88: i64 = ps.push("=Rec(");
                                                        let q89: i64 = ps.push(st.s);
                                                        let q90: i64 = ps.push(")");
                                                    } else {
                                                        if st.kind == CVS_SD {
                                                            let ma: str = cv_i64_str(st.a);
                                                            let mb: str = cv_i64_str(st.b);
                                                            let mc: str = cv_i64_str(st.c);
                                                            let md: str = cv_i64_str(st.d);
                                                            let q91: i64 = ps.push("SD v");
                                                            let q92: i64 = ps.push(ma);
                                                            let q93: i64 = ps.push("[v");
                                                            let q94: i64 = ps.push(mc);
                                                            let q95: i64 = ps.push("]*");
                                                            let q96: i64 = ps.push(md);
                                                            let q97: i64 = ps.push("+4<-v");
                                                            let q98: i64 = ps.push(mb);
                                                            let q99: i64 = ps.push(":");
                                                            let q100: i64 = ps.push(st.s);
                                                        } else {
                                                            if st.kind == CVS_WRAP {
                                                                let na2: str = cv_i64_str(st.a);
                                                                let nb2: str = cv_i64_str(st.b);
                                                                let q101: i64 = ps.push("Wrap v");
                                                                let q102: i64 = ps.push(na2);
                                                                let q103: i64 = ps.push("<-v");
                                                                let q104: i64 = ps.push(nb2);
                                                            } else {
                                                                if st.kind == CVS_FUEL {
                                                                    let oa2: str = cv_i64_str(st.a);
                                                                    let q105: i64 = ps.push("Fuel ");
                                                                    let q106: i64 = ps.push(oa2);
                                                                } else {
                                                                    let q23: i64 = cv_ser_shp5b(st, ps);
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    let glue: str = "";
    return glue.join(ps);
}

// SH-AIR-CV-2: does this MATCH guarantee a return — all arm bodies diverge (the typechecker's
// exhaustive+all-arms rule, statements.rs:2492; a type-clean all-arms-returning match is
// necessarily exhaustive, so the parse-level check is all-arms).
fn cv_match_arms_diverge(nodes: Arena<PNode>, kids: Vec<i64>, mid: i64) -> bool {
    let mn: PNode = nodes.get(mid);
    let na: i64 = mn.child_count;
    if na > 1 {
    } else {
        return false;
    }
    let mut j: i64 = 1;
    while j < na {
        let aid: i64 = kids.get(mn.child_start + j);
        let an: PNode = nodes.get(aid);
        let abid: i64 = kids.get(an.child_start + an.child_count - 1);
        let ad: bool = cv_block_diverges(nodes, kids, abid);
        if ad {
        } else {
            return false;
        }
        j = j + 1;
    }
    return true;
}

// SH-AIR-CV-2: does this stmt list GUARANTEE a return — the mirror of the typechecker's
// `guaranteed_return` (statements.rs:486-889): a `return` (744) / a `trap();` (the Never
// expr-stmt, 685) / an `if` whose BOTH branches guarantee (1969) / a match whose arms all
// guarantee (2492). While/for-in/break/continue never guarantee. The typed AST DROPS every stmt
// after the first guaranteed one (the check_block break, 886) — the walker mirrors that
// truncation, which is what elides the merge block on a both-branches-return if.
fn cv_block_diverges(nodes: Arena<PNode>, kids: Vec<i64>, bnid: i64) -> bool {
    let bn: PNode = nodes.get(bnid);
    let n: i64 = bn.child_count;
    let mut i: i64 = 0;
    while i < n {
        let sid: i64 = kids.get(bn.child_start + i);
        let sn: PNode = nodes.get(sid);
        if sn.kind == P_K_RETURN {
            return true;
        } else {
        }
        if sn.kind == P_K_EXPR_STMT {
            if sn.child_count > 0 {
                let xid: i64 = kids.get(sn.child_start);
                let xn: PNode = nodes.get(xid);
                if xn.kind == P_K_CALL {
                    let it: bool = xn.text.bytes_eq("trap");
                    if it {
                        return true;
                    } else {
                    }
                } else {
                }
            } else {
            }
        } else {
        }
        if sn.kind == P_K_IF {
            if sn.child_count == 3 {
                let tb: i64 = kids.get(sn.child_start + 1);
                let eb: i64 = kids.get(sn.child_start + 2);
                let td: bool = cv_block_diverges(nodes, kids, tb);
                if td {
                    let ed: bool = cv_block_diverges(nodes, kids, eb);
                    if ed {
                        return true;
                    } else {
                    }
                } else {
                }
            } else {
            }
        } else {
        }
        if sn.kind == P_K_MATCH {
            let md: bool = cv_match_arms_diverge(nodes, kids, sid);
            if md {
                return true;
            } else {
            }
        } else {
        }
        i = i + 1;
    }
    return false;
}

// SH-AIR-CV-2: the recursive block walker — the mirror of `lower_statements` (air.rs:1420-1755).
// Walks ONE stmt list (`bnid` = a P_K_BLOCK) emitting into `cur0`, flushing blocks (in emission
// order) at every terminator point, and recursing into branch/loop/arm bodies with a CLONED env
// (the oracle's `env.clone()` — branch bindings never leak). `cont` = the continuation block
// (-1 = None: the epilogue is `Ret`); `brk`/`cnt` = the innermost loop's break/continue targets
// (-1 outside a loop — a stray break renders `Jmp b-1`, unmatchable → loud); `inc` = the for-in
// idx var for continue's inline increment (-1 for while). X6 for blocks: then/else/merge (and the
// while/for trios) are freshed BEFORE their bodies are lowered.
// W-TUPLE: parse a tuple ret-detail mangle (`$tupleN__a_b_...`) to the `;`-joined AirType
// token list ("I64;I64"). An unknown atom yields "" (the caller poisons LOUD).
fn cv_tuptys_of_mangle(detail: str) -> str ! { Alloc } {
    let pfx: bool = tc_str_starts(detail, "$tuple");
    if pfx {
    } else {
        return "";
    }
    let dl: i64 = detail.len();
    // find the `__` separator after the count digits.
    let mut sep: i64 = 0 - 1;
    let mut si: i64 = 6;
    while si + 1 < dl {
        if detail.byte_at(si) == 95 {
            if detail.byte_at(si + 1) == 95 {
                sep = si;
                si = dl;
            } else {
                si = si + 1;
            }
        } else {
            si = si + 1;
        }
    }
    if sep < 0 {
        return "";
    } else {
    }
    let atoms: str = detail.substr(sep + 2, dl);
    // split on `$` (the injective-mangle separator: $tupleN__e0$e1$...), map each atom.
    let mut toks: Vec<str> = Vec::new();
    let al: i64 = atoms.len();
    let mut a0: i64 = 0;
    let mut ai: i64 = 0;
    while ai <= al {
        let mut cut: bool = false;
        if ai == al {
            cut = true;
        } else {
            if atoms.byte_at(ai) == 36 {
                cut = true;
            } else {
            }
        }
        if cut {
            let atom: str = atoms.substr(a0, ai);
            let mut tok: str = "";
            if atom.bytes_eq("i64") {
                tok = "I64";
            } else {
            }
            if atom.bytes_eq("u64") {
                tok = "U64";
            } else {
            }
            if atom.bytes_eq("u32") {
                tok = "U32";
            } else {
            }
            if atom.bytes_eq("i32") {
                tok = "I32";
            } else {
            }
            if atom.bytes_eq("bool") {
                tok = "Bool";
            } else {
            }
            if atom.bytes_eq("str") {
                tok = "Ptr";
            } else {
            }
            if tok.len() > 0 {
                let qt: i64 = toks.push(tok);
            } else {
                return "";
            }
            a0 = ai + 1;
        } else {
        }
        ai = ai + 1;
    }
    let semi: str = ";";
    return semi.join(toks);
}

// W-TUPELEM: parse the SAME tuple ret-detail mangle to the `;`-joined per-element str
// PROVENANCE sentinels — `$str` for a str atom, `-` (a non-empty positional placeholder,
// never stored) for the other known scalars, "" whole-result on any unknown atom (the
// caller's token gate poisons that shape LOUD already). Deliberately NOT a Ptr-token lens:
// Ptr goes ambiguous the day the atom map learns records, and a record mis-tagged $str
// would route a `len`-named method into the strintr arm — silent wrong bytes. The atom set
// MUST stay in lockstep with cv_tuptys_of_mangle; a desync degrades to a missing sentinel
// (loud poison), never a mis-tag.
fn cv_tupelems_of_mangle(detail: str) -> str ! { Alloc } {
    let pfx: bool = tc_str_starts(detail, "$tuple");
    if pfx {
    } else {
        return "";
    }
    let dl: i64 = detail.len();
    let mut sep: i64 = 0 - 1;
    let mut si: i64 = 6;
    while si + 1 < dl {
        if detail.byte_at(si) == 95 {
            if detail.byte_at(si + 1) == 95 {
                sep = si;
                si = dl;
            } else {
                si = si + 1;
            }
        } else {
            si = si + 1;
        }
    }
    if sep < 0 {
        return "";
    } else {
    }
    let atoms: str = detail.substr(sep + 2, dl);
    let mut toks: Vec<str> = Vec::new();
    let al: i64 = atoms.len();
    let mut a0: i64 = 0;
    let mut ai: i64 = 0;
    while ai <= al {
        let mut cut: bool = false;
        if ai == al {
            cut = true;
        } else {
            if atoms.byte_at(ai) == 36 {
                cut = true;
            } else {
            }
        }
        if cut {
            let atom: str = atoms.substr(a0, ai);
            let mut tok: str = "";
            if atom.bytes_eq("str") {
                tok = "$str";
            } else {
            }
            if atom.bytes_eq("i64") {
                tok = "-";
            } else {
            }
            if atom.bytes_eq("u64") {
                tok = "-";
            } else {
            }
            if atom.bytes_eq("u32") {
                tok = "-";
            } else {
            }
            if atom.bytes_eq("i32") {
                tok = "-";
            } else {
            }
            if atom.bytes_eq("bool") {
                tok = "-";
            } else {
            }
            if tok.len() > 0 {
                let qt: i64 = toks.push(tok);
            } else {
                return "";
            }
            a0 = ai + 1;
        } else {
        }
        ai = ai + 1;
    }
    let semi: str = ";";
    return semi.join(toks);
}

fn cv_walk_stmts(nodes: Arena<PNode>, kids: Vec<i64>, bnid: i64, cur0: i64, cont: i64, brk: i64, cnt: i64, inc: i64, fnid: i64, base: i64, env0: Vec<CvBind>, locals: Vec<str> @Mut, stmts: Vec<CvStmt> @Mut, blocks: Vec<CvBlock> @Mut, bctr: Vec<i64> @Mut, rdefs: Vec<TcRec>, sigs: Vec<TcSig>, fids: Vec<str>, cnames: Vec<str>, cvals: Vec<i64>, amult: i64, bmults: Vec<i64> @Mut) -> i64 ! { Alloc } {
    let mut env: Vec<CvBind> = cv_env_clone(env0);
    let bn: PNode = nodes.get(bnid);
    let n: i64 = bn.child_count;
    let mut cur: i64 = cur0;
    let mut mark: i64 = stmts.len();
    let mut i: i64 = 0;
    while i < n {
        let sid: i64 = kids.get(bn.child_start + i);
        let sn: PNode = nodes.get(sid);
        let k: i64 = sn.kind;
        if k == P_K_LET {
            if sn.child_count == 2 {
                let ltid: i64 = kids.get(sn.child_start);
                let ltok: str = ai_airtype_of_typenode(nodes, kids, ltid, rdefs);
                let lvid: i64 = kids.get(sn.child_start + 1);
                let lvn: PNode = nodes.get(lvid);
                let mut ld: i64 = 0;
                let erec0: i64 = cv_rec_of_typenode(nodes, kids, ltid, rdefs);
                let mut lesz: i64 = 0;
                if erec0 >= 0 {
                    let er0: TcRec = rdefs.get(erec0);
                    if er0.is_enum {
                        if er0.tpnames.len() == 0 {
                            lesz = cv_enum_total_size(rdefs, erec0);
                        } else {
                            lesz = cv_enum_inst_size(nodes, kids, rdefs, erec0, ltid);
                        }
                    } else {
                    }
                } else {
                }
                if lvn.kind == P_K_TUPLE {
                    // CAP-MATCH re-pin (supersedes the ST-3 note): the oracle BINDS the
                    // let name to the construct var directly (a rename, NO copy); the
                    // temp+copy the ST-3 corpus pinned belongs to the DESTRUCTURE
                    // (`let (x, y) = q` materializes q via a copy temp — see the
                    // path-RHS arm). Render-proven on both shapes: `let pair = (a,b);
                    // Some(pair)` has NO copy; `let q = (a,b); let (x,y) = q` has one.
                    // SR-032: the elements are typed by the annotation's element types.
                    ld = cv_fresh("Ptr", base, locals);
                    let qlt: i64 = cv_emit_tuple(nodes, kids, ld, lvid, ltid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                } else {
                    ld = cv_fresh(ltok, base, locals);
                    if lvn.kind == P_K_ARRAY {
                        // SHP-0b: an array literal takes the annotation's element type.
                        let mut lel: str = cv_array_elem_tok(nodes, kids, ltid, rdefs);
                        if lel.len() == 0 {
                            lel = "?";
                        }
                        let letid: i64 = cv_array_elem_tid(nodes, kids, ltid);
                        let qla: i64 = cv_emit_array(nodes, kids, ld, lvid, base, env, rdefs, sigs, fids, cnames, cvals, lel, letid, locals, stmts);
                    } else {
                        // AG6-6: resolve the annotation's generic-enum INSTANCE size BEFORE lowering
                        // the RHS, so a unit-variant construct (`let e: E<i64> = E::N;`) allocates the
                        // instance cell, not the un-substituted def cell. 0 for every non-enum and
                        // every unresolvable annotation — those keep the def size byte-for-byte.
                        let ql: i64 = cv_into(nodes, kids, ld, lvid, base, env, rdefs, sigs, fids, cnames, cvals, ltok, erec0, lesz, ltid, locals, stmts);
                    }
                }
                let lrec: i64 = cv_rec_of_typenode(nodes, kids, ltid, rdefs);
                let lelem: str = cv_elem_of_typenode(nodes, kids, ltid, rdefs);
                let ltup: str = cv_tuptys_of_typenode(nodes, kids, ltid, rdefs);
                let qb: i64 = env.push(CvBind { name: sn.text, var: ld, ty: ltok, rec: lrec, elem: lelem, tuptys: ltup, esize: lesz });
            } else {
                // B-LET: an UNANNOTATED let — the local types from the VALUE (cv_expr_tytok,
                // intrinsic-aware). An underivable type ("?") POISONS loud. The env binding
                // carries no rec/elem/tuptys (a record-typed use through it poisons at the
                // USE site — fail-closed, never wrong bytes).
                if sn.child_count == 1 {
                    let uvid: i64 = kids.get(sn.child_start);
                    let utok: str = cv_expr_tytok(nodes, kids, uvid, env, rdefs, sigs, cnames, cvals);
                    let uunk: bool = utok.bytes_eq("?");
                    if uunk {
                        let qp0: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                    } else {
                        let ud: i64 = cv_fresh(utok, base, locals);
                        let uvn: PNode = nodes.get(uvid);
                        if uvn.kind == P_K_ARRAY {
                            // SHP-0b: no slot dictates an unannotated array's element type.
                            let qua: i64 = cv_emit_array(nodes, kids, ud, uvid, base, env, rdefs, sigs, fids, cnames, cvals, "", 0 - 1, locals, stmts);
                        } else {
                            let qu: i64 = cv_into(nodes, kids, ud, uvid, base, env, rdefs, sigs, fids, cnames, cvals, utok, 0 - 1, 0, 0 - 1, locals, stmts);
                        }
                        let qub: i64 = env.push(CvBind { name: sn.text, var: ud, ty: utok, rec: 0 - 1, elem: "", tuptys: "", esize: 0 });
                    }
                } else {
                    let qp1: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                }
            }
            i = i + 1;
        } else {
            if k == P_K_LET_TUPLE {
                // ST-3: `let (x, y) = t` — the RHS (last child) is a tuple LOCAL;
                // destructure to per-element LoadFields at accumulated offsets. The
                // element types come from an explicit (T1,T2) annotation (child0) or
                // the local's tuptys. A non-local RHS / non-tuple falls to POISON.
                let ltrhs: i64 = kids.get(sn.child_start + sn.child_count - 1);
                let ltrn: PNode = nodes.get(ltrhs);
                let mut ltdone: bool = false;
                // W-TUPLE: a CALL RHS (`let (x, y) = f(...)` — the parser's dominant shape):
                // the call materializes via cv_to_var (dst-first, the pair ptr), the element
                // tokens derive from the callee sig's ret_detail ($tupleN__a_b_...); an
                // unresolvable sig/mangle falls through to POISON.
                if ltrn.kind == P_K_CALL {
                    let ltcc: i64 = tc_last_colons(ltrn.text);
                    if ltcc < 0 {
                        let ltsi: i64 = tc_sig_find(sigs, ltrn.text);
                        if ltsi >= 0 {
                            let ltsg: TcSig = sigs.get(ltsi);
                            let cttys: str = cv_tuptys_of_mangle(ltsg.ret_detail);
                            if cttys.len() > 0 {
                                let celems: str = cv_tupelems_of_mangle(ltsg.ret_detail);
                                let ctvar: i64 = cv_to_var(nodes, kids, ltrhs, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                                let mut cboff: i64 = 0;
                                let mut cbi: i64 = 0;
                                let mut cgo: bool = true;
                                while cgo {
                                    let cbname: str = tc_seg_at(sn.text, cbi);
                                    if cbname.len() == 0 {
                                        cgo = false;
                                    } else {
                                        let cetok: str = tc_seg_at(cttys, cbi);
                                        let cel0: str = tc_seg_at(celems, cbi);
                                        let mut celem: str = "";
                                        if cel0.bytes_eq("$str") {
                                            celem = "$str";
                                        } else {
                                        }
                                        let cxd: i64 = cv_fresh(cetok, base, locals);
                                        let cqlf: i64 = stmts.push(CvStmt { kind: CVS_LF2, a: cxd, b: ctvar, c: cboff, d: 0, s: cetok });
                                        let cqbx: i64 = env.push(CvBind { name: cbname, var: cxd, ty: cetok, rec: 0 - 1, elem: celem, tuptys: "", esize: 0 });
                                        cboff = cboff + cv_ty_width(cetok);
                                        cbi = cbi + 1;
                                    }
                                }
                                ltdone = true;
                            } else {
                            }
                        } else {
                        }
                    } else {
                    }
                } else {
                }
                if ltdone {
                } else {
                if ltrn.kind == P_K_PATH {
                    let tlc: i64 = tc_last_colons(ltrn.text);
                    if tlc < 0 {
                        let tvar: i64 = cv_env_var(env, ltrn.text);
                        if tvar >= 0 {
                            let mut ttys: str = "";
                            if sn.child_count >= 2 {
                                let ltyid: i64 = kids.get(sn.child_start);
                                ttys = cv_tuptys_of_typenode(nodes, kids, ltyid, rdefs);
                            } else {
                            }
                            if ttys.len() > 0 {
                            } else {
                                ttys = cv_env_tuptys(env, ltrn.text);
                            }
                            if ttys.len() > 0 {
                                // CAP-MATCH re-pin: the oracle materializes the tuple
                                // LOCAL through a copy temp before the element loads
                                // (the temp+copy the ST-3 corpus attributed to the let).
                                let dctmp: i64 = cv_fresh("Ptr", base, locals);
                                let qdc: i64 = stmts.push(CvStmt { kind: CVS_AS_VAR, a: dctmp, b: tvar, c: 0, d: 0, s: "" });
                                let mut boff: i64 = 0;
                                let mut bi: i64 = 0;
                                let mut go: bool = true;
                                while go {
                                    let bname: str = tc_seg_at(sn.text, bi);
                                    if bname.len() == 0 {
                                        go = false;
                                    } else {
                                        let etok: str = tc_seg_at(ttys, bi);
                                        let xd: i64 = cv_fresh(etok, base, locals);
                                        let qlf: i64 = stmts.push(CvStmt { kind: CVS_LF2, a: xd, b: dctmp, c: boff, d: 0, s: etok });
                                        let qbx: i64 = env.push(CvBind { name: bname, var: xd, ty: etok, rec: 0 - 1, elem: "", tuptys: "", esize: 0 });
                                        boff = boff + cv_ty_width(etok);
                                        bi = bi + 1;
                                    }
                                }
                                ltdone = true;
                            } else {
                            }
                        } else {
                        }
                    } else {
                    }
                } else {
                }
                }
                if ltdone {
                } else {
                    let qptp: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                }
                i = i + 1;
            } else {
            if k == P_K_ASSIGN {
                let apid: i64 = kids.get(sn.child_start);
                let apn: PNode = nodes.get(apid);
                let mut asok: bool = false;
                if apn.kind == P_K_PATH {
                    let awq: i64 = tc_last_colons(apn.text);
                    if awq >= 0 {
                        // SH-AIR-CV-3: a field WRITE `r.x = v` (plain `=` only — reg2's E2): the
                        // RHS to_var FIRST, then SF with the real offset (w_lit: As;SF).
                        if sn.value == 0 {
                            let wlen: i64 = apn.text.len();
                            let wbase: str = apn.text.substr(0, awq);
                            let wseg: str = apn.text.substr(awq + 2, wlen);
                            let wvar: i64 = cv_env_var(env, wbase);
                            let wrec: i64 = cv_env_rec(env, wbase);
                            if wvar >= 0 {
                                if wrec >= 0 {
                                    let woff: i64 = cv_field_off(rdefs, wrec, wseg);
                                    if woff >= 0 {
                                        let wtok: str = cv_field_tok(rdefs, wrec, wseg);
                                        let wvid: i64 = kids.get(sn.child_start + 1);
                                        // SHP-0b: the field's declared type decides the
                                        // value's (cv_slot_var), not only a bare literal's.
                                        let wrv: i64 = cv_slot_var(nodes, kids, wvid, wtok, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                                        let qsf2: i64 = stmts.push(CvStmt { kind: CVS_SF, a: wvar, b: wrv, c: woff, d: 0, s: wtok });
                                        asok = true;
                                    } else {
                                    }
                                } else {
                                }
                            } else {
                            }
                        } else {
                        }
                    } else {
                    }
                    let av: i64 = cv_env_var(env, apn.text);
                    if av >= 0 {
                        if sn.value == 0 {
                            let avid: i64 = kids.get(sn.child_start + 1);
                            let aty: str = cv_env_tytok(env, apn.text);
                            let arec: i64 = cv_env_rec(env, apn.text);
                            let asz: i64 = cv_env_esize(env, apn.text);
                            let mut aunsupported: bool = false;
                            if arec >= 0 {
                                let ardef: TcRec = rdefs.get(arec);
                                if ardef.is_enum {
                                    if ardef.tpnames.len() > 0 {
                                        aunsupported = cv_expr_is_enum_ctor_for(nodes, kids, avid, arec, env, rdefs, fids);
                                    } else {
                                    }
                                } else {
                                }
                            } else {
                            }
                            if aunsupported {
                                let qap: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                            } else {
                                let qa: i64 = cv_into(nodes, kids, av, avid, base, env, rdefs, sigs, fids, cnames, cvals, aty, arec, asz, 0 - 2, locals, stmts);
                            }
                            asok = true;
                        } else {
                        }
                    } else {
                    }
                } else {
                }
                if apn.kind == P_K_INDEX {
                    // SH-AIR-CV-4: the index WRITE `arr[i] = v` (plain `=` only): the bounds chain
                    // (elided for a literal index), then the RHS mat AFTER TrapIf (reg5), then SD.
                    if sn.value == 0 {
                        let wxrid: i64 = kids.get(apn.child_start);
                        let wxrn: PNode = nodes.get(wxrid);
                        if wxrn.kind == P_K_PATH {
                            let warr: i64 = cv_env_var(env, wxrn.text);
                            let wtok: str = cv_env_elem(env, wxrn.text);
                            if warr >= 0 {
                                if wtok.len() > 0 {
                                    let wxid: i64 = kids.get(apn.child_start + 1);
                                    let wxn: PNode = nodes.get(wxid);
                                    let wxv: i64 = cv_to_var(nodes, kids, wxid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                                    if wxn.kind == P_K_LIT_INT {
                                    } else {
                                        // RF-M3 (SHP-5a): a guarded write access is poisoned
                                        // (the stream carries the poison; the module is `!!`).
                                        let wrg: bool = rf_index_guarded(nodes, kids, apid);
                                        if wrg {
                                            let qwg: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                                        }
                                        // RF-M2: a covered range-for loop var elides the WRITE
                                        // chain too (the oracle's place rides `bounds_proven`).
                                        let wre: bool = rf_index_elided(nodes, kids, apid);
                                        if wre {
                                        } else {
                                            let qwc: i64 = cv_index_check(nodes, kids, wxid, wxv, warr, base, env, rdefs, sigs, cnames, cvals, locals, stmts);
                                        }
                                    }
                                    let wrhsid: i64 = kids.get(sn.child_start + 1);
                                    // SHP-0b: the element type decides the value's
                                    // (cv_slot_var), not only a bare literal's.
                                    let wrhsv: i64 = cv_slot_var(nodes, kids, wrhsid, wtok, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                                    let ww: i64 = cv_ty_width(wtok);
                                    let qsd: i64 = stmts.push(CvStmt { kind: CVS_SD, a: warr, b: wrhsv, c: wxv, d: ww, s: wtok });
                                    asok = true;
                                } else {
                                }
                            } else {
                            }
                        } else {
                        }
                    } else {
                    }
                } else {
                }
                if asok {
                } else {
                    let qp2: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                }
                i = i + 1;
            } else {
                if k == P_K_RETURN {
                    if sn.child_count == 0 {
                        let qf1: i64 = cv_flush(blocks, cur, mark, stmts.len(), CVT_RET_NONE, 0 - 1, 0 - 1, 0 - 1, 0 - 1, bmults, amult);
                    } else {
                        let rvid: i64 = kids.get(sn.child_start);
                        let rtid: i64 = tc_fn_ret_typeid(nodes, kids, fnid);
                        let rv: i64 = cv_to_var_expected(nodes, kids, rvid, rtid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                        let qf2: i64 = cv_flush(blocks, cur, mark, stmts.len(), CVT_RET_SOME, rv, 0 - 1, 0 - 1, 0 - 1, bmults, amult);
                    }
                    return 0;
                } else {
                    if k == P_K_BREAK {
                        let qf3: i64 = cv_flush(blocks, cur, mark, stmts.len(), CVT_JMP, brk, 0 - 1, 0 - 1, 0 - 1, bmults, amult);
                        return 0;
                    } else {
                        if k == P_K_CONTINUE {
                            if inc >= 0 {
                                // RF-M4: `__one` takes the COUNTER's width — U32 for for-in
                                // (the pre-range byte-identical shape), I64 for range-for
                                // (the oracle Continue arm reads the frame width,
                                // air.rs:1861-1864). The counter is always a fresh LOCAL,
                                // so its locals entry carries the token.
                                let cw: str = cv_local_tytok(inc, base, locals);
                                let cone: i64 = cv_fresh(cw, base, locals);
                                let qc1: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: cone, b: 1, c: 0, d: 0, s: "" });
                                let qc2: i64 = stmts.push(CvStmt { kind: CVS_AS_BIN, a: inc, b: inc, c: T_PLUS, d: cone, s: "" });
                            } else {
                            }
                            let qf4: i64 = cv_flush(blocks, cur, mark, stmts.len(), CVT_JMP, cnt, 0 - 1, 0 - 1, 0 - 1, bmults, amult);
                            return 0;
                        } else {
                            if k == P_K_EXPR_STMT {
                                let xvid: i64 = kids.get(sn.child_start);
                                let xn: PNode = nodes.get(xvid);
                                let mut istrap: bool = false;
                                if xn.kind == P_K_CALL {
                                    istrap = xn.text.bytes_eq("trap");
                                } else {
                                }
                                if istrap {
                                    // trap(): the expr-stmt dst freshes FIRST (a Unit PHANTOM local —
                                    // allocated, never referenced), then the intrinsic's Bool cond +
                                    // Assign(1) + TrapIf; the block terminates Unreachable and the
                                    // dead remainder is dropped (air.rs:1451-1466 + 3181).
                                    let td: i64 = cv_fresh("Unit", base, locals);
                                    let tc: i64 = cv_fresh("Bool", base, locals);
                                    let qt1: i64 = stmts.push(CvStmt { kind: CVS_AS_INT, a: tc, b: 1, c: 0, d: 0, s: "" });
                                    let qt2: i64 = stmts.push(CvStmt { kind: CVS_TRAP, a: tc, b: 0, c: 0, d: 0, s: "" });
                                    let qf5: i64 = cv_flush(blocks, cur, mark, stmts.len(), CVT_UNR, 0 - 1, 0 - 1, 0 - 1, 0 - 1, bmults, amult);
                                    return 0;
                                } else {
                                    if xn.kind == P_K_REGION {
                                        // SHP-5c-3: a region statement (air.rs lower_expr_stmt_at →
                                        // lower_region_expr). The statement's Unit dst freshes first,
                                        // the limit lowers to a local, the U32 save local freshes;
                                        // RegionBegin; the body's statements inline into THIS block
                                        // over a scoped env (the walker, told not to close the block);
                                        // RegionEnd, which wraps an 8-byte limit before the compare.
                                        // The reclaim bytes are unconditional: the oracle emits them
                                        // for module and tool functions, the only kinds this emitter
                                        // lowers (actors and closures are refused before it).
                                        // Refused: a body with any statement but a let, an expression
                                        // statement or an assignment (control flow is the type
                                        // checker's T068), a body ending in an expression statement
                                        // (its value is the region's — a dst routing this slice does
                                        // not mirror), a limit that is not an integer local.
                                        let rok: bool = cv_region_body_ok(nodes, kids, xvid);
                                        if !rok {
                                            let qrp: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                                        } else {
                                            let rdst: i64 = cv_fresh("Unit", base, locals);
                                            let rlid: i64 = kids.get(xn.child_start);
                                            let rlim: i64 = cv_to_var(nodes, kids, rlid, base, env, rdefs, sigs, fids, cnames, cvals, locals, stmts);
                                            let rlt: str = cv_built_var_tok(rlim, base, env, locals);
                                            let rlok: bool = cv_tok_is_int(rlt);
                                            if !rlok {
                                                let qrl: i64 = stmts.push(CvStmt { kind: CVS_POISON, a: 0, b: 0, c: 0, d: 0, s: "" });
                                            }
                                            let mut rwrap: i64 = 0;
                                            if cv_ty_width(rlt) == 8 {
                                                rwrap = 1;
                                            }
                                            let rsave: i64 = cv_fresh("U32", base, locals);
                                            let qrb: i64 = stmts.push(CvStmt { kind: CVS_RBEGIN, a: rsave, b: 0, c: 0, d: 0, s: "" });
                                            let rbid: i64 = kids.get(xn.child_start + 1);
                                            let qrw: i64 = cv_walk_stmts(nodes, kids, rbid, cur, 0 - 2, brk, cnt, inc, fnid, base, env, locals, stmts, blocks, bctr, rdefs, sigs, fids, cnames, cvals, amult, bmults);
                                            let qre: i64 = stmts.push(CvStmt { kind: CVS_REND, a: rsave, b: rlim, c: rwrap, d: 0, s: "" });
                                        }
                                        i = i + 1;
                                    } else {
                                        // lower_expr_stmt = fresh + INTO (the CV-1 sweep catch).
                                        let xty: str = cv_expr_tytok(nodes, kids, xvid, env, rdefs, sigs, cnames, cvals);
                                        let xd: i64 = cv_fresh(xty, base, locals);
                                        let xr: i64 = cv_into(nodes, kids, xd, xvid, base, env, rdefs, sigs, fids, cnames, cvals, xty, 0 - 1, 0, 0 - 1, locals, stmts);
                                        i = i + 1;
                                    }
                                }
                            } else {
