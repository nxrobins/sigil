                            let ipl: i64 = lines.push(iwn);
                        } else {
                            if acn.kind == P_K_HANDLER {
                                let mut hret: i64 = -1;
                                let mut hx: i64 = 0;
                                while hx < acn.child_count {
                                    let hcid: i64 = kids.get(acn.child_start + hx);
