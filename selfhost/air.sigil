                                }
                                let hline: str = cv_fn_line(nodes, kids, acid, hname, hret, hbid, rdefs, sigs, fids, cnames, cvals, stage, macc, fcnt, wtypes, wexps, wskip, wcode, wfncnt, wbad, cn.text, tnames, tmods, wstrs, woffs, fowns, ecal, ecee, emul, fpois, true);
