                                        let embid: i64 = tc_fn_body(nodes, kids, emcid);
                                        let emwb0: i64 = wbad.len();
                                        let emline: str = cv_fn_line(nodes, kids, emcid, emname, emrt, embid, rdefs, sigs, fids, cnames, cvals, stage, macc, fcnt, wtypes, wexps, wskip, wcode, wfncnt, wbad, mn.text, tnames, tmods, wstrs, woffs, fowns, ecal, ecee, emul, fpois, false);
                                        if wbad.len() > emwb0 {
                                            let qbe: i64 = wbadn.push(emname);
                                        } else {
                                        }
                                        let emwn: str = emline.concat("\n");
                                        let empl: i64 = lines.push(emwn);
