    let mut wtypes: Vec<i64> = Vec::new();
    let mut wexps: Vec<i64> = Vec::new();
    // SH-WASM W-EXPORT-HYGIENE: one entry per fn whose export entry was withheld below, so the
    // export section count matches the entries actually written.
    let mut wskip: Vec<i64> = Vec::new();
    let mut wcode: Vec<i64> = Vec::new();
    let mut wfncnt: Vec<i64> = Vec::new();
    let mut wbad: Vec<i64> = Vec::new();
    // BOOT-SELF capstone: the per-fn POISON census — the NAME of every fn whose emission
