        if undone > 0 {
            let qpu: i64 = fpois.set(0, 1);
        } else {
        }
        let mut wcc: i64 = 0;
        let mut wi2: i64 = 0;
        while wi2 < nf2 {
            let wv: i64 = fcost.get(wi2);
            wcc = cv_aclamp(wcc, wv);
            wi2 = wi2 + 1;
        }
        let fbud: i64 = 128 + wcc * 8;
        let nfss: str = cv_i64_str(nfs);
        let fbs: str = cv_i64_str(fbud);
        let mut fp: Vec<str> = Vec::new();
        let qp0: i64 = fp.push("FUELREPORT|S");
        let qp1: i64 = fp.push(nfss);
        let qp2: i64 = fp.push("|R");
        let qp3: i64 = fp.push(fbs);
        let pval: i64 = fpois.get(0);
        let mut cflag: str = "1";
        if pval == 1 {
            cflag = "0";
        } else {
        }
        let qpc0: i64 = fp.push("|C");
        let qpc1: i64 = fp.push(cflag);
        let qp4: i64 = fp.push("\n");
        let fglue: str = "";
        let fpl: str = fglue.join(fp);
        let qfl: i64 = lines.push(fpl);
    } else {
    }
    let empty4: str = "";
    let outc: str = empty4.join(lines);
    return outc;
}

// The pre-memory CV entry (CV-1..4): build → serialize (stage 0).
pub fn ai_encode_cv(nodes: Arena<PNode>, kids: Vec<i64>, root: i64) -> str ! { Alloc } {
    let r: str = ai_encode_cv_impl(nodes, kids, root, 0);
    return r;
}

// SH-AIR-CV-5: the post-memory CV entry — build → cv_mem_lower → serialize (stage 1).
pub fn ai_encode_cv_mem(nodes: Arena<PNode>, kids: Vec<i64>, root: i64) -> str ! { Alloc } {
    let r: str = ai_encode_cv_impl(nodes, kids, root, 1);
    return r;
}

// SH-FUEL F1: the post-fuel CV entry — build → cv_mem_lower → cv_fuel_insert →
// serialize (stage 2; the second stage composition).
pub fn ai_encode_cv_fuel(nodes: Arena<PNode>, kids: Vec<i64>, root: i64) -> str ! { Alloc } {
    let r: str = ai_encode_cv_impl(nodes, kids, root, 2);
    return r;
}

// SH-WASM W1: the wasm entry — build → mem → fuel → cv_emit_wasm_body per fn →
// module assembly (stage 3). Returns the WHOLE MODULE as hex (or `!!`).
pub fn ai_encode_wasm(nodes: Arena<PNode>, kids: Vec<i64>, root: i64) -> str ! { Alloc } {
    let r: str = ai_encode_cv_impl(nodes, kids, root, 3);
    return r;
}

// BOOT-SELF capstone: the per-fn W-emit POISON CENSUS — `;`-joined names of every fn whose
// emission tainted the module ("" = clean). Runs the FULL stage-3 pipeline internally (stage 4
// only swaps the RETURN); diagnostic-only, never a byte arbiter.
pub fn ai_wasm_poison_census(nodes: Arena<PNode>, kids: Vec<i64>, root: i64) -> str ! { Alloc } {
    let r: str = ai_encode_cv_impl(nodes, kids, root, 4);
    return r;
}
