        let qb2: i64 = tbl.push(112);
        let qb3: i64 = tbl.push(1);
        let qb4: i64 = wb_uleb(tbl, nfns);
        let qb5: i64 = wb_uleb(tbl, nfns);
        let qb6: i64 = m.push(4);
        let tbll: i64 = tbl.len();
        let qb7: i64 = wb_uleb(m, tbll);
