// The SIGIL type-checker, in SIGIL — PR-4c (binary int-literal pinning).
//
// Consumes the parser's `Arena<PNode>` (this file is inlined after lexer.sigil
// + parser.sigil in the differential tool) and emits, span-keyed, the resolved
// type of (a) each top-level function's RETURN type and (b) each typed
// EXPRESSION node — the Option-A differential (resolved-type table). A "type" is
// a single i64 CODE — 0..21 a scalar Type discriminant, 1000+i the i-th `record`
// declared in the module. A record-typed value emits as `tag 9` (Named) plus the
// record NAME (ET-T4). PR-3b added FIELD ACCESS (`p.x` → receiver Named(record) +
// the field's type, both at the shared node span). PR-3c adds record CONSTRUCTION
// `Name { f: v, … }`: the parser packs "Name;f1;f2;…" in the node text aligned
// with the value children (source order), so each field-init is typed with that
// field's declared type as its expected (pinning a literal like a `let`
// annotation), and the construction itself emits one Named(record) at its span.
// Enums (PR-3d) build on this; record-typed fields nest only with a full
// Arena<TNode>, a later epic.
//
// All symbols are `tc_`/`TC_`-prefixed; the node-kind constants (`P_K_*`), the
// `PNode` record, and the `Arena<PNode>` come from the inlined parser.sigil.
module typecheck;

// ── the Type -> tag contract ─────────────────────────────────────────────────
// Mirrors crates/sigil-compiler/src/type_check/types.rs discriminant order; the
// Rust oracle's `type_tag()` is the TOTAL twin (ET-T6 drift-lock). Any out-of-core
// type maps to TC_UNHANDLED, which the oracle never emits — so a corpus that
// outgrows this code diverges loudly (the parser harness's UNHANDLED=901 trick).
const TC_T_UNIT: i64 = 0;
const TC_T_BOOL: i64 = 1;
const TC_T_I32: i64 = 2;
const TC_T_U32: i64 = 3;
const TC_T_I64: i64 = 4;
const TC_T_U64: i64 = 5;
const TC_T_F64: i64 = 6;
const TC_T_STR: i64 = 7;
// PR-G0: Type::Generic (a type-parameter). Closes the ET-T6 total-Type-tag
// drift-lock (the oracle's type_tag has a tag-8 slot). NEVER pushed into the emitted
// record stream (ET-G4) — a generic body is skipped, and a type-param at a concrete
// call/construct site is SUBSTITUTED to its concrete code before emit; tag 8 lives
// only as a sig/rec-table marker.
const TC_T_GENERIC: i64 = 8;
const TC_T_NAMED: i64 = 9;
// PR-C0 (caps-in-typecheck): Type::Cap (a capability type). The oracle's
// `type_tag(Type::Cap)=10`; tag 10 is otherwise free in this sequence (Named=9,
// Array=12). RESERVED here — C0 builds the cap-declaration table but emits NO cap
// records yet (the corpus has zero `cap type` decls → byte-identical, the PR-G0
// pattern); PR-C1 emits tag-10 records for cap-typed let/param/return.
const TC_T_CAP: i64 = 10;
// Composite type tags (PR-5e). These mirror the oracle's `type_tag`: a composite
// node emits one of these PLUS a recursive `type_detail` string (the oracle's
// `mangle_type` byte-for-byte) as the record's 4th field.
const TC_T_ARRAY: i64 = 12;
const TC_T_REF: i64 = 14;
const TC_T_SLICE: i64 = 15;
const TC_T_TUPLE: i64 = 19;
// ET-D3: the composite type-detail encoder is bounded — at depth 0 it returns a
// non-matching sentinel (→ a LOUD differential divergence), never recursing.
const TC_TYPE_DEPTH_CEILING: i64 = 64;
const TC_UNHANDLED: i64 = 901;
// "No expected type" — an int literal with no pinning context defaults to i64.
const TC_NO_EXPECT: i64 = 999;
// Record type codes start here: a value of `1000 + i` is the i-th record.
const TC_REC_BASE: i64 = 1000;
// PR-C0: cap-declaration logical codes. A name that resolves to the i-th `cap type`
// decl gets code `TC_CAP_BASE + i`. Caps occupy the band [TC_CAP_BASE, TC_UNHANDLED)
// = [500, 901), DISTINCT from scalar tags (0..23), the sentinels (901/902/999), and
// record codes (>= TC_REC_BASE=1000) — so the pervasive `code >= TC_REC_BASE`
// "is-record" checks never misfire on a cap. The is-cap predicate (consumed in
// PR-C1) is `code >= TC_CAP_BASE && code < TC_UNHANDLED`. Resolution precedence is
// scalar -> record -> cap (ET-CAP-11). The 401-slot band is the boring limit (a cap
// with > 32 authorities already trips T185, so this is far beyond any real program).
const TC_CAP_BASE: i64 = 500;
// PR-6b: `Self` sentinel inside a trait method signature — substituted to the
// implementing type's code before the exact `==` satisfaction compare. 902 sits in
// the unused gap between TC_UNHANDLED (901) and TC_NO_EXPECT (999), so it never
// collides with a real Type tag (0..21) or a record code (>=1000). (A const
// initializer must be a literal — `0 - 2` is an expression and does not parse.)
const TC_T_SELF: i64 = 902;
// ASCII ':' — paths normalize `.`/`::` to "::" so a dotted member is two of these.
const TC_BYTE_COLON: i64 = 58;
// ASCII ';' — a record-construction node packs "Name;field1;field2;…" in its text.
const TC_BYTE_SEMI: i64 = 59;
// ASCII ',' — a P_K_CAP_TYPE node packs its parametric param names comma-joined in
// the 3rd ";"-segment (PR-C0 counts these to get a cap's parametric arity).
const TC_BYTE_COMMA: i64 = 44;

// The symbol table: a flat list of (name -> type code) bindings for ONE function
// body, appended as `let`s are walked. Hand-written SIGIL has no generic Map, so
// lookup is a linear scan from the most recent binding (same-scope shadowing
// wins). BLOCK scoping (PR-5g): a nested if/while/match-arm block records the
// table length on entry and `tc_scope_unwind`s on exit, so an inner shadow does
// not leak past its block — making SIGIL resolve names with proper block scoping,
// exactly as the oracle does (ET-T5 satisfied by construction).
// `detail` (PR-5e) carries a composite type's recursive `mangle_type` string
// (e.g. `$tuple2__i64_u32`, `ref_Point`) so a reference to a composite-typed
// local emits the same 4th-field detail the oracle does. Empty for scalar/record
// binds; a non-empty detail marks the bind as out-of-core for type CHECKS (the
// `tag` stays TC_UNHANDLED) but composite for EMISSION.
// `targs` (PR-G2a): for a generic-record local (`let b: Box<i64> = …`), the `;`-joined
// concrete type-arg codes ("4" for Box<i64>, "4;7" for Map<i64,str>); "" for any other
// binding. A field access on the local substitutes the field's type-param to targs[idx].
record TcBind { name: str, tag: i64, detail: str, targs: str }

// Pop every binding added since `mark` by OVERWRITING it with a dead `name:""`
// sentinel (SIGIL's Vec has no truncate/pop; `set` is the only shrink primitive).
// An empty name never matches a real lookup, so the inner-scope shadows stop
// leaking past their block. Called on exit from each nested block scope (PR-5g).
fn tc_scope_unwind(binds: Vec<TcBind> @Mut, mark: i64) -> i64 ! { Alloc } {
    let n: i64 = binds.len();
    let mut i: i64 = mark;
    while i < n {
        let dead: i64 = binds.set(i, TcBind { name: "", tag: TC_UNHANDLED, detail: "", targs: "" });
        i = i + 1;
    }
    return 0;
}

// Look up a name's type code, scanning most-recent-first; TC_UNHANDLED if unbound.
fn tc_bind_lookup(binds: Vec<TcBind>, name: str) -> i64 {
    let n: i64 = binds.len();
    let mut i: i64 = n - 1;
    while i >= 0 {
        let b: TcBind = binds.get(i);
        if b.name.bytes_eq(name) {
            return b.tag;
        } else {
        }
        i = i - 1;
    }
    return TC_UNHANDLED;
}

// The module-level function-signature table: (name -> return code + ordered param
// type codes), built in a pre-pass so a call resolves regardless of definition
// order (forward refs, recursion).
// `param_typeids` retains each declared parameter's type-node id for later AIR lowering; this
// avoids rescanning the whole syntax arena at every call site that needs an expected enum layout.
// `ret_detail` (PR-5j) is the composite mangle of the return type ("" for
// scalar/record/unit — ET-J2), so a call to a composite-returning fn emits the
// composite call-node record. `param_details` is the per-param composite mangle
// (lockstep with `params`, ET-J4) for the ref/composite-param arg-type check (T071).
// `tpbounds` (PR-6b): per type-param j, the `;`-joined trait-bound list ("Hash;Eq",
// "" if unbounded) read from the `P_K_TYPE_PARAM` text. `parmtp`: per param i, the
// index of the type-param it bare-IS (a param `x: T` → j), or -1 if the param's type
// is concrete. Together they let a call site map arg i → the bounds it must satisfy.
// `rettp` (PR-G1a): the type-param index the RETURN type bare-IS (`fn id<T>(x: T) -> T`
// → 0), or -1 when the return is concrete or a composite generic (`-> Holder<T>`). A
// call to a `rettp >= 0` callee SUBSTITUTES the return code from the concrete arg that
// binds that type-param (ET-G3b), or fires T150 if no arg binds it.
record TcSig { name: str, ret: i64, params: Vec<i64>, param_typeids: Vec<i64>, ret_detail: str, param_details: Vec<str>, tpbounds: Vec<str>, parmtp: Vec<i64>, rettp: i64 }

// Find the signature index for a function name, or 0-1 if not declared.
fn tc_sig_find(sigs: Vec<TcSig>, name: str) -> i64 {
    let n: i64 = sigs.len();
    let mut i: i64 = 0;
    while i < n {
        let s: TcSig = sigs.get(i);
        if s.name.bytes_eq(name) {
            return i;
        } else {
        }
        i = i + 1;
    }
    return 0 - 1;
}

// PR-6b: the trait table — one entry per declared `trait`. Method signatures are
// stored as PARALLEL flat vecs (no generic Map): method k owns name `mnames[k]`,
// return `mrets[k]`, and params `mptags[mstarts[k] .. +mcounts[k]]` in the flat
// `mptags` pool — exactly the vstarts/vcounts/vptags idiom TcRec uses for enum
// variants. A method's `Self` param/return is stored as TC_T_SELF (substituted at
// satisfaction time). Methods are stored SORTED by name (ET-TR8) so the FIRST
// structural failure matches the oracle's BTreeMap order (missing vs wrong-sig).
record TcTrait { name: str, mnames: Vec<str>, mrets: Vec<i64>, mstarts: Vec<i64>, mcounts: Vec<i64>, mptags: Vec<i64> }

// Index of the trait named `name`, or -1 (not declared). Linear scan (tc_sig_find
// idiom). Consulted FIRST on every bound/impl path so an unknown trait is T248
// (ET-TR5), never T249/T245.
fn tc_trait_find(traits: Vec<TcTrait>, name: str) -> i64 {
    let n: i64 = traits.len();
    let mut i: i64 = 0;
    while i < n {
        let t: TcTrait = traits.get(i);
        if t.name.bytes_eq(name) {
            return i;
        } else {
        }
        i = i + 1;
    }
    return 0 - 1;
}

// `Self` → the implementing type's code; any other code passes through. The single
// substitution applied before the exact `==` signature compare (mirrors apply_subst
// over {Self: concrete}).
fn tc_self_subst(code: i64, concrete: i64) -> i64 {
    if code == TC_T_SELF {
        return concrete;
    } else {
        return code;
    }
}

// Count the `;`-separated segments of `text` (>= 1; "" is one empty segment). Twin
// of tc_seg_at, for walking a type-param's bound list.
fn tc_seg_count(text: str) -> i64 {
    let len: i64 = text.len();
    let mut n: i64 = 1;
    let mut i: i64 = 0;
    while i < len {
        let b: i64 = text.byte_at(i);
        if b == TC_BYTE_SEMI {
            n = n + 1;
        } else {
        }
        i = i + 1;
    }
    return n;
}

// The module-level named-type table: the i-th entry has type code TC_REC_BASE + i
// and a name. RECORDS carry parallel field-name / field-type-code lists (scalar
// fields; a record-typed field is out-of-core). ENUMS (is_enum) carry no fields —
// a value of enum type and every variant construction both type as Named(enum),
// and a variant payload is typed without expectation (the oracle does not pin a
// payload literal to the variant's field type), so the variant list is not needed.
// `vnames`/`vstarts`/`vcounts`/`vptags` (enums only) hold each variant's payload
// type codes, flat: variant k's payloads are `vptags[vstarts[k] .. +vcounts[k]]`.
// Used to bind enum-payload patterns (`Opt::Some(x)` => x : the variant's
// payload type). Empty for records.
// `tpnames` (PR-G2a): the record's declared type-param names (`record Box<T>` → ["T"]),
// empty for a non-generic record. `fparmtp`: per field i (lockstep with fnames/ftags),
// the type-param index its declared type bare-IS (`v: T` → 0), or -1 for a concrete
// field. Together they let a field access on a generic-record local substitute the
// field's type from the local's tracked concrete type-args (TcBind.targs).
record TcRec { name: str, fnames: Vec<str>, ftags: Vec<i64>, is_enum: bool, vnames: Vec<str>, vstarts: Vec<i64>, vcounts: Vec<i64>, vptags: Vec<i64>, tpnames: Vec<str>, fparmtp: Vec<i64>, vptp: Vec<i64> }

// PR-C0 (caps-in-typecheck): one entry per `cap type` declaration, in source order
// (so the i-th cap resolves to the deterministic logical code TC_CAP_BASE + i — no
// HashMap, order-stable per ET-CAP-12). `pnames` is the parametric ARITY: the count
// of deadline params (`cap type Approval(a: i64, b: i64)` → 2; a non-parametric cap
// → 0). The arity is the Cap(n,[]) vs Cap(n,[d]) hard boundary (PR-C4); C0 only
// records it. Mirrors the Rust oracle's `universe.caps` set + parametric arity.
record TcCap { name: str, pnames: i64 }

// Index of the variant named `vnm` in the enum at `rdefs[ridx]`, or -1.
fn tc_variant_index(rdefs: Vec<TcRec>, ridx: i64, vnm: str) -> i64 {
    let erec: TcRec = rdefs.get(ridx);
    let n: i64 = erec.vnames.len();
    let mut i: i64 = 0;
    while i < n {
        let nm: str = erec.vnames.get(i);
        if nm.bytes_eq(vnm) {
            return i;
        } else {
        }
        i = i + 1;
    }
    return 0 - 1;
}

// The type code of the named field of the record at index `ridx`, or
// TC_UNHANDLED if the record has no such field.
fn tc_find_field(rdefs: Vec<TcRec>, ridx: i64, fname: str) -> i64 {
    let rec: TcRec = rdefs.get(ridx);
    let n: i64 = rec.fnames.len();
    let mut i: i64 = 0;
    while i < n {
        let nm: str = rec.fnames.get(i);
        if nm.bytes_eq(fname) {
            return rec.ftags.get(i);
        } else {
        }
        i = i + 1;
    }
    return TC_UNHANDLED;
}

// Does the record at `ridx` declare a field named `fname`? Distinct from
// tc_find_field, which returns TC_UNHANDLED for BOTH a missing field AND a field
// of out-of-core type — the unknown-field diagnostic (T120) needs the genuinely-
// absent case only.
fn tc_has_field(rdefs: Vec<TcRec>, ridx: i64, fname: str) -> bool {
    let rec: TcRec = rdefs.get(ridx);
    let n: i64 = rec.fnames.len();
    let mut i: i64 = 0;
    while i < n {
        let nm: str = rec.fnames.get(i);
        if nm.bytes_eq(fname) {
            return true;
        } else {
        }
        i = i + 1;
    }
    return false;
}

// PR-G2a: the type-param index that the named field of the record at `ridx` bare-IS
// (lockstep with tc_find_field via `fparmtp`), or -1 for a concrete field / no such
// field. A generic-record field access substitutes the field's declared type to the
// receiver-local's concrete type-arg at this index.
fn tc_field_parmtp(rdefs: Vec<TcRec>, ridx: i64, fname: str) -> i64 {
    let rec: TcRec = rdefs.get(ridx);
    let n: i64 = rec.fnames.len();
    let mut i: i64 = 0;
    while i < n {
        let nm: str = rec.fnames.get(i);
        if nm.bytes_eq(fname) {
            return rec.fparmtp.get(i);
        } else {
        }
        i = i + 1;
    }
    return 0 - 1;
}

// Index of the FIRST byte of the LAST "::" in a path text, or 0-1 if none. (A
// member access `p.x` is stored as "p::x"; the last "::" separates the receiver
// path from the final segment.)
fn tc_last_colons(text: str) -> i64 {
    let n: i64 = text.len();
    let mut last: i64 = 0 - 1;
    let mut i: i64 = 0;
    while i < n - 1 {
        let b: i64 = text.byte_at(i);
        if b == TC_BYTE_COLON {
            let b2: i64 = text.byte_at(i + 1);
            if b2 == TC_BYTE_COLON {
                last = i;
                i = i + 2;
            } else {
                i = i + 1;
            }
        } else {
            i = i + 1;
        }
    }
    return last;
}

// The n-th ";"-delimited segment of a path text, or "" if there are fewer than
// n+1 segments. A record-construction node's text is "Name;f1;f2;…" — segment 0
// is the record name, segment i+1 is the i-th field's name (source order, so it
// aligns with the i-th value child).
fn tc_seg_at(text: str, n: i64) -> str {
    let len: i64 = text.len();
    let mut seg: i64 = 0;
    let mut segstart: i64 = 0;
    let mut i: i64 = 0;
    while i < len {
        let b: i64 = text.byte_at(i);
        if b == TC_BYTE_SEMI {
            if seg == n {
                return text.substr(segstart, i);
            } else {
            }
            seg = seg + 1;
            segstart = i + 1;
        } else {
        }
        i = i + 1;
    }
    if seg == n {
        return text.substr(segstart, len);
    } else {
    }
    return "";
}

// PR-G2a: parse a non-negative decimal string (an itoa'd type code) back to i64. An
// empty string (a missing `targs` segment) returns TC_UNHANDLED — NOT 0, which is the
// valid Unit code — so a substitution miss never aliases a real type.
fn tc_atoi(s: str) -> i64 {
    let n: i64 = s.len();
    if n == 0 {
        return TC_UNHANDLED;
    } else {
    }
    let mut acc: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        let b: i64 = s.byte_at(i);
        acc = acc * 10 + (b - 48);
        i = i + 1;
    }
    return acc;
}

// PR-G2a: the `;`-joined concrete type-arg codes of a generic-annotation type node
// (`Box<i64>` → "4", `Map<i64, str>` → "4;7"). Each child is a P_K_TYPE arg resolved via
// tc_code_of_name (a non-plain/composite arg → its TC_UNHANDLED code); "" if the node has
// no type-arg children (a non-generic annotation).
fn tc_typearg_codes(nodes: Arena<PNode>, kids: Vec<i64>, typeid: i64, rdefs: Vec<TcRec>) -> str ! { Alloc } {
    let tn: PNode = nodes.get(typeid);
    let mut out: str = "";
    let mut i: i64 = 0;
    while i < tn.child_count {
        let acid: i64 = kids.get(tn.child_start + i);
        let acn: PNode = nodes.get(acid);
        let mut code: i64 = TC_UNHANDLED;
        if acn.kind == P_K_TYPE {
            if acn.flags == 0 {
                if acn.child_count == 0 {
                    code = tc_code_of_name(acn.text, rdefs);
                } else {
                }
            } else {
            }
        } else {
        }
        let cs: str = code.itoa();
        if i == 0 {
            out = cs;
        } else {
            let semi: str = out.concat(";");
            out = semi.concat(cs);
        }
        i = i + 1;
    }
    return out;
}

// PR-G2a-ii: a lightweight field-value type for un-annotated generic-record construction
// inference — enough to bind a type-param from the value WITHOUT re-emitting records. An
// int literal defaults to i64 (the un-annotated default), other literals to their scalar
// type, a bare variable to its binding; anything else (call, nested construct) →
// TC_UNHANDLED (the type-param stays unbound → T233).
fn tc_value_type_light(nodes: Arena<PNode>, kids: Vec<i64>, vid: i64, binds: Vec<TcBind>) -> i64 {
    let vn: PNode = nodes.get(vid);
    if vn.kind == P_K_LIT_INT {
        return TC_T_I64;
    } else {
    }
    if vn.kind == P_K_LIT_STR {
        return TC_T_STR;
    } else {
    }
    if vn.kind == P_K_LIT_BOOL {
        return TC_T_BOOL;
    } else {
    }
    if vn.kind == P_K_LIT_FLOAT {
        return TC_T_F64;
    } else {
    }
    if vn.kind == P_K_PATH {
        let cc: i64 = tc_last_colons(vn.text);
        if cc < 0 {
            return tc_bind_lookup(binds, vn.text);
        } else {
        }
    } else {
    }
    return TC_UNHANDLED;
}

// PR-G2a-ii: infer an UN-ANNOTATED generic-record construct's type-args from its field
// values (the construction-inference). Per type-param j, the FIRST field that bare-IS it
// supplies the concrete code via the lightweight value type; a type-param NO field binds is
// left TC_UNHANDLED (→ T233 at the call site). Returns the ";"-joined codes, "" if the
// record is non-generic / unknown. (Conflict detection — T234 — and the IntLit-flex of a
// mixed int-lit + concrete binding are PR-G2a-iii; here the FIRST binding wins.)
fn tc_infer_targs(nodes: Arena<PNode>, kids: Vec<i64>, ctorid: i64, rdefs: Vec<TcRec>, binds: Vec<TcBind>, diags: Vec<str> @Mut) -> str ! { Alloc } {
    let cn: PNode = nodes.get(ctorid);
    let recname: str = tc_seg_at(cn.text, 0);
    let rcode: i64 = tc_code_of_name(recname, rdefs);
    if rcode < TC_REC_BASE {
        return "";
    } else {
    }
    let ridx: i64 = rcode - TC_REC_BASE;
    let rec: TcRec = rdefs.get(ridx);
    let ntp: i64 = rec.tpnames.len();
    if ntp == 0 {
        return "";
    } else {
    }
    let mut out: str = "";
    let mut j: i64 = 0;
    while j < ntp {
        // Prefer the first CONCRETE (non-int-literal) field binding the type-param — a
        // concrete `u32` field beats an int-literal `5` field (`Pair { a: 5, b: u }` infers
        // u32, matching the oracle's IntLit flex). A type-param bound ONLY by int-literal
        // field(s) defaults to i64 (the un-annotated default; a non-i64-context read of such
        // a field is the IntLit-flex boundary, AG-G12). No binding field → TC_UNHANDLED (T233).
        // PR-G2a-iii: T234 when two bindings CONFLICT — a second concrete differing from the
        // first, OR an int-literal binding when the resolved concrete is a NON-int type (the
        // int literal cannot flex to it). Int-lit + int-lit, and int-lit + int-concrete, do
        // NOT conflict (the literal flexes). One T234 per conflicting type-param.
        let mut hard: i64 = TC_NO_EXPECT;
        let mut soft: bool = false;
        let mut conflict: bool = false;
        let mut any_field: bool = false;
        let mut fi: i64 = 0;
        while fi < cn.child_count {
            let fname: str = tc_seg_at(cn.text, fi + 1);
            let fptp: i64 = tc_field_parmtp(rdefs, ridx, fname);
            if fptp == j {
                any_field = true;
                let fvid: i64 = kids.get(cn.child_start + fi);
                let fvn: PNode = nodes.get(fvid);
                if fvn.kind == P_K_LIT_INT {
                    soft = true;
                } else {
                    let cval: i64 = tc_value_type_light(nodes, kids, fvid, binds);
                    if tc_is_concrete(hard) {
                        if cval == hard {
                        } else {
                            if tc_is_concrete(cval) {
                                conflict = true;
                            } else {
                            }
                        }
                    } else {
                        hard = cval;
                    }
                }
            } else {
            }
            fi = fi + 1;
        }
        if soft {
            if tc_is_concrete(hard) {
                if tc_is_int_type(hard) {
                } else {
                    conflict = true;
                }
            } else {
            }
        } else {
        }
        // Resolve the type-param + its construction-inference diagnostic. A CONFLICT (fields
        // disagree) → T234; a type-param NO field binds → T233 ("cannot be inferred"); both
        // resolve to the ERROR sentinel (TC_UNHANDLED) so a later field read does NOT cascade
        // a spurious mismatch (the oracle uses Type::Error at the slot, emitting ONLY the
        // T233/T234). A bound, non-conflicting param resolves to its concrete (or i64 default).
        // T233 and T234 are mutually exclusive per type-param, so exactly one fires.
        let mut code: i64 = TC_UNHANDLED;
        if conflict {
            let dc234: i64 = tc_push_diag(diags, "T234");
        } else {
            if any_field {
                if tc_is_concrete(hard) {
                    code = hard;
                } else {
                    if soft {
                        code = TC_T_I64;
                    } else {
                    }
                }
            } else {
                let dc233: i64 = tc_push_diag(diags, "T233");
            }
        }
        let cs: str = code.itoa();
        if j == 0 {
            out = cs;
        } else {
            let semi: str = out.concat(";");
            out = semi.concat(cs);
        }
        j = j + 1;
    }
    return out;
}

// Map a plain scalar type name (a K_TYPE node's text) to its Type tag, or
// TC_UNHANDLED if it is not a built-in scalar (it may still be a record name —
// see tc_code_of_name).
fn tc_scalar_tag(name: str) -> i64 {
    if name.bytes_eq("bool") {
        return TC_T_BOOL;
    } else {
    }
    if name.bytes_eq("i32") {
        return TC_T_I32;
    } else {
    }
    if name.bytes_eq("u32") {
        return TC_T_U32;
    } else {
    }
    if name.bytes_eq("i64") {
        return TC_T_I64;
    } else {
    }
    if name.bytes_eq("u64") {
        return TC_T_U64;
    } else {
    }
    if name.bytes_eq("f64") {
        return TC_T_F64;
    } else {
    }
    if name.bytes_eq("str") {
        return TC_T_STR;
    } else {
    }
    return TC_UNHANDLED;
}

// Resolve a plain type name to a type CODE: a built-in scalar tag, else the
// record code (TC_REC_BASE + index) if it names a declared record, else
// TC_UNHANDLED.
fn tc_code_of_name(name: str, rdefs: Vec<TcRec>) -> i64 {
    let st: i64 = tc_scalar_tag(name);
    if st != TC_UNHANDLED {
        return st;
    } else {
    }
    let n: i64 = rdefs.len();
    let mut i: i64 = 0;
    while i < n {
        let rec: TcRec = rdefs.get(i);
        if rec.name.bytes_eq(name) {
            return TC_REC_BASE + i;
        } else {
        }
        i = i + 1;
    }
    return TC_UNHANDLED;
}

// SELF-1: the stdlib generics the ambient-include pass registers into the oracle's type
// universe (stdlib/sigil/*.sigil record/enum decls: Vec/Arena/Map/Option/Result + the
// iterator records) plus the oracle's hardcoded `Slot`. The self-hosted tc has NO ambient
// injection — rdefs holds the module's OWN decls only — so a `let v: Vec<i64>` annotation is
// invisible to tc_code_of_name and would false-fire T046 at the PR-G4 let path. But the oracle
// ACCEPTS it: resolve_annotated_let_type (statements.rs:1636) accepts a `Named(name,args)` let
// annotation iff `name` is a known record/enum with `args.len() == arity`. This returns that
// arity for the fixed stdlib-generic set (or -1 for a non-stdlib name) so the let path can
// mirror the oracle's VERDICT — accept a known base at MATCHING arity, keep T046 for an unknown
// base or a wrong-arity generic (an allowlist, never a blanket accept). Arity = the decl's
// type-param count: single-param generics -> 1; Map/Result and the two-param iterators -> 2.
fn tc_stdlib_generic_arity(name: str) -> i64 {
    if name.bytes_eq("Vec") {
        return 1;
    } else {
    }
    if name.bytes_eq("Arena") {
        return 1;
    } else {
    }
    if name.bytes_eq("Option") {
        return 1;
    } else {
    }
    if name.bytes_eq("Slot") {
        return 1;
    } else {
    }
    if name.bytes_eq("VecIter") {
        return 1;
    } else {
    }
    if name.bytes_eq("TakeIter") {
        return 1;
    } else {
    }
    if name.bytes_eq("Map") {
        return 2;
    } else {
    }
    if name.bytes_eq("Result") {
        return 2;
    } else {
    }
    if name.bytes_eq("MapIter") {
        return 2;
    } else {
    }
    if name.bytes_eq("FilterIter") {
        return 2;
    } else {
    }
    return 0 - 1;
}

// PR-C0: resolve a name to its cap logical code (TC_CAP_BASE + i) if it names a
// declared `cap type`, else TC_UNHANDLED. This is the "cap arm" of name resolution
// (ET-CAP-11): consulted AFTER scalar/record at the cap-typing sites in PR-C1, so a
// name shadowed by a scalar/record never reaches here. INERT on the current corpus
// (`cdefs` is empty → always TC_UNHANDLED). Linear scan over the flat Vec<TcCap>,
// most-foundational-first, order-stable (ET-CAP-12).
fn tc_cap_code_of_name(name: str, cdefs: Vec<TcCap>) -> i64 {
    let n: i64 = cdefs.len();
    let mut i: i64 = 0;
    while i < n {
        let c: TcCap = cdefs.get(i);
        if c.name.bytes_eq(name) {
            return TC_CAP_BASE + i;
        } else {
        }
        i = i + 1;
    }
    return TC_UNHANDLED;
}

// The mangle leaf for a scalar type CODE — the inverse of tc_scalar_tag, used
// INSIDE a composite detail (where a scalar element mangles to its name, unlike
// a top-level scalar node which emits an empty 4th field). Empty for non-scalars.
fn tc_scalar_mangle(code: i64) -> str {
    if code == TC_T_UNIT {
        return "unit";
    } else {
    }
    if code == TC_T_BOOL {
        return "bool";
    } else {
    }
    if code == TC_T_I32 {
        return "i32";
    } else {
    }
    if code == TC_T_U32 {
        return "u32";
    } else {
    }
    if code == TC_T_I64 {
        return "i64";
    } else {
    }
    if code == TC_T_U64 {
        return "u64";
    } else {
    }
    if code == TC_T_F64 {
        return "f64";
    } else {
    }
    if code == TC_T_STR {
        return "str";
    } else {
    }
    return "";
}

// Recursively mangle a TYPE node into the oracle's `mangle_type` string (PR-5e).
// `tc_tmangle` handles the ref/slice FLAGS that ride on the inner node (1 `&`,
// 2 `&mut`, 3 `&[slice]`); `tc_tmangle_kind` handles the node's KIND with flags
// ignored. Mutually recursive (SIGIL resolves fn sigs in a pre-pass). ET-D3: at
// depth 0 a "DEPTH" sentinel is returned (no further recursion) — it matches no
// oracle detail, so an over-deep type surfaces as a LOUD differential mismatch.
fn tc_tmangle(nodes: Arena<PNode>, kids: Vec<i64>, typeid: i64, rdefs: Vec<TcRec>, depth: i64) -> str ! { Alloc } {
    if depth <= 0 {
        return "DEPTH";
    } else {
    }
    let n: PNode = nodes.get(typeid);
    if n.flags == 1 {
        let in1: str = tc_tmangle_kind(nodes, kids, typeid, rdefs, depth - 1);
        let pre1: str = "ref_";
        return pre1.concat(in1);
    } else {
    }
    if n.flags == 2 {
        let in2: str = tc_tmangle_kind(nodes, kids, typeid, rdefs, depth - 1);
        let pre2: str = "ref_mut_";
        return pre2.concat(in2);
    } else {
    }
    if n.flags == 3 {
        let in3: str = tc_tmangle_kind(nodes, kids, typeid, rdefs, depth - 1);
        let pre3: str = "slice__";
        return pre3.concat(in3);
    } else {
    }
    return tc_tmangle_kind(nodes, kids, typeid, rdefs, depth - 1);
}

// The kind-dispatch half of the composite mangle (flags ignored — the caller
// already prefixed any ref/slice). Tuple => `$tupleN__e0$e1$…`, Array =>
// `Array__<elem>$<size>` (R2: `$`-separated for an injective mangle), a plain
// nominal => its scalar mangle or record/Named
// name. Each element recurses through tc_tmangle so nested refs/composites mangle.
fn tc_tmangle_kind(nodes: Arena<PNode>, kids: Vec<i64>, typeid: i64, rdefs: Vec<TcRec>, depth: i64) -> str ! { Alloc } {
    let n: PNode = nodes.get(typeid);
    if n.kind == P_K_TYPE_TUPLE {
        let cnt: str = n.child_count.itoa();
        let tp: str = "$tuple";
        let h1: str = tp.concat(cnt);
        let mut acc: str = h1.concat("__");
        let mut i: i64 = 0;
        while i < n.child_count {
            let cid: i64 = kids.get(n.child_start + i);
            let part: str = tc_tmangle(nodes, kids, cid, rdefs, depth - 1);
            if i == 0 {
                acc = acc.concat(part);
            } else {
                let withsep: str = acc.concat("$");
                acc = withsep.concat(part);
            }
            i = i + 1;
        }
        return acc;
    } else {
    }
    if n.kind == P_K_TYPE_ARRAY {
        let elem: i64 = kids.get(n.child_start);
        let em: str = tc_tmangle(nodes, kids, elem, rdefs, depth - 1);
        let ap: str = "Array__";
        let a1: str = ap.concat(em);
        let a2: str = a1.concat("$");
        return a2.concat(n.value.itoa());
    } else {
    }
    if n.kind == P_K_TYPE {
        if n.child_count == 0 {
            let code: i64 = tc_code_of_name(n.text, rdefs);
            let sm: str = tc_scalar_mangle(code);
            if sm.len() > 0 {
                return sm;
            } else {
                return n.text;
            }
        } else {
            return "GENERIC";
        }
    } else {
    }
    return "UNKNOWN";
}

// The top-level EMISSION tag for a composite type node: Ref/Slice (from the ride
// flags) or Tuple/Array (from the kind). A plain nominal returns its scalar/record
// code. Used for the function-return record + composite let/param resolution.
fn tc_type_topcode(nodes: Arena<PNode>, kids: Vec<i64>, typeid: i64, rdefs: Vec<TcRec>) -> i64 {
    let n: PNode = nodes.get(typeid);
    if n.flags == 1 {
        return TC_T_REF;
    } else {
    }
    if n.flags == 2 {
        return TC_T_REF;
    } else {
    }
    if n.flags == 3 {
        return TC_T_SLICE;
    } else {
    }
    if n.kind == P_K_TYPE_TUPLE {
        return TC_T_TUPLE;
    } else {
    }
    if n.kind == P_K_TYPE_ARRAY {
        return TC_T_ARRAY;
    } else {
    }
    if n.kind == P_K_TYPE {
        if n.child_count == 0 {
            return tc_code_of_name(n.text, rdefs);
        } else {
            return TC_UNHANDLED;
        }
    } else {
    }
    return TC_UNHANDLED;
}

// True iff a TYPE node denotes a COMPOSITE (Ref/Slice via flags, or Tuple/Array
// via kind) — i.e. one whose record carries a non-empty `mangle_type` detail. A
// plain scalar/record nominal is NOT composite (it emits via tc_push_rec).
fn tc_is_composite_typenode(nodes: Arena<PNode>, typeid: i64) -> bool {
    let n: PNode = nodes.get(typeid);
    if n.flags == 1 {
        return true;
    } else {
    }
    if n.flags == 2 {
        return true;
    } else {
    }
    if n.flags == 3 {
        return true;
    } else {
    }
    if n.kind == P_K_TYPE_TUPLE {
        return true;
    } else {
    }
    if n.kind == P_K_TYPE_ARRAY {
        return true;
    } else {
    }
    return false;
}

// True iff `s` begins with `p` (ASCII prefix — all mangle prefixes are ASCII).
fn tc_str_starts(s: str, p: str) -> bool {
    let pl: i64 = p.len();
    let sl: i64 = s.len();
    if sl < pl {
        return false;
    } else {
    }
    let head: str = s.substr(0, pl);
    return head.bytes_eq(p);
}

// Recover a composite bind's EMISSION tag from its mangle detail prefix. `ref_mut_`
// must be tested before `ref_` (the longer prefix subsumes the shorter).
fn tc_detail_tag(detail: str) -> i64 {
    if tc_str_starts(detail, "$tuple") {
        return TC_T_TUPLE;
    } else {
    }
    if tc_str_starts(detail, "ref_mut_") {
        return TC_T_REF;
    } else {
    }
    if tc_str_starts(detail, "ref_") {
        return TC_T_REF;
    } else {
    }
    if tc_str_starts(detail, "slice__") {
        return TC_T_SLICE;
    } else {
    }
    if tc_str_starts(detail, "Array__") {
        return TC_T_ARRAY;
    } else {
    }
    return TC_UNHANDLED;
}

// The `mangle_type` leaf for a resolved type CODE (PR-5f): a scalar maps to its
// mangle name, a record/Named (>= TC_REC_BASE) to its bare name, anything else to
// "" (a composite element is out-of-core for the depth-1 literal encoder). Used to
// build an array/tuple LITERAL's detail from its already-typed elements.
fn tc_code_mangle(code: i64, rdefs: Vec<TcRec>) -> str {
    if code >= TC_REC_BASE {
        let rec: TcRec = rdefs.get(code - TC_REC_BASE);
        return rec.name;
    } else {
    }
    return tc_scalar_mangle(code);
}

// The element type CODE of an array, parsed from its `Array__<elem>_<size>` detail
// (PR-5f, scalar/record element case): strip the prefix, split off the trailing
// `_<size>` at the LAST underscore, resolve the remaining `<elem>`. A composite
// element (whose mangle itself contains `_`) resolves to TC_UNHANDLED — correct,
// since arrays of composites are out of this slice's scope.
fn tc_array_elem_code(detail: str, rdefs: Vec<TcRec>) -> i64 {
    if tc_str_starts(detail, "Array__") {
    } else {
        return TC_UNHANDLED;
    }
    let dlen: i64 = detail.len();
    let rest: str = detail.substr(7, dlen);
    let rlen: i64 = rest.len();
    let mut lastu: i64 = 0 - 1;
    let mut i: i64 = 0;
    while i < rlen {
        let ch: str = rest.substr(i, i + 1);
        if ch.bytes_eq("$") {
            lastu = i;
        } else {
        }
        i = i + 1;
    }
    if lastu < 0 {
        return TC_UNHANDLED;
    } else {
    }
    let elemstr: str = rest.substr(0, lastu);
    return tc_code_of_name(elemstr, rdefs);
}

// A bind's composite `detail` by name (most-recent-first), or "" if unbound or a
// non-composite (scalar/record) bind.
fn tc_bind_detail(binds: Vec<TcBind>, name: str) -> str {
    let n: i64 = binds.len();
    let mut i: i64 = n - 1;
    while i >= 0 {
        let b: TcBind = binds.get(i);
        if b.name.bytes_eq(name) {
            return b.detail;
        } else {
        }
        i = i - 1;
    }
    return "";
}

// PR-G2a: a bind's generic-record `targs` by name (most-recent-first), or "" if unbound
// or not a generic-record local. A field access on the local substitutes via these codes.
fn tc_bind_targs(binds: Vec<TcBind>, name: str) -> str {
    let n: i64 = binds.len();
    let mut i: i64 = n - 1;
    while i >= 0 {
        let b: TcBind = binds.get(i);
        if b.name.bytes_eq(name) {
            return b.targs;
        } else {
        }
        i = i - 1;
    }
    return "";
}

// PR-C1: the bare cap name a type node denotes, or "" if the node is not a plain
// `cap type` name. A plain name (flags 0, no children) that is NOT a scalar/record
// (tc_code_of_name == UNHANDLED) but IS a declared cap (tc_cap_code_of_name !=
// UNHANDLED) resolves to its bare name — the oracle's render_type(Type::Cap) detail
// for the non-parametric case. A deadline-bearing cap annotation (`Approval(2030,…)`)
// has type-arg children, so it is not a plain name → "" (out-of-core, deferred to C4).
fn tc_cap_name_of_typenode(nodes: Arena<PNode>, tid: i64, rdefs: Vec<TcRec>, cdefs: Vec<TcCap>) -> str {
    let tn: PNode = nodes.get(tid);
    if tn.kind == P_K_TYPE {
        if tn.flags == 0 {
            if tn.child_count == 0 {
                let sc: i64 = tc_code_of_name(tn.text, rdefs);
                if sc == TC_UNHANDLED {
                    let cc: i64 = tc_cap_code_of_name(tn.text, cdefs);
                    if cc != TC_UNHANDLED {
                        return tn.text;
                    } else {
                    }
                } else {
                }
            } else {
            }
        } else {
        }
    } else {
    }
    return "";
}

// The composite `detail` of a function parameter's declared type, or "" if the
// param is scalar/record (non-composite). Mirrors tc_param_type_tag's child walk.
// PR-C1: a cap-typed param carries its bare cap name as `detail` (the bind's tag is
// TC_T_CAP) so the var-ref emission emits `tag 10, <cap name>` via tc_push_rec_detail.
fn tc_param_detail(nodes: Arena<PNode>, kids: Vec<i64>, paramid: i64, rdefs: Vec<TcRec>, cdefs: Vec<TcCap>) -> str ! { Alloc } {
    let pn: PNode = nodes.get(paramid);
    if pn.child_count >= 1 {
        let tid: i64 = kids.get(pn.child_start);
        if tc_is_composite_typenode(nodes, tid) {
            return tc_tmangle(nodes, kids, tid, rdefs, TC_TYPE_DEPTH_CEILING);
        } else {
        }
        let capn: str = tc_cap_name_of_typenode(nodes, tid, rdefs, cdefs);
        if capn.len() > 0 {
            return capn;
        } else {
        }
    } else {
    }
    return "";
}

// Build + push one `start,end,tag,detail;` record with an EXPLICIT tag and detail
// string (PR-5e) — the composite-type sibling of tc_push_rec (which derives the
// tag/name from a type CODE). The detail is the oracle's `mangle_type` byte string.
fn tc_push_rec_detail(recs: Vec<str> @Mut, start: i64, end: i64, tag: i64, detail: str) -> i64 ! { Alloc } {
    let a1: str = start.itoa();
    let a2: str = a1.concat(",");
    let a3: str = a2.concat(end.itoa());
    let a4: str = a3.concat(",");
    let a5: str = a4.concat(tag.itoa());
    let a6: str = a5.concat(",");
    let a7: str = a6.concat(detail);
    let a8: str = a7.concat(";");
    let pushed: i64 = recs.push(a8);
    return pushed;
}

// Build + push one `start,end,tag,name;` record. A scalar code emits its tag and
// an empty name; a record code (>= TC_REC_BASE) emits tag 9 (Named) and the
// record's NAME (ET-T4: name-bearing so distinct records are distinguished).
fn tc_push_rec(recs: Vec<str> @Mut, start: i64, end: i64, code: i64, rdefs: Vec<TcRec>) -> i64 ! { Alloc } {
    let mut etag: i64 = code;
    let mut nm: str = "";
    if code >= TC_REC_BASE {
        etag = TC_T_NAMED;
        let rec: TcRec = rdefs.get(code - TC_REC_BASE);
        nm = rec.name;
    } else {
    }
    let a1: str = start.itoa();
    let a2: str = a1.concat(",");
    let a3: str = a2.concat(end.itoa());
    let a4: str = a3.concat(",");
    let a5: str = a4.concat(etag.itoa());
    let a6: str = a5.concat(",");
    let a7: str = a6.concat(nm);
    let a8: str = a7.concat(";");
    let pushed: i64 = recs.push(a8);
    return pushed;
}

// The resolved return-type code of a function node. Among a K_FN node's DIRECT
// children the return type is the only plain `K_TYPE`. No return-type child =>
// Unit. A non-plain type is out-of-core => TC_UNHANDLED.
// PR-G2b-i (ET-G15): does every type-arg child of a generic-Named type node resolve
// to a CONCRETE code (a scalar or a declared record/enum, != TC_UNHANDLED)? A
// type-param arg (the `T` in `-> Box<T>`) or a nested generic arg (`Box<Box<i64>>`)
// resolves to TC_UNHANDLED → false. Mirrors tc_typearg_codes' per-arg resolution.
fn tc_all_targs_concrete(nodes: Arena<PNode>, kids: Vec<i64>, typeid: i64, rdefs: Vec<TcRec>) -> bool {
    let tn: PNode = nodes.get(typeid);
    if tn.child_count == 0 {
        return false;
    } else {
    }
    let mut i: i64 = 0;
    while i < tn.child_count {
        let acid: i64 = kids.get(tn.child_start + i);
        let acn: PNode = nodes.get(acid);
        let mut code: i64 = TC_UNHANDLED;
        if acn.kind == P_K_TYPE {
            if acn.flags == 0 {
                if acn.child_count == 0 {
                    code = tc_code_of_name(acn.text, rdefs);
                } else {
                }
            } else {
            }
        } else {
        }
        if code == TC_UNHANDLED {
            return false;
        } else {
        }
        i = i + 1;
    }
    return true;
}

fn tc_fn_ret_tag(nodes: Arena<PNode>, kids: Vec<i64>, fnid: i64, rdefs: Vec<TcRec>) -> i64 {
    let fnn: PNode = nodes.get(fnid);
    let mut tag: i64 = TC_T_UNIT;
    let mut i: i64 = 0;
    while i < fnn.child_count {
        let cid: i64 = kids.get(fnn.child_start + i);
        let cn: PNode = nodes.get(cid);
        if cn.kind == P_K_TYPE {
            if cn.flags == 0 {
                if cn.child_count == 0 {
                    tag = tc_code_of_name(cn.text, rdefs);
                } else {
                    // PR-G2b-i (Gap A, ET-G15): a generic-Named return (`-> Opt<i64>`,
                    // `-> Box<i64>`) resolves to its base record/enum code — emitting a
                    // `9,basename` record (args dropped, matching the oracle's type_detail)
                    // — ONLY when EVERY type-arg is concrete. A type-param arg (the `T` in a
                    // generic-impl method's `-> Box<T>`) or a nested generic arg keeps
                    // TC_UNHANDLED, so the AG-G6 nested-return call-site typing is unchanged.
                    let base: i64 = tc_code_of_name(cn.text, rdefs);
                    if base >= TC_REC_BASE {
                        if tc_all_targs_concrete(nodes, kids, cid, rdefs) {
                            tag = base;
                        } else {
                            tag = TC_UNHANDLED;
                        }
                    } else {
                        tag = TC_UNHANDLED;
                    }
                }
            } else {
                tag = TC_UNHANDLED;
            }
        } else {
        }
        i = i + 1;
    }
    return tag;
}

// The function's return TYPE node id (a direct K_TYPE / K_TYPE_TUPLE / K_TYPE_ARRAY
// child — params are P_K_PARAM, so the return type is the only type-family direct
// child), or -1 for a Unit return. Used to emit a composite-aware return record.
fn tc_fn_ret_typeid(nodes: Arena<PNode>, kids: Vec<i64>, fnid: i64) -> i64 {
    let fnn: PNode = nodes.get(fnid);
    let mut found: i64 = 0 - 1;
    let mut i: i64 = 0;
    while i < fnn.child_count {
        let cid: i64 = kids.get(fnn.child_start + i);
        let cn: PNode = nodes.get(cid);
        if cn.kind == P_K_TYPE {
            found = cid;
        } else {
        }
        if cn.kind == P_K_TYPE_TUPLE {
            found = cid;
        } else {
        }
        if cn.kind == P_K_TYPE_ARRAY {
            found = cid;
        } else {
        }
        i = i + 1;
    }
    return found;
}

// The body block of a function: the one direct K_BLOCK child of a K_FN, or 0-1.
fn tc_fn_body(nodes: Arena<PNode>, kids: Vec<i64>, fnid: i64) -> i64 {
    let fnn: PNode = nodes.get(fnid);
    let mut found: i64 = 0 - 1;
    let mut i: i64 = 0;
    while i < fnn.child_count {
        let cid: i64 = kids.get(fnn.child_start + i);
        let cn: PNode = nodes.get(cid);
        if cn.kind == P_K_BLOCK {
            found = cid;
        } else {
        }
        i = i + 1;
    }
    return found;
}

// Is this binary op a comparison (result Bool) vs arithmetic (result = operand
// type)? Op codes are the lexer token tags the parser stores in K_BINARY.value.
fn tc_binop_is_compare(op: i64) -> bool {
    if op == T_LT {
        return true;
    } else {
    }
    if op == T_GT {
        return true;
    } else {
    }
    if op == T_EQEQ {
        return true;
    } else {
    }
    if op == T_BANGEQ {
        return true;
    } else {
    }
    if op == T_LTEQ {
        return true;
    } else {
    }
    if op == T_GTEQ {
        return true;
    } else {
    }
    return false;
}

// Resolve an INTEGER literal's type from its expected-type context: the four
// machine ints pin it; any other / absent expectation defaults to i64.
fn tc_int_from_expected(expected: i64) -> i64 {
    if expected == TC_T_I32 {
        return TC_T_I32;
    } else {
    }
    if expected == TC_T_U32 {
        return TC_T_U32;
    } else {
    }
    if expected == TC_T_I64 {
        return TC_T_I64;
    } else {
    }
    if expected == TC_T_U64 {
        return TC_T_U64;
    } else {
    }
    return TC_T_I64;
}

// ── PR-5a: the diagnostics channel ───────────────────────────────────────────
// Push one diagnostic code (e.g. "T041") into the diagnostics stream. Codes are
// compared as a sorted SET against the oracle's core-owned diagnostics (ET-T3,
// exact-code parity), so a bare `code;` entry is the whole tuple.
fn tc_push_diag(diags: Vec<str> @Mut, code: str) -> i64 ! { Alloc } {
    let withsemi: str = code.concat(";");
    let pushed: i64 = diags.push(withsemi);
    return pushed;
}

// a8 parity (code + span): emit "code,start,end;" — the code plus the offending
// node's byte span. Used ONLY at sites where the node's real start/end are in
// scope; spanless sites keep tc_push_diag (code-only). Assembled once via a
// fixed concat chain (mirrors tc_push_rec) — never per-char, never in a loop.
fn tc_push_diag_with_span(diags: Vec<str> @Mut, code: str, start: i64, end: i64) -> i64 ! { Alloc } {
    let b1: str = code.concat(",");
    let b2: str = b1.concat(start.itoa());
    let b3: str = b2.concat(",");
    let b4: str = b3.concat(end.itoa());
    let b5: str = b4.concat(";");
    let pushed: i64 = diags.push(b5);
    return pushed;
}

// A "concrete" type code is an actual scalar (0..7) or record/enum (>= 1000) — NOT
// the out-of-core sentinel (TC_UNHANDLED) nor the "no expectation" marker
// (TC_NO_EXPECT). A mismatch diagnostic is only raised when BOTH sides are
// concrete, so an out-of-core construct never manufactures a spurious code.
fn tc_is_concrete(code: i64) -> bool {
    if code == TC_UNHANDLED {
        return false;
    } else {
    }
    if code == TC_NO_EXPECT {
        return false;
    } else {
    }
    return true;
}

// PR-G2a-iii: one of the four machine-int types (the only slots a bare int literal flexes
// into). A non-int slot (bool/str/f64/record) admits no literal pinning — an int-literal
// field-init there is the oracle's "out-of-range integer literal" T071.
fn tc_is_int_type(code: i64) -> bool {
    if code == TC_T_I32 {
        return true;
    } else {
    }
    if code == TC_T_U32 {
        return true;
    } else {
    }
    if code == TC_T_I64 {
        return true;
    } else {
    }
    if code == TC_T_U64 {
        return true;
    } else {
    }
    return false;
}

// A built-in scalar type code (Unit..Str = 0..7).
fn tc_is_scalar(code: i64) -> bool {
    if code < TC_T_UNIT {
        return false;
    } else {
    }
    if code <= TC_T_STR {
        return true;
    } else {
    }
    return false;
}

// Is a value of resolved type `found` (whose source expression is an all-integer-
// literal subtree iff `found_is_lit`) assignable to a slot expecting `want`? Exact
// type match, OR a bare int literal pinning to any of the four machine ints. This
// mirrors the oracle's let/return/assign compatibility: no implicit int widening
// (`i32` is NOT assignable to `i64`), only an unpinned literal flexes to a machine
// int. A non-machine-int target (bool/str/f64/record) admits no literal pinning.
fn tc_assignable(want: i64, found: i64, found_is_lit: bool) -> bool {
    if want == found {
        return true;
    } else {
    }
    if found_is_lit {
        if want == TC_T_I32 {
            return true;
        } else {
        }
        if want == TC_T_U32 {
            return true;
        } else {
        }
        if want == TC_T_I64 {
            return true;
        } else {
        }
        if want == TC_T_U64 {
            return true;
        } else {
        }
    } else {
    }
    return false;
}

// Emit `code` into `diags` when a value of type `found` (an all-int-literal
// subtree iff `found_is_lit`) is NOT assignable to a slot expecting `want`. A
// no-op unless BOTH sides are concrete — an out-of-core type never manufactures a
// spurious mismatch (it would diverge the positive stream instead, ET-T6).
fn tc_check_assign(want: i64, found: i64, found_is_lit: bool, code: str, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    if tc_is_concrete(want) {
        if tc_is_concrete(found) {
            if tc_assignable(want, found, found_is_lit) {
            } else {
                let d: i64 = tc_push_diag(diags, code);
            }
        } else {
        }
    } else {
    }
    return 0;
}

// The `mangle_type` detail of the LAST record pushed (PR-5i, ET-V2): the bytes
// after the 3rd `,` and before the final `;` of `recs[len-1]` — exactly what
// `tc_emit_expr` just emitted for the value's own node. `""` for a scalar value
// AND for an empty `recs` (the index is never negative). The mangle alphabet
// excludes `,`/`;` (AG-V2), so the 3rd comma reliably starts a comma-free detail.
fn tc_last_rec_detail(recs: Vec<str>) -> str ! { Alloc } {
    let n: i64 = recs.len();
    if n == 0 {
        return "";
    } else {
    }
    let last: str = recs.get(n - 1);
    let ll: i64 = last.len();
    let mut commas: i64 = 0;
    let mut dstart: i64 = 0 - 1;
    let mut i: i64 = 0;
    while i < ll {
        let ch: str = last.substr(i, i + 1);
        if ch.bytes_eq(",") {
            commas = commas + 1;
            if commas == 3 {
                dstart = i + 1;
            } else {
            }
        } else {
        }
        i = i + 1;
    }
    if dstart < 0 {
        return "";
    } else {
    }
    let dend: i64 = ll - 1;
    if dend <= dstart {
        return "";
    } else {
    }
    return last.substr(dstart, dend);
}

// PR-5i composite-value check (ET-V1): emit `code` IFF exactly ONE of the two
// `mangle_type` details is composite (presence XOR) — a composite value in a
// scalar/unit context (or vice-versa) is ALWAYS a real mismatch the oracle
// rejects. Two composites are DEFERRED (AG-V1: the mangle erased the IntLit/
// coercion info needed to decide them soundly, and a false reject is worse than
// the bounded false-accept). Safe to call ALONGSIDE tc_check_assign: the composite
// (detail) and scalar (concrete-code) emission paths are disjoint, never double-fire.
fn tc_check_composite(a_detail: str, a_code: i64, b_detail: str, b_code: i64, code: str, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    // "composite" = a TRUE composite mangle ($tuple/ref_/slice__/Array__), NOT a
    // record NAME (a record value's detail is its bare name, which must stay on the
    // scalar/code check path). tc_detail_tag returns TC_UNHANDLED for a non-composite.
    let ac: bool = tc_detail_tag(a_detail) != TC_UNHANDLED;
    let bc: bool = tc_detail_tag(b_detail) != TC_UNHANDLED;
    if ac {
        if bc {
            // both composite — deferred (AG-V1), no emit.
        } else {
            // a composite, b non-composite: emit ONLY if b is a CONCRETE type (a real
            // scalar/record mismatch) — never an error/undefined value (the oracle
            // suppresses the return/assign mismatch when the value is already errored).
            if tc_is_concrete(b_code) {
                let da: i64 = tc_push_diag(diags, code);
            } else {
            }
        }
    } else {
        if bc {
            if tc_is_concrete(a_code) {
                let db: i64 = tc_push_diag(diags, code);
            } else {
            }
        } else {
        }
    }
    return 0;
}

// Emit `code` when a (concrete) condition type is not exactly Bool (an `if`/`while`
// condition admits no int-literal pinning — bool is required outright).
fn tc_check_bool(cond: i64, code: str, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    if tc_is_concrete(cond) {
        if cond == TC_T_BOOL {
        } else {
            let d: i64 = tc_push_diag(diags, code);
        }
    } else {
    }
    return 0;
}

// ── PR-5b: binop operand rules + name resolution ─────────────────────────────
// True for the equality operators `==`/`!=` — their operands need only be the
// SAME type (bool/str/f64 included). Arithmetic + ordering instead require the
// same NUMERIC type (tc_is_numeric).
fn tc_binop_is_equality(op: i64) -> bool {
    if op == T_EQEQ {
        return true;
    } else {
    }
    if op == T_BANGEQ {
        return true;
    } else {
    }
    return false;
}

// A numeric type code: the four machine ints or f64 (i32..f64 = 2..6). Bool, Str,
// Unit are NOT numeric — arithmetic and ordering reject them.
fn tc_is_numeric(code: i64) -> bool {
    if code < TC_T_I32 {
        return false;
    } else {
    }
    if code <= TC_T_F64 {
        return true;
    } else {
    }
    return false;
}

// Check a binary operator's (already-resolved) operands. Equality (`==`/`!=`)
// requires the SAME type → T055 on a type mismatch. Arithmetic + ordering require
// the SAME NUMERIC type → T054 on a type mismatch OR a same-but-non-numeric pair
// (bool/str). A no-op unless both sides are concrete — a pinned literal already
// shares its sibling's type, so a literal-vs-concrete pair never trips this.
// Returns 1 when a diagnostic was emitted (the operands are ill-typed), else 0 —
// the caller then propagates TC_UNHANDLED so a single binop error does not cascade
// into a spurious return/let/assign mismatch (the oracle suppresses the cascade).
fn tc_check_binop(lt: i64, rt: i64, op: i64, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    if tc_is_concrete(lt) {
        if tc_is_concrete(rt) {
            if tc_binop_is_equality(op) {
                if lt == rt {
                } else {
                    let d1: i64 = tc_push_diag(diags, "T055");
                    return 1;
                }
            } else {
                if lt == rt {
                    if tc_is_numeric(lt) {
                    } else {
                        let d2: i64 = tc_push_diag(diags, "T054");
                        return 1;
                    }
                } else {
                    let d3: i64 = tc_push_diag(diags, "T054");
                    return 1;
                }
            }
        } else {
        }
    } else {
    }
    return 0;
}

// Is `name` bound in the symbol table? Distinct from tc_bind_lookup, which returns
// TC_UNHANDLED for BOTH an unbound name AND a bound-but-out-of-core type; the
// undefined-local diagnostic (T060) needs the genuinely-unbound case only.
fn tc_bind_has(binds: Vec<TcBind>, name: str) -> bool {
    let n: i64 = binds.len();
    let mut i: i64 = n - 1;
    while i >= 0 {
        let b: TcBind = binds.get(i);
        if b.name.bytes_eq(name) {
            return true;
        } else {
        }
        i = i - 1;
    }
    return false;
}

// The CODE of the enum that declares a variant named `vname`, or -1. An UNqualified
// variant call (`A(5)` where some enum has variant `A`) is a valid construction the
// oracle accepts — so a bare-name call matching a variant is NOT an undefined
// function (no T062).
fn tc_enum_of_variant(rdefs: Vec<TcRec>, vname: str) -> i64 {
    let n: i64 = rdefs.len();
    let mut i: i64 = 0;
    while i < n {
        let rec: TcRec = rdefs.get(i);
        if rec.is_enum {
            let vk: i64 = tc_variant_index(rdefs, i, vname);
            if vk >= 0 {
                return TC_REC_BASE + i;
            } else {
            }
        } else {
        }
        i = i + 1;
    }
    return 0 - 1;
}

// PR-G2b-iii (Gap D): how many declared enums carry a variant named `vname`? A bare
// variant construction (`Some(5)`) whose name lives in ≥2 enums is AMBIGUOUS (T236)
// unless an annotation/qualifier disambiguates. Single-module, kind-disjoint (AG-G18).
fn tc_count_enums_with_variant(rdefs: Vec<TcRec>, vname: str) -> i64 {
    let n: i64 = rdefs.len();
    let mut count: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        let rec: TcRec = rdefs.get(i);
        if rec.is_enum {
            let vk: i64 = tc_variant_index(rdefs, i, vname);
            if vk >= 0 {
                count = count + 1;
            } else {
            }
        } else {
        }
        i = i + 1;
    }
    return count;
}

// PR-G2b-iii (Gap B): a generic-enum CONSTRUCT value whose annotation pins concrete
// type-args (`let o: Opt<i64> = Opt::Some("x")`) — fire T041 when a type-param payload's
// light value type is not assignable to the substituted slot. The oracle reports this as
// a let-level T041 (it infers `Opt<str>` and compares); SIGIL mirrors it via tc_check_assign
// on the payload (NOT a construct-level T071 — ET-G18). An int-literal payload flexes
// (AG-G12); a non-type-param payload / a None / a non-construct value is skipped.
fn tc_enum_ctor_payload_t041(nodes: Arena<PNode>, kids: Vec<i64>, lvid: i64, lgen_base: i64, ltargs: str, rdefs: Vec<TcRec>, binds: Vec<TcBind>, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let vn: PNode = nodes.get(lvid);
    // The enum-construct node is EITHER a bare P_K_CALL (`Some(5)` — text = "Some",
    // payloads = children[0..]) OR a qualified P_K_METHOD (`Opt::Some(5)` — text = the
    // variant "Some", child[0] = the receiver enum path, payloads = children[1..]).
    let mut is_ctor: bool = false;
    let mut argoff: i64 = 0;
    let mut vname: str = "";
    if vn.kind == P_K_CALL {
        is_ctor = true;
        argoff = 0;
        vname = vn.text;
    } else {
        if vn.kind == P_K_METHOD {
            is_ctor = true;
            argoff = 1;
            vname = vn.text;
        } else {
        }
    }
    if is_ctor {
        let ridx: i64 = lgen_base - TC_REC_BASE;
        let erec: TcRec = rdefs.get(ridx);
        if erec.is_enum {
            let vk: i64 = tc_variant_index(rdefs, ridx, vname);
            if vk >= 0 {
                let vs: i64 = erec.vstarts.get(vk);
                let vc: i64 = erec.vcounts.get(vk);
                let mut bi: i64 = 0;
                while bi < vc {
                    let cidx: i64 = argoff + bi;
                    if cidx < vn.child_count {
                        let pvptp: i64 = erec.vptp.get(vs + bi);
                        if pvptp >= 0 {
                            let pseg: str = tc_seg_at(ltargs, pvptp);
                            if pseg.len() > 0 {
                                let want: i64 = tc_atoi(pseg);
                                let argid: i64 = kids.get(vn.child_start + cidx);
                                let plt: i64 = tc_value_type_light(nodes, kids, argid, binds);
                                let plit: bool = tc_is_all_int_lit(nodes, kids, argid);
                                let dca: i64 = tc_check_assign(want, plt, plit, "T041", diags);
                            } else {
                            }
                        } else {
                        }
                    } else {
                    }
                    bi = bi + 1;
                }
            } else {
            }
        } else {
        }
    } else {
    }
    return 0;
}

// Is `name` present in a Vec of strings? (Used for match-exhaustiveness: is an
// enum variant among the covered patterns.)
fn tc_str_in_vec(v: Vec<str>, name: str) -> bool {
    let n: i64 = v.len();
    let mut i: i64 = 0;
    while i < n {
        let s: str = v.get(i);
        if s.bytes_eq(name) {
            return true;
        } else {
        }
        i = i + 1;
    }
    return false;
}

// Type an expression node under an `expected` context, the symbol table `binds`,
// the signature table `sigs`, and the record defs `rdefs`; emit its
// `start,end,tag,name;` record, recurse, and return its type code. PR-3b adds
// FIELD ACCESS in the K_PATH arm: a dotted path "base::field" whose base is a
// record local emits the receiver record (Named base) AND the field record (the
// field's type), both at the same node span.
fn tc_emit_expr(nodes: Arena<PNode>, kids: Vec<i64>, exprid: i64, expected: i64, binds: Vec<TcBind>, sigs: Vec<TcSig>, traits: Vec<TcTrait>, rdefs: Vec<TcRec>, recs: Vec<str> @Mut, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let en: PNode = nodes.get(exprid);
    if en.kind == P_K_LIT_BOOL {
        let pb: i64 = tc_push_rec(recs, en.start, en.end, TC_T_BOOL, rdefs);
        return TC_T_BOOL;
    } else {
    }
    if en.kind == P_K_LIT_STR {
        let ps: i64 = tc_push_rec(recs, en.start, en.end, TC_T_STR, rdefs);
        return TC_T_STR;
    } else {
    }
    if en.kind == P_K_FSTRING {
        // PR-E3 (Option 2b): an f-string TYPES as `str`. Recurse ONLY the hole children
        // — the children alternate chunk, hole, chunk, … (ET-E3), so EVEN indices are
        // literal chunks (no record, mirroring the oracle walk_expr) and ODD indices are
        // holes. A hole whose type is a known non-`str` type is not stringifiable in
        // PR-E3a → T262; a `str` hole, an out-of-core (TC_UNHANDLED) hole, or a hole that
        // already reported its own error (the oracle's `Type::Error` carve-out) is clean.
        // The FString's OWN str record is pushed LAST — AFTER the holes — so the
        // order-sensitive `tc_last_rec_detail` (the return/let/assign composite-check)
        // reads `str`, not the final hole's composite type (which would spuriously fire
        // T049 on a `return f"{ref_or_composite}"`). The differential SORTS records, so
        // emitting it last is parity-neutral. NO concat lowering — that is the Rust
        // pre-AIR pass, which the differential never runs.
        let mut hi: i64 = 1;
        while hi < en.child_count {
            let hid: i64 = kids.get(en.child_start + hi);
            let pre: i64 = diags.len();
            let ht: i64 = tc_emit_expr(nodes, kids, hid, TC_NO_EXPECT, binds, sigs, traits, rdefs, recs, diags);
            let post: i64 = diags.len();
            // PR-E3b: str / i64 / bool holes are stringifiable (i64 auto-converts via
            // str_itoa, bool via str_of_bool at the Rust pre-AIR pass). TC_UNHANDLED is
            // fail-soft (out-of-core), and a hole that already pushed a diagnostic is the
            // oracle's `Type::Error` carve-out. SIGIL has no `||`, so accumulate `ok`.
            let mut ok: i64 = 0;
            if ht == TC_T_STR {
                ok = 1;
            } else {
            }
            if ht == TC_T_I64 {
                ok = 1;
            } else {
            }
            if ht == TC_T_BOOL {
                ok = 1;
            } else {
            }
            if ht == TC_UNHANDLED {
                ok = 1;
            } else {
            }
            if post > pre {
                ok = 1;
            } else {
            }
            if ok == 0 {
                let d262: i64 = tc_push_diag(diags, "T262");
            } else {
            }
            hi = hi + 2;
        }
        let pf: i64 = tc_push_rec(recs, en.start, en.end, TC_T_STR, rdefs);
        return TC_T_STR;
    } else {
    }
    if en.kind == P_K_LIT_FLOAT {
        let pf: i64 = tc_push_rec(recs, en.start, en.end, TC_T_F64, rdefs);
        return TC_T_F64;
    } else {
    }
    if en.kind == P_K_LIT_INT {
        let it: i64 = tc_int_from_expected(expected);
        let pi: i64 = tc_push_rec(recs, en.start, en.end, it, rdefs);
        return it;
    } else {
    }
    if en.kind == P_K_PATH {
        let colon: i64 = tc_last_colons(en.text);
        if colon >= 0 {
            let tlen: i64 = en.text.len();
            let base: str = en.text.substr(0, colon);
            let field: str = en.text.substr(colon + 2, tlen);
            let basecode: i64 = tc_bind_lookup(binds, base);
            if basecode >= TC_REC_BASE {
                let ridx: i64 = basecode - TC_REC_BASE;
                let mut ftag: i64 = tc_find_field(rdefs, ridx, field);
                // T120: the record type has no such field. a8: emit code+span
                // (the field-access node's byte range, matching the oracle's
                // `expr.span`).
                if tc_has_field(rdefs, ridx, field) {
                } else {
                    let df120: i64 = tc_push_diag_with_span(diags, "T120", en.start, en.end);
                }
                // PR-G2a: if the field bare-IS a type-param (`v: T`) and the receiver
                // local carries concrete type-args (`b: Box<i64>`), SUBSTITUTE the field's
                // declared type to the local's concrete arg at that type-param's index —
                // `b.v` types i64. A concrete field (fparmtp == -1) or a local without
                // tracked type-args keeps the declared ftag.
                let fptp: i64 = tc_field_parmtp(rdefs, ridx, field);
                if fptp >= 0 {
                    let btargs: str = tc_bind_targs(binds, base);
                    if btargs.len() > 0 {
                        let seg: str = tc_seg_at(btargs, fptp);
                        ftag = tc_atoi(seg);
                    } else {
                    }
                } else {
                }
                let prr: i64 = tc_push_rec(recs, en.start, en.end, basecode, rdefs);
                let prf: i64 = tc_push_rec(recs, en.start, en.end, ftag, rdefs);
                return ftag;
            } else {
                // Not a record local: a dotted path whose base is an ENUM type
                // name is a unit-variant construction (`Color::Red`), typed
                // Named(enum) — ONE record at the path span (no receiver). Any
                // other `base::field` is out-of-core.
                let ecode: i64 = tc_code_of_name(base, rdefs);
                if ecode >= TC_REC_BASE {
                    let erec: TcRec = rdefs.get(ecode - TC_REC_BASE);
                    if erec.is_enum {
                        // A unit variant `Color::Red` — but the variant must exist;
                        // `E::Bogus` is an undefined local (T060) in the oracle.
                        let uvk: i64 = tc_variant_index(rdefs, ecode - TC_REC_BASE, field);
                        if uvk >= 0 {
                        } else {
                            let dv60: i64 = tc_push_diag_with_span(diags, "T060", en.start, en.end);
                        }
                        let pev: i64 = tc_push_rec(recs, en.start, en.end, ecode, rdefs);
                        return ecode;
                    } else {
                        let pu1: i64 = tc_push_rec(recs, en.start, en.end, TC_UNHANDLED, rdefs);
                        return TC_UNHANDLED;
                    }
                } else {
                    // `base::field` where base is neither a record local nor a
                    // declared type: the base name is undefined (T060).
                    let dp60: i64 = tc_push_diag_with_span(diags, "T060", en.start, en.end);
                    let pu2: i64 = tc_push_rec(recs, en.start, en.end, TC_UNHANDLED, rdefs);
                    return TC_UNHANDLED;
                }
            }
        } else {
            // PR-C1: a reference to a CAP-typed local (param) — its bind carries tag
            // TC_T_CAP (10) + detail = the bare cap name — emits `start,end,10,<name>`
            // via tc_push_rec_detail (the oracle's render_type(Type::Cap) detail). The
            // value's type is out-of-core for CHECKS (TC_UNHANDLED), so it never cascades.
            // Checked BEFORE the composite path: a bare cap name is not recognizable by
            // tc_detail_tag, so the tag-10 marker (not the detail) discriminates it.
            let vcap: i64 = tc_bind_lookup(binds, en.text);
            if vcap == TC_T_CAP {
                let capd: str = tc_bind_detail(binds, en.text);
                let pcv: i64 = tc_push_rec_detail(recs, en.start, en.end, TC_T_CAP, capd);
                return TC_UNHANDLED;
            } else {
            }
            // A reference to a COMPOSITE-typed local (PR-5e) emits the bind's
            // recursive mangle detail (e.g. `$tuple2__i64_u32`); the value's type
            // is out-of-core for CHECKS (TC_UNHANDLED), so it never cascades.
            let cdet: str = tc_bind_detail(binds, en.text);
            if cdet.len() > 0 {
                let pvd: i64 = tc_push_rec_detail(recs, en.start, en.end, tc_detail_tag(cdet), cdet);
                return TC_UNHANDLED;
            } else {
            }
            // HB-2 family-2: a bare unit-variant VALUE (`None`) — an UNBOUND name declared as
            // a variant by exactly ONE in-scope enum resolves to that enum, mirroring the
            // qualified `Option::None` value path's push (and the bare-CONSTRUCTION rule at
            // tc_enum_of_variant). Locals SHADOW variants: the bound path below wins first.
            // Ambiguity (≥2 enums) deliberately falls through to the old unbound path — no
            // corpus fixture pins the oracle's ambiguous-bare-VALUE verdict, so the shadow
            // stays conservative there rather than guessing T236's reach.
            if tc_bind_has(binds, en.text) {
            } else {
                let bvc: i64 = tc_count_enums_with_variant(rdefs, en.text);
                if bvc == 1 {
                    let bvcode: i64 = tc_enum_of_variant(rdefs, en.text);
                    let pbv: i64 = tc_push_rec(recs, en.start, en.end, bvcode, rdefs);
                    return bvcode;
                } else {
                }
            }
            let vt: i64 = tc_bind_lookup(binds, en.text);
            let pv: i64 = tc_push_rec(recs, en.start, en.end, vt, rdefs);
            // T060: a bare name not bound in the symbol table is an undefined local.
            if tc_bind_has(binds, en.text) {
            } else {
                let dl60: i64 = tc_push_diag_with_span(diags, "T060", en.start, en.end);
            }
            return vt;
        }
    } else {
    }
    if en.kind == P_K_CALL {
        let cr: i64 = tc_emit_call(nodes, kids, exprid, expected, binds, sigs, traits, rdefs, recs, diags);
        return cr;
    } else {
    }
    if en.kind == P_K_RECORD_CONSTRUCT {
        let rcr: i64 = tc_emit_construct(nodes, kids, exprid, "", binds, sigs, traits, rdefs, recs, diags);
        return rcr;
    } else {
    }
    if en.kind == P_K_METHOD {
        let mr: i64 = tc_emit_method(nodes, kids, exprid, binds, sigs, traits, rdefs, recs, diags);
        return mr;
    } else {
    }
    if en.kind == P_K_BINARY {
        let lid: i64 = kids.get(en.child_start);
        let rid: i64 = kids.get(en.child_start + 1);
        if tc_binop_is_compare(en.value) {
            let lc: i64 = tc_emit_binop_pair(nodes, kids, lid, rid, TC_NO_EXPECT, en.value, binds, sigs, traits, rdefs, recs, diags);
            let pcmp: i64 = tc_push_rec(recs, en.start, en.end, TC_T_BOOL, rdefs);
            return TC_T_BOOL;
        } else {
            let la: i64 = tc_emit_binop_pair(nodes, kids, lid, rid, expected, en.value, binds, sigs, traits, rdefs, recs, diags);
            let parith: i64 = tc_push_rec(recs, en.start, en.end, la, rdefs);
            return la;
        }
    } else {
    }
    if en.kind == P_K_BORROW {
        // `&inner` / `&mut inner` (PR-5e). Type the inner first (it emits its own
        // record), then emit the borrow node: a record/Named inner yields a Ref
        // (`ref_Name` / `ref_mut_Name`, tag 14); the mut bit rides node.flags==1.
        // Borrow of a non-nominal (a scalar rejects T133; an array decays to a
        // slice — both deferred) is out-of-core => the loud TC_UNHANDLED sentinel.
        let bid: i64 = kids.get(en.child_start);
        let ic: i64 = tc_emit_expr(nodes, kids, bid, TC_NO_EXPECT, binds, sigs, traits, rdefs, recs, diags);
        if ic >= TC_REC_BASE {
            let brec: TcRec = rdefs.get(ic - TC_REC_BASE);
            let mut pre: str = "ref_";
            if en.flags == 1 {
                pre = "ref_mut_";
            } else {
            }
            let bdetail: str = pre.concat(brec.name);
            let pbr: i64 = tc_push_rec_detail(recs, en.start, en.end, TC_T_REF, bdetail);
            return TC_UNHANDLED;
        } else {
            let pub2: i64 = tc_push_rec(recs, en.start, en.end, TC_UNHANDLED, rdefs);
            return TC_UNHANDLED;
        }
    } else {
    }
    if en.kind == P_K_ARRAY {
        // `[e0, e1, …]` (PR-5f). Each element is typed under `expected`. In most
        // contexts `expected` is TC_NO_EXPECT, so an int-literal element defaults
        // i64 (the oracle types the literal's own type, not the context's). The
        // ONE exception is the array-stride fix mirror: a `[T;N]`-annotated `let`
        // value threads T (an int type) here so int-literal elements resolve to T
        // — matching the Rust oracle's resolve_int_literals_in_expr, so the
        // emitted Array detail + element records are T, not i64 (the storage
        // stride the Rust compiler lays down then agrees with the readers). A
        // non-int `expected` (NO_EXPECT, a record, a scalar that leaked in) leaves
        // int elements at i64 via tc_int_from_expected. Detail =
        // `Array__<mangle(type(e0))>_<count>`, tag 12. An empty `[]` (count 0)
        // has no inferable element here => out-of-core.
        if en.child_count == 0 {
            let pae: i64 = tc_push_rec(recs, en.start, en.end, TC_UNHANDLED, rdefs);
            return TC_UNHANDLED;
        } else {
        }
        let mut e0code: i64 = TC_UNHANDLED;
        let mut ai: i64 = 0;
        while ai < en.child_count {
            let acid: i64 = kids.get(en.child_start + ai);
            let aec: i64 = tc_emit_expr(nodes, kids, acid, expected, binds, sigs, traits, rdefs, recs, diags);
            if ai == 0 {
                e0code = aec;
            } else {
            }
            ai = ai + 1;
        }
        let amg: str = tc_code_mangle(e0code, rdefs);
        let apfx: str = "Array__";
        let ah1: str = apfx.concat(amg);
        let ah2: str = ah1.concat("$");
        let adetail: str = ah2.concat(en.child_count.itoa());
        let par: i64 = tc_push_rec_detail(recs, en.start, en.end, TC_T_ARRAY, adetail);
        return TC_UNHANDLED;
    } else {
    }
    if en.kind == P_K_TUPLE {
        // `(e0, e1, …)` (PR-5f). Like the array literal, each element is typed
        // independently (NO expectation); detail = `$tuple<n>__<m0>_<m1>…`, tag 19.
        let tcnt: str = en.child_count.itoa();
        let tword: str = "$tuple";
        let tpfx: str = tword.concat(tcnt);
        let mut tdetail: str = tpfx.concat("__");
        let mut ti: i64 = 0;
        while ti < en.child_count {
            let tcid: i64 = kids.get(en.child_start + ti);
            let tec: i64 = tc_emit_expr(nodes, kids, tcid, TC_NO_EXPECT, binds, sigs, traits, rdefs, recs, diags);
            let tmg: str = tc_code_mangle(tec, rdefs);
            if ti == 0 {
                tdetail = tdetail.concat(tmg);
            } else {
                let twithsep: str = tdetail.concat("$");
                tdetail = twithsep.concat(tmg);
            }
            ti = ti + 1;
        }
        let ptr: i64 = tc_push_rec_detail(recs, en.start, en.end, TC_T_TUPLE, tdetail);
        return TC_UNHANDLED;
    } else {
    }
    if en.kind == P_K_INDEX {
        // `a[i]` (PR-5f). Emit the array receiver (a path to an array local emits
        // its Array detail) + the index (typed NO_EXPECT => i64); the node's own
        // type is the array's ELEMENT type. Recovered from the receiver's bind
        // detail for the common path-receiver case; otherwise out-of-core.
        let ixaid: i64 = kids.get(en.child_start);
        let ixiid: i64 = kids.get(en.child_start + 1);
        let ixac: i64 = tc_emit_expr(nodes, kids, ixaid, TC_NO_EXPECT, binds, sigs, traits, rdefs, recs, diags);
        let ixic: i64 = tc_emit_expr(nodes, kids, ixiid, TC_NO_EXPECT, binds, sigs, traits, rdefs, recs, diags);
        let ixan: PNode = nodes.get(ixaid);
        let mut elemc: i64 = TC_UNHANDLED;
        if ixan.kind == P_K_PATH {
            let ixadet: str = tc_bind_detail(binds, ixan.text);
            elemc = tc_array_elem_code(ixadet, rdefs);
        } else {
        }
        let pix: i64 = tc_push_rec(recs, en.start, en.end, elemc, rdefs);
        return elemc;
    } else {
    }
    let pu: i64 = tc_push_rec(recs, en.start, en.end, TC_UNHANDLED, rdefs);
    return TC_UNHANDLED;
}

// True iff the expression subtree is made entirely of integer literals and
// arithmetic ops over them — i.e. it carries no concrete-typed leaf of its own,
// so the oracle gives it whatever int type its context demands. A comparison is
// excluded (it yields bool, not an int).
fn tc_is_all_int_lit(nodes: Arena<PNode>, kids: Vec<i64>, id: i64) -> bool {
    let n: PNode = nodes.get(id);
    if n.kind == P_K_LIT_INT {
        return true;
    } else {
    }
    if n.kind == P_K_BINARY {
        if tc_binop_is_compare(n.value) {
            return false;
        } else {
            if n.child_count == 2 {
                let l: i64 = kids.get(n.child_start);
                let r: i64 = kids.get(n.child_start + 1);
                if tc_is_all_int_lit(nodes, kids, l) {
                    return tc_is_all_int_lit(nodes, kids, r);
                } else {
                    return false;
                }
            } else {
            }
        }
    } else {
    }
    return false;
}

// Type both operands of a binary op and return the LHS type code. `base` is the
// expectation each operand inherits (NO_EXPECT for a comparison, the outer
// expected for arithmetic). When EXACTLY ONE operand is an all-integer-literal
// subtree and the other is not, the non-literal is typed first and the literal
// subtree is then typed with the non-literal's resolved type as its expectation —
// which propagates DOWN into the subtree (a nested all-literal arithmetic op
// re-routes here with that type as `base`). This mirrors the oracle, which pins
// every `IntLit` to its concrete sibling's int type (so `v < 0` with `v: i32`
// types `0` as i32, and the `2 * 3` in `a + 1 - 2 * 3` takes a's i32). Emission
// order is irrelevant — the differential compares a sorted set.
fn tc_emit_binop_pair(nodes: Arena<PNode>, kids: Vec<i64>, lid: i64, rid: i64, base: i64, op: i64, binds: Vec<TcBind>, sigs: Vec<TcSig>, traits: Vec<TcTrait>, rdefs: Vec<TcRec>, recs: Vec<str> @Mut, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let lislit: bool = tc_is_all_int_lit(nodes, kids, lid);
    let rislit: bool = tc_is_all_int_lit(nodes, kids, rid);
    let mut lt: i64 = TC_UNHANDLED;
    let mut rt: i64 = TC_UNHANDLED;
    if lislit {
        if rislit {
            lt = tc_emit_expr(nodes, kids, lid, base, binds, sigs, traits, rdefs, recs, diags);
            rt = tc_emit_expr(nodes, kids, rid, base, binds, sigs, traits, rdefs, recs, diags);
        } else {
            rt = tc_emit_expr(nodes, kids, rid, base, binds, sigs, traits, rdefs, recs, diags);
            lt = tc_emit_expr(nodes, kids, lid, rt, binds, sigs, traits, rdefs, recs, diags);
        }
    } else {
        lt = tc_emit_expr(nodes, kids, lid, base, binds, sigs, traits, rdefs, recs, diags);
        if rislit {
            rt = tc_emit_expr(nodes, kids, rid, lt, binds, sigs, traits, rdefs, recs, diags);
        } else {
            rt = tc_emit_expr(nodes, kids, rid, base, binds, sigs, traits, rdefs, recs, diags);
        }
    }
    // T054 (arithmetic/ordering need a matching numeric type) / T055 (equality
    // needs a matching type). The literal-pinning above already aligned a
    // literal-vs-concrete pair, so only a genuine concrete-vs-concrete clash trips.
    // On error the result is TC_UNHANDLED so the mistype does not cascade into a
    // spurious return/let/assign mismatch (the oracle suppresses the cascade).
    let err: i64 = tc_check_binop(lt, rt, op, diags);
    if err == 1 {
        return TC_UNHANDLED;
    } else {
    }
    return lt;
}

// Type a call expression `f(args)`: result = callee RETURN code; each argument is
// typed with the matching PARAMETER code as its expected. A callee of the form
// `Enum::Variant` (the base is a declared enum) is instead a PAYLOAD-variant
// construction (`Opt::Some(5)`) — typed Named(enum) at the call span, with each
// payload argument typed WITHOUT expectation (the oracle does not pin a payload
// literal to the variant field type, so a `u32`-payload literal stays i64).
// Unknown callee => TC_UNHANDLED.
fn tc_emit_call(nodes: Arena<PNode>, kids: Vec<i64>, callid: i64, expected: i64, binds: Vec<TcBind>, sigs: Vec<TcSig>, traits: Vec<TcTrait>, rdefs: Vec<TcRec>, recs: Vec<str> @Mut, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let cn: PNode = nodes.get(callid);
    let cc: i64 = tc_last_colons(cn.text);
    if cc >= 0 {
        let cbase: str = cn.text.substr(0, cc);
        let ecode: i64 = tc_code_of_name(cbase, rdefs);
        if ecode >= TC_REC_BASE {
            let erec: TcRec = rdefs.get(ecode - TC_REC_BASE);
            if erec.is_enum {
                let mut ei: i64 = 0;
                while ei < cn.child_count {
                    let eargid: i64 = kids.get(cn.child_start + ei);
                    let eat: i64 = tc_emit_expr(nodes, kids, eargid, TC_NO_EXPECT, binds, sigs, traits, rdefs, recs, diags);
                    ei = ei + 1;
                }
                let pevc: i64 = tc_push_rec(recs, cn.start, cn.end, ecode, rdefs);
                return ecode;
            } else {
            }
        } else {
        }
    } else {
    }
    let sidx: i64 = tc_sig_find(sigs, cn.text);
    if sidx >= 0 {
        let sg: TcSig = sigs.get(sidx);
        let plen: i64 = sg.params.len();
        let gen_isg: bool = sg.tpbounds.len() > 0;
        // T070: the call's argument count does not match the declaration. A wrong
        // call keeps its declared return type (no cascade — the oracle still types
        // the call as the return type), so arg checks below still run. PR-G1a: the
        // oracle does NOT arity-check a GENERIC call (it zips formals with the provided
        // args, tolerating surplus/missing args), so T070 is suppressed for a generic
        // callee — a too-few-args generic instead surfaces an uninferrable type-param as
        // T150 (the inference loop below).
        if gen_isg {
        } else {
            if cn.child_count == plen {
            } else {
                let dar70: i64 = tc_push_diag_with_span(diags, "T070", cn.start, cn.end);
            }
        }
        // Collect each arg's type + int-literal flag (PR-6b reads them after the loop
        // to check each TYPE-PARAM's bounds ONCE).
        let mut argtypes: Vec<i64> = Vec::new();
        let mut arglits: Vec<bool> = Vec::new();
        let mut ai: i64 = 0;
        while ai < cn.child_count {
            let argid: i64 = kids.get(cn.child_start + ai);
            let mut argexp: i64 = TC_NO_EXPECT;
            if ai < plen {
                argexp = sg.params.get(ai);
            } else {
            }
            let at: i64 = tc_emit_expr(nodes, kids, argid, argexp, binds, sigs, traits, rdefs, recs, diags);
            let aolit: bool = tc_is_all_int_lit(nodes, kids, argid);
            let qat: i64 = argtypes.push(at);
            let qal: i64 = arglits.push(aolit);
            // T071: an in-range argument whose type is not assignable to its
            // parameter (a bare literal pins to the param type, like a `let`).
            if ai < plen {
                // PR-5j: composite param (e.g. `&P`) vs a non-composite arg (`g(5)`)
                // emits T071 (XOR). The arg's record is last right now (ET-J3), so
                // its detail is recoverable here, before the next iteration.
                let argdet: str = tc_last_rec_detail(recs);
                let pdet: str = sg.param_details.get(ai);
                let dcc71: i64 = tc_check_composite(pdet, argexp, argdet, at, "T071", diags);
                let dac71: i64 = tc_check_assign(argexp, at, aolit, "T071", diags);
            } else {
            }
            ai = ai + 1;
        }
        // PR-6b: check each TYPE-PARAM's bounds ONCE — the oracle's check_bounds zips
        // type-params with their single inferred concrete arg, so a type-param bound by
        // TWO params (`pair<T: Hash>(a: T, b: T)`) yields ONE diagnostic, not two. Use
        // the FIRST param that bare-IS the type-param (positional inference; a
        // conflicting second occurrence is the arg-type machinery's concern — AG-TR11).
        // A bare int-literal arg (arglits) is unpinned IntLit → never satisfies (ET-TR18).
        let tpc: i64 = sg.tpbounds.len();
        let mut tj: i64 = 0;
        while tj < tpc {
            let blist: str = sg.tpbounds.get(tj);
            let bln: i64 = blist.len();
            if bln == 0 {
            } else {
                let mut found: i64 = 0 - 1;
                let mut pj: i64 = 0;
                while pj < plen {
                    let mt: i64 = sg.parmtp.get(pj);
                    if mt == tj {
                        let na: i64 = argtypes.len();
                        if pj < na {
                            found = pj;
                            pj = plen;
                        } else {
                            pj = pj + 1;
                        }
                    } else {
                        pj = pj + 1;
                    }
                }
                if found >= 0 {
                    let cat: i64 = argtypes.get(found);
                    let cal: bool = arglits.get(found);
                    let dcb: i64 = tc_check_bounds_arg(cat, cal, blist, traits, sigs, rdefs, diags);
                } else {
                }
            }
            tj = tj + 1;
        }
        // PR-G1a (ET-G3b): infer each type-param of a generic callee from the call, and
        // emit T150 for any uninferrable one (per-param, matching the oracle). A type-param
        // tj is INFERRABLE iff some PROVIDED arg whose param bare-IS tj exists (a bound arg
        // — concrete or int-literal — binds it), OR tj is the RETURN type-param and the
        // call has a concrete EXPECTED type (a let-annotation / return-position context:
        // the "first-arg-ELSE-expected" rule). A type-param reachable only through a
        // composite param (`x: Ref<T>` — parmtp == -1) or omitted by a too-few-args call
        // is therefore uninferrable → T150 (nested inference is OUT — AG-G6). A bare-int-
        // literal-only binding in a non-let context is AG-G12 (out of v1).
        let gtpc: i64 = sg.tpbounds.len();
        let mut gtj: i64 = 0;
        while gtj < gtpc {
            let mut gprov: bool = false;
            let mut gpj0: i64 = 0;
            while gpj0 < plen {
                let gmt0: i64 = sg.parmtp.get(gpj0);
                if gmt0 == gtj {
                    let gna0: i64 = argtypes.len();
                    if gpj0 < gna0 {
                        gprov = true;
                    } else {
                    }
                } else {
                }
                gpj0 = gpj0 + 1;
            }
            let mut ginfer: bool = gprov;
            if gtj == sg.rettp {
                if tc_is_concrete(expected) {
                    ginfer = true;
                } else {
                }
            } else {
            }
            if ginfer {
            } else {
                let dgi150: i64 = tc_push_diag(diags, "T150");
            }
            gtj = gtj + 1;
        }
        // PR-G1a: a generic free fn whose RETURN bare-IS a type-param (`fn id<T>(x: T) -> T`,
        // sg.rettp >= 0) SUBSTITUTES its call-node record. Source order (ET-G3b): the FIRST
        // concrete (non-literal) arg that binds the return type-param, ELSE the expected type
        // (a let annotation / return-position context), ELSE i64 for a literal-only binding
        // (AG-G12: a non-i64-annotated bare-literal binding is out of v1), ELSE TC_UNHANDLED
        // (the T150 case above). Concrete / composite-generic returns keep rettp == -1 and
        // fall through to the unchanged paths below (so every non-generic call is byte-for-
        // byte unchanged).
        if sg.rettp >= 0 {
            let mut grcbind: i64 = TC_NO_EXPECT;
            let mut grfound: bool = false;
            let mut grprov: bool = false;
            let mut grpj: i64 = 0;
            while grpj < plen {
                let grmt: i64 = sg.parmtp.get(grpj);
                if grmt == sg.rettp {
                    let grna: i64 = argtypes.len();
                    if grpj < grna {
                        grprov = true;
                        let grlit: bool = arglits.get(grpj);
                        if grlit {
                        } else {
                            if grfound {
                            } else {
                                grcbind = argtypes.get(grpj);
                                grfound = true;
                            }
                        }
                    } else {
                    }
                } else {
                }
                grpj = grpj + 1;
            }
            let mut grsub: i64 = TC_UNHANDLED;
            if grfound {
                grsub = grcbind;
            } else {
                if tc_is_concrete(expected) {
                    grsub = expected;
                } else {
                    if grprov {
                        grsub = TC_T_I64;
                    } else {
                    }
                }
            }
            let pgr: i64 = tc_push_rec(recs, cn.start, cn.end, grsub, rdefs);
            return grsub;
        } else {
        }
        // PR-5j: a composite-returning call emits the composite call-node record so
        // the value's type flows (the 5i return/let check + later refs recover it via
        // tc_last_rec_detail). ET-J5: the RETURNED code is TC_UNHANDLED — NOT `sg.ret`,
        // which for a composite is TC_T_UNIT (tc_fn_ret_tag yields UNIT for non-plain
        // types) and would cascade as a concrete UNIT into the scalar checks. Only the
        // emitted record carries the composite detail.
        if sg.ret_detail.len() > 0 {
            let pcd: i64 = tc_push_rec_detail(recs, cn.start, cn.end, tc_detail_tag(sg.ret_detail), sg.ret_detail);
            return TC_UNHANDLED;
        } else {
            let pcall: i64 = tc_push_rec(recs, cn.start, cn.end, sg.ret, rdefs);
            return sg.ret;
        }
    } else {
    }
    // An UNqualified enum-variant construction (`A(5)`): a bare name that is not a
    // function but IS a variant of a declared enum — typed Named(enum), args typed
    // without expectation (like the qualified form). The oracle accepts this.
    if cc < 0 {
        let mut evcode: i64 = tc_enum_of_variant(rdefs, cn.text);
        // PR-G2b-iii: prefer the EXPECTED enum (a let/param annotation) when it has this
        // variant — a bare `Some(5)` under `let v: B = …` constructs B (not the first enum
        // with `Some`, which would mis-type the value and cascade T046); and that annotation
        // DISAMBIGUATES the variant (no T236).
        let mut disambig: bool = false;
        if expected >= TC_REC_BASE {
            let exr: TcRec = rdefs.get(expected - TC_REC_BASE);
            if exr.is_enum {
                let exvk: i64 = tc_variant_index(rdefs, expected - TC_REC_BASE, cn.text);
                if exvk >= 0 {
                    evcode = expected;
                    disambig = true;
                } else {
                }
            } else {
            }
        } else {
        }
        if evcode >= 0 {
            // PR-G2b-iii (Gap D, ET-G14): a BARE variant whose name lives in ≥2 enums is
            // AMBIGUOUS → T236, UNLESS the expected annotation resolved it (disambig). A
            // qualified `E::V` (cc>=0) never reaches here. Single-module, kind-disjoint (AG-G18).
            let ecount: i64 = tc_count_enums_with_variant(rdefs, cn.text);
            if ecount >= 2 {
                if disambig {
                } else {
                    let d236: i64 = tc_push_diag_with_span(diags, "T236", cn.start, cn.end);
                }
            } else {
            }
            let mut uvi: i64 = 0;
            while uvi < cn.child_count {
                let uvargid: i64 = kids.get(cn.child_start + uvi);
                let uvat: i64 = tc_emit_expr(nodes, kids, uvargid, TC_NO_EXPECT, binds, sigs, traits, rdefs, recs, diags);
                uvi = uvi + 1;
            }
            let puv: i64 = tc_push_rec(recs, cn.start, cn.end, evcode, rdefs);
            return evcode;
        } else {
        }
    } else {
    }
    // T062: a bare-name call to something that is neither a declared function nor a
    // variant. A dotted callee (`cc >= 0`) is an enum-variant construction (handled
    // above) or out of core, so only the plain-name case raises T062.
    if cc < 0 {
        let dfn62: i64 = tc_push_diag_with_span(diags, "T062", cn.start, cn.end);
    } else {
    }
    let pu: i64 = tc_push_rec(recs, cn.start, cn.end, TC_UNHANDLED, rdefs);
    return TC_UNHANDLED;
}

// Type a record construction `Name { f: v, … }`. The node text is
// "Name;f1;f2;…"; each value child (source order) is typed with that field's
// declared type as its expected — so a field-init literal pins to the field's
// type (`y: 2` in a `y: u32` field types `2` as u32, like a `let` annotation).
// The construction itself emits one record (its span) typed Named(record). An
// unknown record name => TC_UNHANDLED (children still typed, no expectation, so
// their records are never silently dropped).
fn tc_emit_construct(nodes: Arena<PNode>, kids: Vec<i64>, ctorid: i64, ctor_targs: str, binds: Vec<TcBind>, sigs: Vec<TcSig>, traits: Vec<TcTrait>, rdefs: Vec<TcRec>, recs: Vec<str> @Mut, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let cn: PNode = nodes.get(ctorid);
    let recname: str = tc_seg_at(cn.text, 0);
    let rcode: i64 = tc_code_of_name(recname, rdefs);
    if rcode >= TC_REC_BASE {
        let ridx: i64 = rcode - TC_REC_BASE;
        let mut fi: i64 = 0;
        while fi < cn.child_count {
            let fvid: i64 = kids.get(cn.child_start + fi);
            let fname: str = tc_seg_at(cn.text, fi + 1);
            let mut fexp: i64 = tc_find_field(rdefs, ridx, fname);
            // PR-G2a: a field that bare-IS a type-param (`v: T`) is PINNED to its
            // SUBSTITUTED concrete slot when the construct has known type-args (from a
            // generic-record annotation, `ctor_targs`) — so `Box<u32> = Box { v: 5 }` types
            // the init `5` as u32 (the construct-WRITE twin of the field-access READ
            // substitution). A concrete field (fparmtp == -1) or a construct without
            // type-args keeps the declared slot (prior behavior, unchanged). The construct-
            // time field-init type CHECK (T071 on `Box<str> = Box { v: 5 }`) needs the
            // inference-vs-annotation conflict count and is deferred to PR-G2a-ii.
            let cfptp: i64 = tc_field_parmtp(rdefs, ridx, fname);
            let mut do_t071: bool = false;
            if cfptp >= 0 {
                if ctor_targs.len() > 0 {
                    fexp = tc_atoi(tc_seg_at(ctor_targs, cfptp));
                    do_t071 = true;
                } else {
                }
            } else {
            }
            let ft: i64 = tc_emit_expr(nodes, kids, fvid, fexp, binds, sigs, traits, rdefs, recs, diags);
            // PR-G2a-iii: construct-time field-init type CHECK against the substituted slot.
            // (b) the standard assignment check, plus (a) an EXTRA T071 when a bare int
            // literal lands in a NON-int slot (the oracle's "out-of-range integer literal"
            // check). So `Box<str> = Box { v: 5 }` emits TWO T071 (the int-lit-into-str AND
            // the i64-vs-str mismatch) at the oracle's count, while `Box<i64> = Box { v: "x" }`
            // emits one and `Box<u32> = Box { v: 5 }` stays clean.
            if do_t071 {
                let flit: bool = tc_is_all_int_lit(nodes, kids, fvid);
                let dcb: i64 = tc_check_assign(fexp, ft, flit, "T071", diags);
                if flit {
                    if tc_is_int_type(fexp) {
                    } else {
                        let dca: i64 = tc_push_diag(diags, "T071");
                    }
                } else {
                }
            } else {
            }
            fi = fi + 1;
        }
        let pc: i64 = tc_push_rec(recs, cn.start, cn.end, rcode, rdefs);
        return rcode;
    } else {
    }
    let mut fj: i64 = 0;
    while fj < cn.child_count {
        let fvid2: i64 = kids.get(cn.child_start + fj);
        let ft2: i64 = tc_emit_expr(nodes, kids, fvid2, TC_NO_EXPECT, binds, sigs, traits, rdefs, recs, diags);
        fj = fj + 1;
    }
    let pu: i64 = tc_push_rec(recs, cn.start, cn.end, TC_UNHANDLED, rdefs);
    return TC_UNHANDLED;
}

// Type a method-form node `Recv::seg(args)` (P_K_METHOD: text = last segment,
// child[0] = the receiver Path, child[1..] = args). When the receiver path names
// a declared ENUM, this is a PAYLOAD-variant construction (`Opt::Some(5)`) — typed
// Named(enum) at the node span, with each arg typed WITHOUT expectation (the
// receiver child emits NO record, mirroring the oracle's payload-only
// EnumConstruct). Any real method call is out-of-core => TC_UNHANDLED.
fn tc_emit_method(nodes: Arena<PNode>, kids: Vec<i64>, mid: i64, binds: Vec<TcBind>, sigs: Vec<TcSig>, traits: Vec<TcTrait>, rdefs: Vec<TcRec>, recs: Vec<str> @Mut, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let mn: PNode = nodes.get(mid);
    if mn.child_count >= 1 {
        let recvid: i64 = kids.get(mn.child_start);
        let recvn: PNode = nodes.get(recvid);
        if recvn.kind == P_K_PATH {
            let ecode: i64 = tc_code_of_name(recvn.text, rdefs);
            if ecode >= TC_REC_BASE {
                let erec: TcRec = rdefs.get(ecode - TC_REC_BASE);
                if erec.is_enum {
                    let mut ai: i64 = 1;
                    while ai < mn.child_count {
                        let argid: i64 = kids.get(mn.child_start + ai);
                        let at: i64 = tc_emit_expr(nodes, kids, argid, TC_NO_EXPECT, binds, sigs, traits, rdefs, recs, diags);
                        ai = ai + 1;
                    }
                    let pm: i64 = tc_push_rec(recs, mn.start, mn.end, ecode, rdefs);
                    return ecode;
                } else {
                }
            } else {
                // PR-G3a: a METHOD CALL `recv.method(args)` where the receiver path is a LOCAL
                // bound to a record. Look up the impl-method sig "RecordName::method" (seeded by
                // tc_build_sigs), emit the receiver's Named-record record at the receiver span
                // (the oracle's full-path-span quirk), type each arg, and type the call node as
                // the method's RETURN. The method body itself is the impl-walk's concern. An
                // unknown method falls through to TC_UNHANDLED (out of core).
                let rbase: i64 = tc_bind_lookup(binds, recvn.text);
                if rbase >= TC_REC_BASE {
                    let rrec: TcRec = rdefs.get(rbase - TC_REC_BASE);
                    let mkpre: str = rrec.name.concat("::");
                    let mkey: str = mkpre.concat(mn.text);
                    let msidx: i64 = tc_sig_find(sigs, mkey);
                    if msidx >= 0 {
                        let msg: TcSig = sigs.get(msidx);
                        // PR-G3b: a generic-impl method returning a bare type-param (`-> T`)
                        // has msg.rettp >= 0 and msg.ret == TC_UNHANDLED (the param name does
                        // not resolve to a tag). Substitute the call's result from the
                        // RECEIVER's type-args, indexed by the method-return type-param
                        // position (the impl-position, which aligns with the record's slot —
                        // ET-G3b at the method level). A concrete-return method (rettp < 0)
                        // keeps msg.ret. An empty/missing receiver targ leaves it unhandled.
                        let mut mret2: i64 = msg.ret;
                        if msg.rettp >= 0 {
                            let btargs: str = tc_bind_targs(binds, recvn.text);
                            let bseg: str = tc_seg_at(btargs, msg.rettp);
                            if bseg.len() > 0 {
                                mret2 = tc_atoi(bseg);
                            } else {
                            }
                        } else {
                        }
                        let prr: i64 = tc_push_rec(recs, recvn.start, recvn.end, rbase, rdefs);
                        // PR-G3a: each call arg pins to the matching method PARAM and is
                        // checked (T071), exactly like a free call. The sig's param 0 is the
                        // receiver `self`, so the call arg at child index `mai` (child 0 is the
                        // receiver path) maps to `params[mai]`. A bare int-literal pins to the
                        // param type; a non-assignable arg → T071 (per-slot, matching the
                        // oracle's count).
                        let mplen: i64 = msg.params.len();
                        let mut mai: i64 = 1;
                        while mai < mn.child_count {
                            let margid: i64 = kids.get(mn.child_start + mai);
                            let mut margexp: i64 = TC_NO_EXPECT;
                            if mai < mplen {
                                margexp = msg.params.get(mai);
                                // PR-G3b: a type-param method param (`x: T`) substitutes its
                                // expected type from the receiver's targs at this position, so a
                                // mismatched int-literal arg is rejected against the CONCRETE type
                                // (mirrors the oracle's apply_subst over method params).
                                let mptp: i64 = msg.parmtp.get(mai);
                                if mptp >= 0 {
                                    let btp: str = tc_bind_targs(binds, recvn.text);
                                    let pseg: str = tc_seg_at(btp, mptp);
                                    if pseg.len() > 0 {
                                        margexp = tc_atoi(pseg);
                                    } else {
                                    }
                                } else {
                                }
                            } else {
                            }
                            let mat: i64 = tc_emit_expr(nodes, kids, margid, margexp, binds, sigs, traits, rdefs, recs, diags);
                            if mai < mplen {
                                // PR-G3b: the method-arg T071 check, two complementary arms that
                                // together mirror the oracle's `infer_method_call_expr`:
                                //   (1) a surviving int-literal whose default (i64) does not match
                                //       the (substituted) concrete param type — gated on `malit`,
                                //       preserving the IntLit→machine-int flex (a fitting literal
                                //       pins and is silent).
                                //   (2) a NON-int-literal arg of an incompatible concrete type
                                //       (str/bool/record/other width) passed where a MACHINE INT
                                //       (i32/u32/i64/u64) is expected. This direction was a
                                //       pre-existing soundness hole: the oracle's method-arg check
                                //       was int-literal-only, so `b.add(true)`/`b.add("no")` typed
                                //       CLEAN and then produced INVALID wasm at instantiation. Both
                                //       compilers now reject it at the machine-int param position
                                //       (the strict free-call path always did). Scoped to machine-int
                                //       params (composite/str/bool param directions unchanged) and to
                                //       a concrete, non-generic arg — so the malit and generic-arg
                                //       cases never double-fire.
                                let malit: bool = tc_is_all_int_lit(nodes, kids, margid);
                                if malit {
                                    let dca: i64 = tc_check_assign(margexp, mat, malit, "T071", diags);
                                } else {
                                    if tc_is_int_type(margexp) {
                                        if mat == TC_T_GENERIC {
                                        } else {
                                            let dcm: i64 = tc_check_assign(margexp, mat, malit, "T071", diags);
                                        }
                                    } else {
                                    }
                                }
                            } else {
                            }
                            mai = mai + 1;
                        }
                        let pmc: i64 = tc_push_rec(recs, mn.start, mn.end, mret2, rdefs);
                        return mret2;
                    } else {
                    }
                } else {
                }
            }
        } else {
        }
    } else {
    }
    let pu: i64 = tc_push_rec(recs, mn.start, mn.end, TC_UNHANDLED, rdefs);
    return TC_UNHANDLED;
}

// The expected-type code from a `let` annotation node (a plain K_TYPE): the
// scalar tag or record code, or TC_NO_EXPECT when the type is non-plain.
fn tc_annot_tag(nodes: Arena<PNode>, typeid: i64, rdefs: Vec<TcRec>) -> i64 {
    let tn: PNode = nodes.get(typeid);
    if tn.kind == P_K_TYPE {
        if tn.flags == 0 {
            if tn.child_count == 0 {
                return tc_code_of_name(tn.text, rdefs);
            } else {
            }
        } else {
        }
    } else {
    }
    return TC_NO_EXPECT;
}

// Walk a block's statements, threading the symbol table `binds`. Handles
// `return <expr>`, `let [: T] = <expr>`, expression statements, simple
// assignments (place + value; the RHS is pinned to a SCALAR place's type so an
// int literal narrows to it, mirroring the oracle's check_assign), and the
// control-flow statements
// `if`/`while` — recursing into each branch/body block (SIGIL `if` always carries
// an else block, synthesised empty when absent). `break`/`continue` carry no
// expression. The symbol table is flat + append-only (no generic Vec truncate),
// so a type-changing shadow inside a branch can leak past the branch — the
// monomorphic corpus avoids that and the resolution-parity vetting catches it.
fn tc_emit_block_exprs(nodes: Arena<PNode>, kids: Vec<i64>, blockid: i64, binds: Vec<TcBind> @Mut, sigs: Vec<TcSig>, traits: Vec<TcTrait>, rdefs: Vec<TcRec>, recs: Vec<str> @Mut, fnret: i64, fnret_detail: str, diags: Vec<str> @Mut, cdefs: Vec<TcCap>) -> i64 ! { Alloc } {
    let bn: PNode = nodes.get(blockid);
    // PR-5d: returns 1 iff this block is GUARANTEED to return on every path (a
    // `return`, an `if` whose both branches return, or an exhaustive `match` whose
    // arms all return). `while` never guarantees. Drives the T044 check.
    let mut guaranteed: i64 = 0;
    let mut i: i64 = 0;
    while i < bn.child_count {
        let sid: i64 = kids.get(bn.child_start + i);
        let sn: PNode = nodes.get(sid);
        if sn.kind == P_K_RETURN {
            guaranteed = 1;
            if sn.child_count == 1 {
                let vid: i64 = kids.get(sn.child_start);
                // PR-G1a: a return-position generic CALL takes the declared return type as
                // its expected, so a return-only type-param (`return make()`) binds from the
                // fn return (ET-G3b).
                // Narrow-int parity: a SCALAR return type also PINS the value, mirroring the
                // oracle's check_return, which resolves the returned expression's int literals
                // to the return type (`fn f() -> u32 { return 5; }` types `5` as u32, not i64
                // — a binary `return 0 - 5` to an i32 return narrows its operands too, the
                // type-level twin of the wasm fix). tc_int_from_expected narrows only the four
                // machine ints, so a non-int scalar return is a harmless no-op; an ARRAY
                // return pins via the P_K_ARRAY mirror below; a record/composite return stays
                // TC_NO_EXPECT (its int fields resolve via their own paths).
                let mut rvexp: i64 = TC_NO_EXPECT;
                let rvn: PNode = nodes.get(vid);
                if rvn.kind == P_K_CALL {
                    rvexp = fnret;
                } else {
                }
                // Array-stride fix mirror (return position, #330): an array-LITERAL return
                // value resolves its int-literal elements to the `[T;N]` return type's
                // element T (so the emitted Array detail + element records are T, like the
                // Rust oracle). `fnret_detail` is the return type's mangle (`Array__u32_3`);
                // a non-array / non-int element yields TC_UNHANDLED => rvexp stays NO_EXPECT.
                // The let-handler twin lives at the `let` P_K_ARRAY branch.
                if rvn.kind == P_K_ARRAY {
                    let rvelem: i64 = tc_array_elem_code(fnret_detail, rdefs);
                    if tc_is_int_type(rvelem) {
                        rvexp = rvelem;
                    } else {
                    }
                } else {
                }
                // Narrow-int parity (scalar return): a SCALAR return type pins the value so
                // an int literal narrows to it. Guarded on rvexp still NO_EXPECT so the
                // P_K_CALL / P_K_ARRAY pins above WIN: a COMPOSITE return's `fnret` is the
                // i64 default (its real type rides `fnret_detail`), so `tc_is_scalar(fnret)`
                // is true for it too — pinning that here would clobber the array mirror's
                // element type and de-resolve the elements (Array__u32_3 -> Array__i64_3).
                if rvexp == TC_NO_EXPECT {
                    if tc_is_scalar(fnret) {
                        rvexp = fnret;
                    } else {
                    }
                } else {
                }
                let vt: i64 = tc_emit_expr(nodes, kids, vid, rvexp, binds, sigs, traits, rdefs, recs, diags);
                // T049: the returned value must be assignable to the declared
                // return type (a bare int literal flexes to a machine int).
                // PR-5i: the composite check (XOR) covers a composite value returned
                // where a scalar is declared (or vice-versa); the scalar check covers
                // the rest. The two emission paths are disjoint (never double-fire).
                let rfound: str = tc_last_rec_detail(recs);
                let dcr: i64 = tc_check_composite(fnret_detail, fnret, rfound, vt, "T049", diags);
                let vlit: bool = tc_is_all_int_lit(nodes, kids, vid);
                // B-COMPOSE (the MONO-8 relaxation, return-path twin): a monomorphized-
                // INSTANCE return annotation (`-> Vec__i64`, mn's annotation rewrite) accepts
                // a BASE-named record value (`return Vec {...}`) — the value is the generic
                // origin of the instance. INERT for normal programs (`base__…` instance
                // annotations exist only post-mn_expand).
                let mut skip49: bool = false;
                if fnret >= TC_REC_BASE {
                    if vt >= TC_REC_BASE {
                        let erec49: TcRec = rdefs.get(fnret - TC_REC_BASE);
                        let vrec49: TcRec = rdefs.get(vt - TC_REC_BASE);
                        let vpfx49: str = vrec49.name.concat("__");
                        if tc_str_starts(erec49.name, vpfx49) {
                            skip49 = true;
                        } else {
                        }
                    } else {
                    }
                } else {
                }
                if skip49 {
                } else {
                    let dret: i64 = tc_check_assign(fnret, vt, vlit, "T049", diags);
                }
            } else {
            }
        } else {
        }
        if sn.kind == P_K_LET {
            if sn.child_count == 2 {
                let aid: i64 = kids.get(sn.child_start);
                let lvid: i64 = kids.get(sn.child_start + 1);
                let exp: i64 = tc_annot_tag(nodes, aid, rdefs);
                // PR-G2a: a GENERIC-RECORD annotation (`let b: Box<i64> = …`) — a plain
                // K_TYPE whose name is a declared record AND that carries type-arg children
                // — yields the concrete type-args, used to (a) pin/check the construct's
                // type-param field-inits and (b) record on the binding so `b.field`
                // substitutes the field's type-param. (Non-generic / composite annotations
                // keep targs "".)
                let mut ltargs: str = "";
                // PR-G4: the generic-record annotation's RECORD code (or -1). The
                // annotation is authoritative for the local's type — so a local whose
                // VALUE is out-of-core (e.g. a nested-generic-return call `mk(5)` typed
                // TC_UNHANDLED, AG-G6) still binds as `Box` with concrete targs, and a
                // downstream `b.field` resolves instead of cascading a stray T060.
                let mut lrec: i64 = 0 - 1;
                // PR-G4: is the annotation a GENERIC-NAMED type (`Box<i64>`, `Opt<i64>` — a
                // plain K_TYPE with type-arg children)? If so, `tc_annot_tag` returns
                // TC_NO_EXPECT (its scalar/record fast-path requires zero children), which
                // would otherwise leave the value UNCHECKED against the annotation. lgen_base
                // is the resolved record/enum code, or TC_UNHANDLED for an unknown name.
                let mut lgen_named: bool = false;
                let mut lgen_base: i64 = TC_UNHANDLED;
                let an: PNode = nodes.get(aid);
                if an.kind == P_K_TYPE {
                    if an.flags == 0 {
                        if an.child_count > 0 {
                            lgen_named = true;
                            let acode: i64 = tc_code_of_name(an.text, rdefs);
                            lgen_base = acode;
                            if acode >= TC_REC_BASE {
                                ltargs = tc_typearg_codes(nodes, kids, aid, rdefs);
                                lrec = acode;
                            } else {
                            }
                        } else {
                        }
                    } else {
                    }
                } else {
                }
                // Type the value. A generic-record CONSTRUCT is typed WITH the annotation's
                // type-args so each type-param field-init pins/checks against its substituted
                // slot (the construct-WRITE twin of the field-access READ substitution).
                let lvn: PNode = nodes.get(lvid);
                let mut lt: i64 = TC_UNHANDLED;
                if lvn.kind == P_K_RECORD_CONSTRUCT {
                    lt = tc_emit_construct(nodes, kids, lvid, ltargs, binds, sigs, traits, rdefs, recs, diags);
                } else {
                    // PR-G2b-iii (Gap D): a generic-ENUM annotation (`let v: A<i64> = …`) yields
                    // exp = TC_NO_EXPECT (the type-arg-bearing annotation is invisible to
                    // tc_annot_tag), which would let a bare-variant construct fire a spurious
                    // T236 (the annotation cannot disambiguate). Pass the annotation's ENUM code
                    // as the expected so tc_emit_call's T236 check resolves it. Restricted to
                    // enum annotations — record-annotation value typing (Box<i64> = mk()) is
                    // unchanged (AG-G19 / ET-G15 boundary preserved).
                    let mut vexp: i64 = exp;
                    if lgen_base >= TC_REC_BASE {
                        let lgbr: TcRec = rdefs.get(lgen_base - TC_REC_BASE);
                        if lgbr.is_enum {
                            vexp = lgen_base;
                        } else {
                        }
                    } else {
                    }
                    // Array-stride fix mirror: an array-literal value resolves its
                    // int-literal elements to the annotation's element type T ONLY
                    // when the annotation is a `[T;N]` array with an int element
                    // (so the emitted Array detail + element records are T, like
                    // the Rust oracle's resolve_int_literals_in_expr). Any OTHER
                    // annotation — scalar (`let x: i32 = [1,2,3]`, an error) or
                    // record — must NOT leak into the elements: the Rust resolver
                    // only fires when the target is an Array/Slice, so an array
                    // value under a non-array annotation is typed NO_EXPECT (its
                    // elements stay i64, matching the oracle). Returns/args/assigns
                    // never reach here (they pass their own vexp), so this mirrors
                    // the let-only scope of the Rust fix exactly.
                    if lvn.kind == P_K_ARRAY {
                        vexp = TC_NO_EXPECT;
                        if tc_is_composite_typenode(nodes, aid) {
                            let avmg: str = tc_tmangle(nodes, kids, aid, rdefs, TC_TYPE_DEPTH_CEILING);
                            let avelem: i64 = tc_array_elem_code(avmg, rdefs);
                            if tc_is_int_type(avelem) {
                                vexp = avelem;
                            } else {
                            }
                        } else {
                        }
                    } else {
                    }
                    lt = tc_emit_expr(nodes, kids, lvid, vexp, binds, sigs, traits, rdefs, recs, diags);
                }
                // PR-5f: a composite-ANNOTATED local (`let a: [i64;3] = …`) carries
                // its annotation's mangle so references + indexing recover it. (An
                // un-annotated composite let is a deferred follow-on.)
                let mut ldetail: str = "";
                if tc_is_composite_typenode(nodes, aid) {
                    ldetail = tc_tmangle(nodes, kids, aid, rdefs, TC_TYPE_DEPTH_CEILING);
                } else {
                }
                // PR-C1: a cap-typed let (`let c2: Fuel = …`) carries the bare cap name as
                // its detail (the bind's tag is set to TC_T_CAP below), so a later reference
                // to c2 emits `tag 10, <cap name>` via the var-ref intercept; and the cap
                // annotation is a VALID non-scalar type (suppresses the T046 that the
                // unknown-plain-name path would otherwise fire).
                let cap_let: str = tc_cap_name_of_typenode(nodes, aid, rdefs, cdefs);
                if cap_let.len() > 0 {
                    ldetail = cap_let;
                } else {
                }
                // PR-G1a: a SCALAR-annotated binding takes its DECLARED type, not the
                // value's — so `let x: i64 = <u32 value>` binds x to i64 (the oracle reports
                // the T041 mismatch but still types x as its annotation), and a later
                // `return x` does NOT cascade a spurious T049. A non-scalar annotation keeps
                // the value type (records/composites resolve through their own detail).
                let mut lbind: i64 = lt;
                if tc_is_scalar(exp) {
                    lbind = exp;
                } else {
                }
                // SELF-2: a PLAIN known record/enum annotation is ALSO authoritative (like a
                // scalar above / the generic-record case below) — `let t: Token = toks.get(0)`
                // binds t as Token even when the value is OUT-OF-CORE (Vec.get -> TC_UNHANDLED),
                // so a later `t.kind` resolves the field instead of false-firing T060 on an
                // out-of-core receiver. exp = tc_annot_tag is the record/enum code (>= TC_REC_BASE)
                // for a KNOWN nominal; a CROSS-MODULE annotation (PNode unknown to the isolated
                // module) has exp = TC_UNHANDLED, so it correctly stays out-of-core (that T060 is a
                // composition artifact, correct isolated behavior). lrec/cap still override below.
                if exp >= TC_REC_BASE {
                    lbind = exp;
                } else {
                }
                // PR-G4: a generic-record annotation pins the binding to its record code
                // regardless of the value's type (the annotation is authoritative).
                if lrec >= TC_REC_BASE {
                    lbind = lrec;
                } else {
                }
                // PR-C1: a cap-typed let binds with tag TC_T_CAP so its var-ref intercept fires.
                if cap_let.len() > 0 {
                    lbind = TC_T_CAP;
                } else {
                }
                let nb: i64 = binds.push(TcBind { name: sn.text, tag: lbind, detail: ldetail, targs: ltargs });
                // PR-5i: composite-vs-scalar let mismatch (XOR) — `let x: bool = (1,2)`
                // or `let a: [i64;3] = 0`. The annotation detail vs the value's detail;
                // composite-vs-composite (arity/element) is deferred (AG-V1).
                let lfound: str = tc_last_rec_detail(recs);
                let dcl: i64 = tc_check_composite(ldetail, exp, lfound, lt, "T041", diags);
                // T041: a SCALAR-annotated binding whose initializer is not
                // assignable to it. (A non-scalar annotation is T046 — a later
                // slice — so it is skipped here, not mis-flagged as T041.)
                if tc_is_scalar(exp) {
                    let llit: bool = tc_is_all_int_lit(nodes, kids, lvid);
                    let dlet: i64 = tc_check_assign(exp, lt, llit, "T041", diags);
                } else {
                    // T046: a non-scalar let annotation. An UNKNOWN plain type name
                    // is always T046; a known record/enum annotation is T046 only
                    // when the initializer's concrete type does not match it
                    // exactly (a non-plain generic annotation, TC_NO_EXPECT, is OK).
                    if exp == TC_UNHANDLED {
                        // PR-C1: a cap annotation is a VALID non-scalar type — no T046.
                        if cap_let.len() > 0 {
                        } else {
                            let da46: i64 = tc_push_diag(diags, "T046");
                        }
                    } else {
                        if exp >= TC_REC_BASE {
                            if tc_is_concrete(lt) {
                                if lt == exp {
                                } else {
                                    // MONO-8: a monomorphized-INSTANCE annotation (`Box__i64`)
                                    // accepts a BASE-named record value (`Box{...}`) — the value
                                    // is the generic origin of the instance. mn_expand rewrites
                                    // the let annotation to the instance leaf but leaves the
                                    // construct at the base (byte-neutral in the W-lane), so the
                                    // tc gate must not false-T046 that pairing. INERT for normal
                                    // programs — `base__…`-named instance annotations exist ONLY
                                    // post-mn_expand.
                                    let mut skip46: bool = false;
                                    if lt >= TC_REC_BASE {
                                        let erec46: TcRec = rdefs.get(exp - TC_REC_BASE);
                                        let vrec46: TcRec = rdefs.get(lt - TC_REC_BASE);
                                        let vpfx46: str = vrec46.name.concat("__");
                                        if tc_str_starts(erec46.name, vpfx46) {
                                            skip46 = true;
                                        } else {
                                        }
                                    } else {
                                    }
                                    if skip46 {
                                    } else {
                                        let db46: i64 = tc_push_diag(diags, "T046");
                                    }
                                }
                            } else {
                            }
                        } else {
                        }
                    }
                }
                // PR-G4: a GENERIC-NAMED annotation (`Box<i64>`, `Opt<i64>`) is invisible to
                // tc_annot_tag (exp == TC_NO_EXPECT), so the dispatch above never checks the
                // value against it — a pre-existing false-ACCEPT. Mirror the oracle's
                // resolve_annotated_let_type + type_compatible: an UNKNOWN base name is T046;
                // a value that is not the SAME Named (or the same Named at DIFFERENT type-args,
                // for a copied local) is T041. A construct conforms by construction (its slots
                // are pinned to ltargs + self-checked → T071), so only a PATH value's targs are
                // compared. A nested-construct field mismatch is AG-G6 (inner slots are not
                // re-substituted), so the value's OWN top type is what is checked here.
                if lgen_named {
                    if lgen_base >= TC_REC_BASE {
                        if lt == lgen_base {
                            if lvn.kind == P_K_PATH {
                                let lvtargs: str = tc_bind_targs(binds, lvn.text);
                                if lvtargs.len() > 0 {
                                    let lvmatch: bool = lvtargs.bytes_eq(ltargs);
                                    if lvmatch {
                                    } else {
                                        let dgt: i64 = tc_push_diag(diags, "T041");
                                    }
                                } else {
                                }
                            } else {
                                // PR-G2b-iii (Gap B): a generic-ENUM construct value
                                // (`Opt::Some("x")`) under a matching enum annotation — check
                                // each type-param payload against the substituted slot → T041
                                // (ET-G18: T041, not T071; AG-G12 int-lit flex).
                                let dgb: i64 = tc_enum_ctor_payload_t041(nodes, kids, lvid, lgen_base, ltargs, rdefs, binds, diags);
                            }
                        } else {
                            // A definitively-CONCRETE value of a different Named/scalar is T041;
                            // an OUT-OF-CORE value (TC_UNHANDLED — e.g. a nested-generic-return
                            // call the oracle resolves but SIGIL cannot, AG-G6) is fail-soft:
                            // never rejected, since it cannot be proven incompatible.
                            if lt == TC_UNHANDLED {
                            } else {
                                let dgn: i64 = tc_push_diag(diags, "T041");
                            }
                        }
                    } else {
                        // SELF-1: the PR-G4 else = a generic-named annotation whose base is NOT a
                        // module-local record/enum. The oracle registers the stdlib generics
                        // (Vec/Arena/Map/Option/Result/… via ambient injection) and ACCEPTS them at
                        // matching arity, so mirror that VERDICT: an allowlisted base at the right
                        // arg count is NOT T046 (the binding stays the fail-soft TC_UNHANDLED set at
                        // the `nb` push above — the oracle can't resolve the element type here
                        // either). An UNKNOWN base or a WRONG arity still fires T046 (oracle parity).
                        let sgar: i64 = tc_stdlib_generic_arity(an.text);
                        if sgar >= 0 {
                            if an.child_count == sgar {
                            } else {
                                let dw46: i64 = tc_push_diag(diags, "T046");
                            }
                        } else {
                            let dg46: i64 = tc_push_diag(diags, "T046");
                        }
                    }
                } else {
                }
            } else {
                if sn.child_count == 1 {
                    let lvid2: i64 = kids.get(sn.child_start);
                    // PR-G2a-ii: an UN-ANNOTATED generic-record construct INFERS its type-args
                    // from the field values, so a later `b.field` substitutes; a type-param
                    // NO field binds cannot be inferred → T233 (per unbound type-param,
                    // matching the oracle). A non-construct / non-generic value keeps targs "".
                    let mut utargs: str = "";
                    let lvn2: PNode = nodes.get(lvid2);
                    if lvn2.kind == P_K_RECORD_CONSTRUCT {
                        // PR-G2a-ii/iii: infer the type-args from the field values; the helper
                        // fires T233 (a type-param NO field binds) and T234 (conflicting field
                        // bindings) itself, so no post-scan here.
                        utargs = tc_infer_targs(nodes, kids, lvid2, rdefs, binds, diags);
                    } else {
                    }
                    let lt2: i64 = tc_emit_expr(nodes, kids, lvid2, TC_NO_EXPECT, binds, sigs, traits, rdefs, recs, diags);
                    // PR-5i: an un-annotated composite let (`let a = [1,2,3];`) recovers
                    // the value's composite detail so later references/indexing resolve.
                    // ONLY a true composite mangle is stored — a record value's detail
                    // is its bare NAME, which must stay "" (the record code path).
                    let ldraw: str = tc_last_rec_detail(recs);
                    let mut ldet2: str = "";
                    if tc_detail_tag(ldraw) != TC_UNHANDLED {
                        ldet2 = ldraw;
                    } else {
                    }
                    let nb2: i64 = binds.push(TcBind { name: sn.text, tag: lt2, detail: ldet2, targs: utargs });
                } else {
                }
            }
        } else {
        }
        // SELF-2: `let (a, b) = rhs` (P_K_LET_TUPLE, kind 12) — the statement walker had NO arm
        // for it, so the destructured element names were never bound and every downstream
        // reference false-fired T060 (undefined local). The oracle desugars to
        // `let $t = rhs; let a = $t.0; let b = $t.1;` and env-inserts each; mirror the OUTCOME:
        // type the RHS (the LAST child; children = [type?, value]) so a diag inside the
        // initializer (e.g. an undefined callee -> T062) still surfaces exactly as the oracle
        // checks it, then bind each `;`-joined element name (node.text = "a;b"). The binds are
        // fail-soft TC_UNHANDLED — a tuple is out-of-core in this shadow (the tuple LITERAL /
        // return already type TC_UNHANDLED), so it cannot destructure a tuple return into
        // per-element types; the oracle binds the real element types (a faithful-types follow-on,
        // AG-S2-TUPTYPES). Arity/T261 is likewise out (the RHS is typically an out-of-core call
        // whose tuple arity the shadow can't recover — AG-S2-ARITY). Scoping rides the normal
        // block unwind (same `binds` vec + the enclosing scope mark).
        if sn.kind == P_K_LET_TUPLE {
            let ltvid: i64 = kids.get(sn.child_start + sn.child_count - 1);
            let ltvt: i64 = tc_emit_expr(nodes, kids, ltvid, TC_NO_EXPECT, binds, sigs, traits, rdefs, recs, diags);
            let ltn: i64 = tc_seg_count(sn.text);
            let mut lti: i64 = 0;
            while lti < ltn {
                let ltname: str = tc_seg_at(sn.text, lti);
                let ltb: i64 = binds.push(TcBind { name: ltname, tag: TC_UNHANDLED, detail: "", targs: "" });
                lti = lti + 1;
            }
        } else {
        }
        if sn.kind == P_K_EXPR_STMT {
            if sn.child_count == 1 {
                let eid: i64 = kids.get(sn.child_start);
                let et: i64 = tc_emit_expr(nodes, kids, eid, TC_NO_EXPECT, binds, sigs, traits, rdefs, recs, diags);
            } else {
            }
        } else {
        }
        if sn.kind == P_K_ASSIGN {
            if sn.value == 0 {
                if sn.child_count == 2 {
                    let pid: i64 = kids.get(sn.child_start);
                    let avid: i64 = kids.get(sn.child_start + 1);
                    let pt: i64 = tc_emit_expr(nodes, kids, pid, TC_NO_EXPECT, binds, sigs, traits, rdefs, recs, diags);
                    // PR-5i: read the place's detail BEFORE typing the value (no
                    // ordering hazard — the place's record is last right now).
                    let pdetail: str = tc_last_rec_detail(recs);
                    // Narrow-int parity: PIN the RHS to a SCALAR place's type, mirroring
                    // the oracle's check_assign, which resolves the assignment RHS's int
                    // literals to the place type (`y: u32; y = 5;` types `5` as u32, not
                    // i64 — so a binary RHS `n = 0 - 5` to an i32 place narrows its
                    // operands too, the type-level twin of the wasm fix). tc_int_from_expected
                    // narrows only the four machine ints, so a non-int scalar place
                    // (f64/bool/str) is a harmless no-op; a record/composite place keeps
                    // TC_NO_EXPECT (unchanged — int literals don't flow there).
                    let mut avexp: i64 = TC_NO_EXPECT;
                    if tc_is_scalar(pt) {
                        avexp = pt;
                    } else {
                    }
                    let avt: i64 = tc_emit_expr(nodes, kids, avid, avexp, binds, sigs, traits, rdefs, recs, diags);
                    let adetail: str = tc_last_rec_detail(recs);
                    // T045: the value must be assignable to the place's type (a bare int
                    // literal flexes via tc_assignable's machine-int rule). The composite
                    // XOR covers a composite assigned where a scalar is expected.
                    let dca: i64 = tc_check_composite(pdetail, pt, adetail, avt, "T045", diags);
                    let avlit: bool = tc_is_all_int_lit(nodes, kids, avid);
                    let dasn: i64 = tc_check_assign(pt, avt, avlit, "T045", diags);
                } else {
                }
            } else {
            }
        } else {
        }
        if sn.kind == P_K_IF {
            if sn.child_count == 3 {
                let cid: i64 = kids.get(sn.child_start);
                let thid: i64 = kids.get(sn.child_start + 1);
                let elid: i64 = kids.get(sn.child_start + 2);
                let ct: i64 = tc_emit_expr(nodes, kids, cid, TC_NO_EXPECT, binds, sigs, traits, rdefs, recs, diags);
                // T050: an `if` condition must be exactly `bool`.
                let dif: i64 = tc_check_bool(ct, "T050", diags);
                // PR-5g: then and else are SIBLING scopes — each unwinds to the
                // pre-`if` table length, so neither's bindings leak to the other or
                // past the `if`.
                let ifmark: i64 = binds.len();
                let r1: i64 = tc_emit_block_exprs(nodes, kids, thid, binds, sigs, traits, rdefs, recs, fnret, fnret_detail, diags, cdefs);
                let u1: i64 = tc_scope_unwind(binds, ifmark);
                let r2: i64 = tc_emit_block_exprs(nodes, kids, elid, binds, sigs, traits, rdefs, recs, fnret, fnret_detail, diags, cdefs);
                let u2: i64 = tc_scope_unwind(binds, ifmark);
                // The `if` guarantees a return only when BOTH branches do.
                if r1 == 1 {
                    if r2 == 1 {
                        guaranteed = 1;
                    } else {
                    }
                } else {
                }
            } else {
            }
        } else {
        }
        if sn.kind == P_K_WHILE {
            if sn.child_count == 2 {
                let wcid: i64 = kids.get(sn.child_start);
                let wbid: i64 = kids.get(sn.child_start + 1);
                let wct: i64 = tc_emit_expr(nodes, kids, wcid, TC_NO_EXPECT, binds, sigs, traits, rdefs, recs, diags);
                // T051: a `while` condition must be exactly `bool`.
                let dwh: i64 = tc_check_bool(wct, "T051", diags);
                // PR-5g: the loop body is a nested scope — unwind on exit.
                let wmark: i64 = binds.len();
                let r3: i64 = tc_emit_block_exprs(nodes, kids, wbid, binds, sigs, traits, rdefs, recs, fnret, fnret_detail, diags, cdefs);
                let uw: i64 = tc_scope_unwind(binds, wmark);
            } else {
            }
        } else {
        }
        if sn.kind == P_K_MATCH {
            let mr: i64 = tc_emit_match(nodes, kids, sid, binds, sigs, traits, rdefs, recs, fnret, fnret_detail, diags, cdefs);
            if mr == 1 {
                guaranteed = 1;
            } else {
            }
        } else {
        }
        i = i + 1;
    }
    return guaranteed;
}

// Type a `match` statement. child[0] is the scrutinee; child[1..] are the
// P_K_MATCH_ARM nodes. A match is a STATEMENT (no value), so it emits no record
// of its own — only the scrutinee, each arm's guard, and each arm body's
// statements do. Per arm (`P_K_MATCH_ARM`, flags = 1 when a `if` guard is
// present): child[0] is the pattern, child[last] is the body block, and when
// guarded child[1] is the guard. A `P_K_PAT_BINDING` pattern (`n`) binds its name
// to the SCRUTINEE's type for the arm body. A `P_K_PAT_ENUM` pattern
// (`Opt::Some(x)` or bare `Some(x)`) binds each payload name to the variant's
// payload type (resolved from the scrutinee enum's per-variant payload table,
// PR-4d). Literal/str/range/wildcard/unit-variant patterns bind nothing.
fn tc_emit_match(nodes: Arena<PNode>, kids: Vec<i64>, matchid: i64, binds: Vec<TcBind> @Mut, sigs: Vec<TcSig>, traits: Vec<TcTrait>, rdefs: Vec<TcRec>, recs: Vec<str> @Mut, fnret: i64, fnret_detail: str, diags: Vec<str> @Mut, cdefs: Vec<TcCap>) -> i64 ! { Alloc } {
    let mn: PNode = nodes.get(matchid);
    if mn.child_count == 0 {
        return 0;
    } else {
    }
    let scrid: i64 = kids.get(mn.child_start);
    let sct: i64 = tc_emit_expr(nodes, kids, scrid, TC_NO_EXPECT, binds, sigs, traits, rdefs, recs, diags);
    // PR-G2b-ii (Gap C, AG-G17): a generic-enum scrutinee that is a bound LOCAL carries
    // its concrete type-args (`let o: Opt<i64>` → targs "4"); a payload pattern binding
    // (`Opt::Some(x)`) substitutes its type-param payload from these. A non-local
    // scrutinee (a call result / field / index) carries no targs → fail-soft (AG-G17).
    let scrn: PNode = nodes.get(scrid);
    let mut scrut_targs: str = "";
    if scrn.kind == P_K_PATH {
        scrut_targs = tc_bind_targs(binds, scrn.text);
    } else {
    }
    // PR-5d exhaustiveness state: an UNGUARDED wildcard/binding is a catch-all; an
    // enum scrutinee needs every variant covered; a bool needs both true + false.
    // Guarded arms never contribute. `all_arms_ret` tracks whether every unguarded
    // arm body returns (for T044 / guaranteed-return).
    let mut has_catchall: i64 = 0;
    let mut saw_true: i64 = 0;
    let mut saw_false: i64 = 0;
    let mut is_enum_scrut: bool = false;
    let mut eridx: i64 = 0;
    if sct >= TC_REC_BASE {
        let srec0: TcRec = rdefs.get(sct - TC_REC_BASE);
        if srec0.is_enum {
            is_enum_scrut = true;
            eridx = sct - TC_REC_BASE;
        } else {
        }
    } else {
    }
    let mut covered: Vec<str> = Vec::new();
    let mut all_arms_ret: i64 = 1;
    let mut ai: i64 = 1;
    while ai < mn.child_count {
        let armid: i64 = kids.get(mn.child_start + ai);
        let armn: PNode = nodes.get(armid);
        if armn.child_count >= 1 {
            // PR-5g: each arm is its own scope — its pattern bindings + body lets
            // unwind on arm exit so they do not leak to the next arm or past the match.
            let armmark: i64 = binds.len();
            let patid: i64 = kids.get(armn.child_start);
            let patn: PNode = nodes.get(patid);
            if patn.kind == P_K_PAT_BINDING {
                let nb: i64 = binds.push(TcBind { name: patn.text, tag: sct, detail: "", targs: "" });
            } else {
            }
            // `Opt::Some(x)` / bare `Some(x)` — bind each payload name to the
            // variant's payload type. The enum is the SCRUTINEE's type (so the
            // bare form, whose pattern text omits the enum, resolves too).
            if patn.kind == P_K_PAT_ENUM {
                if sct >= TC_REC_BASE {
                    let ridx: i64 = sct - TC_REC_BASE;
                    let vnm: str = tc_seg_at(patn.text, 1);
                    let vk: i64 = tc_variant_index(rdefs, ridx, vnm);
                    if vk >= 0 {
                        let erec: TcRec = rdefs.get(ridx);
                        let vs: i64 = erec.vstarts.get(vk);
                        let vc: i64 = erec.vcounts.get(vk);
                        let mut bi: i64 = 0;
                        let mut binding: bool = true;
                        while binding {
                            let bn: str = tc_seg_at(patn.text, 2 + bi);
                            if bn.len() == 0 {
                                binding = false;
                            } else {
                                let mut bt: i64 = TC_UNHANDLED;
                                if bi < vc {
                                    bt = erec.vptags.get(vs + bi);
                                    // PR-G2b-ii (Gap C): a type-param payload (`Some(T)`) substitutes
                                    // its bound type from the scrutinee's targs at this impl-position.
                                    // ET-G16: vptp is indexed in lockstep with vptags. ET-G17: an
                                    // unresolved/empty targ keeps the declared (TC_UNHANDLED) tag —
                                    // never tag 8.
                                    let bvptp: i64 = erec.vptp.get(vs + bi);
                                    if bvptp >= 0 {
                                        let pseg: str = tc_seg_at(scrut_targs, bvptp);
                                        if pseg.len() > 0 {
                                            bt = tc_atoi(pseg);
                                        } else {
                                        }
                                    } else {
                                    }
                                } else {
                                }
                                let nbp: i64 = binds.push(TcBind { name: bn, tag: bt, detail: "", targs: "" });
                                bi = bi + 1;
                            }
                        }
                    } else {
                    }
                } else {
                }
            } else {
            }
            // T190: an inclusive range pattern `lo..=hi` with lo > hi (the parser
            // packs lo in `value`, hi in `flags`, both signed).
            if patn.kind == P_K_PAT_RANGE {
                if patn.value > patn.flags {
                    let d190: i64 = tc_push_diag_with_span(diags, "T190", patn.start, patn.end);
                } else {
                }
            } else {
            }
            // Exhaustiveness contribution — UNGUARDED arms only (a guarded arm can
            // fail its guard, so it never makes a match exhaustive).
            if armn.flags == 1 {
            } else {
                if patn.kind == P_K_PAT_WILDCARD {
                    has_catchall = 1;
                } else {
                }
                if patn.kind == P_K_PAT_BINDING {
                    has_catchall = 1;
                } else {
                }
                if patn.kind == P_K_PAT_LIT {
                    if patn.flags == 1 {
                        if patn.value == 1 {
                            saw_true = 1;
                        } else {
                            saw_false = 1;
                        }
                    } else {
                    }
                } else {
                }
                if patn.kind == P_K_PAT_ENUM {
                    let cvnm: str = tc_seg_at(patn.text, 1);
                    let qc: i64 = covered.push(cvnm);
                } else {
                }
            }
            if armn.flags == 1 {
                let gid: i64 = kids.get(armn.child_start + 1);
                let gt: i64 = tc_emit_expr(nodes, kids, gid, TC_NO_EXPECT, binds, sigs, traits, rdefs, recs, diags);
            } else {
            }
            let bid: i64 = kids.get(armn.child_start + armn.child_count - 1);
            let br: i64 = tc_emit_block_exprs(nodes, kids, bid, binds, sigs, traits, rdefs, recs, fnret, fnret_detail, diags, cdefs);
            if armn.flags == 1 {
            } else {
                if br == 1 {
                } else {
                    all_arms_ret = 0;
                }
            }
            let au: i64 = tc_scope_unwind(binds, armmark);
        } else {
        }
        ai = ai + 1;
    }
    // Determine exhaustiveness.
    let mut exhaustive: i64 = 0;
    if has_catchall == 1 {
        exhaustive = 1;
    } else {
        if is_enum_scrut {
            let srec: TcRec = rdefs.get(eridx);
            let nv: i64 = srec.vnames.len();
            let mut allcov: i64 = 1;
            let mut vi: i64 = 0;
            while vi < nv {
                let vn: str = srec.vnames.get(vi);
                if tc_str_in_vec(covered, vn) {
                } else {
                    allcov = 0;
                }
                vi = vi + 1;
            }
            exhaustive = allcov;
        } else {
            if sct == TC_T_BOOL {
                if saw_true == 1 {
                    if saw_false == 1 {
                        exhaustive = 1;
                    } else {
                    }
                } else {
                }
            } else {
            }
        }
    }
    // T087 (enum) / T088 (non-enum) on a CONCRETE, non-exhaustive scrutinee.
    if exhaustive == 0 {
        if tc_is_concrete(sct) {
            if is_enum_scrut {
                let d87: i64 = tc_push_diag(diags, "T087");
            } else {
                let d88: i64 = tc_push_diag(diags, "T088");
            }
        } else {
        }
    } else {
    }
    // The match is guaranteed-return iff exhaustive AND every unguarded arm returns.
    let mut mg: i64 = 0;
    if exhaustive == 1 {
        if all_arms_ret == 1 {
            mg = 1;
        } else {
        }
    } else {
    }
    return mg;
}

// The type code of a parameter node (K_PARAM): its single child is the type
// (K_TYPE). Scalar or record types; a non-plain param type => TC_UNHANDLED.
fn tc_param_type_tag(nodes: Arena<PNode>, kids: Vec<i64>, paramid: i64, rdefs: Vec<TcRec>, cdefs: Vec<TcCap>) -> i64 {
    let pn: PNode = nodes.get(paramid);
    if pn.child_count >= 1 {
        let tid: i64 = kids.get(pn.child_start);
        let tn: PNode = nodes.get(tid);
        if tn.kind == P_K_TYPE {
            if tn.flags == 0 {
                if tn.child_count == 0 {
                    let code: i64 = tc_code_of_name(tn.text, rdefs);
                    if code != TC_UNHANDLED {
                        return code;
                    } else {
                    }
                    // PR-C1: a cap-typed param tags as TC_T_CAP (10), consulted AFTER
                    // scalar/record (ET-CAP-11). The bare cap name rides the bind's `detail`
                    // (tc_param_detail) for emission; the tag stays out-of-core for CHECKS.
                    let cc: i64 = tc_cap_code_of_name(tn.text, cdefs);
                    if cc != TC_UNHANDLED {
                        return TC_T_CAP;
                    } else {
                    }
                    return TC_UNHANDLED;
                } else {
                }
            } else {
            }
        } else {
        }
    } else {
    }
    return TC_UNHANDLED;
}

// Seed a function's symbol table with its parameters BEFORE its body is typed.
fn tc_seed_params(nodes: Arena<PNode>, kids: Vec<i64>, fnid: i64, binds: Vec<TcBind> @Mut, rdefs: Vec<TcRec>, cdefs: Vec<TcCap>) -> i64 ! { Alloc } {
    let fnn: PNode = nodes.get(fnid);
    let mut i: i64 = 0;
    while i < fnn.child_count {
        let cid: i64 = kids.get(fnn.child_start + i);
        let cn: PNode = nodes.get(cid);
        if cn.kind == P_K_PARAM {
            let mut ptag: i64 = tc_param_type_tag(nodes, kids, cid, rdefs, cdefs);
            let pdetail: str = tc_param_detail(nodes, kids, cid, rdefs, cdefs);
            // PR-G3b: a GENERIC-RECORD-typed param (`b: Box<i64>`) must bind as its
            // record code with concrete type-args, exactly like a `let b: Box<i64>`
            // local — otherwise tc_param_type_tag returns TC_UNHANDLED (its plain-type
            // branch rejects any type node with type-arg children) and a method call on
            // the param receiver never resolves. Resolve the base name to a record and
            // capture its targs; a non-record generic (Vec<i64>) stays unhandled.
            let mut ptargs: str = "";
            if cn.child_count >= 1 {
                let ptid: i64 = kids.get(cn.child_start);
                let ptn: PNode = nodes.get(ptid);
                if ptn.kind == P_K_TYPE {
                    if ptn.flags == 0 {
                        if ptn.child_count > 0 {
                            let pbase: i64 = tc_code_of_name(ptn.text, rdefs);
                            if pbase >= TC_REC_BASE {
                                ptag = pbase;
                                ptargs = tc_typearg_codes(nodes, kids, ptid, rdefs);
                            } else {
                            }
                        } else {
                        }
                    } else {
                    }
                } else {
                }
            } else {
            }
            let nb: i64 = binds.push(TcBind { name: cn.text, tag: ptag, detail: pdetail, targs: ptargs });
        } else {
        }
        i = i + 1;
    }
    return 0;
}

// SELF-2: seed module-level `const` decls into a fn's symbol table so their references resolve.
// The tc shadow had NO const handling (P_K_CONST was never referenced in typecheck.sigil), so
// every constant reference (T_LPAREN, P_K_FN, TC_T_I64, … — the enum-like constants that
// saturate every selfhost module) was an unbound bare name → a false T060 (undefined local).
// Consts are module-level (always in scope, like fns), so this runs per-fn right after
// tc_seed_params — the analogue of the oracle putting a module const in scope. A P_K_CONST node's
// text is "name;value" (name = seg 0) and its single child is the declared TYPE node, resolved to
// a scalar/record code (an out-of-core/composite type stays TC_UNHANDLED — the ref still BINDS, so
// no T060; the exact type is a faithfulness follow-on, AG-S2-CONSTTYPE). Scans root's DIRECT
// children (top-level items) only. Const names are UPPERCASE by convention, so they never collide
// with a lowercase param/local (no shadow-order hazard on the selfhost source).
fn tc_seed_consts(nodes: Arena<PNode>, kids: Vec<i64>, root: i64, binds: Vec<TcBind> @Mut, rdefs: Vec<TcRec>) -> i64 ! { Alloc } {
    let rn: PNode = nodes.get(root);
    let mut i: i64 = 0;
    while i < rn.child_count {
        let cid: i64 = kids.get(rn.child_start + i);
        let cn: PNode = nodes.get(cid);
        if cn.kind == P_K_CONST {
            let cname: str = tc_seg_at(cn.text, 0);
            let mut ctag: i64 = TC_UNHANDLED;
            if cn.child_count > 0 {
                let ctid: i64 = kids.get(cn.child_start);
                let ctn: PNode = nodes.get(ctid);
                ctag = tc_code_of_name(ctn.text, rdefs);
            } else {
            }
            let cb: i64 = binds.push(TcBind { name: cname, tag: ctag, detail: "", targs: "" });
        } else {
        }
        i = i + 1;
    }
    return 0;
}

// Build the module-level named-type table: one entry per `record` (K_RECORD_DEF,
// `text` = name; K_FIELD children, `text` = field name, child[0] = K_TYPE; scalar
// fields, a record-typed field => TC_UNHANDLED) AND one per `enum` (K_ENUM_DEF,
// `text` = name; is_enum = true, no fields recorded). Both share the Named code
// space (TC_REC_BASE + push order); the order is internal (the encoding is
// name-bearing) so records-then-enums is fine.
fn tc_build_recs(nodes: Arena<PNode>, kids: Vec<i64>, root: i64, rdefs: Vec<TcRec> @Mut) -> i64 ! { Alloc } {
    let rn: PNode = nodes.get(root);
    let mut i: i64 = 0;
    while i < rn.child_count {
        let cid: i64 = kids.get(rn.child_start + i);
        let cn: PNode = nodes.get(cid);
        if cn.kind == P_K_RECORD_DEF {
            // PR-G2a pre-pass: the record's type-param names (`record Box<T>` → ["T"]).
            let mut rtpnames: Vec<str> = Vec::new();
            let mut tpi: i64 = 0;
            while tpi < cn.child_count {
                let tpcid: i64 = kids.get(cn.child_start + tpi);
                let tpcn: PNode = nodes.get(tpcid);
                if tpcn.kind == P_K_TYPE_PARAM {
                    let qtn: i64 = rtpnames.push(tc_seg_at(tpcn.text, 0));
                } else {
                }
                tpi = tpi + 1;
            }
            let mut fnames: Vec<str> = Vec::new();
            let mut ftags: Vec<i64> = Vec::new();
            let mut fparmtp: Vec<i64> = Vec::new();
            let mut fi: i64 = 0;
            while fi < cn.child_count {
                let fcid: i64 = kids.get(cn.child_start + fi);
                let fcn: PNode = nodes.get(fcid);
                if fcn.kind == P_K_FIELD {
                    let mut ftag: i64 = TC_UNHANDLED;
                    let mut fptp: i64 = 0 - 1;
                    if fcn.child_count >= 1 {
                        let tid: i64 = kids.get(fcn.child_start);
                        let tn: PNode = nodes.get(tid);
                        if tn.kind == P_K_TYPE {
                            if tn.flags == 0 {
                                if tn.child_count == 0 {
                                    ftag = tc_scalar_tag(tn.text);
                                    // PR-G2a: a field whose type name IS a type-param.
                                    let rtpc: i64 = rtpnames.len();
                                    let mut rtj: i64 = 0;
                                    while rtj < rtpc {
                                        let cand: str = rtpnames.get(rtj);
                                        if cand.bytes_eq(tn.text) {
                                            fptp = rtj;
                                            rtj = rtpc;
                                        } else {
                                            rtj = rtj + 1;
                                        }
                                    }
                                    // A field whose type is a (backward-declared) record or
                                    // enum resolves to that record/enum code — so `b.field`
                                    // types as the nested type (not TC_UNHANDLED), which lets a
                                    // `match b.opt { Opt::Some(x) => … }` bind the variant payload
                                    // (fixes the AG-E6 / AG-G17 false T060 on a non-local
                                    // scrutinee). A type-param field (fptp >= 0) is NOT a nested
                                    // record; a forward-declared field type misses (rdefs is built
                                    // in source order) and stays TC_UNHANDLED.
                                    if ftag == TC_UNHANDLED {
                                        if fptp < 0 {
                                            let frc: i64 = tc_code_of_name(tn.text, rdefs);
                                            if frc >= TC_REC_BASE {
                                                ftag = frc;
                                            } else {
                                            }
                                        } else {
                                        }
                                    } else {
                                    }
                                } else {
                                    // A generic-Named field type (`opt: Opt<i64>`) resolves to its
                                    // BASE enum/record code, so `b.opt` types as `Opt` and a match
                                    // binds the variant (no false T060). The concrete type-args are
                                    // NOT yet threaded through a field access, so a type-param payload
                                    // fail-softs to TC_UNHANDLED (AG-G19 follow-on) — never a wrong
                                    // concrete or a false code.
                                    let gfrc: i64 = tc_code_of_name(tn.text, rdefs);
                                    if gfrc >= TC_REC_BASE {
                                        ftag = gfrc;
                                    } else {
                                    }
                                }
                            } else {
                            }
                        } else {
                        }
                    } else {
                    }
                    let q1: i64 = fnames.push(fcn.text);
                    let q2: i64 = ftags.push(ftag);
                    let q3: i64 = fparmtp.push(fptp);
                } else {
                }
                fi = fi + 1;
            }
            let revn: Vec<str> = Vec::new();
            let revs: Vec<i64> = Vec::new();
            let revc: Vec<i64> = Vec::new();
            let revp: Vec<i64> = Vec::new();
            let revtp: Vec<i64> = Vec::new();
            let qs: i64 = rdefs.push(TcRec { name: cn.text, fnames: fnames, ftags: ftags, is_enum: false, vnames: revn, vstarts: revs, vcounts: revc, vptags: revp, tpnames: rtpnames, fparmtp: fparmtp, vptp: revtp });
        } else {
        }
        if cn.kind == P_K_ENUM_DEF {
            // PR-G2b-ii: the enum's type-param names (`enum Opt<T>` → ["T"]) — mirrors the
            // record pre-pass, so a variant payload that bare-IS a type-param can be
            // substituted from the scrutinee's type-args at a match (Gap C, ET-G16).
            let mut etpnames: Vec<str> = Vec::new();
            let mut etpi: i64 = 0;
            while etpi < cn.child_count {
                let etpcid: i64 = kids.get(cn.child_start + etpi);
                let etpcn: PNode = nodes.get(etpcid);
                if etpcn.kind == P_K_TYPE_PARAM {
                    let qetn: i64 = etpnames.push(tc_seg_at(etpcn.text, 0));
                } else {
                }
                etpi = etpi + 1;
            }
            let efn: Vec<str> = Vec::new();
            let eft: Vec<i64> = Vec::new();
            let mut vnames: Vec<str> = Vec::new();
            let mut vstarts: Vec<i64> = Vec::new();
            let mut vcounts: Vec<i64> = Vec::new();
            let mut vptags: Vec<i64> = Vec::new();
            let mut vptp: Vec<i64> = Vec::new();
            let mut vi: i64 = 0;
            while vi < cn.child_count {
                let vcid: i64 = kids.get(cn.child_start + vi);
                let vcn: PNode = nodes.get(vcid);
                if vcn.kind == P_K_ENUM_VARIANT {
                    let qn: i64 = vnames.push(vcn.text);
                    let qst: i64 = vstarts.push(vptags.len());
                    let mut pc: i64 = 0;
                    let mut fj: i64 = 0;
                    while fj < vcn.child_count {
                        let fcid: i64 = kids.get(vcn.child_start + fj);
                        let fcn: PNode = nodes.get(fcid);
                        if fcn.kind == P_K_ENUM_FIELD {
                            let mut ptag: i64 = TC_UNHANDLED;
                            let mut pptp: i64 = 0 - 1;
                            if fcn.child_count >= 1 {
                                let tid: i64 = kids.get(fcn.child_start);
                                let tn: PNode = nodes.get(tid);
                                if tn.kind == P_K_TYPE {
                                    if tn.flags == 0 {
                                        if tn.child_count == 0 {
                                            ptag = tc_scalar_tag(tn.text);
                                            // PR-G2b-ii: does this payload bare-IS a type-param?
                                            let etpc: i64 = etpnames.len();
                                            let mut etj: i64 = 0;
                                            while etj < etpc {
                                                let ecand: str = etpnames.get(etj);
                                                if ecand.bytes_eq(tn.text) {
                                                    pptp = etj;
                                                    etj = etpc;
                                                } else {
                                                    etj = etj + 1;
                                                }
                                            }
                                        } else {
                                        }
                                    } else {
                                    }
                                } else {
                                }
                            } else {
                            }
                            // ET-G16: vptp and vptags pushed in lockstep, 1:1.
                            let qp: i64 = vptags.push(ptag);
                            let qpt: i64 = vptp.push(pptp);
                            pc = pc + 1;
                        } else {
                        }
                        fj = fj + 1;
                    }
                    let qc: i64 = vcounts.push(pc);
                } else {
                }
                vi = vi + 1;
            }
            let efp: Vec<i64> = Vec::new();
            let qe: i64 = rdefs.push(TcRec { name: cn.text, fnames: efn, ftags: eft, is_enum: true, vnames: vnames, vstarts: vstarts, vcounts: vcounts, vptags: vptags, tpnames: etpnames, fparmtp: efp, vptp: vptp });
        } else {
        }
        i = i + 1;
    }
    return 0;
}

// PR-C0: build the cap-declaration table — one TcCap per top-level `cap type` decl,
// in source order (mirrors tc_build_recs' root-child walk). A P_K_CAP_TYPE node's
// text is "name;authorities;params"; `pnames` is the parametric arity = the count of
// comma-separated entries in the 3rd segment (0 when empty / non-parametric). INERT
// on the current corpus (zero `cap type` decls → an empty table → no behavior change,
// ET-CAP-5). Like tc_build_recs, walks the root's children directly, so it handles a
// single P_K_MODULE root (the corpus shape) identically.
fn tc_build_caps(nodes: Arena<PNode>, kids: Vec<i64>, root: i64, cdefs: Vec<TcCap> @Mut) -> i64 ! { Alloc } {
    let rn: PNode = nodes.get(root);
    let mut i: i64 = 0;
    while i < rn.child_count {
        let cid: i64 = kids.get(rn.child_start + i);
        let cn: PNode = nodes.get(cid);
        if cn.kind == P_K_CAP_TYPE {
            let cname: str = tc_seg_at(cn.text, 0);
            let params: str = tc_seg_at(cn.text, 2);
            let plen: i64 = params.len();
            let mut pn: i64 = 0;
            if plen > 0 {
                pn = 1;
                let mut bi: i64 = 0;
                while bi < plen {
                    if params.byte_at(bi) == TC_BYTE_COMMA {
                        pn = pn + 1;
                    } else {
                    }
                    bi = bi + 1;
                }
            } else {
            }
            let qc: i64 = cdefs.push(TcCap { name: cname, pnames: pn });
        } else {
        }
        i = i + 1;
    }
    return 0;
}

// Build the module-level function-signature table (record-typed params/returns
// resolve via `rdefs`).
fn tc_build_sigs(nodes: Arena<PNode>, kids: Vec<i64>, root: i64, sigs: Vec<TcSig> @Mut, rdefs: Vec<TcRec>, cdefs: Vec<TcCap>) -> i64 ! { Alloc } {
    // B-COMPOSE: the three vec-backing intrinsics the ORACLE knows globally (alloc user-code
    // calls ACCEPT; vec_load/vec_store are recognized with a witness-shape check). Without
    // sigs, every cloned Vec method body T062s in the composed tc gate. Ret/params are the
    // LOOSEST faithful codes: alloc -> i64 (the oracle's IntrinsicAlloc result); the two
    // vec ops type as UNHANDLED (compatible-with-anything — vec_load's true ret is the
    // witness's T). Witness MISUSE shapes (a non-Vec 4th arg the oracle rejects) stay an
    // explicit divergence fence: quarantined out of tree + never on a covered corpus.
    let mut ial_params: Vec<i64> = Vec::new();
    let qia1: i64 = ial_params.push(TC_T_I64);
    let mut ial_ptids: Vec<i64> = Vec::new();
    let qia0: i64 = ial_ptids.push(0 - 1);
    let mut ial_pdet: Vec<str> = Vec::new();
    let qia2: i64 = ial_pdet.push("");
    let ial_tpb: Vec<str> = Vec::new();
    let mut ial_ptp: Vec<i64> = Vec::new();
    let qia3: i64 = ial_ptp.push(0 - 1);
    let qial: i64 = sigs.push(TcSig { name: "alloc", ret: TC_T_I64, params: ial_params, param_typeids: ial_ptids, ret_detail: "", param_details: ial_pdet, tpbounds: ial_tpb, parmtp: ial_ptp, rettp: 0 - 1 });
    let mut ivl_params: Vec<i64> = Vec::new();
    let mut ivl_ptids: Vec<i64> = Vec::new();
    let mut ivl_pdet: Vec<str> = Vec::new();
    let mut ivl_ptp: Vec<i64> = Vec::new();
    let mut ivi: i64 = 0;
    while ivi < 4 {
        let qv1: i64 = ivl_params.push(TC_UNHANDLED);
        let qv0: i64 = ivl_ptids.push(0 - 1);
        let qv2: i64 = ivl_pdet.push("");
        let qv3: i64 = ivl_ptp.push(0 - 1);
        ivi = ivi + 1;
    }
    let ivl_tpb: Vec<str> = Vec::new();
    let qivl: i64 = sigs.push(TcSig { name: "vec_load", ret: TC_UNHANDLED, params: ivl_params, param_typeids: ivl_ptids, ret_detail: "", param_details: ivl_pdet, tpbounds: ivl_tpb, parmtp: ivl_ptp, rettp: 0 - 1 });
    let mut ivs_params: Vec<i64> = Vec::new();
    let mut ivs_ptids: Vec<i64> = Vec::new();
    let mut ivs_pdet: Vec<str> = Vec::new();
    let mut ivs_ptp: Vec<i64> = Vec::new();
    let mut ivj: i64 = 0;
    while ivj < 4 {
        let qw1: i64 = ivs_params.push(TC_UNHANDLED);
        let qw0: i64 = ivs_ptids.push(0 - 1);
        let qw2: i64 = ivs_pdet.push("");
        let qw3: i64 = ivs_ptp.push(0 - 1);
        ivj = ivj + 1;
    }
    let ivs_tpb: Vec<str> = Vec::new();
    let qivs: i64 = sigs.push(TcSig { name: "vec_store", ret: TC_T_UNIT, params: ivs_params, param_typeids: ivs_ptids, ret_detail: "", param_details: ivs_pdet, tpbounds: ivs_tpb, parmtp: ivs_ptp, rettp: 0 - 1 });
    // HB-2 family-1: the raw-memory intrinsics the certified artifact's stdlib tail calls from
    // NON-generic fns (generic Vec/Arena bodies are PR-G0-skipped, which is why only these two
    // ever fired T062 over cap0). Ret codes mirror the oracle exactly (intrinsics.rs):
    // store8 -> Unit, load8 -> i64, str_from_raw -> Str. Param codes are the loosest faithful
    // i64s — the oracle's own arg checks (T075 etc.) are out-of-core, so the shadow skips them
    // (subset-safe: a missed code, never a false one). Module-privacy gates (str_from_raw is
    // T257-private to `string`) are likewise out-of-core and not modeled.
    let mut is8_params: Vec<i64> = Vec::new();
    let qs81: i64 = is8_params.push(TC_T_I64);
    let qs82: i64 = is8_params.push(TC_T_I64);
    let mut is8_ptids: Vec<i64> = Vec::new();
    let qs83: i64 = is8_ptids.push(0 - 1);
    let qs84: i64 = is8_ptids.push(0 - 1);
    let mut is8_pdet: Vec<str> = Vec::new();
    let qs85: i64 = is8_pdet.push("");
    let qs86: i64 = is8_pdet.push("");
    let is8_tpb: Vec<str> = Vec::new();
    let mut is8_ptp: Vec<i64> = Vec::new();
    let qs87: i64 = is8_ptp.push(0 - 1);
    let qs88: i64 = is8_ptp.push(0 - 1);
    let qis8: i64 = sigs.push(TcSig { name: "store8", ret: TC_T_UNIT, params: is8_params, param_typeids: is8_ptids, ret_detail: "", param_details: is8_pdet, tpbounds: is8_tpb, parmtp: is8_ptp, rettp: 0 - 1 });
    let mut il8_params: Vec<i64> = Vec::new();
    let ql81: i64 = il8_params.push(TC_T_I64);
    let mut il8_ptids: Vec<i64> = Vec::new();
    let ql82: i64 = il8_ptids.push(0 - 1);
    let mut il8_pdet: Vec<str> = Vec::new();
    let ql83: i64 = il8_pdet.push("");
    let il8_tpb: Vec<str> = Vec::new();
    let mut il8_ptp: Vec<i64> = Vec::new();
    let ql84: i64 = il8_ptp.push(0 - 1);
    let qil8: i64 = sigs.push(TcSig { name: "load8", ret: TC_T_I64, params: il8_params, param_typeids: il8_ptids, ret_detail: "", param_details: il8_pdet, tpbounds: il8_tpb, parmtp: il8_ptp, rettp: 0 - 1 });
    let mut isr_params: Vec<i64> = Vec::new();
    let qsr1: i64 = isr_params.push(TC_T_I64);
    let qsr2: i64 = isr_params.push(TC_T_I64);
    let mut isr_ptids: Vec<i64> = Vec::new();
    let qsr3: i64 = isr_ptids.push(0 - 1);
    let qsr4: i64 = isr_ptids.push(0 - 1);
    let mut isr_pdet: Vec<str> = Vec::new();
    let qsr5: i64 = isr_pdet.push("");
    let qsr6: i64 = isr_pdet.push("");
    let isr_tpb: Vec<str> = Vec::new();
    let mut isr_ptp: Vec<i64> = Vec::new();
    let qsr7: i64 = isr_ptp.push(0 - 1);
    let qsr8: i64 = isr_ptp.push(0 - 1);
    let qisr: i64 = sigs.push(TcSig { name: "str_from_raw", ret: TC_T_STR, params: isr_params, param_typeids: isr_ptids, ret_detail: "", param_details: isr_pdet, tpbounds: isr_tpb, parmtp: isr_ptp, rettp: 0 - 1 });
    let rn: PNode = nodes.get(root);
    let mut i: i64 = 0;
    while i < rn.child_count {
        let cid: i64 = kids.get(rn.child_start + i);
        let cn: PNode = nodes.get(cid);
        if cn.kind == P_K_FN {
            let ret: i64 = tc_fn_ret_tag(nodes, kids, cid, rdefs);
            // PR-5j ET-J2: the return's composite detail — "" for scalar/record/unit
            // (a record return must NOT mangle to its bare name, or the call node
            // would emit tag 901 instead of tag 9 + name).
            let rtid: i64 = tc_fn_ret_typeid(nodes, kids, cid);
            let mut ret_detail: str = "";
            if rtid >= 0 {
                if tc_is_composite_typenode(nodes, rtid) {
                    ret_detail = tc_tmangle(nodes, kids, rtid, rdefs, TC_TYPE_DEPTH_CEILING);
                } else {
                }
            } else {
            }
            // PR-6b pre-pass: collect this fn's type-param names + their ';'-joined
            // bound lists (P_K_TYPE_PARAM text = "name;b1;b2"; "" if unbounded).
            let mut tpnames: Vec<str> = Vec::new();
            let mut tpbounds: Vec<str> = Vec::new();
            let mut ti: i64 = 0;
            while ti < cn.child_count {
                let tcid: i64 = kids.get(cn.child_start + ti);
                let tcn: PNode = nodes.get(tcid);
                if tcn.kind == P_K_TYPE_PARAM {
                    let tptext: str = tcn.text;
                    let tlen: i64 = tptext.len();
                    let mut semi: i64 = 0 - 1;
                    let mut bj: i64 = 0;
                    while bj < tlen {
                        let bb: i64 = tptext.byte_at(bj);
                        if bb == TC_BYTE_SEMI {
                            semi = bj;
                            bj = tlen;
                        } else {
                            bj = bj + 1;
                        }
                    }
                    let mut tpbound: str = "";
                    if semi >= 0 {
                        tpbound = tptext.substr(semi + 1, tlen);
                    } else {
                    }
                    let qtn: i64 = tpnames.push(tc_seg_at(tptext, 0));
                    let qtb: i64 = tpbounds.push(tpbound);
                } else {
                }
                ti = ti + 1;
            }
            // PR-G1a: rettp = the type-param index the return bare-IS, or -1. A bare
            // type-param return node (`-> T`) is a plain K_TYPE with text == a tpname
            // and NO children; a composite generic return (`-> Holder<T>`) has child
            // args so tc_typenode_name yields "" → rettp stays -1 (that is G2, not G1a).
            let mut rettp: i64 = 0 - 1;
            if rtid >= 0 {
                let rname: str = tc_typenode_name(nodes, rtid);
                let rtpc: i64 = tpnames.len();
                let mut rtj: i64 = 0;
                while rtj < rtpc {
                    let rcand: str = tpnames.get(rtj);
                    if rcand.bytes_eq(rname) {
                        rettp = rtj;
                        rtj = rtpc;
                    } else {
                        rtj = rtj + 1;
                    }
                }
            } else {
            }
            let mut params: Vec<i64> = Vec::new();
            let mut param_typeids: Vec<i64> = Vec::new();
            let mut param_details: Vec<str> = Vec::new();
            let mut parmtp: Vec<i64> = Vec::new();
            let mut pi: i64 = 0;
            while pi < cn.child_count {
                let pcid: i64 = kids.get(cn.child_start + pi);
                let pcn: PNode = nodes.get(pcid);
                if pcn.kind == P_K_PARAM {
                    // ET-J4: params + param_details pushed in lockstep, one each per
                    // param. tc_param_detail is "" for a non-composite param (gated).
                    let ptag: i64 = tc_param_type_tag(nodes, kids, pcid, rdefs, cdefs);
                    let qp: i64 = params.push(ptag);
                    let mut ptid: i64 = 0 - 1;
                    if pcn.child_count > 0 {
                        ptid = kids.get(pcn.child_start);
                    } else {
                    }
                    let qpi: i64 = param_typeids.push(ptid);
                    let pdet: str = tc_param_detail(nodes, kids, pcid, rdefs, cdefs);
                    let qpd: i64 = param_details.push(pdet);
                    // PR-6b: parmtp[i] = the type-param index this param bare-IS, or -1.
                    let pnm: str = tc_param_typename(nodes, kids, pcid);
                    let mut tpidx: i64 = 0 - 1;
                    let tpc: i64 = tpnames.len();
                    let mut tj: i64 = 0;
                    while tj < tpc {
                        let cand: str = tpnames.get(tj);
                        if cand.bytes_eq(pnm) {
                            tpidx = tj;
                            tj = tpc;
                        } else {
                            tj = tj + 1;
                        }
                    }
                    let qpt: i64 = parmtp.push(tpidx);
                } else {
                }
                pi = pi + 1;
            }
            // The P_K_FN text carries the effect suffix (`name;!;E1;…`, parser_fn:3822);
            // the census key must be the BARE name (segment 0) — call sites look up by the
            // bare callee, matching the oracle's function_sigs key. Without this, an
            // effect-row fn (`fn a() -> i64 ! { Alloc }`) registers under "a;!;Alloc" and every
            // call to it false-fires T062 (the BOOT composition surfaced this latent gap).
            let fnkey: str = tc_seg_at(cn.text, 0);
            let qs: i64 = sigs.push(TcSig { name: fnkey, ret: ret, params: params, param_typeids: param_typeids, ret_detail: ret_detail, param_details: param_details, tpbounds: tpbounds, parmtp: parmtp, rettp: rettp });
        } else {
        }
        // PR-6b: seed each impl method as a sig keyed "Type::method" (the oracle's
        // function_sigs key) so structural satisfaction can look it up. Inherent and
        // explicit impls alike — the target type is text segment 1.
        if cn.kind == P_K_IMPL {
            let yname: str = tc_seg_at(cn.text, 1);
            // PR-G3b: collect the impl's type-param names (P_K_TYPE_PARAM children come
            // FIRST, before the method P_K_FN children — same layout as a record/fn). A
            // method returning a bare impl-type-param (`-> T`, or a renamed `-> U` under
            // `impl Box<U>`) substitutes at the call site from the receiver's type-args,
            // indexed by this impl-position — which aligns with the record's type-param
            // position (the impl fills the record's slots left-to-right).
            let mut itpnames: Vec<str> = Vec::new();
            let mut iti: i64 = 0;
            while iti < cn.child_count {
                let itcid: i64 = kids.get(cn.child_start + iti);
                let itcn: PNode = nodes.get(itcid);
                if itcn.kind == P_K_TYPE_PARAM {
                    let qit: i64 = itpnames.push(tc_seg_at(itcn.text, 0));
                } else {
                }
                iti = iti + 1;
            }
            let mut mi2: i64 = 0;
            while mi2 < cn.child_count {
                let mcid: i64 = kids.get(cn.child_start + mi2);
                let mcn: PNode = nodes.get(mcid);
                if mcn.kind == P_K_FN {
                    let mret: i64 = tc_fn_ret_tag(nodes, kids, mcid, rdefs);
                    // PR-G3b: mrettp = the impl-type-param index the method return bare-IS,
                    // or -1. tc_typenode_name yields "" for a composite return (`-> Box<T>`)
                    // → no match → -1 (that nesting is G4, not here). A concrete `-> i64`
                    // return also yields -1 → no substitution (msg.ret is already the tag).
                    let mut mrettp: i64 = 0 - 1;
                    let mrtid: i64 = tc_fn_ret_typeid(nodes, kids, mcid);
                    if mrtid >= 0 {
                        let mrname: str = tc_typenode_name(nodes, mrtid);
                        let itpc: i64 = itpnames.len();
                        let mut itj: i64 = 0;
                        while itj < itpc {
                            let icand: str = itpnames.get(itj);
                            if icand.bytes_eq(mrname) {
                                mrettp = itj;
                                itj = itpc;
                            } else {
                                itj = itj + 1;
                            }
                        }
                    } else {
                    }
                    let mut mparams: Vec<i64> = Vec::new();
                    let mut mparam_typeids: Vec<i64> = Vec::new();
                    let mut mpdet: Vec<str> = Vec::new();
                    let mut mtpb: Vec<str> = Vec::new();
                    let mut mpp: Vec<i64> = Vec::new();
                    let mut mpi: i64 = 0;
                    while mpi < mcn.child_count {
                        let mpcid: i64 = kids.get(mcn.child_start + mpi);
                        let mpcn: PNode = nodes.get(mpcid);
                        if mpcn.kind == P_K_PARAM {
                            let mptag: i64 = tc_param_type_tag(nodes, kids, mpcid, rdefs, cdefs);
                            let qm1: i64 = mparams.push(mptag);
                            let mut mptid: i64 = 0 - 1;
                            if mpcn.child_count > 0 {
                                mptid = kids.get(mpcn.child_start);
                            } else {
                            }
                            let qmi: i64 = mparam_typeids.push(mptid);
                            let mpd: str = tc_param_detail(nodes, kids, mpcid, rdefs, cdefs);
                            let qm2: i64 = mpdet.push(mpd);
                            // PR-G3b: parmtp[i] = the impl-type-param index this param bare-IS,
                            // or -1. A type-param-typed param (`x: T`) stores mptag = TC_UNHANDLED
                            // (T is no scalar/record); the substitution happens at the call site
                            // from the receiver's targs[parmtp], mirroring rettp.
                            let mpnm: str = tc_param_typename(nodes, kids, mpcid);
                            let mut mptp: i64 = 0 - 1;
                            let mitpc: i64 = itpnames.len();
                            let mut mij: i64 = 0;
                            while mij < mitpc {
                                let mican: str = itpnames.get(mij);
                                if mican.bytes_eq(mpnm) {
                                    mptp = mij;
                                    mij = mitpc;
                                } else {
                                    mij = mij + 1;
                                }
                            }
                            let qm3: i64 = mpp.push(mptp);
                        } else {
                        }
                        mpi = mpi + 1;
                    }
                    let pre: str = yname.concat("::");
                    // Strip the method's effect suffix (parser_fn:3822) so the key is the bare
                    // `Type::method` the call site looks up (same latent gap as top-level fns).
                    let mbare: str = tc_seg_at(mcn.text, 0);
                    let mkey: str = pre.concat(mbare);
                    let qms: i64 = sigs.push(TcSig { name: mkey, ret: mret, params: mparams, param_typeids: mparam_typeids, ret_detail: "", param_details: mpdet, tpbounds: mtpb, parmtp: mpp, rettp: mrettp });
                } else {
                }
                mi2 = mi2 + 1;
            }
        } else {
        }
        i = i + 1;
    }
    return 0;
}

// Lexicographic byte-compare a < b (for sorting trait methods by name, ET-TR8).
fn tc_str_lt(a: str, b: str) -> bool {
    let la: i64 = a.len();
    let lb: i64 = b.len();
    let mut lim: i64 = la;
    if lb < la {
        lim = lb;
    } else {
    }
    let mut i: i64 = 0;
    while i < lim {
        let ca: i64 = a.byte_at(i);
        let cb: i64 = b.byte_at(i);
        if ca < cb {
            return true;
        } else {
        }
        if ca > cb {
            return false;
        } else {
        }
        i = i + 1;
    }
    if la < lb {
        return true;
    } else {
    }
    return false;
}

// The declared type NAME of a param (its P_K_TYPE child's text), or "" for a
// composite/out-of-core param type. Used to map a param to the type-param it bare-IS.
fn tc_param_typename(nodes: Arena<PNode>, kids: Vec<i64>, paramid: i64) -> str {
    let pn: PNode = nodes.get(paramid);
    if pn.child_count >= 1 {
        let tid: i64 = kids.get(pn.child_start);
        let tn: PNode = nodes.get(tid);
        if tn.kind == P_K_TYPE {
            if tn.flags == 0 {
                if tn.child_count == 0 {
                    return tn.text;
                } else {
                }
            } else {
            }
        } else {
        }
    } else {
    }
    return "";
}

// The name of a plain P_K_TYPE node (a trait sig's return type), or "" if composite.
fn tc_typenode_name(nodes: Arena<PNode>, typeid: i64) -> str {
    let tn: PNode = nodes.get(typeid);
    if tn.kind == P_K_TYPE {
        if tn.flags == 0 {
            if tn.child_count == 0 {
                return tn.text;
            } else {
            }
        } else {
        }
    } else {
    }
    return "";
}

// Resolve a trait-method param/return type NAME to a code: `Self` → TC_T_SELF (the
// substitution sentinel), "" (composite/out-of-core) → TC_UNHANDLED, else the scalar
// tag or record code.
fn tc_trait_typecode(name: str, rdefs: Vec<TcRec>) -> i64 {
    let isself: bool = name.bytes_eq("Self");
    if isself {
        return TC_T_SELF;
    } else {
    }
    let ln: i64 = name.len();
    if ln == 0 {
        return TC_UNHANDLED;
    } else {
    }
    return tc_code_of_name(name, rdefs);
}

// PR-6b: build the trait table. Each P_K_TRAIT's P_K_TRAIT_SIG children are methods
// (text = name; children = P_K_PARAM* then an optional trailing P_K_TYPE return).
// `Self` types → TC_T_SELF. Methods are stored SORTED by name (ET-TR8) so the first
// structural failure matches the oracle's BTreeMap order.
fn tc_build_traits(nodes: Arena<PNode>, kids: Vec<i64>, root: i64, traits: Vec<TcTrait> @Mut, rdefs: Vec<TcRec>) -> i64 ! { Alloc } {
    let rn: PNode = nodes.get(root);
    let mut i: i64 = 0;
    while i < rn.child_count {
        let cid: i64 = kids.get(rn.child_start + i);
        let cn: PNode = nodes.get(cid);
        if cn.kind == P_K_TRAIT {
            let mut mnames: Vec<str> = Vec::new();
            let mut mrets: Vec<i64> = Vec::new();
            let mut mstarts: Vec<i64> = Vec::new();
            let mut mcounts: Vec<i64> = Vec::new();
            let mut mptags: Vec<i64> = Vec::new();
            let mut si: i64 = 0;
            while si < cn.child_count {
                let sid: i64 = kids.get(cn.child_start + si);
                let sn: PNode = nodes.get(sid);
                if sn.kind == P_K_TRAIT_SIG {
                    let pstart: i64 = mptags.len();
                    let mut pcount: i64 = 0;
                    let mut mret: i64 = TC_T_UNIT;
                    let mut ci: i64 = 0;
                    while ci < sn.child_count {
                        let chid: i64 = kids.get(sn.child_start + ci);
                        let chn: PNode = nodes.get(chid);
                        if chn.kind == P_K_PARAM {
                            let pnm: str = tc_param_typename(nodes, kids, chid);
                            let pc: i64 = tc_trait_typecode(pnm, rdefs);
                            let qpp: i64 = mptags.push(pc);
                            pcount = pcount + 1;
                        } else {
                        }
                        if chn.kind == P_K_TYPE {
                            let rnm: str = tc_typenode_name(nodes, chid);
                            mret = tc_trait_typecode(rnm, rdefs);
                        } else {
                        }
                        ci = ci + 1;
                    }
                    let qn: i64 = mnames.push(sn.text);
                    let qr: i64 = mrets.push(mret);
                    let qst: i64 = mstarts.push(pstart);
                    let qc: i64 = mcounts.push(pcount);
                } else {
                }
                si = si + 1;
            }
            // ET-TR8: selection-sort the per-method arrays by name (mptags is the flat
            // pool, untouched — mstarts still index it correctly after the permutation).
            let mc: i64 = mnames.len();
            let mut a: i64 = 0;
            while a < mc {
                let mut mn: i64 = a;
                let mut b: i64 = a + 1;
                while b < mc {
                    let nb: str = mnames.get(b);
                    let nmin: str = mnames.get(mn);
                    if tc_str_lt(nb, nmin) {
                        mn = b;
                    } else {
                    }
                    b = b + 1;
                }
                if mn == a {
                } else {
                    let na: str = mnames.get(a);
                    let nm: str = mnames.get(mn);
                    let xn1: i64 = mnames.set(a, nm);
                    let xn2: i64 = mnames.set(mn, na);
                    let ra: i64 = mrets.get(a);
                    let rm: i64 = mrets.get(mn);
                    let xr1: i64 = mrets.set(a, rm);
                    let xr2: i64 = mrets.set(mn, ra);
                    let sa: i64 = mstarts.get(a);
                    let sm: i64 = mstarts.get(mn);
                    let xs1: i64 = mstarts.set(a, sm);
                    let xs2: i64 = mstarts.set(mn, sa);
                    let cca: i64 = mcounts.get(a);
                    let ccm: i64 = mcounts.get(mn);
                    let xc1: i64 = mcounts.set(a, ccm);
                    let xc2: i64 = mcounts.set(mn, cca);
                }
                a = a + 1;
            }
            let qt: i64 = traits.push(TcTrait { name: cn.text, mnames: mnames, mrets: mrets, mstarts: mstarts, mcounts: mcounts, mptags: mptags });
        } else {
        }
        i = i + 1;
    }
    return 0;
}

// Two type codes match for satisfaction iff equal, OR either is out-of-core
// (TC_UNHANDLED) — an undecidable comparison never manufactures a mismatch (ET-TR13).
fn tc_codes_match(a: i64, b: i64) -> bool {
    if a == b {
        return true;
    } else {
    }
    if a == TC_UNHANDLED {
        return true;
    } else {
    }
    if b == TC_UNHANDLED {
        return true;
    } else {
    }
    return false;
}

// Structural satisfaction (mirrors structural_satisfies, traits.rs:76): the record/
// enum at `concrete` provides every trait method as `Name::method` with an EXACT
// signature match after Self→concrete. Methods visited in sorted order (ET-TR8):
// the first MISSING → 245 (NoImpl, short-circuit); the first present-but-mismatched
// → 246 (SignatureMismatch). 0 = Ok.
fn tc_structural_satisfies(concrete: i64, traits: Vec<TcTrait>, tidx: i64, sigs: Vec<TcSig>, rdefs: Vec<TcRec>) -> i64 ! { Alloc } {
    let ridx: i64 = concrete - TC_REC_BASE;
    let rec: TcRec = rdefs.get(ridx);
    let recname: str = rec.name;
    let tr: TcTrait = traits.get(tidx);
    let mc: i64 = tr.mnames.len();
    let mut mi: i64 = 0;
    while mi < mc {
        let mname: str = tr.mnames.get(mi);
        let pre: str = recname.concat("::");
        let key: str = pre.concat(mname);
        let sidx: i64 = tc_sig_find(sigs, key);
        if sidx < 0 {
            return 245;
        } else {
        }
        let found: TcSig = sigs.get(sidx);
        let pcount: i64 = tr.mcounts.get(mi);
        let pstart: i64 = tr.mstarts.get(mi);
        let mut ok: bool = true;
        let gotpc: i64 = found.params.len();
        if gotpc == pcount {
        } else {
            ok = false;
        }
        let wret: i64 = tc_self_subst(tr.mrets.get(mi), concrete);
        if tc_codes_match(found.ret, wret) {
        } else {
            ok = false;
        }
        if ok {
            let mut pj: i64 = 0;
            while pj < pcount {
                let wp: i64 = tc_self_subst(tr.mptags.get(pstart + pj), concrete);
                let gp: i64 = found.params.get(pj);
                if tc_codes_match(gp, wp) {
                } else {
                    ok = false;
                }
                pj = pj + 1;
            }
        } else {
        }
        if ok {
        } else {
            return 246;
        }
        mi = mi + 1;
    }
    return 0;
}

// The satisfaction predicate (mirrors type_satisfies_trait, traits.rs:118). 0 = Ok,
// 245 = NoImpl, 246 = SignatureMismatch. Caller decides T248 (trait not found) first.
// ET-TR11: the built-in table is {i64,str,bool}x{Hash,Eq} keyed by trait NAME,
// independent of any user redefinition. ET-TR3/13: Ok ONLY for an out-of-core arg
// (TC_UNHANDLED) — a concrete in-core scalar not in the table is NoImpl (T245), never
// a silent allow.
fn tc_type_satisfies(concrete: i64, traits: Vec<TcTrait>, tidx: i64, sigs: Vec<TcSig>, rdefs: Vec<TcRec>) -> i64 ! { Alloc } {
    let tr: TcTrait = traits.get(tidx);
    let tn: str = tr.name;
    let mut hashlike: bool = false;
    if tn.bytes_eq("Hash") {
        hashlike = true;
    } else {
        if tn.bytes_eq("Eq") {
            hashlike = true;
        } else {
        }
    }
    if hashlike {
        if concrete == TC_T_I64 {
            return 0;
        } else {
        }
        if concrete == TC_T_STR {
            return 0;
        } else {
        }
        if concrete == TC_T_BOOL {
            return 0;
        } else {
        }
    } else {
    }
    if concrete == TC_UNHANDLED {
        return 0;
    } else {
    }
    if concrete == TC_NO_EXPECT {
        return 0;
    } else {
    }
    if concrete >= TC_REC_BASE {
        return tc_structural_satisfies(concrete, traits, tidx, sigs, rdefs);
    } else {
    }
    return 245;
}

// PR-6b call-site bound check (mirrors check_bounds, traits.rs:152). For each bound
// in the `;`-joined list: T248 if the trait is not declared (checked FIRST, ET-TR5);
// else T245/T246 per satisfaction. `is_int_lit` marks a bare int-literal arg — the
// oracle does NOT pin it to i64 before the check, so it is unpinned IntLit and never
// satisfies a known trait → T245 (ET-TR18, oracle-faithful).
fn tc_check_bounds_arg(concrete: i64, is_int_lit: bool, boundlist: str, traits: Vec<TcTrait>, sigs: Vec<TcSig>, rdefs: Vec<TcRec>, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let nb: i64 = tc_seg_count(boundlist);
    let mut bi: i64 = 0;
    while bi < nb {
        let bname: str = tc_seg_at(boundlist, bi);
        let bl: i64 = bname.len();
        if bl == 0 {
        } else {
            let tidx: i64 = tc_trait_find(traits, bname);
            if tidx < 0 {
                let d248: i64 = tc_push_diag(diags, "T248");
            } else {
                if is_int_lit {
                    let d245i: i64 = tc_push_diag(diags, "T245");
                } else {
                    let verdict: i64 = tc_type_satisfies(concrete, traits, tidx, sigs, rdefs);
                    if verdict == 245 {
                        let d245: i64 = tc_push_diag(diags, "T245");
                    } else {
                        if verdict == 246 {
                            let d246: i64 = tc_push_diag(diags, "T246");
                        } else {
                        }
                    }
                }
            }
        }
        bi = bi + 1;
    }
    return 0;
}

// Linear membership test over a Vec<str> (no generic Set in hand-written SIGIL).
fn tc_str_vec_contains(v: Vec<str>, s: str) -> bool {
    let n: i64 = v.len();
    let mut i: i64 = 0;
    while i < n {
        let e: str = v.get(i);
        if e.bytes_eq(s) {
            return true;
        } else {
        }
        i = i + 1;
    }
    return false;
}

// PR-6a declaration-time coherence (mirrors validators.rs:92). Per `impl Trait for
// Type` block (P_K_IMPL text = "trait;type"; empty trait = inherent, skipped): the
// trait-in-scope check is FIRST (ET-TR5) — an undeclared trait is T248, never T249/
// T245. A known trait whose implementing type is NOT a local record/enum is an
// orphan (T249); a repeated (trait,type) pair is a coherence violation (T250). The
// (trait,type) seen-set is a Vec<str> of "trait::type" keys (no Set; linear scan).
fn tc_validate_impls(nodes: Arena<PNode>, kids: Vec<i64>, root: i64, traits: Vec<TcTrait>, rdefs: Vec<TcRec>, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let rn: PNode = nodes.get(root);
    let mut seen: Vec<str> = Vec::new();
    let mut i: i64 = 0;
    while i < rn.child_count {
        let cid: i64 = kids.get(rn.child_start + i);
        let cn: PNode = nodes.get(cid);
        if cn.kind == P_K_IMPL {
            let tname: str = tc_seg_at(cn.text, 0);
            let yname: str = tc_seg_at(cn.text, 1);
            let tlen: i64 = tname.len();
            if tlen == 0 {
            } else {
                let tfi: i64 = tc_trait_find(traits, tname);
                if tfi < 0 {
                    let d248: i64 = tc_push_diag(diags, "T248");
                } else {
                    let ycode: i64 = tc_code_of_name(yname, rdefs);
                    if ycode >= TC_REC_BASE {
                        let sep: str = tname.concat("::");
                        let key: str = sep.concat(yname);
                        if tc_str_vec_contains(seen, key) {
                            let d250: i64 = tc_push_diag(diags, "T250");
                        } else {
                            let qk: i64 = seen.push(key);
                        }
                    } else {
                        let d249: i64 = tc_push_diag(diags, "T249");
                    }
                }
            }
        } else {
        }
        i = i + 1;
    }
    return 0;
}

// Emit one function's records — its return-type record then its body's expression
// records (and the T044 missing-return diagnostic). Factored out of tc_emit so it
// serves BOTH a top-level `fn` AND an impl method (a P_K_FN child of P_K_IMPL),
// which the oracle emits into module.functions alike (PR-6a / ET-TR9).
// PR-G0 (ET-G2b): does this fn carry a type-param (a generic source fn/method)? The
// oracle never emits a generic SOURCE fn (mod.rs:683) — only its monomorphized
// instances, which the differential FILTERS — so the SIGIL side emits NO records
// (return + body) for a generic source item; both sides stay empty for it.
fn tc_fn_has_type_params(nodes: Arena<PNode>, kids: Vec<i64>, fnid: i64) -> bool {
    let fnn: PNode = nodes.get(fnid);
    let mut i: i64 = 0;
    while i < fnn.child_count {
        let cid: i64 = kids.get(fnn.child_start + i);
        let cn: PNode = nodes.get(cid);
        if cn.kind == P_K_TYPE_PARAM {
            return true;
        } else {
        }
        i = i + 1;
    }
    return false;
}

fn tc_emit_one_fn(nodes: Arena<PNode>, kids: Vec<i64>, cid: i64, root: i64, sigs: Vec<TcSig>, traits: Vec<TcTrait>, rdefs: Vec<TcRec>, recs: Vec<str> @Mut, diags: Vec<str> @Mut, cdefs: Vec<TcCap>) -> i64 ! { Alloc } {
    let cn: PNode = nodes.get(cid);
    let rtag: i64 = tc_fn_ret_tag(nodes, kids, cid, rdefs);
    let rtid: i64 = tc_fn_ret_typeid(nodes, kids, cid);
    // PR-C1: a cap return type emits a tag-10 record (detail = bare cap name) and walks
    // the body with the cap out-of-core for the return-guarantee/return-match checks. A
    // non-returning cap fn's T044 is a documented out-of-core boundary for C1 — the corpus
    // exercises only correct cap usage, so no false code can fire.
    let mut cap_ret: str = "";
    if rtid >= 0 {
        cap_ret = tc_cap_name_of_typenode(nodes, rtid, rdefs, cdefs);
    } else {
    }
    if cap_ret.len() > 0 {
        let pcapr: i64 = tc_push_rec_detail(recs, cn.start, cn.end, TC_T_CAP, cap_ret);
        let bidc: i64 = tc_fn_body(nodes, kids, cid);
        if bidc >= 0 {
            let mut bindsc: Vec<TcBind> = Vec::new();
            let spc: i64 = tc_seed_params(nodes, kids, cid, bindsc, rdefs, cdefs);
            let scc: i64 = tc_seed_consts(nodes, kids, root, bindsc, rdefs);
            let p2c: i64 = tc_emit_block_exprs(nodes, kids, bidc, bindsc, sigs, traits, rdefs, recs, TC_UNHANDLED, "", diags, cdefs);
        } else {
        }
        return 0;
    } else {
    }
    // PR-5i: the return type's composite detail ("" for scalar/record/unit),
    // computed once — drives the (composite-aware, PR-5e) ret record, the
    // composite return check (threaded as fnret_detail), and the T044 gate.
    let mut fnret_detail: str = "";
    if rtid >= 0 {
        if tc_is_composite_typenode(nodes, rtid) {
            fnret_detail = tc_tmangle(nodes, kids, rtid, rdefs, TC_TYPE_DEPTH_CEILING);
        } else {
        }
    } else {
    }
    if fnret_detail.len() > 0 {
        let rtop: i64 = tc_type_topcode(nodes, kids, rtid, rdefs);
        let p1d: i64 = tc_push_rec_detail(recs, cn.start, cn.end, rtop, fnret_detail);
    } else {
        let p1a: i64 = tc_push_rec(recs, cn.start, cn.end, rtag, rdefs);
    }
    let bid: i64 = tc_fn_body(nodes, kids, cid);
    if bid >= 0 {
        let mut binds: Vec<TcBind> = Vec::new();
        let sp: i64 = tc_seed_params(nodes, kids, cid, binds, rdefs, cdefs);
        let scn: i64 = tc_seed_consts(nodes, kids, root, binds, rdefs);
        let p2: i64 = tc_emit_block_exprs(nodes, kids, bid, binds, sigs, traits, rdefs, recs, rtag, fnret_detail, diags, cdefs);
        // T044: a non-unit function whose body does not return on every path.
        // Non-unit = a concrete non-unit `rtag` (scalar/record) OR a COMPOSITE
        // return — for which `tc_fn_ret_tag` yields TC_T_UNIT (PR-5i), so gate
        // that case on the detail instead.
        let ret_is_composite: bool = fnret_detail.len() > 0;
        let mut fireable: bool = false;
        if tc_is_concrete(rtag) {
            if rtag != TC_T_UNIT {
                fireable = true;
            } else {
            }
        } else {
        }
        if ret_is_composite {
            fireable = true;
        } else {
        }
        if fireable {
            if p2 == 1 {
            } else {
                let d44: i64 = tc_push_diag(diags, "T044");
            }
        } else {
        }
    } else {
    }
    return 0;
}

// Multi-module: the module list this walker iterates. EVERY other gate carries this
// collect step (nr/ec/tt/cap/own — and rc_encode's comment documents WHY: build passes
// walk a node's DIRECT children, so a P_K_PROGRAM root, whose children are modules and
// not decls, must be handled per module). tc was the ONE walker without the arm — on a
// multi-module program it walked the program root's children looking for fns, found
// module nodes instead, and returned EMPTY records/pool/diags. The composed pipeline
// reads empty tc diags as PASS, so a multi-module program type-checked VACUOUSLY.
// Found by the HB-2 mutant suite: `let x: bool = 5;` appended to the certified
// artifact (module tool + the stdlib's string/strings/option modules) sailed through.
fn tc_collect_modules(nodes: Arena<PNode>, kids: Vec<i64>, root: i64, out: Vec<i64> @Mut) -> i64 ! { Alloc } {
    let rn: PNode = nodes.get(root);
    if rn.kind == P_K_PROGRAM {
        let mut i: i64 = 0;
        while i < rn.child_count {
            let cid: i64 = kids.get(rn.child_start + i);
            let pushed: i64 = out.push(cid);
            i = i + 1;
        }
    } else {
        let pushed: i64 = out.push(root);
    }
    return 0;
}

// Per top-level function, emit its return-type record then its body's expression
// records. The record-def table and the signature table are built once up front —
// program-wide unions across modules (the own/ring precedent) — and each build pass is
// called PER MODULE because it walks direct children. Each function's symbol table is
// seeded with its parameters plus its OWN module's consts (cross-module const refs are
// the documented T060 artifact boundary, not a resolved surface).
fn tc_emit(nodes: Arena<PNode>, kids: Vec<i64>, root: i64, recs: Vec<str> @Mut, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let mut mods: Vec<i64> = Vec::new();
    let cmods: i64 = tc_collect_modules(nodes, kids, root, mods);
    let nmod: i64 = mods.len();
    let mut rdefs: Vec<TcRec> = Vec::new();
    // PR-C0: the cap-declaration table (flat Vec<TcCap>, source order), built as a
    // pre-pass alongside rdefs. INERT in C0 — the corpus has zero `cap type` decls, so
    // `cdefs` is empty and no cap record/code is emitted (byte-identical to pre-C0, the
    // PR-G0 pattern). PR-C1 threads `cdefs` to the cap-value typing path (param/return/
    // let) and emits tag-10 records via tc_cap_code_of_name.
    let mut cdefs: Vec<TcCap> = Vec::new();
    let mut b1: i64 = 0;
    while b1 < nmod {
        let m1: i64 = mods.get(b1);
        let br: i64 = tc_build_recs(nodes, kids, m1, rdefs);
        let bc: i64 = tc_build_caps(nodes, kids, m1, cdefs);
        b1 = b1 + 1;
    }
    // sigs need the COMPLETE rdefs/cdefs union, so a second pass.
    let mut sigs: Vec<TcSig> = Vec::new();
    let mut b2: i64 = 0;
    while b2 < nmod {
        let m2: i64 = mods.get(b2);
        let bs: i64 = tc_build_sigs(nodes, kids, m2, sigs, rdefs, cdefs);
        b2 = b2 + 1;
    }
    // The trait table (names + sorted method contracts) — used by the decl-time
    // coherence pass (T248/T249/T250, ET-TR4/5) AND call-site bound satisfaction.
    let mut traits: Vec<TcTrait> = Vec::new();
    let mut b3: i64 = 0;
    while b3 < nmod {
        let m3: i64 = mods.get(b3);
        let btt: i64 = tc_build_traits(nodes, kids, m3, traits, rdefs);
        b3 = b3 + 1;
    }
    let mut b4: i64 = 0;
    while b4 < nmod {
        let m4: i64 = mods.get(b4);
        let vci: i64 = tc_validate_impls(nodes, kids, m4, traits, rdefs, diags);
        b4 = b4 + 1;
    }
    let mut emitted: i64 = 0;
    let mut mw: i64 = 0;
    while mw < nmod {
        let mroot: i64 = mods.get(mw);
        let e0: i64 = tc_emit_module(nodes, kids, mroot, sigs, traits, rdefs, cdefs, recs, diags);
        emitted = emitted + e0;
        mw = mw + 1;
    }
    return emitted;
}

// One module's fn/impl walk — the body of the old single-module tc_emit loop, with the
// enclosing MODULE as the const-seed root for its fns.
fn tc_emit_module(nodes: Arena<PNode>, kids: Vec<i64>, root: i64, sigs: Vec<TcSig>, traits: Vec<TcTrait>, rdefs: Vec<TcRec>, cdefs: Vec<TcCap>, recs: Vec<str> @Mut, diags: Vec<str> @Mut) -> i64 ! { Alloc } {
    let rn: PNode = nodes.get(root);
    let mut emitted: i64 = 0;
    let mut i: i64 = 0;
    while i < rn.child_count {
        let cid: i64 = kids.get(rn.child_start + i);
        let cn: PNode = nodes.get(cid);
        if cn.kind == P_K_FN {
            // PR-G0: a generic source fn emits NOTHING (its instances are filtered on
            // the oracle side — ET-G2b). A concrete fn is walked as before.
            if tc_fn_has_type_params(nodes, kids, cid) {
            } else {
                let e1: i64 = tc_emit_one_fn(nodes, kids, cid, root, sigs, traits, rdefs, recs, diags, cdefs);
                emitted = emitted + 1;
            }
        } else {
        }
        // PR-6a (ET-TR9): a non-generic impl's method bodies ARE emitted into the
        // oracle's module.functions, so walk each P_K_FN method child as a function
        // (return record + body) for record parity. Trait/trait-sig nodes yield no
        // TypedFunction and stay record-free (they fall through with no handler).
        if cn.kind == P_K_IMPL {
            // PR-G3b: a GENERIC-TARGET impl (impl Box<T> — the impl node itself carries
            // P_K_TYPE_PARAM children) emits NO method-body records. The oracle emits one
            // monomorphized instance per concrete type (Box__get__i64), each reusing the
            // method's source span — the differential FILTERS those (gspans now includes
            // generic-impl-method spans), so the SIGIL side must stay empty for them too
            // (ET-G2b). A concrete impl (impl P) is walked as before (PR-6a / PR-G3a).
            let impl_generic: bool = tc_fn_has_type_params(nodes, kids, cid);
            let mut mi: i64 = 0;
            while mi < cn.child_count {
                let mcid: i64 = kids.get(cn.child_start + mi);
                let mcn: PNode = nodes.get(mcid);
                if mcn.kind == P_K_FN {
                    if impl_generic {
                    } else {
                        // PR-G0: a method-level type-param (T235) likewise emits nothing —
                        // its instances are filtered. Only a fully-concrete method is walked.
                        if tc_fn_has_type_params(nodes, kids, mcid) {
                        } else {
                            let e2: i64 = tc_emit_one_fn(nodes, kids, mcid, root, sigs, traits, rdefs, recs, diags, cdefs);
                            emitted = emitted + 1;
                        }
                    }
                } else {
                }
                mi = mi + 1;
            }
        } else {
        }
        i = i + 1;
    }
    return emitted;
}

// Encode the type-check result for transfer to the differential harness, in the
// shape `records|pool|diags` — records joined, `|`, the (empty) pool, `|`, then
// the diagnostics section (PR-5a): each emitted core-owned T-code as `Txxx;`,
// compared by the harness as a sorted SET against the oracle's diagnostics (ET-T3
// exact-code parity). Record names are carried inline in each record, not the pool.
pub fn tc_encode(nodes: Arena<PNode>, kids: Vec<i64>, root: i64) -> str ! { Alloc } {
    let mut recs: Vec<str> = Vec::new();
    let pool: Vec<str> = Vec::new();
    let mut diags: Vec<str> = Vec::new();
    let emitted: i64 = tc_emit(nodes, kids, root, recs, diags);
    let empty: str = "";
    let recj: str = empty.join(recs);
    let poolj: str = empty.join(pool);
    let diagj: str = empty.join(diags);
    let withbar: str = recj.concat("|");
    let withpool: str = withbar.concat(poolj);
    let withbar2: str = withpool.concat("|");
    let full: str = withbar2.concat(diagj);
    return full;
}
