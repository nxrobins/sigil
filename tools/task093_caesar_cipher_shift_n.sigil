// TASK: caesar cipher shift n — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

fn normalize_shift(shift_in: i64) -> i64 {
    let mut shift = shift_in;

    while shift < 0 {
        shift = shift + 26;
    }

    while shift >= 26 {
        shift = shift - 26;
    }

    return shift;
}

fn shift_letter(b: i64, shift: i64) -> i64 {
    if b >= 97 {
        if b <= 122 {
            let offset = b - 97;
            let mut value = offset + shift;
            while value >= 26 {
                value = value - 26;
            }
            return 97 + value;
        } else {
        }
    } else {
    }

    if b >= 65 {
        if b <= 90 {
            let offset = b - 65;
            let mut value = offset + shift;
            while value >= 26 {
                value = value - 26;
            }
            return 65 + value;
        } else {
        }
    } else {
    }

    return b;
}

pub fn tool_main(input_ptr: i64, input_len: i64) -> i64 ! { Alloc } {
    let zero = input_len - input_len;
    let one = input_len / input_len;
    let mut split = input_len;
    let mut scan = input_len;

    while scan > zero {
        let b = load8(input_ptr + scan - one);
        if split == input_len {
            if b == 58 {
                split = scan - one;
            } else {
            }
        } else {
        }
        scan = scan - one;
    }

    if split == input_len {
        return 0 - 400;
    } else {
        let mut sign = 1;
        let mut shift = 0;
        let mut saw_digit = 0;
        let mut shift_scan = split + one;

        while shift_scan < input_len {
            let b = load8(input_ptr + shift_scan);
            if b == 45 {
                sign = 0 - 1;
            } else {
                if b >= 48 {
                    if b <= 57 {
                        shift = shift * 10 + b - 48;
                        saw_digit = 1;
                    } else {
                    }
                } else {
                }
            }
            shift_scan = shift_scan + one;
        }

        if saw_digit == 1 {
        } else {
            return 0 - 400;
        }

        shift = normalize_shift(shift * sign);

        let out_ptr = alloc(split);
        let mut i = 0;

        while i < split {
            let b = load8(input_ptr + i);
            store8(out_ptr + i, shift_letter(b, shift));
            i = i + 1;
        }

        return out_ptr * 4294967296 + split;
    }
}
