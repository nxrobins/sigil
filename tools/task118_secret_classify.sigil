// TASK: secret classify — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

fn render_decimal(n_in: i64 @Secret) -> i64 @Secret ! { Alloc } {
    if n_in == 0 {
        let out: i64 @Secret = alloc(1);
        store8(out, 48);
        return out * 4294967296 + 1;
    } else {
        let scratch: i64 @Secret = alloc(20);
        let mut digits: i64 @Secret = 0;
        let mut n: i64 @Secret = n_in;
        while n > 0 {
            let q: i64 @Secret = n / 10;
            let d: i64 @Secret = n - q * 10;
            store8(scratch + digits, 48 + d);
            digits = digits + 1;
            n = q;
        }
        let out: i64 @Secret = alloc(digits);
        let mut i: i64 @Secret = 0;
        while i < digits {
            let b: i64 @Secret = load8(scratch + digits - 1 - i);
            store8(out + i, b);
            i = i + 1;
        }
        return out * 4294967296 + digits;
    }
}

// Accept @Secret input, classify bytes, return "upper:N,lower:N,digit:N,other:N".
pub fn tool_main(input_ptr: i64 @Secret, input_len: i64 @Secret) -> i64 @Secret ! { Alloc } {
    let mut upper: i64 @Secret = 0;
    let mut lower: i64 @Secret = 0;
    let mut digit: i64 @Secret = 0;
    let mut other: i64 @Secret = 0;
    let mut i: i64 @Secret = 0;
    while i < input_len {
        let b: i64 @Secret = load8(input_ptr + i);
        let mut matched: i64 @Secret = 0;
        if b > 64 {
            if b < 91 {
                upper = upper + 1;
                matched = 1;
            } else {
            }
        } else {
        }
        if b > 96 {
            if b < 123 {
                lower = lower + 1;
                matched = 1;
            } else {
            }
        } else {
        }
        if b > 47 {
            if b < 58 {
                digit = digit + 1;
                matched = 1;
            } else {
            }
        } else {
        }
        if matched == 0 {
            other = other + 1;
        } else {
        }
        i = i + 1;
    }

    let out: i64 @Secret = alloc(128);
    let mut n: i64 @Secret = 0;

    // upper:N
    store8(out + n, 117); n = n + 1;
    store8(out + n, 112); n = n + 1;
    store8(out + n, 112); n = n + 1;
    store8(out + n, 101); n = n + 1;
    store8(out + n, 114); n = n + 1;
    store8(out + n, 58); n = n + 1;
    let a: i64 @Secret = render_decimal(upper);
    let ap: i64 @Secret = a / 4294967296;
    let al: i64 @Secret = a - ap * 4294967296;
    let mut m: i64 @Secret = 0;
    while m < al {
        store8(out + n, load8(ap + m));
        n = n + 1;
        m = m + 1;
    }

    store8(out + n, 44); n = n + 1;
    store8(out + n, 108); n = n + 1;
    store8(out + n, 111); n = n + 1;
    store8(out + n, 119); n = n + 1;
    store8(out + n, 101); n = n + 1;
    store8(out + n, 114); n = n + 1;
    store8(out + n, 58); n = n + 1;
    let b2: i64 @Secret = render_decimal(lower);
    let bp: i64 @Secret = b2 / 4294967296;
    let bl: i64 @Secret = b2 - bp * 4294967296;
    let mut m2: i64 @Secret = 0;
    while m2 < bl {
        store8(out + n, load8(bp + m2));
        n = n + 1;
        m2 = m2 + 1;
    }

    store8(out + n, 44); n = n + 1;
    store8(out + n, 100); n = n + 1;
    store8(out + n, 105); n = n + 1;
    store8(out + n, 103); n = n + 1;
    store8(out + n, 105); n = n + 1;
    store8(out + n, 116); n = n + 1;
    store8(out + n, 58); n = n + 1;
    let c2: i64 @Secret = render_decimal(digit);
    let cp: i64 @Secret = c2 / 4294967296;
    let cl: i64 @Secret = c2 - cp * 4294967296;
    let mut m3: i64 @Secret = 0;
    while m3 < cl {
        store8(out + n, load8(cp + m3));
        n = n + 1;
        m3 = m3 + 1;
    }

    store8(out + n, 44); n = n + 1;
    store8(out + n, 111); n = n + 1;
    store8(out + n, 116); n = n + 1;
    store8(out + n, 104); n = n + 1;
    store8(out + n, 101); n = n + 1;
    store8(out + n, 114); n = n + 1;
    store8(out + n, 58); n = n + 1;
    let d2: i64 @Secret = render_decimal(other);
    let dp: i64 @Secret = d2 / 4294967296;
    let dl: i64 @Secret = d2 - dp * 4294967296;
    let mut m4: i64 @Secret = 0;
    while m4 < dl {
        store8(out + n, load8(dp + m4));
        n = n + 1;
        m4 = m4 + 1;
    }

    return out * 4294967296 + n;
}
