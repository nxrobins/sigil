// TASK: fetch url search — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i32) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { NetIO, Alloc, FFI, Unsafe }

#[ring(outer)] #[trusted] module tool;

extern "C" fn http_get(url: i32, url_len: i32) -> i64 ! { FFI, Unsafe };

fn render_bool(value: i64 @Internal) -> i64 @Internal ! { Alloc } {
    if value == 1 {
        let out_ptr: i64 @Internal = alloc(4);
        store8(out_ptr, 116);
        store8(out_ptr + 1, 114);
        store8(out_ptr + 2, 117);
        store8(out_ptr + 3, 101);
        return out_ptr * 4294967296 + 4;
    } else {
        let out_ptr: i64 @Internal = alloc(5);
        store8(out_ptr, 102);
        store8(out_ptr + 1, 97);
        store8(out_ptr + 2, 108);
        store8(out_ptr + 3, 115);
        store8(out_ptr + 4, 101);
        return out_ptr * 4294967296 + 5;
    }
}

pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { NetIO, Alloc, FFI, Unsafe } {
    let zero = input_len - input_len;
    let one = input_len / input_len;
    let mut split = input_len;
    let mut scan = input_len;

    while scan > zero {
        let b = load8(input_ptr + scan - one);
        if split == input_len {
            if b == 58 {
                split = scan - one;
            } else {
            }
        } else {
        }
        scan = scan - one;
    }

    if split == input_len {
        return 0 - 400;
    } else {
        let raw: i64 @Internal = http_get(input_ptr, split);

        if raw < 0 {
            return raw;
        } else {
            let pat_src: i32 @Internal = input_ptr + split + one;
            let mut pat_scan: i32 @Internal = pat_src;
            let mut pat_len: i64 @Internal = 0;

            while pat_scan < input_ptr + input_len {
                pat_len = pat_len + 1;
                pat_scan = pat_scan + one;
            }

            if pat_len == 0 {
                return 0 - 400;
            } else {
                let pat_ptr: i64 @Internal = alloc(pat_len);
                let mut pat_copy_scan: i32 @Internal = pat_src;
                let mut pat_copy_len: i64 @Internal = 0;

                while pat_copy_scan < input_ptr + input_len {
                    let b: i64 @Internal = load8(pat_copy_scan);
                    store8(pat_ptr + pat_copy_len, b);
                    pat_copy_len = pat_copy_len + 1;
                    pat_copy_scan = pat_copy_scan + one;
                }

                let body_ptr: i64 @Internal = raw / 4294967296;
                let body_len: i64 @Internal = raw - body_ptr * 4294967296;
                let mut found: i64 @Internal = 0;
                let mut i: i64 @Internal = 0;

                while i < body_len {
                    if found == 0 {
                        if body_len - i >= pat_len {
                            let mut same: i64 @Internal = 1;
                            let mut j: i64 @Internal = 0;

                            while j < pat_len {
                                if same == 1 {
                                    let a: i64 @Internal = load8(body_ptr + i + j);
                                    let b: i64 @Internal = load8(pat_ptr + j);
                                    if a == b {
                                    } else {
                                        same = 0;
                                    }
                                } else {
                                }
                                j = j + 1;
                            }

                            if same == 1 {
                                found = 1;
                            } else {
                            }
                        } else {
                        }
                    } else {
                    }
                    i = i + 1;
                }

                return render_bool(found);
            }
        }
    }
}
