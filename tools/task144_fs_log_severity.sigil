// TASK: fs log severity — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i32) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { FsIO, Alloc, FFI, Unsafe }

#[ring(outer)] #[trusted] module tool;

extern "C" fn fs_read(path: i32, path_len: i32) -> i64 ! { FFI, Unsafe };

fn render_decimal(n_in: i64 @Internal) -> i64 @Internal ! { Alloc } {
    if n_in == 0 {
        let out: i64 @Internal = alloc(1);
        store8(out, 48);
        return out * 4294967296 + 1;
    } else {
        let scratch: i64 @Internal = alloc(20);
        let mut digits: i64 @Internal = 0;
        let mut n: i64 @Internal = n_in;
        while n > 0 {
            let q: i64 @Internal = n / 10;
            let d: i64 @Internal = n - q * 10;
            store8(scratch + digits, 48 + d);
            digits = digits + 1;
            n = q;
        }
        let out: i64 @Internal = alloc(digits);
        let mut i: i64 @Internal = 0;
        while i < digits {
            let b: i64 @Internal = load8(scratch + digits - 1 - i);
            store8(out + i, b);
            i = i + 1;
        }
        return out * 4294967296 + digits;
    }
}

// Read log file, count INFO/ERROR/WARN severity entries. Return "INFO:N,ERROR:N,WARN:N".
pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { FsIO, Alloc, FFI, Unsafe } {
    let raw: i64 @Internal = fs_read(input_ptr, input_len);
    if raw < 0 {
        return raw;
    } else {
    }
    let file_ptr: i64 @Internal = raw / 4294967296;
    let file_len: i64 @Internal = raw - file_ptr * 4294967296;

    let mut info_cnt: i64 @Internal = 0;
    let mut err_cnt: i64 @Internal = 0;
    let mut warn_cnt: i64 @Internal = 0;

    let mut line_start: i64 @Internal = 0;
    let mut i: i64 @Internal = 0;
    while i <= file_len {
        let mut eol: i64 @Internal = 0;
        if i == file_len {
            eol = 1;
        } else {
            let b: i64 @Internal = load8(file_ptr + i);
            if b == 10 {
                eol = 1;
            } else {
            }
        }
        if eol == 1 {
            let ln: i64 @Internal = i - line_start;
            if ln >= 4 {
                let c0: i64 @Internal = load8(file_ptr + line_start);
                let c1: i64 @Internal = load8(file_ptr + line_start + 1);
                let c2: i64 @Internal = load8(file_ptr + line_start + 2);
                let c3: i64 @Internal = load8(file_ptr + line_start + 3);
                if c0 == 73 {
                    if c1 == 78 {
                        if c2 == 70 {
                            if c3 == 79 {
                                info_cnt = info_cnt + 1;
                            } else {
                            }
                        } else {
                        }
                    } else {
                    }
                } else {
                }
                if ln >= 5 {
                    let c4: i64 @Internal = load8(file_ptr + line_start + 4);
                    if c0 == 69 {
                        if c1 == 82 {
                            if c2 == 82 {
                                if c3 == 79 {
                                    if c4 == 82 {
                                        err_cnt = err_cnt + 1;
                                    } else {
                                    }
                                } else {
                                }
                            } else {
                            }
                        } else {
                        }
                    } else {
                    }
                } else {
                }
                if c0 == 87 {
                    if c1 == 65 {
                        if c2 == 82 {
                            if c3 == 78 {
                                warn_cnt = warn_cnt + 1;
                            } else {
                            }
                        } else {
                        }
                    } else {
                    }
                } else {
                }
            } else {
            }
            line_start = i + 1;
        } else {
        }
        i = i + 1;
    }

    let out: i64 @Internal = alloc(64);
    let mut n: i64 @Internal = 0;
    // "INFO:N"
    store8(out + n, 73); n = n + 1;
    store8(out + n, 78); n = n + 1;
    store8(out + n, 70); n = n + 1;
    store8(out + n, 79); n = n + 1;
    store8(out + n, 58); n = n + 1;
    let ip: i64 @Internal = render_decimal(info_cnt);
    let ip_p: i64 @Internal = ip / 4294967296;
    let ip_l: i64 @Internal = ip - ip_p * 4294967296;
    let mut m: i64 @Internal = 0;
    while m < ip_l {
        store8(out + n, load8(ip_p + m));
        n = n + 1;
        m = m + 1;
    }
    store8(out + n, 44); n = n + 1;
    // "ERROR:N"
    store8(out + n, 69); n = n + 1;
    store8(out + n, 82); n = n + 1;
    store8(out + n, 82); n = n + 1;
    store8(out + n, 79); n = n + 1;
    store8(out + n, 82); n = n + 1;
    store8(out + n, 58); n = n + 1;
    let ep: i64 @Internal = render_decimal(err_cnt);
    let ep_p: i64 @Internal = ep / 4294967296;
    let ep_l: i64 @Internal = ep - ep_p * 4294967296;
    let mut m2: i64 @Internal = 0;
    while m2 < ep_l {
        store8(out + n, load8(ep_p + m2));
        n = n + 1;
        m2 = m2 + 1;
    }
    store8(out + n, 44); n = n + 1;
    // "WARN:N"
    store8(out + n, 87); n = n + 1;
    store8(out + n, 65); n = n + 1;
    store8(out + n, 82); n = n + 1;
    store8(out + n, 78); n = n + 1;
    store8(out + n, 58); n = n + 1;
    let wp: i64 @Internal = render_decimal(warn_cnt);
    let wp_p: i64 @Internal = wp / 4294967296;
    let wp_l: i64 @Internal = wp - wp_p * 4294967296;
    let mut m3: i64 @Internal = 0;
    while m3 < wp_l {
        store8(out + n, load8(wp_p + m3));
        n = n + 1;
        m3 = m3 + 1;
    }
    return out * 4294967296 + n;
}
