// TASK: secret rot13 — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

// ROT13 a @Secret input, return @Secret result.
pub fn tool_main(input_ptr: i64 @Secret, input_len: i64 @Secret) -> i64 @Secret ! { Alloc } {
    let out: i64 @Secret = alloc(input_len);
    let mut i: i64 @Secret = 0;
    while i < input_len {
        let b: i64 @Secret = load8(input_ptr + i);
        let mut r: i64 @Secret = b;
        if b > 64 {
            if b < 91 {
                // uppercase
                let shifted: i64 @Secret = b + 13;
                if shifted > 90 {
                    r = shifted - 26;
                } else {
                    r = shifted;
                }
            } else {
            }
        } else {
        }
        if b > 96 {
            if b < 123 {
                let shifted2: i64 @Secret = b + 13;
                if shifted2 > 122 {
                    r = shifted2 - 26;
                } else {
                    r = shifted2;
                }
            } else {
            }
        } else {
        }
        store8(out + i, r);
        i = i + 1;
    }
    return out * 4294967296 + input_len;
}
