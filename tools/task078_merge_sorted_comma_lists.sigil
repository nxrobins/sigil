// TASK: merge sorted comma lists — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

fn write_u32(ptr: i64, value: i64) -> i64 {
    let q0 = value / 256;
    let b0 = value - q0 * 256;
    let q1 = q0 / 256;
    let b1 = q0 - q1 * 256;
    let q2 = q1 / 256;
    let b2 = q1 - q2 * 256;
    let q3 = q2 / 256;
    let b3 = q2 - q3 * 256;

    store8(ptr, b0);
    store8(ptr + 1, b1);
    store8(ptr + 2, b2);
    store8(ptr + 3, b3);
    return 0;
}

fn read_u32(ptr: i64) -> i64 {
    let b0 = load8(ptr);
    let b1 = load8(ptr + 1);
    let b2 = load8(ptr + 2);
    let b3 = load8(ptr + 3);
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
}

fn append_segment(out_ptr: i64, out_len_in: i64, src_ptr: i64, start: i64, end: i64) -> i64 {
    let mut out_len = out_len_in;
    let mut i = start;

    while i < end {
        let b = load8(src_ptr + i);
        store8(out_ptr + out_len, b);
        out_len = out_len + 1;
        i = i + 1;
    }

    return out_len;
}

fn token_compare(
    src_ptr: i64,
    a_start: i64,
    a_end: i64,
    b_start: i64,
    b_end: i64,
) -> i64 {
    let mut a = a_start;
    let mut b = b_start;
    let mut result = 0;
    let mut done = 0;

    while a < a_end {
        if b < b_end {
            if done == 0 {
                let ba = load8(src_ptr + a);
                let bb = load8(src_ptr + b);
                if ba < bb {
                    result = 0 - 1;
                    done = 1;
                } else {
                    if ba > bb {
                        result = 1;
                        done = 1;
                    } else {
                    }
                }
            } else {
            }
            a = a + 1;
            b = b + 1;
        } else {
            if done == 0 {
                result = 1;
                done = 1;
            } else {
            }
            a = a_end;
        }
    }

    if done == 0 {
        if b < b_end {
            result = 0 - 1;
        } else {
            result = 0;
        }
    } else {
    }

    return result;
}

pub fn tool_main(input_ptr: i64, input_len: i64) -> i64 ! { Alloc } {
    if input_len == 0 {
        let out_ptr = alloc(0);
        return out_ptr * 4294967296;
    } else {
        let mut token_count = 0;
        let mut in_token = 0;
        let mut i = 0;

        while i < input_len {
            let b = load8(input_ptr + i);
            if b == 44 {
                in_token = 0;
            } else {
                if b == 10 {
                    in_token = 0;
                } else {
                    if in_token == 0 {
                        token_count = token_count + 1;
                        in_token = 1;
                    } else {
                    }
                }
            }
            i = i + 1;
        }

        let meta_ptr = alloc(token_count * 8);
        let mut token_start = 0;
        let mut token_index = 0;
        in_token = 0;
        i = 0;

        while i < input_len {
            let b = load8(input_ptr + i);
            if b == 44 {
                if in_token == 1 {
                    let slot = meta_ptr + token_index * 8;
                    write_u32(slot, token_start);
                    write_u32(slot + 4, i);
                    token_index = token_index + 1;
                    in_token = 0;
                } else {
                }
            } else {
                if b == 10 {
                    if in_token == 1 {
                        let slot = meta_ptr + token_index * 8;
                        write_u32(slot, token_start);
                        write_u32(slot + 4, i);
                        token_index = token_index + 1;
                        in_token = 0;
                    } else {
                    }
                } else {
                    if in_token == 0 {
                        token_start = i;
                        in_token = 1;
                    } else {
                    }
                }
            }
            i = i + 1;
        }

        if in_token == 1 {
            let slot = meta_ptr + token_index * 8;
            write_u32(slot, token_start);
            write_u32(slot + 4, input_len);
        } else {
        }

        let selected_ptr = alloc(token_count);
        i = 0;
        while i < token_count {
            store8(selected_ptr + i, 0);
            i = i + 1;
        }

        let out_ptr = alloc(input_len);
        let mut out_len = 0;
        let mut out_count = 0;

        while out_count < token_count {
            let mut best_index = token_count;
            let mut best_start = 0;
            let mut best_end = 0;
            let mut idx = 0;

            while idx < token_count {
                let sel = load8(selected_ptr + idx);
                if sel == 0 {
                    let slot = meta_ptr + idx * 8;
                    let cur_start = read_u32(slot);
                    let cur_end = read_u32(slot + 4);
                    if best_index == token_count {
                        best_index = idx;
                        best_start = cur_start;
                        best_end = cur_end;
                    } else {
                        let cmp = token_compare(input_ptr, cur_start, cur_end, best_start, best_end);
                        if cmp < 0 {
                            best_index = idx;
                            best_start = cur_start;
                            best_end = cur_end;
                        } else {
                        }
                    }
                } else {
                }
                idx = idx + 1;
            }

            if out_count > 0 {
                store8(out_ptr + out_len, 44);
                out_len = out_len + 1;
            } else {
            }
            out_len = append_segment(out_ptr, out_len, input_ptr, best_start, best_end);
            store8(selected_ptr + best_index, 1);
            out_count = out_count + 1;
        }

        return out_ptr * 4294967296 + out_len;
    }
}
