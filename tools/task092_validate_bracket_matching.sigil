// TASK: validate bracket matching — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

fn render_bool(value: i64) -> i64 {
    if value == 1 {
        let out_ptr = alloc(4);
        store8(out_ptr, 116);
        store8(out_ptr + 1, 114);
        store8(out_ptr + 2, 117);
        store8(out_ptr + 3, 101);
        return out_ptr * 4294967296 + 4;
    } else {
        let out_ptr = alloc(5);
        store8(out_ptr, 102);
        store8(out_ptr + 1, 97);
        store8(out_ptr + 2, 108);
        store8(out_ptr + 3, 115);
        store8(out_ptr + 4, 101);
        return out_ptr * 4294967296 + 5;
    }
}

pub fn tool_main(input_ptr: i64, input_len: i64) -> i64 ! { Alloc } {
    let stack_ptr = alloc(input_len);
    let mut depth = 0;
    let mut valid = 1;
    let mut i = 0;

    while i < input_len {
        if valid == 1 {
            let b = load8(input_ptr + i);

            if b == 40 {
                store8(stack_ptr + depth, 40);
                depth = depth + 1;
            } else {
                if b == 91 {
                    store8(stack_ptr + depth, 91);
                    depth = depth + 1;
                } else {
                    if b == 123 {
                        store8(stack_ptr + depth, 123);
                        depth = depth + 1;
                    } else {
                        if b == 41 {
                            if depth > 0 {
                                let top = load8(stack_ptr + depth - 1);
                                if top == 40 {
                                    depth = depth - 1;
                                } else {
                                    valid = 0;
                                }
                            } else {
                                valid = 0;
                            }
                        } else {
                            if b == 93 {
                                if depth > 0 {
                                    let top = load8(stack_ptr + depth - 1);
                                    if top == 91 {
                                        depth = depth - 1;
                                    } else {
                                        valid = 0;
                                    }
                                } else {
                                    valid = 0;
                                }
                            } else {
                                if b == 125 {
                                    if depth > 0 {
                                        let top = load8(stack_ptr + depth - 1);
                                        if top == 123 {
                                            depth = depth - 1;
                                        } else {
                                            valid = 0;
                                        }
                                    } else {
                                        valid = 0;
                                    }
                                } else {
                                }
                            }
                        }
                    }
                }
            }
        } else {
        }

        i = i + 1;
    }

    if depth == 0 {
    } else {
        valid = 0;
    }

    return render_bool(valid);
}
