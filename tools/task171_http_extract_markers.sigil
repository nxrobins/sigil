// TASK: http extract markers — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i32) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { NetIO, Alloc, FFI, Unsafe }

#[ring(outer)] #[trusted] module tool;

extern "C" fn http_get(url: i32, url_len: i32) -> i64 ! { FFI, Unsafe };

// Input "url:START:END". Fetch URL, extract lines strictly between markers.
pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { NetIO, Alloc, FFI, Unsafe } {
    let zero_i32: i32 = input_len - input_len;
    let one_i32: i32 = input_len / input_len;
    let two_i32: i32 = one_i32 + one_i32;
    let three_i32: i32 = two_i32 + one_i32;

    // Skip past "://" so we don't pick the scheme's colon.
    let mut scheme_end: i32 = zero_i32;
    let mut ss: i32 = zero_i32;
    let mut stop_scheme: i32 = zero_i32;
    while ss < input_len {
        if stop_scheme == zero_i32 {
            let ss1: i32 @Internal = ss + one_i32;
            let ss2: i32 @Internal = ss + two_i32;
            if ss2 < input_len {
                let c0: i64 @Internal = load8(input_ptr + ss);
                let c1: i64 @Internal = load8(input_ptr + ss1);
                let c2: i64 @Internal = load8(input_ptr + ss2);
                if c0 == 58 {
                    if c1 == 47 {
                        if c2 == 47 {
                            scheme_end = ss + three_i32;
                            stop_scheme = one_i32;
                        } else {
                        }
                    } else {
                    }
                } else {
                }
            } else {
            }
        } else {
        }
        ss = ss + one_i32;
    }

    // Find first ':' after scheme_end (last1), then next ':' after that (last2)
    let mut last1: i32 @Internal = input_len;
    let mut last2: i32 @Internal = input_len;
    let mut scan: i32 @Internal = scheme_end;
    while scan < input_len {
        let b: i64 @Internal = load8(input_ptr + scan);
        if b == 58 {
            if last1 == input_len {
                last1 = scan;
            } else {
                if last2 == input_len {
                    last2 = scan;
                } else {
                }
            }
        } else {
        }
        scan = scan + one_i32;
    }
    if last1 == input_len {
        return 0 - 400;
    } else {
    }
    if last2 == input_len {
        return 0 - 400;
    } else {
    }

    let raw: i64 @Internal = http_get(input_ptr, last1);
    if raw < 0 {
        return raw;
    } else {
    }
    let body_ptr: i64 @Internal = raw / 4294967296;
    let body_len: i64 @Internal = raw - body_ptr * 4294967296;

    let start_off: i32 @Internal = last1 + one_i32;
    let start_len_i32: i32 @Internal = last2 - start_off;
    let end_off: i32 @Internal = last2 + one_i32;
    let end_len_i32: i32 @Internal = input_len - end_off;

    let mut start_len: i64 @Internal = 0;
    let mut c1: i32 @Internal = zero_i32;
    while c1 < start_len_i32 {
        start_len = start_len + 1;
        c1 = c1 + one_i32;
    }
    let mut end_len: i64 @Internal = 0;
    let mut c2: i32 @Internal = zero_i32;
    while c2 < end_len_i32 {
        end_len = end_len + 1;
        c2 = c2 + one_i32;
    }

    let out: i64 @Internal = alloc(body_len);
    let mut out_len: i64 @Internal = 0;
    let mut in_region: i64 @Internal = 0;

    let mut line_start: i64 @Internal = 0;
    let mut i: i64 @Internal = 0;
    while i <= body_len {
        let mut eol: i64 @Internal = 0;
        if i == body_len {
            eol = 1;
        } else {
            let b: i64 @Internal = load8(body_ptr + i);
            if b == 10 {
                eol = 1;
            } else {
            }
        }
        if eol == 1 {
            let ln: i64 @Internal = i - line_start;
            let mut is_start: i64 @Internal = 0;
            if ln == start_len {
                is_start = 1;
                let mut k: i64 @Internal = 0;
                let mut k32: i32 @Internal = zero_i32;
                while k < start_len {
                    let fb: i64 @Internal = load8(body_ptr + line_start + k);
                    let ib: i64 @Internal = load8(input_ptr + start_off + k32);
                    if fb == ib {
                    } else {
                        is_start = 0;
                    }
                    k = k + 1;
                    k32 = k32 + one_i32;
                }
            } else {
            }
            let mut is_end: i64 @Internal = 0;
            if ln == end_len {
                is_end = 1;
                let mut k3: i64 @Internal = 0;
                let mut k332: i32 @Internal = zero_i32;
                while k3 < end_len {
                    let fb2: i64 @Internal = load8(body_ptr + line_start + k3);
                    let ib2: i64 @Internal = load8(input_ptr + end_off + k332);
                    if fb2 == ib2 {
                    } else {
                        is_end = 0;
                    }
                    k3 = k3 + 1;
                    k332 = k332 + one_i32;
                }
            } else {
            }
            if is_start == 1 {
                in_region = 1;
            } else {
                if is_end == 1 {
                    in_region = 0;
                } else {
                    if in_region == 1 {
                        let mut m: i64 @Internal = line_start;
                        while m < i {
                            let mb: i64 @Internal = load8(body_ptr + m);
                            store8(out + out_len, mb);
                            out_len = out_len + 1;
                            m = m + 1;
                        }
                        store8(out + out_len, 10);
                        out_len = out_len + 1;
                    } else {
                    }
                }
            }
            line_start = i + 1;
        } else {
        }
        i = i + 1;
    }
    return out * 4294967296 + out_len;
}
