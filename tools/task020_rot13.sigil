// TASK: rot13 — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

fn rot13_byte(b: i64) -> i64 {
    if b >= 65 {
        if b <= 90 {
            if b < 78 {
                return b + 13;
            } else {
                return b - 13;
            }
        } else {
            if b >= 97 {
                if b <= 122 {
                    if b < 110 {
                        return b + 13;
                    } else {
                        return b - 13;
                    }
                } else {
                    return b;
                }
            } else {
                return b;
            }
        }
    } else {
        if b >= 97 {
            if b <= 122 {
                if b < 110 {
                    return b + 13;
                } else {
                    return b - 13;
                }
            } else {
                return b;
            }
        } else {
            return b;
        }
    }
}

pub fn tool_main(input_ptr: i64, input_len: i64) -> i64 ! { Alloc } {
    let out_ptr = alloc(input_len);
    let mut i = 0;

    while i < input_len {
        let b = load8(input_ptr + i);
        store8(out_ptr + i, rot13_byte(b));
        i = i + 1;
    }

    return out_ptr * 4294967296 + input_len;
}
