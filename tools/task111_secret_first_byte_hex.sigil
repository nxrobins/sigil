// TASK: secret first byte hex — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

// Accept @Secret input, return first byte as hex (2 chars), as @Secret.
fn hex_digit(n: i64 @Secret) -> i64 @Secret ! {} {
    if n < 10 {
        return 48 + n;
    } else {
        return 87 + n;
    }
}

pub fn tool_main(input_ptr: i64 @Secret, input_len: i64 @Secret) -> i64 @Secret ! { Alloc } {
    if input_len == 0 {
        let out: i64 @Secret = alloc(2);
        store8(out, 48);
        store8(out + 1, 48);
        return out * 4294967296 + 2;
    } else {
    }
    let b: i64 @Secret = load8(input_ptr);
    let hi: i64 @Secret = b / 16;
    let lo: i64 @Secret = b - hi * 16;
    let out: i64 @Secret = alloc(2);
    store8(out, hex_digit(hi));
    store8(out + 1, hex_digit(lo));
    return out * 4294967296 + 2;
}
