// TASK: fs csv col count — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i32) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { FsIO, Alloc, FFI, Unsafe }

#[ring(outer)] #[trusted] module tool;

extern "C" fn fs_read(path: i32, path_len: i32) -> i64 ! { FFI, Unsafe };

fn render_decimal(n_in: i64 @Internal) -> i64 @Internal ! { Alloc } {
    if n_in == 0 {
        let out: i64 @Internal = alloc(1);
        store8(out, 48);
        return out * 4294967296 + 1;
    } else {
        let scratch: i64 @Internal = alloc(20);
        let mut digits: i64 @Internal = 0;
        let mut n: i64 @Internal = n_in;
        while n > 0 {
            let q: i64 @Internal = n / 10;
            let d: i64 @Internal = n - q * 10;
            store8(scratch + digits, 48 + d);
            digits = digits + 1;
            n = q;
        }
        let out: i64 @Internal = alloc(digits);
        let mut i: i64 @Internal = 0;
        while i < digits {
            let b: i64 @Internal = load8(scratch + digits - 1 - i);
            store8(out + i, b);
            i = i + 1;
        }
        return out * 4294967296 + digits;
    }
}

// Input "path:N". Read CSV, count non-empty values in column N (0-indexed),
// excluding the header row.
pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { FsIO, Alloc, FFI, Unsafe } {
    let zero_i32: i32 = input_len - input_len;
    let one_i32: i32 = input_len / input_len;

    let mut sep32: i32 = input_len;
    let mut scan: i32 = zero_i32;
    while scan < input_len {
        let b: i64 @Internal = load8(input_ptr + scan);
        if b == 58 {
            if sep32 == input_len {
                sep32 = scan;
            } else {
            }
        } else {
        }
        scan = scan + one_i32;
    }
    if sep32 == input_len {
        return 0 - 400;
    } else {
    }

    let raw: i64 @Internal = fs_read(input_ptr, sep32);
    if raw < 0 {
        return raw;
    } else {
    }
    let file_ptr: i64 @Internal = raw / 4294967296;
    let file_len: i64 @Internal = raw - file_ptr * 4294967296;

    // Parse target column index from input (after ':')
    let mut target: i64 @Internal = 0;
    let mut p: i32 @Internal = sep32 + one_i32;
    while p < input_len {
        let cb: i64 @Internal = load8(input_ptr + p);
        if cb > 47 {
            if cb < 58 {
                target = target * 10 + cb - 48;
            } else {
            }
        } else {
        }
        p = p + one_i32;
    }

    // Count non-empty cells in target column across data rows (skip header).
    let mut count: i64 @Internal = 0;
    let mut row: i64 @Internal = 0;
    let mut col: i64 @Internal = 0;
    let mut cell_has_content: i64 @Internal = 0;
    let mut i: i64 @Internal = 0;
    while i <= file_len {
        let mut eol: i64 @Internal = 0;
        let mut sep_c: i64 @Internal = 0;
        let mut byte_val: i64 @Internal = 0;
        if i == file_len {
            eol = 1;
        } else {
            let b: i64 @Internal = load8(file_ptr + i);
            byte_val = b;
            if b == 10 {
                eol = 1;
            } else {
                if b == 44 {
                    sep_c = 1;
                } else {
                    cell_has_content = 1;
                }
            }
        }
        if eol == 1 {
            if row > 0 {
                if col == target {
                    if cell_has_content == 1 {
                        count = count + 1;
                    } else {
                    }
                } else {
                }
            } else {
            }
            row = row + 1;
            col = 0;
            cell_has_content = 0;
        } else {
            if sep_c == 1 {
                if row > 0 {
                    if col == target {
                        if cell_has_content == 1 {
                            count = count + 1;
                        } else {
                        }
                    } else {
                    }
                } else {
                }
                col = col + 1;
                cell_has_content = 0;
            } else {
            }
        }
        let _b: i64 @Internal = byte_val;
        i = i + 1;
    }
    return render_decimal(count);
}
