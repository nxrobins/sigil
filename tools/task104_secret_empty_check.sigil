// TASK: secret empty check — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

// Accept @Secret input, return "empty" or "nonempty" as @Secret.
pub fn tool_main(input_ptr: i64 @Secret, input_len: i64 @Secret) -> i64 @Secret ! { Alloc } {
    if input_len == 0 {
        let out: i64 @Secret = alloc(5);
        store8(out, 101); // e
        store8(out + 1, 109); // m
        store8(out + 2, 112); // p
        store8(out + 3, 116); // t
        store8(out + 4, 121); // y
        return out * 4294967296 + 5;
    } else {
        let out: i64 @Secret = alloc(8);
        store8(out, 110); // n
        store8(out + 1, 111); // o
        store8(out + 2, 110); // n
        store8(out + 3, 101); // e
        store8(out + 4, 109); // m
        store8(out + 5, 112); // p
        store8(out + 6, 116); // t
        store8(out + 7, 121); // y
        return out * 4294967296 + 8;
    }
}
