// TASK: transpose csv — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

fn write_u32(ptr: i64, value: i64) -> i64 {
    let q0 = value / 256;
    let b0 = value - q0 * 256;
    let q1 = q0 / 256;
    let b1 = q0 - q1 * 256;
    let q2 = q1 / 256;
    let b2 = q1 - q2 * 256;
    let q3 = q2 / 256;
    let b3 = q2 - q3 * 256;

    store8(ptr, b0);
    store8(ptr + 1, b1);
    store8(ptr + 2, b2);
    store8(ptr + 3, b3);
    return 0;
}

fn read_u32(ptr: i64) -> i64 {
    let b0 = load8(ptr);
    let b1 = load8(ptr + 1);
    let b2 = load8(ptr + 2);
    let b3 = load8(ptr + 3);
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
}

fn append_segment(out_ptr: i64, out_len_in: i64, src_ptr: i64, start: i64, end: i64) -> i64 {
    let mut out_len = out_len_in;
    let mut i = start;

    while i < end {
        let b = load8(src_ptr + i);
        store8(out_ptr + out_len, b);
        out_len = out_len + 1;
        i = i + 1;
    }

    return out_len;
}

pub fn tool_main(input_ptr: i64, input_len: i64) -> i64 ! { Alloc } {
    if input_len == 0 {
        let out_ptr = alloc(0);
        return out_ptr * 4294967296;
    } else {
        let mut col_count = 1;
        let mut row_count = 1;
        let mut scan = 0;
        let mut first_row = 1;

        while scan < input_len {
            let b = load8(input_ptr + scan);
            if first_row == 1 {
                if b == 44 {
                    col_count = col_count + 1;
                } else {
                    if b == 10 {
                        first_row = 0;
                        row_count = row_count + 1;
                    } else {
                    }
                }
            } else {
                if b == 10 {
                    row_count = row_count + 1;
                } else {
                }
            }
            scan = scan + 1;
        }

        let last = load8(input_ptr + input_len - 1);
        if last == 10 {
            row_count = row_count - 1;
        } else {
        }

        let meta_ptr = alloc(row_count * col_count * 8);
        let mut row = 0;
        let mut col = 0;
        let mut cell_start = 0;
        let mut i = 0;

        while i < input_len {
            let b = load8(input_ptr + i);
            if b == 44 {
                let slot_index = row * col_count + col;
                let slot = meta_ptr + slot_index * 8;
                write_u32(slot, cell_start);
                write_u32(slot + 4, i);
                col = col + 1;
                cell_start = i + 1;
            } else {
                if b == 10 {
                    let slot_index = row * col_count + col;
                    let slot = meta_ptr + slot_index * 8;
                    write_u32(slot, cell_start);
                    write_u32(slot + 4, i);
                    row = row + 1;
                    col = 0;
                    cell_start = i + 1;
                } else {
                }
            }
            i = i + 1;
        }

        if last == 10 {
        } else {
            let slot_index = row * col_count + col;
            let slot = meta_ptr + slot_index * 8;
            write_u32(slot, cell_start);
            write_u32(slot + 4, input_len);
        }

        let out_ptr = alloc(input_len);
        let mut out_len = 0;
        let mut out_col = 0;

        while out_col < col_count {
            let mut out_row = 0;

            while out_row < row_count {
                let slot_index = out_row * col_count + out_col;
                let slot = meta_ptr + slot_index * 8;
                let start = read_u32(slot);
                let end = read_u32(slot + 4);
                out_len = append_segment(out_ptr, out_len, input_ptr, start, end);

                if out_row + 1 < row_count {
                    store8(out_ptr + out_len, 44);
                    out_len = out_len + 1;
                } else {
                    if out_col + 1 < col_count {
                        store8(out_ptr + out_len, 10);
                        out_len = out_len + 1;
                    } else {
                    }
                }

                out_row = out_row + 1;
            }

            out_col = out_col + 1;
        }

        return out_ptr * 4294967296 + out_len;
    }
}
