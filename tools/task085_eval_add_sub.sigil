// TASK: eval add sub — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

fn render_decimal_unsigned(n_in: i64) -> i64 {
    if n_in == 0 {
        let out_ptr = alloc(1);
        store8(out_ptr, 48);
        return out_ptr * 4294967296 + 1;
    } else {
        let scratch_ptr = alloc(20);
        let mut digits = 0;
        let mut n = n_in;

        while n > 0 {
            let q = n / 10;
            let digit = n - q * 10;
            store8(scratch_ptr + digits, 48 + digit);
            digits = digits + 1;
            n = q;
        }

        let out_ptr = alloc(digits);
        let mut i = 0;

        while i < digits {
            let b = load8(scratch_ptr + digits - 1 - i);
            store8(out_ptr + i, b);
            i = i + 1;
        }

        return out_ptr * 4294967296 + digits;
    }
}

fn render_decimal_signed(n_in: i64) -> i64 {
    if n_in < 0 {
        let mag = 0 - n_in;
        let raw = render_decimal_unsigned(mag);
        let digits_ptr = raw / 4294967296;
        let digits_len = raw - digits_ptr * 4294967296;
        let out_ptr = alloc(digits_len + 1);
        store8(out_ptr, 45);
        let mut i = 0;

        while i < digits_len {
            let b = load8(digits_ptr + i);
            store8(out_ptr + 1 + i, b);
            i = i + 1;
        }

        return out_ptr * 4294967296 + digits_len + 1;
    } else {
        return render_decimal_unsigned(n_in);
    }
}

pub fn tool_main(input_ptr: i64, input_len: i64) -> i64 ! { Alloc } {
    let mut total = 0;
    let mut current = 0;
    let mut sign = 1;
    let mut i = 0;

    while i < input_len {
        let b = load8(input_ptr + i);
        if b >= 48 {
            if b <= 57 {
                current = current * 10 + b - 48;
            } else {
            }
        } else {
            if b == 43 {
                total = total + sign * current;
                current = 0;
                sign = 1;
            } else {
                if b == 45 {
                    total = total + sign * current;
                    current = 0;
                    sign = 0 - 1;
                } else {
                }
            }
        }
        i = i + 1;
    }

    total = total + sign * current;
    return render_decimal_signed(total);
}
