// TASK: fs split nth — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i32) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { FsIO, Alloc, FFI, Unsafe }

#[ring(outer)] #[trusted] module tool;

extern "C" fn fs_read(path: i32, path_len: i32) -> i64 ! { FFI, Unsafe };

// Input "path:D:N". Split file on single-byte delimiter D, return Nth (0-indexed) segment.
pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { FsIO, Alloc, FFI, Unsafe } {
    let zero_i32: i32 = input_len - input_len;
    let one_i32: i32 = input_len / input_len;

    let mut sep1: i32 = input_len;
    let mut sep2: i32 = input_len;
    let mut scan: i32 = zero_i32;
    while scan < input_len {
        let b: i64 @Internal = load8(input_ptr + scan);
        if b == 58 {
            if sep1 == input_len {
                sep1 = scan;
            } else {
                if sep2 == input_len {
                    sep2 = scan;
                } else {
                }
            }
        } else {
        }
        scan = scan + one_i32;
    }
    if sep1 == input_len {
        return 0 - 400;
    } else {
    }
    if sep2 == input_len {
        return 0 - 400;
    } else {
    }

    let raw: i64 @Internal = fs_read(input_ptr, sep1);
    if raw < 0 {
        return raw;
    } else {
    }
    let file_ptr: i64 @Internal = raw / 4294967296;
    let file_len: i64 @Internal = raw - file_ptr * 4294967296;

    // delimiter is first byte after sep1
    let delim_off: i32 @Internal = sep1 + one_i32;
    let delim: i64 @Internal = load8(input_ptr + delim_off);

    // parse N after sep2
    let mut target: i64 @Internal = 0;
    let mut p: i32 @Internal = sep2 + one_i32;
    while p < input_len {
        let cb: i64 @Internal = load8(input_ptr + p);
        if cb > 47 {
            if cb < 58 {
                target = target * 10 + cb - 48;
            } else {
            }
        } else {
        }
        p = p + one_i32;
    }

    // Walk file, count segments
    let mut idx: i64 @Internal = 0;
    let mut seg_start: i64 @Internal = 0;
    let mut seg_len: i64 @Internal = 0;
    let mut found_start: i64 @Internal = 0 - 1;
    let mut found_len: i64 @Internal = 0;
    let mut i: i64 @Internal = 0;
    while i <= file_len {
        let mut end_seg: i64 @Internal = 0;
        if i == file_len {
            end_seg = 1;
        } else {
            let b: i64 @Internal = load8(file_ptr + i);
            if b == delim {
                end_seg = 1;
            } else {
                if b == 10 {
                    end_seg = 1;
                } else {
                }
            }
        }
        if end_seg == 1 {
            seg_len = i - seg_start;
            if idx == target {
                if found_start < 0 {
                    found_start = seg_start;
                    found_len = seg_len;
                } else {
                }
            } else {
            }
            idx = idx + 1;
            seg_start = i + 1;
        } else {
        }
        i = i + 1;
    }

    if found_start < 0 {
        return 0 - 404;
    } else {
    }

    let out: i64 @Internal = alloc(found_len);
    let mut k: i64 @Internal = 0;
    while k < found_len {
        let bb: i64 @Internal = load8(file_ptr + found_start + k);
        store8(out + k, bb);
        k = k + 1;
    }
    return out * 4294967296 + found_len;
}
