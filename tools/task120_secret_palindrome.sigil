// TASK: secret palindrome — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

// Return "true" if @Secret input is a palindrome.
pub fn tool_main(input_ptr: i64 @Secret, input_len: i64 @Secret) -> i64 @Secret ! { Alloc } {
    let mut ok: i64 @Secret = 1;
    let mut i: i64 @Secret = 0;
    let half: i64 @Secret = input_len / 2;
    while i < half {
        let a: i64 @Secret = load8(input_ptr + i);
        let b: i64 @Secret = load8(input_ptr + input_len - 1 - i);
        if a == b {
        } else {
            ok = 0;
        }
        i = i + 1;
    }
    if ok == 1 {
        let out: i64 @Secret = alloc(4);
        store8(out, 116);
        store8(out + 1, 114);
        store8(out + 2, 117);
        store8(out + 3, 101);
        return out * 4294967296 + 4;
    } else {
        let out: i64 @Secret = alloc(5);
        store8(out, 102);
        store8(out + 1, 97);
        store8(out + 2, 108);
        store8(out + 3, 115);
        store8(out + 4, 101);
        return out * 4294967296 + 5;
    }
}
