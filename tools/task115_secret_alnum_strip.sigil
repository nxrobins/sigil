// EFFECTS: ! { Alloc }

module tool;

// Accept @Secret input, strip non-alphanumeric bytes, return @Secret result.
pub fn tool_main(input_ptr: i64 @Secret, input_len: i64 @Secret) -> i64 @Secret ! { Alloc } {
    let out: i64 @Secret = alloc(input_len);
    let mut n: i64 @Secret = 0;
    let mut i: i64 @Secret = 0;
    while i < input_len {
        let b: i64 @Secret = load8(input_ptr + i);
        let mut ok: i64 @Secret = 0;
        if b > 47 {
            if b < 58 {
                ok = 1;
            } else {
            }
        } else {
        }
        if b > 64 {
            if b < 91 {
                ok = 1;
            } else {
            }
        } else {
        }
        if b > 96 {
            if b < 123 {
                ok = 1;
            } else {
            }
        } else {
        }
        if ok == 1 {
            store8(out + n, b);
            n = n + 1;
        } else {
        }
        i = i + 1;
    }
    return out * 4294967296 + n;
}
