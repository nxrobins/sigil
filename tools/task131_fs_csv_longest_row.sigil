// TASK: fs csv longest row — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i32) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { FsIO, Alloc, FFI, Unsafe }

#[ring(outer)] #[trusted] module tool;

extern "C" fn fs_read(path: i32, path_len: i32) -> i64 ! { FFI, Unsafe };

// Input "path:N". Read CSV, return the row with the longest value in column N.
pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { FsIO, Alloc, FFI, Unsafe } {
    let zero_i32: i32 = input_len - input_len;
    let one_i32: i32 = input_len / input_len;

    let mut sep32: i32 = input_len;
    let mut scan: i32 = zero_i32;
    while scan < input_len {
        let b: i64 @Internal = load8(input_ptr + scan);
        if b == 58 {
            if sep32 == input_len {
                sep32 = scan;
            } else {
            }
        } else {
        }
        scan = scan + one_i32;
    }
    if sep32 == input_len {
        return 0 - 400;
    } else {
    }

    let raw: i64 @Internal = fs_read(input_ptr, sep32);
    if raw < 0 {
        return raw;
    } else {
    }
    let file_ptr: i64 @Internal = raw / 4294967296;
    let file_len: i64 @Internal = raw - file_ptr * 4294967296;

    let mut target: i64 @Internal = 0;
    let mut p: i32 @Internal = sep32 + one_i32;
    while p < input_len {
        let cb: i64 @Internal = load8(input_ptr + p);
        if cb > 47 {
            if cb < 58 {
                target = target * 10 + cb - 48;
            } else {
            }
        } else {
        }
        p = p + one_i32;
    }

    // Walk rows. Track best (row_start, row_len, cell_len).
    let mut best_start: i64 @Internal = 0;
    let mut best_row_len: i64 @Internal = 0;
    let mut best_cell_len: i64 @Internal = 0;

    let mut row: i64 @Internal = 0;
    let mut row_start: i64 @Internal = 0;
    let mut col: i64 @Internal = 0;
    let mut cell_start: i64 @Internal = 0;
    let mut i: i64 @Internal = 0;
    while i <= file_len {
        let mut eol: i64 @Internal = 0;
        let mut sep_c: i64 @Internal = 0;
        if i == file_len {
            eol = 1;
        } else {
            let b: i64 @Internal = load8(file_ptr + i);
            if b == 10 {
                eol = 1;
            } else {
                if b == 44 {
                    sep_c = 1;
                } else {
                }
            }
        }
        if sep_c == 1 {
            if col == target {
                let cell_len: i64 @Internal = i - cell_start;
                if row > 0 {
                    if cell_len > best_cell_len {
                        best_start = row_start;
                        best_cell_len = cell_len;
                    } else {
                    }
                } else {
                }
            } else {
            }
            col = col + 1;
            cell_start = i + 1;
        } else {
        }
        if eol == 1 {
            if col == target {
                let cell_len2: i64 @Internal = i - cell_start;
                if row > 0 {
                    if cell_len2 > best_cell_len {
                        best_start = row_start;
                        best_cell_len = cell_len2;
                    } else {
                    }
                } else {
                }
            } else {
            }
            if row > 0 {
                if row_start == best_start {
                    best_row_len = i - row_start;
                } else {
                }
            } else {
            }
            row = row + 1;
            row_start = i + 1;
            col = 0;
            cell_start = i + 1;
        } else {
        }
        i = i + 1;
    }

    let out: i64 @Internal = alloc(best_row_len);
    let mut k: i64 @Internal = 0;
    while k < best_row_len {
        let bb: i64 @Internal = load8(file_ptr + best_start + k);
        store8(out + k, bb);
        k = k + 1;
    }
    return out * 4294967296 + best_row_len;
}
