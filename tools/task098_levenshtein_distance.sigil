// TASK: levenshtein distance — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

fn write_u32(ptr: i64, value: i64) -> i64 {
    let q0 = value / 256;
    let b0 = value - q0 * 256;
    let q1 = q0 / 256;
    let b1 = q0 - q1 * 256;
    let q2 = q1 / 256;
    let b2 = q1 - q2 * 256;
    let q3 = q2 / 256;
    let b3 = q2 - q3 * 256;

    store8(ptr, b0);
    store8(ptr + 1, b1);
    store8(ptr + 2, b2);
    store8(ptr + 3, b3);
    return 0;
}

fn read_u32(ptr: i64) -> i64 {
    let b0 = load8(ptr);
    let b1 = load8(ptr + 1);
    let b2 = load8(ptr + 2);
    let b3 = load8(ptr + 3);
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
}

fn min3(a: i64, b: i64, c: i64) -> i64 {
    let mut m = a;
    if b < m {
        m = b;
    } else {
    }
    if c < m {
        m = c;
    } else {
    }
    return m;
}

fn render_decimal(n_in: i64) -> i64 {
    if n_in == 0 {
        let out_ptr = alloc(1);
        store8(out_ptr, 48);
        return out_ptr * 4294967296 + 1;
    } else {
        let scratch_ptr = alloc(20);
        let mut digits = 0;
        let mut n = n_in;

        while n > 0 {
            let q = n / 10;
            let digit = n - q * 10;
            store8(scratch_ptr + digits, 48 + digit);
            digits = digits + 1;
            n = q;
        }

        let out_ptr = alloc(digits);
        let mut i = 0;

        while i < digits {
            let b = load8(scratch_ptr + digits - 1 - i);
            store8(out_ptr + i, b);
            i = i + 1;
        }

        return out_ptr * 4294967296 + digits;
    }
}

pub fn tool_main(input_ptr: i64, input_len: i64) -> i64 ! { Alloc } {
    let mut split = input_len;
    let mut i = 0;

    while i < input_len {
        let b = load8(input_ptr + i);
        if split == input_len {
            if b == 10 {
                split = i;
            } else {
            }
        } else {
        }
        i = i + 1;
    }

    let left_start = 0;
    let left_end = split;
    let mut right_start = input_len;

    if split < input_len {
        right_start = split + 1;
    } else {
        right_start = input_len;
    }

    let right_end = input_len;
    let left_len = left_end - left_start;
    let right_len = right_end - right_start;
    let right_slots = right_len + 1;
    let row_size = right_slots * 4;
    let mut prev_ptr = alloc(row_size);
    let mut curr_ptr = alloc(row_size);

    i = 0;
    while i <= right_len {
        let slot = prev_ptr + i * 4;
        write_u32(slot, i);
        i = i + 1;
    }

    let mut row = 1;
    while row <= left_len {
        write_u32(curr_ptr, row);
        let left_b = load8(input_ptr + left_start + row - 1);
        let mut col = 1;

        while col <= right_len {
            let right_b = load8(input_ptr + right_start + col - 1);
            let mut cost = 1;
            if left_b == right_b {
                cost = 0;
            } else {
            }
            let del_slot = prev_ptr + col * 4;
            let prev_col = col - 1;
            let ins_slot = curr_ptr + prev_col * 4;
            let sub_slot = prev_ptr + prev_col * 4;
            let deletion = read_u32(del_slot) + 1;
            let insertion = read_u32(ins_slot) + 1;
            let substitution = read_u32(sub_slot) + cost;
            let value = min3(deletion, insertion, substitution);
            let cur_slot = curr_ptr + col * 4;
            write_u32(cur_slot, value);
            col = col + 1;
        }

        let tmp = prev_ptr;
        prev_ptr = curr_ptr;
        curr_ptr = tmp;
        row = row + 1;
    }

    let result_slot = prev_ptr + right_len * 4;
    let result = read_u32(result_slot);
    return render_decimal(result);
}
