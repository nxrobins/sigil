// TASK: omni pipeline — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i32) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { FsIO, NetIO, Alloc, FFI, Unsafe }

#[ring(outer)] #[trusted] module tool;

extern "C" fn fs_read(path: i32, path_len: i32) -> i64 ! { FFI, Unsafe };
extern "C" fn http_get(url: i32, url_len: i32) -> i64 ! { FFI, Unsafe };

// Read pipeline config (key=value) — expects "url=..." and "transform=...".
// Fetch URL, apply transform (upper/lower/reverse), return result.
pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { FsIO, NetIO, Alloc, FFI, Unsafe } {
    let raw: i64 @Internal = fs_read(input_ptr, input_len);
    if raw < 0 {
        return raw;
    } else {
    }
    let file_ptr: i64 @Internal = raw / 4294967296;
    let file_len: i64 @Internal = raw - file_ptr * 4294967296;

    // Parse key=value lines; locate url_start/len and transform_start/len
    let mut url_start: i64 @Internal = 0 - 1;
    let mut url_end: i64 @Internal = 0;
    let mut tf_start: i64 @Internal = 0 - 1;
    let mut tf_end: i64 @Internal = 0;

    let mut line_start: i64 @Internal = 0;
    let mut i: i64 @Internal = 0;
    while i <= file_len {
        let mut eol: i64 @Internal = 0;
        if i == file_len {
            eol = 1;
        } else {
            let b: i64 @Internal = load8(file_ptr + i);
            if b == 10 {
                eol = 1;
            } else {
            }
        }
        if eol == 1 {
            let ln: i64 @Internal = i - line_start;
            if ln >= 4 {
                let c0: i64 @Internal = load8(file_ptr + line_start);
                let c1: i64 @Internal = load8(file_ptr + line_start + 1);
                let c2: i64 @Internal = load8(file_ptr + line_start + 2);
                let c3: i64 @Internal = load8(file_ptr + line_start + 3);
                // "url="?
                if c0 == 117 {
                    if c1 == 114 {
                        if c2 == 108 {
                            if c3 == 61 {
                                url_start = line_start + 4;
                                url_end = i;
                            } else {
                            }
                        } else {
                        }
                    } else {
                    }
                } else {
                }
            } else {
            }
            if ln >= 10 {
                let c0b: i64 @Internal = load8(file_ptr + line_start);
                let c9b: i64 @Internal = load8(file_ptr + line_start + 9);
                // "transform=" ends with '=' at offset 9
                if c0b == 116 {
                    if c9b == 61 {
                        tf_start = line_start + 10;
                        tf_end = i;
                    } else {
                    }
                } else {
                }
            } else {
            }
            line_start = i + 1;
        } else {
        }
        i = i + 1;
    }

    if url_start < 0 {
        return 0 - 404;
    } else {
    }

    let url_len_i64: i64 @Internal = url_end - url_start;

    // Copy URL into input buffer
    let zero_i32: i32 @Internal = input_len - input_len;
    let one_i32: i32 @Internal = input_len / input_len;
    let mut out_i32: i32 @Internal = zero_i32;
    let mut j: i64 @Internal = 0;
    while j < url_len_i64 {
        let bb: i64 @Internal = load8(file_ptr + url_start + j);
        store8(input_ptr + out_i32, bb);
        out_i32 = out_i32 + one_i32;
        j = j + 1;
    }

    let raw_body: i64 @Internal = http_get(input_ptr, out_i32);
    if raw_body < 0 {
        return raw_body;
    } else {
    }
    let body_ptr: i64 @Internal = raw_body / 4294967296;
    let body_len: i64 @Internal = raw_body - body_ptr * 4294967296;

    // Determine transform
    let mut mode: i64 @Internal = 0;
    if tf_start >= 0 {
        let tf_first: i64 @Internal = load8(file_ptr + tf_start);
        if tf_first == 117 {
            mode = 1;
        } else {
            if tf_first == 108 {
                mode = 2;
            } else {
                if tf_first == 114 {
                    mode = 3;
                } else {
                }
            }
        }
    } else {
    }

    let out: i64 @Internal = alloc(body_len);
    let mut k: i64 @Internal = 0;
    while k < body_len {
        if mode == 1 {
            let b: i64 @Internal = load8(body_ptr + k);
            let mut r: i64 @Internal = b;
            if b > 96 {
                if b < 123 {
                    r = b - 32;
                } else {
                }
            } else {
            }
            store8(out + k, r);
        } else {
            if mode == 2 {
                let b: i64 @Internal = load8(body_ptr + k);
                let mut r: i64 @Internal = b;
                if b > 64 {
                    if b < 91 {
                        r = b + 32;
                    } else {
                    }
                } else {
                }
                store8(out + k, r);
            } else {
                if mode == 3 {
                    let src: i64 @Internal = body_ptr + body_len - 1 - k;
                    let b: i64 @Internal = load8(src);
                    store8(out + k, b);
                } else {
                    let b: i64 @Internal = load8(body_ptr + k);
                    store8(out + k, b);
                }
            }
        }
        k = k + 1;
    }

    let _tf_end: i64 @Internal = tf_end;
    return out * 4294967296 + body_len;
}
