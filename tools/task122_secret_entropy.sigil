// TASK: secret entropy — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

fn render_decimal(n_in: i64 @Secret) -> i64 @Secret ! { Alloc } {
    if n_in == 0 {
        let out: i64 @Secret = alloc(1);
        store8(out, 48);
        return out * 4294967296 + 1;
    } else {
        let scratch: i64 @Secret = alloc(20);
        let mut digits: i64 @Secret = 0;
        let mut n: i64 @Secret = n_in;
        while n > 0 {
            let q: i64 @Secret = n / 10;
            let d: i64 @Secret = n - q * 10;
            store8(scratch + digits, 48 + d);
            digits = digits + 1;
            n = q;
        }
        let out: i64 @Secret = alloc(digits);
        let mut i: i64 @Secret = 0;
        while i < digits {
            let b: i64 @Secret = load8(scratch + digits - 1 - i);
            store8(out + i, b);
            i = i + 1;
        }
        return out * 4294967296 + digits;
    }
}

// Return "uniq/total" as @Secret entropy estimate.
pub fn tool_main(input_ptr: i64 @Secret, input_len: i64 @Secret) -> i64 @Secret ! { Alloc } {
    let seen: i64 @Secret = alloc(256);
    let mut k: i64 @Secret = 0;
    while k < 256 {
        store8(seen + k, 0);
        k = k + 1;
    }
    let mut uniq: i64 @Secret = 0;
    let mut i: i64 @Secret = 0;
    while i < input_len {
        let b: i64 @Secret = load8(input_ptr + i);
        let prev: i64 @Secret = load8(seen + b);
        if prev == 0 {
            store8(seen + b, 1);
            uniq = uniq + 1;
        } else {
        }
        i = i + 1;
    }

    let d_pkg: i64 @Secret = render_decimal(uniq);
    let d_ptr: i64 @Secret = d_pkg / 4294967296;
    let d_len: i64 @Secret = d_pkg - d_ptr * 4294967296;

    let t_pkg: i64 @Secret = render_decimal(input_len);
    let t_ptr: i64 @Secret = t_pkg / 4294967296;
    let t_len: i64 @Secret = t_pkg - t_ptr * 4294967296;

    let total: i64 @Secret = d_len + 1 + t_len;
    let out: i64 @Secret = alloc(total);
    let mut n: i64 @Secret = 0;
    let mut m: i64 @Secret = 0;
    while m < d_len {
        store8(out + n, load8(d_ptr + m));
        n = n + 1;
        m = m + 1;
    }
    store8(out + n, 47); // /
    n = n + 1;
    let mut m2: i64 @Secret = 0;
    while m2 < t_len {
        store8(out + n, load8(t_ptr + m2));
        n = n + 1;
        m2 = m2 + 1;
    }
    return out * 4294967296 + n;
}
