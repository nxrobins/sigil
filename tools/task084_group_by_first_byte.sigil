// TASK: group by first byte — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

fn write_u32(ptr: i64, value: i64) -> i64 {
    let q0 = value / 256;
    let b0 = value - q0 * 256;
    let q1 = q0 / 256;
    let b1 = q0 - q1 * 256;
    let q2 = q1 / 256;
    let b2 = q1 - q2 * 256;
    let q3 = q2 / 256;
    let b3 = q2 - q3 * 256;

    store8(ptr, b0);
    store8(ptr + 1, b1);
    store8(ptr + 2, b2);
    store8(ptr + 3, b3);
    return 0;
}

fn read_u32(ptr: i64) -> i64 {
    let b0 = load8(ptr);
    let b1 = load8(ptr + 1);
    let b2 = load8(ptr + 2);
    let b3 = load8(ptr + 3);
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
}

fn append_segment(out_ptr: i64, out_len_in: i64, src_ptr: i64, start: i64, end: i64) -> i64 {
    let mut out_len = out_len_in;
    let mut i = start;

    while i < end {
        let b = load8(src_ptr + i);
        store8(out_ptr + out_len, b);
        out_len = out_len + 1;
        i = i + 1;
    }

    return out_len;
}

fn count_tokens(src_ptr: i64, input_len: i64) -> i64 {
    let mut count = 0;
    let mut in_token = 0;
    let mut pos = 0;

    while pos < input_len {
        let b = load8(src_ptr + pos);
        if b == 44 {
            in_token = 0;
        } else {
            if in_token == 0 {
                count = count + 1;
                in_token = 1;
            } else {
            }
        }
        pos = pos + 1;
    }

    return count;
}

fn parse_tokens(src_ptr: i64, input_len: i64, meta_ptr: i64, count: i64) -> i64 {
    let mut token_start = 0;
    let mut in_token = 0;
    let mut idx = 0;
    let mut pos = 0;

    while pos < input_len {
        let b = load8(src_ptr + pos);
        if b == 44 {
            if in_token == 1 {
                let slot = meta_ptr + idx * 8;
                write_u32(slot, token_start);
                write_u32(slot + 4, pos);
                idx = idx + 1;
                in_token = 0;
            } else {
            }
        } else {
            if in_token == 0 {
                token_start = pos;
                in_token = 1;
            } else {
            }
        }
        pos = pos + 1;
    }

    if in_token == 1 {
        let slot = meta_ptr + idx * 8;
        write_u32(slot, token_start);
        write_u32(slot + 4, input_len);
        idx = idx + 1;
    } else {
    }

    while idx < count {
        let slot = meta_ptr + idx * 8;
        write_u32(slot, input_len);
        write_u32(slot + 4, input_len);
        idx = idx + 1;
    }

    return 0;
}

pub fn tool_main(input_ptr: i64, input_len: i64) -> i64 ! { Alloc } {
    let token_count = count_tokens(input_ptr, input_len);
    let meta_ptr = alloc(token_count * 8);
    parse_tokens(input_ptr, input_len, meta_ptr, token_count);

    let out_ptr = alloc(input_len + 512);
    let mut out_len = 0;
    let mut wrote_group = 0;
    let mut group_byte = 0;

    while group_byte < 256 {
        let mut group_count = 0;
        let mut idx = 0;

        while idx < token_count {
            let slot = meta_ptr + idx * 8;
            let token_start = read_u32(slot);
            let token_end = read_u32(slot + 4);
            if token_start < token_end {
                let first = load8(input_ptr + token_start);
                if first == group_byte {
                    group_count = group_count + 1;
                } else {
                }
            } else {
            }
            idx = idx + 1;
        }

        if group_count > 0 {
            if wrote_group == 1 {
                store8(out_ptr + out_len, 10);
                out_len = out_len + 1;
            } else {
            }

            store8(out_ptr + out_len, group_byte);
            out_len = out_len + 1;
            store8(out_ptr + out_len, 58);
            out_len = out_len + 1;

            let mut wrote_token = 0;
            idx = 0;

            while idx < token_count {
                let slot = meta_ptr + idx * 8;
                let token_start = read_u32(slot);
                let token_end = read_u32(slot + 4);
                if token_start < token_end {
                    let first = load8(input_ptr + token_start);
                    if first == group_byte {
                        if wrote_token == 1 {
                            store8(out_ptr + out_len, 44);
                            out_len = out_len + 1;
                        } else {
                        }
                        out_len = append_segment(out_ptr, out_len, input_ptr, token_start, token_end);
                        wrote_token = 1;
                    } else {
                    }
                } else {
                }
                idx = idx + 1;
            }

            wrote_group = 1;
        } else {
        }

        group_byte = group_byte + 1;
    }

    return out_ptr * 4294967296 + out_len;
}
