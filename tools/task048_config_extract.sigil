// TASK: config extract — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i32) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { FsIO, Alloc, FFI, Unsafe }

#[ring(outer)] #[trusted] module tool;

extern "C" fn fs_read(path: i32, path_len: i32) -> i64 ! { FFI, Unsafe };

fn find_value_start(
    file_ptr: i64 @Internal,
    line_start: i64 @Internal,
    line_end: i64 @Internal,
    key_ptr: i64 @Internal,
    key_len: i64 @Internal,
) -> i64 @Internal ! {} {
    let mut sep: i64 @Internal = line_start;

    while sep < line_end {
        let b: i64 @Internal = load8(file_ptr + sep);
        if b == 61 {
            if sep - line_start == key_len {
                let mut same: i64 @Internal = 1;
                let mut i: i64 @Internal = 0;

                while i < key_len {
                    if same == 1 {
                        let a: i64 @Internal = load8(file_ptr + line_start + i);
                        let b2: i64 @Internal = load8(key_ptr + i);
                        if a == b2 {
                        } else {
                            same = 0;
                        }
                    } else {
                    }
                    i = i + 1;
                }

                if same == 1 {
                    return sep + 1;
                } else {
                    return 0 - 1;
                }
            } else {
                return 0 - 1;
            }
        } else {
        }
        sep = sep + 1;
    }

    return 0 - 1;
}

pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { FsIO, Alloc, FFI, Unsafe } {
    let zero = input_len - input_len;
    let one = input_len / input_len;
    let mut split = input_len;
    let mut scan = input_len;

    while scan > zero {
        let b = load8(input_ptr + scan - one);
        if split == input_len {
            if b == 58 {
                split = scan - one;
            } else {
            }
        } else {
        }
        scan = scan - one;
    }

    if split == input_len {
        return 0 - 400;
    } else {
        let raw: i64 @Internal = fs_read(input_ptr, split);

        if raw < 0 {
            return raw;
        } else {
            let mut key_len: i64 @Internal = 0;
            let mut key_scan: i32 @Internal = input_ptr + split + one;

            while key_scan < input_ptr + input_len {
                key_len = key_len + 1;
                key_scan = key_scan + one;
            }

            if key_len == 0 {
                return 0 - 400;
            } else {
                let key_ptr: i64 @Internal = alloc(key_len);
                let mut key_copy_scan: i32 @Internal = input_ptr + split + one;
                let mut key_copy_len: i64 @Internal = 0;

                while key_copy_scan < input_ptr + input_len {
                    let b: i64 @Internal = load8(key_copy_scan);
                    store8(key_ptr + key_copy_len, b);
                    key_copy_len = key_copy_len + 1;
                    key_copy_scan = key_copy_scan + one;
                }

                let file_ptr: i64 @Internal = raw / 4294967296;
                let file_len: i64 @Internal = raw - file_ptr * 4294967296;
                let mut line_start: i64 @Internal = 0;
                let mut i: i64 @Internal = 0;

                while i < file_len {
                    let b: i64 @Internal = load8(file_ptr + i);
                    if b == 10 {
                        let mut line_end: i64 @Internal = i;
                        if line_end > line_start {
                            if load8(file_ptr + line_end - 1) == 13 {
                                line_end = line_end - 1;
                            } else {
                            }
                        } else {
                        }

                        let value_start: i64 @Internal =
                            find_value_start(file_ptr, line_start, line_end, key_ptr, key_len);
                        if value_start >= 0 {
                            let out_ptr: i64 @Internal = file_ptr + value_start;
                            return out_ptr * 4294967296 + line_end - value_start;
                        } else {
                        }

                        line_start = i + 1;
                    } else {
                    }
                    i = i + 1;
                }

                if line_start < file_len {
                    let mut line_end: i64 @Internal = file_len;
                    if line_end > line_start {
                        if load8(file_ptr + line_end - 1) == 13 {
                            line_end = line_end - 1;
                        } else {
                        }
                    } else {
                    }

                    let value_start: i64 @Internal =
                        find_value_start(file_ptr, line_start, line_end, key_ptr, key_len);
                    if value_start >= 0 {
                        let out_ptr: i64 @Internal = file_ptr + value_start;
                        return out_ptr * 4294967296 + line_end - value_start;
                    } else {
                    }
                } else {
                }

                return 0;
            }
        }
    }
}
