// TASK: fs base64 — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i32) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { FsIO, Alloc, FFI, Unsafe }

#[ring(outer)] #[trusted] module tool;

extern "C" fn fs_read(path: i32, path_len: i32) -> i64 ! { FFI, Unsafe };

fn b64_char(n: i64 @Internal) -> i64 @Internal ! {} {
    if n < 26 {
        return 65 + n;
    } else {
        if n < 52 {
            return 97 + n - 26;
        } else {
            if n < 62 {
                return 48 + n - 52;
            } else {
                if n == 62 {
                    return 43;
                } else {
                    return 47;
                }
            }
        }
    }
}

// Base64-encode the contents of a file.
pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { FsIO, Alloc, FFI, Unsafe } {
    let raw: i64 @Internal = fs_read(input_ptr, input_len);
    if raw < 0 {
        return raw;
    } else {
    }
    let file_ptr: i64 @Internal = raw / 4294967296;
    let file_len: i64 @Internal = raw - file_ptr * 4294967296;

    let out_cap: i64 @Internal = file_len * 2 + 8;
    let out: i64 @Internal = alloc(out_cap);
    let mut out_len: i64 @Internal = 0;

    let mut i: i64 @Internal = 0;
    while i < file_len {
        let b0: i64 @Internal = load8(file_ptr + i);
        let mut b1: i64 @Internal = 0;
        let mut b2: i64 @Internal = 0;
        let mut have1: i64 @Internal = 0;
        let mut have2: i64 @Internal = 0;
        if i + 1 < file_len {
            b1 = load8(file_ptr + i + 1);
            have1 = 1;
        } else {
        }
        if i + 2 < file_len {
            b2 = load8(file_ptr + i + 2);
            have2 = 1;
        } else {
        }

        let v0: i64 @Internal = b0 / 4;
        let v0q: i64 @Internal = v0 * 4;
        let v1_hi: i64 @Internal = b0 - v0q;
        let b1_div16: i64 @Internal = b1 / 16;
        let v1: i64 @Internal = v1_hi * 16 + b1_div16;
        let b1_div16_times16: i64 @Internal = b1_div16 * 16;
        let v2_hi: i64 @Internal = b1 - b1_div16_times16;
        let b2_div64: i64 @Internal = b2 / 64;
        let v2: i64 @Internal = v2_hi * 4 + b2_div64;
        let b2_div64_times64: i64 @Internal = b2_div64 * 64;
        let v3: i64 @Internal = b2 - b2_div64_times64;

        store8(out + out_len, b64_char(v0));
        out_len = out_len + 1;
        store8(out + out_len, b64_char(v1));
        out_len = out_len + 1;
        if have1 == 1 {
            store8(out + out_len, b64_char(v2));
            out_len = out_len + 1;
        } else {
            store8(out + out_len, 61);
            out_len = out_len + 1;
        }
        if have2 == 1 {
            store8(out + out_len, b64_char(v3));
            out_len = out_len + 1;
        } else {
            store8(out + out_len, 61);
            out_len = out_len + 1;
        }
        i = i + 3;
    }

    return out * 4294967296 + out_len;
}
