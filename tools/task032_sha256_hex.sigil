// TASK: sha256 hex — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i32) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc, FFI, Unsafe }

#[ring(outer)] #[trusted] module tool;

use sigil::crypto;

pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { Alloc, FFI, Unsafe } {
    let digest_packed: i64 @Internal = crypto::sha256(input_ptr, input_len);
    if digest_packed < 0 {
        return digest_packed;
    } else {
        let digest_ptr: i64 @Internal = digest_packed / 4294967296;
        let digest_len: i64 @Internal = digest_packed - digest_ptr * 4294967296;
        return crypto::hex_encode(digest_ptr, digest_len);
    }
}
