// TASK: fetch url extract urls — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i32) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { NetIO, Alloc, FFI, Unsafe }

#[ring(outer)] #[trusted] module tool;

extern "C" fn http_get(url: i32, url_len: i32) -> i64 ! { FFI, Unsafe };

fn append_segment(
    out_ptr: i64 @Internal,
    out_len_in: i64 @Internal,
    body_ptr: i64 @Internal,
    start: i64 @Internal,
    end: i64 @Internal,
) -> i64 @Internal ! {} {
    let mut out_len: i64 @Internal = out_len_in;
    let mut i: i64 @Internal = start;

    while i < end {
        let b: i64 @Internal = load8(body_ptr + i);
        store8(out_ptr + out_len, b);
        out_len = out_len + 1;
        i = i + 1;
    }

    return out_len;
}

pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { NetIO, Alloc, FFI, Unsafe } {
    let raw: i64 @Internal = http_get(input_ptr, input_len);

    if raw < 0 {
        return raw;
    } else {
        let body_ptr: i64 @Internal = raw / 4294967296;
        let body_len: i64 @Internal = raw - body_ptr * 4294967296;
        let out_ptr: i64 @Internal = alloc(body_len);
        let mut out_len: i64 @Internal = 0;
        let mut wrote_any: i64 @Internal = 0;
        let mut i: i64 @Internal = 0;
        let mut capturing: i64 @Internal = 0;
        let mut capture_start: i64 @Internal = 0;

        while i < body_len {
            if capturing == 0 {
                let mut scheme_len: i64 @Internal = 0;

                if body_len - i >= 8 {
                    if load8(body_ptr + i) == 104 {
                        if load8(body_ptr + i + 1) == 116 {
                            if load8(body_ptr + i + 2) == 116 {
                                if load8(body_ptr + i + 3) == 112 {
                                    if load8(body_ptr + i + 4) == 115 {
                                        if load8(body_ptr + i + 5) == 58 {
                                            if load8(body_ptr + i + 6) == 47 {
                                                if load8(body_ptr + i + 7) == 47 {
                                                    scheme_len = 8;
                                                } else {
                                                }
                                            } else {
                                            }
                                        } else {
                                        }
                                    } else {
                                    }
                                } else {
                                }
                            } else {
                            }
                        } else {
                        }
                    } else {
                    }
                } else {
                }

                if scheme_len == 0 {
                    if body_len - i >= 7 {
                        if load8(body_ptr + i) == 104 {
                            if load8(body_ptr + i + 1) == 116 {
                                if load8(body_ptr + i + 2) == 116 {
                                    if load8(body_ptr + i + 3) == 112 {
                                        if load8(body_ptr + i + 4) == 58 {
                                            if load8(body_ptr + i + 5) == 47 {
                                                if load8(body_ptr + i + 6) == 47 {
                                                    scheme_len = 7;
                                                } else {
                                                }
                                            } else {
                                            }
                                        } else {
                                        }
                                    } else {
                                    }
                                } else {
                                }
                            } else {
                            }
                        } else {
                        }
                    } else {
                    }
                } else {
                }

                if scheme_len > 0 {
                    if wrote_any == 1 {
                        store8(out_ptr + out_len, 10);
                        out_len = out_len + 1;
                    } else {
                    }
                    capturing = 1;
                    capture_start = i;
                } else {
                }
            } else {
                let b: i64 @Internal = load8(body_ptr + i);
                if b <= 32 {
                    out_len = append_segment(out_ptr, out_len, body_ptr, capture_start, i);
                    wrote_any = 1;
                    capturing = 0;
                } else {
                }
            }

            i = i + 1;
        }

        if capturing == 1 {
            out_len = append_segment(out_ptr, out_len, body_ptr, capture_start, body_len);
        } else {
        }

        return out_ptr * 4294967296 + out_len;
    }
}
