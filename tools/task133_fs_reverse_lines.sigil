// TASK: fs reverse lines — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i32) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { FsIO, Alloc, FFI, Unsafe }

#[ring(outer)] #[trusted] module tool;

extern "C" fn fs_read(path: i32, path_len: i32) -> i64 ! { FFI, Unsafe };

// Read a file, reverse the line order.
pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { FsIO, Alloc, FFI, Unsafe } {
    let raw: i64 @Internal = fs_read(input_ptr, input_len);
    if raw < 0 {
        return raw;
    } else {
    }
    let file_ptr: i64 @Internal = raw / 4294967296;
    let file_len: i64 @Internal = raw - file_ptr * 4294967296;

    let starts: i64 @Internal = alloc(2048);
    let lens: i64 @Internal = alloc(2048);
    let mut nlines: i64 @Internal = 0;

    let mut line_start: i64 @Internal = 0;
    let mut i: i64 @Internal = 0;
    while i <= file_len {
        let mut eol: i64 @Internal = 0;
        if i == file_len {
            eol = 1;
        } else {
            let b: i64 @Internal = load8(file_ptr + i);
            if b == 10 {
                eol = 1;
            } else {
            }
        }
        if eol == 1 {
            let ln: i64 @Internal = i - line_start;
            if ln > 0 {
                let n_off: i64 @Internal = nlines * 8;
                store8(starts + n_off, line_start);
                store8(starts + n_off + 1, line_start / 256);
                store8(starts + n_off + 2, line_start / 65536);
                store8(lens + n_off, ln);
                store8(lens + n_off + 1, ln / 256);
                nlines = nlines + 1;
            } else {
            }
            line_start = i + 1;
        } else {
        }
        i = i + 1;
    }

    let out: i64 @Internal = alloc(file_len + nlines);
    let mut out_len: i64 @Internal = 0;
    let mut m: i64 @Internal = nlines;
    while m > 0 {
        m = m - 1;
        let m_off: i64 @Internal = m * 8;
        let s_lo: i64 @Internal = load8(starts + m_off);
        let s_mid: i64 @Internal = load8(starts + m_off + 1);
        let s_hi: i64 @Internal = load8(starts + m_off + 2);
        let s: i64 @Internal = s_lo + s_mid * 256 + s_hi * 65536;
        let l_lo: i64 @Internal = load8(lens + m_off);
        let l_hi: i64 @Internal = load8(lens + m_off + 1);
        let l: i64 @Internal = l_lo + l_hi * 256;

        let mut k: i64 @Internal = 0;
        while k < l {
            let bb: i64 @Internal = load8(file_ptr + s + k);
            store8(out + out_len, bb);
            out_len = out_len + 1;
            k = k + 1;
        }
        store8(out + out_len, 10);
        out_len = out_len + 1;
    }
    return out * 4294967296 + out_len;
}
