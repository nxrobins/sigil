// EFFECTS: ! { Alloc }

module tool;

fn normalize_key_byte(b: i64) -> i64 {
    if b >= 97 {
        if b <= 122 {
            return b - 97;
        } else {
        }
    } else {
    }

    if b >= 65 {
        if b <= 90 {
