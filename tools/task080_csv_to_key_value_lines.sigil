// TASK: csv to key value lines — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

fn write_u32(ptr: i64, value: i64) -> i64 {
    let q0 = value / 256;
    let b0 = value - q0 * 256;
    let q1 = q0 / 256;
    let b1 = q0 - q1 * 256;
    let q2 = q1 / 256;
    let b2 = q1 - q2 * 256;
    let q3 = q2 / 256;
    let b3 = q2 - q3 * 256;

    store8(ptr, b0);
    store8(ptr + 1, b1);
    store8(ptr + 2, b2);
    store8(ptr + 3, b3);
    return 0;
}

fn read_u32(ptr: i64) -> i64 {
    let b0 = load8(ptr);
    let b1 = load8(ptr + 1);
    let b2 = load8(ptr + 2);
    let b3 = load8(ptr + 3);
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
}

fn append_segment(out_ptr: i64, out_len_in: i64, src_ptr: i64, start: i64, end: i64) -> i64 {
    let mut out_len = out_len_in;
    let mut i = start;

    while i < end {
        let b = load8(src_ptr + i);
        store8(out_ptr + out_len, b);
        out_len = out_len + 1;
        i = i + 1;
    }

    return out_len;
}

fn parse_row(src_ptr: i64, row_start: i64, row_end: i64, col_count: i64, meta_ptr: i64) -> i64 {
    if col_count == 0 {
        return 0;
    } else {
        let mut cell_start = row_start;
        let mut idx = 0;
        let mut pos = row_start;

        while pos < row_end {
            let b = load8(src_ptr + pos);
            if b == 44 {
                let slot = meta_ptr + idx * 8;
                write_u32(slot, cell_start);
                write_u32(slot + 4, pos);
                idx = idx + 1;
                cell_start = pos + 1;
            } else {
            }
            pos = pos + 1;
        }

        if idx < col_count {
            let slot = meta_ptr + idx * 8;
            write_u32(slot, cell_start);
            write_u32(slot + 4, row_end);
            idx = idx + 1;
        } else {
        }

        while idx < col_count {
            let slot = meta_ptr + idx * 8;
            write_u32(slot, row_end);
            write_u32(slot + 4, row_end);
            idx = idx + 1;
        }

        return 0;
    }
}

pub fn tool_main(input_ptr: i64, input_len: i64) -> i64 ! { Alloc } {
    let mut split = input_len;
    let mut i = 0;

    while i < input_len {
        let b = load8(input_ptr + i);
        if split == input_len {
            if b == 10 {
                split = i;
            } else {
            }
        } else {
        }
        i = i + 1;
    }

    if split == input_len {
        let out_ptr = alloc(0);
        return out_ptr * 4294967296;
    } else {
        let header_start = 0;
        let header_end = split;
        let value_start = split + 1;
        let mut value_end = input_len;

        if value_start < input_len {
            let last = load8(input_ptr + input_len - 1);
            if last == 10 {
                value_end = input_len - 1;
            } else {
            }
        } else {
        }

        let mut col_count = 1;
        i = header_start;

        while i < header_end {
            let b = load8(input_ptr + i);
            if b == 44 {
                col_count = col_count + 1;
            } else {
            }
            i = i + 1;
        }

        let header_meta = alloc(col_count * 8);
        let value_meta = alloc(col_count * 8);
        parse_row(input_ptr, header_start, header_end, col_count, header_meta);
        parse_row(input_ptr, value_start, value_end, col_count, value_meta);

        let out_ptr = alloc(input_len);
        let mut out_len = 0;
        let mut col = 0;

        while col < col_count {
            if col > 0 {
                store8(out_ptr + out_len, 10);
                out_len = out_len + 1;
            } else {
            }

            let header_slot = header_meta + col * 8;
            let header_cell_start = read_u32(header_slot);
            let header_cell_end = read_u32(header_slot + 4);
            out_len = append_segment(out_ptr, out_len, input_ptr, header_cell_start, header_cell_end);

            store8(out_ptr + out_len, 58);
            out_len = out_len + 1;

            let value_slot = value_meta + col * 8;
            let value_cell_start = read_u32(value_slot);
            let value_cell_end = read_u32(value_slot + 4);
            out_len = append_segment(out_ptr, out_len, input_ptr, value_cell_start, value_cell_end);

            col = col + 1;
        }

        return out_ptr * 4294967296 + out_len;
    }
}
