// TASK: secret xor salt — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

// Accept @Secret input and @Public salt, split by newline. Return XOR hash as @Secret.
// Note: mixing @Secret and @Public still yields @Secret (taint upgrade).
fn xor_byte_pair(a_in: i64 @Secret, b_in: i64 @Secret) -> i64 @Secret ! {} {
    let mut a: i64 @Secret = a_in;
    let mut b: i64 @Secret = b_in;
    let mut place: i64 @Secret = 1;
    let mut result: i64 @Secret = 0;
    let mut i: i64 @Secret = 0;
    while i < 8 {
        let ah: i64 @Secret = a / 2;
        let bh: i64 @Secret = b / 2;
        let ab: i64 @Secret = a - ah * 2;
        let bb: i64 @Secret = b - bh * 2;
        let s: i64 @Secret = ab + bb;
        if s == 1 {
            result = result + place;
        } else {
        }
        a = ah;
        b = bh;
        place = place + place;
        i = i + 1;
    }
    return result;
}

fn hex_digit(n: i64 @Secret) -> i64 @Secret ! {} {
    if n < 10 {
        return 48 + n;
    } else {
        return 87 + n;
    }
}

pub fn tool_main(input_ptr: i64 @Secret, input_len: i64 @Secret) -> i64 @Secret ! { Alloc } {
    // Find newline separator. Input is "secret\nsalt".
    let mut sep: i64 @Secret = 0 - 1;
    let mut i: i64 @Secret = 0;
    while i < input_len {
        let b: i64 @Secret = load8(input_ptr + i);
        if sep < 0 {
            if b == 10 {
                sep = i;
            } else {
            }
        } else {
        }
        i = i + 1;
    }

    let secret_end: i64 @Secret = sep;
    let salt_start: i64 @Secret = sep + 1;
    let salt_end: i64 @Secret = input_len;

    let secret_len: i64 @Secret = secret_end;
    let salt_len: i64 @Secret = salt_end - salt_start;

    let mut acc: i64 @Secret = 0;
    let mut j: i64 @Secret = 0;
    while j < secret_len {
        let sb: i64 @Secret = load8(input_ptr + j);
        let salt_div: i64 @Secret = j / salt_len;
        let salt_off: i64 @Secret = j - salt_div * salt_len;
        let salt_addr: i64 @Secret = input_ptr + salt_start + salt_off;
        let tb: i64 @Secret = load8(salt_addr);
        let x: i64 @Secret = xor_byte_pair(sb, tb);
        acc = xor_byte_pair(acc, x);
        j = j + 1;
    }

    let hi: i64 @Secret = acc / 16;
    let lo: i64 @Secret = acc - hi * 16;
    let out: i64 @Secret = alloc(2);
    store8(out, hex_digit(hi));
    store8(out + 1, hex_digit(lo));
    return out * 4294967296 + 2;
}
