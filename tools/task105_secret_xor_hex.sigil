// TASK: secret xor hex — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

// Accept @Secret input, XOR all bytes, return hex checksum as @Secret.
fn xor_byte_pair(a_in: i64 @Secret, b_in: i64 @Secret) -> i64 @Secret ! {} {
    let mut a: i64 @Secret = a_in;
    let mut b: i64 @Secret = b_in;
    let mut place: i64 @Secret = 1;
    let mut result: i64 @Secret = 0;
    let mut i: i64 @Secret = 0;

    while i < 8 {
        let a_half: i64 @Secret = a / 2;
        let b_half: i64 @Secret = b / 2;
        let a_bit: i64 @Secret = a - a_half * 2;
        let b_bit: i64 @Secret = b - b_half * 2;
        let bit_sum: i64 @Secret = a_bit + b_bit;

        if bit_sum == 1 {
            result = result + place;
        } else {
        }

        a = a_half;
        b = b_half;
        place = place + place;
        i = i + 1;
    }

    return result;
}

fn hex_digit(n: i64 @Secret) -> i64 @Secret ! {} {
    if n < 10 {
        return 48 + n;
    } else {
        return 87 + n;
    }
}

pub fn tool_main(input_ptr: i64 @Secret, input_len: i64 @Secret) -> i64 @Secret ! { Alloc } {
    let mut acc: i64 @Secret = 0;
    let mut i: i64 @Secret = 0;

    while i < input_len {
        let b: i64 @Secret = load8(input_ptr + i);
        acc = xor_byte_pair(acc, b);
        i = i + 1;
    }

    let hi: i64 @Secret = acc / 16;
    let lo: i64 @Secret = acc - hi * 16;
    let out_ptr: i64 @Secret = alloc(2);
    store8(out_ptr, hex_digit(hi));
    store8(out_ptr + 1, hex_digit(lo));
    return out_ptr * 4294967296 + 2;
}
