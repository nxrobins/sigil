// TASK: dedup lines — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i32) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { FsIO, Alloc, FFI, Unsafe }

#[ring(outer)] #[trusted] module tool;

extern "C" fn fs_read(path: i32, path_len: i32) -> i64 ! { FFI, Unsafe };

fn write_u32(ptr: i64 @Internal, value: i64 @Internal) -> i64 @Internal ! {} {
    let q0: i64 @Internal = value / 256;
    let b0: i64 @Internal = value - q0 * 256;
    let q1: i64 @Internal = q0 / 256;
    let b1: i64 @Internal = q0 - q1 * 256;
    let q2: i64 @Internal = q1 / 256;
    let b2: i64 @Internal = q1 - q2 * 256;
    let q3: i64 @Internal = q2 / 256;
    let b3: i64 @Internal = q2 - q3 * 256;

    store8(ptr, b0);
    store8(ptr + 1, b1);
    store8(ptr + 2, b2);
    store8(ptr + 3, b3);
    return 0;
}

fn read_u32(ptr: i64 @Internal) -> i64 @Internal ! {} {
    let b0: i64 @Internal = load8(ptr);
    let b1: i64 @Internal = load8(ptr + 1);
    let b2: i64 @Internal = load8(ptr + 2);
    let b3: i64 @Internal = load8(ptr + 3);
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
}

fn append_segment(
    out_ptr: i64 @Internal,
    out_len_in: i64 @Internal,
    file_ptr: i64 @Internal,
    start: i64 @Internal,
    end: i64 @Internal,
) -> i64 @Internal ! {} {
    let mut out_len: i64 @Internal = out_len_in;
    let mut i: i64 @Internal = start;

    while i < end {
        let b: i64 @Internal = load8(file_ptr + i);
        store8(out_ptr + out_len, b);
        out_len = out_len + 1;
        i = i + 1;
    }

    return out_len;
}

fn line_compare(
    file_ptr: i64 @Internal,
    a_start: i64 @Internal,
    a_end: i64 @Internal,
    b_start: i64 @Internal,
    b_end: i64 @Internal,
) -> i64 @Internal ! {} {
    let mut a: i64 @Internal = a_start;
    let mut b: i64 @Internal = b_start;
    let mut result: i64 @Internal = 0;
    let mut done: i64 @Internal = 0;

    while a < a_end {
        if b < b_end {
            if done == 0 {
                let ba: i64 @Internal = load8(file_ptr + a);
                let bb: i64 @Internal = load8(file_ptr + b);
                if ba < bb {
                    result = 0 - 1;
                    done = 1;
                } else {
                    if ba > bb {
                        result = 1;
                        done = 1;
                    } else {
                    }
                }
            } else {
            }
            a = a + 1;
            b = b + 1;
        } else {
            if done == 0 {
                result = 1;
                done = 1;
            } else {
            }
            a = a_end;
        }
    }

    if done == 0 {
        if b < b_end {
            result = 0 - 1;
        } else {
            result = 0;
        }
    } else {
    }

    return result;
}

pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { FsIO, Alloc, FFI, Unsafe } {
    let raw: i64 @Internal = fs_read(input_ptr, input_len);

    if raw < 0 {
        return raw;
    } else {
        let file_ptr: i64 @Internal = raw / 4294967296;
        let file_len: i64 @Internal = raw - file_ptr * 4294967296;
        let mut line_count: i64 @Internal = 0;
        let mut i: i64 @Internal = 0;

        while i < file_len {
            let b: i64 @Internal = load8(file_ptr + i);
            if b == 10 {
                line_count = line_count + 1;
            } else {
            }
            i = i + 1;
        }

        if file_len > 0 {
            let last: i64 @Internal = load8(file_ptr + file_len - 1);
            if last == 10 {
            } else {
                line_count = line_count + 1;
            }
        } else {
        }

        let meta_ptr: i64 @Internal = alloc(line_count * 8);
        let mut line_start: i64 @Internal = 0;
        let mut line_index: i64 @Internal = 0;
        i = 0;

        while i < file_len {
            let b: i64 @Internal = load8(file_ptr + i);
            if b == 10 {
                let slot: i64 @Internal = meta_ptr + line_index * 8;
                write_u32(slot, line_start);
                write_u32(slot + 4, i);
                line_index = line_index + 1;
                line_start = i + 1;
            } else {
            }
            i = i + 1;
        }

        if file_len > 0 {
            let last: i64 @Internal = load8(file_ptr + file_len - 1);
            if last == 10 {
            } else {
                let slot: i64 @Internal = meta_ptr + line_index * 8;
                write_u32(slot, line_start);
                write_u32(slot + 4, file_len);
            }
        } else {
        }

        let selected_ptr: i64 @Internal = alloc(line_count);
        let mut zero_i: i64 @Internal = 0;
        while zero_i < line_count {
            store8(selected_ptr + zero_i, 0);
            zero_i = zero_i + 1;
        }

        let out_ptr: i64 @Internal = alloc(file_len);
        let mut out_len: i64 @Internal = 0;
        let mut out_count: i64 @Internal = 0;
        let mut have_last: i64 @Internal = 0;
        let mut last_start: i64 @Internal = 0;
        let mut last_end: i64 @Internal = 0;

        while out_count < line_count {
            let mut best_index: i64 @Internal = line_count;
            let mut best_start: i64 @Internal = 0;
            let mut best_end: i64 @Internal = 0;
            let mut idx: i64 @Internal = 0;

            while idx < line_count {
                let sel: i64 @Internal = load8(selected_ptr + idx);
                if sel == 0 {
                    let slot: i64 @Internal = meta_ptr + idx * 8;
                    let cur_start: i64 @Internal = read_u32(slot);
                    let cur_end: i64 @Internal = read_u32(slot + 4);
                    if best_index == line_count {
                        best_index = idx;
                        best_start = cur_start;
                        best_end = cur_end;
                    } else {
                        let cmp: i64 @Internal =
                            line_compare(file_ptr, cur_start, cur_end, best_start, best_end);
                        if cmp < 0 {
                            best_index = idx;
                            best_start = cur_start;
                            best_end = cur_end;
                        } else {
                        }
                    }
                } else {
                }
                idx = idx + 1;
            }

            if have_last == 0 {
                out_len = append_segment(out_ptr, out_len, file_ptr, best_start, best_end);
                have_last = 1;
                last_start = best_start;
                last_end = best_end;
            } else {
                let cmp: i64 @Internal =
                    line_compare(file_ptr, best_start, best_end, last_start, last_end);
                if cmp == 0 {
                } else {
                    if out_len > 0 {
                        store8(out_ptr + out_len, 10);
                        out_len = out_len + 1;
                    } else {
                    }
                    out_len = append_segment(out_ptr, out_len, file_ptr, best_start, best_end);
                    last_start = best_start;
                    last_end = best_end;
                }
            }

            store8(selected_ptr + best_index, 1);
            out_count = out_count + 1;
        }

        return out_ptr * 4294967296 + out_len;
    }
}
