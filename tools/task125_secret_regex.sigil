// TASK: secret regex — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

// Validate @Secret input matches "[A-Z][0-9]{3}".
pub fn tool_main(input_ptr: i64 @Secret, input_len: i64 @Secret) -> i64 @Secret ! { Alloc } {
    let mut valid: i64 @Secret = 1;
    if input_len == 4 {
        let c0: i64 @Secret = load8(input_ptr);
        if c0 < 65 {
            valid = 0;
        } else {
            if c0 > 90 {
                valid = 0;
            } else {
            }
        }
        let mut i: i64 @Secret = 1;
        while i < 4 {
            let c: i64 @Secret = load8(input_ptr + i);
            if c < 48 {
                valid = 0;
            } else {
                if c > 57 {
                    valid = 0;
                } else {
                }
            }
            i = i + 1;
        }
    } else {
        valid = 0;
    }

    if valid == 1 {
        let out: i64 @Secret = alloc(5);
        store8(out, 118);
        store8(out + 1, 97);
        store8(out + 2, 108);
        store8(out + 3, 105);
        store8(out + 4, 100);
        return out * 4294967296 + 5;
    } else {
        let out: i64 @Secret = alloc(7);
        store8(out, 105);
        store8(out + 1, 110);
        store8(out + 2, 118);
        store8(out + 3, 97);
        store8(out + 4, 108);
        store8(out + 5, 105);
        store8(out + 6, 100);
        return out * 4294967296 + 7;
    }
}
