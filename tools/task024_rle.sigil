// TASK: rle — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

fn append_count(out_ptr: i64, out_len_in: i64, count: i64, scratch_ptr: i64) -> i64 {
    if count == 0 {
        return out_len_in;
    } else {
        let mut digits = 0;
        let mut n = count;

        while n > 0 {
            let q = n / 10;
            let digit = n - q * 10;
            store8(scratch_ptr + digits, 48 + digit);
            digits = digits + 1;
            n = q;
        }

        let mut out_len = out_len_in;
        let mut i = 0;

        while i < digits {
            let b = load8(scratch_ptr + digits - 1 - i);
            store8(out_ptr + out_len, b);
            out_len = out_len + 1;
            i = i + 1;
        }

        return out_len;
    }
}

fn append_run(out_ptr: i64, out_len_in: i64, byte: i64, count: i64, scratch_ptr: i64) -> i64 {
    let out_len = out_len_in + 1;
    store8(out_ptr + out_len_in, byte);
    return append_count(out_ptr, out_len, count, scratch_ptr);
}

pub fn tool_main(input_ptr: i64, input_len: i64) -> i64 ! { Alloc } {
    let out_ptr = alloc(input_len + input_len);
    let scratch_ptr = alloc(20);

    if input_len == 0 {
        return out_ptr * 4294967296;
    } else {
        let mut current = load8(input_ptr);
        let mut count = 1;
        let mut out_len = 0;
        let mut i = 1;

        while i < input_len {
            let b = load8(input_ptr + i);
            if b == current {
                count = count + 1;
            } else {
                out_len = append_run(out_ptr, out_len, current, count, scratch_ptr);
                current = b;
                count = 1;
            }
            i = i + 1;
        }

        out_len = append_run(out_ptr, out_len, current, count, scratch_ptr);
        return out_ptr * 4294967296 + out_len;
    }
}
