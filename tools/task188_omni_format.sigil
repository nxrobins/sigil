// TASK: omni format — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i32) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { FsIO, NetIO, Alloc, FFI, Unsafe }

#[ring(outer)] #[trusted] module tool;

extern "C" fn fs_read(path: i32, path_len: i32) -> i64 ! { FFI, Unsafe };
extern "C" fn http_get(url: i32, url_len: i32) -> i64 ! { FFI, Unsafe };

// Input "spec_path:url". Read format spec ("upper"/"lower"/"reverse"), fetch URL,
// apply transform.
pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { FsIO, NetIO, Alloc, FFI, Unsafe } {
    let zero_i32: i32 = input_len - input_len;
    let one_i32: i32 = input_len / input_len;

    let mut sep32: i32 = input_len;
    let mut scan: i32 = zero_i32;
    while scan < input_len {
        let b: i64 @Internal = load8(input_ptr + scan);
        if b == 58 {
            if sep32 == input_len {
                sep32 = scan;
            } else {
            }
        } else {
        }
        scan = scan + one_i32;
    }
    if sep32 == input_len {
        return 0 - 400;
    } else {
    }

    let raw_spec: i64 @Internal = fs_read(input_ptr, sep32);
    if raw_spec < 0 {
        return raw_spec;
    } else {
    }
    let spec_ptr: i64 @Internal = raw_spec / 4294967296;
    let spec_len: i64 @Internal = raw_spec - spec_ptr * 4294967296;

    // Check first byte: 'u'=upper, 'l'=lower, 'r'=reverse
    let mut mode: i64 @Internal = 0;
    if spec_len > 0 {
        let first: i64 @Internal = load8(spec_ptr);
        if first == 117 {
            mode = 1;
        } else {
            if first == 108 {
                mode = 2;
            } else {
                if first == 114 {
                    mode = 3;
                } else {
                }
            }
        }
    } else {
    }

    let url_off: i32 @Internal = sep32 + one_i32;
    let url_len: i32 @Internal = input_len - url_off;
    let raw_body: i64 @Internal = http_get(input_ptr + url_off, url_len);
    if raw_body < 0 {
        return raw_body;
    } else {
    }
    let body_ptr: i64 @Internal = raw_body / 4294967296;
    let body_len: i64 @Internal = raw_body - body_ptr * 4294967296;

    let out: i64 @Internal = alloc(body_len);
    let mut i: i64 @Internal = 0;
    while i < body_len {
        if mode == 1 {
            let b: i64 @Internal = load8(body_ptr + i);
            let mut r: i64 @Internal = b;
            if b > 96 {
                if b < 123 {
                    r = b - 32;
                } else {
                }
            } else {
            }
            store8(out + i, r);
        } else {
            if mode == 2 {
                let b: i64 @Internal = load8(body_ptr + i);
                let mut r: i64 @Internal = b;
                if b > 64 {
                    if b < 91 {
                        r = b + 32;
                    } else {
                    }
                } else {
                }
                store8(out + i, r);
            } else {
                if mode == 3 {
                    let src: i64 @Internal = body_ptr + body_len - 1 - i;
                    let b: i64 @Internal = load8(src);
                    store8(out + i, b);
                } else {
                    let b: i64 @Internal = load8(body_ptr + i);
                    store8(out + i, b);
                }
            }
        }
        i = i + 1;
    }
    return out * 4294967296 + body_len;
}
