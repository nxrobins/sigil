// TASK: omni encode query — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i32) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { FsIO, NetIO, Alloc, FFI, Unsafe }

#[ring(outer)] #[trusted] module tool;

extern "C" fn fs_read(path: i32, path_len: i32) -> i64 ! { FFI, Unsafe };
extern "C" fn http_get(url: i32, url_len: i32) -> i64 ! { FFI, Unsafe };

fn b64_char(n: i64 @Internal) -> i64 @Internal ! {} {
    if n < 26 {
        return 65 + n;
    } else {
        if n < 52 {
            return 97 + n - 26;
        } else {
            if n < 62 {
                return 48 + n - 52;
            } else {
                if n == 62 {
                    return 45;
                } else {
                    return 95;
                }
            }
        }
    }
}

// Input "data_path:url_base". Read file, base64-encode (urlsafe), append to URL, fetch.
pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { FsIO, NetIO, Alloc, FFI, Unsafe } {
    let zero_i32: i32 = input_len - input_len;
    let one_i32: i32 = input_len / input_len;

    let mut sep32: i32 = input_len;
    let mut scan: i32 = zero_i32;
    while scan < input_len {
        let b: i64 @Internal = load8(input_ptr + scan);
        if b == 58 {
            if sep32 == input_len {
                sep32 = scan;
            } else {
            }
        } else {
        }
        scan = scan + one_i32;
    }
    if sep32 == input_len {
        return 0 - 400;
    } else {
    }

    let raw: i64 @Internal = fs_read(input_ptr, sep32);
    if raw < 0 {
        return raw;
    } else {
    }
    let file_ptr: i64 @Internal = raw / 4294967296;
    let file_len: i64 @Internal = raw - file_ptr * 4294967296;

    // Copy URL prefix to input buffer
    let pref_off: i32 @Internal = sep32 + one_i32;
    let pref_len: i32 @Internal = input_len - pref_off;

    let mut out_i32: i32 @Internal = zero_i32;
    let mut pi: i32 @Internal = zero_i32;
    while pi < pref_len {
        let pb: i64 @Internal = load8(input_ptr + pref_off + pi);
        store8(input_ptr + out_i32, pb);
        out_i32 = out_i32 + one_i32;
        pi = pi + one_i32;
    }

    // Append base64 of file
    let mut i: i64 @Internal = 0;
    while i < file_len {
        let b0: i64 @Internal = load8(file_ptr + i);
        let mut b1: i64 @Internal = 0;
        let mut b2: i64 @Internal = 0;
        if i + 1 < file_len {
            b1 = load8(file_ptr + i + 1);
        } else {
        }
        if i + 2 < file_len {
            b2 = load8(file_ptr + i + 2);
        } else {
        }

        let v0: i64 @Internal = b0 / 4;
        let v0q: i64 @Internal = v0 * 4;
        let v1_hi: i64 @Internal = b0 - v0q;
        let b1_div16: i64 @Internal = b1 / 16;
        let v1: i64 @Internal = v1_hi * 16 + b1_div16;
        let b1_div16_times16: i64 @Internal = b1_div16 * 16;
        let v2_hi: i64 @Internal = b1 - b1_div16_times16;
        let b2_div64: i64 @Internal = b2 / 64;
        let v2: i64 @Internal = v2_hi * 4 + b2_div64;
        let b2_div64_times64: i64 @Internal = b2_div64 * 64;
        let v3: i64 @Internal = b2 - b2_div64_times64;

        store8(input_ptr + out_i32, b64_char(v0));
        out_i32 = out_i32 + one_i32;
        store8(input_ptr + out_i32, b64_char(v1));
        out_i32 = out_i32 + one_i32;
        store8(input_ptr + out_i32, b64_char(v2));
        out_i32 = out_i32 + one_i32;
        store8(input_ptr + out_i32, b64_char(v3));
        out_i32 = out_i32 + one_i32;
        i = i + 3;
    }

    return http_get(input_ptr, out_i32);
}
