// TASK: secret histogram — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

fn render_decimal(n_in: i64 @Secret) -> i64 @Secret ! { Alloc } {
    if n_in == 0 {
        let out: i64 @Secret = alloc(1);
        store8(out, 48);
        return out * 4294967296 + 1;
    } else {
        let scratch: i64 @Secret = alloc(20);
        let mut digits: i64 @Secret = 0;
        let mut n: i64 @Secret = n_in;
        while n > 0 {
            let q: i64 @Secret = n / 10;
            let d: i64 @Secret = n - q * 10;
            store8(scratch + digits, 48 + d);
            digits = digits + 1;
            n = q;
        }
        let out: i64 @Secret = alloc(digits);
        let mut i: i64 @Secret = 0;
        while i < digits {
            let b: i64 @Secret = load8(scratch + digits - 1 - i);
            store8(out + i, b);
            i = i + 1;
        }
        return out * 4294967296 + digits;
    }
}

// Accept @Secret input, compute histogram, return as "byte:count,..." @Secret.
pub fn tool_main(input_ptr: i64 @Secret, input_len: i64 @Secret) -> i64 @Secret ! { Alloc } {
    let counts: i64 @Secret = alloc(256);
    let mut k: i64 @Secret = 0;
    while k < 256 {
        store8(counts + k, 0);
        k = k + 1;
    }
    let mut i: i64 @Secret = 0;
    while i < input_len {
        let b: i64 @Secret = load8(input_ptr + i);
        let prev: i64 @Secret = load8(counts + b);
        store8(counts + b, prev + 1);
        i = i + 1;
    }

    // Emit sorted ascending: walk 0..256, emit "c:N," for nonzero.
    let out_buf: i64 @Secret = alloc(2048);
    let mut out_len: i64 @Secret = 0;
    let mut j: i64 @Secret = 0;
    while j < 256 {
        let c: i64 @Secret = load8(counts + j);
        if c > 0 {
            if out_len > 0 {
                store8(out_buf + out_len, 44); // ,
                out_len = out_len + 1;
            } else {
            }
            store8(out_buf + out_len, j);
            out_len = out_len + 1;
            store8(out_buf + out_len, 58); // :
            out_len = out_len + 1;
            let packed: i64 @Secret = render_decimal(c);
            let p_ptr: i64 @Secret = packed / 4294967296;
            let p_len: i64 @Secret = packed - p_ptr * 4294967296;
            let mut m: i64 @Secret = 0;
            while m < p_len {
                let db: i64 @Secret = load8(p_ptr + m);
                store8(out_buf + out_len, db);
                out_len = out_len + 1;
                m = m + 1;
            }
        } else {
        }
        j = j + 1;
    }

    return out_buf * 4294967296 + out_len;
}
