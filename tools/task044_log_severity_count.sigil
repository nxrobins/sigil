// TASK: log severity count — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i32) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { FsIO, Alloc, FFI, Unsafe }

#[ring(outer)] #[trusted] module tool;

extern "C" fn fs_read(path: i32, path_len: i32) -> i64 ! { FFI, Unsafe };

fn render_decimal(n_in: i64 @Internal) -> i64 @Internal ! { Alloc } {
    if n_in == 0 {
        let out_ptr: i64 @Internal = alloc(1);
        store8(out_ptr, 48);
        return out_ptr * 4294967296 + 1;
    } else {
        let scratch_ptr: i64 @Internal = alloc(20);
        let mut digits: i64 @Internal = 0;
        let mut n: i64 @Internal = n_in;

        while n > 0 {
            let q: i64 @Internal = n / 10;
            let digit: i64 @Internal = n - q * 10;
            store8(scratch_ptr + digits, 48 + digit);
            digits = digits + 1;
            n = q;
        }

        let out_ptr: i64 @Internal = alloc(digits);
        let mut i: i64 @Internal = 0;

        while i < digits {
            let b: i64 @Internal = load8(scratch_ptr + digits - 1 - i);
            store8(out_ptr + i, b);
            i = i + 1;
        }

        return out_ptr * 4294967296 + digits;
    }
}

fn append_ptr(
    out_ptr: i64 @Internal,
    out_len_in: i64 @Internal,
    src_ptr: i64 @Internal,
    src_len: i64 @Internal,
) -> i64 @Internal ! {} {
    let mut out_len: i64 @Internal = out_len_in;
    let mut i: i64 @Internal = 0;

    while i < src_len {
        let b: i64 @Internal = load8(src_ptr + i);
        store8(out_ptr + out_len, b);
        out_len = out_len + 1;
        i = i + 1;
    }

    return out_len;
}

fn severity_kind(file_ptr: i64 @Internal, start: i64 @Internal, end: i64 @Internal) -> i64 @Internal ! {} {
    let len: i64 @Internal = end - start;

    if len == 4 {
        if load8(file_ptr + start) == 73 {
            if load8(file_ptr + start + 1) == 78 {
                if load8(file_ptr + start + 2) == 70 {
                    if load8(file_ptr + start + 3) == 79 {
                        return 1;
                    } else {
                    }
                } else {
                }
            } else {
            }
        } else {
        }
    } else {
        if len == 5 {
            if load8(file_ptr + start) == 69 {
                if load8(file_ptr + start + 1) == 82 {
                    if load8(file_ptr + start + 2) == 82 {
                        if load8(file_ptr + start + 3) == 79 {
                            if load8(file_ptr + start + 4) == 82 {
                                return 2;
                            } else {
                            }
                        } else {
                        }
                    } else {
                    }
                } else {
                }
            } else {
            }
        } else {
        }
    }

    return 0;
}

pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { FsIO, Alloc, FFI, Unsafe } {
    let raw: i64 @Internal = fs_read(input_ptr, input_len);

    if raw < 0 {
        return raw;
    } else {
        let file_ptr: i64 @Internal = raw / 4294967296;
        let file_len: i64 @Internal = raw - file_ptr * 4294967296;
        let mut info_count: i64 @Internal = 0;
        let mut error_count: i64 @Internal = 0;
        let mut in_severity: i64 @Internal = 0;
        let mut severity_start: i64 @Internal = 0;
        let mut severity_end: i64 @Internal = 0;
        let mut field_index: i64 @Internal = 0;
        let mut i: i64 @Internal = 0;

        while i < file_len {
            let b: i64 @Internal = load8(file_ptr + i);

            if b == 10 {
                if in_severity == 1 {
                    severity_end = i;
                    in_severity = 0;
                    field_index = 2;
                } else {
                }

                if field_index >= 2 {
                    let kind: i64 @Internal = severity_kind(file_ptr, severity_start, severity_end);
                    if kind == 1 {
                        info_count = info_count + 1;
                    } else {
                        if kind == 2 {
                            error_count = error_count + 1;
                        } else {
                        }
                    }
                } else {
                }

                field_index = 0;
                severity_start = i + 1;
                severity_end = i + 1;
            } else {
                if b == 32 {
                    if field_index == 0 {
                        field_index = 1;
                        in_severity = 1;
                        severity_start = i + 1;
                    } else {
                        if field_index == 1 {
                            severity_end = i;
                            field_index = 2;
                            in_severity = 0;
                        } else {
                        }
                    }
                } else {
                }
            }

            i = i + 1;
        }

        if in_severity == 1 {
            severity_end = file_len;
            in_severity = 0;
            field_index = 2;
        } else {
        }

        if field_index >= 2 {
            let kind: i64 @Internal = severity_kind(file_ptr, severity_start, severity_end);
            if kind == 1 {
                info_count = info_count + 1;
            } else {
                if kind == 2 {
                    error_count = error_count + 1;
                } else {
                }
            }
        } else {
        }

        let info_raw: i64 @Internal = render_decimal(info_count);
        let info_ptr: i64 @Internal = info_raw / 4294967296;
        let info_len: i64 @Internal = info_raw - info_ptr * 4294967296;
        let error_raw: i64 @Internal = render_decimal(error_count);
        let error_ptr: i64 @Internal = error_raw / 4294967296;
        let error_len: i64 @Internal = error_raw - error_ptr * 4294967296;
        let out_len: i64 @Internal = 12 + info_len + error_len;
        let out_ptr: i64 @Internal = alloc(out_len);
        let mut out_i: i64 @Internal = 0;

        store8(out_ptr + out_i, 73);
        out_i = out_i + 1;
        store8(out_ptr + out_i, 78);
        out_i = out_i + 1;
        store8(out_ptr + out_i, 70);
        out_i = out_i + 1;
        store8(out_ptr + out_i, 79);
        out_i = out_i + 1;
        store8(out_ptr + out_i, 58);
        out_i = out_i + 1;
        out_i = append_ptr(out_ptr, out_i, info_ptr, info_len);
        store8(out_ptr + out_i, 44);
        out_i = out_i + 1;
        store8(out_ptr + out_i, 69);
        out_i = out_i + 1;
        store8(out_ptr + out_i, 82);
        out_i = out_i + 1;
        store8(out_ptr + out_i, 82);
        out_i = out_i + 1;
        store8(out_ptr + out_i, 79);
        out_i = out_i + 1;
        store8(out_ptr + out_i, 82);
        out_i = out_i + 1;
        store8(out_ptr + out_i, 58);
        out_i = out_i + 1;
        out_i = append_ptr(out_ptr, out_i, error_ptr, error_len);

        return out_ptr * 4294967296 + out_len;
    }
}
