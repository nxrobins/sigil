// TASK: count unique words — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i32) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { FsIO, Alloc, FFI, Unsafe }

#[ring(outer)] #[trusted] module tool;

extern "C" fn fs_read(path: i32, path_len: i32) -> i64 ! { FFI, Unsafe };

fn write_u32(ptr: i64 @Internal, value: i64 @Internal) -> i64 @Internal ! {} {
    let q0: i64 @Internal = value / 256;
    let b0: i64 @Internal = value - q0 * 256;
    let q1: i64 @Internal = q0 / 256;
    let b1: i64 @Internal = q0 - q1 * 256;
    let q2: i64 @Internal = q1 / 256;
    let b2: i64 @Internal = q1 - q2 * 256;
    let q3: i64 @Internal = q2 / 256;
    let b3: i64 @Internal = q2 - q3 * 256;

    store8(ptr, b0);
    store8(ptr + 1, b1);
    store8(ptr + 2, b2);
    store8(ptr + 3, b3);
    return 0;
}

fn read_u32(ptr: i64 @Internal) -> i64 @Internal ! {} {
    let b0: i64 @Internal = load8(ptr);
    let b1: i64 @Internal = load8(ptr + 1);
    let b2: i64 @Internal = load8(ptr + 2);
    let b3: i64 @Internal = load8(ptr + 3);
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
}

fn is_sep(b: i64 @Internal) -> i64 @Internal ! {} {
    if b == 32 {
        return 1;
    } else {
        if b == 10 {
            return 1;
        } else {
            if b == 13 {
                return 1;
            } else {
                if b == 9 {
                    return 1;
                } else {
                    return 0;
                }
            }
        }
    }
}

fn word_compare(
    file_ptr: i64 @Internal,
    a_start: i64 @Internal,
    a_end: i64 @Internal,
    b_start: i64 @Internal,
    b_end: i64 @Internal,
) -> i64 @Internal ! {} {
    let mut a: i64 @Internal = a_start;
    let mut b: i64 @Internal = b_start;
    let mut result: i64 @Internal = 0;
    let mut done: i64 @Internal = 0;

    while a < a_end {
        if b < b_end {
            if done == 0 {
                let ba: i64 @Internal = load8(file_ptr + a);
                let bb: i64 @Internal = load8(file_ptr + b);
                if ba < bb {
                    result = 0 - 1;
                    done = 1;
                } else {
                    if ba > bb {
                        result = 1;
                        done = 1;
                    } else {
                    }
                }
            } else {
            }
            a = a + 1;
            b = b + 1;
        } else {
            if done == 0 {
                result = 1;
                done = 1;
            } else {
            }
            a = a_end;
        }
    }

    if done == 0 {
        if b < b_end {
            result = 0 - 1;
        } else {
            result = 0;
        }
    } else {
    }

    return result;
}

fn render_decimal(n_in: i64 @Internal) -> i64 @Internal ! { Alloc } {
    if n_in == 0 {
        let out_ptr: i64 @Internal = alloc(1);
        store8(out_ptr, 48);
        return out_ptr * 4294967296 + 1;
    } else {
        let scratch_ptr: i64 @Internal = alloc(20);
        let mut digits: i64 @Internal = 0;
        let mut n: i64 @Internal = n_in;

        while n > 0 {
            let q: i64 @Internal = n / 10;
            let digit: i64 @Internal = n - q * 10;
            store8(scratch_ptr + digits, 48 + digit);
            digits = digits + 1;
            n = q;
        }

        let out_ptr: i64 @Internal = alloc(digits);
        let mut i: i64 @Internal = 0;

        while i < digits {
            let b: i64 @Internal = load8(scratch_ptr + digits - 1 - i);
            store8(out_ptr + i, b);
            i = i + 1;
        }

        return out_ptr * 4294967296 + digits;
    }
}

pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { FsIO, Alloc, FFI, Unsafe } {
    let raw: i64 @Internal = fs_read(input_ptr, input_len);

    if raw < 0 {
        return raw;
    } else {
        let file_ptr: i64 @Internal = raw / 4294967296;
        let file_len: i64 @Internal = raw - file_ptr * 4294967296;
        let mut word_count: i64 @Internal = 0;
        let mut in_word: i64 @Internal = 0;
        let mut i: i64 @Internal = 0;

        while i < file_len {
            let b: i64 @Internal = load8(file_ptr + i);
            if is_sep(b) == 1 {
                in_word = 0;
            } else {
                if in_word == 0 {
                    word_count = word_count + 1;
                    in_word = 1;
                } else {
                }
            }
            i = i + 1;
        }

        if word_count == 0 {
            return render_decimal(0);
        } else {
            let meta_ptr: i64 @Internal = alloc(word_count * 8);
            let mut word_start: i64 @Internal = 0;
            let mut word_index: i64 @Internal = 0;
            let mut saw_word: i64 @Internal = 0;
            i = 0;

            while i < file_len {
                let b: i64 @Internal = load8(file_ptr + i);
                if is_sep(b) == 1 {
                    if saw_word == 1 {
                        let slot: i64 @Internal = meta_ptr + word_index * 8;
                        write_u32(slot, word_start);
                        write_u32(slot + 4, i);
                        word_index = word_index + 1;
                        saw_word = 0;
                    } else {
                    }
                } else {
                    if saw_word == 0 {
                        word_start = i;
                        saw_word = 1;
                    } else {
                    }
                }
                i = i + 1;
            }

            if saw_word == 1 {
                let slot: i64 @Internal = meta_ptr + word_index * 8;
                write_u32(slot, word_start);
                write_u32(slot + 4, file_len);
            } else {
            }

            let mut unique_count: i64 @Internal = 0;
            let mut idx: i64 @Internal = 0;

            while idx < word_count {
                let slot: i64 @Internal = meta_ptr + idx * 8;
                let cur_start: i64 @Internal = read_u32(slot);
                let cur_end: i64 @Internal = read_u32(slot + 4);
                let cur_len: i64 @Internal = cur_end - cur_start;
                let mut seen_before: i64 @Internal = 0;
                let mut prev: i64 @Internal = 0;

                while prev < idx {
                    if seen_before == 0 {
                        let prev_slot: i64 @Internal = meta_ptr + prev * 8;
                        let prev_start: i64 @Internal = read_u32(prev_slot);
                        let prev_end: i64 @Internal = read_u32(prev_slot + 4);
                        let prev_len: i64 @Internal = prev_end - prev_start;

                        if cur_len == prev_len {
                            let mut same: i64 @Internal = 1;
                            let mut k: i64 @Internal = 0;

                            while k < cur_len {
                                if same == 1 {
                                    let a: i64 @Internal = load8(file_ptr + cur_start + k);
                                    let b: i64 @Internal = load8(file_ptr + prev_start + k);
                                    if a == b {
                                    } else {
                                        same = 0;
                                    }
                                } else {
                                }
                                k = k + 1;
                            }

                            if same == 1 {
                                seen_before = 1;
                            } else {
                            }
                        } else {
                        }
                    } else {
                    }
                    prev = prev + 1;
                }

                if seen_before == 0 {
                    unique_count = unique_count + 1;
                } else {
                }

                idx = idx + 1;
            }

            return render_decimal(unique_count);
        }
    }
}
