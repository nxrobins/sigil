// TASK: fs csv kv — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i32) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { FsIO, Alloc, FFI, Unsafe }

#[ring(outer)] #[trusted] module tool;

extern "C" fn fs_read(path: i32, path_len: i32) -> i64 ! { FFI, Unsafe };

// Input "path:col1:col2". Extract two columns from CSV, emit "key:value\n" for each data row.
pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { FsIO, Alloc, FFI, Unsafe } {
    let zero_i32: i32 = input_len - input_len;
    let one_i32: i32 = input_len / input_len;

    let mut sep1: i32 = input_len;
    let mut sep2: i32 = input_len;
    let mut scan: i32 = zero_i32;
    while scan < input_len {
        let b: i64 @Internal = load8(input_ptr + scan);
        if b == 58 {
            if sep1 == input_len {
                sep1 = scan;
            } else {
                if sep2 == input_len {
                    sep2 = scan;
                } else {
                }
            }
        } else {
        }
        scan = scan + one_i32;
    }
    if sep1 == input_len {
        return 0 - 400;
    } else {
    }
    if sep2 == input_len {
        return 0 - 400;
    } else {
    }

    let raw: i64 @Internal = fs_read(input_ptr, sep1);
    if raw < 0 {
        return raw;
    } else {
    }
    let file_ptr: i64 @Internal = raw / 4294967296;
    let file_len: i64 @Internal = raw - file_ptr * 4294967296;

    // Parse col1
    let mut col1: i64 @Internal = 0;
    let mut p: i32 @Internal = sep1 + one_i32;
    while p < sep2 {
        let cb: i64 @Internal = load8(input_ptr + p);
        if cb > 47 {
            if cb < 58 {
                col1 = col1 * 10 + cb - 48;
            } else {
            }
        } else {
        }
        p = p + one_i32;
    }
    // Parse col2
    let mut col2: i64 @Internal = 0;
    let mut p2: i32 @Internal = sep2 + one_i32;
    while p2 < input_len {
        let cb2: i64 @Internal = load8(input_ptr + p2);
        if cb2 > 47 {
            if cb2 < 58 {
                col2 = col2 * 10 + cb2 - 48;
            } else {
            }
        } else {
        }
        p2 = p2 + one_i32;
    }

    let out: i64 @Internal = alloc(file_len * 2);
    let mut out_len: i64 @Internal = 0;

    let mut row: i64 @Internal = 0;
    let mut col: i64 @Internal = 0;
    let mut cell_start: i64 @Internal = 0;
    let mut key_start: i64 @Internal = 0;
    let mut key_len: i64 @Internal = 0;
    let mut i: i64 @Internal = 0;
    while i <= file_len {
        let mut eol: i64 @Internal = 0;
        let mut sep_c: i64 @Internal = 0;
        if i == file_len {
            eol = 1;
        } else {
            let b: i64 @Internal = load8(file_ptr + i);
            if b == 10 {
                eol = 1;
            } else {
                if b == 44 {
                    sep_c = 1;
                } else {
                }
            }
        }
        if sep_c == 1 {
            if row > 0 {
                if col == col1 {
                    key_start = cell_start;
                    key_len = i - cell_start;
                } else {
                }
                if col == col2 {
                    // emit key:value
                    let mut k: i64 @Internal = 0;
                    while k < key_len {
                        let kb: i64 @Internal = load8(file_ptr + key_start + k);
                        store8(out + out_len, kb);
                        out_len = out_len + 1;
                        k = k + 1;
                    }
                    store8(out + out_len, 58);
                    out_len = out_len + 1;
                    let mut v: i64 @Internal = cell_start;
                    while v < i {
                        let vb: i64 @Internal = load8(file_ptr + v);
                        store8(out + out_len, vb);
                        out_len = out_len + 1;
                        v = v + 1;
                    }
                    store8(out + out_len, 10);
                    out_len = out_len + 1;
                } else {
                }
            } else {
            }
            col = col + 1;
            cell_start = i + 1;
        } else {
        }
        if eol == 1 {
            if row > 0 {
                if col == col2 {
                    let mut k2: i64 @Internal = 0;
                    while k2 < key_len {
                        let kb2: i64 @Internal = load8(file_ptr + key_start + k2);
                        store8(out + out_len, kb2);
                        out_len = out_len + 1;
                        k2 = k2 + 1;
                    }
                    store8(out + out_len, 58);
                    out_len = out_len + 1;
                    let mut v2: i64 @Internal = cell_start;
                    while v2 < i {
                        let vb2: i64 @Internal = load8(file_ptr + v2);
                        store8(out + out_len, vb2);
                        out_len = out_len + 1;
                        v2 = v2 + 1;
                    }
                    store8(out + out_len, 10);
                    out_len = out_len + 1;
                } else {
                }
            } else {
            }
            row = row + 1;
            col = 0;
            cell_start = i + 1;
            key_start = 0;
            key_len = 0;
        } else {
        }
        i = i + 1;
    }

    return out * 4294967296 + out_len;
}
