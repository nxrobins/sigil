    let a_ptr: i64 @Internal = raw_a / 4294967296;
    let a_len: i64 @Internal = raw_a - a_ptr * 4294967296;
    let b_ptr: i64 @Internal = raw_b / 4294967296;
    let b_len: i64 @Internal = raw_b - b_ptr * 4294967296;

    let mut same: i64 @Internal = 1;
    if a_len == b_len {
        let mut i: i64 @Internal = 0;
        while i < a_len {
            let ab: i64 @Internal = load8(a_ptr + i);
            let bb: i64 @Internal = load8(b_ptr + i);
            if ab == bb {
            } else {
                same = 0;
            }
            i = i + 1;
        }
    } else {
        same = 0;
    }

    if same == 1 {
        let out: i64 @Internal = alloc(9);
        store8(out, 105);
        store8(out + 1, 100);
        store8(out + 2, 101);
        store8(out + 3, 110);
        store8(out + 4, 116);
        store8(out + 5, 105);
        store8(out + 6, 99);
        store8(out + 7, 97);
        store8(out + 8, 108);
        return out * 4294967296 + 9;
    } else {
        let out: i64 @Internal = alloc(9);
        store8(out, 100);
        store8(out + 1, 105);
        store8(out + 2, 102);
        store8(out + 3, 102);
        store8(out + 4, 101);
        store8(out + 5, 114);
        store8(out + 6, 101);
        store8(out + 7, 110);
        store8(out + 8, 116);
        return out * 4294967296 + 9;
    }
}
