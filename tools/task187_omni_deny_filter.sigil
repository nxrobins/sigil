// TASK: omni deny filter — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i32) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { FsIO, NetIO, Alloc, FFI, Unsafe }

#[ring(outer)] #[trusted] module tool;

extern "C" fn fs_read(path: i32, path_len: i32) -> i64 ! { FFI, Unsafe };
extern "C" fn http_get(url: i32, url_len: i32) -> i64 ! { FFI, Unsafe };

// Input "denylist_path:url". Read denylist (one deny-word per line), fetch URL,
// return only lines that do NOT contain any deny word.
pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { FsIO, NetIO, Alloc, FFI, Unsafe } {
    let zero_i32: i32 = input_len - input_len;
    let one_i32: i32 = input_len / input_len;

    let mut sep32: i32 = input_len;
    let mut scan: i32 = zero_i32;
    while scan < input_len {
        let b: i64 @Internal = load8(input_ptr + scan);
        if b == 58 {
            if sep32 == input_len {
                sep32 = scan;
            } else {
            }
        } else {
        }
        scan = scan + one_i32;
    }
    if sep32 == input_len {
        return 0 - 400;
    } else {
    }

    let raw_deny: i64 @Internal = fs_read(input_ptr, sep32);
    if raw_deny < 0 {
        return raw_deny;
    } else {
    }
    let deny_ptr: i64 @Internal = raw_deny / 4294967296;
    let deny_len: i64 @Internal = raw_deny - deny_ptr * 4294967296;

    let url_off: i32 @Internal = sep32 + one_i32;
    let url_len: i32 @Internal = input_len - url_off;
    let raw_body: i64 @Internal = http_get(input_ptr + url_off, url_len);
    if raw_body < 0 {
        return raw_body;
    } else {
    }
    let body_ptr: i64 @Internal = raw_body / 4294967296;
    let body_len: i64 @Internal = raw_body - body_ptr * 4294967296;

    // For simplicity: single deny word on first line of deny file.
    let mut deny_word_len: i64 @Internal = deny_len;
    let mut dli: i64 @Internal = 0;
    while dli < deny_len {
        let db: i64 @Internal = load8(deny_ptr + dli);
        if db == 10 {
            if deny_word_len == deny_len {
                deny_word_len = dli;
            } else {
            }
        } else {
        }
        dli = dli + 1;
    }

    let out: i64 @Internal = alloc(body_len + 16);
    let mut out_len: i64 @Internal = 0;
    let mut line_start: i64 @Internal = 0;
    let mut i: i64 @Internal = 0;
    while i <= body_len {
        let mut eol: i64 @Internal = 0;
        if i == body_len {
            eol = 1;
        } else {
            let bx: i64 @Internal = load8(body_ptr + i);
            if bx == 10 {
                eol = 1;
            } else {
            }
        }
        if eol == 1 {
            let ln: i64 @Internal = i - line_start;
            if ln >= deny_word_len {
                let search_limit: i64 @Internal = ln - deny_word_len + 1;
                let mut contains: i64 @Internal = 0;
                let mut j: i64 @Internal = 0;
                while j < search_limit {
                    if contains == 0 {
                        let mut match_ok: i64 @Internal = 1;
                        let mut k: i64 @Internal = 0;
                        while k < deny_word_len {
                            let bb: i64 @Internal = load8(body_ptr + line_start + j + k);
                            let db2: i64 @Internal = load8(deny_ptr + k);
                            if bb == db2 {
                            } else {
                                match_ok = 0;
                            }
                            k = k + 1;
                        }
                        if match_ok == 1 {
                            contains = 1;
                        } else {
                        }
                    } else {
                    }
                    j = j + 1;
                }
                if contains == 0 {
                    if ln > 0 {
                        let mut m: i64 @Internal = 0;
                        while m < ln {
                            let mb: i64 @Internal = load8(body_ptr + line_start + m);
                            store8(out + out_len, mb);
                            out_len = out_len + 1;
                            m = m + 1;
                        }
                        store8(out + out_len, 10);
                        out_len = out_len + 1;
                    } else {
                    }
                } else {
                }
            } else {
                if ln > 0 {
                    let mut m2: i64 @Internal = 0;
                    while m2 < ln {
                        let mb2: i64 @Internal = load8(body_ptr + line_start + m2);
                        store8(out + out_len, mb2);
                        out_len = out_len + 1;
                        m2 = m2 + 1;
                    }
                    store8(out + out_len, 10);
                    out_len = out_len + 1;
                } else {
                }
            }
            line_start = i + 1;
        } else {
        }
        i = i + 1;
    }

    return out * 4294967296 + out_len;
}
