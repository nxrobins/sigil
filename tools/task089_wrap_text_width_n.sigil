// TASK: wrap text width n — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

pub fn tool_main(input_ptr: i64, input_len: i64) -> i64 ! { Alloc } {
    let zero = input_len - input_len;
    let one = input_len / input_len;
    let mut split = input_len;
    let mut scan = input_len;

    while scan > zero {
        let b = load8(input_ptr + scan - one);
        if split == input_len {
            if b == 58 {
                split = scan - one;
            } else {
            }
        } else {
        }
        scan = scan - one;
    }

    if split == input_len {
        return 0 - 400;
    } else {
        let mut width = 0;
        let mut saw_digit = 0;
        let mut width_scan = split + one;

        while width_scan < input_len {
            let b = load8(input_ptr + width_scan);
            if b >= 48 {
                if b <= 57 {
                    width = width * 10 + b - 48;
                    saw_digit = 1;
                } else {
                }
            } else {
            }
            width_scan = width_scan + one;
        }

        if saw_digit == 0 {
            return 0 - 400;
        } else {
            if width <= 0 {
                return 0 - 400;
            } else {
                let out_ptr = alloc(input_len + split);
                let mut out_len = 0;
                let mut line_len = 0;
                let mut i = 0;

                while i < split {
                    let b = load8(input_ptr + i);
                    store8(out_ptr + out_len, b);
                    out_len = out_len + 1;
                    line_len = line_len + 1;

                    if line_len == width {
                        if i + 1 < split {
                            store8(out_ptr + out_len, 10);
                            out_len = out_len + 1;
                            line_len = 0;
                        } else {
                        }
                    } else {
                    }

                    i = i + 1;
                }

                return out_ptr * 4294967296 + out_len;
            }
        }
    }
}
