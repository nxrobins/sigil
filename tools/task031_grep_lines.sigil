        } else {
            let pat_src: i32 @Internal = input_ptr + split + one;
            let mut pat_scan: i32 @Internal = pat_src;
            let mut pat_len: i64 @Internal = 0;

            while pat_scan < input_ptr + input_len {
                pat_len = pat_len + 1;
                pat_scan = pat_scan + one;
            }

            let pat_ptr: i64 @Internal = alloc(pat_len);
            let mut pat_copy_scan: i32 @Internal = pat_src;
            let mut pat_copy_len: i64 @Internal = 0;

            while pat_copy_scan < input_ptr + input_len {
                let b: i64 @Internal = load8(pat_copy_scan);
                store8(pat_ptr + pat_copy_len, b);
                pat_copy_len = pat_copy_len + 1;
                pat_copy_scan = pat_copy_scan + one;
            }

            let file_ptr: i64 @Internal = raw / 4294967296;
            let file_len: i64 @Internal = raw - file_ptr * 4294967296;
            let out_ptr: i64 @Internal = alloc(file_len);
            let mut out_len: i64 @Internal = 0;
            let mut line_start: i64 @Internal = 0;
            let mut line_matched: i64 @Internal = 0;
            let mut matched_count: i64 @Internal = 0;
            let mut first_pat: i64 @Internal = 0;
            let mut b: i64 @Internal = 0;
            let mut cur_pat: i64 @Internal = 0;
            let mut i: i64 @Internal = 0;

            if pat_len == 0 {
                line_matched = 1;
            } else {
                first_pat = load8(pat_ptr);
            }

            while i < file_len {
                b = load8(file_ptr + i);

                if b == 10 {
                    if line_matched == 1 {
                        out_len = append_segment(out_ptr, out_len, file_ptr, line_start, i + 1);
                    } else {
                    }
                    line_start = i + 1;
                    if pat_len == 0 {
                        line_matched = 1;
                    } else {
                        line_matched = 0;
                    }
                    matched_count = 0;
                } else {
                    if pat_len == 0 {
                    } else {
                        if line_matched == 0 {
                            cur_pat = load8(pat_ptr + matched_count);
                            if b == cur_pat {
                                matched_count = matched_count + 1;
                                if matched_count == pat_len {
                                    line_matched = 1;
                                } else {
                                }
                            } else {
                                if b == first_pat {
                                    matched_count = 1;
                                    if pat_len == 1 {
                                        line_matched = 1;
                                    } else {
                                    }
                                } else {
                                    matched_count = 0;
                                }
                            }
                        } else {
                        }
                    }
                }

                i = i + 1;
            }

            if line_start < file_len {
                if line_matched == 1 {
                    out_len = append_segment(out_ptr, out_len, file_ptr, line_start, file_len);
                } else {
                }
            } else {
            }

            return out_ptr * 4294967296 + out_len;
        }
    }
}
