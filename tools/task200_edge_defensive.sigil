// TASK: edge defensive — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

// Defensive: handle empty input, zero-length, weird byte values gracefully.
pub fn tool_main(input_ptr: i64, input_len: i64) -> i64 ! { Alloc } {
    if input_len == 0 {
        let out = alloc(2);
        store8(out, 111); // 'o'
        store8(out + 1, 107); // 'k'
        return out * 4294967296 + 2;
    } else {
    }

    // Iterate without failing on any byte
    let mut i: i64 = 0;
    while i < input_len {
        let b: i64 = load8(input_ptr + i);
        let _ignore: i64 = b;
        i = i + 1;
    }

    let out = alloc(2);
    store8(out, 111);
    store8(out + 1, 107);
    return out * 4294967296 + 2;
}
