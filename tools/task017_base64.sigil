// TASK: base64 — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

fn base64_char(v: i64) -> i64 {
    if v < 26 {
        return 65 + v;
    } else {
        if v < 52 {
            return 97 + v - 26;
        } else {
            if v < 62 {
                return 48 + v - 52;
            } else {
                if v == 62 {
                    return 43;
                } else {
                    return 47;
                }
            }
        }
    }
}

pub fn tool_main(input_ptr: i64, input_len: i64) -> i64 ! { Alloc } {
    let triples = input_len / 3;
    let rem = input_len - triples * 3;
    let mut out_len = triples * 4;

    if rem == 0 {
    } else {
        out_len = out_len + 4;
    }

    let out_ptr = alloc(out_len);
    let mut in_i = 0;
    let mut out_i = 0;
    let full_end = triples * 3;

    while in_i < full_end {
        let b0 = load8(input_ptr + in_i);
        let b1 = load8(input_ptr + in_i + 1);
        let b2 = load8(input_ptr + in_i + 2);
        let q0 = b0 / 4;
        let r0 = b0 - q0 * 4;
        let q1 = b1 / 16;
        let r1 = b1 - q1 * 16;
        let q2 = b2 / 64;
        let r2 = b2 - q2 * 64;
        let v0 = q0;
        let v1 = r0 * 16 + q1;
        let v2 = r1 * 4 + q2;
        let v3 = r2;

        store8(out_ptr + out_i, base64_char(v0));
        store8(out_ptr + out_i + 1, base64_char(v1));
        store8(out_ptr + out_i + 2, base64_char(v2));
        store8(out_ptr + out_i + 3, base64_char(v3));

        in_i = in_i + 3;
        out_i = out_i + 4;
    }

    if rem == 1 {
        let b0 = load8(input_ptr + in_i);
        let q0 = b0 / 4;
        let r0 = b0 - q0 * 4;
        let v0 = q0;
        let v1 = r0 * 16;

        store8(out_ptr + out_i, base64_char(v0));
        store8(out_ptr + out_i + 1, base64_char(v1));
        store8(out_ptr + out_i + 2, 61);
        store8(out_ptr + out_i + 3, 61);
    } else {
        if rem == 2 {
            let b0 = load8(input_ptr + in_i);
            let b1 = load8(input_ptr + in_i + 1);
            let q0 = b0 / 4;
            let r0 = b0 - q0 * 4;
            let q1 = b1 / 16;
            let r1 = b1 - q1 * 16;
            let v0 = q0;
            let v1 = r0 * 16 + q1;
            let v2 = r1 * 4;

            store8(out_ptr + out_i, base64_char(v0));
            store8(out_ptr + out_i + 1, base64_char(v1));
            store8(out_ptr + out_i + 2, base64_char(v2));
            store8(out_ptr + out_i + 3, 61);
        } else {
        }
    }

    return out_ptr * 4294967296 + out_len;
}
