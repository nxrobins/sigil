// TASK: secret parity — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

// Accept @Secret input, compute byte sum, return "even" or "odd" as @Secret.
pub fn tool_main(input_ptr: i64 @Secret, input_len: i64 @Secret) -> i64 @Secret ! { Alloc } {
    let mut sum: i64 @Secret = 0;
    let mut i: i64 @Secret = 0;
    while i < input_len {
        let b: i64 @Secret = load8(input_ptr + i);
        sum = sum + b;
        i = i + 1;
    }
    let half: i64 @Secret = sum / 2;
    let rem: i64 @Secret = sum - half * 2;
    if rem == 0 {
        let out: i64 @Secret = alloc(4);
        store8(out, 101); // e
        store8(out + 1, 118); // v
        store8(out + 2, 101); // e
        store8(out + 3, 110); // n
        return out * 4294967296 + 4;
    } else {
        let out: i64 @Secret = alloc(3);
        store8(out, 111); // o
        store8(out + 1, 100); // d
        store8(out + 2, 100); // d
        return out * 4294967296 + 3;
    }
}
