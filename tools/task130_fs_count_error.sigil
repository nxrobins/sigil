// TASK: fs count error — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i32) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { FsIO, Alloc, FFI, Unsafe }

#[ring(outer)] #[trusted] module tool;

extern "C" fn fs_read(path: i32, path_len: i32) -> i64 ! { FFI, Unsafe };

fn render_decimal(n_in: i64 @Internal) -> i64 @Internal ! { Alloc } {
    if n_in == 0 {
        let out: i64 @Internal = alloc(1);
        store8(out, 48);
        return out * 4294967296 + 1;
    } else {
        let scratch: i64 @Internal = alloc(20);
        let mut digits: i64 @Internal = 0;
        let mut n: i64 @Internal = n_in;
        while n > 0 {
            let q: i64 @Internal = n / 10;
            let d: i64 @Internal = n - q * 10;
            store8(scratch + digits, 48 + d);
            digits = digits + 1;
            n = q;
        }
        let out: i64 @Internal = alloc(digits);
        let mut i: i64 @Internal = 0;
        while i < digits {
            let b: i64 @Internal = load8(scratch + digits - 1 - i);
            store8(out + i, b);
            i = i + 1;
        }
        return out * 4294967296 + digits;
    }
}

// Count lines containing ERROR
pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { FsIO, Alloc, FFI, Unsafe } {
    let raw: i64 @Internal = fs_read(input_ptr, input_len);
    if raw < 0 {
        return raw;
    } else {
    }
    let file_ptr: i64 @Internal = raw / 4294967296;
    let file_len: i64 @Internal = raw - file_ptr * 4294967296;

    let mut count: i64 @Internal = 0;
    let mut line_start: i64 @Internal = 0;
    let mut i: i64 @Internal = 0;
    while i <= file_len {
        let mut eol: i64 @Internal = 0;
        if i == file_len {
            eol = 1;
        } else {
            let b: i64 @Internal = load8(file_ptr + i);
            if b == 10 {
                eol = 1;
            } else {
            }
        }
        if eol == 1 {
            let mut has: i64 @Internal = 0;
            let mut j: i64 @Internal = line_start;
            while j + 5 <= i {
                let c0: i64 @Internal = load8(file_ptr + j);
                let c1: i64 @Internal = load8(file_ptr + j + 1);
                let c2: i64 @Internal = load8(file_ptr + j + 2);
                let c3: i64 @Internal = load8(file_ptr + j + 3);
                let c4: i64 @Internal = load8(file_ptr + j + 4);
                if c0 == 69 {
                    if c1 == 82 {
                        if c2 == 82 {
                            if c3 == 79 {
                                if c4 == 82 {
                                    has = 1;
                                } else {
                                }
                            } else {
                            }
                        } else {
                        }
                    } else {
                    }
                } else {
                }
                j = j + 1;
            }
            if has == 1 {
                count = count + 1;
            } else {
            }
            line_start = i + 1;
        } else {
        }
        i = i + 1;
    }
    return render_decimal(count);
}
