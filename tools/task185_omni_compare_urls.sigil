// TASK: omni compare urls — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i32) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { FsIO, NetIO, Alloc, FFI, Unsafe }

#[ring(outer)] #[trusted] module tool;

extern "C" fn fs_read(path: i32, path_len: i32) -> i64 ! { FFI, Unsafe };
extern "C" fn http_get(url: i32, url_len: i32) -> i64 ! { FFI, Unsafe };

// Read 2 URLs (one per line) from file, fetch both, return "url1" if first
// has more bytes, else "url2".
pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { FsIO, NetIO, Alloc, FFI, Unsafe } {
    let raw: i64 @Internal = fs_read(input_ptr, input_len);
    if raw < 0 {
        return raw;
    } else {
    }
    let file_ptr: i64 @Internal = raw / 4294967296;
    let file_len: i64 @Internal = raw - file_ptr * 4294967296;

    // Find first newline
    let mut nl1: i64 @Internal = file_len;
    let mut i: i64 @Internal = 0;
    while i < file_len {
        let b: i64 @Internal = load8(file_ptr + i);
        if b == 10 {
            if nl1 == file_len {
                nl1 = i;
            } else {
            }
        } else {
        }
        i = i + 1;
    }

    let url1_len: i64 @Internal = nl1;
    let url2_start: i64 @Internal = nl1 + 1;
    let mut url2_end: i64 @Internal = file_len;
    // trim trailing newline
    if url2_end > url2_start {
        let last: i64 @Internal = load8(file_ptr + url2_end - 1);
        if last == 10 {
            url2_end = url2_end - 1;
        } else {
        }
    } else {
    }
    let url2_len: i64 @Internal = url2_end - url2_start;

    let zero_i32: i32 @Internal = input_len - input_len;
    let one_i32: i32 @Internal = input_len / input_len;

    // Copy URL1 to input buffer, fetch
    let mut out_i32: i32 @Internal = zero_i32;
    let mut j: i64 @Internal = 0;
    while j < url1_len {
        let bb: i64 @Internal = load8(file_ptr + j);
        store8(input_ptr + out_i32, bb);
        out_i32 = out_i32 + one_i32;
        j = j + 1;
    }
    let raw1: i64 @Internal = http_get(input_ptr, out_i32);
    if raw1 < 0 {
        return raw1;
    } else {
    }
    let body1_ptr: i64 @Internal = raw1 / 4294967296;
    let body1_len: i64 @Internal = raw1 - body1_ptr * 4294967296;

    // Copy URL2
    let mut out_i32b: i32 @Internal = zero_i32;
    let mut jj: i64 @Internal = 0;
    while jj < url2_len {
        let bb2: i64 @Internal = load8(file_ptr + url2_start + jj);
        store8(input_ptr + out_i32b, bb2);
        out_i32b = out_i32b + one_i32;
        jj = jj + 1;
    }
    let raw2: i64 @Internal = http_get(input_ptr, out_i32b);
    if raw2 < 0 {
        return raw2;
    } else {
    }
    let body2_ptr: i64 @Internal = raw2 / 4294967296;
    let body2_len: i64 @Internal = raw2 - body2_ptr * 4294967296;

    let out: i64 @Internal = alloc(4);
    store8(out, 117); // u
    store8(out + 1, 114); // r
    store8(out + 2, 108); // l
    if body1_len >= body2_len {
        store8(out + 3, 49);
    } else {
        store8(out + 3, 50);
    }
    return out * 4294967296 + 4;
}
