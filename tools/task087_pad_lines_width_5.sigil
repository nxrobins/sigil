// TASK: pad lines width 5 — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

fn append_segment(out_ptr: i64, out_len_in: i64, src_ptr: i64, start: i64, end: i64) -> i64 {
    let mut out_len = out_len_in;
    let mut i = start;

    while i < end {
        let b = load8(src_ptr + i);
        store8(out_ptr + out_len, b);
        out_len = out_len + 1;
        i = i + 1;
    }

    return out_len;
}

fn append_padding(out_ptr: i64, out_len_in: i64, line_len: i64) -> i64 {
    let mut out_len = out_len_in;
    let mut pad = line_len;

    while pad < 5 {
        store8(out_ptr + out_len, 32);
        out_len = out_len + 1;
        pad = pad + 1;
    }

    return out_len;
}

pub fn tool_main(input_ptr: i64, input_len: i64) -> i64 ! { Alloc } {
    let out_ptr = alloc(input_len * 3 + 16);
    let mut out_len = 0;
    let mut line_start = 0;
    let mut line_len = 0;
    let mut i = 0;

    while i < input_len {
        let b = load8(input_ptr + i);
        if b == 10 {
            out_len = append_segment(out_ptr, out_len, input_ptr, line_start, i);
            out_len = append_padding(out_ptr, out_len, line_len);
            if i + 1 < input_len {
                store8(out_ptr + out_len, 10);
                out_len = out_len + 1;
            } else {
            }
            line_start = i + 1;
            line_len = 0;
        } else {
            line_len = line_len + 1;
        }
        i = i + 1;
    }

    if line_start < input_len {
        out_len = append_segment(out_ptr, out_len, input_ptr, line_start, input_len);
        out_len = append_padding(out_ptr, out_len, line_len);
    } else {
    }

    return out_ptr * 4294967296 + out_len;
}
