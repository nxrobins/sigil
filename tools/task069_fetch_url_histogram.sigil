// TASK: fetch url histogram — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i32) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { NetIO, Alloc, FFI, Unsafe }

#[ring(outer)] #[trusted] module tool;

extern "C" fn http_get(url: i32, url_len: i32) -> i64 ! { FFI, Unsafe };

fn write_u32(ptr: i64 @Internal, value: i64 @Internal) -> i64 @Internal ! {} {
    let q0: i64 @Internal = value / 256;
    let b0: i64 @Internal = value - q0 * 256;
    let q1: i64 @Internal = q0 / 256;
    let b1: i64 @Internal = q0 - q1 * 256;
    let q2: i64 @Internal = q1 / 256;
    let b2: i64 @Internal = q1 - q2 * 256;
    let q3: i64 @Internal = q2 / 256;
    let b3: i64 @Internal = q2 - q3 * 256;

    store8(ptr, b0);
    store8(ptr + 1, b1);
    store8(ptr + 2, b2);
    store8(ptr + 3, b3);
    return 0;
}

fn read_u32(ptr: i64 @Internal) -> i64 @Internal ! {} {
    let b0: i64 @Internal = load8(ptr);
    let b1: i64 @Internal = load8(ptr + 1);
    let b2: i64 @Internal = load8(ptr + 2);
    let b3: i64 @Internal = load8(ptr + 3);
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
}

fn render_decimal(n_in: i64 @Internal) -> i64 @Internal ! { Alloc } {
    if n_in == 0 {
        let out_ptr: i64 @Internal = alloc(1);
        store8(out_ptr, 48);
        return out_ptr * 4294967296 + 1;
    } else {
        let scratch_ptr: i64 @Internal = alloc(20);
        let mut digits: i64 @Internal = 0;
        let mut n: i64 @Internal = n_in;

        while n > 0 {
            let q: i64 @Internal = n / 10;
            let digit: i64 @Internal = n - q * 10;
            store8(scratch_ptr + digits, 48 + digit);
            digits = digits + 1;
            n = q;
        }

        let out_ptr: i64 @Internal = alloc(digits);
        let mut i: i64 @Internal = 0;

        while i < digits {
            let b: i64 @Internal = load8(scratch_ptr + digits - 1 - i);
            store8(out_ptr + i, b);
            i = i + 1;
        }

        return out_ptr * 4294967296 + digits;
    }
}

fn append_ptr(
    out_ptr: i64 @Internal,
    out_len_in: i64 @Internal,
    src_ptr: i64 @Internal,
    src_len: i64 @Internal,
) -> i64 @Internal ! {} {
    let mut out_len: i64 @Internal = out_len_in;
    let mut i: i64 @Internal = 0;

    while i < src_len {
        let b: i64 @Internal = load8(src_ptr + i);
        store8(out_ptr + out_len, b);
        out_len = out_len + 1;
        i = i + 1;
    }

    return out_len;
}

pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { NetIO, Alloc, FFI, Unsafe } {
    let raw: i64 @Internal = http_get(input_ptr, input_len);

    if raw < 0 {
        return raw;
    } else {
        let body_ptr: i64 @Internal = raw / 4294967296;
        let body_len: i64 @Internal = raw - body_ptr * 4294967296;
        let counts_ptr: i64 @Internal = alloc(1024);
        let mut i: i64 @Internal = 0;

        while i < 256 {
            write_u32(counts_ptr + i * 4, 0);
            i = i + 1;
        }

        i = 0;
        while i < body_len {
            let b: i64 @Internal = load8(body_ptr + i);
            let slot: i64 @Internal = counts_ptr + b * 4;
            let count: i64 @Internal = read_u32(slot);
            write_u32(slot, count + 1);
            i = i + 1;
        }

        let out_ptr: i64 @Internal = alloc(6144);
        let mut out_len: i64 @Internal = 0;
        let mut wrote_any: i64 @Internal = 0;
        let mut byte_val: i64 @Internal = 0;

        while byte_val < 256 {
            let count: i64 @Internal = read_u32(counts_ptr + byte_val * 4);
            if count > 0 {
                if wrote_any == 1 {
                    store8(out_ptr + out_len, 44);
                    out_len = out_len + 1;
                } else {
                }
                store8(out_ptr + out_len, byte_val);
                out_len = out_len + 1;
                store8(out_ptr + out_len, 58);
                out_len = out_len + 1;
                let digits: i64 @Internal = render_decimal(count);
                let digits_ptr: i64 @Internal = digits / 4294967296;
                let digits_len: i64 @Internal = digits - digits_ptr * 4294967296;
                out_len = append_ptr(out_ptr, out_len, digits_ptr, digits_len);
                wrote_any = 1;
            } else {
            }
            byte_val = byte_val + 1;
        }

        return out_ptr * 4294967296 + out_len;
    }
}
