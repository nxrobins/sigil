// TASK: word frequency — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

fn write_u32(ptr: i64, value: i64) -> i64 {
    let q0 = value / 256;
    let b0 = value - q0 * 256;
    let q1 = q0 / 256;
    let b1 = q0 - q1 * 256;
    let q2 = q1 / 256;
    let b2 = q1 - q2 * 256;
    let q3 = q2 / 256;
    let b3 = q2 - q3 * 256;

    store8(ptr, b0);
    store8(ptr + 1, b1);
    store8(ptr + 2, b2);
    store8(ptr + 3, b3);
    return 0;
}

fn read_u32(ptr: i64) -> i64 {
    let b0 = load8(ptr);
    let b1 = load8(ptr + 1);
    let b2 = load8(ptr + 2);
    let b3 = load8(ptr + 3);
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
}

fn is_sep(b: i64) -> i64 {
    if b == 32 {
        return 1;
    } else {
        if b == 10 {
            return 1;
        } else {
            if b == 13 {
                return 1;
            } else {
                if b == 9 {
                    return 1;
                } else {
                    return 0;
                }
            }
        }
    }
}

fn append_segment(out_ptr: i64, out_len_in: i64, src_ptr: i64, start: i64, end: i64) -> i64 {
    let mut out_len = out_len_in;
    let mut i = start;

    while i < end {
        let b = load8(src_ptr + i);
        store8(out_ptr + out_len, b);
        out_len = out_len + 1;
        i = i + 1;
    }

    return out_len;
}

fn word_equal(src_ptr: i64, a_start: i64, a_end: i64, b_start: i64, b_end: i64) -> i64 {
    let a_len = a_end - a_start;
    let b_len = b_end - b_start;

    if a_len == b_len {
        let mut same = 1;
        let mut k = 0;

        while k < a_len {
            if same == 1 {
                let a = load8(src_ptr + a_start + k);
                let b = load8(src_ptr + b_start + k);
                if a == b {
                } else {
                    same = 0;
                }
            } else {
            }
            k = k + 1;
        }

        return same;
    } else {
        return 0;
    }
}

fn append_decimal(out_ptr: i64, out_len_in: i64, n_in: i64, scratch_ptr: i64) -> i64 {
    if n_in == 0 {
        store8(out_ptr + out_len_in, 48);
        return out_len_in + 1;
    } else {
        let mut digits = 0;
        let mut n = n_in;

        while n > 0 {
            let q = n / 10;
            let digit = n - q * 10;
            store8(scratch_ptr + digits, 48 + digit);
            digits = digits + 1;
            n = q;
        }

        let mut out_len = out_len_in;
        let mut i = 0;

        while i < digits {
            let b = load8(scratch_ptr + digits - 1 - i);
            store8(out_ptr + out_len, b);
            out_len = out_len + 1;
            i = i + 1;
        }

        return out_len;
    }
}

pub fn tool_main(input_ptr: i64, input_len: i64) -> i64 ! { Alloc } {
    if input_len == 0 {
        let out_ptr = alloc(0);
        return out_ptr * 4294967296;
    } else {
        let mut word_count = 0;
        let mut in_word = 0;
        let mut i = 0;

        while i < input_len {
            let b = load8(input_ptr + i);
            if is_sep(b) == 1 {
                in_word = 0;
            } else {
                if in_word == 0 {
                    word_count = word_count + 1;
                    in_word = 1;
                } else {
                }
            }
            i = i + 1;
        }

        if word_count == 0 {
            let out_ptr = alloc(0);
            return out_ptr * 4294967296;
        } else {
            let meta_ptr = alloc(word_count * 8);
            let scratch_ptr = alloc(20);
            let mut word_start = 0;
            let mut word_index = 0;
            let mut saw_word = 0;
            i = 0;

            while i < input_len {
                let b = load8(input_ptr + i);
                if is_sep(b) == 1 {
                    if saw_word == 1 {
                        let slot = meta_ptr + word_index * 8;
                        write_u32(slot, word_start);
                        write_u32(slot + 4, i);
                        word_index = word_index + 1;
                        saw_word = 0;
                    } else {
                    }
                } else {
                    if saw_word == 0 {
                        word_start = i;
                        saw_word = 1;
                    } else {
                    }
                }
                i = i + 1;
            }

            if saw_word == 1 {
                let slot = meta_ptr + word_index * 8;
                write_u32(slot, word_start);
                write_u32(slot + 4, input_len);
            } else {
            }

            let out_ptr = alloc(input_len * 3 + 32);
            let mut out_len = 0;
            let mut wrote_any = 0;
            let mut idx = 0;

            while idx < word_count {
                let slot = meta_ptr + idx * 8;
                let cur_start = read_u32(slot);
                let cur_end = read_u32(slot + 4);
                let mut seen_before = 0;
                let mut prev = 0;

                while prev < idx {
                    if seen_before == 0 {
                        let prev_slot = meta_ptr + prev * 8;
                        let prev_start = read_u32(prev_slot);
                        let prev_end = read_u32(prev_slot + 4);
                        if word_equal(input_ptr, cur_start, cur_end, prev_start, prev_end) == 1 {
                            seen_before = 1;
                        } else {
                        }
                    } else {
                    }
                    prev = prev + 1;
                }

                if seen_before == 0 {
                    let mut count = 0;
                    let mut scan = idx;

                    while scan < word_count {
                        let scan_slot = meta_ptr + scan * 8;
                        let scan_start = read_u32(scan_slot);
                        let scan_end = read_u32(scan_slot + 4);
                        if word_equal(input_ptr, cur_start, cur_end, scan_start, scan_end) == 1 {
                            count = count + 1;
                        } else {
                        }
                        scan = scan + 1;
                    }

                    if wrote_any == 1 {
                        store8(out_ptr + out_len, 44);
                        out_len = out_len + 1;
                    } else {
                    }

                    out_len = append_segment(out_ptr, out_len, input_ptr, cur_start, cur_end);
                    store8(out_ptr + out_len, 58);
                    out_len = out_len + 1;
                    out_len = append_decimal(out_ptr, out_len, count, scratch_ptr);
                    wrote_any = 1;
                } else {
                }

                idx = idx + 1;
            }

            return out_ptr * 4294967296 + out_len;
        }
    }
}
