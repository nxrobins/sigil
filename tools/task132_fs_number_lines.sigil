// TASK: fs number lines — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i32) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { FsIO, Alloc, FFI, Unsafe }

#[ring(outer)] #[trusted] module tool;

extern "C" fn fs_read(path: i32, path_len: i32) -> i64 ! { FFI, Unsafe };

// Read a file, prepend "N: " to each line.
pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { FsIO, Alloc, FFI, Unsafe } {
    let raw: i64 @Internal = fs_read(input_ptr, input_len);
    if raw < 0 {
        return raw;
    } else {
    }
    let file_ptr: i64 @Internal = raw / 4294967296;
    let file_len: i64 @Internal = raw - file_ptr * 4294967296;

    let out: i64 @Internal = alloc(file_len + 256);
    let mut out_len: i64 @Internal = 0;
    let mut line_no: i64 @Internal = 1;
    let mut line_start: i64 @Internal = 0;
    let mut i: i64 @Internal = 0;

    while i <= file_len {
        let mut at_end: i64 @Internal = 0;
        if i == file_len {
            at_end = 1;
        } else {
        }
        let mut is_nl: i64 @Internal = 0;
        if i < file_len {
            let b: i64 @Internal = load8(file_ptr + i);
            if b == 10 {
                is_nl = 1;
            } else {
            }
        } else {
        }
        if is_nl == 1 {
            // render line_no
            if line_no < 10 {
                store8(out + out_len, 48 + line_no);
                out_len = out_len + 1;
            } else {
                let hi: i64 @Internal = line_no / 10;
                let lo: i64 @Internal = line_no - hi * 10;
                store8(out + out_len, 48 + hi);
                out_len = out_len + 1;
                store8(out + out_len, 48 + lo);
                out_len = out_len + 1;
            }
            store8(out + out_len, 58);
            out_len = out_len + 1;
            store8(out + out_len, 32);
            out_len = out_len + 1;
            let mut k: i64 @Internal = line_start;
            while k < i {
                let lb: i64 @Internal = load8(file_ptr + k);
                store8(out + out_len, lb);
                out_len = out_len + 1;
                k = k + 1;
            }
            store8(out + out_len, 10);
            out_len = out_len + 1;
            line_start = i + 1;
            line_no = line_no + 1;
        } else {
        }
        if at_end == 1 {
            return out * 4294967296 + out_len;
        } else {
        }
        i = i + 1;
    }
    return out * 4294967296 + out_len;
}
