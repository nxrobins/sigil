// TASK: fetch url count byte — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i32) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { NetIO, Alloc, FFI, Unsafe }

#[ring(outer)] #[trusted] module tool;

extern "C" fn http_get(url: i32, url_len: i32) -> i64 ! { FFI, Unsafe };

fn hex_value(b: i64 @Internal) -> i64 @Internal ! {} {
    if b >= 48 {
        if b <= 57 {
            return b - 48;
        } else {
        }
    } else {
    }

    if b >= 97 {
        if b <= 102 {
            return 10 + b - 97;
        } else {
        }
    } else {
    }

    if b >= 65 {
        if b <= 70 {
            return 10 + b - 65;
        } else {
        }
    } else {
    }

    return 0 - 1;
}

fn render_decimal(n_in: i64 @Internal) -> i64 @Internal ! { Alloc } {
    if n_in == 0 {
        let out_ptr: i64 @Internal = alloc(1);
        store8(out_ptr, 48);
        return out_ptr * 4294967296 + 1;
    } else {
        let scratch_ptr: i64 @Internal = alloc(20);
        let mut digits: i64 @Internal = 0;
        let mut n: i64 @Internal = n_in;

        while n > 0 {
            let q: i64 @Internal = n / 10;
            let digit: i64 @Internal = n - q * 10;
            store8(scratch_ptr + digits, 48 + digit);
            digits = digits + 1;
            n = q;
        }

        let out_ptr: i64 @Internal = alloc(digits);
        let mut i: i64 @Internal = 0;

        while i < digits {
            let b: i64 @Internal = load8(scratch_ptr + digits - 1 - i);
            store8(out_ptr + i, b);
            i = i + 1;
        }

        return out_ptr * 4294967296 + digits;
    }
}

pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { NetIO, Alloc, FFI, Unsafe } {
    let zero = input_len - input_len;
    let one = input_len / input_len;
    let mut split = input_len;
    let mut scan = input_len;

    while scan > zero {
        let b = load8(input_ptr + scan - one);
        if split == input_len {
            if b == 58 {
                split = scan - one;
            } else {
            }
        } else {
        }
        scan = scan - one;
    }

    if split == input_len {
        return 0 - 400;
    } else {
        let raw: i64 @Internal = http_get(input_ptr, split);

        if raw < 0 {
            return raw;
        } else {
            let mut parse_ptr: i32 @Internal = input_ptr + split + one;
            let parse_end: i32 @Internal = input_ptr + input_len;

            if parse_ptr + one < parse_end {
                if load8(parse_ptr) == 48 {
                    if load8(parse_ptr + one) == 120 {
                        parse_ptr = parse_ptr + one + one;
                    } else {
                    }
                } else {
                }
            } else {
            }

            let mut value: i64 @Internal = 0;
            let mut saw_digit: i64 @Internal = 0;

            while parse_ptr < parse_end {
                let h: i64 @Internal = hex_value(load8(parse_ptr));
                if h >= 0 {
                    value = value * 16 + h;
                    saw_digit = 1;
                } else {
                }
                parse_ptr = parse_ptr + one;
            }

            if saw_digit == 0 {
                return 0 - 400;
            } else {
                let body_ptr: i64 @Internal = raw / 4294967296;
                let body_len: i64 @Internal = raw - body_ptr * 4294967296;
                let mut count: i64 @Internal = 0;
                let mut i: i64 @Internal = 0;

                while i < body_len {
                    let b: i64 @Internal = load8(body_ptr + i);
                    if b == value {
                        count = count + 1;
                    } else {
                    }
                    i = i + 1;
                }

                return render_decimal(count);
            }
        }
    }
}
