// TASK: secret policy — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

// Accept @Secret password + @Public policy ("password\nmin_len"), return "strong"/"weak" as @Secret.
// Strong = length >= min_len AND has upper AND has digit AND has special.
pub fn tool_main(input_ptr: i64 @Secret, input_len: i64 @Secret) -> i64 @Secret ! { Alloc } {
    let mut sep: i64 @Secret = 0 - 1;
    let mut i: i64 @Secret = 0;
    while i < input_len {
        let b: i64 @Secret = load8(input_ptr + i);
        if sep < 0 {
            if b == 10 {
                sep = i;
            } else {
            }
        } else {
        }
        i = i + 1;
    }

    let pw_len: i64 @Secret = sep;

    // Parse min_len after sep+1
    let mut min_len: i64 @Secret = 0;
    let mut p: i64 @Secret = sep + 1;
    while p < input_len {
        let c: i64 @Secret = load8(input_ptr + p);
        if c > 47 {
            if c < 58 {
                min_len = min_len * 10 + c - 48;
            } else {
            }
        } else {
        }
        p = p + 1;
    }

    let mut has_upper: i64 @Secret = 0;
    let mut has_digit: i64 @Secret = 0;
    let mut has_special: i64 @Secret = 0;
    let mut k: i64 @Secret = 0;
    while k < pw_len {
        let b: i64 @Secret = load8(input_ptr + k);
        if b > 64 {
            if b < 91 {
                has_upper = 1;
            } else {
            }
        } else {
        }
        if b > 47 {
            if b < 58 {
                has_digit = 1;
            } else {
            }
        } else {
        }
        if b == 33 {
            has_special = 1;
        } else {
        }
        if b == 64 {
            has_special = 1;
        } else {
        }
        if b == 35 {
            has_special = 1;
        } else {
        }
        if b == 36 {
            has_special = 1;
        } else {
        }
        k = k + 1;
    }

    let mut strong: i64 @Secret = 0;
    if pw_len >= min_len {
        if has_upper == 1 {
            if has_digit == 1 {
                if has_special == 1 {
                    strong = 1;
                } else {
                }
            } else {
            }
        } else {
        }
    } else {
    }

    if strong == 1 {
        let out: i64 @Secret = alloc(6);
        store8(out, 115);
        store8(out + 1, 116);
        store8(out + 2, 114);
        store8(out + 3, 111);
        store8(out + 4, 110);
        store8(out + 5, 103);
        return out * 4294967296 + 6;
    } else {
        let out: i64 @Secret = alloc(4);
        store8(out, 119);
        store8(out + 1, 101);
        store8(out + 2, 97);
        store8(out + 3, 107);
        return out * 4294967296 + 4;
    }
}
