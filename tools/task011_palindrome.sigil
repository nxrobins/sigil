// TASK: palindrome — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { Alloc }

module tool;

pub fn tool_main(input_ptr: i64, input_len: i64) -> i64 ! { Alloc } {
    let mut left = 0;
    let mut right = 0;
    let mut is_pal = 1;

    if input_len > 0 {
        right = input_len - 1;
    } else {
    }

    while left < right {
        let a = load8(input_ptr + left);
        let b = load8(input_ptr + right);

        if a == b {
        } else {
            is_pal = 0;
        }

        left = left + 1;
        right = right - 1;
    }

    if is_pal == 1 {
        let out_ptr = alloc(4);
        store8(out_ptr, 116);
        store8(out_ptr + 1, 114);
        store8(out_ptr + 2, 117);
        store8(out_ptr + 3, 101);
        return out_ptr * 4294967296 + 4;
    } else {
        let out_ptr = alloc(5);
        store8(out_ptr, 102);
        store8(out_ptr + 1, 97);
        store8(out_ptr + 2, 108);
        store8(out_ptr + 3, 115);
        store8(out_ptr + 4, 101);
        return out_ptr * 4294967296 + 5;
    }
}
