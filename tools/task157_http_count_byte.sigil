// TASK: http count byte — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i32) point at the host-allocated input buffer.
// OUTPUT: `i64` — packed result. Most tools pack `(len << 32) | ptr` for a buffer result, or return a single integer for arithmetic/counting tools. See the body for the exact encoding.
// EFFECTS: ! { NetIO, Alloc, FFI, Unsafe }

#[ring(outer)] #[trusted] module tool;

extern "C" fn http_get(url: i32, url_len: i32) -> i64 ! { FFI, Unsafe };

fn render_decimal(n_in: i64 @Internal) -> i64 @Internal ! { Alloc } {
    if n_in == 0 {
        let out: i64 @Internal = alloc(1);
        store8(out, 48);
        return out * 4294967296 + 1;
    } else {
        let scratch: i64 @Internal = alloc(20);
        let mut digits: i64 @Internal = 0;
        let mut n: i64 @Internal = n_in;
        while n > 0 {
            let q: i64 @Internal = n / 10;
            let d: i64 @Internal = n - q * 10;
            store8(scratch + digits, 48 + d);
            digits = digits + 1;
            n = q;
        }
        let out: i64 @Internal = alloc(digits);
        let mut i: i64 @Internal = 0;
        while i < digits {
            let b: i64 @Internal = load8(scratch + digits - 1 - i);
            store8(out + i, b);
            i = i + 1;
        }
        return out * 4294967296 + digits;
    }
}

// Input "url:<decimal byte value>". Count occurrences of that byte in response.
pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { NetIO, Alloc, FFI, Unsafe } {
    let zero_i32: i32 = input_len - input_len;
    let one_i32: i32 = input_len / input_len;

    // Find the LAST ':' — URL may contain multiple colons (scheme, port).
    let mut sep32: i32 = input_len;
    let mut scan: i32 = zero_i32;
    while scan < input_len {
        let b: i64 @Internal = load8(input_ptr + scan);
        if b == 58 {
            sep32 = scan;
        } else {
        }
        scan = scan + one_i32;
    }
    if sep32 == input_len {
        return 0 - 400;
    } else {
    }

    // The URL is from 0..sep32; the byte value from sep32+1..end.
    // But URLs have colons too. Instead, the last colon must come after "://".
    // We assume the tail is always a decimal number.

    let raw: i64 @Internal = http_get(input_ptr, sep32);
    if raw < 0 {
        return raw;
    } else {
    }
    let body_ptr: i64 @Internal = raw / 4294967296;
    let body_len: i64 @Internal = raw - body_ptr * 4294967296;

    let mut target: i64 @Internal = 0;
    let mut p: i32 @Internal = sep32 + one_i32;
    while p < input_len {
        let cb: i64 @Internal = load8(input_ptr + p);
        if cb > 47 {
            if cb < 58 {
                target = target * 10 + cb - 48;
            } else {
            }
        } else {
        }
        p = p + one_i32;
    }

    let mut count: i64 @Internal = 0;
    let mut i: i64 @Internal = 0;
    while i < body_len {
        let b: i64 @Internal = load8(body_ptr + i);
        if b == target {
            count = count + 1;
        } else {
        }
        i = i + 1;
    }
    return render_decimal(count);
}
