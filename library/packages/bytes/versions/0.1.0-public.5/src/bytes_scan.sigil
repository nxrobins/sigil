// Public raw-byte readers; scalar/range failures refuse before memory access.
module bytes_scan;

pub fn find_byte(ptr: i64, len: i64, offset: i64, value: i64) -> i64 {
    if ptr < 0 || len < 0 || offset < 0 { return -400; } else {}
    if ptr > 2147483647 || len > 2147483647 || offset > len { return -413; } else {}
    if len > 2147483647 - ptr { return -413; } else {}
    if value < 0 || value > 255 { return -422; } else {}
    let mut i = offset;
    while i < len {
        if load8(ptr + i) == value { return i; } else {}
        i = i + 1;
    }
    return -1;
}

pub fn equal(a_ptr: i64, a_len: i64, b_ptr: i64, b_len: i64) -> i64 {
    if a_ptr < 0 || a_len < 0 || b_ptr < 0 || b_len < 0 { return -400; } else {}
    if a_ptr > 2147483647 || a_len > 2147483647 || b_ptr > 2147483647 || b_len > 2147483647 {
        return -413;
    } else {}
    if a_len > 2147483647 - a_ptr || b_len > 2147483647 - b_ptr { return -413; } else {}
    if a_len != b_len { return 0; } else {}
    let mut i = 0;
    while i < a_len {
        if load8(a_ptr + i) != load8(b_ptr + i) { return 0; } else {}
        i = i + 1;
    }
    return 1;
}
