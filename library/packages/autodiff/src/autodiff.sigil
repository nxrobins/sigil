// Fixed-capacity scalar reverse mode; only constructors allocate, no host authority.
module autodiff;
use sigil::vec;

record Tape {
    values: Vec<f64>, gradients: Vec<f64>, scratch: Vec<f64>,
    operations: Vec<i64>, left: Vec<i64>, right: Vec<i64>, terms: Vec<i64>,
    capacity: i64, sum_capacity: i64, used: i64, sum_used: i64,
    identity: i64, epoch: i64, error: i64, ready: bool,
    last_root: i64, last_sweep: i64
}
record TapeCell { value: f64 }

fn finite(value: f64) -> bool { return value - value == 0.0; }

pub fn new_tape(node_capacity: i64, sum_capacity: i64) -> Tape ! { Alloc } {
    let mut size = node_capacity;
    let mut edges = sum_capacity;
    let mut error = 0;
    if size < 1 || edges < 0 { error = -400; } else {}
    if error == 0 && (size > 4096 || edges > 4096) { error = -413; } else {}
    if error < 0 { size = 0; edges = 0; } else {}
    let values: Vec<f64> = Vec::with_capacity(size);
    let gradients: Vec<f64> = Vec::with_capacity(size);
    let scratch: Vec<f64> = Vec::with_capacity(size);
    let operations: Vec<i64> = Vec::with_capacity(size);
    let left: Vec<i64> = Vec::with_capacity(size);
    let right: Vec<i64> = Vec::with_capacity(size);
    let terms: Vec<i64> = Vec::with_capacity(edges);
    let mut i = 0;
    while i < size {
        values.push(0.0); gradients.push(0.0); scratch.push(0.0);
        operations.push(0); left.push(0); right.push(0); i = i + 1;
    }
    i = 0;
    while i < edges { terms.push(0); i = i + 1; }
    // A live allocator-owned marker separates tapes in this runtime. Epochs
    // separate resets; handles are execution-local tokens, not portable node IDs.
    let identity = alloc(8);
    return Tape { values: values, gradients: gradients, scratch: scratch,
        operations: operations, left: left, right: right, terms: terms,
        capacity: size, sum_capacity: edges, used: 0, sum_used: 0,
        identity: identity, epoch: 1, error: error, ready: false,
        last_root: 0, last_sweep: 0 };
}

pub fn new_cell() -> TapeCell ! { Alloc } { return TapeCell { value: 0.0 }; }

fn span_ok(pointer: i64, count: i64) -> bool {
    // The bump allocator can follow byte strings; Wasm vector accesses support
    // unaligned backing. Validate the span without inventing an alignment rule.
    if pointer < 0 || pointer > 2147483647 { return false; } else {}
    return count * 8 <= 2147483647 - pointer;
}
fn status(tape: Tape @ReadOnly) -> i64 {
    if tape.error < 0 { return tape.error; } else {}
    if tape.error != 0 { return -400; } else {}
    if tape.capacity < 1 || tape.capacity > 4096 || tape.sum_capacity < 0 || tape.sum_capacity > 4096 { return -400; } else {}
    if tape.used < 0 || tape.used > tape.capacity || tape.sum_used < 0 || tape.sum_used > tape.sum_capacity { return -400; } else {}
    if tape.identity < 1 || tape.identity > 2147483647 || tape.epoch < 1 || tape.epoch > 1048574 { return -400; } else {}
    let n = tape.capacity; let e = tape.sum_capacity;
    // The same count/capacity/span checks are fused here so per-node validation
    // does not spend the bounded tool budget on fourteen tiny helper calls.
    if tape.values.count != n || tape.values.slots != n || tape.gradients.count != n || tape.gradients.slots != n || tape.scratch.count != n || tape.scratch.slots != n { return -400; } else {}
    if tape.operations.count != n || tape.operations.slots != n || tape.left.count != n || tape.left.slots != n || tape.right.count != n || tape.right.slots != n || tape.terms.count != e || tape.terms.slots != e { return -400; } else {}
    let node_end = 2147483647 - n * 8; let edge_end = 2147483647 - e * 8;
    if tape.values.buf < 0 || tape.values.buf > node_end || tape.gradients.buf < 0 || tape.gradients.buf > node_end || tape.scratch.buf < 0 || tape.scratch.buf > node_end { return -400; } else {}
    if tape.operations.buf < 0 || tape.operations.buf > node_end || tape.left.buf < 0 || tape.left.buf > node_end || tape.right.buf < 0 || tape.right.buf > node_end || tape.terms.buf < 0 || tape.terms.buf > edge_end { return -400; } else {}
    return 0;
}
fn node_handle(tape: Tape @ReadOnly, index: i64) -> i64 {
    return tape.identity * 4294967296 + tape.epoch * 4096 + index + 1;
}
fn index_of(tape: Tape @ReadOnly, node: i64) -> i64 {
    if node < 1 { return -400; } else {}
    let owner = node / 4294967296;
    let local = node - owner * 4294967296 - 1;
    if owner != tape.identity || local < 0 || local / 4096 != tape.epoch { return -400; } else {}
    let index = local % 4096;
    if index >= tape.used { return -400; } else {}
    return index;
}

pub fn reset(tape: Tape @Mut) -> i64 {
    let valid = status(tape);
    if valid < 0 { return valid; } else {}
    if tape.epoch == 1048574 { return -413; } else {}
    tape.epoch = tape.epoch + 1;
    tape.used = 0; tape.sum_used = 0; tape.ready = false;
    tape.last_root = 0; tape.last_sweep = 0;
    return 0;
}

fn append(tape: Tape @Mut, operation: i64, a: i64, b: i64, value: f64) -> i64 {
    // Every caller validates before this commit point. Errors never append a
    // prefix or invalidate an already published gradient state.
    if tape.used == tape.capacity { return -413; } else {}
    if !finite(value) { return -422; } else {}
    let index = tape.used;
    tape.values.set(index, value); tape.operations.set(index, operation);
    tape.left.set(index, a); tape.right.set(index, b);
    tape.used = index + 1; tape.ready = false;
    return node_handle(tape, index);
}
pub fn variable(tape: Tape @Mut, value: f64) -> i64 {
    let valid = status(tape);
    if valid < 0 { return valid; } else {}
    return append(tape, 0, 0, 0, value);
}
pub fn constant(tape: Tape @Mut, value: f64) -> i64 {
    let valid = status(tape);
    if valid < 0 { return valid; } else {}
    return append(tape, 1, 0, 0, value);
}
fn binary(tape: Tape @Mut, a: i64, b: i64, operation: i64) -> i64 {
    let valid = status(tape);
    if valid < 0 { return valid; } else {}
    let ai = index_of(tape, a); if ai < 0 { return ai; } else {}
    let bi = index_of(tape, b); if bi < 0 { return bi; } else {}
    let av = tape.values.get(ai); let bv = tape.values.get(bi);
    let mut value = av + bv;
    if operation == 3 { value = av - bv; } else {}
    if operation == 4 { value = av * bv; } else {}
    return append(tape, operation, ai, bi, value);
}
pub fn add(tape: Tape @Mut, a: i64, b: i64) -> i64 { return binary(tape, a, b, 2); }
pub fn sub(tape: Tape @Mut, a: i64, b: i64) -> i64 { return binary(tape, a, b, 3); }
pub fn mul(tape: Tape @Mut, a: i64, b: i64) -> i64 { return binary(tape, a, b, 4); }
pub fn relu(tape: Tape @Mut, a: i64) -> i64 {
    let valid = status(tape); if valid < 0 { return valid; } else {}
    let ai = index_of(tape, a); if ai < 0 { return ai; } else {}
    let mut value = tape.values.get(ai);
    if value < 0.0 { value = 0.0; } else {}
    return append(tape, 5, ai, 0, value);
}
pub fn select(tape: Tape @Mut, condition: bool, yes: i64, no: i64) -> i64 {
    let valid = status(tape); if valid < 0 { return valid; } else {}
    let yi = index_of(tape, yes); if yi < 0 { return yi; } else {}
    let ni = index_of(tape, no); if ni < 0 { return ni; } else {}
    let mut chosen = ni;
    if condition { chosen = yi; } else {}
    return append(tape, 6, chosen, 0, tape.values.get(chosen));
}
pub fn sum(tape: Tape @Mut, nodes: Vec<i64> @ReadOnly) -> i64 {
    let valid = status(tape); if valid < 0 { return valid; } else {}
    if nodes.count < 0 || nodes.count > 4096 || nodes.slots < nodes.count || nodes.slots > 4096 || !span_ok(nodes.buf, nodes.count) { return -400; } else {}
    if tape.used == tape.capacity || nodes.count > tape.sum_capacity - tape.sum_used { return -413; } else {}
    let mut value = 0.0;
    let mut i = 0;
    while i < nodes.count {
        let index = index_of(tape, nodes.get(i));
        if index < 0 { return index; } else {}
        value = value + tape.values.get(index);
        i = i + 1;
    }
    if !finite(value) { return -422; } else {}
    let first = tape.sum_used;
    i = 0;
    while i < nodes.count {
        tape.terms.set(first + i, index_of(tape, nodes.get(i)));
        i = i + 1;
    }
    let result = append(tape, 7, first, nodes.count, value);
    tape.sum_used = first + nodes.count;
    return result;
}

pub fn replay(tape: Tape @Mut, variables: Vec<i64> @ReadOnly, values: Vec<f64> @ReadOnly) -> i64 {
    let valid = status(tape); if valid < 0 { return valid; } else {}
    if variables.count < 0 || variables.count > 4096 || variables.slots < variables.count || variables.slots > 4096 || !span_ok(variables.buf, variables.count) { return -400; } else {}
    if values.count != variables.count || values.slots < values.count || values.slots > 4096 || !span_ok(values.buf, values.count) { return -400; } else {}
    let mut i = 0;
    while i < tape.used {
        let value = tape.values.get(i);
        if !finite(value) { return -400; } else {}
        tape.scratch.set(i, value); i = i + 1;
    }
    i = 0;
    while i < variables.count {
        let index = index_of(tape, variables.get(i));
        if index < 0 { return index; } else {}
        if tape.operations.get(index) != 0 { return -400; } else {}
        let value = values.get(i);
        if !finite(value) { return -422; } else {}
        let mut j = 0;
        while j < i {
            if variables.get(j) == variables.get(i) { return -400; } else {}
            j = j + 1;
        }
        tape.scratch.set(index, value);
        i = i + 1;
    }
    // Replay reuses topology and fixed select decisions. Scratch makes a failed
    // parameter update leave both forward values and published gradients intact.
    i = 0;
    while i < tape.used {
        let operation = tape.operations.get(i);
        if operation < 0 || operation > 7 { return -400; } else {}
        if operation >= 2 {
            let a = tape.left.get(i); let mut b = 0;
            if operation <= 4 || operation == 7 { b = tape.right.get(i); } else {}
            if operation >= 2 && operation <= 6 && (a < 0 || a >= i) { return -400; } else {}
            if operation >= 2 && operation <= 4 && (b < 0 || b >= i) { return -400; } else {}
            if operation == 7 && (a < 0 || b < 0 || b > tape.sum_used || a > tape.sum_used - b) { return -400; } else {}
            let mut value = 0.0;
            if operation == 2 { value = tape.scratch.get(a) + tape.scratch.get(b); } else {}
            if operation == 3 { value = tape.scratch.get(a) - tape.scratch.get(b); } else {}
            if operation == 4 { value = tape.scratch.get(a) * tape.scratch.get(b); } else {}
            if operation == 5 {
                value = tape.scratch.get(a);
                if value < 0.0 { value = 0.0; } else {}
            } else {}
            if operation == 6 { value = tape.scratch.get(a); } else {}
            if operation == 7 {
                value = 0.0; let mut j = 0;
                while j < b {
                    let parent = tape.terms.get(a + j);
                    if parent < 0 || parent >= i { return -400; } else {}
                    value = value + tape.scratch.get(parent); j = j + 1;
                }
            } else {}
            if !finite(value) { return -422; } else {}
            tape.scratch.set(i, value);
        } else {}
        i = i + 1;
    }
    i = 0;
    while i < tape.used { tape.values.set(i, tape.scratch.get(i)); i = i + 1; }
    tape.ready = false; tape.last_root = 0; tape.last_sweep = 0;
    return 0;
}

fn accumulate(tape: Tape @Mut, parent: i64, value: f64) -> i64 {
    let updated = tape.scratch.get(parent) + value;
    if !finite(value) || !finite(updated) { return -422; } else {}
    tape.scratch.set(parent, updated);
    return 0;
}
pub fn backward(tape: Tape @Mut, output: i64) -> i64 {
    let valid = status(tape); if valid < 0 { return valid; } else {}
    let root = index_of(tape, output); if root < 0 { return root; } else {}
    let mut i = 0;
    while i < tape.used {
        if !finite(tape.values.get(i)) { return -400; } else {}
        tape.scratch.set(i, 0.0); i = i + 1;
    }
    tape.scratch.set(root, 1.0);
    i = tape.used;
    // Topological append order makes a single reverse sweep sufficient. Scratch
    // absorbs partial failures; published gradients commit only after success.
    while i > 0 {
        i = i - 1;
        let operation = tape.operations.get(i);
        if operation < 0 || operation > 7 { return -400; } else {}
        if operation >= 2 {
            let g = tape.scratch.get(i);
            let a = tape.left.get(i); let mut b = 0;
            if operation <= 4 || operation == 7 { b = tape.right.get(i); } else {}
            // Validate the same topology and finite-value invariants in the reverse
            // traversal, rather than running a redundant graph walk first.
            if operation >= 2 && operation <= 6 && (a < 0 || a >= i) { return -400; } else {}
            if operation >= 2 && operation <= 4 && (b < 0 || b >= i) { return -400; } else {}
            if operation == 7 {
                if a < 0 || b < 0 || b > tape.sum_used || a > tape.sum_used - b { return -400; } else {}
                let mut check = 0;
                while check < b {
                    let parent = tape.terms.get(a + check);
                    if parent < 0 || parent >= i { return -400; } else {}
                    check = check + 1;
                }
            } else {}
            let mut code = 0;
            if g != 0.0 {
                if operation == 2 || operation == 3 || operation == 4 {
                    let mut left_gradient = g;
                    let mut right_gradient = g;
                    if operation == 3 { right_gradient = 0.0 - g; } else {}
                    if operation == 4 {
                        left_gradient = g * tape.values.get(b);
                        right_gradient = g * tape.values.get(a);
                    } else {}
                    code = accumulate(tape, a, left_gradient);
                    if code < 0 { return code; } else {}
                    code = accumulate(tape, b, right_gradient);
                    if code < 0 { return code; } else {}
                } else {}
                if operation == 5 && tape.values.get(a) > 0.0 {
                    code = accumulate(tape, a, g);
                    if code < 0 { return code; } else {}
                } else {}
                if operation == 6 {
                    code = accumulate(tape, a, g);
                    if code < 0 { return code; } else {}
                } else {}
                if operation == 7 {
                    let mut j = 0;
                    while j < b {
                        code = accumulate(tape, tape.terms.get(a + j), g);
                        if code < 0 { return code; } else {}
                        j = j + 1;
                    }
                } else {}
            } else {}
        } else {}
    }
    i = 0;
    while i < tape.used { tape.gradients.set(i, tape.scratch.get(i)); i = i + 1; }
    tape.ready = true; tape.last_root = output; tape.last_sweep = tape.used;
    return 0;
}
pub fn value_into(tape: Tape @ReadOnly, node: i64, out: TapeCell @Mut) -> i64 {
    let valid = status(tape); if valid < 0 { return valid; } else {}
    let index = index_of(tape, node); if index < 0 { return index; } else {}
    out.value = tape.values.get(index);
    return 0;
}
pub fn gradient_into(tape: Tape @ReadOnly, variable: i64, out: TapeCell @Mut) -> i64 {
    let valid = status(tape); if valid < 0 { return valid; } else {}
    let index = index_of(tape, variable); if index < 0 { return index; } else {}
    if !tape.ready || tape.operations.get(index) != 0 { return -400; } else {}
    out.value = tape.gradients.get(index);
    return 0;
}
