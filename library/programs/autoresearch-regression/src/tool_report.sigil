// Structural fitting-result validation before any external reply updates search state.
// This checks identity and transition arithmetic, not honesty of reported gradients.
module tool_report;
use sigil::bytes;
use sigil::bytes_scan;
use sigil::vec;

pub fn validate(report: i64, len: i64, request: i64, request_len: i64) -> i64 ! { Alloc } {
    if request_len < 84 || request_len > 128 || len != 840 + request_len { return -422; } else {}
    if bytes_scan::equal(report + 840, request_len, request, request_len) != 1 { return -409; } else {}
    let count = load8(request + 14); let steps = load8(request + 13); let rounds = load8(request + 5);
    if count < 1 || count > 12 || steps > 12 || rounds > 6 || request_len != 80 + count * 4 { return -422; } else {}
    let h: Vec<i64> = Vec::with_capacity(8); let decisions: Vec<i64> = Vec::with_capacity(6);
    let numbers: Vec<f64> = Vec::with_capacity(91); let weights: Vec<f64> = Vec::with_capacity(8);
    let mut i = 0; while i < 8 { h.push(0); weights.push(0.0); i = i + 1; }
    i = 0; while i < 6 { decisions.push(0); i = i + 1; }
    i = 0; while i < 91 { numbers.push(0.0); i = i + 1; }
    bytes::copy_into(h.buf, 64, 0, report, len, 0, 64);
    bytes::copy_into(decisions.buf, 48, 0, report, len, 264, 48);
    bytes::copy_into(numbers.buf, 728, 0, report, len, 64, 200);
    bytes::copy_into(numbers.buf, 728, 200, report, len, 312, 528);
    bytes::copy_into(weights.buf, 64, 0, request, request_len, 16, 64);
    if h.get(0) != 1 || h.get(1) != steps || h.get(2) != count || h.get(3) != rounds { return -409; } else {}
    let attempted = h.get(4); let accepted = h.get(5); let rejected = h.get(6); let stopped = h.get(7);
    if attempted < 0 || attempted > rounds || accepted < 0 || accepted > attempted || rejected < 0 || rejected > attempted || accepted + rejected != attempted || stopped < 0 || stopped > 1 { return -422; } else {}
    if (attempted < rounds && stopped != 1) || (attempted == rounds && stopped != 0) { return -422; } else {}
    i = 0; while i < 91 { let v = numbers.get(i); if v - v != 0.0 { return -422; } else {} i = i + 1; }
    let mut penalty = 0.0; i = 0; while i < count { penalty = penalty + 66.0 / 65536.0; i = i + 1; }
    if numbers.get(0) < 0.0 || numbers.get(11) < 0.0 || numbers.get(1) != numbers.get(0) + penalty || numbers.get(12) != numbers.get(11) + penalty { return -422; } else {}
    let mut rate = 3277.0 / 65536.0; let mut fitness = numbers.get(1); let mut commits = 0;
    i = 0;
    while i < 6 {
        let at = 25 + i * 11; let decision = decisions.get(i);
        if i >= attempted {
            if decision != -1 { return -422; } else {}
            let mut j = 0; while j < 11 { if numbers.get(at + j) != 0.0 { return -422; } else {} j = j + 1; }
        } else {
            if numbers.get(at) != rate || numbers.get(at + 1) != fitness || numbers.get(at + 2) < 0.0 { return -422; } else {}
            if decision < 0 || decision > 1 || (decision == 1 && numbers.get(at + 2) >= fitness) || (decision == 0 && numbers.get(at + 2) < fitness) { return -422; } else {}
            let mut any = false; let mut j = 0;
            while j < 8 {
                let gradient = numbers.get(at + 3 + j);
                if gradient != 0.0 { any = true; } else {}
                if decision == 1 {
                    let mut value = weights.get(j);
                    if gradient > 0.0 { value = value - rate; } else { if gradient < 0.0 { value = value + rate; } else {} }
                    if value < 0.0 - 4096.0 { value = 0.0 - 4096.0; } else {}
                    if value > 4096.0 { value = 4096.0; } else {}
                    weights.set(j, value);
                } else {} j = j + 1;
            }
            if !any { return -422; } else {}
            if decision == 1 { commits = commits + 1; fitness = numbers.get(at + 2); rate = rate * 1.5; if rate > 13107.0 / 65536.0 { rate = 13107.0 / 65536.0; } else {} }
            else { rate = rate / 2.0; }
        } i = i + 1;
    }
    if commits != accepted || numbers.get(2) != rate || numbers.get(12) != fitness { return -422; } else {}
    i = 0;
    while i < 8 {
        let value = numbers.get(3 + i);
        if value != weights.get(i) || value < 0.0 - 4096.0 || value > 4096.0 { return -422; } else {}
        if stopped == 1 && numbers.get(17 + i) != 0.0 { return -422; } else {} i = i + 1;
    }
    i = 13; while i < 17 { if numbers.get(i) < 0.0 - 4096.0 || numbers.get(i) > 4096.0 { return -422; } else {} i = i + 1; }
    return 0;
}
