// TASK: split count — agent-targeted demonstration tool.
// INPUT: `input_ptr`/`input_len` (i64) point at the host-allocated input buffer.
// OUTPUT: decimal ASCII field count, packed as pointer * 4294967296 + length.
// EFFECTS: ! { Alloc }

module tool;
use sigil::fmt;

pub fn tool_main(input_ptr: i64, input_len: i64) -> i64 ! { Alloc } {
    let mut count = 0;

    if input_len == 0 {
    } else {
        count = 1;
    }

    let mut i = 0;
    while i < input_len {
        let b = load8(input_ptr + i);
        if b == 44 {
            count = count + 1;
        } else {
        }
        i = i + 1;
    }

    return fmt::decimal_i64(count);
}
