// Application mutation policy uses the reusable seeded generator, not a local LCG.
module tool;
use sigil::rng;
use sigil::vec;

fn nibble(byte: i64) -> i64 {
    if byte >= 48 && byte <= 57 { return byte - 48; } else {}
    if byte >= 97 && byte <= 102 { return byte - 87; } else {}
    return -422;
}

fn operand(generator: SeedRng @Mut, op: i64) -> i64 {
    if op == 4 || op == 5 || op == 6 { return rng::below(generator, 8); } else {}
    return rng::below(generator, 16);
}

pub fn tool_main(input_ptr: i64, input_len: i64) -> i64 ! { Alloc } {
    if input_len > 288 { return -413; } else {}
    if input_len < 200 || input_len % 2 != 0 { return -422; } else {}
    let size = input_len / 2;
    let request = alloc(144);
    let body = alloc(120);
    let mut i = 0;
    while i < size {
        let high = nibble(load8(input_ptr + 2 * i));
        let low = nibble(load8(input_ptr + 2 * i + 1));
        if high < 0 || low < 0 { return -422; } else {}
        store8(request + i, high * 16 + low); i = i + 1;
    }
    if load8(request) != 65 || load8(request + 1) != 80 || load8(request + 2) != 82 || load8(request + 3) != 80 || load8(request + 4) != 1 || load8(request + 5) > 1 || load8(request + 6) != 0 || load8(request + 7) != 0 { return -422; } else {}
    let mode = load8(request + 5);
    let words: Vec<u64> = Vec::with_capacity(2);
    words.push(0); words.push(0);
    i = 0;
    while i < 16 { store8(words.buf + i, load8(request + 8 + i)); i = i + 1; }
    i = 0;
    while i < size - 24 { store8(body + i, load8(request + 24 + i)); i = i + 1; }
    if load8(body) != 65 || load8(body + 1) != 67 || load8(body + 2) != 80 || load8(body + 3) != 85 || load8(body + 4) != 1 || load8(body + 7) != 1 { return -422; } else {}
    let mut count = load8(body + 6);
    if load8(body + 5) > 20 || count > 12 { return -413; } else {}
    if count < 1 || size != 96 + count * 4 { return -422; } else {}
    i = 0;
    while i < count {
        let at = body + 72 + 4 * i;
        let op = load8(at); let dst = load8(at + 1);
        let a = load8(at + 2); let b = load8(at + 3);
        if op > 7 || dst < 4 || dst > 15 || a > 15 { return -422; } else {}
        if op == 4 || op == 5 || op == 6 {
            if b > 7 { return -422; } else {}
        } else { if b > 15 { return -422; } else {} }
        i = i + 1;
    }
    let weights: Vec<f64> = Vec::with_capacity(8);
    i = 0;
    while i < 8 { weights.push(0.0); i = i + 1; }
    i = 0;
    while i < 64 { store8(weights.buf + i, load8(body + 8 + i)); i = i + 1; }
    i = 0;
    while i < 8 {
        let value = weights.get(i);
        if value - value != 0.0 || value < 0.0 - 4096.0 || value > 4096.0 { return -422; } else {}
        i = i + 1;
    }
    let mut stream: u64 = 0;
    if mode == 0 { stream = words.get(1); } else {}
    let generator = rng::new(words.get(0), stream);
    if generator.error < 0 { return -422; } else {}
    let snapshot = rng::new_snapshot();
    if mode == 1 {
        snapshot.value = words.get(0); snapshot.increment = words.get(1);
        if rng::restore(generator, snapshot) != 0 { return -422; } else {}
    } else {}
    let unit = rng::new_float();
    let header: Vec<u64> = Vec::with_capacity(5);
    i = 0;
    while i < 5 { header.push(0); i = i + 1; }
    let output = alloc(304);
    let before = alloc(0);
    let kind = rng::below(generator, 6);
    if kind < 0 { return kind; } else {}
    if kind <= 2 {
        let index = rng::below(generator, count);
        if index < 0 { return index; } else {}
        let at = body + 72 + index * 4;
        if kind == 0 {
            let op = rng::below(generator, 8);
            if op < 0 { return op; } else {}
            let b = operand(generator, op);
            if b < 0 { return b; } else {}
            store8(at, op); store8(at + 3, b);
        } else {
            if kind == 1 {
                let a = rng::below(generator, 16);
                if a < 0 { return a; } else {}
                store8(at + 2, a);
            } else {
                let dst = rng::below(generator, 12);
                if dst < 0 { return dst; } else {}
                store8(at + 1, 4 + dst);
            }
        }
    } else {
        if kind == 3 && count < 12 {
            let op = rng::below(generator, 8);
            if op < 0 { return op; } else {}
            let dst = rng::below(generator, 12);
            if dst < 0 { return dst; } else {}
            let a = rng::below(generator, 16);
            if a < 0 { return a; } else {}
            let b = operand(generator, op);
            if b < 0 { return b; } else {}
            let at = body + 72 + count * 4;
            store8(at, op); store8(at + 1, 4 + dst);
            store8(at + 2, a); store8(at + 3, b); count = count + 1;
        } else {
            if kind == 4 && count > 1 {
                let index = rng::below(generator, count);
                if index < 0 { return index; } else {}
                i = index * 4;
                while i < (count - 1) * 4 {
                    store8(body + 72 + i, load8(body + 76 + i)); i = i + 1;
                }
                count = count - 1;
            } else {
                if kind == 5 {
                    let index = rng::below(generator, 8);
                    if index < 0 { return index; } else {}
                    let status = rng::unit_into(generator, unit);
                    if status < 0 { return status; } else {}
                    let mut value = weights.get(index) + unit.value * 0.5 - 0.25;
                    if value < 0.0 - 4096.0 { value = 0.0 - 4096.0; } else {}
                    if value > 4096.0 { value = 4096.0; } else {}
                    weights.set(index, value);
                } else {}
            }
        }
    }
    store8(body + 6, count);
    i = 0;
    while i < 64 { store8(body + 8 + i, load8(weights.buf + i)); i = i + 1; }
    if rng::snapshot_into(generator, snapshot) != 0 { return -422; } else {}
    header.set(0, 1); header.set(1, snapshot.value); header.set(2, snapshot.increment);
    header.set(3, kind.as_u64()); header.set(4, (72 + count * 4).as_u64());
    if alloc(0) != before { return -500; } else {}
    i = 0;
    while i < 40 { store8(output + i, load8(header.buf + i)); i = i + 1; }
    let length = 72 + count * 4;
    i = 0;
    while i < length { store8(output + 40 + i, load8(body + i)); i = i + 1; }
    i = 0;
    while i < size { store8(output + 40 + length + i, load8(request + i)); i = i + 1; }
    return output * 4294967296 + 40 + length + size;
}
