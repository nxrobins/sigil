// Native CPU full-batch linear regression; Python/Torch is not a runtime backend.
module tool;
use sigil::numeric;
use sigil::vec;
use sigil::string;
use sigil::autodiff;

fn training_loss(tape: Tape @Mut, x: Matrix @ReadOnly, target: Matrix @ReadOnly, weights: Matrix @ReadOnly, scalar: Scalar @Mut, parameters: Vec<i64> @Mut, terms: Vec<i64> @Mut) -> i64 {
    let cleared = autodiff::reset(tape);
    if cleared < 0 { return cleared; } else {}
    let read_bias = numeric::get_into(weights, 0, 0, scalar);
    if read_bias < 0 { return read_bias; } else {}
    let bias = autodiff::variable(tape, scalar.value);
    if bias < 0 { return bias; } else {}
    let read_slope = numeric::get_into(weights, 1, 0, scalar);
    if read_slope < 0 { return read_slope; } else {}
    let slope = autodiff::variable(tape, scalar.value);
    if slope < 0 { return slope; } else {}
    parameters.set(0, bias); parameters.set(1, slope);
    let mut i = 0;
    while i < 4 {
        let feature_status = numeric::get_into(x, i, 1, scalar);
        if feature_status < 0 { return feature_status; } else {}
        let feature = autodiff::constant(tape, scalar.value);
        if feature < 0 { return feature; } else {}
        let target_status = numeric::get_into(target, i, 0, scalar);
        if target_status < 0 { return target_status; } else {}
        let expected = autodiff::constant(tape, scalar.value);
        if expected < 0 { return expected; } else {}
        let product = autodiff::mul(tape, slope, feature);
        if product < 0 { return product; } else {}
        let prediction = autodiff::add(tape, bias, product);
        if prediction < 0 { return prediction; } else {}
        let difference = autodiff::sub(tape, prediction, expected);
        if difference < 0 { return difference; } else {}
        let square = autodiff::mul(tape, difference, difference);
        if square < 0 { return square; } else {}
        terms.set(i, square);
        i = i + 1;
    }
    let total = autodiff::sum(tape, terms);
    if total < 0 { return total; } else {}
    let quarter = autodiff::constant(tape, 0.25);
    if quarter < 0 { return quarter; } else {}
    return autodiff::mul(tape, total, quarter);
}

fn read_gradient(tape: Tape @ReadOnly, parameters: Vec<i64> @ReadOnly, gradient: Matrix @Mut, cell: TapeCell @Mut) -> i64 {
    let mut i = 0;
    while i < 2 {
        let read = autodiff::gradient_into(tape, parameters.get(i), cell);
        if read < 0 { return read; } else {}
        let written = numeric::set(gradient, i, 0, cell.value);
        if written < 0 { return written; } else {}
        i = i + 1;
    }
    return 0;
}

fn replay_weights(tape: Tape @Mut, parameters: Vec<i64> @ReadOnly, weights: Matrix @ReadOnly, scalar: Scalar @Mut, updates: Vec<f64> @Mut) -> i64 {
    let mut i = 0;
    while i < 2 {
        let read = numeric::get_into(weights, i, 0, scalar);
        if read < 0 { return read; } else {}
        updates.set(i, scalar.value); i = i + 1;
    }
    return autodiff::replay(tape, parameters, updates);
}

pub fn tool_main(input_ptr: i64, input_len: i64) -> i64 ! { Alloc } {
    let mut epochs = 100;
    if input_len > 3 { return -413; } else {}
    if input_len > 0 {
        let text = "".concat(string::str_from_bytes(input_ptr, input_len).unwrap_or(""));
        epochs = text.parse_i64().unwrap_or(-1);
        if epochs < 0 || epochs > 200 { return -422; } else {}
    } else {}

    let x = numeric::zeros(4, 2);
    let target = numeric::zeros(4, 1);
    let weights = numeric::zeros(2, 1);
    let gradient = numeric::zeros(2, 1);
    let validation_x = numeric::zeros(2, 2);
    let validation_target = numeric::zeros(2, 1);
    let validation_prediction = numeric::zeros(2, 1);
    let scalar = numeric::new_scalar();
    let loss = numeric::new_scalar();
    let tape = autodiff::new_tape(32, 4);
    if tape.error < 0 { return tape.error; } else {}
    let cell = autodiff::new_cell();
    let parameters: Vec<i64> = Vec::with_capacity(2);
    parameters.push(0); parameters.push(0);
    let updates: Vec<f64> = Vec::with_capacity(2);
    updates.push(0.0); updates.push(0.0);
    let terms: Vec<i64> = Vec::with_capacity(4);
    let mut term = 0;
    while term < 4 { terms.push(0); term = term + 1; }
    let result: Vec<f64> = Vec::with_capacity(9);
    let mut i = 0;
    while i < 9 { result.push(0.0); i = i + 1; }
    let mut value = 0.0;
    i = 0;
    while i < 4 {
        let a = numeric::set(x, i, 0, 1.0);
        if a < 0 { return a; } else {}
        let b = numeric::set(x, i, 1, value);
        if b < 0 { return b; } else {}
        let c = numeric::set(target, i, 0, 2.0 * value + 1.0);
        if c < 0 { return c; } else {}
        value = value + 1.0;
        i = i + 1;
    }
    i = 0;
    while i < 2 {
        let a = numeric::set(validation_x, i, 0, 1.0);
        if a < 0 { return a; } else {}
        let b = numeric::set(validation_x, i, 1, value);
        if b < 0 { return b; } else {}
        let c = numeric::set(validation_target, i, 0, 2.0 * value + 1.0);
        if c < 0 { return c; } else {}
        value = value + 1.0;
        i = i + 1;
    }

    let initial_loss = training_loss(tape, x, target, weights, scalar, parameters, terms);
    if initial_loss < 0 { return initial_loss; } else {}
    let initial_value = autodiff::value_into(tape, initial_loss, cell);
    if initial_value < 0 { return initial_value; } else {}
    result.set(0, cell.value);
    let initial_backward = autodiff::backward(tape, initial_loss);
    if initial_backward < 0 { return initial_backward; } else {}
    let initial_gradient = read_gradient(tape, parameters, gradient, cell);
    if initial_gradient < 0 { return initial_gradient; } else {}
    let first_bias = numeric::get_into(gradient, 0, 0, scalar);
    if first_bias < 0 { return first_bias; } else {}
    result.set(4, scalar.value);
    let first_slope = numeric::get_into(gradient, 1, 0, scalar);
    if first_slope < 0 { return first_slope; } else {}
    result.set(5, scalar.value);

    let before = alloc(0);
    let mut step = 0;
    while step < epochs {
        let replayed = replay_weights(tape, parameters, weights, scalar, updates);
        if replayed < 0 { return replayed; } else {}
        let backward = autodiff::backward(tape, initial_loss);
        if backward < 0 { return backward; } else {}
        let derivative = read_gradient(tape, parameters, gradient, cell);
        if derivative < 0 { return derivative; } else {}
        let update = numeric::sgd_step(weights, gradient, 0.05);
        if update < 0 { return update; } else {}
        step = step + 1;
    }
    // A real allocation-growth control in the runtime tests proves this fence fires.
    if alloc(0) != before { return -500; } else {}

    let final_replay = replay_weights(tape, parameters, weights, scalar, updates);
    if final_replay < 0 { return final_replay; } else {}
    let final_value = autodiff::value_into(tape, initial_loss, cell);
    if final_value < 0 { return final_value; } else {}
    result.set(1, cell.value);
    let bias = numeric::get_into(weights, 0, 0, scalar);
    if bias < 0 { return bias; } else {}
    result.set(2, scalar.value);
    let slope = numeric::get_into(weights, 1, 0, scalar);
    if slope < 0 { return slope; } else {}
    result.set(3, scalar.value);
    let final_backward = autodiff::backward(tape, initial_loss);
    if final_backward < 0 { return final_backward; } else {}
    let final_gradient = read_gradient(tape, parameters, gradient, cell);
    if final_gradient < 0 { return final_gradient; } else {}
    let last_bias = numeric::get_into(gradient, 0, 0, scalar);
    if last_bias < 0 { return last_bias; } else {}
    result.set(6, scalar.value);
    let last_slope = numeric::get_into(gradient, 1, 0, scalar);
    if last_slope < 0 { return last_slope; } else {}
    result.set(7, scalar.value);
    let validation_forward = numeric::matmul_into(validation_x, weights, validation_prediction);
    if validation_forward < 0 { return validation_forward; } else {}
    let validation_loss = numeric::mse_into(validation_prediction, validation_target, loss);
    if validation_loss < 0 { return validation_loss; } else {}
    result.set(8, loss.value);

    // Nine little-endian IEEE-754 f64 values. The host viewer only formats bytes.
    return result.buf * 4294967296 + 72;
}
