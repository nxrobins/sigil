// Experimental private word frequencies using bytes and fmt; no host authority.
module tool;
use sigil::bytes;
use sigil::fmt;
use sigil::bytes_out;
use sigil::bytes_scan;

fn is_sep(b: i64) -> i64 {
    if b == 32 {
        return 1;
    } else {
        if b == 10 {
            return 1;
        } else {
            if b == 13 {
                return 1;
            } else {
                if b == 9 {
                    return 1;
                } else {
                    return 0;
                }
            }
        }
    }
}

pub fn tool_main(input_ptr: i64, input_len: i64) -> i64 ! { Alloc } {
    let mut word_count = 0;
    let mut in_word = 0;
    let mut i = 0;
    while i < input_len {
        if is_sep(load8(input_ptr + i)) == 1 {
            in_word = 0;
        } else {
            if in_word == 0 {
                word_count = word_count + 1;
                in_word = 1;
            } else {
            }
        }
        i = i + 1;
    }
    if word_count == 0 {
        let out_ptr = alloc(0);
        return out_ptr * 4294967296;
    } else {
    }

    let meta_size = word_count * 8;
    let meta_ptr = alloc(meta_size);
    let mut word_start = 0;
    let mut word_index = 0;
    let mut saw_word = 0;
    i = 0;
    while i < input_len {
        if is_sep(load8(input_ptr + i)) == 1 {
            if saw_word == 1 {
                let offset = word_index * 8;
                let start_status = bytes::write_u32_le(meta_ptr, meta_size, offset, word_start);
                if start_status < 0 { return start_status; } else {}
                let end_status = bytes::write_u32_le(meta_ptr, meta_size, offset + 4, i);
                if end_status < 0 { return end_status; } else {}
                word_index = word_index + 1;
                saw_word = 0;
            } else {
            }
        } else {
            if saw_word == 0 {
                word_start = i;
                saw_word = 1;
            } else {
            }
        }
        i = i + 1;
    }
    if saw_word == 1 {
        let offset = word_index * 8;
        let start_status = bytes::write_u32_le(meta_ptr, meta_size, offset, word_start);
        if start_status < 0 { return start_status; } else {}
        let end_status = bytes::write_u32_le(meta_ptr, meta_size, offset + 4, input_len);
        if end_status < 0 { return end_status; } else {}
    } else {
    }

    let out = bytes_out::new(input_len * 3 + 32);
    let mut wrote_any = 0;
    let mut idx = 0;
    while idx < word_count {
        let offset = idx * 8;
        let cur_start = bytes::read_u32_le(meta_ptr, meta_size, offset);
        if cur_start < 0 { return cur_start; } else {}
        let cur_end = bytes::read_u32_le(meta_ptr, meta_size, offset + 4);
        if cur_end < 0 { return cur_end; } else {}
        let mut seen_before = 0;
        let mut prev = 0;
        while prev < idx {
            if seen_before == 0 {
                let prev_offset = prev * 8;
                let prev_start = bytes::read_u32_le(meta_ptr, meta_size, prev_offset);
                if prev_start < 0 { return prev_start; } else {}
                let prev_end = bytes::read_u32_le(meta_ptr, meta_size, prev_offset + 4);
                if prev_end < 0 { return prev_end; } else {}
                let compared = bytes_scan::equal(input_ptr + cur_start, cur_end - cur_start, input_ptr + prev_start, prev_end - prev_start);
                if compared < 0 { return compared; } else {}
                if compared == 1 {
                    seen_before = 1;
                } else {
                }
            } else {
            }
            prev = prev + 1;
        }
        if seen_before == 0 {
            let mut count = 0;
            let mut scan = idx;
            while scan < word_count {
                let scan_offset = scan * 8;
                let scan_start = bytes::read_u32_le(meta_ptr, meta_size, scan_offset);
                if scan_start < 0 { return scan_start; } else {}
                let scan_end = bytes::read_u32_le(meta_ptr, meta_size, scan_offset + 4);
                if scan_end < 0 { return scan_end; } else {}
                let compared = bytes_scan::equal(input_ptr + cur_start, cur_end - cur_start, input_ptr + scan_start, scan_end - scan_start);
                if compared < 0 { return compared; } else {}
                if compared == 1 {
                    count = count + 1;
                } else {
                }
                scan = scan + 1;
            }
            if wrote_any == 1 {
                bytes_out::push_byte(out, 44);
            } else {
            }
            bytes_out::append(out, input_ptr, input_len, cur_start, cur_end - cur_start);
            bytes_out::push_byte(out, 58);
            bytes_out::append_output(out, fmt::decimal_i64(count));
            wrote_any = 1;
        } else {
        }
        idx = idx + 1;
    }
    return bytes_out::finish(out);
}
