// Heap floor S2 (BUG-2): a stored @Secret read back through a FRESH region's pointer.
// `alloc` is an unaligned bump, so the second allocation's pointer minus one is `a`: the
// region model taints region `a` only, and the address arithmetic escapes it. The
// non-@Public store raises the raw-load floor, so returning the load from a function
// declared @Public is T001. The second `alloc` is inlined and the @Public return is the
// fixture's ONLY sink (precision lane: exactly one error) — a `let b: i64 = alloc(1)`
// after the store would itself be floored, a counted cost pinned in taint_heap_floor.rs.
// Shape pinned by `secret_store_read_back_through_fresh_region_is_t001`.
// expect-error: T001
#[ring(outer)] module ext;
fn probe() -> i64 @Public ! { Alloc } {
    let s: i64 @Secret = 42;
    let a: i64 = alloc(1);
    store8(a, s);
    return load8(alloc(1) - 1);
}
