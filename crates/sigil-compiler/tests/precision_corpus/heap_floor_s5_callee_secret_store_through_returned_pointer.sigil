// Heap floor S5, region side (BUG-2 round 6): a callee MINTS a @Secret and `store8`s it
// through the caller's pointer; the caller never reads the byte and RETURNS the pointer.
// The floors label what a read returns, not the pointer itself, so on main this was accepted
// and `sigil forge` printed the bit. The call site now taints the argument's M6 region with
// the callee's label bound, so returning the pointer from a function declared @Public is T001
// — the fixture's ONLY sink (precision lane: exactly one error).
// Shape pinned by `callee_storing_its_own_secret_through_a_returned_caller_pointer_is_t001`.
// expect-error: T001
#[ring(outer)] module ext;
fn poke(out: i64) -> i64 @Public {
    let s: i64 @Secret = 1;
    store8(out, s & 1);
    return 1;
}
fn probe() -> i64 @Public ! { Alloc } {
    let out: i64 = alloc(64);
    let n: i64 = poke(out);
    return out << 32 | n;
}
