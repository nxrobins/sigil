// Heap floor S6 through the returned-pointer sink (BUG-2 round 6): a @Public byte stored at
// a @Secret-derived address, then the buffer's pointer returned unread. WHICH cell changed is
// the secret and the host reads the buffer (`0900` / `0009` on main, where the region rule
// looked at a store's value operand only). The region now takes the join of every operand,
// so returning the pointer from a function declared @Public is T001 — the ONLY sink.
// Shape pinned by `secret_address_store_taints_the_returned_pointer_is_t001`.
// expect-error: T001
#[ring(outer)] module ext;
fn probe() -> i64 @Public ! { Alloc } {
    let out: i64 = alloc(64);
    let s: i64 @Secret = 1;
    store8(out + (s & 1), 9);
    return out << 32 | 2;
}
