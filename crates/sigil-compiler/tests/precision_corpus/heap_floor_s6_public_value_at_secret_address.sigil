// Heap floor S6 (BUG-2): the ADDRESS channel — a @Public value stored at a @Secret address.
// The stored byte is the constant 9; the secret is WHICH cell changed, read back through
// a fresh region's pointer (`sigil forge` returned 0 bytes for secret 40 and 9 bytes for 41
// before the floor). A store's floor joins ALL its operands, so returning the load from a
// function declared @Public is T001. The second `alloc` is inlined and the @Public return is
// the fixture's ONLY sink (precision lane: exactly one error).
// Shape pinned by `public_value_stored_at_a_secret_address_is_t001`.
// expect-error: T001
#[ring(outer)] module ext;
fn probe(s: i64 @Secret) -> i64 @Public ! { Alloc } {
    let a: i64 = alloc(2);
    store8(a + (s & 1), 9);
    return load8(alloc(1) - 1);
}
