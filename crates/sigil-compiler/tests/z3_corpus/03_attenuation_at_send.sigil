// expect-error: C003
// Z3 corpus #3: attenuation reaches SerializeMessage (send) sink.
//
// `worker.send(Burn(cap))` serializes the cap into a message. Authority on
// the cap must be full so the receiver can use it as `Burn` declares. We
// pass a `.restrict(burn)`-attenuated cap; Z3 must reject with C003.
//
// MUTATION CONTRACT: deleting the MUTATION_SITE line removes the send —
// `fuel` stays in state (unconsumed is fine for state caps), program reduces
// to `return 1;`, and verification passes.
module sigil;
cap type Fuel { burn, query }

actor Worker {
    init(seed: i64) {}
    on Burn(f: Fuel) {}
}

entry actor Main {
    state { fuel: Fuel }

    on Start(worker: ActorRef<Worker>) -> i64 {
        worker.send(Burn(fuel.restrict(burn)));  // MUTATION_SITE
        return 1;
    }
}
