// expect-error: T218
// Z3 corpus #44: axis-1 — Wall 4 Step 4 self-reference T218.
//
// WHAT THIS FIXTURE PROVES
//
// V58 (T218): `where <field> <op> <field>` (same identifier on both
// sides) is vacuous and rejected at parse time. `where lo == lo` is
// always true; `where lo < lo` is always false. Such a clause carries
// no information.
//
// The parser-level check fires BEFORE any type-check work. No Z3 query
// is constructed.
//
// THE LANGUAGE PRIMITIVES THIS NEEDED
//
//   * Step 4 parser's bare-Ident branch with same-name check (V58).
//   * T218 diagnostic code.
//
// MUTATION CONTRACT
//
// Deleting MUTATION_SITE removes the offending where clause's record
// declaration. The remaining program has only `Filler` and compiles.
module sigil;

record Vacuous { lo: i64, hi: i64 } where lo == lo // MUTATION_SITE

record Filler { x: i64 } where x >= 0

entry actor Main {
    on Tick() -> i64 {
        let f: Filler = Filler { x: 1 };
        return 1;
    }
}
