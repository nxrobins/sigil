// (N23-S7) fires the diagnostic and clears the refinement slots in
// the same code path — never one without the other.
//
// MUTATION CONTRACT
//
// The MUTATION_SITE is the entire single-line generic-fn declaration.
// Removing the line leaves the entry actor alone, which compiles.
module sigil;

fn validate<T>(x: i64) where x > 0 -> bool { return true; }  // MUTATION_SITE

entry actor Main {
    on Tick() -> i64 {
        return 1;
    }
}
